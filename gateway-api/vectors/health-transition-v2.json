      "latched": false,
      "item": {
        "projection": "runtime-health/v4/remote",
        "device_id": "ori-rt-1a2b3c",
        "uptime_s": 812.5,
        "critical": false,
        "degradation_reasons": [],
        "unknown_critical_blocks": [],
        "status": "ok"
      },
      "expect": {
        "severity": "ok",
        "latched_after": true
      }
    },
