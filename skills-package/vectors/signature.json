            "action_tier": "A"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms"
            ]
          }
        },
        "config_schema": {
          "mode": {
            "type": "string",
            "enum": [
              "quiet",
              "normal"
            ],
            "default": "normal"
          }
        },
        "signature": "ed25519:eaWtjjvclSiBgS32uUxSCMo48fTGYy3R2TOSKLPJp/qrwhoyy/EokFju8xgXOehCHqZ34bjqRQdyB8z/MI+vCw=="
      },
      "expect": "refused",
      "error": "SkillSecurityError",
      "signed_config_schema": {
        "mode": {
          "type": "string",
          "enum": [
            "quiet",
            "normal"
          ],
          "default": "quiet"
        }
      },
      "why": "A default is the value the skill runs on when an operator writes nothing, so changing it changes behaviour without changing any document."
    },
    {
      "name": "unmodified_manifest_verifies",
