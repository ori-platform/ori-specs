{
  "contract": "skills-package/v3 — config_schema load",
  "phase": "schema_load",
  "note": "A declaration is checked on its own terms, before any `config` is considered. These are the skill author's errors, and they surface without a configuration document in hand. The descriptor-core cases are reached here through a skill manifest rather than standalone, because that is where a package consumer meets them.",
  "refusal_note": "`must_name` lists identifiers a conforming refusal must contain — keys, paths and descriptor properties, never English wording. Every case in this file raises SkillValidationError.",
  "cases": [
    {
      "name": "reserved_reading_name_declared",
      "config_schema": {
        "value": {
          "type": "number"
        }
      },
      "expect": "refused",
      "must_name": [
        "value"
      ],
      "why": "The five reading names are always taken from the event. v2 refused them in `config`; v3 refuses them one step earlier, in the schema that would have declared them."
    },
    {
      "name": "reserved_sensor_id_declared",
      "config_schema": {
        "sensor_id": {
          "type": "string"
        }
      },
      "expect": "refused",
      "must_name": [
        "sensor_id"
      ]
    },
    {
      "name": "reserved_name_nested",
      "config_schema": {
        "window": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "number"
            }
          }
        }
      },
      "expect": "refused",
      "must_name": [
        "quality"
      ],
      "why": "Depth does not launder a reserved name."
    },
    {
      "name": "config_schema_not_a_mapping",
      "config_schema": [
        "energy_cost_naira"
      ],
      "expect": "refused",
      "must_name": [
        "config_schema"
      ]
    },
    {
      "name": "object_without_properties",
      "config_schema": {
        "quiet_hours": {
          "type": "object"
        }
      },
      "expect": "refused",
      "must_name": [
        "quiet_hours",
        "properties"
      ]
    },
    {
      "name": "array_without_items",
      "config_schema": {
        "contacts": {
          "type": "array"
        }
      },
      "expect": "refused",
      "must_name": [
        "contacts",
        "items"
      ]
    },
    {
      "name": "default_its_own_descriptor_rejects",
      "config_schema": {
        "energy_cost_naira": {
          "type": "number",
          "minimum": 0,
          "default": -1
        }
      },
      "expect": "refused",
      "must_name": [
        "energy_cost_naira",
        "default"
      ]
    },
    {
      "name": "default_of_the_wrong_type",
      "config_schema": {
        "retries": {
          "type": "integer",
          "default": "3"
        }
      },
      "expect": "refused",
      "must_name": [
        "retries",
        "default"
      ]
    },
    {
      "name": "fractional_bound_on_an_integer",
      "config_schema": {
        "retries": {
          "type": "integer",
          "minimum": 1.5
        }
      },
      "expect": "refused",
      "must_name": [
        "retries",
        "minimum"
      ]
    },
    {
      "name": "boolean_bound",
      "config_schema": {
        "retries": {
          "type": "integer",
          "minimum": true
        }
      },
      "expect": "refused",
      "must_name": [
        "retries",
        "minimum"
      ],
      "why": "A boolean is an integer in some host languages and is not a bound in any of them."
    },
    {
      "name": "non_numeric_bound",
      "config_schema": {
        "retries": {
          "type": "integer",
          "minimum": "1"
        }
      },
      "expect": "refused",
      "must_name": [
        "retries",
        "minimum"
      ]
    },
    {
      "name": "infinite_bound",
      "schema_text": "{\"timeout_s\": {\"type\": \"number\", \"maximum\": 1e999}}",
      "expect": "refused",
      "must_name": [
        "timeout_s",
        "maximum"
      ],
      "note": "Carried as source text, not as a value: `Infinity` is not JSON, and embedding it would make this file unparseable for a strict reader and take every other case down with it."
    },
    {
      "name": "nan_bound",
      "schema_text": "{\"timeout_s\": {\"type\": \"number\", \"minimum\": NaN}}",
      "expect": "refused",
      "must_name": [
        "timeout_s",
        "minimum"
      ],
      "why": "A NaN bound compares false against everything, so it admits nothing while reading as a limit.",
      "note": "Carried as source text for the same reason as the infinity: `NaN` is not JSON."
    },
    {
      "name": "minimum_above_maximum",
      "config_schema": {
        "hour": {
          "type": "integer",
          "minimum": 23,
          "maximum": 0
        }
      },
      "expect": "refused",
      "must_name": [
        "hour"
      ]
    },
    {
      "name": "empty_enum",
      "config_schema": {
        "mode": {
          "type": "string",
          "enum": []
        }
      },
      "expect": "refused",
      "must_name": [
        "mode",
        "enum"
      ]
    },
    {
      "name": "enum_member_its_own_descriptor_rejects",
      "config_schema": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23,
          "enum": [
            0,
            24
          ]
        }
      },
      "expect": "refused",
      "must_name": [
        "hour",
        "enum"
      ]
    },
    {
      "name": "a_valid_schema_is_accepted",
      "config_schema": {
        "energy_cost_naira": {
          "type": "number",
          "minimum": 0,
          "default": 225
        },
        "alert_contact": {
          "type": "string"
        },
        "quiet_hours": {
          "type": "object",
          "properties": {
            "start_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "end_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            }
          }
        }
      },
      "expect": "accepted"
    }
  ]
}
