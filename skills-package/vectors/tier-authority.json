{
  "contract": "skills-package/v3 — tier authority",
  "phase": "package_admission",
  "note": "Tier D is refused from every package, first-party included. v3 does not schematise Tier D parameters, and carries no vector exercising one — but the refusals themselves are required. A rule with no vector is a rule an implementation can omit and still claim conformance.",
  "refusal_note": "`error` is the class a conforming loader raises. A Tier D declaration is a validation error, not a security error, and the same one from every package: v2 raised a security error for community packages because provenance decided who held the authority. In v3 nobody holds it, so provenance is not the question. `must_name` lists identifiers the message must contain.",
  "cases": [
    {
      "name": "trigger_declaring_tier_d_refused",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "overcurrent",
            "action_tier": "D"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms"
            ]
          }
        }
      },
      "expect": "refused",
      "error": "SkillValidationError",
      "must_name": [
        "action_tier",
        "D"
      ],
      "why": "Tier D fires before any LLM and cannot be overridden. It is the one tier that removes the operator rather than adding one."
    },
    {
      "name": "first_party_trigger_declaring_tier_d_refused",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "overcurrent",
            "action_tier": "D"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms"
            ]
          }
        },
        "signature": "bundled"
      },
      "expect": "refused",
      "error": "SkillValidationError",
      "must_name": [
        "action_tier",
        "D"
      ],
      "why": "The `bundled` sentinel does not buy Tier D. v2 accepted it from packages shipping with the runtime; that was containment, not ownership, and left the safety envelope a property of which skills are installed."
    },
    {
      "name": "tier_d_action_in_available_refused",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "observe",
            "action_tier": "A"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            },
            {
              "name": "emergency_cutoff",
              "tier": "D"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms"
            ]
          }
        }
      },
      "expect": "refused",
      "error": "SkillValidationError",
      "must_name": [
        "emergency_cutoff"
      ],
      "why": "Tier D is not reachable from a package by declaration."
    },
    {
      "name": "tier_d_action_in_defaults_refused",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "observe",
            "action_tier": "A"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms",
              "emergency_cutoff"
            ]
          }
        }
      },
      "expect": "refused",
      "error": "SkillValidationError",
      "must_name": [
        "emergency_cutoff"
      ],
      "why": "Nor by naming one in a default list without declaring it."
    },
    {
      "name": "bypass_llm_refused_on_any_trigger",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "observe",
            "action_tier": "A",
            "bypass_llm": true
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms"
            ]
          }
        }
      },
      "expect": "refused",
      "error": "SkillValidationError",
      "must_name": [
        "bypass_llm"
      ],
      "why": "`bypass_llm` is the Tier D execution property. A package reaching it under another tier would have Tier D behaviour without the label."
    },
    {
      "name": "escalation_to_tier_c_accepted",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "observe",
            "action_tier": "C",
            "safe_default_action": "log_to_dashboard"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "open_safety_circuit",
              "tier": "C"
            }
          ],
          "defaults": {
            "observe": [
              "open_safety_circuit"
            ]
          }
        }
      },
      "expect": "accepted",
      "why": "A package may raise an action's tier to at most C. The cap is what makes the Tier D prohibition meaningful rather than cosmetic."
    },
    {
      "name": "tier_a_package_accepted",
      "manifest": {
        "name": "example-skill",
        "version": "1.0.0",
        "author": "example",
        "triggers": [
          {
            "name": "observe",
            "action_tier": "A"
          }
        ],
        "actions": {
          "available": [
            {
              "name": "alert_sms",
              "tier": "A"
            }
          ],
          "defaults": {
            "observe": [
              "alert_sms"
            ]
          }
        }
      },
      "expect": "accepted"
    }
  ]
}
