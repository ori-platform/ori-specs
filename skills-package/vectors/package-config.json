{
  "contract": "skills-package/v3 — config against its schema",
  "phase": "package_admission",
  "note": "A document is checked only against a schema that has itself been validated. `resolved` is the exact mapping the skill must receive, with declared defaults applied — returning the input unchanged is not acceptance, because the hook would then apply its own defaults and the schema would describe nothing.",
  "refusal_note": "`must_name` lists identifiers a conforming refusal must contain, by full path where the key is nested. Every refusal here raises SkillValidationError.",
  "cases": [
    {
      "name": "populated_config_with_no_schema_refused",
      "config_schema": null,
      "config": {
        "energy_cost_naira": 225
      },
      "expect": "refused",
      "must_name": [
        "energy_cost_naira"
      ],
      "why": "Absence is not permission. Treating a missing schema as `anything goes` would make v3 indistinguishable from v2 for every package that omits the field."
    },
    {
      "name": "empty_config_with_no_schema_accepted",
      "config_schema": null,
      "config": {},
      "expect": "accepted",
      "resolved": {}
    },
    {
      "name": "absent_config_with_no_schema_accepted",
      "config_schema": null,
      "config": null,
      "expect": "accepted",
      "resolved": {},
      "why": "Declaring nothing is a statement, and the statement is that the skill takes no configuration."
    },
    {
      "name": "undeclared_key_refused",
      "config_schema": {
        "energy_cost_naira": {
          "type": "number",
          "minimum": 0,
          "default": 225
        },
        "alert_contact": {
          "type": "string"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "mode": {
          "type": "string",
          "enum": [
            "quiet",
            "normal"
          ],
          "default": "normal"
        },
        "quiet_hours": {
          "type": "object",
          "properties": {
            "start_hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23,
              "default": 22
            },
            "window": {
              "type": "object",
              "properties": {
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "config": {
        "energy_cost_nira": 225
      },
      "expect": "refused",
      "must_name": [
        "energy_cost_nira"
      ],
      "why": "A key nobody reads is indistinguishable, from the author's side, from one that works. This is the misspelling the whole version exists to catch."
    },
