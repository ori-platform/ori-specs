      "expected": "unknown_commissioning_key",
      "http": 422
    },
    {
      "name": "cancellation_of_held_authorisation",
      "mutation": "cancel the digest of the authorisation this corpus holds",
      "expected": "authorisation_held",
      "http": 409
    },
    {
      "name": "cancellation_for_another_epoch",
      "mutation": "cancel a digest under which a registration is pending for another epoch",
      "expected": "cancellation_mismatch",
      "http": 422
    },
    {
      "name": "authorisation_after_cancellation",
      "mutation": "submit an authorisation whose digest a cancellation tombstoned",
      "expected": "cancelled",
      "http": 409
    },
    {
      "name": "cancellation_for_an_unrelated_issuer",
      "cancellation_case": "by_designated_key_for_an_unrelated_issuer",
      "expected": "cancellation_not_permitted",
      "http": 422
    },
    {
      "name": "authorisation_with_inconsistent_issuer",
      "mutation": "submit an authorisation under a tombstoned digest that names a key other than the tombstone's expected key; the refusal is terminal and a resubmission gets the same answer",
      "expected": "cancellation_issuer_mismatch",
      "http": 409
    },
    {
      "name": "cancellation_id_reused",
      "mutation": "resubmit cancel-0101 under comm-recovery-1 with a different reason",
      "expected": "cancellation_id_reused",
      "http": 409
    },
    {
      "name": "repeated_cancellation",
      "mutation": "resubmit the permitted cancellation byte for byte under a fresh nonce",
      "expected": "same_semantic_response",
      "http": 200
    }
