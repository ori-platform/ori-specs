  "join_cases": [
    {
      "name": "artifact_missing_fails_closed",
      "note": "No denial artifact reached the device. A grant-bearing package becomes unavailable; a broken artifact never means deny nothing.",
      "grant_case": "tier_c_grant_admitted",
      "denial_artifact": {
        "state": "missing"
      },
      "expected": "grants_unavailable"
    },
    {
      "name": "artifact_unparseable_fails_closed",
      "note": "The denial artifact is present but is not JSON. Same posture: grant-bearing packages are unavailable.",
      "grant_case": "tier_c_grant_admitted",
      "denial_artifact": {
        "state": "present",
        "raw": "not json {{{"
      },
      "expected": "grants_unavailable"
    },
    {
      "name": "artifact_missing_no_grant_unaffected",
      "note": "The same broken-artifact state against a package with no grant. It carries nothing a denial can name, so the implicit Tier A branch proceeds.",
      "grant_case": "no_grant_tier_a_admitted",
      "denial_artifact": {
        "state": "missing"
      },
      "expected": "unaffected"
    }
  ],
