      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v1\",\n  \"entries\": [\n    {\n      \"kind\": \"skill\",\n      \"sha256\": \"sha256:16a9910a5c686f13cafb7b5505ba8bd9bfaf66d8514738a6864c1e5610144597\"\n    }\n  ]\n}",
