{
  "contract": "capability-grant-issuance/v1",
  "grant_corpus": "../capability-grant/grant-vectors-v1.json",
  "cases": [
    {
      "name": "empty_list_denies_nothing",
      "note": "A valid list with no entries. The admitted grant stays admitted.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v1\",\n  \"entries\": []\n}",
      "expected": "not_denied"
    },
    {
      "name": "denied_by_grant_digest",
      "note": "The admitted case's grant, denied by the SHA-256 of its canonical unsigned bytes — the identity the authority signed, immune to re-serialisation.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v1\",\n  \"entries\": [\n    {\n      \"kind\": \"grant\",\n      \"sha256\": \"sha256:16a9910a5c686f13cafb7b5505ba8bd9bfaf66d8514738a6864c1e5610144597\"\n    }\n  ]\n}",
      "expected": "denied",
      "reason": "denied by grant digest"
    },
    {
      "name": "denied_by_payload_digest",
      "note": "The payload itself condemned: every grant over this payload dies, whoever granted what.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v1\",\n  \"entries\": [\n    {\n      \"kind\": \"payload\",\n      \"sha256\": \"sha256:7d61f28d948a24e0a2f3bfa6cd9b36f5b5e342925e65ca08f8848376ef993618\"\n    }\n  ]\n}",
      "expected": "denied",
      "reason": "denied by payload digest"
    },
    {
      "name": "near_miss_denies_nothing",
      "note": "The grant digest with its final hex character changed. Matching is exact; a close digest denies nothing.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v1\",\n  \"entries\": [\n    {\n      \"kind\": \"grant\",\n      \"sha256\": \"sha256:16a9910a5c686f13cafb7b5505ba8bd9bfaf66d8514738a6864c1e5610144590\"\n    }\n  ]\n}",
      "expected": "not_denied"
    },
    {
      "name": "wrong_schema",
      "note": "A list whose schema names a version this contract does not define denies nothing and fails the release build.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v2\",\n  \"entries\": []\n}",
      "expected": "list_refused",
      "reason": "schema is not ori.capability_denial.v1"
    },
    {
      "name": "unknown_field",
      "note": "A list carrying a field the contract does not define.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\n  \"schema\": \"ori.capability_denial.v1\",\n  \"entries\": [],\n  \"notes\": \"x\"\n}",
      "expected": "list_refused",
      "reason": "unknown field notes"
    },
    {
      "name": "duplicate_key_in_list",
      "note": "The raw list text spells schema twice. Strict parsing refuses the bytes before any object exists.",
      "grant_case": "tier_c_grant_admitted",
      "denial_list_raw": "{\"schema\": \"ori.capability_denial.v1\", \"schema\": \"ori.capability_denial.v1\", \"entries\": []}",
      "expected": "list_refused",
      "reason": "duplicate key schema"
    },
    {
