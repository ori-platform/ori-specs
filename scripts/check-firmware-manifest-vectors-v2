"""Check the firmware-telemetry/v2 manifest corpus against the contracts.

Shares no code with scripts/generate-firmware-manifest-vectors-v2. Canonical
bytes come from this script's own serializer, the key is re-derived from the
disclosed seed and every signature verified with this script's own affine
curve arithmetic. The mode table, the bridged source, the refusal reasons,
the `controller_profile` grammar and the corpus digests are read from
firmware-telemetry/v2.md; the manifest's fields and enumerated values from
v1's example manifest. Nothing is read from either generator.

v1 names no closed `sensor_type` or `unit` vocabulary. The values held
supported here are v1's example's (`current`, `ampere`), the two tokens v2's
alarm-channel rule names (`controller_alarm_word`, `bitmask`), and the values
the measurement channels of the profile corpus's accepted documents declare,
because v2 says a profile channel's `sensor_type` and `unit` are what a
manifest channel reading it declares. The channel field set is v1's, or v1's
plus the one field v2's example channel adds; which channels may carry it is
v2's rule, not v1's.

Held to:

- each case: canonical bytes, digest, manifest_hash, wire message and
  signature reproduce from its message, and the manifest is valid under the
  v1 checks modelled here;
- each case: its device_mode is the mode this script derives from its arrays;
- each refusal: signature valid, and the set of v2 rules it breaks names
  exactly its declared reason, so no other rule refuses it;
- each accepted bridged channel: its `controller_profile.digest` is this
  script's digest of a document in the profile corpus's `cases`, whose `id`
  is the binding's, which has the named `profile_channel`, and whose kind,
  `sensor_type` and `unit` agree with the channel;
- coverage: every single-role mode and every multi-role combination accepted,
  no actuator_node accepted, each defined mode refused over arrays that
  determine another, integer and null modes, and no_channels alone; profiles
  qualified and unqualified, an alarm word and two channels reading one
  profile accepted; a refusal for every reason, every `controller_profile`
  grammar clause (a wrong JSON type for each field among them), the bridged
  protocol, one profile `id` under two digests, two qualifications and two
  records, and one digest under two ids, each alone; and
  each misuse of the alarm tokens; and for each bound pair the grammar reads
  (fleet identifier length, record length, digest hex length), each end
  accepted and one past each end refused;
- the digests firmware-telemetry/v2.md pins are the two corpora's.

    python3 scripts/check-firmware-manifest-vectors-v2
    python3 scripts/check-firmware-manifest-vectors-v2 --mutations

`--mutations` corrupts the corpus, re-signs edited manifests with this
script's own signer so that an edit reaches the mode rules rather than the
signature, edits copies of the contract text, and switches off each rule in
turn; every mutant must be refused.
"""

from __future__ import annotations

import base64
import copy
import hashlib
import itertools
import json
import math
import pathlib
import re
import sys
from collections.abc import Callable

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "firmware-telemetry" / "manifest-vectors-v2.json"
PROFILES = ROOT / "firmware-telemetry" / "controller-profile-vectors-v2.json"
TELEMETRY_V1 = ROOT / "firmware-telemetry" / "v1.md"
TELEMETRY_V2 = ROOT / "firmware-telemetry" / "v2.md"

P = 2**255 - 19
D = (-121665 * pow(121666, -1, P)) % P
L = 2**252 + 27742317777372353535851937790883648493
SQRT_M1 = pow(2, (P - 1) // 4, P)
BY = 4 * pow(5, -1, P) % P
ROLE_WORDS = {
    "metering channels": "metering",
    "bridged channels": "bridged",
    "actions": "actions",
}
MODE_RULES = ("mode_undefined", "mode_disagrees", "channels_empty")
PROFILE_RULES = ("profile_missing", "profile_unexpected", "profile_invalid",
                 "alarm_channel")
RULES = MODE_RULES + PROFILE_RULES
# What each rule refuses, as v2.md words it. The checker evaluates each rule by
# its own predicate below, so the clause it is held to must say exactly that: a
# clause whose meaning changes, its polarity included, fails here rather than
# leaving a predicate the text no longer states.
RULE_CLAUSES = {
    "mode_undefined": "`device_mode` is not one of the four values above, "
                      "including a value of another JSON type",
    "mode_disagrees": "`device_mode` is not the value its `channels` and "
                      "`actions` determine",
    "channels_empty": "`channels` is empty",
    "profile_missing": "a bridged channel carries no `controller_profile`",
    "profile_unexpected": "a channel that is not bridged carries `controller_profile`",
    "profile_invalid": "a `controller_profile` breaks the grammar above, or a "
                       "bridged channel's `protocol` is not `modbus_rtu`",
    "alarm_channel": "a channel declares `sensor_type` `controller_alarm_word` or "
                     "`unit` `bitmask`, unless it is a bridged channel that declares both",
}
# The `controller_profile` grammar, cell by cell, as v2.md's field table states
# it. Each pattern matches its Notes cell whole; the groups are the bounds and
# closed sets this script reads.
PROFILE_ROWS = {
    "id": ("string", r"The profile's `id`, a fleet identifier\."),
    "digest": ("string", (r"`([a-z0-9]+:)` and (\d+) (lowercase )?hex: SHA-256 over the "
                          r"canonical bytes of the profile document\.")),
    "profile_channel": ("string", (r"The `name` of the profile channel this channel "
                                   r"reads, a fleet identifier\.")),
    "qualification": ("string", r"`([a-z]+)` or `([a-z]+)`\."),
    "record": ("string or null", (r"The repository path of the qualification record, "
                                  r"relative to the root of the repository that ships the "
                                  r"profile; `null` exactly when `qualification` is "
                                  r"`([a-z]+)`\.")),
}
FLEET_SENTENCE = (r"A fleet identifier, wherever Controller Profiles names one, is a string of "
                  r"(\d+) to (\d+) characters, each from the fleet alphabet: (.*)\.")
RECORD_SENTENCE = (r"A `record` is (\d+) to (\d+) characters, each from the fleet alphabet "
                   r"or `(.)`\. It does not begin or end with `(.)`, never has two `(.)` in a "
                   r"row, and never contains `([^`]+)` anywhere, even inside a segment\.")
KEYS_SENTENCE = "The object's keys are exactly these five."
SAME_PROFILE = (r"Channels that name the same profile `([a-z_]+)` carry the same `([a-z_]+)`, "
                r"`([a-z_]+)` and `([a-z_]+)`, and channels that name the same `([a-z_]+)` "
                r"name the same `([a-z_]+)`: a device holds one document and one "
                r"qualification per profile\. A consumer MUST reject a manifest in which they "
                r"differ \(`([a-z_]+)`\)\.")
# Every grammar clause a refusal of the corpus must break alone at least once.
# A value of the wrong JSON type breaks its type clause and nothing else.
PROFILE_CLAUSES = (
    "not_object", "keys_extra", "keys_missing", "id_type", "id_length", "id_chars",
    "digest_prefix", "digest_length", "digest_digits", "profile_channel_length",
    "profile_channel_chars", "qualification_type", "qualification", "record_type",
    "record_missing", "record_unexpected", "record_length", "record_chars",
    "record_leading", "record_trailing", "record_double_separator", "record_dotdot",
    "protocol", "one_id_two_digest", "one_id_two_qualification", "one_id_two_record",
    "digest_type", "profile_channel_type", "one_digest_two_id",
)
# Channels that differ in qualification differ in record too, under the
# pairing rule, so a second qualification brings a second record with it.
IMPLIED = {"one_id_two_qualification": "one_id_two_record"}
OPTIONAL_MANIFEST_FIELD = "deployment_maintenance_limit_ms"


class Failure(Exception):
    pass


# --- Ed25519, affine -------------------------------------------------------

def _add(p: tuple[int, int], q: tuple[int, int]) -> tuple[int, int]:
    x1, y1 = p
    x2, y2 = q
    t = D * x1 * x2 * y1 * y2 % P
    x3 = (x1 * y2 + x2 * y1) * pow(1 + t, -1, P) % P
    y3 = (y1 * y2 + x1 * x2) * pow(1 - t, -1, P) % P
    return x3, y3


def _mul(k: int, p: tuple[int, int]) -> tuple[int, int]:
    acc = (0, 1)
    while k:
        if k & 1:
            acc = _add(acc, p)
        p = _add(p, p)
        k >>= 1
    return acc


def _recover_x(y: int, sign: int) -> int | None:
    if y >= P:
        return None
    u = (y * y - 1) % P
    v = (D * y * y + 1) % P
    x = u * pow(v, 3, P) * pow(u * pow(v, 7, P), (P - 5) // 8, P) % P
    if v * x * x % P == (P - u) % P:
        x = x * SQRT_M1 % P
    elif v * x * x % P != u:
        return None
    if x == 0 and sign:
        return None
    if x & 1 != sign:
        x = P - x
    return x


def _decode(raw: bytes) -> tuple[int, int] | None:
    n = int.from_bytes(raw, "little")
    y = n & ((1 << 255) - 1)
    x = _recover_x(y, n >> 255)
    return None if x is None else (x, y)


def _encode(point: tuple[int, int]) -> bytes:
    x, y = point
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


_BX = _recover_x(BY, 0)
assert _BX is not None
BASE = (_BX, BY)


def _expand(seed: bytes) -> tuple[int, bytes]:
    h = hashlib.sha512(seed).digest()
    a = int.from_bytes(h[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    return a, h[32:]


def public_key(seed: bytes) -> bytes:
    return _encode(_mul(_expand(seed)[0], BASE))


def sign(seed: bytes, message: bytes) -> bytes:
    """Used only by --mutations, to re-sign an edited manifest."""
    a, prefix = _expand(seed)
    public = _encode(_mul(a, BASE))
    r = int.from_bytes(hashlib.sha512(prefix + message).digest(), "little") % L
    big_r = _encode(_mul(r, BASE))
    h = int.from_bytes(hashlib.sha512(big_r + public + message).digest(), "little")
    return big_r + ((r + h * a) % L).to_bytes(32, "little")


def verify(public: bytes, message: bytes, signature: bytes) -> bool:
    if len(signature) != 64 or len(public) != 32:
        return False
    a = _decode(public)
    r = _decode(signature[:32])
    s = int.from_bytes(signature[32:], "little")
    if a is None or r is None or s >= L or _encode(r) != signature[:32]:
        return False
    h = int.from_bytes(
        hashlib.sha512(signature[:32] + public + message).digest(), "little"
    )
    return _mul(s, BASE) == _add(r, _mul(h, a))


# --- canonical JSON, per firmware-telemetry/v1 "Canonical JSON" -------------

_SHORT_ESCAPES = {'"': '\\"', "\\": "\\\\", "\b": "\\b", "\f": "\\f",
                  "\n": "\\n", "\r": "\\r", "\t": "\\t"}


def _string(s: str) -> str:
    out = ['"']
    for ch in s:
        if ch in _SHORT_ESCAPES:
            out.append(_SHORT_ESCAPES[ch])
        elif ord(ch) < 0x20:
            out.append(f"\\u{ord(ch):04x}")
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def _number(n: float) -> str:
    if type(n) is int:
        if abs(n) > 2**53 - 1:
            raise Failure(f"integer {n} outside the canonical range")
        return str(n)
    if not math.isfinite(n):
        raise Failure("non-finite number")
    if n != 0 and not 1e-4 <= abs(n) < 1e16:
        raise Failure(f"number {n!r} outside the canonical zone")
    text = repr(n)
    if "e" in text or "E" in text or "." not in text:
        raise Failure(f"number {n!r} has no fixed-notation form")
    return text


def _emit(value: object) -> str:
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if type(value) in (int, float):
        return _number(value)  # type: ignore[arg-type]
    if type(value) is str:
        return _string(value)
    if type(value) is list:
        return "[" + ",".join(_emit(v) for v in value) + "]"
    if type(value) is dict:
        return "{" + ",".join(
            _string(k) + ":" + _emit(value[k]) for k in sorted(value)
        ) + "}"
    raise Failure(f"no canonical form for {type(value).__name__}")


def canonical(value: object) -> bytes:
    return _emit(value).encode("utf-8")


# --- contract text ---------------------------------------------------------

def _section(text: str, heading: str) -> str:
    start = text.index(heading)
    rest = text[start + len(heading):]
    end = re.search(r"\n#{2,3} ", rest)
    return rest if end is None else rest[: end.start()]


def contract_texts() -> dict[str, str]:
    return {"t1": TELEMETRY_V1.read_text(), "t2": TELEMETRY_V2.read_text()}


def _v1_manifest(t1: str) -> dict:
    block = re.search(r"```json\n(\{\n  \"manifest\".*?)\n```",
                      _section(t1, "## Capability Manifest"), re.DOTALL)
    if block is None:
        raise Failure("v1 carries no example manifest message")
    example = json.loads(block.group(1))["manifest"]

    def options(value: str) -> set[str]:
        return set(value.split("|"))

    channel = example["channels"][0]
    return {
        "fields": set(example) - {OPTIONAL_MANIFEST_FIELD},
        "postures": options(example["posture"]),
        "key_storage": options(example["key_storage"]),
        "transports": set(example["transports"]),
        "channel_fields": set(channel),
        # v1 names no closed sensor_type or unit vocabulary; only the example's
        # values are held supported here.
        "sensor_types": {channel["sensor_type"]},
        "units": {channel["unit"]},
        "protocols": options(channel["protocol"]),
        "sources": options(channel["source"]),
        "action_fields": set(example["actions"][0]),
        "action_names": {example["actions"][0]["action"]},
        "authorities": options(example["actions"][0]["authority"]),
        "interlock_fields": set(example["interlocks"][0]),
    }


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = contract_texts() if texts is None else texts
    t1, t2 = texts["t1"], texts["t2"]
    section = _section(t2, "## Device Mode")
    bridged = re.search(
        r"A channel whose `source` is `([a-z_]+)` is bridged;\s+every other "
        r"channel meters\.", section)
    if bridged is None:
        raise Failure("v2 Device Mode does not say which source is bridged")
    modes: dict[str, object] = {}
    for value, cell in re.findall(r"^\| `([a-z_]+)` \| (.*?) \|\s*$", section, re.MULTILINE):
        single = re.fullmatch(r"(Metering channels|Bridged channels|Actions) only"
                              r"(?:, and no (?:actions|channels))?\.", cell)
        several = re.fullmatch(r"More than one of the three: (.*)\.", cell)
        if single is not None:
            modes[value] = frozenset({ROLE_WORDS[single.group(1).lower()]})
        elif several is not None:
            listed = [w.strip().lower() for w in several.group(1).split(",")]
            if sorted(ROLE_WORDS.get(w, w) for w in listed) != sorted(ROLE_WORDS.values()):
                raise Failure(f"the {value} row does not list the three roles")
            modes[value] = "several"
        else:
            raise Failure(f"cannot read the {value} row: {cell!r}")
    if sorted(m for m in modes.values() if m != "several") != sorted(
        frozenset({r}) for r in ROLE_WORDS.values()
    ) or list(modes.values()).count("several") != 1:
        raise Failure("the mode table does not give each role one mode and "
                      "one mode to several roles")
    reasons = _rules(section, "Device Mode", MODE_RULES)
    field = _section(t2, "### The `controller_profile` field")
    reasons |= _rules(field, "Controller Profiles", PROFILE_RULES)
    v1 = _v1_manifest(t1)
    profile = _profile_grammar(field, _section(t2, "## Controller Profiles"), v1)
    if profile["shared_reason"] != reasons["profile_invalid"]:
        raise Failure("the one-profile rule names another reason than the grammar's")
    reading = re.search(r"A manifest channel reading an `([a-z_]+)` channel declares "
                        r"`sensor_type` `([a-z_]+)` and `unit` `([a-z_]+)`",
                        " ".join(_section(t2, "### The profile document").split()))
    if reading is None or reading.groups()[1:] != (profile["alarm_sensor_type"],
                                                   profile["alarm_unit"]):
        raise Failure("v2 does not say what a manifest channel reading an alarm word declares")
    profile["alarm_kind"] = reading.group(1)
    golden = _section(t2, "## Golden Vectors")
    pins = {}
    for name in ("manifest", "controller-profile"):
        pin = re.search(rf"\[{name}-vectors-v2\.json\]\({name}-vectors-v2\.json\)"
                        r"[^`]*?Its\s+SHA-256\s+is\s+`([0-9a-f]{64})`", golden)
        if pin is None:
            raise Failure(f"firmware-telemetry/v2.md pins no {name} corpus digest")
        pins[name] = pin.group(1)
    return {
        "v1": v1,
        "bridged_source": bridged.group(1),
        "modes": modes,
        "reasons": reasons,
        "profile": profile,
        "pin": pins["manifest"],
        "profile_pin": pins["controller-profile"],
    }


def _rules(section: str, where: str, rules: tuple[str, ...]) -> dict[str, str]:
    """The reason each rule of a "MUST reject a manifest when:" list names."""
    start = re.search(r"MUST\s+reject\s+a\s+manifest\s+when:", section)
    if start is None:
        raise Failure(f"v2 {where} lists no manifest refusals")
    bullets = re.findall(r"^- (.*?)(?=^- |^\S|\Z)", section[start.end():], re.MULTILINE | re.DOTALL)
    codes = [re.findall(r"`([a-z_]+)`\)", " ".join(b.split())) for b in bullets]
    if len(codes) != len(rules) or any(len(c) != 1 for c in codes):
        raise Failure(f"v2 {where} does not list {len(rules)} rules, each with one error")
    for rule, bullet in zip(rules, bullets):
        # Only the trailing error annotation is removed; every other word of
        # the bullet, a parenthesis included, is part of the clause.
        annotated = re.fullmatch(r"(.*) \((?:recommended error )?`[a-z_]+`\)[;.]",
                                 " ".join(bullet.split()))
        clause = annotated.group(1) if annotated else " ".join(bullet.split())
        if clause != RULE_CLAUSES[rule]:
            raise Failure(f"v2 {where}'s {rule} clause reads {clause!r}, "
                          f"not {RULE_CLAUSES[rule]!r}")
    return {rule: c[0] for rule, c in zip(rules, codes)}


def _alphabet(spec: str) -> frozenset[str]:
    chars: set[str] = set()
    for item in re.split(r", (?:and )?| and ", spec):
        pair = re.fullmatch(r"`(.)`–`(.)`", item)
        single = re.fullmatch(r"`(.)`", item)
        if pair is not None:
            chars.update(chr(c) for c in range(ord(pair.group(1)), ord(pair.group(2)) + 1))
        elif single is not None:
            chars.add(single.group(1))
        else:
            raise Failure(f"cannot read the fleet alphabet item {item!r}")
    return frozenset(chars)


def _profile_grammar(field: str, intro_text: str, v1: dict) -> dict:
    """The `controller_profile` grammar and the two rule tokens, from v2.md."""
    block = re.search(r"```json\n(\{.*?)\n```", field, re.DOTALL)
    if block is None:
        raise Failure("v2 carries no example channel with a controller_profile")
    example = json.loads(block.group(1))
    added = set(example) - v1["channel_fields"]
    if len(added) != 1 or not v1["channel_fields"] <= set(example):
        raise Failure("v2's example channel does not add exactly one field to v1's")
    name = added.pop()
    rows = re.findall(r"^\| `([a-z_]+)` \| ([a-z ]+) \| (.*) \|$", field, re.MULTILINE)
    if [r[0] for r in rows] != list(PROFILE_ROWS) or set(example[name]) != set(PROFILE_ROWS):
        raise Failure(f"v2's {name} rows {[r[0] for r in rows]} are not {list(PROFILE_ROWS)}")
    cells = {}
    for key, kind, notes in rows:
        wanted_kind, pattern = PROFILE_ROWS[key]
        match = re.fullmatch(pattern, notes)
        if kind != wanted_kind or match is None:
            raise Failure(f"v2's {key} row reads {kind!r}, {notes!r}")
        cells[key] = match.groups()
    flat = " ".join(field.split())
    if KEYS_SENTENCE not in flat:
        raise Failure(f"v2 no longer says {KEYS_SENTENCE!r}")
    same = re.search(SAME_PROFILE, flat)
    if (same is None or same.group(1) != "id" or not set(same.groups()[1:4]) <= set(PROFILE_ROWS)
            or (same.group(5), same.group(6)) != ("digest", same.group(1))):
        raise Failure("v2 does not say which fields channels naming one profile share")
    intro = intro_text.strip().split("\n\n")
    fleet_paragraph = next((p for p in intro if p.startswith("A fleet identifier")), "")
    fleet = re.fullmatch(FLEET_SENTENCE, " ".join(fleet_paragraph.split()))
    if fleet is None:
        raise Failure("v2 does not define the fleet identifier where this script reads it")
    record = re.search(RECORD_SENTENCE, flat)
    if record is None or len({record.group(3), record.group(4), record.group(5)}) != 1:
        raise Failure("v2's record sentence does not read as this script holds it")
    clause = RULE_CLAUSES["profile_invalid"]
    protocol = re.search(r"`protocol` is not `([a-z_]+)`", clause)
    tokens = re.search(r"declares `sensor_type` `([a-z_]+)` or `unit` `([a-z_]+)`",
                       RULE_CLAUSES["alarm_channel"])
    assert protocol is not None and tokens is not None
    if protocol.group(1) not in v1["protocols"]:
        raise Failure("the bridged protocol is not one of v1's")
    qualifications = frozenset(cells["qualification"])
    if cells["record"][0] not in qualifications:
        raise Failure("the record row names no qualification")
    prefix, hex_len, lower = cells["digest"]
    return {
        "field": name,
        "keys": frozenset(PROFILE_ROWS),
        "types": {k: (str, type(None)) if kind == "string or null" else (str,)
                  for k, kind, _ in rows},
        "fleet": (int(fleet.group(1)), int(fleet.group(2)), _alphabet(fleet.group(3))),
        "digest": (prefix, int(hex_len),
                   frozenset("0123456789abcdef" if lower else "0123456789abcdefABCDEF")),
        "qualifications": qualifications,
        "unrecorded": cells["record"][0],
        "record": (int(record.group(1)), int(record.group(2)), record.group(3),
                   record.group(6)),
        "protocol": protocol.group(1),
        "shared": same.groups()[1:4],
        "shared_reason": same.group(7),
        "alarm_sensor_type": tokens.group(1),
        "alarm_unit": tokens.group(2),
    }


# --- consumer model --------------------------------------------------------

def derive_mode(manifest: dict, model: dict) -> str | None:
    roles = {
        "bridged" if c["source"] == model["bridged_source"] else "metering"
        for c in manifest["channels"]
    }
    if manifest["actions"]:
        roles.add("actions")
    for mode, wanted in model["modes"].items():
        if wanted == "several" and len(roles) > 1:
            return mode
        if wanted == frozenset(roles):
            return mode
    return None


def v1_fault(message: dict, context: dict, public: bytes, model: dict,
             vocabulary: tuple[set[str], set[str]]) -> str | None:
    """Return why the v1 checks modelled here refuse the message, or None."""
    v1 = model["v1"]
    sensor_types, units = vocabulary
    shapes = (v1["channel_fields"], v1["channel_fields"] | {model["profile"]["field"]})
    if type(message) is not dict or set(message) != {"manifest", "manifest_hash", "signature"}:
        return "message fields"
    m = message["manifest"]
    if type(m) is not dict or not v1["fields"] <= set(m) <= v1["fields"] | {OPTIONAL_MANIFEST_FIELD}:
        return "manifest fields"
    if OPTIONAL_MANIFEST_FIELD in m:
        return "the corpus does not exercise the optional field"
    if type(m["v"]) is not int or m["v"] != 1 or m["alg"] != "ed25519":
        return "v or alg"
    if m["device_id"] != context["device_id"]:
        return "device_id"
    if m["public_key_b64"] != context["public_key_b64"]:
        return "public_key_b64"
    body = canonical(m)
    if message["manifest_hash"] != "sha256:" + hashlib.sha256(body).hexdigest():
        return "manifest_hash"
    wire = message["signature"]
    if type(wire) is not str or not wire.startswith("ed25519:"):
        return "signature encoding"
    try:
        raw = base64.b64decode(wire[8:], validate=True)
    except ValueError:
        return "signature base64"
    if base64.b64encode(raw).decode() != wire[8:] or not verify(public, body, raw):
        return "signature"
    for name in ("firmware_version", "board_profile"):
        if type(m[name]) is not str or not m[name]:
            return name
    if m["posture"] not in v1["postures"] or m["key_storage"] not in v1["key_storage"]:
        return "posture or key_storage"
    flags = (m["secure_boot_enabled"], m["flash_encryption_enabled"])
    if any(type(f) is not bool for f in flags):
        return "posture booleans"
    if m["posture"] != "development" and not all(flags):
        return "posture disagrees with its booleans"
    if (type(m["transports"]) is not list or not m["transports"]
            or not set(m["transports"]) <= v1["transports"]):
        return "transports"
    for name in ("channels", "actions", "interlocks"):
        if type(m[name]) is not list:
            return name
    seen = set()
    for c in m["channels"]:
        if type(c) is not dict or set(c) not in shapes:
            return "channel fields"
        if c["channel"] in seen:
            return "duplicate channel"
        seen.add(c["channel"])
        if any(type(c[k]) is not str for k in ("sensor_type", "unit", "protocol", "source")):
            return "channel strings"
        if (c["sensor_type"] not in sensor_types or c["unit"] not in units
                or c["protocol"] not in v1["protocols"] or c["source"] not in v1["sources"]):
            return "unsupported channel"
        q = c["quality_floor"]
        if type(q) not in (int, float) or not 0 <= q <= 1:
            return "quality_floor"
    for a in m["actions"]:
        if (type(a) is not dict or set(a) != v1["action_fields"]
                or a["action"] not in v1["action_names"]
                or a["authority"] not in v1["authorities"]):
            return "action"
    for i in m["interlocks"]:
        if type(i) is not dict or set(i) != v1["interlock_fields"]:
            return "interlock"
        if i["channel"] not in seen or i["action"] not in {a["action"] for a in m["actions"]}:
            return "interlock names an undeclared channel or action"
    return None


def profile_faults(binding: object, channel: dict, model: dict,
                   off: frozenset[str] = frozenset()) -> set[str]:
    """Every `controller_profile` grammar clause a bridged channel breaks."""
    g = model["profile"]
    faults = set()
    if channel["source"] == model["bridged_source"] and channel["protocol"] != g["protocol"]:
        faults.add("protocol")
    if g["field"] not in channel:
        return faults
    if type(binding) is not dict:
        return faults | {"not_object"}
    if set(binding) - g["keys"]:
        faults.add("keys_extra")
    if g["keys"] - set(binding):
        faults.add("keys_missing")
    for key, kinds in g["types"].items():
        if key in binding and type(binding[key]) not in kinds:
            faults.add(f"{key}_type")
    low, high, chars = g["fleet"]
    for key in ("id", "profile_channel"):
        value = binding.get(key)
        if type(value) is str:
            if not low <= len(value) <= high:
                faults.add(f"{key}_length")
            if not set(value) <= chars:
                faults.add(f"{key}_chars")
    prefix, size, digits = g["digest"]
    digest = binding.get("digest")
    if type(digest) is str:
        if not digest.startswith(prefix):
            faults.add("digest_prefix")
        else:
            if len(digest) != len(prefix) + size:
                faults.add("digest_length")
            if not set(digest[len(prefix):]) <= digits:
                faults.add("digest_digits")
    qualification = binding.get("qualification")
    known = type(qualification) is str and qualification in g["qualifications"]
    content = "type_also_content" in off
    if (type(qualification) is str or (content and "qualification" in binding)) and not known:
        faults.add("qualification")
    elif known and "record" in binding and (
            content or type(binding["record"]) in (str, type(None))):
        unrecorded = qualification == g["unrecorded"]
        if binding["record"] is None and not unrecorded:
            faults.add("record_missing")
        if binding["record"] is not None and unrecorded:
            faults.add("record_unexpected")
    record = binding.get("record")
    if type(record) is str:
        low, high, separator, parent = g["record"]
        if not low <= len(record) <= high:
            faults.add("record_length")
        if not set(record) <= chars | {separator}:
            faults.add("record_chars")
        if record.startswith(separator):
            faults.add("record_leading")
        if record.endswith(separator):
            faults.add("record_trailing")
        if separator * 2 in record:
            faults.add("record_double_separator")
        if parent in record:
            faults.add("record_dotdot")
    return faults


def broken_rules(manifest: dict, model: dict, off: frozenset[str]) -> set[str]:
    """Every v2 manifest rule the manifest breaks, not only the first."""
    mode = manifest["device_mode"]
    broken = set()
    defined = type(mode) is str and mode in model["modes"]
    if not defined:
        broken.add("mode_undefined")
    elif mode != derive_mode(manifest, model):
        broken.add("mode_disagrees")
    if not manifest["channels"]:
        broken.add("channels_empty")
    g = model["profile"]
    for c in manifest["channels"]:
        bridged = c["source"] == model["bridged_source"]
        if bridged and g["field"] not in c:
            broken.add("profile_missing")
        if not bridged and g["field"] in c:
            broken.add("profile_unexpected")
        if profile_faults(c.get(g["field"]), c, model, off):
            broken.add("profile_invalid")
        alarm_type = c["sensor_type"] == g["alarm_sensor_type"]
        alarm_unit = c["unit"] == g["alarm_unit"]
        if (alarm_type or alarm_unit) and not (bridged and alarm_type and alarm_unit):
            broken.add("alarm_channel")
    if consistency_faults(manifest, model) and "profile_consistency" not in off:
        broken.add("profile_invalid")
    return broken - off


def consistency_faults(manifest: dict, model: dict) -> set[str]:
    """Which shared fields differ between channels that name one profile id."""
    g = model["profile"]
    groups: dict[str, list[dict]] = {}
    for c in manifest["channels"]:
        b = c.get(g["field"])
        if type(b) is dict and type(b.get("id")) is str:
            groups.setdefault(b["id"], []).append(b)
    faults = set()
    for bindings in groups.values():
        for key in g["shared"]:
            if len({json.dumps(b.get(key), sort_keys=True) for b in bindings}) > 1:
                faults.add(f"one_id_two_{key}")
    ids: dict[str, set[str]] = {}
    for c in manifest["channels"]:
        b = c.get(g["field"])
        if type(b) is dict and type(b.get("digest")) is str and type(b.get("id")) is str:
            ids.setdefault(b["digest"], set()).add(b["id"])
    if any(len(v) > 1 for v in ids.values()):
        faults.add("one_digest_two_id")
    return faults


def profile_documents(profiles: dict, model: dict) -> dict[str, dict]:
    """The profile corpus's accepted documents, by this script's digest of each."""
    documents = {}
    for case in profiles["cases"]:
        digest = "sha256:" + hashlib.sha256(canonical(case["document"])).hexdigest()
        if case["digest"] != digest:
            raise Failure(f"profile {case['name']}: digest is not its document's")
        documents[digest] = case["document"]
    return documents


def vocabulary(documents: dict[str, dict], model: dict) -> tuple[set[str], set[str]]:
    v1, g = model["v1"], model["profile"]
    sensor_types = v1["sensor_types"] | {g["alarm_sensor_type"]}
    units = v1["units"] | {g["alarm_unit"]}
    for doc in documents.values():
        for c in doc["channels"]:
            if "sensor_type" in c:
                sensor_types.add(c["sensor_type"])
                units.add(c["unit"])
    return sensor_types, units


def binding_fault(channel: dict, documents: dict[str, dict], model: dict) -> str | None:
    """Why the profile corpus does not hold what an accepted channel names."""
    g = model["profile"]
    binding = channel[g["field"]]
    doc = documents.get(binding["digest"])
    if doc is None:
        return "names no document of the profile corpus"
    if doc["id"] != binding["id"]:
        return f"names {binding['id']}, the document is {doc['id']}"
    named = [c for c in doc["channels"] if c["name"] == binding["profile_channel"]]
    if len(named) != 1:
        return f"the document has no channel {binding['profile_channel']}"
    if named[0]["kind"] == g["alarm_kind"]:
        wanted = (g["alarm_sensor_type"], g["alarm_unit"])
    else:
        wanted = (named[0]["sensor_type"], named[0]["unit"])
    if (channel["sensor_type"], channel["unit"]) != wanted:
        return f"declares {channel['sensor_type']}/{channel['unit']}, the profile {wanted}"
    return None


CONTRACT = "ori-specs/firmware-telemetry/v2.md"
CORPUS_VERSION = 2
TOP_KEYS = {"contract", "version", "comment", "test_seed_hex", "public_key_hex",
            "public_key_b64", "signature_encoding", "verifier_context", "reasons", "cases",
            "reject_cases"}
CASE_KEYS = {"name", "message", "canonical_hex", "canonical_sha256_hex", "message_hex", "note"}
REJECT_KEYS = CASE_KEYS | {"reason", "signature_valid"}


def _shapes(corpus: dict) -> None:
    """The corpus and each of its entries carry exactly their keys."""
    if type(corpus) is not dict or set(corpus) != TOP_KEYS:
        raise Failure(f"corpus keys {sorted(corpus)} are not {sorted(TOP_KEYS)}")
    if (type(corpus["contract"]) is not str or corpus["contract"] != CONTRACT
            or type(corpus["version"]) is not int or corpus["version"] != CORPUS_VERSION):
        raise Failure(f"corpus names {corpus['contract']!r} v{corpus['version']!r}, not "
                      f"{CONTRACT} v{CORPUS_VERSION}")
    for section, keys in (("cases", CASE_KEYS), ("reject_cases", REJECT_KEYS)):
        for entry in corpus[section]:
            if type(entry) is not dict or set(entry) != keys:
                raise Failure(f"{section} entry {entry.get('name')!r} has keys "
                              f"{sorted(entry)}, not {sorted(keys)}")
            if type(entry["note"]) is not str or type(entry["name"]) is not str:
                raise Failure(f"{section} entry {entry['name']!r}: name or note not a string")


def check(corpus: dict, model: dict, profiles: dict,
          off: frozenset[str] = frozenset()) -> None:
    _shapes(corpus)
    documents = profile_documents(profiles, model)
    words = vocabulary(documents, model)
    seed = bytes.fromhex(corpus["test_seed_hex"])
    public = public_key(seed)
    if corpus["public_key_hex"] != public.hex():
        raise Failure("public key does not derive from the seed")
    context = corpus["verifier_context"]
    if set(context) != {"device_id", "public_key_b64"}:
        raise Failure("verifier context is not a provisioning anchor")
    for where in (context["public_key_b64"], corpus["public_key_b64"]):
        if base64.b64decode(where, validate=True) != public:
            raise Failure("a public_key_b64 names another key")
    declared = set(model["reasons"].values())
    if set(corpus["reasons"]) != declared:
        raise Failure(f"corpus reasons {sorted(corpus['reasons'])} are not the "
                      f"contract's {sorted(declared)}")

    def common(case: dict) -> dict:
        message = case["message"]
        manifest = message["manifest"]
        body = canonical(manifest)
        if bytes.fromhex(case["canonical_hex"]) != body:
            raise Failure(f"{case['name']}: canonical bytes")
        if case["canonical_sha256_hex"] != hashlib.sha256(body).hexdigest():
            raise Failure(f"{case['name']}: digest")
        if bytes.fromhex(case["message_hex"]) != canonical(message):
            raise Failure(f"{case['name']}: wire message")
        why = v1_fault(message, context, public, model, words)
        if why is not None:
            raise Failure(f"{case['name']}: not otherwise valid under v1 ({why})")
        return manifest

    names = set()
    for case in corpus["cases"] + corpus["reject_cases"]:
        if case["name"] in names:
            raise Failure(f"duplicate case {case['name']}")
        names.add(case["name"])

    for case in corpus["cases"]:
        manifest = common(case)
        broken = broken_rules(manifest, model, off)
        if broken:
            raise Failure(f"{case['name']}: refused ({sorted(broken)})")
        if "mode_disagrees" not in off and manifest["device_mode"] != derive_mode(manifest, model):
            raise Failure(f"{case['name']}: mode is not the one its arrays determine")
        for c in manifest["channels"]:
            if model["profile"]["field"] in c:
                why = binding_fault(c, documents, model)
                if why is not None:
                    raise Failure(f"{case['name']}: {c['channel']} {why}")

    for case in corpus["reject_cases"]:
        manifest = common(case)
        if case["signature_valid"] is not True:
            raise Failure(f"{case['name']}: a refusal here must carry a valid signature")
        if case["reason"] not in declared:
            raise Failure(f"{case['name']}: undeclared reason {case['reason']}")
        reasons = {model["reasons"][r] for r in broken_rules(manifest, model, off)}
        if reasons != {case["reason"]}:
            raise Failure(f"{case['name']}: refused for {sorted(reasons)}, "
                          f"not exactly {case['reason']}")

    accepted = [c["message"]["manifest"] for c in corpus["cases"]]
    refused = [(c["reason"], c["message"]["manifest"]) for c in corpus["reject_cases"]]
    roles = sorted(ROLE_WORDS.values())
    for size in (1, 2, 3):
        for combo in itertools.combinations(roles, size):
            if combo == ("actions",):
                continue
            if not any(_roles(m, model) == set(combo) for m in accepted):
                raise Failure(f"coverage: no accepted case over {combo}")
    if any(_roles(m, model) == {"actions"} or not m["channels"] for m in accepted):
        raise Failure("coverage: a manifest with no channel is accepted")
    undefined = model["reasons"]["mode_undefined"]
    for mode in model["modes"]:
        if not any(r == model["reasons"]["mode_disagrees"] and m["device_mode"] == mode
                   and m["channels"] for r, m in refused):
            raise Failure(f"coverage: {mode} is never refused over other arrays")
    for kind in (int, type(None), str):
        if not any(r == undefined and type(m["device_mode"]) is kind
                   for r, m in refused):
            raise Failure(f"coverage: no undefined {kind.__name__} mode")
    if not any(m["device_mode"] == "sensor_node" and m["actions"] for _, m in refused):
        raise Failure("coverage: sensor_node with an action is not refused")
    if not any(r == model["reasons"]["channels_empty"] and m["actions"]
               and derive_mode(m, model) == m["device_mode"] for r, m in refused):
        raise Failure("coverage: no refusal for empty channels alone")
    _profile_coverage(accepted, refused, model, off)


def _bound_coverage(accepted: list[dict], refused: list[tuple[str, dict]],
                    model: dict) -> dict[str, bool]:
    """Each end of each bound the grammar reads accepted, one past each refused."""
    g = model["profile"]
    prefix, size, _ = g["digest"]
    low, high, _ = g["fleet"]
    pairs = {
        "fleet identifier length": ((low, high), ("id", "profile_channel"), 0),
        "record length": (g["record"][:2], ("record",), 0),
        "digest hex length": ((size, size), ("digest",), len(prefix)),
    }

    def lengths(manifests: list[dict], fields: tuple[str, ...], skip: int) -> set[int]:
        out = set()
        for m in manifests:
            for c in m["channels"]:
                b = c.get(g["field"])
                if type(b) is not dict:
                    continue
                for f in fields:
                    v = b.get(f)
                    if type(v) is str and (not skip or v.startswith(prefix)):
                        out.add(len(v) - skip)
        return out

    invalid = model["reasons"]["profile_invalid"]
    wanted = {}
    for label, ((first, last), fields, skip) in pairs.items():
        good = lengths(accepted, fields, skip)
        bad = lengths([m for r, m in refused if r == invalid], fields, skip)
        for end, past in ((first, first - 1), (last, last + 1)):
            wanted[f"{label} accepted at {end}"] = end in good
            wanted[f"{label} refused at {past}"] = past in bad
    return wanted


def _profile_coverage(accepted: list[dict], refused: list[tuple[str, dict]],
                      model: dict, off: frozenset[str]) -> None:
    g = model["profile"]
    bindings = [[c[g["field"]] for c in m["channels"] if g["field"] in c] for m in accepted]
    wanted: dict[str, bool] = {}
    for q in sorted(g["qualifications"]):
        wanted[f"{q} profile accepted"] = any(b["qualification"] == q
                                              for bs in bindings for b in bs)
    wanted["alarm-word channel accepted"] = any(
        c["sensor_type"] == g["alarm_sensor_type"] for m in accepted for c in m["channels"])
    wanted["two channels reading one profile accepted"] = any(
        len(bs) > len({b["digest"] for b in bs}) for bs in bindings)
    wanted.update(_bound_coverage(accepted, refused, model))
    for reason in set(model["reasons"].values()):
        wanted[f"a refusal for {reason}"] = any(r == reason for r, _ in refused)
    invalid = model["reasons"]["profile_invalid"]
    alone = set()
    for r, m in refused:
        if r == invalid:
            faults: set[str] = set()
            for c in m["channels"]:
                faults |= profile_faults(c.get(g["field"]), c, model, off)
            faults |= consistency_faults(m, model)
            faults -= {IMPLIED[f] for f in faults if f in IMPLIED}
            if len(faults) == 1:
                alone |= faults
    for clause in PROFILE_CLAUSES:
        wanted[f"a refusal breaking {clause} alone"] = clause in alone
    # "even inside a segment": the parent token within a segment, not as one.
    _, _, separator, parent = g["record"]
    wanted[f"a refusal with {parent} inside a record segment"] = any(
        r == invalid and any(
            type(b := c.get(g["field"])) is dict and type(b.get("record")) is str
            and any(parent in seg and seg != parent for seg in b["record"].split(separator))
            for c in m["channels"]) for r, m in refused)
    misuse = model["reasons"]["alarm_channel"]
    for bridged, tokens in itertools.product((True, False), ((1, 0), (0, 1), (1, 1))):
        if bridged and tokens == (1, 1):
            continue
        label = (f"{'a bridged' if bridged else 'an unbridged'} channel declaring "
                 f"{['', 'the alarm sensor_type'][tokens[0]]}"
                 f"{' and ' if tokens == (1, 1) else ''}"
                 f"{['', 'the alarm unit'][tokens[1]]}"
                 f"{' alone' if tokens != (1, 1) else ''}")
        wanted[label] = any(r == misuse and any(
            (c["source"] == model["bridged_source"]) == bridged
            and (int(c["sensor_type"] == g["alarm_sensor_type"]),
                 int(c["unit"] == g["alarm_unit"])) == tokens
            for c in m["channels"]) for r, m in refused)
    missing = sorted(k for k, ok in wanted.items() if not ok)
    if missing:
        raise Failure(f"coverage: {missing}")


def _roles(manifest: dict, model: dict) -> set[str]:
    roles = {
        "bridged" if c["source"] == model["bridged_source"] else "metering"
        for c in manifest["channels"]
    }
    return roles | ({"actions"} if manifest["actions"] else set())


def run(corpus_bytes: bytes, model: dict, off: frozenset[str] = frozenset(),
        profile_bytes: bytes | None = None) -> None:
    profile_bytes = PROFILES.read_bytes() if profile_bytes is None else profile_bytes
    if hashlib.sha256(corpus_bytes).hexdigest() != model["pin"]:
        raise Failure("corpus digest differs from the one firmware-telemetry/v2.md pins")
    if hashlib.sha256(profile_bytes).hexdigest() != model["profile_pin"]:
        raise Failure("profile corpus digest differs from the one v2.md pins")
    check(json.loads(corpus_bytes), model, json.loads(profile_bytes), off)


# --- mutations -------------------------------------------------------------

def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)
    profiles = json.loads(PROFILES.read_bytes())
    seed = bytes.fromhex(base["test_seed_hex"])

    def resign(case: dict) -> None:
        manifest = case["message"]["manifest"]
        body = canonical(manifest)
        case["message"]["manifest_hash"] = "sha256:" + hashlib.sha256(body).hexdigest()
        case["message"]["signature"] = "ed25519:" + base64.b64encode(sign(seed, body)).decode()
        case["canonical_hex"] = body.hex()
        case["canonical_sha256_hex"] = hashlib.sha256(body).hexdigest()
        case["message_hex"] = canonical(case["message"]).hex()

    def find(collection: str, name: str) -> Callable[[dict], dict]:
        return lambda c: next(x for x in c[collection] if x["name"] == name)

    bridge = find("cases", "bridge_node")
    mixed_all = find("cases", "mixed_all_three")
    no_channels = find("reject_cases", "reject_actuator_node_no_channels")
    null_mode = find("reject_cases", "reject_mode_null")
    sensor_action = find("reject_cases", "reject_sensor_node_with_action")

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check(mutated, model, profiles)
        return go

    def edited(pick: Callable[[dict], dict], **fields: object) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            case = pick(c)
            case["message"]["manifest"].update(fields)
            resign(case)
        return edit

    def flip_signature(c: dict) -> None:
        case = bridge(c)
        raw = bytearray(base64.b64decode(case["message"]["signature"][8:]))
        raw[40] ^= 1
        case["message"]["signature"] = "ed25519:" + base64.b64encode(bytes(raw)).decode()
        case["message_hex"] = canonical(case["message"]).hex()

    def two_reasons(c: dict) -> None:
        case = copy.deepcopy(no_channels(c))
        case["name"] = "two_reasons"
        case["message"]["manifest"].update(actions=[])
        resign(case)
        c["reject_cases"].append(case)

    def profile_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(profiles)
            edit(mutated)
            check(copy.deepcopy(base), model, mutated)
        return go

    def rename_voltage(p: dict) -> None:
        doc = p["cases"][0]["document"]
        next(c for c in doc["channels"] if c["name"] == "output_voltage")["name"] = "volts"
        p["cases"][0]["digest"] = "sha256:" + hashlib.sha256(canonical(doc)).hexdigest()

    qualified = find("cases", "bridge_node_qualified")
    alarm_case = find("cases", "bridge_node_alarm_word")
    generator_digest = next(x["digest"] for x in profiles["cases"] if x["name"] == "generator")

    def without_profile(case: dict) -> dict:
        channel = dict(case["message"]["manifest"]["channels"][0])
        del channel["controller_profile"]
        return channel

    def rechannel(pick: Callable[[dict], dict], name: str,
                  **fields: object) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            case = pick(c)
            channel = next(x for x in case["message"]["manifest"]["channels"]
                           if x["channel"] == name)
            channel.update(copy.deepcopy(fields))
            resign(case)
        return edit

    def rebind(pick: Callable[[dict], dict], name: str,
               **fields: object) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            case = pick(c)
            channel = next(x for x in case["message"]["manifest"]["channels"]
                           if x["channel"] == name)
            channel["controller_profile"].update(fields)
            resign(case)
        return edit

    def two_profile_reasons(c: dict) -> None:
        case = find("reject_cases", "reject_bridged_without_profile")(c)
        case["message"]["manifest"]["channels"][0]["protocol"] = "i2c"
        resign(case)

    def text_mutant(key: str, old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            if old not in texts[key]:
                raise AssertionError(f"mutant target missing from {key}: {old!r}")
            texts[key] = texts[key].replace(old, new, 1)
            run(corpus_bytes, contract_model(texts))
        return go

    def model_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            run(corpus_bytes, mutated)
        return go

