"""Check the restated-records corpus against evidence-exchange/v3.

`evidence-exchange/vectors/receiver-state/restated-records-v3.json` fixes what a
runtime does with a verified inbound artifact that names a fact it already
holds a final record of. Shares no code with
scripts/generate-evidence-exchange-receiver-state-vectors-v3, and was written
without reading it: every expected value is recomputed here from the contract.

- every artifact's preimage, authenticator and binding are recomputed from the
  published material the file carries: the custody MAC under the generation
  its derived `key_id` selects, every Ed25519 signature under the key
  `(purpose, key_id)` selects from a registry this script holds to the
  registry rules, and each receipt's `range_digest` over the sealed chain rows;
- each case's answer, reason, applied sequences and every held record after
  are recomputed from the restatement rules, all or nothing, the store-fault
  rule, step 6 of the disposition verification, and runtime-health/v4's
  application-storage fault signal, then compared with the literal;
- every held record before is a state those rules can reach;
- every case class the Test vectors paragraph names is present, as a property
  of the cases rather than of their names.

The agree/conflict table and the field tables are read from the text, and the
text the rules come from is pinned unit for unit in
scripts/evidence-exchange-restatement-pinned-units.json, so a reworded rule
fails here rather than passing unread.

The case schema, the store-fault points and where each applies, and the
active-epoch projection's members are read from the text, and the effective
epoch is the epoch the projection names, so it is checked through the
projection rather than as a record of its own.

    python3 scripts/check-evidence-exchange-receiver-state-vectors-v3
    python3 scripts/check-evidence-exchange-receiver-state-vectors-v3 --mutations

Requires the `cryptography` package; refuses to run without it rather than
skipping the signatures. Lists every disagreement, not only the first.
"""

from __future__ import annotations

import base64
import copy
import hashlib
import hmac
import json
import pathlib
import re
import sys
from collections.abc import Callable
from typing import Any, NoReturn

try:
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey,
        Ed25519PublicKey,
    )
except ImportError:  # pragma: no cover - the gate must not pass silently
    print(
        "check-evidence-exchange-receiver-state-vectors-v3: the cryptography package is required",
        file=sys.stderr,
    )
    sys.exit(1)

NAME = "check-evidence-exchange-receiver-state-vectors-v3"
ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "evidence-exchange" / "v3.md"
HEALTH = ROOT / "runtime-health" / "v4.md"
CORPUS = ROOT / "evidence-exchange" / "vectors" / "receiver-state" / "restated-records-v3.json"
PINNED = ROOT / "scripts" / "evidence-exchange-restatement-pinned-units.json"


class Failure(Exception):
    pass


def fail(message: str) -> NoReturn:
    raise Failure(message)


# --- the pinned text ---------------------------------------------------------------------

TEXT_BLOCKS = (
    # The same rules restated elsewhere in the contract: a rewording of any of them fails here.
    (CONTRACT, "- **Restated records.** A verified artifact that restates", "Each party's conformance claim"),
    (CONTRACT, "A verified acknowledgement for an envelope whose custody is already recorded",
     "### Delivery receipt"),
    (CONTRACT, "A runtime receiving a receipt whose range includes sequences it already holds",
     "**What a receipt does and does not prove.**"),
    (CONTRACT, "A runtime refuses a verified epoch confirmation whose `device_id` is not its",
     "What this exchange takes from"),
    (CONTRACT, "- The first record of a fact is final.", "## Chain row format"),
    (CONTRACT, "6. Its effect is not already in force", "**Effects at the runtime.**"),
    (CONTRACT, "## Restated records", "## Three state models"),
    (CONTRACT, "| Custody ack byte-identical to the one whose custody is held", "### Test vectors"),
    (CONTRACT, "**Restated records** are fixed by", "**Dispositions** are fixed by"),
    (HEALTH, "#### Application-storage fault", "#### Awaiting-receipt age"),
)


def _norm(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def _block_units(block: str) -> list[str]:
    units: list[str] = []
    for paragraph in re.split(r"\n\s*\n", block):
        lines = paragraph.strip().splitlines()
        if not lines:
            continue
        if lines[0].lstrip().startswith("|"):
            units.extend(
                _norm(line)
                for line in lines
                if line.strip() and not re.fullmatch(r"\|[\s:|-]+\|", line.strip())
            )
        else:
            prose = _norm(paragraph)
            units.extend(u for u in re.split(r"(?<=[.:;])\s+(?=[A-Z`*\[(])", prose) if u)
    return units


def _block(body: str, start_marker: str, end_marker: str, source: pathlib.Path) -> tuple[int, int]:
    start = body.find(start_marker)
    end = body.find(end_marker, start)
    if start < 0 or end < start:
        fail(f"{source.name} lacks the block starting {start_marker[:50]!r}")
    return start, end


def units_of(texts: dict) -> list[str]:
    units: list[str] = []
    for source, start_marker, end_marker in TEXT_BLOCKS:
        body = texts[source]
        start, end = _block(body, start_marker, end_marker, source)
        units.extend(_block_units(body[start:end]))
    return units


def read_texts() -> dict:
    return {
        CONTRACT: CONTRACT.read_text(encoding="utf-8"),
        HEALTH: HEALTH.read_text(encoding="utf-8"),
    }


def check_contract_text(texts: dict) -> None:
    units = units_of(texts)
    pinned = json.loads(PINNED.read_text(encoding="utf-8"))
    if units != pinned:
        added = [u for u in units if u not in pinned]
        removed = [u for u in pinned if u not in units]
        fail(
            "the restatement text differs from the pinned units, in content or order. Re-pinning "
            "is a semantic change: update scripts/evidence-exchange-restatement-pinned-units.json "
            "only together with this corpus and, where a rule changed, this checker\n"
            + "".join(f"  + {u}\n" for u in added)
            + "".join(f"  - {u}\n" for u in removed)
        )


