ARTIFACT_TITLES = {
    "custody_acknowledgement": "Custody acknowledgement",
    "delivery_receipt": "Delivery receipt",
    "epoch_confirmation": "Epoch confirmation",
    "evidence_disposition": "Evidence disposition",
}
AUTHENTICATOR = {"custody_acknowledgement": "mac"}
HELD_MEMBERS = (
    "custody", "receipts", "epoch_confirmations", "active_epoch", "registration_obligations",
    "dispositions", "stops", "application_storage_fault",
)
STORE_FAULT_POINTS = ("at_read", "after_first_write", "at_commit", "at_refusal_record")
REFUSAL_RECORD = "at_refusal_record"
STOP_MEMBERS = {"scope", "anchor_epoch_id"}
# The held records, as the restated-records table names them. Member names are the file's;
# what each holds is the table's.
RECORD_MEMBERS = {
    "custody": {"local_seq", "custody_at_ms", "key_id", "recorded_at_ms"},
    "receipts": {"local_seq", "accepted_at_ms", "key_id"},
    "epoch_confirmations": {"device_id", "anchor_epoch_id", "pubkey_hex", "actor",
                            "confirmed_at_ms", "key_id", "applied_at_ms"},
    "registration_obligations": {"anchor_epoch_id", "pubkey_hex", "state", "closed_at_ms"},
    "dispositions": {"triggering_digest", "anchor_epoch_id", "scope", "disposition",
                     "decided_at_ms", "key_id", "artifact_digest"},
}
DISPOSITION_BODY = ("triggering_digest", "anchor_epoch_id", "scope", "disposition",
                    "decided_at_ms", "key_id")


def _table(text: str, header: str) -> list[list[str]]:
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if _norm(line) == header:
            rows = []
            for row in lines[i + 2:]:
                if not row.strip().startswith("|"):
                    break
                rows.append([c.strip() for c in row.strip().strip("|").split("|")])
            return rows
    fail(f"the contract has no table headed {header!r}")
    return []


def _section(text: str, heading: str) -> str:
    start = text.find("\n" + heading + "\n")
    if start < 0:
        fail(f"the contract has no section {heading!r}")
    end = text.find("\n#", start + len(heading) + 2)
    return text[start:end]


def contract_rules(texts: dict) -> dict:
    """Read every rule the model applies from the text."""
    text = texts[CONTRACT]
    pinned = "\n".join(units_of(texts))
    for key, sentence in REQUIRED_SENTENCES.items():
        if _norm(sentence) not in pinned:
            fail(
                f"the contract no longer states the {key!r} rule word for word; changing it "
                "changes this checker, never only the pin"
            )
    rules: dict[str, Any] = {}
    domains = {}
    for row in _table(text, "| Artifact | Domain | Algorithm | Key purpose |"):
        domains[row[0]] = row
    rules["domain"], rules["purpose"], rules["algorithm"] = {}, {}, {}
    for kind, title in ARTIFACT_TITLES.items():
        if title not in domains:
            fail(f"the domain table has no row for {title}")
        _, domain, algorithm, purpose = domains[title]
        found = re.fullmatch(r"`([a-z0-9_.]+)\\0`", domain)
        if found is None:
            fail(f"the {title} domain is not an ASCII string with its NUL: {domain!r}")
        rules["domain"][kind] = found.group(1).encode("ascii") + b"\0"
        rules["algorithm"][kind] = algorithm
        rules["purpose"][kind] = purpose.strip("`")
    rules["fields"] = {}
    for kind, title in ARTIFACT_TITLES.items():
        rows = _table(_section(text, "### " + title), "| Field | Type | Notes |")
        rules["fields"][kind] = {r[0].strip("`"): r[1].strip("`") for r in rows}
    rules["values"] = {
        r[0].strip("`"): r[1].strip("`")
        for r in _table(text, "| `disposition` | `scope` | Terminal | Meaning |")
    }
    rules["reasons"] = [r[0].strip("`") for r in _table(text, "| Reason | Meaning |")]
    rules["agreement"] = {}
    for row in _table(text, "| Artifact | Agrees when | Conflicts when |"):
        kind = next((k for k, t in ARTIFACT_TITLES.items() if t == row[0]), None)
        if kind is None:
            fail(f"the agreement table names an artifact this checker does not know: {row[0]!r}")
        agrees, conflicts = row[1], row[2]
        compared = re.match(r"Its ((?:`\w+`(?:, | and )?)+) (?:equals|each equal) the held", agrees)
        if agrees.startswith("Always, once it is verified.") and conflicts.startswith("Never."):
            rules["agreement"][kind] = ("always",)
        elif agrees.startswith("v2's rule, unchanged: a byte-identical repetition") \
                and conflicts.startswith("Never: a disposition with no new effect is refused "
                                         "`superseded`"):
            rules["agreement"][kind] = ("byte_identical",)
        elif compared is not None:
            fields = re.findall(r"`(\w+)`", compared.group(1))
            named = re.findall(r"`(\w+)`", conflicts.split(" differs")[0])
            if set(named) != set(fields) and not (
                    len(fields) > 1 and conflicts.startswith("Any one of them differs")):
                fail(f"the {row[0]} row compares {fields} and conflicts on {named}")
            rules["agreement"][kind] = ("fields", tuple(fields))
        else:
            fail(f"the {row[0]} agreement rule is not one this checker reads: {agrees[:60]!r}")
    if set(rules["agreement"]) != set(ARTIFACT_TITLES):
        fail("the agreement table does not carry exactly the four inbound artifacts")
    small = _table(text, "| y, as 32 little-endian bytes | Points of small order |")
    rules["small_order_y"] = {r[0].strip("`") for r in small}
    salt = re.search(r'salt\s+= "([^"]+)" as ASCII, no NUL', text)
    info = re.search(r'info\s+= "([^"]+)" as ASCII, no NUL', text)
    length = re.search(r"length = (\d+) bytes", text)
    if not (salt and info and length):
        fail("the custody key_id derivation is not stated as this checker reads it")
    rules["hkdf"] = (salt.group(1).encode(), info.group(1).encode(), int(length.group(1)))
    schema(text, rules)
    rules["defects"] = defect_reasons(text)
    integers = re.search(r"Integers\s+satisfy `\|n\| <= (\d+)`", text)
    if integers is None:
        fail("the contract no longer states the integer domain as this checker reads it")
    rules["int_max"] = int(integers.group(1))
    if set(rules["defects"].values()) - set(rules["reasons"]):
        fail("a defect's reason is outside the vocabulary")
    return rules


PROJECTION_SENTENCE = re.compile(
    r"Its members are ((?:`\w+`(?:, | and )?)+), each equal to the confirmation record's for that "
    r"epoch")


def schema(text: str, rules: dict) -> None:
    """The case schema the Test vectors paragraph states, held against this model's."""
    block = text[text.find("**Restated records** are fixed by"):text.find("**Dispositions** are fixed by")]
    tables = [t for t in re.split(r"\n\s*\n", block) if t.lstrip().startswith("| Member | Content |")]
    if len(tables) != 2:
        fail("the Test vectors paragraph no longer carries the case and held-record tables")
    case_rows = _table(tables[0], "| Member | Content |")
    members = [m for row in case_rows for m in re.findall(r"`(\w+)`", row[0])]
    if set(members) != set(CASE_KEYS) or len(members) != len(CASE_KEYS):
        fail(f"the text's case members {members} are not this model's")
    fault = next(r[1] for r in case_rows if r[0] == "`store_fault`")
    points = re.findall(r"`(\w+)`, (?:on|at) ", fault)
    if tuple(points) != STORE_FAULT_POINTS \
            or "which applies only to an application that writes more than one record" not in fault \
            or "at the commit of an application that writes at least one record" not in fault \
            or "before any decision" not in fault \
            or ("on writing the record of a refusal already decided, which applies only to a "
                "decided refusal: the answer is that refusal with its reason, every held record is "
                "unchanged, and the signal is raised") not in fault:
        fail(f"the store_fault points or where each applies are not as this model reads them: "
             f"{points}")
    rules["fault_min_writes"] = {"at_read": 0, "after_first_write": 2, "at_commit": 1}
    answer = next(r[1] for r in case_rows if r[0] == "`expected`")
    if f"a store fault at any point but `{REFUSAL_RECORD}`, which answers `reject`" not in answer:
        fail("the expected row no longer answers a refusal-record fault with the refusal")
    held_rows = _table(tables[1], "| Member | Content |")
    order = [row[0].strip("`") for row in held_rows]
    if order != list(HELD_MEMBERS):
        fail(f"the text's held members {order} are not this model's {list(HELD_MEMBERS)}")
    shapes = {}
    for row in held_rows:
        braces = re.search(r"`\{([^}]*)\}`", row[1])
        shapes[row[0].strip("`")] = None if braces is None else {
            m.strip() for m in braces.group(1).split(",")}
    for member, wanted in RECORD_MEMBERS.items():
        if shapes.get(member) != wanted:
            fail(f"the text gives {member} records {shapes.get(member)}, this model {wanted}")
    if shapes.get("stops") != STOP_MEMBERS:
        fail(f"the text gives stop records {shapes.get('stops')}")
    projection = PROJECTION_SENTENCE.search(_norm(text))
    named = set(re.findall(r"`(\w+)`", projection.group(1))) if projection else None
    if named is None or named != shapes.get("active_epoch") \
            or not named < RECORD_MEMBERS["epoch_confirmations"]:
        fail(f"the active-epoch projection's members {named} disagree with its table row "
             f"{shapes.get('active_epoch')} or are not the confirmation record's")
    rules["projection"] = named


# --- crypto and canonical bytes ----------------------------------------------------------

P = 2**255 - 19
D = (-121665 * pow(121666, P - 2, P)) % P


def canonical(obj: Any) -> bytes:
    return json.dumps(
        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def hkdf(ikm: bytes, salt: bytes, info: bytes, length: int) -> bytes:
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    out, block, counter = b"", b"", 1
    while len(out) < length:
        block = hmac.new(prk, block + info + bytes([counter]), hashlib.sha256).digest()
        out += block
        counter += 1
    return out[:length]


L_ORDER = 2**252 + 27742317777372353535851937790883648493


def _ed_add(p1: tuple, p2: tuple) -> tuple:
    x1, y1, z1, t1 = p1
    x2, y2, z2, t2 = p2
    a, b = (y1 - x1) * (y2 - x2) % P, (y1 + x1) * (y2 + x2) % P
    c, d = 2 * t1 * t2 * D % P, 2 * z1 * z2 % P
    e, f, g, h = b - a, d - c, d + c, b + a
    return e * f % P, g * h % P, f * g % P, e * h % P


def _ed_mul(k: int, point: tuple) -> tuple:
    out = (0, 1, 1, 0)
    while k:
        if k & 1:
            out = _ed_add(out, point)
        point, k = _ed_add(point, point), k >> 1
    return out


def _ed_encode(point: tuple) -> bytes:
    x, y, z, _ = point
    zi = pow(z, P - 2, P)
    x, y = x * zi % P, y * zi % P
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def _ed_base() -> tuple:
    y = 4 * pow(5, P - 2, P) % P
    x2 = (y * y - 1) * pow(D * y * y + 1, P - 2, P) % P
    x = pow(x2, (P + 3) // 8, P)
    if (x * x - x2) % P:
        x = x * pow(2, (P - 1) // 4, P) % P
    if x & 1:
        x = P - x
    return x, y, 1, x * y % P


def sign_with_nonce(seed: bytes, message: bytes, nonce: bytes) -> bytes:
    """An RFC 8032 signature whose r comes from `nonce` rather than the key's prefix: as valid as
    the deterministic one, and different bytes, so a re-signed artifact with the same body."""
    h = hashlib.sha512(seed).digest()
    a = int.from_bytes(h[:32], "little") & ((1 << 254) - 8) | (1 << 254)
    base = _ed_base()
    public = _ed_encode(_ed_mul(a, base))
    r = int.from_bytes(hashlib.sha512(b"alternate" + nonce + message).digest(), "little") % L_ORDER
    big_r = _ed_encode(_ed_mul(r, base))
    k = int.from_bytes(hashlib.sha512(big_r + public + message).digest(), "little") % L_ORDER
    return big_r + ((r + k * a) % L_ORDER).to_bytes(32, "little")


def refused_point(public_hex: str, small_order_y: set[str]) -> str | None:
    """RFC 8032 section 5.1.3 decoding and the small-order rule, as the registry section states."""
    raw = bytes.fromhex(public_hex)
    n = int.from_bytes(raw, "little")
    sign, y = n >> 255, n & ((1 << 255) - 1)
    if y >= P:
        return "y is not below p"
    u, v = (y * y - 1) % P, (D * y * y + 1) % P
    x2 = u * pow(v, P - 2, P) % P
    if x2 != 0 and pow(x2, (P - 1) // 2, P) != 1:
        return "no square root"
    if x2 == 0 and sign:
        return "x is 0 and the sign bit is set"
    if raw[:31].hex() + format(raw[31] & 0x7F, "02x") in small_order_y:
        return "small order"
    return None


# --- the published material --------------------------------------------------------------

def material(corpus: dict, rules: dict, out: list[str]) -> dict:
    keys: dict[str, dict] = {}
    registry = corpus["authority_key_registry"]
    if set(registry) != {"schema", "keys"} or registry["schema"] != "ori.evidence_authority_keys.v1" \
            or not isinstance(registry["keys"], list) or not registry["keys"]:
        out.append("[material] authority_key_registry is not a registry document")
        return {"authority": {}, "custody": {}}
    purposes = set(rules["purpose"].values()) - {"gateway_custody"}
    seen: dict[str, str] = {}
    for key in registry["keys"]:
        if set(key) != {"key_id", "public_key_hex", "purpose", "status"} \
                or not all(isinstance(v, str) for v in key.values()):
            out.append(f"[material] registry key with members {sorted(key)}")
            continue
        if not re.fullmatch(r"[0-9a-f]{64}", key["public_key_hex"]):
            out.append(f"[material] public_key_hex {key['public_key_hex']!r}")
            continue
        derived = "sha256:" + hashlib.sha256(bytes.fromhex(key["public_key_hex"])).hexdigest()
        if key["key_id"] != derived:
            out.append(f"[material] registry key_id {key['key_id']} does not derive")
        if key["purpose"] not in purposes or key["status"] not in ("active", "verify_only", "revoked"):
            out.append(f"[material] registry key {key['key_id']} purpose or status")
        if key["key_id"] in seen:
            out.append(f"[material] registry key_id {key['key_id']} held twice")
        seen[key["key_id"]] = key["purpose"]
        why = refused_point(key["public_key_hex"], rules["small_order_y"])
        if why:
            out.append(f"[material] registry key {key['key_id']} refused: {why}")
        seed = corpus["authority_seeds"].get(key["key_id"])
        if seed is None or Ed25519PrivateKey.from_private_bytes(bytes.fromhex(seed)).public_key() \
                .public_bytes_raw().hex() != key["public_key_hex"]:
            out.append(f"[material] no published seed reproduces {key['key_id']}")
        keys[key["key_id"]] = key
    for purpose in {k["purpose"] for k in keys.values()}:
        active = [k for k in keys.values() if k["purpose"] == purpose and k["status"] == "active"]
        if len(active) != 1:
            out.append(f"[material] {purpose} holds {len(active)} active keys")
    if set(corpus["authority_seeds"]) != set(keys):
        out.append("[material] authority_seeds name keys the registry does not hold")
    custody: dict[str, dict] = {}
    reg = corpus["custody_registry"]
    if set(reg) != {"active", "verify_only"}:
        out.append(f"[material] custody_registry holds {sorted(reg)}")
    for status, generation in reg.items():
        secret = bytes.fromhex(generation["secret_hex"])
        try:
            secret.decode("utf-8")
        except UnicodeDecodeError:
            out.append(f"[material] custody {status} secret is not UTF-8")
        derived = "hkdf-sha256:" + hkdf(secret, *rules["hkdf"]).hex()
        if generation["key_id"] != derived:
            out.append(f"[material] custody {status} key_id does not derive from its secret")
        if derived in custody:
            out.append("[material] two custody generations derive one key_id")
        custody[derived] = {"status": status, "secret": secret}
    return {"authority": keys, "custody": custody}


# Each defect whose reason the vocabulary assigns by its own wording: the phrase that assigns
# it, found in exactly one reason's Meaning cell, gives the reason.
DEFECT_PHRASES = {
    "range_domain": "`from_seq` is below `1`, or `to_seq` is below `from_seq`",
    "range_digest": "a receipt's `range_digest` does not match the chain rows this runtime sealed "
                    "for its range",
    "range_unsealed": "or a receipt's range includes one",
    "local_seq_unsealed": "The artifact names a `local_seq` this runtime has not sealed",
    "disposition_version": "a disposition whose `v` is not `1`",
    "version": "The `v` of a custody acknowledgement, a delivery receipt or an epoch "
               "confirmation is not a version this receiver interprets",
}


def defect_reasons(text: str) -> dict[str, str]:
    rows = _table(text, "| Reason | Meaning |")
    out = {}
    for defect, phrase in DEFECT_PHRASES.items():
        owners = [r[0].strip("`") for r in rows if phrase in r[1]]
        if len(owners) != 1:
            fail(f"the vocabulary assigns {defect} to {owners}, not one reason")
        out[defect] = owners[0]
    if "decided from the bytes alone" not in next(
            r[1] for r in rows if r[0].strip("`") == out["range_domain"]):
        fail("the vocabulary no longer decides a receipt's range domain from the bytes alone")
    return out


def verify(case: dict, corpus: dict, rules: dict, mat: dict) -> list[str]:
    """Every check the contract orders before application. A failure is tagged with the reason
    the vocabulary refuses it for, `[refused:<reason>]`."""
    kind, art, where = case["artifact_type"], case["artifact"], case["name"]
    why = rules["defects"]

    def refused(reason: str, detail: str) -> str:
        return f"[refused:{reason}] {where}: {detail}"

    out: list[str] = []
    fields = rules["fields"].get(kind)
    if fields is None:
        return [f"[shape] {where}: artifact_type {kind!r} is not an inbound artifact"]
    if not isinstance(art, dict) or set(art) != set(fields):
        return [refused("malformed", f"artifact members are not exactly {sorted(fields)}")]
    for name, typ in fields.items():
        if (typ == "int") is not (type(art[name]) is int) or (typ == "string") is not isinstance(
                art[name], str):
            out.append(refused("malformed", f"{name} is not {typ}"))
    if any(type(art[f]) is int and abs(art[f]) > rules["int_max"] for f in fields):
        out.append(refused("malformed", "an integer outside the canonical domain"))
    if out:
        return out
    if art["v"] != 1:
        return [refused(why["disposition_version"] if kind == "evidence_disposition"
                        else why["version"], "v is not 1")]
    if kind == "delivery_receipt" and (art["from_seq"] < 1 or art["to_seq"] < art["from_seq"]):
        return [refused(why["range_domain"], "the range is not a closed interval of sequences")]
    if kind == "evidence_disposition" and rules["values"].get(art["disposition"]) != art["scope"]:
        return [refused("malformed", "disposition and scope are not a permitted pair")]
    tag = AUTHENTICATOR.get(kind, "signature")
    body = {k: v for k, v in art.items() if k != tag}
    preimage = rules["domain"][kind] + canonical(body)
    if case["canonical_hex"] != preimage.hex():
        out.append(f"[canonical] {where}: canonical_hex is not the domain, NUL and canonical body")
    if case["authenticator"] != "valid":
        out.append(f"[authenticator] {where}: authenticator is not 'valid'")
    if kind == "custody_acknowledgement":
        if not re.fullmatch(r"hkdf-sha256:[0-9a-f]{32}", art["key_id"]) \
                or not re.fullmatch(r"hmac-sha256:[0-9a-f]{64}", art["mac"]):
            return out + [refused("malformed", "key_id or mac shape")]
        generation = mat["custody"].get(art["key_id"])
        if generation is None:
            return out + [refused("unknown_key", "custody key_id held by no generation")]
        if not hmac.compare_digest(
                "hmac-sha256:" + hmac.new(generation["secret"], preimage, hashlib.sha256).hexdigest(),
                art["mac"]):
            return out + [refused("bad_authenticator", "MAC does not verify under its generation")]
    else:
        sig = art["signature"]
        if not re.fullmatch(r"ed25519:[A-Za-z0-9+/]{86}==", sig):
            return out + [refused("malformed", "signature shape")]
        key = mat["authority"].get(art["key_id"])
        purpose = rules["purpose"][kind]
        if key is None:
            return out + [refused("unknown_key", "key_id held for no purpose")]
        if key["purpose"] != purpose:
            return out + [refused("wrong_purpose", f"key_id held for {key['purpose']}")]
        if key["status"] not in ("active", "verify_only"):
            return out + [refused("retired_key", f"key_id held {key['status']}")]
        try:
            Ed25519PublicKey.from_public_bytes(bytes.fromhex(key["public_key_hex"])).verify(
                base64.b64decode(sig[len("ed25519:"):], validate=True), preimage)
        except (InvalidSignature, ValueError):
            return out + [refused("bad_authenticator", "signature does not verify under its key")]
    if art["device_id"] != corpus["device"]["device_id"]:
        return out + [refused("binding_mismatch", "device_id is not the receiver's")]
    envelopes = {e["local_seq"]: e for e in corpus["sealed_envelopes"]}
    if kind == "custody_acknowledgement":
        env = envelopes.get(art["local_seq"])
        if env is None:
            out.append(refused(why["local_seq_unsealed"], "local_seq not sealed"))
        elif env["envelope_digest"] != art["envelope_digest"]:
            out.append(refused("binding_mismatch", "envelope_digest is not the sealed envelope's"))
    elif kind == "delivery_receipt":
        span = range(art["from_seq"], art["to_seq"] + 1)
        if any(s not in envelopes for s in span):
            out.append(refused(why["range_unsealed"], "the range includes a sequence not sealed"))
        else:
            digest = "sha256:" + hashlib.sha256(b"".join(
                bytes.fromhex(envelopes[s]["chain_row_digest"].removeprefix("sha256:"))
                for s in span)).hexdigest()
            if digest != art["range_digest"]:
                out.append(refused(why["range_digest"],
                                   "range_digest is not over the sealed chain rows"))
    elif kind == "epoch_confirmation":
        if {"anchor_epoch_id": art["anchor_epoch_id"], "pubkey_hex": art["pubkey_hex"]} \
                not in corpus["sealed_registrations"]:
            out.append(refused("binding_mismatch", "epoch and key are not a sealed registration"))
    else:
        sealed = {e["envelope_digest"]: e["anchor_epoch_id"] for e in corpus["sealed_envelopes"]}
        sealed |= {a["digest"]: a["anchor_epoch_id"] for a in corpus["sealed_artifacts"]}
        named = next((a for a in corpus["sealed_artifacts"]
                      if a["digest"] == art["triggering_digest"]), None)
        # The Test vectors schema: this corpus's dispositions name only `sealed_artifacts`, never
        # a registration; registration-bound dispositions live in the v2 disposition corpus.
        if art["triggering_digest"] in sealed and (named is None
                                                   or named["artifact_type"] == "anchor_registration"):
            out.append(f"[schema] {where}: a disposition here names only a sealed artifact that is "
                       "not a registration")
        if art["triggering_digest"] not in sealed:
            out.append(refused("binding_mismatch", "triggering_digest names nothing sealed"))
        elif art["anchor_epoch_id"] != sealed[art["triggering_digest"]] and not (
                art["anchor_epoch_id"] == "" and art["scope"] == "artifact"):
            out.append(refused("binding_mismatch", "anchor_epoch_id is not the sealed artifact's"))
    return out


# --- held state ---------------------------------------------------------------------------

def stop_in_force(disposition: dict, stops: list[dict]) -> bool:
    """Step 6's stop already in force. An identity stop covers every epoch of the identity, so it
    is in force for any epoch or identity disposition; an epoch stop only for its own epoch."""
    if any(s["scope"] == "identity" for s in stops):
        return True
    return disposition["scope"] == "epoch" and stop_of(disposition) in stops


def stop_of(disposition: dict) -> dict:
    """The stop record an epoch or identity disposition produces, as the schema gives it."""
    return {"scope": disposition["scope"],
            "anchor_epoch_id": disposition["anchor_epoch_id"] if disposition["scope"] == "epoch"
            else ""}


def projection_of(record: dict, members: set[str]) -> dict:
    return {k: record[k] for k in sorted(members)}


SHA256_ID = re.compile(r"sha256:[0-9a-f]{64}")
CUSTODY_ID = re.compile(r"hkdf-sha256:[0-9a-f]{32}")
PUBKEY = re.compile(r"[0-9a-f]{64}")


def held_values(state: dict, corpus: dict, rules: dict, where: str) -> list[str]:
    """Every held field's type and domain, every held key one the material holds for the
    artifact's purpose, and every held record bound to this receiver."""
    out: list[str] = []
    top = rules["int_max"]

    def bad(member: str, field: str, value: Any) -> None:
        out.append(f"[state] {where}: {member}.{field} {value!r} is outside its domain")

    def integer(member: str, field: str, value: Any, least: int = -top, null: bool = False) -> None:
        if (value is None and null) or (type(value) is int and least <= value <= top):
            return
        bad(member, field, value)

    def authority_key(member: str, value: Any, kind: str) -> None:
        purpose = rules["purpose"][kind]
        if not (isinstance(value, str) and SHA256_ID.fullmatch(value) and any(
                k["key_id"] == value and k["purpose"] == purpose
                for k in corpus["authority_key_registry"]["keys"])):
            bad(member, "key_id", value)

    def epoch(member: str, field: str, value: Any, sealed_only: bool = True) -> None:
        if not (isinstance(value, str) and SHA256_ID.fullmatch(value)) or (
                sealed_only and value not in {r["anchor_epoch_id"] for r in corpus["sealed_registrations"]}):
            bad(member, field, value)

    custody_ids = {g["key_id"] for g in corpus["custody_registry"].values()}
    for r in state["custody"]:
        integer("custody", "local_seq", r["local_seq"], 1)
        integer("custody", "custody_at_ms", r["custody_at_ms"])
        integer("custody", "recorded_at_ms", r["recorded_at_ms"], null=True)
        if not (isinstance(r["key_id"], str) and CUSTODY_ID.fullmatch(r["key_id"])
                and r["key_id"] in custody_ids):
            bad("custody", "key_id", r["key_id"])
    for r in state["receipts"]:
        integer("receipts", "local_seq", r["local_seq"], 1)
        integer("receipts", "accepted_at_ms", r["accepted_at_ms"])
        authority_key("receipts", r["key_id"], "delivery_receipt")
    device = corpus["device"]["device_id"]
    for member, records in (("epoch_confirmations", state["epoch_confirmations"]),
                            ("active_epoch", [state["active_epoch"]] if state["active_epoch"] else [])):
        for r in records:
            if r.get("device_id") != device:
                bad(member, "device_id", r.get("device_id"))
            epoch(member, "anchor_epoch_id", r.get("anchor_epoch_id"))
            if not (isinstance(r.get("pubkey_hex"), str) and PUBKEY.fullmatch(r["pubkey_hex"])):
                bad(member, "pubkey_hex", r.get("pubkey_hex"))
            if not (isinstance(r.get("actor"), str) and r["actor"]):
                bad(member, "actor", r.get("actor"))
            integer(member, "confirmed_at_ms", r.get("confirmed_at_ms"))
            if "applied_at_ms" in r:
                integer(member, "applied_at_ms", r["applied_at_ms"])
            authority_key(member, r.get("key_id"), "epoch_confirmation")
    for o in state["registration_obligations"]:
        epoch("registration_obligations", "anchor_epoch_id", o["anchor_epoch_id"])
        if o["state"] not in ("open", "confirmed"):
            bad("registration_obligations", "state", o["state"])
        integer("registration_obligations", "closed_at_ms", o["closed_at_ms"], null=True)
    # Step 5: the subject is an artifact this runtime sealed, the disposition names that
    # subject's epoch, `""` only under `artifact` scope, and a `retained_pending` names an anchor
    # registration. A sealed registration carries no digest here, so none can be named.
    subjects = {a["digest"]: (a["artifact_type"], a["anchor_epoch_id"])
                for a in corpus["sealed_artifacts"] if a["artifact_type"] != "anchor_registration"}
    for r in state["dispositions"]:
        subject = subjects.get(r["triggering_digest"])
        if subject is None:
            bad("dispositions", "triggering_digest", r["triggering_digest"])
        elif r["anchor_epoch_id"] == "" and r["scope"] == "artifact":
            pass
        elif r["anchor_epoch_id"] != subject[1]:
            bad("dispositions", "anchor_epoch_id", (r["anchor_epoch_id"], "subject", subject[1]))
        if subject is not None and r["disposition"] == "retained_pending" \
                and subject[0] != "anchor_registration":
            bad("dispositions", "disposition", ("retained_pending names", subject[0]))
        if not (r["anchor_epoch_id"] == "" and r["scope"] == "artifact"):
            epoch("dispositions", "anchor_epoch_id", r["anchor_epoch_id"])
        if rules["values"].get(r["disposition"]) != r["scope"]:
            bad("dispositions", "scope", (r["scope"], r["disposition"]))
        integer("dispositions", "decided_at_ms", r["decided_at_ms"])
        authority_key("dispositions", r["key_id"], "evidence_disposition")
        # The digest is over the held disposition's own wire bytes. A held record's artifact is
        # not carried, so the digest must be one this script can rebuild: that of a corpus
        # artifact with this body, or of this body signed under the published seed by RFC 8032's
        # deterministic signature. A digest of the unsigned preimage is neither.
        if not (isinstance(r["artifact_digest"], str) and SHA256_ID.fullmatch(r["artifact_digest"])):
            bad("dispositions", "artifact_digest", r["artifact_digest"])
        elif r["artifact_digest"] not in rebuildable_digests(r, corpus, rules):
            out.append(f"[fixture] {where}: dispositions.artifact_digest {r['artifact_digest']!r}: "
                       "this checker cannot reconstruct the artifact it names from this corpus, "
                       "neither as a carried artifact nor as the body signed deterministically "
                       "under its published seed. A fixture limit of this corpus, not a contract "
                       "refusal; the case is still refused.")
    for r in state["stops"]:
        if not isinstance(r, dict) or set(r) != STOP_MEMBERS or r["scope"] not in ("epoch", "identity"):
            bad("stops", "scope", r)
        elif r["scope"] == "epoch":
            epoch("stops", "anchor_epoch_id", r["anchor_epoch_id"])
        elif r["anchor_epoch_id"] != "":
            # An identity stop covers every epoch of the identity and names none.
            bad("stops", "anchor_epoch_id", r["anchor_epoch_id"])
    return out


def _rec(corpus: dict, rules: dict, fields: dict) -> dict:
    """A held disposition record with the digest of its body signed under the published seed."""
    body = {k: fields[k] for k in DISPOSITION_BODY}
    digests = rebuildable_digests({**body, "artifact_digest": ""}, corpus,
                                  {**rules, "disposition_digests": {}})
    return {**body, "artifact_digest": next(iter(digests))}


def rebuildable_digests(record: dict, corpus: dict, rules: dict) -> set[str]:
    body = tuple(record[k] for k in DISPOSITION_BODY)
    found = set(rules.get("disposition_digests", {}).get(json.dumps(body), set()))
    seed = corpus["authority_seeds"].get(record["key_id"])
    if seed is not None:
        artifact = {**{k: record[k] for k in DISPOSITION_BODY}, "v": 1,
                    "device_id": corpus["device"]["device_id"]}
        preimage = rules["domain"]["evidence_disposition"] + canonical(artifact)
        artifact["signature"] = "ed25519:" + base64.b64encode(
            Ed25519PrivateKey.from_private_bytes(bytes.fromhex(seed)).sign(preimage)).decode()
        found.add(wire_digest(artifact))
    return found


def check_state(state: Any, corpus: dict, where: str, projection: set[str],
                rules: dict | None = None) -> list[str]:
    """A held state these rules can reach."""
    if not isinstance(state, dict) or list(state) != list(HELD_MEMBERS):
        return [f"[state] {where}: members are not {list(HELD_MEMBERS)}"]
    out: list[str] = []
    for member, wanted in RECORD_MEMBERS.items():
        records = state[member]
        if not isinstance(records, list) or any(
                not isinstance(r, dict) or set(r) != wanted for r in records):
            out.append(f"[state] {where}: {member} records are not {sorted(wanted)}")
            return out
    if rules is not None:
        out += held_values(state, corpus, rules, where)
        # A fixture limit is reported and still refuses the case, but it is not a statement
        # about the held state, so the state is still judged.
        if any(not f.startswith("[fixture]") for f in out):
            return out
    sealed = {e["local_seq"] for e in corpus["sealed_envelopes"]}
    for member in ("custody", "receipts"):
        seqs = [r["local_seq"] for r in state[member]]
        if seqs != sorted(set(seqs)) or not set(seqs) <= sealed:
            out.append(f"[state] {where}: {member} not ascending, unique and sealed")
    confirmed = {}
    for record in state["epoch_confirmations"]:
        binding = {"anchor_epoch_id": record["anchor_epoch_id"], "pubkey_hex": record["pubkey_hex"]}
        if binding not in corpus["sealed_registrations"] or record["anchor_epoch_id"] in confirmed:
            out.append(f"[state] {where}: confirmation for {record['anchor_epoch_id'][:15]} unreachable")
        confirmed[record["anchor_epoch_id"]] = record
    obligations = state["registration_obligations"]
    if [{"anchor_epoch_id": o["anchor_epoch_id"], "pubkey_hex": o["pubkey_hex"]}
            for o in obligations] != corpus["sealed_registrations"]:
        out.append(f"[state] {where}: not one obligation per sealed registration, in order")
    for o in obligations:
        record = confirmed.get(o["anchor_epoch_id"])
        if o["state"] not in ("open", "confirmed") or (o["state"] == "confirmed") is not (
                record is not None) or (o["closed_at_ms"] is None) is not (o["state"] == "open"):
            out.append(f"[state] {where}: obligation {o['anchor_epoch_id'][:15]} state")
        # One application closes the obligation and records the confirmation, at one
        # `receiver_now_ms`, with the key the registration sealed.
        elif record is not None and (o["closed_at_ms"] != record["applied_at_ms"]
                                     or o["pubkey_hex"] != record["pubkey_hex"]):
            out.append(f"[state] {where}: obligation {o['anchor_epoch_id'][:15]} closed at "
                       f"{o['closed_at_ms']}, its confirmation applied at {record['applied_at_ms']}")
    active = state["active_epoch"]
    if active is not None:
        # An earlier receiver may have left a projection that disagrees with its confirmation
        # record; the text leaves it as found, so only its shape and epoch are held here.
        record = confirmed.get(active.get("anchor_epoch_id")) if isinstance(active, dict) else None
        if record is None or set(active) != projection:
            out.append(f"[state] {where}: active_epoch is not a projection of a held confirmation")
    stops = []
    for record in state["dispositions"]:
        if record["scope"] in ("epoch", "identity"):
            stops.append(stop_of(record))
    if state["stops"] != stops:
        out.append(f"[state] {where}: stops are not those the held dispositions produce")
    # In application order, nothing stop-producing follows an identity stop: once it is in force
    # every later epoch or identity disposition is superseded and records nothing.
    after_identity = False
    for record in state["stops"]:
        if isinstance(record, dict) and after_identity:
            out.append(f"[state] {where}: a {record.get('scope')} stop applied after an identity stop")
            break
        if isinstance(record, dict) and record.get("scope") == "identity":
            after_identity = True
    # Every record is final and of one fact: a repeat is applied with no new state, and a
    # second disposition whose stop is in force is `superseded`, so no record repeats.
    for member, key in (("dispositions", lambda r: json.dumps(r, sort_keys=True)),
                        ("stops", lambda r: json.dumps(r, sort_keys=True)),
                        ("epoch_confirmations", lambda r: r["anchor_epoch_id"]),
                        ("custody", lambda r: r["local_seq"]),
                        ("receipts", lambda r: r["local_seq"]),
                        ("registration_obligations",
                         lambda r: (r["anchor_epoch_id"], r["pubkey_hex"]))):
        keys = [key(r) for r in state[member]]
        if len(set(keys)) != len(keys):
            out.append(f"[state] {where}: {member} holds a final record twice")
    scoped = [json.dumps(stop_of(r), sort_keys=True) for r in state["dispositions"]
              if r["scope"] in ("epoch", "identity")]
    if len(set(scoped)) != len(scoped):
        out.append(f"[state] {where}: two stop-producing dispositions for one scope")
    if type(state["application_storage_fault"]) is not bool:
        out.append(f"[state] {where}: application_storage_fault is not a bool")
    return out


# --- the model ----------------------------------------------------------------------------

def restates(kind: str, art: dict, held: dict) -> Any:
    """The held record the artifact restates, or None when it names no held fact."""
    if kind == "custody_acknowledgement":
        return next((r for r in held["custody"] if r["local_seq"] == art["local_seq"]), None)
    if kind == "delivery_receipt":
        span = range(art["from_seq"], art["to_seq"] + 1)
        held_seqs = [r for r in held["receipts"] if r["local_seq"] in span]
        return held_seqs or None
    if kind == "epoch_confirmation":
        return next((r for r in held["epoch_confirmations"]
                     if r["anchor_epoch_id"] == art["anchor_epoch_id"]), None)
    # Byte identity of the complete signed artifact: its wire-bytes digest, never its body.
    return next((r for r in held["dispositions"] if r["artifact_digest"] == wire_digest(art)), None)


def wire_digest(art: dict) -> str:
    """`sha256:` over the wire bytes: the complete artifact, its signature included."""
    return "sha256:" + hashlib.sha256(canonical(art)).hexdigest()


def disposition_record(art: dict) -> dict:
    return {**{k: art[k] for k in DISPOSITION_BODY}, "artifact_digest": wire_digest(art)}


def decide(case: dict, corpus: dict, rules: dict) -> dict:
    """The answer and every held record after, recomputed. `writes` counts changed records."""
    kind, art = case["artifact_type"], case["artifact"]
    before, now = case["held_before"], case["receiver_now_ms"]
    after = copy.deepcopy(before)
    rule = rules["agreement"][kind]
    held = restates(kind, art, before)
    expected, reason, applied, writes = "accept", None, None, 0
    if kind == "custody_acknowledgement":
        if held is None:
            after["custody"].append({"local_seq": art["local_seq"], "custody_at_ms": art["custody_at_ms"],
                                     "key_id": art["key_id"], "recorded_at_ms": now})
            after["custody"].sort(key=lambda r: r["local_seq"])
            writes = 1
        elif rule[0] == "fields" and all(art[f] == held[f] for f in rule[1]):
            if held["recorded_at_ms"] is None:
                next(r for r in after["custody"] if r["local_seq"] == art["local_seq"])[
                    "recorded_at_ms"] = now
                writes = 1
        else:
            expected, reason = "reject", "restatement_conflict"
    elif kind == "delivery_receipt":
        if rule != ("always",):
            fail("the receipt rule is no longer 'always agrees'; this checker has no other model")
        have = {r["local_seq"] for r in before["receipts"]}
        applied = [s for s in range(art["from_seq"], art["to_seq"] + 1) if s not in have]
        after["receipts"] += [{"local_seq": s, "accepted_at_ms": art["accepted_at_ms"],
                               "key_id": art["key_id"]} for s in applied]
        after["receipts"].sort(key=lambda r: r["local_seq"])
        writes = len(applied)
    elif kind == "epoch_confirmation":
        if held is not None:
            if rule[0] != "fields" or any(art[f] != held[f] for f in rule[1]):
                expected, reason = "reject", "restatement_conflict"
        else:
            record = {k: art[k] for k in RECORD_MEMBERS["epoch_confirmations"] - {"applied_at_ms"}}
            record["applied_at_ms"] = now
            after["epoch_confirmations"].append(record)
            for o in after["registration_obligations"]:
                if o["anchor_epoch_id"] == art["anchor_epoch_id"] and o["pubkey_hex"] == art["pubkey_hex"]:
                    o["state"], o["closed_at_ms"] = "confirmed", now
            writes = 2
            if art["anchor_epoch_id"] == corpus["device"]["sealing_epoch"]:
                after["active_epoch"] = projection_of(record, rules["projection"])
                writes = 3
    else:
        if rule != ("byte_identical",):
            fail("the disposition rule is no longer v2's byte-identical repeat")
        if held is not None:
            pass
        elif art["scope"] in ("epoch", "identity") and stop_in_force(art, before["stops"]):
            expected, reason = "reject", "superseded"
        elif art["scope"] in ("epoch", "identity"):
            after["dispositions"].append(disposition_record(art))
            after["stops"].append(stop_of(art))
            writes = 2
        elif art["scope"] == "artifact" and art["disposition"] == "artifact_terminal":
            # Bound to an artifact other than a registration, it is recorded and has no delivery
            # effect, whatever stop is in force: step 6 supersedes only epoch and identity ones.
            after["dispositions"].append(disposition_record(art))
            writes = 1
        else:
            fail(f"{case['name']}: a {art['scope']} {art['disposition']} first application is "
                 "not modelled; extend this checker from the text before adding it")
    fault = case["store_fault"]
    if fault is not None:
        if fault not in STORE_FAULT_POINTS:
            fail(f"[store_fault] {case['name']}: store_fault {fault!r} is not null or a point "
                 f"{STORE_FAULT_POINTS}")
        if fault == REFUSAL_RECORD:
            # Only a decided refusal writes a refusal record: it is still answered, nothing held
            # changes, and the failed write raises the signal.
            if expected != "reject":
                fail(f"[store_fault] {case['name']}: {fault} cannot occur on a decision that is "
                     f"not a refusal")
            after = copy.deepcopy(before)
            after["application_storage_fault"] = True
            return {"expected": "reject", "reason": reason, "applied": None, "after": after,
                    "writes": 0}
        written = writes if expected == "accept" else 0
        if written < rules["fault_min_writes"][fault]:
            fail(f"[store_fault] {case['name']}: {fault} cannot occur on a decision that writes "
                 f"{written} record(s)")
        # Every store fault rolls back, leaves the artifact undecided and raises the signal,
        # whatever the decision would have been.
        after = copy.deepcopy(before)
        after["application_storage_fault"] = True
        return {"expected": "undecided", "reason": None, "applied": None, "after": after,
                "writes": writes}
    if expected == "accept":
        after["application_storage_fault"] = False
    return {"expected": expected, "reason": reason,
            "applied": applied if kind == "delivery_receipt" else None,
            "after": after, "writes": writes}


def compare_after(case: dict, got: dict, where: str) -> list[str]:
    out = []
    want, lit = got["after"], case["held_after"]
    if not isinstance(lit, dict) or list(lit) != list(HELD_MEMBERS):
        return [f"[held_after] {where}: members are not {list(HELD_MEMBERS)}"]
    for member in HELD_MEMBERS:
        if lit[member] != want[member]:
            out.append(f"[held_after:{member}] {where}: {json.dumps(lit[member])[:120]} is not "
                       f"{json.dumps(want[member])[:120]}")
    return out


CASE_KEYS = ("name", "artifact_type", "note", "receiver_now_ms", "held_before", "artifact",
             "canonical_hex", "authenticator", "store_fault", "expected", "reject_reason",
             "applied_sequences", "held_after")


def check_case(case: dict, corpus: dict, rules: dict, mat: dict) -> list[str]:
    where = case.get("name", "?")
    if set(case) != set(CASE_KEYS):
        return [f"[shape] {where}: keys are not {sorted(CASE_KEYS)}"]
    if not isinstance(case["name"], str) or not isinstance(case["note"], str) \
            or type(case["receiver_now_ms"]) is not int \
            or abs(case["receiver_now_ms"]) > rules["int_max"] \
            or case["expected"] not in ("accept", "reject", "undecided") \
            or not (case["applied_sequences"] is None or (
                isinstance(case["applied_sequences"], list)
                and all(type(x) is int for x in case["applied_sequences"]))):
        return [(f"[shape] {where}: name, note, receiver_now_ms, expected or applied_sequences "
                 "has the wrong type or value")]
    out = verify(case, corpus, rules, mat)
    out += check_state(case["held_before"], corpus, where + " held_before", rules["projection"], rules)
    out += check_state(case["held_after"], corpus, where + " held_after", rules["projection"], rules)
    if any(not f.startswith("[fixture]") for f in out):
        return out
    if case["reject_reason"] is not None and case["reject_reason"] not in rules["reasons"]:
        out.append(f"[reason] {where}: {case['reject_reason']!r} is outside the vocabulary")
    try:
        got = decide(case, corpus, rules)
    except Failure as error:
        text = str(error)
        return out + [text if text.startswith("[store_fault]") else f"[model] {text}"]
    if case["expected"] != got["expected"]:
        out.append(f"[answer] {where}: expected {case['expected']!r}, the text gives "
                   f"{got['expected']!r}")
    if case["reject_reason"] != got["reason"]:
        out.append(f"[reason] {where}: reject_reason {case['reject_reason']!r}, the text gives "
                   f"{got['reason']!r}")
    if case["applied_sequences"] != got["applied"]:
        out.append(f"[applied_sequences] {where}: {case['applied_sequences']!r}, the text gives "
                   f"{got['applied']!r}")
    return out + compare_after(case, got, where)


# --- coverage -----------------------------------------------------------------------------

def _held(case: dict) -> Any:
    return restates(case["artifact_type"], case["artifact"], case["held_before"])


def _kind(name: str) -> Callable[[dict], bool]:
    return lambda c: c["artifact_type"] == name


def _plain(c: dict) -> bool:
    return c["store_fault"] is None


def _custody_gen(corpus: dict, key_id: str) -> str | None:
    return next((s for s, g in corpus["custody_registry"].items() if g["key_id"] == key_id), None)


def _redelivery(corpus: dict, kind: str) -> Callable[[dict], bool]:
    def test(c: dict) -> bool:
        return c["artifact_type"] == kind and _plain(c) and c["expected"] == "accept" and any(
            f["artifact"] == c["artifact"] and f["store_fault"] is not None
            and f["expected"] == "undecided" and f["held_after"] == c["held_before"]
            for f in corpus["cases"])
    return test


def coverage_classes(corpus: dict) -> dict[str, Callable[[dict], bool]]:
    """Every case class the Test vectors paragraph names, as a property of a case."""
    cus, rec, con, dis = (_kind(k) for k in ARTIFACT_TITLES)
    sealing = corpus["device"]["sealing_epoch"]

    def gen(c: dict) -> str | None:
        return _custody_gen(corpus, c["artifact"]["key_id"])

    def held_gen(c: dict) -> str | None:
        h = _held(c)
        return _custody_gen(corpus, h["key_id"]) if h else None

    def custody_restates(c: dict, same: bool, recorded: bool | None = None) -> bool:
        h = _held(c)
        return cus(c) and _plain(c) and h is not None \
            and (h["custody_at_ms"] == c["artifact"]["custody_at_ms"]) is same \
            and (recorded is None or (h["recorded_at_ms"] is not None) is recorded)

    def receipt_union(c: dict, where: str) -> bool:
        if not (rec(c) and _plain(c)):
            return False
        a = c["artifact"]
        span = list(range(a["from_seq"], a["to_seq"] + 1))
        have = {r["local_seq"] for r in c["held_before"]["receipts"]} & set(span)
        if not have or have == set(span):
            return False
        held_part = [s for s in span if s in have]
        if where == "prefix":
            return held_part == span[:len(held_part)]
        return held_part == span[-len(held_part):]

    def confirmation_differs(c: dict, field: str) -> bool:
        h = _held(c)
        return con(c) and _plain(c) and h is not None and [
            f for f in ("confirmed_at_ms", "actor", "key_id") if h[f] != c["artifact"][f]] == [field]

    def earlier_restated(c: dict, agrees: bool) -> bool:
        h, before = _held(c), c["held_before"]
        return con(c) and _plain(c) and h is not None \
            and c["artifact"]["anchor_epoch_id"] != sealing \
            and any(r["anchor_epoch_id"] == sealing for r in before["epoch_confirmations"]) \
            and (before["active_epoch"] or {}).get("anchor_epoch_id") == sealing \
            and all(h[f] == c["artifact"][f] for f in ("confirmed_at_ms", "actor", "key_id")) is agrees

    def fault(kind: Callable[[dict], bool], point: str) -> Callable[[dict], bool]:
        return lambda c: kind(c) and c["store_fault"] == point

    return {
        "custody: a first acceptance": lambda c: cus(c) and _plain(c) and _held(c) is None,
        "custody: a byte-identical repeat": lambda c: custody_restates(c, True, True)
        and _held(c)["key_id"] == c["artifact"]["key_id"],
        "custody: the held time under the verify_only generation, held under the active": lambda c:
        custody_restates(c, True) and held_gen(c) == "active" and gen(c) == "verify_only",
        "custody: the held time under the active generation, held under the verify_only": lambda c:
        custody_restates(c, True) and held_gen(c) == "verify_only" and gen(c) == "active",
        "custody: a different time under the active generation": lambda c:
        custody_restates(c, False) and gen(c) == "active",
        "custody: a different time under the verify_only generation": lambda c:
        custody_restates(c, False) and gen(c) == "verify_only",
        "custody: an agreeing restatement of custody held without a record time": lambda c:
        custody_restates(c, True, False),
        "custody: a conflicting restatement of custody held without a record time": lambda c:
        custody_restates(c, False, False),
        "custody: a store fault at commit": fault(cus, "at_commit"),
        "custody: a conflicting restatement whose refusal record cannot be written": lambda c:
        fault(cus, REFUSAL_RECORD)(c) and _held(c) is not None
        and _held(c)["custody_at_ms"] != c["artifact"]["custody_at_ms"],
        "custody: a store fault on reading the held record": lambda c:
        fault(cus, "at_read")(c) and _held(c) is not None,
        "receipt: an identical repeat": lambda c: rec(c) and _plain(c) and len(_held(c) or []) == (
            c["artifact"]["to_seq"] - c["artifact"]["from_seq"] + 1) and all(
            r["accepted_at_ms"] == c["artifact"]["accepted_at_ms"]
            and r["key_id"] == c["artifact"]["key_id"] for r in _held(c)),
        "receipt: a union over a held prefix": lambda c: receipt_union(c, "prefix"),
        "receipt: a union over a held suffix": lambda c: receipt_union(c, "suffix"),
        "receipt: a union whose held sequences were receipted under a verify_only key": lambda c:
        rec(c) and _plain(c) and bool(_held(c))
        and len(_held(c)) < c["artifact"]["to_seq"] - c["artifact"]["from_seq"] + 1
        and all(corpus_key_status(corpus, r["key_id"]) == "verify_only" for r in _held(c))
        and corpus_key_status(corpus, c["artifact"]["key_id"]) == "active",
        "receipt: a store fault after the first sequence's write": fault(rec, "after_first_write"),
        "receipt: a store fault at commit": fault(rec, "at_commit"),
        "receipt: the redelivery after a fault": _redelivery(corpus, "delivery_receipt"),
        "confirmation: an identical restatement": lambda c: con(c) and _plain(c)
        and _held(c) is not None and all(_held(c)[f] == c["artifact"][f]
                                         for f in ("confirmed_at_ms", "actor", "key_id")),
        "confirmation: differing in confirmed_at_ms alone": lambda c:
        confirmation_differs(c, "confirmed_at_ms"),
        "confirmation: differing in actor alone": lambda c: confirmation_differs(c, "actor"),
        "confirmation: differing in key_id alone": lambda c: confirmation_differs(c, "key_id"),
        "confirmation: an agreeing restatement of an earlier epoch while the sealing epoch is "
        "confirmed": lambda c: earlier_restated(c, True),
        "confirmation: a conflicting restatement of an earlier epoch while the sealing epoch is "
        "confirmed": lambda c: earlier_restated(c, False),
        "confirmation: the sealing epoch while only an earlier epoch is confirmed": lambda c:
        con(c) and _plain(c) and c["artifact"]["anchor_epoch_id"] == sealing and _held(c) is None
        and bool(c["held_before"]["epoch_confirmations"]),
        "confirmation: a store fault after the first write": fault(con, "after_first_write"),
        "confirmation: a store fault at commit": fault(con, "at_commit"),
        "disposition: a first application": lambda c: dis(c) and _plain(c) and _held(c) is None
        and not c["held_before"]["stops"],
        "disposition: a byte-identical repeat": lambda c: dis(c) and _plain(c) and _held(c) is not None,
        "disposition: a superseded refusal": lambda c: dis(c) and _plain(c) and _held(c) is None
        and any(s["scope"] == c["artifact"]["scope"] for s in c["held_before"]["stops"]),
        "disposition: an epoch disposition for the identity stop's epoch, superseded": lambda c:
        dis(c) and _plain(c) and c["artifact"]["scope"] == "epoch"
        and c["reject_reason"] == "superseded" and any(
            s["scope"] == "identity" for s in c["held_before"]["stops"])
        and any(d["scope"] == "identity" and d["anchor_epoch_id"] == c["artifact"]["anchor_epoch_id"]
                for d in c["held_before"]["dispositions"]),
        "disposition: an epoch disposition for another epoch under an identity stop, superseded":
        lambda c: dis(c) and _plain(c) and c["artifact"]["scope"] == "epoch"
        and c["reject_reason"] == "superseded"
        and any(s["scope"] == "identity" for s in c["held_before"]["stops"])
        and not any(d["anchor_epoch_id"] == c["artifact"]["anchor_epoch_id"]
                    for d in c["held_before"]["dispositions"]),
        "disposition: an identity disposition applied beside an epoch stop": lambda c:
        dis(c) and _plain(c) and c["artifact"]["scope"] == "identity" and c["expected"] == "accept"
        and _held(c) is None and any(s["scope"] == "epoch" for s in c["held_before"]["stops"]),
        "disposition: an identity disposition's byte-identical repeat": lambda c:
        dis(c) and _plain(c) and c["artifact"]["scope"] == "identity" and _held(c) is not None,
        "disposition: an artifact-scoped disposition recorded under an identity stop": lambda c:
        dis(c) and _plain(c) and c["artifact"]["scope"] == "artifact" and c["expected"] == "accept"
        and _held(c) is None and any(s["scope"] == "identity" for s in c["held_before"]["stops"]),
        "disposition: a re-signed body under its stop, superseded": lambda c:
        dis(c) and _plain(c) and c["reject_reason"] == "superseded" and any(
            all(d[k] == c["artifact"][k] for k in DISPOSITION_BODY)
            and d["artifact_digest"] != wire_digest(c["artifact"])
            for d in c["held_before"]["dispositions"]),
        "disposition: a re-signed artifact-scoped body, applied as a new disposition": lambda c:
        dis(c) and _plain(c) and c["expected"] == "accept" and c["artifact"]["scope"] == "artifact"
        and _held(c) is None and any(
            all(d[k] == c["artifact"][k] for k in DISPOSITION_BODY)
            for d in c["held_before"]["dispositions"]),
        "disposition: a store fault after the first write": fault(dis, "after_first_write"),
        "disposition: a store fault at commit": fault(dis, "at_commit"),
        "disposition: the redelivery after a fault": _redelivery(corpus, "evidence_disposition"),
        "at_commit: a delivery receipt": fault(rec, "at_commit"),
        "at_commit: an epoch confirmation": fault(con, "at_commit"),
        "at_commit: an evidence disposition": fault(dis, "at_commit"),
        "after_first_write: an epoch confirmation": fault(con, "after_first_write"),
        "after_first_write: an evidence disposition": fault(dis, "after_first_write"),
        "signal: a store fault while it is raised keeps it raised": lambda c:
        c["store_fault"] is not None and c["held_before"]["application_storage_fault"] is True,
        "signal: a refusal leaves it raised": lambda c: _plain(c)
        and c["held_before"]["application_storage_fault"] is True and c["expected"] == "reject",
        "signal: an agreeing restatement answered as applied clears it": lambda c: _plain(c)
        and c["held_before"]["application_storage_fault"] is True and c["expected"] == "accept"
        and _held(c) is not None,
    }


def corpus_key_status(corpus: dict, key_id: str) -> str | None:
    return next((k["status"] for k in corpus["authority_key_registry"]["keys"]
                 if k["key_id"] == key_id), None)


def coverage(corpus: dict) -> list[str]:
    out = [f"[coverage] not covered: {label}"
           for label, test in coverage_classes(corpus).items()
           if not any(_safe(test, c) for c in corpus["cases"])]
    # The text: "The corpus exercises `at_read` and `at_refusal_record` once each, for custody".
    for point in ("at_read", REFUSAL_RECORD):
        hits = [c for c in corpus["cases"] if isinstance(c, dict) and c.get("store_fault") == point]
        if len(hits) != 1 or hits[0].get("artifact_type") != "custody_acknowledgement":
            out.append(f"[coverage] {point} is exercised {len(hits)} times, not once for custody")
    return out


def _safe(test: Callable[[dict], bool], case: dict) -> bool:
    try:
        return bool(test(case))
    except (KeyError, TypeError, AttributeError, IndexError):
        return False


# --- the corpus ---------------------------------------------------------------------------

TOP_KEYS = (
    "contract", "device", "sealed_envelopes", "sealed_registrations", "sealed_artifacts",
    "domains", "custody_registry", "authority_key_registry", "authority_seeds", "cases",
)
LABEL = "ori-specs evidence-exchange/v3 restated records"


def check_corpus(corpus: dict, rules: dict) -> list[str]:
    """Every disagreement; a corpus too malformed to read is one, never a crash."""
    try:
        return _check_corpus(corpus, rules)
    except (KeyError, TypeError, ValueError, AttributeError, IndexError) as error:
        return [(f"[malformed] the corpus cannot be read as this contract's: "
                 f"{error.__class__.__name__} {error}")]


def _check_corpus(corpus: dict, rules: dict) -> list[str]:
    out: list[str] = []
    if not isinstance(corpus, dict):
        return ["[file] the corpus is not an object"]
    # The text names the shared state and material; every other member is descriptive text.
    if not set(TOP_KEYS) <= set(corpus) or any(
            not isinstance(corpus[k], str) for k in set(corpus) - set(TOP_KEYS)):
        return [(f"[file] top-level members lack {sorted(set(TOP_KEYS) - set(corpus))} or carry "
                 "a non-descriptive member the text does not name")]
    if corpus["contract"] != "evidence-exchange/v3":
        out.append("[file] contract is not evidence-exchange/v3")
    if {k: v.encode() + b"\0" for k, v in corpus["domains"].items()} != rules["domain"]:
        out.append("[file] domains are not the contract's")
    for env in corpus["sealed_envelopes"]:
        for member, label in (("chain_row_digest", "chain row"), ("envelope_digest", "envelope")):
            want = "sha256:" + hashlib.sha256(f"{LABEL} {label} {env['local_seq']}".encode()).hexdigest()
            if env[member] != want:
                out.append(f"[file] sealed envelope {env['local_seq']} {member}")
    if any(a.get("artifact_type") == "anchor_registration" for a in corpus["sealed_artifacts"]):
        out.append("[schema] sealed_artifacts holds a registration, which no disposition here names")
    for i, art in enumerate(corpus["sealed_artifacts"], 1):
        if art["digest"] != "sha256:" + hashlib.sha256(f"{LABEL} checkpoint {i}".encode()).hexdigest():
            out.append(f"[file] sealed artifact {i} digest")
    if corpus["device"]["sealing_epoch"] not in [r["anchor_epoch_id"]
                                                 for r in corpus["sealed_registrations"]]:
        out.append("[file] the sealing epoch is no sealed registration")
    mat = material(corpus, rules, out)
    names = [c.get("name") for c in corpus["cases"]]
    if len(set(names)) != len(names):
        out.append("[file] case names repeat")
    digests: dict[str, set[str]] = {}
    for case in corpus["cases"]:
        if isinstance(case, dict) and case.get("artifact_type") == "evidence_disposition" \
                and isinstance(case.get("artifact"), dict) \
                and set(case["artifact"]) == set(rules["fields"]["evidence_disposition"]):
            body = tuple(case["artifact"][k] for k in DISPOSITION_BODY)
            digests.setdefault(json.dumps(body), set()).add(wire_digest(case["artifact"]))
    rules = {**rules, "disposition_digests": digests}
    for case in corpus["cases"]:
        out += check_case(case, corpus, rules, mat)
    out += coverage(corpus)
    return out


# --- mutations ----------------------------------------------------------------------------

def _resign(case: dict, corpus: dict, rules: dict) -> None:
    kind, art = case["artifact_type"], case["artifact"]
    tag = AUTHENTICATOR.get(kind, "signature")
    body = {k: v for k, v in art.items() if k != tag}
    preimage = rules["domain"][kind] + canonical(body)
    case["canonical_hex"] = preimage.hex()
    if kind == "custody_acknowledgement":
        secret = next(bytes.fromhex(g["secret_hex"]) for g in corpus["custody_registry"].values()
                      if g["key_id"] == art["key_id"])
        art["mac"] = "hmac-sha256:" + hmac.new(secret, preimage, hashlib.sha256).hexdigest()
    else:
        seed = bytes.fromhex(corpus["authority_seeds"][art["key_id"]])
        art["signature"] = "ed25519:" + base64.b64encode(
            Ed25519PrivateKey.from_private_bytes(seed).sign(preimage)).decode()


def _flip_char(value: str) -> str:
    """One character of an authenticator's body changed, its shape kept."""
    k = len(value) // 2
    return value[:k] + ("B" if value[k] != "B" else "C") + value[k + 1:] if value.startswith(
        "ed25519:") else value[:-1] + ("0" if value[-1] != "0" else "1")


def _first(corpus: dict, kind: str) -> int:
    return next(i for i, c in enumerate(corpus["cases"]) if c["artifact_type"] == kind
                and c["store_fault"] is None)


# For each held field kind, values its domain refuses: altered identically in held_before and
# held_after, so every relationship between the two still holds and only the value is wrong.
INVALID_VALUES: dict[str, tuple[Any, ...]] = {
    "local_seq": (False, 0, 99),
    "time": (False, -9007199254740992, "1787000000000"),
    "custody_key": ("unheld-key", "hkdf-sha256:" + "0" * 32, "HKDF-SHA256:" + "a" * 32),
    "authority_key": ("unheld-key", "sha256:" + "0" * 64),
    "device_id": ("another-device",),
    "epoch": ("sha256:" + "f" * 64, "not-an-epoch"),
    "pubkey_hex": ("ZZ", 5),
    "actor": ("", 7),
    "digest": ("sha256:" + "e" * 64,),
    "scope": ("galaxy",),
    "disposition": ("not_a_disposition",),
    "state": ("closed", None),
}
FIELD_KINDS = {
    "local_seq": "local_seq", "custody_at_ms": "time", "recorded_at_ms": "time",
    "accepted_at_ms": "time", "confirmed_at_ms": "time", "applied_at_ms": "time",
    "closed_at_ms": "time", "decided_at_ms": "time", "device_id": "device_id",
    "anchor_epoch_id": "epoch", "pubkey_hex": "pubkey_hex", "actor": "actor",
    "triggering_digest": "digest", "scope": "scope", "disposition": "disposition",
    "state": "state",
}


def retained_value_mutants(corpus: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    out: list[tuple[str, Any, Callable[[dict], Any]]] = []
    seen: set[tuple[str, str, str]] = set()
    for i, case in enumerate(corpus["cases"]):
        before, after = case["held_before"], case["held_after"]
        for member in ("custody", "receipts", "epoch_confirmations", "registration_obligations",
                       "dispositions", "stops", "active_epoch"):
            pairs = ([(None, before[member])] if member == "active_epoch" else
                     list(enumerate(before[member])))
            for j, record in pairs:
                if not isinstance(record, dict):
                    continue
                twin = after[member] if j is None else (
                    after[member][j] if j < len(after[member]) else None)
                if twin is None or twin != record and any(record[k] != twin.get(k) for k in record
                                                          if k not in ("recorded_at_ms",)):
                    continue
                for field in record:
                    kind = ("custody_key" if member == "custody" else "authority_key") \
                        if field == "key_id" else FIELD_KINDS.get(field)
                    if kind is None or record[field] is None and kind == "time":
                        continue
                    for value in INVALID_VALUES[kind]:
                        key = (member, field, repr(value))
                        if key in seen:
                            continue
                        seen.add(key)

                        def edit(c: dict, i: int = i, m: str = member, j: int | None = j,
                                 f: str = field, v: Any = value) -> None:
                            for side in ("held_before", "held_after"):
                                target = c["cases"][i][side][m]
                                (target if j is None else target[j])[f] = v
                        label = f"{case['name']}: retained {member}.{field} = {value!r} in both"
                        out.append((label, "[state]", edit))
    for value in (1, None, "true"):
        out.append((f"retained application_storage_fault = {value!r} in both", "[state]",
                    lambda c, v=value: [c["cases"][0][side].update(application_storage_fault=v)
                                        for side in ("held_before", "held_after")]))
    return out


def resigned_mutants(corpus: dict, rules: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    """Byte identity is the complete signed artifact's: a re-signed body is never a replay."""
    out: list[tuple[str, Any, Callable[[dict], Any]]] = []

    def resign_other(c: dict, i: int) -> None:
        x = c["cases"][i]
        art = x["artifact"]
        body = {k: v for k, v in art.items() if k != "signature"}
        preimage = rules["domain"]["evidence_disposition"] + canonical(body)
        sig = sign_with_nonce(bytes.fromhex(c["authority_seeds"][art["key_id"]]), preimage, b"r4")
        art["signature"] = "ed25519:" + base64.b64encode(sig).decode()

    for i, case in enumerate(corpus["cases"]):
        if case["artifact_type"] != "evidence_disposition" or case["store_fault"] is not None:
            continue
        held = restates("evidence_disposition", case["artifact"], case["held_before"])
        if held is not None:
            out.append((f"{case['name']}: a signature-only variant answered as the replay",
                        ("[answer]", "[reason]", "[held_after"),
                        lambda c, i=i: resign_other(c, i)))
        if case["held_before"]["dispositions"]:
            out.append((f"{case['name']}: a held artifact_digest altered in both states",
                        "[fixture]|artifact_digest",
                        lambda c, i=i: [d.update(artifact_digest="sha256:" + "9" * 64)
                                        for side in ("held_before", "held_after")
                                        for d in c["cases"][i][side]["dispositions"][:1]]))
            out.append((f"{case['name']}: a held artifact_digest over the unsigned preimage",
                        "[fixture]|artifact_digest", lambda c, i=i: _preimage_digests(c, i, rules)))
        if case["expected"] == "accept" and held is None and case["artifact"]["scope"] == "artifact" \
                and case["held_before"]["dispositions"]:
            out.append((f"{case['name']}: the re-signed artifact-scoped body answered as a replay",
                        "[held_after", lambda c, i=i: c["cases"][i].update(
                            held_after={**copy.deepcopy(c["cases"][i]["held_before"]),
                                        "application_storage_fault": False})))
    return out


def _preimage_digests(c: dict, i: int, rules: dict) -> None:
    for side in ("held_before", "held_after"):
        for d in c["cases"][i][side]["dispositions"][:1]:
            body = {**{k: d[k] for k in DISPOSITION_BODY}, "v": 1, "device_id": c["device"]["device_id"]}
            d["artifact_digest"] = "sha256:" + hashlib.sha256(
                rules["domain"]["evidence_disposition"] + canonical(body)).hexdigest()


def cross_scope_mutants(corpus: dict, rules: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    """An identity stop covers every epoch: each way of letting an epoch stop past it."""
    out: list[tuple[str, Any, Callable[[dict], Any]]] = []
    for i, case in enumerate(corpus["cases"]):
        art = case["artifact"]
        if case["artifact_type"] != "evidence_disposition" or case["store_fault"] is not None \
                or art["scope"] != "epoch" or case["reject_reason"] != "superseded" \
                or not any(s["scope"] == "identity" for s in case["held_before"]["stops"]):
            continue

        def applied(c: dict, i: int = i) -> None:
            x = c["cases"][i]
            x.update(expected="accept", reject_reason=None)
            x["held_after"]["dispositions"].append(disposition_record(x["artifact"]))
            x["held_after"]["stops"].append(stop_of(x["artifact"]))
            x["held_after"]["application_storage_fault"] = False

        def held(c: dict, i: int = i) -> None:
            x = c["cases"][i]
            for side in ("held_before", "held_after"):
                x[side]["dispositions"].append(_rec(c, rules, {
                    **disposition_record(x["artifact"]), "decided_at_ms": 1}))
                x[side]["stops"].append(stop_of(x["artifact"]))
        out.append((f"{case['name']}: applied after the identity stop instead of superseded",
                    ("[answer]", "[reason]", "[held_after", "[state]"), applied))
        out.append((f"{case['name']}: an epoch stop appended after the identity stop in held state",
                    "[state]|after an identity stop", held))
    for i, case in enumerate(corpus["cases"]):
        if case["artifact_type"] == "evidence_disposition" and case["store_fault"] is None \
                and case["artifact"]["scope"] == "artifact" and case["expected"] == "accept" \
                and any(s["scope"] == "identity" for s in case["held_before"]["stops"]):
            def superseded(c: dict, i: int = i) -> None:
                x = c["cases"][i]
                x.update(expected="reject", reject_reason="superseded")
                x["held_after"] = copy.deepcopy(x["held_before"])
            out.append((f"{case['name']}: superseded under the identity stop instead of recorded",
                        ("[answer]", "[reason]", "[held_after"), superseded))
    if len(out) < 5:
        fail("the corpus no longer carries an epoch disposition superseded under an identity stop "
             "for the same and for another epoch, and an artifact-scoped one recorded under it")
    return out


def subject_mutants(corpus: dict, rules: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    """A disposition naming a registration, or a sealed envelope, held or arriving: the schema
    says this corpus's dispositions name only sealed artifacts that are not registrations."""
    dis = _first(corpus, "evidence_disposition")
    registration = {"artifact_type": "anchor_registration",
                    "anchor_epoch_id": corpus["device"]["sealing_epoch"],
                    "digest": "sha256:" + hashlib.sha256(b"a sealed registration").hexdigest()}

    def arriving(digest_of: Callable[[dict], str], extra: dict | None = None) -> Callable[[dict], Any]:
        def go(c: dict) -> None:
            if extra:
                c["sealed_artifacts"].append(dict(extra))
            c["cases"][dis]["artifact"].update(triggering_digest=digest_of(c))
            _resign(c["cases"][dis], c, rules)
        return go

    def held(c: dict) -> None:
        c["sealed_artifacts"].append(dict(registration))
        case = next(x for x in c["cases"] if x["name"] == "receipt_union_over_held_prefix")
        for side in ("held_before", "held_after"):
            case[side]["dispositions"].append(_rec(c, rules, {
                "triggering_digest": registration["digest"],
                "anchor_epoch_id": registration["anchor_epoch_id"], "scope": "artifact",
                "disposition": "artifact_terminal", "decided_at_ms": 1787000003000,
                "key_id": c["cases"][dis]["artifact"]["key_id"]}))
    return [
        ("subject: an arriving disposition names a sealed envelope", "[schema]",
         arriving(lambda c: c["sealed_envelopes"][0]["envelope_digest"])),
        ("subject: an arriving disposition names a registration", "[schema]",
         arriving(lambda c: registration["digest"], registration)),
        ("subject: a held disposition names a registration", "[state]|triggering_digest", held),
    ]


def permitted_states(corpus: dict, rules: dict) -> list[tuple[str, Callable[[dict], Any]]]:
    """Held states the text allows that a stricter checker might refuse."""
    def both(name: str, edit: Callable[[dict], Any]) -> Callable[[dict], Any]:
        def go(c: dict) -> None:
            case = next(x for x in c["cases"] if x["name"] == name)
            for side in ("held_before", "held_after"):
                edit(case[side])
        return go

    key = next(k["key_id"] for k in corpus["authority_key_registry"]["keys"]
               if k["purpose"] == "evidence_authority_disposition")
    terminal = {"triggering_digest": corpus["sealed_artifacts"][0]["digest"], "anchor_epoch_id": "",
                "scope": "artifact", "disposition": "artifact_terminal",
                "decided_at_ms": 1787000003000, "key_id": key}
    return [
        ("an artifact-scoped terminal disposition naming no epoch",
         both("receipt_union_over_held_prefix", lambda h: h["dispositions"].append(
             _rec(corpus, rules, terminal)))),
        ("a projection an earlier receiver left disagreeing with its record",
         both("confirmation_identical", lambda h: h["active_epoch"].update(actor="earlier@site"))),
        ("an identity disposition and its identity stop, naming no epoch",
         both("receipt_union_over_held_prefix", lambda h: (
             h["dispositions"].append(_rec(corpus, rules, {
                 **terminal, "scope": "identity", "disposition": "identity_replacement_required",
                 "anchor_epoch_id": corpus["sealed_artifacts"][0]["anchor_epoch_id"]})),
             h["stops"].append({"scope": "identity", "anchor_epoch_id": ""})))),
        ("confirmation application times decreasing along the list",
         both("confirmation_earlier_epoch_agreeing_restatement", _times_step_back)),
        ("disposition decision times decreasing along the list",
         both("receipt_union_over_held_prefix", lambda h: h["dispositions"].extend([
             _rec(corpus, rules, {**terminal,
                                  "triggering_digest": corpus["sealed_artifacts"][0]["digest"],
                                  "anchor_epoch_id": corpus["sealed_artifacts"][0]["anchor_epoch_id"],
                                  "decided_at_ms": 1787000009000}),
             _rec(corpus, rules, {**terminal,
                                  "triggering_digest": corpus["sealed_artifacts"][1]["digest"],
                                  "anchor_epoch_id": corpus["sealed_artifacts"][1]["anchor_epoch_id"],
                                  "decided_at_ms": 1787000001000})]))),
    ]


def _times_step_back(h: dict) -> None:
    """The first-applied confirmation carries the later time, as a clock step-back leaves it."""
    first, second = h["epoch_confirmations"][0], h["epoch_confirmations"][1]
    first["applied_at_ms"] = second["applied_at_ms"] + 5000
    for o in h["registration_obligations"]:
        if o["anchor_epoch_id"] == first["anchor_epoch_id"]:
            o["closed_at_ms"] = first["applied_at_ms"]


def relationship_mutants(corpus: dict, rules: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    """Each relationship between held records broken identically in held_before and held_after,
    so the case's answer still follows; each must be refused for that relationship."""
    def both(name: str, edit: Callable[[dict], Any]) -> Callable[[dict], Any]:
        def go(c: dict) -> None:
            case = next(x for x in c["cases"] if x["name"] == name)
            for side in ("held_before", "held_after"):
                edit(case[side])
        return go

    def first(pred: Callable[[dict], bool]) -> str:
        return next(c["name"] for c in corpus["cases"] if pred(c["held_before"])
                    and c["held_before"] == {**c["held_after"],
                                             "application_storage_fault":
                                             c["held_before"]["application_storage_fault"]})

    disp = first(lambda h: bool(h["dispositions"]))
    conf = first(lambda h: any(o["state"] == "confirmed" for o in h["registration_obligations"]))
    cust = first(lambda h: bool(h["custody"]))
    rec = first(lambda h: bool(h["receipts"]))
    other_epoch = next(r["anchor_epoch_id"] for r in corpus["sealed_registrations"]
                       if r["anchor_epoch_id"] != corpus["device"]["sealing_epoch"])
    checkpoint = corpus["sealed_artifacts"][0]["digest"]
    envelope = corpus["sealed_envelopes"][0]
    template = {"triggering_digest": checkpoint,
                "anchor_epoch_id": corpus["sealed_artifacts"][0]["anchor_epoch_id"],
                "scope": "epoch", "disposition": "epoch_reprovisioning_required",
                "decided_at_ms": 1787000003000,
                "key_id": next(k["key_id"] for k in corpus["authority_key_registry"]["keys"]
                               if k["purpose"] == "evidence_authority_disposition")}

    def confirmed(h: dict) -> dict:
        return next(o for o in h["registration_obligations"] if o["state"] == "confirmed")

    edits: list[tuple[str, str, str, Callable[[dict], Any]]] = [
        ("a disposition names another epoch than its subject's", disp, "subject",
         lambda h: h["dispositions"][0].update(anchor_epoch_id=other_epoch) or h["stops"][0].update(
             anchor_epoch_id=other_epoch)),
        ("an epoch-scoped disposition names no epoch", disp, "dispositions.anchor_epoch_id",
         lambda h: h["dispositions"][0].update(anchor_epoch_id="") or h["stops"][0].update(
             anchor_epoch_id="")),
        ("a retained_pending names a checkpoint", rec, "retained_pending names",
         lambda h: h["dispositions"].append(_rec(corpus, rules, {
             **template, "scope": "artifact", "disposition": "retained_pending"}))),
        ("a disposition and its stop held twice", disp, "twice",
         lambda h: (h["dispositions"].append(dict(h["dispositions"][0])),
                    h["stops"].append(dict(h["stops"][0])))),
        ("a second stop-producing disposition for one epoch", disp, "one scope",
         lambda h: (h["dispositions"].append(_rec(corpus, rules, {**h["dispositions"][0],
                                                                  "decided_at_ms": 1})),
                    h["stops"].append(dict(h["stops"][0])))),
        ("a stop without its disposition", disp, "stops are not",
         lambda h: h["dispositions"].clear()),
        ("a disposition without its stop", disp, "stops are not", lambda h: h["stops"].clear()),
        ("an obligation closed at another time than its confirmation applied", conf, "closed at",
         lambda h: confirmed(h).update(closed_at_ms=confirmed(h)["closed_at_ms"] + 1)),
        ("a confirmation applied at another time than its obligation closed", conf, "closed at",
         lambda h: next(r for r in h["epoch_confirmations"]
                        if r["anchor_epoch_id"] == confirmed(h)["anchor_epoch_id"]).update(
             applied_at_ms=confirmed(h)["closed_at_ms"] + 1)),
        ("an obligation confirmed with no confirmation", conf, "state",
         lambda h: h["epoch_confirmations"].clear() or h.update(active_epoch=None)),
        ("a confirmation held twice", conf, "confirmation for",
         lambda h: h["epoch_confirmations"].append(dict(h["epoch_confirmations"][0]))),
        ("an obligation lost", conf, "not one obligation",
         lambda h: h["registration_obligations"].pop()),
        ("custody held twice for one envelope", cust, "custody",
         lambda h: h["custody"].append(dict(h["custody"][0]))),
        ("a sequence receipted twice", rec, "receipts",
         lambda h: h["receipts"].append(dict(h["receipts"][0]))),
        ("a disposition names a sealed envelope", rec, "triggering_digest",
         lambda h: h["dispositions"].append(_rec(corpus, rules, {
             **template, "scope": "artifact", "disposition": "artifact_terminal",
             "triggering_digest": envelope["envelope_digest"],
             "anchor_epoch_id": envelope["anchor_epoch_id"]}))),
        ("an identity stop names an epoch", rec, "stops",
         lambda h: (h["dispositions"].append(_rec(corpus, rules, {
             **template, "scope": "identity", "disposition": "identity_replacement_required"})),
                    h["stops"].append({"scope": "identity",
                                       "anchor_epoch_id": template["anchor_epoch_id"]}))),
        ("an epoch stop names no epoch", disp, "stops", lambda h: h["stops"][0].update(
            anchor_epoch_id="")),
    ]
    return [(f"relationship: {label}", f"[state]|{needle}", both(name, edit))
            for label, name, needle, edit in edits]


def vocabulary_mutants(corpus: dict, rules: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    """Each defect the vocabulary names, introduced into one re-signed artifact: it must be
    refused for that reason, as this script reads the text, and for no other."""
    rec, cus = _first(corpus, "delivery_receipt"), _first(corpus, "custody_acknowledgement")
    con, dis = _first(corpus, "epoch_confirmation"), _first(corpus, "evidence_disposition")
    receipt_key = next(k["key_id"] for k in corpus["authority_key_registry"]["keys"]
                       if k["purpose"] == "evidence_authority_receipt" and k["status"] == "active")

    def resigned(i: int, **changes: Any) -> Callable[[dict], Any]:
        return lambda c: (c["cases"][i]["artifact"].update(changes), _resign(c["cases"][i], c, rules))

    edits = [
        ("receipt from_seq below 1", "non_contiguous_range", resigned(rec, from_seq=0)),
        ("receipt to_seq below from_seq", "non_contiguous_range", resigned(rec, from_seq=3, to_seq=2)),
        ("receipt range past the sealed sequences", "unknown_sequence", resigned(rec, to_seq=9)),
        ("receipt range_digest over other rows", "binding_mismatch",
         resigned(rec, range_digest="sha256:" + "0" * 64)),
        ("receipt v 2", "unrecognised_version", resigned(rec, v=2)),
        ("custody v 2", "unrecognised_version", resigned(cus, v=2)),
        ("confirmation v 2", "unrecognised_version", resigned(con, v=2)),
        ("disposition v 2", "malformed", resigned(dis, v=2)),
        ("disposition widened to identity", "malformed", resigned(dis, scope="identity")),
        ("custody local_seq not sealed", "unknown_sequence", resigned(cus, local_seq=9)),
        ("custody for another device", "binding_mismatch", resigned(cus, device_id="other-device")),
        ("confirmation for an unsealed epoch", "binding_mismatch",
         resigned(con, anchor_epoch_id="sha256:" + "1" * 64)),
        ("disposition for an unsealed artifact", "binding_mismatch",
         resigned(dis, triggering_digest="sha256:" + "2" * 64)),
        ("confirmation under the receipt key", "wrong_purpose", resigned(con, key_id=receipt_key)),
        ("receipt key_id unknown", "unknown_key", lambda c: c["cases"][rec]["artifact"].update(
            key_id="sha256:" + "3" * 64)),
        ("custody mac shape", "malformed", lambda c: c["cases"][cus]["artifact"].update(
            mac="hmac-sha256:" + "A" * 64)),
    ]
    return [(f"vocabulary: {label}", f"[refused:{reason}]", edit) for label, reason, edit in edits]


DECISION = ("[answer]", "[reason]", "[applied_sequences]", "[held_after")


def resigned_value(case: dict, corpus: dict) -> tuple[str, Any] | None:
    """A value for one signed field that changes what the text decides, or None."""
    if case["store_fault"] is not None:
        return None
    kind, art = case["artifact_type"], case["artifact"]
    held = restates(kind, art, case["held_before"])
    if kind == "custody_acknowledgement":
        if held is not None and held["custody_at_ms"] != art["custody_at_ms"]:
            return "custody_at_ms", held["custody_at_ms"]
        return "custody_at_ms", art["custody_at_ms"] + 7
    if kind == "epoch_confirmation":
        differs = [f for f in ("confirmed_at_ms", "actor", "key_id")
                   if held is not None and held[f] != art[f]]
        if held is not None and len(differs) == 1:
            return differs[0], held[differs[0]]
        return ("confirmed_at_ms", art["confirmed_at_ms"] + 7) if not differs else None
    if kind == "delivery_receipt":
        return ("accepted_at_ms", art["accepted_at_ms"] + 7) if case["applied_sequences"] else None
    if case["reject_reason"] == "superseded":
        return None
    return "decided_at_ms", art["decided_at_ms"] + 7


def corpus_mutants(corpus: dict, rules: dict) -> list[tuple[str, Any, Callable[[dict], Any]]]:
    """(label, the failure tag that must newly appear, edit)."""
    out: list[tuple[str, Any, Callable[[dict], Any]]] = []
    for i, case in enumerate(corpus["cases"]):
        n = case["name"]
        kind = case["artifact_type"]
        flips = {"accept": "reject", "reject": "accept", "undecided": "accept"}
        out.append((f"{n}: answer flipped", "[answer]",
                    lambda c, i=i, f=flips: c["cases"][i].update(expected=f[c["cases"][i]["expected"]])))
        out.append((f"{n}: reason changed", "[reason]", lambda c, i=i: c["cases"][i].update(
            reject_reason="binding_mismatch" if c["cases"][i]["reject_reason"] else "restatement_conflict")))
        if case["reject_reason"] == "restatement_conflict":
            out.append((f"{n}: superseded for a conflict", "[reason]",
                        lambda c, i=i: c["cases"][i].update(reject_reason="superseded")))
        if case["reject_reason"] == "superseded":
            out.append((f"{n}: restatement_conflict for superseded", "[reason]",
                        lambda c, i=i: c["cases"][i].update(reject_reason="restatement_conflict")))
        out.append((f"{n}: signal after flipped", "[held_after:application_storage_fault]",
                    lambda c, i=i: c["cases"][i]["held_after"].update(
                        application_storage_fault=not c["cases"][i]["held_after"][
                            "application_storage_fault"])))
        for member in ("custody", "receipts", "epoch_confirmations", "dispositions"):
            records = case["held_after"][member]
            for j, record in enumerate(records):
                for field, value in record.items():
                    if field in ("local_seq", "anchor_epoch_id", "triggering_digest", "pubkey_hex"):
                        continue
                    other = (value + 1 if isinstance(value, int) else
                             1787000000001 if value is None else value + "x")
                    out.append((f"{n}: held_after {member}[{j}].{field} changed",
                                f"[held_after:{member}]",
                                lambda c, i=i, m=member, j=j, f=field, o=other:
                                c["cases"][i]["held_after"][m][j].update({f: o})))
            if records:
                out.append((f"{n}: held_after {member} record dropped", f"[held_after:{member}]",
                            lambda c, i=i, m=member: c["cases"][i]["held_after"][m].pop()))
        # The held state the decision reads, changed: the answer, the applied sequences or the
        # records after must move with it.
        if case["held_before"]["receipts"]:
            out.append((f"{n}: held_before receipts lose their first sequence", DECISION,
                        lambda c, i=i: c["cases"][i]["held_before"]["receipts"].pop(0)))
        if case["held_before"]["custody"]:
            out.append((f"{n}: held_before custody time moved", DECISION,
                        lambda c, i=i: c["cases"][i]["held_before"]["custody"][0].update(
                            custody_at_ms=c["cases"][i]["held_before"]["custody"][0]["custody_at_ms"] + 1)))
        for j, _ in enumerate(case["held_after"]["registration_obligations"]):
            out.append((f"{n}: obligation {j} reopened or closed", "[held_after:registration_obligations]",
                        lambda c, i=i, j=j: c["cases"][i]["held_after"]["registration_obligations"][j]
                        .update(closed_at_ms=(c["cases"][i]["held_after"]["registration_obligations"][j]
                                              ["closed_at_ms"] or 0) + 1)))
        if case["held_after"]["active_epoch"] is not None:
            out.append((f"{n}: projection moved", "[held_after:active_epoch]",
                        lambda c, i=i: c["cases"][i]["held_after"].update(active_epoch=None)))
        # The effective epoch is the projection's: moving it, or the projection losing a member,
        # is a held-record change.
        after_confirmed = case["held_after"]["epoch_confirmations"]
        active = case["held_after"]["active_epoch"]
        if kind == "epoch_confirmation" and _held(case) is not None \
                and case["held_before"]["active_epoch"] is not None:
            out.append((f"{n}: a disagreeing projection before is repaired after",
                        "[held_after:active_epoch]",
                        lambda c, i=i: c["cases"][i]["held_before"]["active_epoch"].update(
                            actor="left-by-an-earlier-receiver")))
        if active is not None:
            out.append((f"{n}: projection loses device_id", "[held_after:active_epoch]",
                        lambda c, i=i: c["cases"][i]["held_after"]["active_epoch"].pop("device_id")))
            out.append((f"{n}: projection names another actor", "[held_after:active_epoch]",
                        lambda c, i=i: c["cases"][i]["held_after"]["active_epoch"].update(
                            actor="another@elsewhere")))
        for j, record in enumerate(after_confirmed):
            if active is None or record["anchor_epoch_id"] != active["anchor_epoch_id"]:
                out.append((f"{n}: effective epoch moved to confirmation {j}",
                            "[held_after:active_epoch]",
                            lambda c, i=i, j=j: c["cases"][i]["held_after"].update(active_epoch={
                                k: v for k, v in c["cases"][i]["held_after"]["epoch_confirmations"][j]
                                .items() if k != "applied_at_ms"})))
        # Store faults: on the read even a refusal is undecided; after_first_write needs an
        # application of more than one record, and at_commit one of at least one.
        if case["store_fault"] is None:
            out.append((f"{n}: a fault on the read", DECISION,
                        lambda c, i=i: c["cases"][i].update(store_fault="at_read")))
            # A refusal record that cannot be written: on a refusal the signal must rise; on
            # anything else the point cannot occur.
            # A refusal with the signal already raised is equivalent: the answer and every
            # record stay, and the signal stays raised.
            if not (case["expected"] == "reject" and case["held_before"]["application_storage_fault"]):
                out.append((f"{n}: its refusal record unwritable",
                            DECISION if case["expected"] == "reject" else "[store_fault]",
                            lambda c, i=i: c["cases"][i].update(store_fault=REFUSAL_RECORD)))
        elif case["store_fault"] == REFUSAL_RECORD:
            out.append((f"{n}: answered undecided", ("[answer]", "[reason]"),
                        lambda c, i=i: c["cases"][i].update(expected="undecided", reject_reason=None)))
            out.append((f"{n}: the failed write leaves the signal down",
                        "[held_after:application_storage_fault]",
                        lambda c, i=i: c["cases"][i]["held_after"].update(
                            application_storage_fault=False)))
        else:
            underlying = decide({**case, "store_fault": None}, corpus, rules)["expected"]
            out.append((f"{n}: {REFUSAL_RECORD} where the decision is {underlying}",
                        DECISION if underlying == "reject" else "[store_fault]",
                        lambda c, i=i: c["cases"][i].update(store_fault=REFUSAL_RECORD)))
            writes = decide({**case, "store_fault": None}, corpus, rules)
            written = writes["writes"] if writes["expected"] == "accept" else 0
            for point, least in rules["fault_min_writes"].items():
                if written < least:
                    out.append((f"{n}: {point} where it cannot occur", "[store_fault]",
                                lambda c, i=i, p=point: c["cases"][i].update(store_fault=p)))
        if case["held_after"]["stops"]:
            out.append((f"{n}: stop lifted", "[held_after:stops]",
                        lambda c, i=i: c["cases"][i]["held_after"]["stops"].clear()))
        tag = AUTHENTICATOR.get(kind, "signature")
        out.append((f"{n}: authenticator corrupted", "[refused:bad_authenticator]",
                    lambda c, i=i, t=tag: c["cases"][i]["artifact"].update(
                        {t: _flip_char(c["cases"][i]["artifact"][t])})))
        out.append((f"{n}: canonical_hex not the preimage", "[canonical]",
                    lambda c, i=i: c["cases"][i].update(
                        canonical_hex=c["cases"][i]["canonical_hex"][2:])))
        if kind == "delivery_receipt":
            out.append((f"{n}: applied_sequences dropped one", "[applied_sequences]",
                        lambda c, i=i: c["cases"][i].update(applied_sequences=(
                            c["cases"][i]["applied_sequences"] or [9])[:-1] or [1, 2, 3, 4])))
            out.append((f"{n}: range_digest re-signed over other rows", "[refused:binding_mismatch]",
                        lambda c, i=i, r=rules, cc=corpus: (
                            c["cases"][i]["artifact"].update(
                                range_digest="sha256:" + hashlib.sha256(b"other").hexdigest()),
                            _resign(c["cases"][i], c, r))))
        else:
            out.append((f"{n}: applied_sequences invented", "[applied_sequences]",
                        lambda c, i=i: c["cases"][i].update(applied_sequences=[1])))
        out.append((f"{n}: store_fault point swapped", (*DECISION, "[store_fault]"),
                    lambda c, i=i: c["cases"][i].update(store_fault=None if c["cases"][i]["store_fault"]
                                                        else "at_commit")))
        # A re-signed artifact that says something else, chosen so the text's rule moves the
        # decision: the literal answer or held records must then be refused.
        moved = resigned_value(case, corpus)
        if moved is not None:
            field, value = moved
            out.append((f"{n}: {field} re-signed to move the decision", DECISION,
                        lambda c, i=i, f=field, v=value, r=rules: (
                            c["cases"][i]["artifact"].update({f: v}),
                            _resign(c["cases"][i], c, r))))
    out += vocabulary_mutants(corpus, rules)
    out += retained_value_mutants(corpus)
    out += relationship_mutants(corpus, rules)
    out += subject_mutants(corpus, rules)
    out += cross_scope_mutants(corpus, rules)
    out += resigned_mutants(corpus, rules)
    for label in coverage_classes(corpus):
        out.append((f"without {label}", "[coverage]",
                    lambda c, label=label: c.update(cases=[
                        x for x in c["cases"] if not _safe(coverage_classes(c)[label], x)])))
    return out


# Each rule changed in the text as if re-pinned: the corpus that contradicts it must be refused.
REPINS = (
    ("the projection drops device_id",
     "Its members are `device_id`, `anchor_epoch_id`,", "Its members are `anchor_epoch_id`,",
     "`{device_id, anchor_epoch_id, pubkey_hex, actor, confirmed_at_ms, key_id}`, or `null`",
     "`{anchor_epoch_id, pubkey_hex, actor, confirmed_at_ms, key_id}`, or `null`"),
    ("confirmation agreement ignores key_id",
     "| Epoch confirmation | Its `confirmed_at_ms`, `actor` and `key_id` each equal",
     "| Epoch confirmation | Its `confirmed_at_ms` and `actor` each equal"),
    ("confirmation agreement ignores actor",
     "| Epoch confirmation | Its `confirmed_at_ms`, `actor` and `key_id` each equal",
     "| Epoch confirmation | Its `confirmed_at_ms` and `key_id` each equal"),
    ("custody agreement adds the generation",
     "| Custody acknowledgement | Its `custody_at_ms` equals the held one",
     "| Custody acknowledgement | Its `custody_at_ms` and `key_id` each equal the held one",
     "| Its `custody_at_ms` differs from the held one, under either generation. |",
     "| Its `custody_at_ms` or `key_id` differs from the held one, under either generation. |"),
    ("custody agreement compares the envelope only",
     "| Custody acknowledgement | Its `custody_at_ms` equals the held one",
     "| Custody acknowledgement | Its `envelope_digest` equals the held one",
     "| Its `custody_at_ms` differs from the held one, under either generation. |",
     "| Its `envelope_digest` differs from the held one, under either generation. |"),
    ("custody domain renamed", "`ori.evidence_custody_ack.v1\\0`", "`ori.evidence_custody_ack.v2\\0`"),
    ("receipt purpose swapped",
     "| `ori.evidence_delivery_receipt.v1\\0` | Ed25519 | `evidence_authority_receipt` |",
     "| `ori.evidence_delivery_receipt.v1\\0` | Ed25519 | `evidence_authority_epoch` |"),
    ("epoch_reprovisioning_required widened to identity",
     "| `epoch_reprovisioning_required` | `epoch` | yes |",
     "| `epoch_reprovisioning_required` | `identity` | yes |"),
    ("restatement_conflict dropped from the vocabulary",
     "| `restatement_conflict` | A verified artifact conflicts", "| `conflict` | A verified artifact conflicts"),
)


# Each restatement of a rule elsewhere in the contract, reworded to say something else. Each must
# fail both the pin and the rule the model reads.
REWORDINGS = (
    ("what changed", "and neither answer changes\n  the held record.",
     "and an agreeing answer\n  may update the held record."),
    ("custody pointer", "a restatement, decided under [Restated records](#restated-records).\n\n### Delivery receipt",
     "a restatement, and replaces the held record.\n\n### Delivery receipt"),
    ("receipt pointer", "receipted applies it as [Restated records](#restated-records) says.",
     "receipted replaces their receipt records."),
    ("confirmation pointer", ("verified confirmation for an epoch already confirmed is a restatement, "
                              "decided\nunder [Restated records](#restated-records)."),
     "verified confirmation for an epoch already confirmed replaces the held confirmation."),
    ("invariant", "- The first record of a fact is final.", "- The latest record of a fact is final."),
    ("superseded third answer", "It neither agrees nor conflicts, and it changes nothing.",
     "It conflicts, and it changes nothing."),
    ("projection repaired", "is left as found: neither answer to a restatement repairs or rewrites it.",
     "is repaired from the confirmation record by an agreeing restatement."),
    ("store constraint", "is a defect in the receiver, never a store fault:",
     "is a store fault, not a defect in the receiver:"),
    ("refusal record", "it still answers the refusal with its reason, every held record stays",
     "it leaves the artifact undecided, every held record stays"),
    ("refusal unacknowledged", "is acknowledged as that refusal.", "is not acknowledged."),
    ("invariant drops the exception", "every held record as it was and still answers that refusal.",
     "the artifact undecided."),
    ("refusal record not a store fault",
     "committing an application, or writing the record of a refusal it has decided.",
     "committing an application."),
    ("refusal-record point", "The corpus calls this point `at_refusal_record`.",
     "The corpus calls this point `at_commit`."),
)


def text_mutants(texts: dict) -> list[tuple[str, dict]]:
    out = []
    for source, start_marker, end_marker in TEXT_BLOCKS:
        body = texts[source]
        start, end = _block(body, start_marker, end_marker, source)
        block = body[start:end]
        for unit in _block_units(block):
            pattern = r"\s+".join(re.escape(w) for w in unit.split())
            edited_block, count = re.subn(pattern, "", block, count=1)
            if count != 1:
                out.append((f"unit not removable from its block: {unit[:60]}", {}))
                continue
            edited = dict(texts)
            edited[source] = body[:start] + edited_block + body[end:]
            out.append((f"unit removed: {unit[:60]}", edited))
    return out


def run_mutations(texts: dict, corpus: dict, rules: dict, base: list[str]) -> tuple[int, list[str]]:
    survived: list[str] = []
    count = 0
    for label, edited in text_mutants(texts):
        count += 1
        if not edited:
            survived.append(label)
            continue
        try:
            check_contract_text(edited)
        except Failure:
            continue
        survived.append(label)
    for key, sentence in REQUIRED_SENTENCES.items():
        count += 1
        edited = dict(texts)
        source = CONTRACT if _norm(sentence) in _norm(texts[CONTRACT]) else HEALTH
        pattern = r"\s+".join(re.escape(w) for w in sentence.split())
        edited[source], n = re.subn(pattern, sentence.rsplit(" ", 1)[0].replace("\\", "\\\\"),
                                    texts[source], count=1)
        if n != 1:
            survived.append(f"re-pin mutant for {key!r} matches nothing")
            continue
        try:
            contract_rules(edited)
        except Failure:
            continue
        survived.append(f"re-pin: {key} reworded")
    for label, old, new in REWORDINGS:
        count += 1
        pattern = r"\s+".join(re.escape(w) for w in old.split())
        changed, hits = re.subn(pattern, lambda _m, new=new: new, texts[CONTRACT])
        if hits != 1:
            survived.append(f"rewording {label!r} matches {hits} places")
            continue
        edited = {**texts, CONTRACT: changed}
        try:
            check_contract_text(edited)
            survived.append(f"rewording {label!r} passes the pin")
            continue
        except Failure:
            pass
        try:
            contract_rules(edited)
        except Failure:
            continue
        survived.append(f"rewording {label!r} passes the rules")
    base_set = set(base)
    for label, *pairs in REPINS:
        count += 1
        edited = dict(texts)
        body = texts[CONTRACT]
        missing = [old for old in pairs[::2] if body.count(old) != 1]
        if missing:
            survived.append(f"re-pin mutant {label!r} does not match once: {missing[0][:60]}")
            continue
        for old, new in zip(pairs[::2], pairs[1::2], strict=True):
            body = body.replace(old, new)
        edited[CONTRACT] = body
        # A re-pin must still read as a contract: the corpus, not the parser, refuses it.
        try:
            found = check_corpus(corpus, contract_rules(edited))
        except Failure as error:
            survived.append(f"re-pin: {label} unreadable ({error})")
            continue
        if set(found) - base_set:
            continue
        survived.append(f"re-pin: {label}")
    # States the text permits, held in both before and after: each must still pass.
    permitted = permitted_states(corpus, rules)
    for label, edit in permitted:
        good = copy.deepcopy(corpus)
        edit(good)
        new = [f for f in check_corpus(good, rules) if f not in base_set]
        if new:
            survived.append(f"permitted state refused: {label}: {new[0]}")
    for label, wanted, edit in corpus_mutants(corpus, rules):
        count += 1
        bad = copy.deepcopy(corpus)
        try:
            edit(bad)
        except (KeyError, TypeError, StopIteration, IndexError) as error:
            survived.append(f"{label}: mutant not constructible ({error.__class__.__name__})")
            continue
        if bad == corpus:
            survived.append(f"{label}: mutant changes nothing")
            continue
        try:
            found = check_corpus(bad, rules)
        except Failure as error:
            found = [f"[model] {error}"]
        new = [f for f in found if f not in base_set]
        if isinstance(wanted, str) and "|" in wanted:
            prefix, needle = wanted.split("|", 1)
            if any(f.startswith(prefix) and needle in f for f in new):
                continue
            survived.append(f"{label}: refused for {new[:1] or 'nothing'}, not {wanted}")
            continue
        tags = wanted if isinstance(wanted, tuple) else (wanted,)
        other = [f for f in new if f.startswith("[refused:") and not f.startswith(tags)]
        if other:
            survived.append(f"{label}: refused for {other[0]}, not {wanted}")
            continue
        if any(f.startswith(tags) or ("[held_after" in tags or any(
                t.startswith("[held_after") for t in tags))
               and f.startswith("[state]") and " held_after:" in f for f in new):
            continue
        survived.append(f"{label}: refused for {new[:1] or 'nothing'}, not {wanted}")
    return count, survived


def main(argv: list[str]) -> int:
    texts = read_texts()
    if argv == ["--print-units"]:
        print(json.dumps(units_of(texts), indent=2, ensure_ascii=False))
        return 0
    if argv not in ([], ["--mutations"]):
        print(__doc__)
        return 2
    try:
        check_contract_text(texts)
        rules = contract_rules(texts)
        corpus = json.loads(CORPUS.read_text(encoding="utf-8"))
        found = check_corpus(corpus, rules)
    except (Failure, ValueError, OSError) as failure:
        print(f"{NAME}: {failure}", file=sys.stderr)
        return 1
    status = 0
    if found:
        print(f"{NAME}: {len(found)} disagreement(s) between the corpus and the contract:",
              file=sys.stderr)
        for line in found:
            print(f"  {line}", file=sys.stderr)
        status = 1
    if argv == ["--mutations"]:
        count, survived = run_mutations(texts, corpus, rules, found)
        if survived:
            for line in survived:
                print(f"mutant survived: {line[:160]}", file=sys.stderr)
            return 1
        print(f"{NAME}: {count} mutants refused, each for its intended reason; "
              f"{len(permitted_states(corpus, rules))} permitted states pass")
    if status == 0:
        print(f"{NAME}: corpus agrees with the contract ({len(corpus['cases'])} cases, "
              f"{len(coverage_classes(corpus))} case classes covered)")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
