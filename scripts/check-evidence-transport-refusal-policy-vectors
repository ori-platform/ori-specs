#!/usr/bin/env python3
"""Check the refusal-policy vectors against evidence-transport/v2.

The policy is read from the contract text itself, never from the vector file.
The whole policy block, from the response table through registration
resolution, and the authentication order, device authorisation and limits
sections, are pinned: every sentence and table row must equal the list held in
`evidence-transport-pinned-units.json` beside this script, so no edit to the policy can pass
until that set is updated in the same change. Within the pinned text, the
response table gives each status's admitted outcomes, the policy table's action
cells must be one of five exact phrases, the terminal classification table must
agree with the rows that archive, and the fail-closed paragraph gives the class
for a reason a status does not admit. Every case is reclassified from that text
with no defaults, so an absent or invalid field is an unrecognised outcome
rather than a pass; every sequence is replayed through an explicit per-device
courier state machine in which an unstated transition is an error; and the
corpus is held to coverage of every row, every retention defect, and every
category of unrecognised outcome.

    python3 scripts/check-evidence-transport-refusal-policy-vectors
    python3 scripts/check-evidence-transport-refusal-policy-vectors --mutations
    python3 scripts/check-evidence-transport-refusal-policy-vectors --print-units

`--mutations` corrupts the corpus and edits the contract text, deleting each
pinned unit in turn and rewording each exact action, and requires every mutant
to be refused. A checker that did not read the text would pass the corpus
mutants and fail the text mutants. `--print-units` prints the block's units,
for updating the pin after a deliberate contract change.
"""

from __future__ import annotations

import copy
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "evidence-transport" / "v2.md"
VECTORS = ROOT / "evidence-transport" / "vectors" / "refusal-policy-v2.json"
PINNED = ROOT / "scripts" / "evidence-transport-pinned-units.json"
BLOCK_START = "| HTTP | `outcome` | Meaning |"
BLOCK_END = "## Persistence and provenance"
# Pinned beside the policy block: the authentication order, which decides
# whether a fault is refused before or after authentication.
EXTRA_BLOCKS = (
    ("Authentication order is normative:", "## Device authorisation"),
    ("## Device authorisation and enumeration resistance", "## Response"),
    ("## Limits and failure behaviour", "## Vectors"),
)
UNRECOGNISED = "unrecognised"
CLASSES = ("retire", "archive", "hold", "handoff", "retry_after", "backoff")
RETAINED = "refused_retained"

# The only action phrases the policy table may use. `archive` is the terminal
# action: it archives on a verified retention and holds otherwise.
ACTIONS = {
    "Archive once retained; otherwise hold.": "archive",
    "Hold.": "hold",
    "Retain; retry on the next handoff, never on a timer.": "handoff",
    "Retain; retry no earlier than `Retry-After`.": "retry_after",
    "Retain; back off.": "backoff",
}

# The fail-closed paragraph, which the pin requires verbatim, states these.
FAIL_CLOSED = (
    "A server MUST emit only a reason its status admits. For a status in the "
    "table with any other reason, including an empty `reason`, the gateway records "
    "`unrecognised`, retains the queue entry, and fails closed: `400` and "
    "`422` hold; `401` and `403` wait for the next handoff; `409` and `507` hold; "
    "`429` and `503` back off, a `429` waiting no less than any parseable "
    "`Retry-After`. The response `retriable` flag never changes this "
    "classification."
)
FAIL_CLOSED_CLASSES = {400: "hold", 422: "hold", 401: "handoff", 403: "handoff",
                       409: "hold", 507: "hold", 429: "backoff", 503: "backoff"}

# An authenticated response carries the submitted digest; an unauthenticated
# one never does (the digest rule beside the policy, pinned with it).
DIGEST_REQUIRED = {200, 403, 409, 422, 507}
DIGEST_FORBIDDEN = {401}

# The checks a gateway applies to a retention, each a way it can fail to bind.
RETENTION_DEFECTS = (
    "absent", "bad_mac", "digest_mismatch", "type_mismatch", "device_mismatch",
    "status_mismatch", "reason_mismatch", "extra_field", "wrong_version", "malformed_epoch",
)


# The sentences this checker's model implements, each beside the rule it backs.
# The pin forces a touch and not agreement: `--print-units` regenerates it
# mechanically. These cannot be regenerated. A contract that rewords one of them
# has changed a rule this model hard-codes, so it fails until this list and the
# model change with it.
MODEL_SENTENCES = {
    # TRANSITIONS: a handoff wait resumes on a handoff and never on a timer.
    "timer": "A timer is never a handoff.",
    # TRANSITIONS: a handoff or restart never ends a back-off or Retry-After wait.
    "waits": (
        "A handoff never brings a back-off or a `Retry-After` wait forward, and a "
        "restart restores such a wait rather than ending it."
    ),
    # replay(): the handoff sources, including a retired registration.
    "handoff": (
        "A **handoff** is a relevant state-change signal: a newly admitted outbound artifact for the same "
        "device; an authenticated admission refused `queue_full` for a configured device; a `200` retiring an "
        "anchor registration for that device; or courier process start."
    ),
    # classify(): a pre-disposition capacity 503 is its own reason, with no custody.
    "capacity_503": (
        "`503 retention_capacity_unavailable` means the authority cannot retain this terminal refusal within "
        "the applicable pre-disposition allowance."
    ),
    "capacity_503_exit": (
        "Exit requires authority-operator action that restores or increases durable retention capacity; "
        "evidence MUST NOT be evicted to create that capacity."
    ),
    # replay(): only an authenticated admission for a configured device signals a handoff.
    "authenticated_admission": (
        "A carriage on any other topic, or whose `device_id` values disagree, is no admission and signals nothing."
    ),
    # replay(): a queue_full handoff moves nothing but the head.
    "queue_full_handoff": (
        "A `queue_full` handoff admits no bytes, transfers no custody, and changes no queue ordering; it only "
        "makes an existing eligible head entry for that device runnable once."
    ),
    # The gateway acts on a stop only through its verified projection (check-evidence-handoff-vectors).
    "stop_projection": (
        "The gateway acts on it only when it carries exactly these fields, `mac` verifies under the secret the "
        "request was signed with, `device_id` is the request's, and `disposition_digest` names an artifact the "
        "same response carries; it never reads the disposition's fields to decide the stop."
    ),
    "stop_retains": (
        "Stopping retains every queued byte and its order, performs no archive, and changes no custody the runtime "
        "already holds."
    ),
    # replay(): state is kept per device and lane.
    "lanes": (
        "Each device has two lanes: its anchor registrations, and every other artifact "
        "it delivers. Order, retry state, and holds are kept, persisted, and restored "
        "per `device_id` and lane. A hold or back-off in one lane MUST NOT delay "
        "delivery in the other lane or for another device,"
    ),
    "capacity": (
        "Every device share reserves one `anchor_registration` slot and the maximum "
        "encoded registration-record bytes exclusively for registration,"
    ),
    # _settle(): a verified retention archives in either lane and frees it.
    "archive": (
        "An **archive** moves a refused artifact, atomically, out of its lane's active "
        "delivery order into the device's durable incident archive, and releases the "
        "gateway's byte copy, before the lane advances."
    ),
    "archive_only_retained": "It happens only on a verified `refused_retained`,",
    # _settle(): an archive that cannot commit behaves as a hold not yet durable.
    "archive_failure": (
        "If the archive cannot commit, the entry stays at the head of its lane with its "
        "bytes and the courier reports store failure; each process that starts without "
        "that archive sends it once more, and the identical retry returns the same "
        "retained decision."
    ),
    # TRANSITIONS: an archived artifact is never offered again.
    "archived_never_resent": (
        "An archived artifact is never re-sent by the courier, is not `state: held`, and "
        "counts toward neither `pending` nor `blocked`."
    ),
    # classify(): a terminal refusal without retention holds.
    "terminal_refused_holds": (
        "A terminal refusal answered with an ordinary `refused` is held, never archived."
    ),
    # classify(): what a gateway checks before it archives.
    "retention_verification": (
        "A `refused_retained` whose `retention` is absent or fails any of these is an "
        "unrecognised outcome."
    ),
    "retention_admitted": (
        "`refused_retained` is admitted only at a reason whose policy row archives; at "
        "any other reason, and at any other status, the response is an unrecognised outcome."
    ),
    "retention_only": "Only a verified `refused_retained` lets the gateway release its byte copy.",
    # classify(): a response whose authority artifacts cannot be staged.
    "staging": (
        "carrying an authority artifact the gateway cannot durably stage, or one whose "
        "routing-projection `device_id` is not the request's;"
    ),
    # classify(): the terminal class is the archiving rows.
    "terminal": "A terminal refusal is exactly one whose policy row archives.",
    # replay(): a 507 holds its own lane only.
    "capacity_hold": (
        "The gateway holds that device's lane with its bytes; no other lane or device "
        "waits on it."
    ),
    # replay(): a hold not yet durable is sent once more per process start.
    "non_durable_hold": (
        "A courier that stops, or whose hold write fails, between the refusal and the "
        "durable hold sends the artifact once more from each process that starts "
        "without that hold, and holds it when it is refused again."
    ),
    # classify(): a 401 malformed never condemns the artifact bytes.
    "transport_fault": (
        "Repeated `401 malformed` is a visible delivery-availability fault, never "
        "evidence of invalid artifact bytes and never a reason to discard, rewrite, or "
        "immediately resend them."
    ),
    # The backoff row for pending_registration_conflict is transient.
    "pending_conflict": (
        "The refused bytes are not retained by the authority, and the refusal lasts "
        "only while that registration is pending: once it applies or reaches a "
        "terminal refusal, the same bytes resolve afresh, per `evidence-exchange/v2`."
    ),
    "pending_conflict_idempotency": (
        "a `409 pending_registration_conflict` changes, once the registration retained "
        "pending under its commissioning digest has applied or reached a terminal "
        "refusal, to whatever *Resolution at the authority* in `evidence-exchange/v2` "
        "then gives these bytes;"
    ),
    "reservation_lane": "is never confirmed, and delays no lane but its own.",
    # classify(): nothing here discards evidence or delays an action.
    "no_discard": (
        "So no delivery outcome may discard evidence, and no delivery state may delay or gate a runtime action."
    ),
    # classify(): every binding the gateway checks, the reason included.
    "retention_binds": "`refusal_status` equals the HTTP status; and `reason` equals the response's `reason`.",
    "retention_shape": (
        "it carries exactly the fields in the table above and no other, `v` is `1`, and `anchor_epoch_id` is "
        "`\"\"` or `sha256:` followed by 64 lowercase hexadecimal characters;"
    ),
    "retention_recomputed": (
        "every field but `key_id` and `mac` is fixed when the refusal is first retained, and `key_id` and `mac` are "
        "those of the request being answered."
    ),
    # replay(): the return set rides on these outcomes and no narrower set.
    # The model is the conforming credential's; check-evidence-transport-capability-vectors holds the legacy one.
    "return_set": (
        "on every authenticated response for that device whose `outcome` is `accepted`, `refused`, or "
        "`refused_retained` and that passed device authorisation, to a conforming credential,"
    ),
    # replay(): no disposition changes the courier's queue actions.
    "no_gateway_stop": (
        "and no disposition stops, holds, or widens delivery at the gateway except through a verified `stop` "
        "projection."
    ),
    # classify(): a staging failure is unrecognised for one attempt, and staging is idempotent.
    "staging_attempt": (
        "A response carrying an artifact it cannot durably stage is an unrecognised outcome for that attempt only:"
    ),
    "staging_idempotent": "An artifact whose digest it already holds is neither staged nor forwarded again,",
}
# A sentence in the pinned block that gives a disposition power over delivery at
# the gateway contradicts no_gateway_stop; only that negated sentence may match.
GATEWAY_STOP = re.compile(
    r"\bdispositions?\b[^.]*\b(?:stops?|holds?|halts?|blocks?|widens?|suspends?)\b[^.]*\b(?:delivery|lane|courier)\b",
    re.IGNORECASE,
)
DIGEST_RULE = re.compile(r"a ((?:`\d{3}`,? (?:or )?)+)refusal without its digest")
SIZE_RULE = re.compile(r"An artifact larger than ([\d,]+) bytes is outside this hop\.")


class CheckError(Exception):
    pass


def _norm(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def block_units(text: str) -> list[str]:
    """Every table row and prose sentence of the pinned blocks, in order."""
    units: list[str] = []
    for start_marker, end_marker in ((BLOCK_START, BLOCK_END), *EXTRA_BLOCKS):
        units.extend(_units_between(text, start_marker, end_marker))
    return units


def _units_between(text: str, start_marker: str, end_marker: str) -> list[str]:
    start = text.find(start_marker)
    end = text.find(end_marker, start)
    if start < 0 or end < start:
        raise CheckError(f"evidence-transport/v2.md lacks the block starting {start_marker[:40]!r}")
    units: list[str] = []
    for paragraph in re.split(r"\n\s*\n", text[start:end]):
        lines = paragraph.strip().splitlines()
        if not lines:
            continue
        if lines[0].lstrip().startswith("|"):
            units.extend(_norm(line) for line in lines if line.strip())
            continue
        for chunk in re.split(r"\n(?=- )", paragraph.strip()):
            prose = _norm(chunk.removeprefix("- "))
            units.extend(s for s in re.split(r"(?<=[.:;])\s+(?=[A-Z`*\[(])", prose) if s)
    return units


def _classification(rest: str) -> dict[tuple[int, str], str]:
    """The closed terminal/non-terminal table, keyed by (status, reason)."""
    start = rest.find("| Status | Reason | Class |")
    if start < 0:
        raise CheckError("the contract no longer carries the terminal classification table")
    table: dict[tuple[int, str], str] = {}
    for line in rest[start:].splitlines()[2:]:
        if not line.strip().startswith("|"):
            break
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        status = re.fullmatch(r"`(\d{3})`", cells[0]) if len(cells) == 3 else None
        if status is None or cells[2] not in ("terminal", "non-terminal"):
            raise CheckError(f"classification row is not `status` | reasons | class: {cells}")
        for reason in re.findall(r"`([a-z_]+)`", cells[1]):
            key = (int(status.group(1)), reason)
            if key in table:
                raise CheckError(f"{key} is classified twice")
            table[key] = cells[2]
    return table


def load_policy(text: str, check_pin: bool = True) -> dict:
    units = block_units(text)
    pinned = json.loads(PINNED.read_text(encoding="utf-8"))
    if check_pin and units != pinned:
        added = sorted(set(units) - set(pinned))
        removed = sorted(set(pinned) - set(units))
        raise CheckError(
            "the policy block differs from the pinned units, in content or order; a deliberate change "
            "updates scripts/evidence-transport-pinned-units.json in the same commit\n"
            + "".join(f"  + {u}\n" for u in added)
            + "".join(f"  - {u}\n" for u in removed)
        )
    if _norm(FAIL_CLOSED) not in _norm(text[text.find(BLOCK_START):text.find(BLOCK_END)]):
        raise CheckError("the fail-closed paragraph is not the one this checker classifies")

    head, sep, rest = text.partition("### Refusal policy")
    if not sep:
        raise CheckError("no Refusal policy section")
    outcomes: dict[int, set[str]] = {}
    for line in head[head.find(BLOCK_START):].splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if cells and cells[0].isdigit():
            if len(cells) != 3:
                raise CheckError(f"response table row is not three cells: {cells}")
            named = re.findall(r"`([a-z_]+)`", cells[1])
            if not named or _norm(cells[1]) != " or ".join(f"`{o}`" for o in named):
                raise CheckError(f"response table row {cells[0]} outcomes are not a plain list")
            outcomes[int(cells[0])] = set(named)
    admitted = set().union(*outcomes.values()) if outcomes else set()
    if admitted - {"accepted", "refused", RETAINED, "pending"} or 200 not in outcomes:
        raise CheckError(f"response table outcomes are not the closed set: {outcomes}")

    table: dict[int, dict[str, str]] = {}
    for line in rest.split("The reasons mean", 1)[0].splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if not cells or not cells[0].isdigit():
            continue
        if len(cells) != 3 or cells[2] not in ACTIONS:
            raise CheckError(f"refusal policy row is not an exact action: {cells}")
        status = int(cells[0])
        reasons = re.findall(r"`([a-z_]+)`", cells[1])
        if not reasons or _norm(cells[1]) != ", ".join(f"`{r}`" for r in reasons):
            raise CheckError(f"refusal policy row {status} reasons are not a plain list")
        for reason in reasons:
            if reason in table.setdefault(status, {}):
                raise CheckError(f"{status} {reason} is classified twice")
            table[status][reason] = ACTIONS[cells[2]]
    if set(table) != {s for s in outcomes if s != 200} or set(table) != set(FAIL_CLOSED_CLASSES):
        raise CheckError("the policy table, response table and fail-closed rule name different statuses")
    classification = _classification(rest.split("The reasons mean", 1)[0])
    rows = {(s, r): klass for s, reasons in table.items() for r, klass in reasons.items()}
    if set(classification) != set(rows):
        raise CheckError("the terminal classification and the policy table name different rows")
    for key, klass in rows.items():
        if (classification[key] == "terminal") != (klass == "archive"):
            raise CheckError(f"{key} is {classification[key]} but its policy row is {klass}")
    for status, klass_by_reason in table.items():
        archives = any(k == "archive" for k in klass_by_reason.values())
        if archives != (RETAINED in outcomes[status]):
            raise CheckError(f"status {status} archives at a reason but admits no {RETAINED}, or the reverse")
    section = _norm(text[text.find(BLOCK_START):text.find(BLOCK_END)])
    pinned_text = " ".join(units)
    for key, sentence in MODEL_SENTENCES.items():
        if _norm(sentence) not in pinned_text:
            raise CheckError(
                f"the contract no longer states the {key} rule this checker's model hard-codes: "
                f"{sentence[:70]!r}. Rewording it changes the rule; change the model and "
                "MODEL_SENTENCES with it, never only the pin"
            )
    for unit in units:
        if GATEWAY_STOP.search(unit) and _norm(MODEL_SENTENCES["no_gateway_stop"]) not in unit:
            raise CheckError(
                f"the policy block gives a disposition power over gateway delivery: {unit[:90]!r}. The courier "
                "acts only on the HTTP outcome and a verified retention"
            )
    digest_rule = DIGEST_RULE.search(section)
    if digest_rule is None:
        raise CheckError("the contract no longer states which refusals must carry their digest")
    if {int(s) for s in re.findall(r"\d{3}", digest_rule.group(1))} != DIGEST_REQUIRED - {200}:
        raise CheckError("the statuses whose refusal must carry its digest differ from DIGEST_REQUIRED")
    size = SIZE_RULE.search(section)
    if size is None:
        raise CheckError("the contract no longer states the artifact size bound")
    return {
        "max_artifact_bytes": int(size.group(1).replace(",", "")),
        "outcomes": outcomes,
        "table": table,
        "terminal": {k for k, v in classification.items() if v == "terminal"},
        "fallback": dict(FAIL_CLOSED_CLASSES),
        # A retired registration is a handoff for the device's other lane
        # only while the handoff definition says so.
        "registration_retirement_is_handoff": (
            "a `200` retiring an anchor registration for that device" in section
        ),
        "handoff_text": section,
        "lanes": "Each device has two lanes: its anchor registrations, and every other artifact it delivers." in section,
    }


def _positive_int(value) -> bool:
    return type(value) is int and value > 0


def classify(policy: dict, case: dict) -> dict:
    """The action the contract text requires for one response. No defaults."""
    unrecognised = {"class": "backoff", "reason": UNRECOGNISED}
    status = case.get("status")
    outcomes = policy["outcomes"]
    if type(status) is not int or status not in outcomes or case.get("media") != "json":
        return unrecognised
    outcome = case.get("outcome")
    if outcome not in outcomes[status]:
        return unrecognised
    reason, digest, retriable = case.get("reason"), case.get("digest"), case.get("retriable")
    if type(reason) is not str or type(digest) is not bool or type(retriable) is not bool:
        return unrecognised
    if case.get("staged") is not True:
        # Every authority artifact in a response is staged before the response is acted on.
        return unrecognised
    if (status in DIGEST_REQUIRED or outcome == RETAINED) and not digest or (status in DIGEST_FORBIDDEN and digest):
        return unrecognised
    retention = case.get("retention")
    if outcome == RETAINED:
        if retention != "verified":
            return unrecognised
    elif "retention" in case:
        return unrecognised
    if status == 200:
        if reason == "" and case.get("complete") is True and not retriable:
            return {"class": "retire", "reason": ""}
        return unrecognised
    table, fallback = policy["table"], policy["fallback"]
    retry_after = case.get("retry_after_s")
    if reason in table[status]:
        klass = table[status][reason]
        if outcome == RETAINED and klass != "archive":
            return unrecognised
        if klass == "archive":
            klass = "archive" if outcome == RETAINED else "hold"
        if klass == "retry_after" and not _positive_int(retry_after):
            return unrecognised
        return {"class": klass, "reason": reason}
    if outcome == RETAINED:
        return unrecognised
    result = {"class": fallback[status], "reason": UNRECOGNISED}
    if status == 429 and _positive_int(retry_after):
        result["min_wait_s"] = retry_after
    return result


def check_cases(policy: dict, cases: list[dict]) -> None:
    seen: set[str] = set()
    for case in cases:
        name = case.get("name")
        if not isinstance(name, str) or not name or name in seen:
            raise CheckError(f"case name missing or duplicated: {name!r}")
        seen.add(name)
        if case.get("expected", {}).get("class") not in CLASSES:
            raise CheckError(f"{name}: unknown class")
        if "retention" in case and case["retention"] not in ("verified", *RETENTION_DEFECTS):
            raise CheckError(f"{name}: unknown retention state {case['retention']!r}")
        want = classify(policy, case)
        if case["expected"] != want:
            raise CheckError(f"{name}: expected {case['expected']}, the contract gives {want}")


def _json(c):
    return c.get("media") == "json"


def check_coverage(policy: dict, cases: list[dict]) -> None:
    table, outcomes = policy["table"], policy["outcomes"]
    well_formed = [c for c in cases if _json(c) and c.get("outcome") in outcomes.get(c.get("status"), ())]
    rows = {(c["status"], c.get("reason"), c.get("outcome")) for c in well_formed}
    for status, reasons in table.items():
        for reason, klass in reasons.items():
            plain = "pending" if "pending" in outcomes[status] else "refused"
            if (status, reason, plain) not in rows:
                raise CheckError(f"no case for table row {status} {reason}")
            if klass == "archive" and not any(
                c["status"] == status and c.get("reason") == reason and c.get("outcome") == RETAINED
                and c["expected"]["class"] == "archive" for c in cases
            ):
                raise CheckError(f"no archived case for table row {status} {reason}")
        if not any(c["status"] == status and c.get("reason") and c["reason"] not in reasons for c in well_formed):
            raise CheckError(f"no unknown-reason case for {status}")
        if not any(c["status"] == status and c.get("retriable") is True for c in well_formed):
            raise CheckError(f"no retriable-flag case for {status}")
    for defect in RETENTION_DEFECTS:
        if not any(c.get("outcome") == RETAINED and c.get("retention") == defect for c in cases):
            raise CheckError(f"no case for a retention that is {defect}")
    required = {
        "400 without a digest": lambda c: c["status"] == 400 and c.get("digest") is False and _json(c),
        "the invalid 400 unknown_key": lambda c: (c["status"], c.get("reason")) == (400, "unknown_key"),
        "a 400 with no reason": lambda c: c["status"] == 400 and c.get("reason") == "" and _json(c),
        "a 422 with no reason": lambda c: c["status"] == 422 and c.get("reason") == "" and _json(c),
        "a clean 200": lambda c: c["expected"]["class"] == "retire",
        "a 200 missing a required artifact": lambda c: c["status"] == 200 and c.get("complete") is False,
        "a 200 marked retriable": lambda c: c["status"] == 200 and c.get("retriable") is True,
        "a 200 carrying a refusal": lambda c: c["status"] == 200 and c.get("outcome") == "refused",
        "a 200 without its digest": lambda c: c["status"] == 200 and c.get("digest") is False,
        "a 200 carrying a reason": lambda c: c["status"] == 200 and c.get("outcome") == "accepted" and c.get("reason"),
        "a 200 with no outcome": lambda c: c["status"] == 200 and "outcome" not in c,
        "a refusal with no outcome": lambda c: c["status"] != 200 and _json(c) and "outcome" not in c,
        "another 2xx": lambda c: 200 < c["status"] < 300,
        "a status outside the table": lambda c: c["status"] not in outcomes,
        "a non-JSON body": lambda c: not _json(c),
        "an outcome that contradicts its status": lambda c: c["status"] in outcomes and c["status"] != 200 and c.get("outcome") is not None and c.get("outcome") not in outcomes[c["status"]],
        "an authenticated refusal without its digest": lambda c: c["status"] in (403, 409, 422, 507) and c.get("digest") is False and _json(c),
        "an unauthenticated 401 carrying a digest": lambda c: c["status"] == 401 and c.get("digest") is True,
        "a 429 rate_limited without Retry-After": lambda c: (c["status"], c.get("reason")) == (429, "rate_limited") and "retry_after_s" not in c,
        "a 429 rate_limited with an invalid Retry-After": lambda c: (c["status"], c.get("reason")) == (429, "rate_limited") and "retry_after_s" in c and not _positive_int(c["retry_after_s"]),
        "a 429 unknown reason with Retry-After": lambda c: c["status"] == 429 and c.get("reason") != "rate_limited" and "retry_after_s" in c,
        "a retention at a reason that does not archive": lambda c: c.get("outcome") == RETAINED and c.get("reason") in table.get(c["status"], {}) and table[c["status"]][c["reason"]] != "archive",
        "a retention at a reason the status does not admit": lambda c: c.get("outcome") == RETAINED and c.get("reason") not in table.get(c["status"], {}),
        "a retention on a status that admits none": lambda c: c.get("outcome") == RETAINED and c["status"] in outcomes and RETAINED not in outcomes[c["status"]],
        "a retention without its digest": lambda c: c.get("outcome") == RETAINED and c.get("digest") is False,
        "a plain refusal carrying a retention": lambda c: c.get("outcome") == "refused" and "retention" in c,
        "a response whose authority artifacts were not staged": lambda c: c.get("staged") is False,
        "a terminal refusal answered without retention": lambda c: (c["status"], c.get("reason")) in policy["terminal"] and c.get("outcome") == "refused" and c["expected"]["class"] == "hold",
    }
    for label, predicate in required.items():
        if not any(predicate(c) for c in cases):
            raise CheckError(f"no case for {label}")


EXPECTS = {
    "retained", "held", "retired", "no_attempt", "no_attempt_before_retry_after",
    "no_attempt_before_backoff", "attempt_fresh_envelope_same_bytes", "archived",
}

# The courier's transitions, each stated by a pinned sentence. Anything not
# listed here is not stated, and a sequence that relies on it is refused.
TRANSITIONS = {
    ("hold", "timer_elapsed"): "no_attempt",        # "sends it no further"
    ("hold", "handoff"): "no_attempt",
    ("archived", "timer_elapsed"): "no_attempt",    # "never re-sent by the courier"
    ("archived", "handoff"): "no_attempt",
    ("archived", "restart"): "no_attempt",
    ("handoff", "timer_elapsed"): "no_attempt",     # "A timer is never a handoff."
    ("handoff", "handoff"): "attempt",              # the handoff rows
    ("handoff", "restart"): "attempt",              # "any start of the courier process"
    ("retry_after", "timer_elapsed"): "no_attempt_before_retry_after",
    ("retry_after", "handoff"): "no_attempt_before_retry_after",  # "never brings ... forward"
    ("retry_after", "restart"): "no_attempt_before_retry_after",  # "a restart restores such a wait"
    ("retry_after", "retry_after_elapsed"): "attempt",
    ("backoff", "timer_elapsed"): "no_attempt_before_backoff",
    ("backoff", "handoff"): "no_attempt_before_backoff",
    ("backoff", "restart"): "no_attempt_before_backoff",
    ("backoff", "backoff_elapsed"): "attempt",
}


def _response_case(policy: dict, response: dict) -> dict:
    status = response["status"]
    in_table = status in policy["outcomes"]
    case = {
        "status": status,
        "reason": response.get("reason", ""),
        "media": "json" if in_table else "text",
        "retriable": False,
        "complete": True,
        "staged": True,
        "digest": status not in DIGEST_FORBIDDEN,
    }
    if in_table:
        admitted = policy["outcomes"][status]
        plain = next(o for o in ("accepted", "pending", "refused") if o in admitted)
        case["outcome"] = response.get("outcome", plain)
    if "retention" in response:
        case["retention"] = response["retention"]
    elif case.get("outcome") == RETAINED:
        case["retention"] = "verified"
    if "retry_after_s" in response:
        case["retry_after_s"] = response["retry_after_s"]
    return case


def _settle(states: dict, key: tuple, action: dict, step: dict) -> str:
    """Record an attempt's outcome; an archive frees the lane in either lane."""
    if action["class"] == "archive":
        if step.get("archive_persisted", True):
            states[key] = {"class": "archived", "durable": True}
            return "archived"
        # An archive that cannot commit leaves the head held with its bytes,
        # sent once more by each process that starts without the archive.
        states[key] = {"class": "hold", "durable": False}
        return "hold"
    durable = step.get("hold_persisted", True)
    states[key] = {"class": action["class"], "durable": durable}
    return action["class"]


def replay(policy: dict, sequence: dict) -> None:
    name = sequence["name"]
    states: dict[tuple, dict] = {}
    for index, step in enumerate(sequence["steps"]):
        where = f"{name} step {index}"
        device = step.get("device", "device")
        lane = step.get("lane", "evidence")
        if lane != "evidence" and not policy["lanes"]:
            raise CheckError(f"{where}: the contract states no lane {lane!r}")
        event, expect = step["event"], step["expect"]
        if event == "artifact_handed_off_in_other_lane":
            # A newly handed-off artifact is a handoff for every lane of its device.
            if "a newly admitted outbound artifact for the same device" not in policy["handoff_text"]:
                raise CheckError(f"{where}: the contract makes no other lane's artifact a handoff")
            event = "handoff"
        if event == "queue_full":
            # An authenticated queue_full for this configured device is a handoff.
            if "an authenticated admission refused `queue_full` for a configured device" not in policy["handoff_text"]:
                raise CheckError(f"{where}: the contract makes no handoff of a queue_full refusal")
            event = "handoff"
        if event in ("queue_full_unconfigured_device", "admission_unauthenticated"):
            # Neither is a handoff for this device; like a timer, it moves nothing.
            event = "timer_elapsed"
        if event == "registration_retired":
            if not policy["registration_retirement_is_handoff"] or lane == "registration":
                raise CheckError(f"{where}: the contract makes no handoff of a retired registration here")
            event = "handoff"
        key = (device, lane)
        if expect not in EXPECTS:
            raise CheckError(f"{where}: unknown expectation {expect!r}")
        state = states.get(key)
        if event == "deliver":
            # A retired or archived entry leaves nothing at the head, so the next
            # artifact, or a later handoff of the same bytes such as a
            # registration re-offer, is a new admission.
            if state is not None and state["class"] not in ("retire", "archived"):
                raise CheckError(f"{where}: deliver after the first attempt")
            action = classify(policy, _response_case(policy, step["response"]))
            state = _settle(states, key, action, step)
            want = {"hold": "held", "retire": "retired", "archived": "archived"}.get(state, "retained")
            if expect != want:
                raise CheckError(f"{where}: expected {expect!r}, the contract gives {want!r}")
            continue
        if state is None or state["class"] == "retire":
            raise CheckError(f"{where}: {event} with nothing queued for {device}")
        if state["class"] == "hold" and event == "restart":
            outcome = "no_attempt" if state["durable"] else "attempt"
        else:
            outcome = TRANSITIONS.get((state["class"], event))
            if outcome is None:
                raise CheckError(f"{where}: the contract states no transition for {event} in {state['class']}")
        want = "attempt_fresh_envelope_same_bytes" if outcome == "attempt" else outcome
        if expect != want:
            raise CheckError(f"{where}: expected {expect!r}, the contract gives {want!r}")
        if outcome == "attempt":
            if "response" not in step:
                raise CheckError(f"{where}: an attempt names its response")
            action = classify(policy, _response_case(policy, step["response"]))
            got = _settle(states, key, action, step)
            if "then" in step:
                wanted = {"hold": "held", "retire": "retired", "archived": "archived"}.get(got, "retained")
                if step["then"] != wanted:
                    raise CheckError(f"{where}: the attempt leaves {wanted!r}, not {step['then']!r}")
        elif "response" in step:
            raise CheckError(f"{where}: a step with no attempt has no response")


REQUIRED_SEQUENCES = (
    "422 unknown_key is retried on the next handoff",
    "an unsupported artifact version is retried on the next handoff",
    "a durable hold stays held",
    "429 is retried no earlier than Retry-After",
    "every retry carries a fresh transport envelope",
    "a courier restart is a handoff",
    "a handoff or a restart never brings a back-off forward",
    "an unrecognised outcome backs off",
    "one device's hold never delays another device",
    "a hold not yet durable is sent once more",
    "a registration conflict backs off in its own lane",
    "a retired registration is a handoff for the device's evidence",
    "a new artifact in one lane is a handoff for the device's other lane",
    "a terminal registration refusal is archived and never blocks a later registration",
    "a registration accepted pending is re-offered as a new admission",
    "a retained checkpoint rollback is archived and the next envelope is delivered",
    "an archive survives a restart and is never re-sent",
    "an archive that cannot commit leaves the head held",
    "a terminal refusal answered without retention is held",
    "a retention that does not bind never releases the gateway copy",
    "a 507 holds only that device's lane",
    "non-terminal refusals stay active",
    "a 503 retention_capacity_unavailable backs off without custody",
    "an authenticated queue_full for a configured device is a handoff",
    "a pending registration's confirmation returns through a queue_full handoff",
    "a queue_full from an unconfigured device or an unauthenticated admission is no handoff",
    "a queue_full handoff never brings a back-off or a Retry-After forward",
)


def check(document: dict, policy: dict) -> None:
    check_cases(policy, document["cases"])
    check_coverage(policy, document["cases"])
    sequences = document["sequences"]
    for prefix in REQUIRED_SEQUENCES:
        if not any(s["name"].startswith(prefix) for s in sequences):
            raise CheckError(f"no sequence for: {prefix}")
    for sequence in sequences:
        replay(policy, sequence)


def corpus_mutants(document: dict, policy: dict):
    cases = document["cases"]
    for i, case in enumerate(cases):
        for klass in CLASSES:
            if klass != case["expected"]["class"]:
                bad = copy.deepcopy(document)
                bad["cases"][i]["expected"]["class"] = klass
                yield f"case {case['name']!r} class {klass}", bad
        if case["expected"]["reason"]:
            bad = copy.deepcopy(document)
            bad["cases"][i]["expected"]["reason"] = (
                case.get("reason") if case["expected"]["reason"] == UNRECOGNISED else UNRECOGNISED
            )
            if bad["cases"][i]["expected"] != case["expected"]:
                yield f"case {case['name']!r} recorded reason", bad
        if case["expected"]["class"] == "archive":
            for defect in RETENTION_DEFECTS:
                bad = copy.deepcopy(document)
                bad["cases"][i]["retention"] = defect
                yield f"case {case['name']!r} retention {defect}", bad
    for i, sequence in enumerate(document["sequences"]):
        for j, step in enumerate(sequence["steps"]):
            for expect in sorted(EXPECTS - {step["expect"]}):
                bad = copy.deepcopy(document)
                bad["sequences"][i]["steps"][j]["expect"] = expect
                yield f"sequence {sequence['name']!r} step {j} {expect}", bad

    def without(label, drop):
        bad = copy.deepcopy(document)
        bad["cases"] = [c for c in cases if not drop(c)]
        return f"without {label}", bad

    for status, reasons in policy["table"].items():
        for reason in reasons:
            yield without(f"row {status} {reason}", lambda c, s=status, r=reason: (c["status"], c.get("reason")) == (s, r))
        yield without(f"unknown reasons on {status}", lambda c, s=status, rs=reasons: c["status"] == s and c.get("reason") and c["reason"] not in rs)
        yield without(f"retriable cases on {status}", lambda c, s=status: c["status"] == s and c.get("retriable") is True)
    yield without("statuses outside the table", lambda c: c["status"] not in policy["outcomes"])
    yield without("non-JSON bodies", lambda c: not _json(c))
    yield without("the clean 200", lambda c: c["expected"]["class"] == "retire")
    yield without("cases with no outcome", lambda c: "outcome" not in c)
    yield without("invalid Retry-After", lambda c: "retry_after_s" in c and not _positive_int(c["retry_after_s"]))
    yield without("retained refusals", lambda c: c.get("outcome") == RETAINED)
    yield without("unstaged responses", lambda c: c.get("staged") is False)
    for defect in RETENTION_DEFECTS:
        yield without(f"retention {defect}", lambda c, d=defect: c.get("retention") == d)
    for prefix in REQUIRED_SEQUENCES:
        bad = copy.deepcopy(document)
        bad["sequences"] = [s for s in document["sequences"] if not s["name"].startswith(prefix)]
        yield f"without sequence {prefix!r}", bad


def text_mutants(text: str):
    """Delete each pinned unit in turn, and reword each exact action."""
    for start_marker, end_marker in ((BLOCK_START, BLOCK_END), *EXTRA_BLOCKS):
        start = text.find(start_marker)
        end = text.find(end_marker, start)
        block = text[start:end]
        units = _units_between(text, start_marker, end_marker)
        for unit in units:
            rebuilt = "\n".join(_norm(line) for line in block.splitlines())
            rebuilt = rebuilt.replace(unit, "", 1) if unit in rebuilt else _rebuild_without(block, unit)
            yield f"contract text: delete {unit[:60]!r}", text[:start] + rebuilt + text[end:]
        # Moving a unit to another place in its block must fail too.
        if len(units) > 2:
            first = units[1]
            rebuilt = _rebuild_without(block, first)
            yield f"contract text: move {first[:50]!r} to the end", text[:start] + rebuilt + "\n\n" + first + "\n\n" + text[end:]
    for phrase in ACTIONS:
        reworded = phrase.replace(";", ",", 1).rstrip(".") + " as needed."
        yield f"contract text: action {phrase!r} reworded", text.replace(phrase, reworded)
    # A classification that disagrees with the policy table, re-pinned.
    yield "contract text: 409 conflict classified non-terminal", text.replace(
        "| `409` | `conflict` | terminal |", "| `409` | `conflict` | non-terminal |")
    yield "contract text: a disposition stops gateway delivery", text.replace(
        "**Staging is idempotent by digest.**",
        "An identity-scoped disposition stops delivery at the gateway for that device.\n\n"
        "**Staging is idempotent by digest.**", 1)
    yield "contract text: 507 archives", text.replace(
        "| 507 | `retention_capacity_exhausted` | Hold. |",
        "| 507 | `retention_capacity_exhausted` | Archive once retained; otherwise hold. |")


def _rebuild_without(block: str, unit: str) -> str:
    """Remove a prose unit that spans several source lines."""
    words = unit.split()
    pattern = r"\s+".join(re.escape(w) for w in words)
    rebuilt, count = re.subn(pattern, "", block, count=1)
    if count != 1:
        raise CheckError(f"pinned unit could not be removed: {unit[:60]!r}")
    return rebuilt


def main() -> int:
    text = CONTRACT.read_text(encoding="utf-8")
    if "--print-units" in sys.argv[1:]:
        print(json.dumps(block_units(text), indent=2, ensure_ascii=False))
        return 0
    document = json.loads(VECTORS.read_text(encoding="utf-8"))
    try:
        policy = load_policy(text)
        check(document, policy)
    except CheckError as error:
        print(f"check-evidence-transport-refusal-policy-vectors: {error}", file=sys.stderr)
        return 1
    if "--mutations" in sys.argv[1:]:
        survived = []
        total = 0
        for label, bad in corpus_mutants(document, policy):
            total += 1
            try:
                check(bad, policy)
            except (CheckError, KeyError):
                continue
            survived.append(label)
        edits = list(text_mutants(text))
        for label, edited in edits:
            total += 1
            try:
                repinned = label.startswith((
                    "contract text: 409 conflict classified", "contract text: 507 archives",
                    "contract text: a disposition stops",
                ))
                check(document, load_policy(edited, check_pin=not repinned))
            except (CheckError, KeyError):
                continue
            survived.append(label)
        # Re-pin mutants: each model sentence reworded and the pin regenerated,
        # which the pin alone would accept.
        repins = 0
        for key, sentence in MODEL_SENTENCES.items():
            pattern = r"\s+".join(re.escape(w) for w in sentence.split())
            reworded = sentence.rsplit(" ", 1)[0].replace("\\", "\\\\")
            edited, count = re.subn(pattern, reworded, text, count=1)
            repins += 1
            total += 1
            if count != 1:
                survived.append(f"re-pin mutant for {key} matches nothing")
                continue
            try:
                check(document, load_policy(edited, check_pin=False))
            except (CheckError, KeyError):
                continue
            survived.append(f"re-pin: {key} reworded")
        if survived:
            for label in survived:
                print(f"mutant survived: {label}", file=sys.stderr)
            return 1
        print(
            f"refusal-policy mutations: {total} refused, {len(edits)} of them contract-text edits "
            f"and {repins} re-pinned rewordings"
        )
    print(
        f"refusal-policy vectors: {len(document['cases'])} cases and "
        f"{len(document['sequences'])} sequences hold to evidence-transport/v2"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
