#!/usr/bin/env python3
# Copyright 2026 Ori Nexus Systems LTD
# SPDX-License-Identifier: Apache-2.0
"""Check the ed25519-key-admission/v1 corpus against the contract's rules.

Every verdict is recomputed here from the contract's clauses with this
script's own affine curve arithmetic; nothing is read from the corpus but the
inputs. The points of small order are found by multiplying curve points by the
prime group order, not read from the contract or the corpus, and the contract's
table must name exactly their y-coordinates.

Held to:

- each public key: verdict and refusing clause, in the contract's order;
- coverage: every non-canonical encoding under both sign bits, every
  small-order encoding, both invalid-sign encodings, each off-curve y under both
  sign bits, and admitted keys under both sign bits;
- the mixed-order cases: refused, and genuinely of mixed order; a case naming
  a seed and a torsion point re-derives from them;
- each keyless signature: the cofactored equation accepts it under its key, and
  the case is refused for that key;
- each torsion-shift signature: the cofactorless equation accepts it under its
  shifted key, and the case is refused for that key;
- `public_keys` carry the evidence-exchange/v2 authority key registry corpus's
  encodings in order, with its verdicts except where a key of mixed order,
  which v2 admits, is refused here.

    python3 scripts/check-ed25519-key-admission-vectors
    python3 scripts/check-ed25519-key-admission-vectors --mutations

`--mutations` corrupts the corpus, edits the contract table, and switches off
each rule of the model in turn; every mutant must be refused.
"""

from __future__ import annotations

import copy
import hashlib
import json
import pathlib
import random
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "ed25519-key-admission" / "v1.md"
VECTORS = ROOT / "ed25519-key-admission" / "vectors-v1.json"
SOURCE = ROOT / "evidence-exchange" / "vectors" / "authority-key-registry-v2.json"
NAME = "ed25519-key-admission/v1"

P = 2**255 - 19
D = (-121665 * pow(121666, -1, P)) % P
L = 2**252 + 27742317777372353535851937790883648493
I = pow(2, (P - 1) // 4, P)
IDENTITY = (0, 1)
CLAUSES = ("non_canonical", "off_curve", "invalid_sign", "small_order", "mixed_order")
MIXED_SUFFIX = "; of mixed order"


class Failure(Exception):
    pass


def add(a: tuple[int, int], b: tuple[int, int]) -> tuple[int, int]:
    (x1, y1), (x2, y2) = a, b
    t = D * x1 * x2 * y1 * y2 % P
    x3 = (x1 * y2 + x2 * y1) * pow(1 + t, -1, P) % P
    y3 = (y1 * y2 + x1 * x2) * pow(1 - t, -1, P) % P
    return (x3, y3)


def mul(k: int, point: tuple[int, int]) -> tuple[int, int]:
    result = IDENTITY
    while k:
        if k & 1:
            result = add(result, point)
        point = add(point, point)
        k >>= 1
    return result


def x_for(y: int) -> int | None:
    """A square root of (y^2 - 1)/(d y^2 + 1), or None when there is none."""
    num = (y * y - 1) % P
    den = (D * y * y + 1) % P
    xx = num * pow(den, -1, P) % P
    x = pow(xx, (P + 3) // 8, P)
    if (x * x - xx) % P:
        x = x * I % P
    if (x * x - xx) % P:
        return None
    return x


def encode(point: tuple[int, int]) -> bytes:
    x, y = point
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


BASE = (x_for(4 * pow(5, -1, P) % P) or 0, 4 * pow(5, -1, P) % P)
if BASE[0] & 1:
    BASE = (P - BASE[0], BASE[1])


def small_order_points() -> set[tuple[int, int]]:
    """The torsion subgroup, found as L times random curve points."""
    rng = random.Random(25519)
    found: set[tuple[int, int]] = set()
    while len(found) < 8:
        y = rng.randrange(P)
        x = x_for(y)
        if x is None:
            continue
        found.add(mul(L, (x, y)))
    for point in found:
        if mul(8, point) != IDENTITY:
            raise Failure("a derived torsion point does not have order dividing 8")
    return found


def model(raw: bytes, *, order: tuple[str, ...] = CLAUSES, off: str = "") -> str | None:
    n = int.from_bytes(raw, "little")
    sign, y = n >> 255, n & ((1 << 255) - 1)
    checks = {}
    x = x_for(y) if y < P else None
    checks["non_canonical"] = y >= P
    checks["off_curve"] = y < P and x is None
    checks["invalid_sign"] = x == 0 and sign == 1
    point = None
    if y < P and x is not None:
        if (x & 1) != sign:
            x = (P - x) % P
        point = (x, y)
    checks["small_order"] = point is not None and mul(8, point) == IDENTITY
    checks["mixed_order"] = (
        point is not None and mul(8, point) != IDENTITY and mul(L, point) != IDENTITY
    )
    for clause in order:
        if clause != off and checks[clause]:
            return clause
    return None


def table_rows(text: str) -> dict[int, str]:
    block = text.split("| y, as 32 little-endian bytes |", 1)[1].split("\n\n", 1)[0]
    return {
        int.from_bytes(bytes.fromhex(y), "little"): label.strip()
        for y, label in re.findall(r"^\| `([0-9a-f]{64})` \|([^|]*)\|", block, re.MULTILINE)
    }


def point_order(point: tuple[int, int]) -> int:
    return next(n for n in (1, 2, 4, 8) if mul(n, point) == IDENTITY)


def derived_labels(torsion: set[tuple[int, int]]) -> dict[int, str]:
    """Each y's label, from the orders of the torsion points that share it."""
    labels: dict[int, str] = {}
    for y in {pt[1] for pt in torsion}:
        orders = sorted(point_order(pt) for pt in torsion if pt[1] == y)
        if orders == [1]:
            labels[y] = "the identity"
        elif orders == [2]:
            labels[y] = "the point of order 2"
        elif orders == [4, 4]:
            labels[y] = "the two points of order 4"
        elif orders == [8, 8]:
            labels[y] = "two points of order 8"
        else:
            raise Failure(f"torsion points sharing y have orders {orders}")
    return labels


def decode(raw: bytes) -> tuple[int, int] | None:
    n = int.from_bytes(raw, "little")
    sign, y = n >> 255, n & ((1 << 255) - 1)
    if y >= P:
        return None
    x = x_for(y)
    if x is None or (x == 0 and sign):
        return None
    return ((P - x) % P if (x & 1) != sign else x, y)


def _equation(public: bytes, message: bytes, signature: bytes, cofactor: int) -> bool:
    a, r = decode(public), decode(signature[:32])
    s = int.from_bytes(signature[32:], "little")
    if a is None or r is None or s >= L:
        return False
    k = int.from_bytes(hashlib.sha512(signature[:32] + public + message).digest(), "little") % L
    left = mul(cofactor, mul(s, BASE))
    return left == add(mul(cofactor, r), mul(cofactor, mul(k, a)))


def cofactored_accepts(public: bytes, message: bytes, signature: bytes) -> bool:
    return _equation(public, message, signature, 8)


def cofactorless_accepts(public: bytes, message: bytes, signature: bytes) -> bool:
    return _equation(public, message, signature, 1)


def derived_public_point(seed: bytes) -> tuple[int, int]:
    """RFC 8032, section 5.1.5: the public point of a private seed."""
    digest = hashlib.sha512(seed).digest()
    scalar = int.from_bytes(digest[:32], "little")
    scalar &= (1 << 254) - 8
    scalar |= 1 << 254
    return mul(scalar, BASE)


def as_v2(case: dict) -> dict:
    """A public_keys case as the v2 corpus states it: mixed order is admitted there."""
    if case.get("clause") != "mixed_order":
        return case
    why = case["why"]
    return {
        "public_key_hex": case["public_key_hex"],
        "expected": "accepted",
        "clause": None,
        "why": why[: -len(MIXED_SUFFIX)] if why.endswith(MIXED_SUFFIX) else why,
    }


def check(corpus: dict, contract: str, source: dict, *, order=CLAUSES, off="") -> None:
    if corpus.get("contract") != NAME or corpus.get("vector_set") != NAME:
        raise Failure("the corpus does not name ed25519-key-admission/v1")

    torsion = small_order_points()
    rows = table_rows(contract)
    if set(rows) != {pt[1] for pt in torsion}:
        raise Failure("the contract table does not name exactly the small-order y values")
    if rows != derived_labels(torsion):
        raise Failure("a contract table label does not match the orders of its points")

    cases = corpus["public_keys"]
    projected = [
        {k: c[k] for k in ("public_key_hex", "expected", "clause", "why") if k in c}
        for c in source["public_keys"]
    ]
    if [as_v2(c) for c in cases] != projected:
        raise Failure("public_keys differ from the evidence-exchange/v2 corpus")
    for case in cases:
        if case.get("clause") == "mixed_order" and not case["why"].endswith(MIXED_SUFFIX):
            raise Failure(f"{case['public_key_hex']}: a mixed-order case must say so")

    seen: set[bytes] = set()
    for case in cases:
        raw = bytes.fromhex(case["public_key_hex"])
        if len(raw) != 32 or raw in seen:
            raise Failure(f"{case['public_key_hex']}: not 32 bytes, or repeated")
        seen.add(raw)
        clause = model(raw, order=order, off=off)
        want = ("refused", clause) if clause else ("accepted", None)
        if (case["expected"], case.get("clause")) != want:
            raise Failure(f"{case['public_key_hex']}: corpus says {case['expected']}/{case.get('clause')}, rules say {want}")

    for y in range(P, 2**255):
        for sign in (0, 1):
            if (y | (sign << 255)).to_bytes(32, "little") not in seen:
                raise Failure(f"non-canonical y={y - P}+p sign={sign} is missing")
    for point in torsion:
        if encode(point) not in seen:
            raise Failure(f"small-order encoding {encode(point).hex()} is missing")
    for y in (1, P - 1):
        if (y | (1 << 255)).to_bytes(32, "little") not in seen:
            raise Failure(f"invalid-sign encoding of y={y} is missing")
    off_curve = {int.from_bytes(r, "little") & ((1 << 255) - 1) for r in seen if model(r) == "off_curve"}
    for y in off_curve:
        for sign in (0, 1):
            if (y | (sign << 255)).to_bytes(32, "little") not in seen:
                raise Failure(f"off-curve y={y} lacks sign {sign}")
    admitted = [r for r in seen if model(r) is None]
    if {r[31] >> 7 for r in admitted} != {0, 1}:
        raise Failure("admitted keys do not appear under both sign bits")
    mixed_seen = [r for r in seen if model(r) == "mixed_order"]
    if {r[31] >> 7 for r in mixed_seen} != {0, 1}:
        raise Failure("mixed-order keys do not appear under both sign bits")

    shifted: set[str] = set()
    for case in corpus["mixed_order"]:
        raw = bytes.fromhex(case["public_key_hex"])
        point = decode(raw)
        if point is None or mul(L, point) == IDENTITY or mul(8, point) == IDENTITY:
            raise Failure(f"mixed-order {case['public_key_hex']}: not of mixed order")
        clause = model(raw, order=order, off=off)
        if (case["expected"], case.get("clause")) != ("refused", "mixed_order") or clause != "mixed_order":
            raise Failure(f"mixed-order {case['public_key_hex']}: must be refused as mixed_order")
        if "seed_hex" in case:
            torsion_point = decode(bytes.fromhex(case["torsion_point_hex"]))
            if torsion_point is None or torsion_point not in torsion or torsion_point == IDENTITY:
                raise Failure(f"mixed-order {case['public_key_hex']}: torsion_point_hex is not a nonzero point of small order")
            original = derived_public_point(bytes.fromhex(case["seed_hex"]))
            if encode(add(original, torsion_point)) != raw:
                raise Failure(f"mixed-order {case['public_key_hex']}: does not re-derive from its seed and torsion point")
            shifted.add(case["public_key_hex"])
    if not shifted:
        raise Failure("no mixed-order case is a seed-derived key shifted by a torsion point")

    keyed = {c["public_key_hex"] for c in corpus["keyless_signatures"]}
    if keyed != {encode(pt).hex() for pt in torsion}:
        raise Failure("keyless_signatures do not cover exactly the eight small-order keys")
    for case in corpus["keyless_signatures"]:
        public = bytes.fromhex(case["public_key_hex"])
        signature = bytes.fromhex(case["signature_hex"])
        if signature != encode(BASE) + (1).to_bytes(32, "little"):
            raise Failure("a keyless signature is not R = base point, S = 1")
        if not cofactored_accepts(public, bytes.fromhex(case["message_hex"]), signature):
            raise Failure(f"{case['public_key_hex']}: the cofactored equation does not accept it")
        if (case["expected"], case["clause"]) != ("refused", model(public, order=order, off=off)):
            raise Failure(f"{case['public_key_hex']}: a keyless signature must be refused for its key")

    signed = {c["public_key_hex"] for c in corpus["torsion_shift_signatures"]}
    if not signed or signed != shifted:
        raise Failure("torsion_shift_signatures do not cover exactly the shifted mixed-order keys")
    for case in corpus["torsion_shift_signatures"]:
        public = bytes.fromhex(case["public_key_hex"])
        message = bytes.fromhex(case["message_hex"])
        signature = bytes.fromhex(case["signature_hex"])
        if not cofactorless_accepts(public, message, signature):
            raise Failure(f"{case['public_key_hex']}: the cofactorless equation does not accept the torsion-shift signature")
        if (case["expected"], case["clause"]) != ("refused", model(public, order=order, off=off)):
            raise Failure(f"{case['public_key_hex']}: a torsion-shift signature must be refused for its key")


def load() -> tuple[dict, str, dict]:
    return (
        json.loads(VECTORS.read_text(encoding="utf-8")),
        CONTRACT.read_text(encoding="utf-8"),
        json.loads(SOURCE.read_text(encoding="utf-8")),
    )


def mutations(corpus: dict, contract: str, source: dict) -> int:
    def flip_expected(c):
        c["public_keys"][0]["expected"] = "accepted"

    def wrong_clause(c):
        nc = next(k for k in c["public_keys"] if k.get("clause") == "non_canonical")
        nc["clause"] = "off_curve"

    def drop(clause):
        def run(c):
            c["public_keys"].remove(next(k for k in c["public_keys"] if k.get("clause") == clause))
        return run

    def drop_keyless(c):
        c["keyless_signatures"].pop()

    def bad_s(c):
        sig = c["keyless_signatures"][0]["signature_hex"]
        c["keyless_signatures"][0]["signature_hex"] = sig[:64] + "02" + sig[66:]

    def mixed_accepted(c):
        c["mixed_order"][0]["expected"] = "accepted"
        c["mixed_order"][0]["clause"] = None

    def public_mixed_accepted(c):
        case = next(k for k in c["public_keys"] if k.get("clause") == "mixed_order")
        case["expected"] = "accepted"
        case["clause"] = None

    def shifted_seed_changed(c):
        case = next(k for k in c["mixed_order"] if "seed_hex" in k)
        case["seed_hex"] = "00" + case["seed_hex"][2:]

    def shifted_torsion_identity(c):
        case = next(k for k in c["mixed_order"] if "seed_hex" in k)
        case["torsion_point_hex"] = "01" + "00" * 31

    def drop_shifted_case(c):
        c["mixed_order"] = [k for k in c["mixed_order"] if "seed_hex" not in k]

    def torsion_sig_altered(c):
        sig = c["torsion_shift_signatures"][0]["signature_hex"]
        c["torsion_shift_signatures"][0]["signature_hex"] = sig[:-2] + ("00" if sig[-2:] != "00" else "01")

    def drop_torsion_sig(c):
        c["torsion_shift_signatures"].clear()

    def mixed_prime(c):
        c["mixed_order"][0]["public_key_hex"] = encode(BASE).hex()

    # Each mutant names the failure it must cause, so none is refused by
    # accident. Mutants of public_keys are checked against a source carrying
    # the same mutation, so the derivation check cannot be what refuses them.
    corpus_mutants = [
        ("expected flipped", flip_expected, "rules say"),
        ("clause changed", wrong_clause, "rules say"),
        ("non-canonical case dropped", drop("non_canonical"), "non-canonical"),
        ("small-order case dropped", drop("small_order"), "small-order encoding"),
        ("invalid-sign case dropped", drop("invalid_sign"), "invalid-sign"),
        ("off-curve case dropped", drop("off_curve"), "off-curve"),
        ("keyless signature dropped", drop_keyless, "keyless_signatures do not cover"),
        ("keyless S altered", bad_s, "not R = base point"),
        ("mixed-order accepted", mixed_accepted, "must be refused as mixed_order"),
        ("mixed-order case of prime order", mixed_prime, "not of mixed order"),
        ("public mixed-order case accepted", public_mixed_accepted, "rules say"),
        ("shifted key's seed changed", shifted_seed_changed, "does not re-derive"),
        ("shifted key's torsion point the identity", shifted_torsion_identity, "not a nonzero point of small order"),
        ("shifted case dropped", drop_shifted_case, "no mixed-order case is a seed-derived key"),
        ("torsion-shift signature altered", torsion_sig_altered, "cofactorless equation does not accept"),
        ("torsion-shift signatures dropped", drop_torsion_sig, "torsion_shift_signatures do not cover"),
        ("contract renamed", lambda c: c.update(contract="ed25519-key-admission/v2"), "does not name"),
    ]
    killed = 0
    total = 0
    for label, mutate, reason in corpus_mutants:
        mutant = copy.deepcopy(corpus)
        mutate(mutant)
        twin = copy.deepcopy(source)
        twin["public_keys"] = [as_v2(copy.deepcopy(c)) for c in mutant["public_keys"]]
        total += 1
        try:
            check(mutant, contract, twin)
        except Failure as exc:
            if reason in str(exc):
                killed += 1
            else:
                print(f"WRONG REASON: {label}: {exc}", file=sys.stderr)
        else:
            print(f"SURVIVED: {label}", file=sys.stderr)
    total += 1
    drifted = copy.deepcopy(corpus)
    drifted["public_keys"][0]["why"] = "reworded"
    try:
        check(drifted, contract, source)
    except Failure as exc:
        killed += "evidence-exchange/v2 corpus" in str(exc)
    else:
        print("SURVIVED: public_keys drifted from the source corpus", file=sys.stderr)
    row = "26e8958fc2b227b045c3f489f2ef98f0d5dfac05d3c63339b13802886d53fc05"
    for label, text in (
        ("table row removed", contract.replace(f"| `{row}` | two points of order 8 |\n", "")),
        ("table row altered", contract.replace(row, row[:-2] + "06")),
        (
            "table label swapped",
            contract.replace("| the point of order 2 |", "| the two points of order 4 |"),
        ),
    ):
        total += 1
        try:
            check(corpus, text, source)
        except Failure:
            killed += 1
        else:
            print(f"SURVIVED: {label}", file=sys.stderr)
    for clause in CLAUSES:
        total += 1
        try:
            check(corpus, contract, source, off=clause)
        except Failure:
            killed += 1
        else:
            print(f"SURVIVED: rule {clause} switched off", file=sys.stderr)
    total += 1
    try:
        check(
            corpus,
            contract,
            source,
            order=("off_curve", "non_canonical", "small_order", "invalid_sign", "mixed_order"),
        )
    except Failure:
        killed += 1
    else:
        print("SURVIVED: clause order changed", file=sys.stderr)
    print(f"mutations: {killed} of {total} refused")
    return 0 if killed == total else 1


def main() -> int:
    corpus, contract, source = load()
    try:
        check(corpus, contract, source)
    except Failure as exc:
        print(f"check-ed25519-key-admission-vectors: {exc}", file=sys.stderr)
        return 1
    print(
        f"ed25519-key-admission/v1: {len(corpus['public_keys'])} public keys, "
        f"{len(corpus['mixed_order'])} mixed-order, "
        f"{len(corpus['keyless_signatures'])} keyless signatures, "
        f"{len(corpus['torsion_shift_signatures'])} torsion-shift signatures agree with the contract"
    )
    if "--mutations" in sys.argv[1:]:
        return mutations(corpus, contract, source)
    return 0


if __name__ == "__main__":
    sys.exit(main())
