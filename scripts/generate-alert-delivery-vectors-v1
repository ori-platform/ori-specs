# --- receiver sequences (check 6) --------------------------------------------------------------------
def epoch_of(key_identity: str) -> bytes:
    for k in KEYS.values():
        if identity(k.pub) == key_identity:
            return recognised(k.pub)
    raise KeyError(key_identity)


def breaks(h: dict, o: dict) -> bool:
    """Whether o, against the stored observation h, is different bytes under h's identity or breaks Consistency.

    Every rule holds within one device_id, whatever key signs each record.
    """
    if h["device_id"] != o["device_id"]:
        return False
    same_attempt = h["delivery_attempt_id"] == o["delivery_attempt_id"]
    hs, os_ = integer(h["observation_seq"]), integer(o["observation_seq"])
    if same_attempt and hs == os_:
        return True  # different bytes under a held identity
    if same_attempt and any(h[m] != o[m] for m in ("alert_id", "notice", "class", "channel", "attempt_seq",
                                                     "attempted_at_ms")):
        return True
    if h["alert_id"] == o["alert_id"] and (h["notice"], h["class"]) != (o["notice"], o["class"]):
        return True
    if not same_attempt and h["attempt_seq"] == o["attempt_seq"]:
        return True
    if same_attempt and hs == os_ - 1:
        return h["outcome"] != o["prior_outcome"]
    if same_attempt and hs == os_ + 1:
        return h["prior_outcome"] != o["outcome"]
    return False


def tally_key(o: dict) -> tuple:
    return (o["device_id"], epoch_of(o["key_identity"]), o["channel"], o["class"] or "", o["reason"], o["month"])


class Receiver:
    def __init__(self, ctx: dict) -> None:
        self.ctx = ctx
        self.kept: list[dict] = []  # {"data", "obj", "verdict", "hit"}

    def check6(self, data: str, o: dict) -> tuple[str, list]:
        if any(k["data"] == data for k in self.kept):  # identical to a record held as stored or as conflict
            return "duplicate", []
        stored = [k for k in self.kept if k["verdict"] == "stored"]  # never judged against a conflict record
        if o["kind"] == "submission":
            hit = [k for k in stored if k["obj"]["kind"] == "submission" and breaks(k["obj"], o)]
            return ("conflict", hit) if hit else ("stored", [])
        same = [k for k in stored if k["obj"]["kind"] == "withheld_tally" and tally_key(k["obj"]) == tally_key(o)]
        hit = [k for k in same if integer(k["obj"]["count"]) == integer(o["count"])]
        if hit:
            return "conflict", hit
        if same and integer(o["count"]) < max(integer(k["obj"]["count"]) for k in same):
            return "lower_count", []
        return "stored", []

    def receive(self, data: str) -> str:
        reason = receiver_stateless(data, self.ctx)
        if reason is not None:
            return reason
        o = parse(data)
        verdict, hit = self.check6(data, o)
        if verdict in ("stored", "conflict"):
            self.kept.append({"data": data, "obj": o, "verdict": verdict, "hit": hit})
        return verdict

    def reading(self) -> tuple[list, list]:
        stored = [k["obj"] for k in self.kept if k["verdict"] == "stored"]
        unsettled = set()
        for k in self.kept:
            if k["verdict"] == "conflict":
                for r in [k] + k["hit"]:  # neither side of a conflict is presented as settled
                    o = r["obj"]
                    unsettled.add((o["device_id"], o["alert_id"]) if o["kind"] == "submission" else tally_key(o))
        alerts: dict = {}
        for o in stored:
            if o["kind"] == "submission":
                alerts.setdefault((o["device_id"], o["alert_id"]), {}).setdefault(o["channel"], []).append(o)
        reading = []
        for (dev, aid), chans in sorted(alerts.items()):
            out = {}
            for ch, obs_ in sorted(chans.items()):
                top = max(integer(x["attempt_seq"]) for x in obs_)
                last = max((x for x in obs_ if integer(x["attempt_seq"]) == top),
                           key=lambda x: integer(x["observation_seq"]))
                out[ch] = {"latest_attempt_state": last["outcome"],
                           "ever_accepted": any(x["outcome"] == "accepted" for x in obs_)}
            reading.append({"device_id": dev, "alert_id": aid, "channels": out,
                            "accepted_on_some_channel": any(c["ever_accepted"] for c in out.values()),
                            "settled": (dev, aid) not in unsettled})
        tallies: dict = {}
        for o in stored:
            if o["kind"] == "withheld_tally":
                tk = tally_key(o)
                if tk not in tallies or integer(o["count"]) > integer(tallies[tk]["count"]):
                    tallies[tk] = o
        held = [{"device_id": o["device_id"], "epoch": o["key_identity"], "channel": o["channel"],
                 "class": o["class"], "reason": o["reason"], "month": o["month"], "count": integer(o["count"]),
                 "record_digest": digest(text(o)), "settled": tk not in unsettled}
                for tk, o in sorted(tallies.items(), key=lambda kv: (kv[1]["device_id"], kv[1]["key_identity"],
                                                                     kv[0][2:]))]
        return reading, held


RECEIVER_SEQUENCES: list[dict] = []


def rseq(name: str, note: str, recs: list, ctx: dict | None = None) -> None:
    ctx = ctx or fixture()
    ctx = {k: v for k, v in ctx.items() if k not in ("topic_device", "configured_devices")}
    datas = [r if isinstance(r, str) else text(r) for r in recs]
    rcv = Receiver(ctx)
    verdicts = [rcv.receive(d) for d in datas]
    reading, tallies = rcv.reading()
    RECEIVER_SEQUENCES.append({"name": name, "note": note, **ctx,
                               "records": [{"record": d, "expected": v} for d, v in zip(datas, verdicts)],
                               "expected_reading": reading, "expected_tallies": tallies})


def obs(alert: str, attempt: str, aseq: int, oseq: int, prior: object, outcome: str, detail: object = None,
        *, signer: object = RUNTIME, channel: str = "sms", issued: int | None = None, **over: object) -> dict:
    members = {"alert_id": alert, "delivery_attempt_id": attempt, "attempt_seq": aseq,
               "attempted_at_ms": T0 + aseq * 10_000, "observation_seq": oseq, "prior_outcome": prior,
               "outcome": outcome, "detail": detail, "channel": channel,
               "issued_at_ms": issued if issued is not None else T0 + aseq * 10_000 + oseq * 1000}
    return submission(signer, **{**members, **over})


