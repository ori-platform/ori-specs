"""Generate alert-delivery/v1 vectors.

Writes alert-delivery/vectors/alert-delivery-v1.json: signed records as exact
bytes, each with the verdict a gateway gives it at checks 3, 4 and 6 of
Carriage and custody and the verdict a receiver gives it at checks 1 to 5 of
Verifying; receiver sequences, each record with its check 6 verdict and, after
the last, the reading of Reading a notice and the tallies held; carriage
sequences with the gateway's custody verdict and acknowledgement; enrolment
proofs with their challenge bytes, signing input, signature and verdict; and
the gateway-config/v2 alert_delivery load rules. Keys are SHA-256 of a
published label and are test keys only.

Usage: generate-alert-delivery-vectors-v1 [--check]
"""

from __future__ import annotations

import base64
import hashlib
import json
import pathlib
import re
import sys

from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric.ed25519 import (
    Ed25519PrivateKey,
    Ed25519PublicKey,
)
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "alert-delivery" / "vectors" / "alert-delivery-v1.json"

DOMAIN = b"ori.alert_delivery.v1\x00"
ENROL_DOMAIN = b"ori.report_key_enrolment.v1\x00"
POSTURE_DOMAIN = b"ori.runtime_posture.v1\x00"
SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")
MAX_INT = 2**53 - 1
RECORD_TOPIC_BOUND = 1024
RECORD_PAYLOAD_MAX = 4096  # gateway-api/v2 Payload Size for the record topic, and the receiver's own bound
DEVICE = "site-a-edge-01"
OTHER_DEVICE = "site-a-edge-02"
FORWARDER = "gateway-site-a"
OTHER_FORWARDER = "gateway-site-b"
PURPOSE = "alert_delivery_report"
T0 = 1_787_000_000_000

DEVICE_RE = re.compile(r"[A-Za-z0-9._-]{1,128}")
ID_RE = re.compile(r"[A-Za-z0-9_-]{16,64}")
CLASS_RE = re.compile(r"[a-z][a-z0-9_]{0,31}")
MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")
KEY_ID_RE = re.compile(r"sha256:[0-9a-f]{64}")
NONCE_RE = re.compile(r"(?:[0-9a-f]{2}){16,32}")
NOTICES = ("optional", "tier_d", "protection_degraded")
MANDATORY = ("tier_d", "protection_degraded")
CHANNELS = ("sms", "whatsapp")
OUTCOMES = ("accepted", "failed", "unconfirmed")
DETAILS = {"accepted": (), "failed": ("provider_refused", "provider_reported_failure", "not_submitted"),
           "unconfirmed": ("timeout_after_submit", "response_unreadable")}
ALL_DETAILS = tuple(d for v in DETAILS.values() for d in v)
REASONS = ("disabled", "capped")
SUBMISSION = {"v", "kind", "device_id", "key_identity", "alert_id", "notice", "class", "channel",
              "delivery_attempt_id", "attempt_seq", "attempted_at_ms", "observation_seq", "prior_outcome",
              "outcome", "detail", "issued_at_ms", "signature"}
TALLY = {"v", "kind", "device_id", "key_identity", "channel", "class", "reason", "month", "count",
         "issued_at_ms", "signature"}
# Observations of one attempt: (observation_seq, prior_outcome) -> permitted outcomes. Row 3's further
# condition, that the second observation followed an unconfirmed, follows from row 2 and consistency.
TRANSITIONS = {(1, None): {"accepted", "failed", "unconfirmed"}, (2, "unconfirmed"): {"accepted", "failed"},
               (2, "accepted"): {"failed"}, (3, "accepted"): {"failed"}}
# Unicode White_Space.
WHITE_SPACE = set("\t\n\x0b\x0c\r \x85\xa0     　") | {chr(c) for c in range(0x2000, 0x200B)}


# --- keys -------------------------------------------------------------------------------------------
def seed(name: str) -> bytes:
    return hashlib.sha256(f"ori alert-delivery/v1 {name} test key".encode("ascii")).digest()


def b64(b: bytes) -> str:
    return base64.b64encode(b).decode("ascii")


def identity(pub: bytes) -> str:
    return "sha256:" + hashlib.sha256(SPKI_PREFIX + pub).hexdigest()


def recognised(pub: bytes) -> bytes:
    return pub[:31] + bytes([pub[31] & 0x7F])


class Signer:
    def __init__(self, name: str) -> None:
        self.name = name
        self.key = Ed25519PrivateKey.from_private_bytes(seed(name))
        self.pub = self.key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)

    def sign(self, message: bytes) -> bytes:
        return self.key.sign(message)


# Edwards25519 arithmetic: to sign under a key's negation, to recognise keys, and for key admission.
FIELD = 2**255 - 19
ORDER = 2**252 + 27742317777372353535851937790883648493
D = -121665 * pow(121666, FIELD - 2, FIELD) % FIELD
IDENT = (0, 1, 1, 0)


def padd(a: tuple, b: tuple) -> tuple:
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    k1 = (y1 - x1) * (y2 - x2) % FIELD
    k2 = (y1 + x1) * (y2 + x2) % FIELD
    k3 = 2 * D * t1 * t2 % FIELD
    k4 = 2 * z1 * z2 % FIELD
    e, f, g, h = k2 - k1, k4 - k3, k4 + k3, k2 + k1
    return (e * f % FIELD, g * h % FIELD, f * g % FIELD, e * h % FIELD)


def pmul(n: int, p: tuple) -> tuple:
    acc = IDENT
    while n:
        if n & 1:
            acc = padd(acc, p)
        p = padd(p, p)
        n >>= 1
    return acc


def penc(p: tuple) -> bytes:
    x, y, z, _ = p
    inv = pow(z, FIELD - 2, FIELD)
    x, y = x * inv % FIELD, y * inv % FIELD
    return (y | (x & 1) << 255).to_bytes(32, "little")


def pdec(raw: bytes) -> tuple | str:
    """A point, or the ed25519-key-admission/v1 decoding clause that refuses the encoding."""
    v = int.from_bytes(raw, "little")
    sign, y = v >> 255, v & ((1 << 255) - 1)
    if y >= FIELD:
        return "non_canonical"
    xx = (y * y - 1) * pow(D * y * y + 1, FIELD - 2, FIELD) % FIELD
    x = pow(xx, (FIELD + 3) // 8, FIELD)
    if (x * x - xx) % FIELD:
        x = x * pow(2, (FIELD - 1) // 4, FIELD) % FIELD
    if (x * x - xx) % FIELD:
        return "off_curve"
    if x == 0 and sign:
        return "invalid_sign"
    if x & 1 != sign:
        x = FIELD - x
    return (x, y, 1, x * y % FIELD)


def is_identity(p: tuple) -> bool:
    x, y, z, _ = p
    return x % FIELD == 0 and (y - z) % FIELD == 0


def admission(raw: bytes) -> str | None:
    p = pdec(raw)
    if isinstance(p, str):
        return p
    if is_identity(pmul(8, p)):
        return "small_order"
    if not is_identity(pmul(ORDER, p)):
        return "mixed_order"
    return None


BASE = pdec((4 * pow(5, FIELD - 2, FIELD) % FIELD).to_bytes(32, "little"))


class Negated:
    """Signs as the holder of a key does under that key's negation: with -a under -A."""

    def __init__(self, of: Signer) -> None:
        self.name = of.name + "_negated"
        self.of = of
        self.pub = of.pub[:31] + bytes([of.pub[31] ^ 0x80])

    def sign(self, message: bytes) -> bytes:
        h = hashlib.sha512(seed(self.of.name)).digest()
        a = int.from_bytes(h[:32], "little") & ((1 << 254) - 8) | (1 << 254)
        r = int.from_bytes(hashlib.sha512(h[32:] + message).digest(), "little") % ORDER
        big_r = penc(pmul(r, BASE))
        k = int.from_bytes(hashlib.sha512(big_r + self.pub + message).digest(), "little") % ORDER
        sig = big_r + ((r + k * (ORDER - a % ORDER)) % ORDER).to_bytes(32, "little")
        Ed25519PublicKey.from_public_bytes(self.pub).verify(sig, message)
        return sig


RUNTIME, OTHER, ROTATED = Signer("runtime"), Signer("other"), Signer("rotated")
NEGATED = Negated(RUNTIME)
SMALL_ORDER = bytes.fromhex("01" + "00" * 31)  # the identity: ed25519-key-admission/v1 small_order
KEYS = {s.name: s for s in (RUNTIME, OTHER, ROTATED, NEGATED)}
assert len({recognised(s.pub) for s in (RUNTIME, OTHER, ROTATED)}) == 3
assert recognised(NEGATED.pub) == recognised(RUNTIME.pub) and admission(NEGATED.pub) is None
assert admission(SMALL_ORDER) == "small_order" and all(admission(s.pub) is None for s in KEYS.values())


# --- canonical bytes ---------------------------------------------------------------------------------
class Raw(str):
    """A JSON number token kept exactly as written."""


def emit(value: object) -> str:
    if isinstance(value, Raw):
        return str(value)
    if value is True:
        return "true"
    if value is False:
        return "false"
    if value is None:
        return "null"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, dict):
        return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + emit(value[k]) for k in sorted(value)) + "}"
    if isinstance(value, list):
        return "[" + ",".join(emit(v) for v in value) + "]"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    raise TypeError(value)


def canonical(obj: dict) -> bytes:
    return emit(obj).encode("utf-8")


def text(obj: dict) -> str:
    return canonical(obj).decode("utf-8")


def parse(data: str) -> object:
    def pairs(items: list) -> dict:
        if len({k for k, _ in items}) != len(items):
            raise ValueError("a member named twice is the Payload Member Rule's, outside this corpus")
        return dict(items)
    return json.loads(data, parse_int=Raw, parse_float=Raw, object_pairs_hook=pairs)


def integer(v: object) -> int | None:
    if isinstance(v, Raw) and re.fullmatch(r"0|[1-9][0-9]*", v):
        return int(v)
    return None


def digest(data: str) -> str:
    return "sha256:" + hashlib.sha256(data.encode("utf-8")).hexdigest()


def sign_obj(obj: dict, signer: object, domain: bytes = DOMAIN) -> str:
    unsigned = {k: v for k, v in obj.items() if k != "signature"}
    return b64(signer.sign(domain + canonical(unsigned)))


# --- record builders ---------------------------------------------------------------------------------
def submission(signer: object = RUNTIME, *, drop: tuple = (), domain: bytes = DOMAIN, **over: object) -> dict:
    obj = {"v": 1, "kind": "submission", "device_id": DEVICE, "key_identity": identity(signer.pub),
           "alert_id": "q3Jx0bS6lVb8nT2aXw9e1g", "notice": "optional", "class": "grid_power_restored",
           "channel": "sms", "delivery_attempt_id": "Zt4Qm8yK2cR7vP1nL0sW5a", "attempt_seq": 41,
           "attempted_at_ms": T0 + 500, "observation_seq": 1, "prior_outcome": None, "outcome": "accepted",
           "detail": None, "issued_at_ms": T0 + 1000}
    obj.update({k: v for k, v in over.items() if k != "signature"})
    for k in drop:
        del obj[k]
    obj["signature"] = sign_obj(obj, signer, domain)
    if "signature" in over:
        obj["signature"] = over["signature"]
    return obj


def tally(signer: object = RUNTIME, *, drop: tuple = (), domain: bytes = DOMAIN, **over: object) -> dict:
    obj = {"v": 1, "kind": "withheld_tally", "device_id": DEVICE, "key_identity": identity(signer.pub),
           "channel": "sms", "class": "grid_power_restored", "reason": "disabled", "month": "2026-08",
           "count": 3, "issued_at_ms": T0 + 2000}
    obj.update({k: v for k, v in over.items() if k != "signature"})
    for k in drop:
        del obj[k]
    obj["signature"] = sign_obj(obj, signer, domain)
    if "signature" in over:
        obj["signature"] = over["signature"]
    return obj


# --- judgement: gateway checks 3 to 6, receiver checks 1 to 6 -----------------------------------------
def is_str(v: object) -> bool:
    """A JSON string. Raw is a number token kept as written, a str subclass, and never a string."""
    return type(v) is str


def word(v: object, vocabulary: tuple) -> bool:
    return is_str(v) and v in vocabulary


def b64_ok(s: object, n: int) -> bool:
    if not is_str(s):
        return False
    try:
        d = base64.b64decode(s, validate=True)
    except ValueError:
        return False
    return len(d) == n and b64(d) == s


def string(v: object, pattern: re.Pattern) -> bool:
    return is_str(v) and v.isascii() and pattern.fullmatch(v) is not None


def int_in(v: object, lo: int, hi: int) -> bool:
    n = integer(v)
    return n is not None and lo <= n <= hi


def class_ok(v: object) -> bool:
    return v is None or string(v, CLASS_RE)


def form_ok(o: object) -> bool:
    """Gateway check 4: a record of either kind, every member present, of its type and within its form.

    A member's form is its own type, pattern, bounds and vocabulary. Rules that relate two members, the
    observation table, the class rules and the detail table, are check 5's of Verifying.
    """
    if not isinstance(o, dict) or not word(o.get("kind"), ("submission", "withheld_tally")):
        return False
    common = (integer(o.get("v")) == 1 and string(o.get("device_id"), DEVICE_RE)
              and string(o.get("key_identity"), KEY_ID_RE) and word(o.get("channel"), CHANNELS)
              and class_ok(o.get("class")) and int_in(o.get("issued_at_ms"), 1, MAX_INT)
              and b64_ok(o.get("signature"), 64))
    if o["kind"] == "submission":
        return (set(o) == SUBMISSION and common and string(o["alert_id"], ID_RE)
                and word(o["notice"], NOTICES) and string(o["delivery_attempt_id"], ID_RE)
                and int_in(o["attempt_seq"], 1, MAX_INT) and int_in(o["attempted_at_ms"], 1, MAX_INT)
                and int_in(o["observation_seq"], 1, 3)
                and (o["prior_outcome"] is None or word(o["prior_outcome"], OUTCOMES))
                and word(o["outcome"], OUTCOMES)
                and (o["detail"] is None or word(o["detail"], ALL_DETAILS)))
    return (set(o) == TALLY and common and word(o["reason"], REASONS) and string(o["month"], MONTH_RE)
            and int_in(o["count"], 1, MAX_INT))


def shape(obj: object) -> str | None:
    """Check 4 of Carriage and custody: unsupported_version for a v within the integer rule other than 1."""
    if isinstance(obj, dict) and int_in(obj.get("v"), 2, MAX_INT):
        return "unsupported_version"
    return None if form_ok(obj) else "malformed"


def gateway_stateless(data: str, topic: str, configured: list) -> str | None:
    """Checks 1 (Payload Size only) and 3 to 6 of Carriage and custody; volume and check 2 are gateway-api/v2's."""
    if len(data.encode("utf-8")) > RECORD_PAYLOAD_MAX:
        return "payload_too_large"
    obj = parse(data)
    if canonical(obj) != data.encode("utf-8"):
        return "not_canonical"
    if shape(obj) is not None:
        return shape(obj)
    if topic not in configured:
        return "unknown_device"
    if obj["device_id"] != topic:
        return "device_mismatch"
    return None


def rules_verdict(o: dict) -> str | None:
    """Check 5 of Verifying, in the order it lists its reasons."""
    if o["kind"] == "submission":
        seq = integer(o["observation_seq"])
        if o["outcome"] not in TRANSITIONS.get((seq, o["prior_outcome"]), set()):
            return "transition_refused"
        if o["notice"] in MANDATORY and o["class"] is not None:
            return "class_refused"
        code = o["detail"]
        if code is not None and (code not in DETAILS[o["outcome"]]
                                 or (o["prior_outcome"] == "accepted") != (code == "provider_reported_failure")):
            return "detail_refused"
        return None
    if o["reason"] == "disabled" and o["class"] is None:
        return "class_refused"
    return None


def verify(pub: bytes, sig_b64: str, message: bytes) -> bool:
    if admission(pub) is not None:
        return False
    try:
        Ed25519PublicKey.from_public_bytes(pub).verify(base64.b64decode(sig_b64), message)
    except InvalidSignature:
        return False
    return True


def receiver_stateless(data: str, ctx: dict) -> str | None:
    """Checks 1 to 5 of Verifying. Check 1 is the receiver's own 4096-byte bound, then carriage checks 3 and 4
    (check 2, the Payload Member Rule, is gateway-api/v2's corpora's): a receiver receives no topic."""
    if len(data.encode("utf-8")) > RECORD_PAYLOAD_MAX:
        return "payload_too_large"
    obj = parse(data)
    if canonical(obj) != data.encode("utf-8"):
        return "not_canonical"
    if shape(obj) is not None:
        return shape(obj)
    enrolled = enrolment_of(obj, ctx["enrolments"], revoked_too=True)
    permitted = ctx["forwarding_registry"].get(ctx["forwarder"], [])
    if not any(p["device_id"] == obj["device_id"] and (enrolled is None or p["owner"] == enrolled["owner"])
               for p in permitted):
        return "not_owned"  # the owner the key's enrolment names, or, with no enrolment, the device alone
    if enrolled is None:
        return "key_not_enrolled"
    if enrolled["revoked"]:
        return "key_revoked"
    unsigned = {k: v for k, v in obj.items() if k != "signature"}
    if not verify(KEYS[enrolled["key"]].pub, obj["signature"], DOMAIN + canonical(unsigned)):
        return "signature_invalid"
    return rules_verdict(obj)


def enrolment_of(obj: dict, enrolments: list, *, revoked_too: bool = False) -> dict | None:
    """The enrolment of the record's key for its device, for report signing (not revoked, unless asked), or None."""
    for e in enrolments:
        if (e["device_id"] == obj["device_id"] and e["purpose"] == PURPOSE and (revoked_too or not e["revoked"])
                and identity(KEYS[e["key"]].pub) == obj["key_identity"]):
            return e
    return None


def derive_lineages(enrolments: list) -> dict:
    """Each enrolment's lineage, numbered per device from 1, derived in revision order from its signed origin.

    An origin equal to the key_identity or the recorded origin of a key held enrolled for the device to the same
    owner joins that key's lineage; any other
    origin, the key itself, a key never enrolled, a key enrolled only for another purpose, or (in a registry
    check 6 would never let arise) a key held to another owner, begins a lineage of its own at the receiver.
    """
    out: dict = {}
    by_device: dict = {}
    for e in enrolments:
        by_device.setdefault(e["device_id"], []).append(e)
    for es in by_device.values():
        held: list = []
        n = 0
        for e in sorted(es, key=lambda e: e["revision"]):
            if e["purpose"] != PURPOSE:
                continue  # an enrolment for another purpose has no lineage and is never held
            joined = [h for h in held if e["lineage_origin"] in (identity(KEYS[h["key"]].pub), h["lineage_origin"])
                      and h["owner"] == e["owner"]]
            if joined:
                out[id(e)] = out[id(joined[0])]
            else:
                n += 1
                out[id(e)] = n
            held.append(e)
    return out


def lineage_of(enrolment: dict, enrolments: list) -> int:
    return derive_lineages(enrolments)[id(enrolment)]


def enr(device: str, key: str, revision: int = 1, origin: str | None = None, owner: str = "site-a",
        purpose: str = PURPOSE, revoked: bool = False) -> dict:
    """origin: the test key whose key_identity is the signed lineage origin; the key itself when None. An
    enrolment for another purpose has no lineage_origin."""
    e = {"device_id": device, "key": key, "purpose": purpose, "owner": owner, "revision": revision,
         "lineage_origin": identity(KEYS[origin or key].pub), "revoked": revoked}
    if purpose != PURPOSE:
        del e["lineage_origin"]
    return e


def perm(device: str, owner: str = "site-a") -> dict:
    return {"device_id": device, "owner": owner}


def check_enrolments(enrolments: list, other_owner_origin: bool = False) -> None:
    """other_owner_origin lifts, for one defence-in-depth fixture, the assert that no enrolment names as its
    origin a key held for the device to another owner, which check 6 refuses as lineage_mismatch."""
    by_device: dict = {}
    for e in enrolments:
        by_device.setdefault(e["device_id"], []).append(e)
    report = [e for e in enrolments if e["purpose"] == PURPOSE]
    for es in by_device.values():
        assert len({e["revision"] for e in es}) == len(es)
        es = sorted((e for e in es if e["purpose"] == PURPOSE), key=lambda e: e["revision"])
        for i, e in enumerate(es):
            crossed = [h for h in es[:i] if h["owner"] != e["owner"]
                       and e["lineage_origin"] in (identity(KEYS[h["key"]].pub), h["lineage_origin"])]
            assert other_owner_origin or not crossed, "refused at enrolment as lineage_mismatch"
    for e in report:
        for h in report:
            if h is not e and h["device_id"] != e["device_id"]:
                assert e["lineage_origin"] not in (identity(KEYS[h["key"]].pub), h["lineage_origin"]), \
                    "refused at enrolment as lineage_mismatch: an origin of another device"
            if h is not e and h["key"] == e["key"]:
                assert (h["device_id"], h["owner"]) == (e["device_id"], e["owner"]), \
                    "refused at enrolment as key_already_enrolled"
    derive_lineages(enrolments)


def fixture(device: str = DEVICE, *, enrol: tuple = ("runtime",), forwarder: str = FORWARDER,
            registry: dict | None = None, enrolments: list | None = None, other_owner_origin: bool = False) -> dict:
    """enrol: keys enrolled in turn, each after the first a rotation of the one before, naming its origin."""
    enrolments = enrolments if enrolments is not None else [
        enr(device, k, i + 1, enrol[0]) for i, k in enumerate(enrol)]
    check_enrolments(enrolments, other_owner_origin)
    return {"topic_device": device, "configured_devices": [device], "forwarder": forwarder,
            "forwarding_registry": registry if registry is not None else {FORWARDER: [perm(device)]},
            "enrolments": enrolments}


# A store reset begins lineage 2 under rotated; a move to site-b does too, to another owner.
RESET = fixture(enrolments=[enr(DEVICE, "runtime"), enr(DEVICE, "rotated", 2)])
MOVED = fixture(registry={FORWARDER: [perm(DEVICE)], OTHER_FORWARDER: [perm(DEVICE, "site-b")]},
                enrolments=[enr(DEVICE, "runtime"), enr(DEVICE, "rotated", 2, owner="site-b")])
# A skipped key: runtime enrolled; other begins a lineage and is never enrolled; rotated, its rotation, names
# other as its origin, so begins a lineage of its own at the receiver.
SKIPPED = fixture(enrolments=[enr(DEVICE, "runtime"), enr(DEVICE, "rotated", 2, "other")])
# runtime began a lineage and rotated to rotated before any enrolment: only rotated is enrolled, origin runtime.
ORIGIN_UNENROLLED = fixture(enrolments=[enr(DEVICE, "rotated", 1, "runtime")])


# --- records -----------------------------------------------------------------------------------------
RECORD_CASES: list[dict] = []


def rcase(name: str, note: str, rec: object, gateway: str, receiver: str, ctx: dict | None = None) -> None:
    data = rec if isinstance(rec, str) else text(rec)
    ctx = ctx or fixture()
    g = gateway_stateless(data, ctx["topic_device"], ctx["configured_devices"]) or "pass"
    r = receiver_stateless(data, ctx) or "pass"
    if (g, r) != (gateway, receiver):
        raise AssertionError(f"{name}: computed gateway {g}, receiver {r}; declared {gateway}, {receiver}")
    if any(c["name"] == name for c in RECORD_CASES):
        raise AssertionError(f"duplicate case name {name}")
    RECORD_CASES.append({"name": name, "note": note, "record": data, **ctx,
                         "expected_gateway": g, "expected_receiver": r})


def ok(name: str, note: str, rec: object, ctx: dict | None = None) -> None:
    rcase(name, note, rec, "pass", "pass", ctx)


def gw(name: str, note: str, rec: object, reason: str, ctx: dict | None = None) -> None:
    rcase(name, note, rec, reason, reason, ctx)


def rx_only(name: str, note: str, rec: object, reason: str, ctx: dict | None = None) -> None:
    rcase(name, note, rec, "pass", reason, ctx)


GOOD = submission()
TGOOD = tally()

# Accepted: every row of the observation table, every detail code, every outcome, both kinds.
ok("row1_accepted", "Observation table row 1: seq 1, prior null, accepted; detail null, the only detail "
   "accepted permits.", GOOD)
ok("row1_failed_provider_refused", "Row 1, failed, detail provider_refused.",
