         [(DEVICE, obs(AL1, AT1, 1, 1, None, "accepted")), (DEVICE, obs(AL1, AT2, 2, 1, None, "accepted")),
          (DEVICE, obs(AL1, AT3, 3, 1, None, "accepted")), (DEVICE, obs(AL1, AT1, 1, 1, None, "accepted")),
          (DEVICE, obs(AL1, AT3, 3, 1, None, "accepted")),
