# --- enrolment sequences ---------------------------------------------------------------------------
ENROL_SEQUENCES: list[dict] = []
NONCE_C = hashlib.sha256(b"ori alert-delivery/v1 test nonce c").hexdigest()[:48]


def estep(signer: object, issued: str, *, named_nonce: str | None = None, signed_by: object = None,
          device: str = DEVICE, owner: str = "site-a") -> dict:
    """One proof: `signer` is the key being enrolled; the challenge names `named_nonce` (the issued one when None),
    and `signed_by` signs it (the key being enrolled when None)."""
    chal = text(challenge(signer, nonce=named_nonce or issued, device_id=device))
    sig = b64((signed_by or signer).sign(ENROL_DOMAIN + chal.encode("utf-8")))
    return {"enrolling_device_id": device, "enrolling_owner": owner, "enrolling_public_key": "ed25519:" + b64(signer.pub),
            "enrolling_key_identity": identity(signer.pub), "issued_nonce": issued, "challenge": chal,
            "challenge_b64": b64(chal.encode("utf-8")),
            "signing_input_hex": (ENROL_DOMAIN + chal.encode("utf-8")).hex(), "signature": sig}


def eseq(name: str, note: str, steps: list) -> None:
    held_now: list = []
    consumed: set = set()
    out = []
    for st in steps:
        pub = base64.b64decode(st["enrolling_public_key"][8:])
        v = enrol_verdict(st["challenge"], st["signature"], st["enrolling_device_id"], pub, st["issued_nonce"],
                          st["issued_nonce"] in consumed, held_now) or "pass"
        consumed.add(st["issued_nonce"])  # consumed whether or not the proof verifies
        if v == "pass":
            held_now.append({"device_id": st["enrolling_device_id"], "public_key": st["enrolling_public_key"],
                             "key_identity": st["enrolling_key_identity"], "purpose": PURPOSE,
                             "owner": st["enrolling_owner"], "revoked": False})
        out.append({**st, "expected": v, "expected_held": [dict(h) for h in held_now]})
    ENROL_SEQUENCES.append({"name": name, "note": note, "steps": out})


eseq("refused_nonce_then_valid", "runtime's proof names a nonce the receiver did not issue: nonce_mismatch, which "
     "holds nothing and consumes the issued nonce. A fresh nonce, and runtime's valid proof passes.",
     [estep(RUNTIME, NONCE, named_nonce=NONCE64), estep(RUNTIME, NONCE_C)])
eseq("refused_signature_then_valid", "runtime's proof signed by other: signature_invalid, which holds nothing. A "
     "fresh nonce, and runtime's valid proof passes.",
     [estep(RUNTIME, NONCE, signed_by=OTHER), estep(RUNTIME, NONCE_C)])
eseq("refused_consumes_nonce", "runtime's proof signed by other: signature_invalid, which holds nothing but "
     "consumes the issued nonce. runtime's valid proof under that same nonce is then nonce_mismatch; under a "
     "fresh nonce it passes.",
     [estep(RUNTIME, NONCE, signed_by=OTHER), estep(RUNTIME, NONCE), estep(RUNTIME, NONCE_C)])
eseq("valid_then_again", "runtime's valid proof passes and is held; the same key presented again, under a fresh "
     "nonce, is key_already_enrolled, and the held set is unchanged.",
     [estep(RUNTIME, NONCE), estep(RUNTIME, NONCE_C)])
eseq("valid_then_negation", "runtime's valid proof passes; runtime's negation, its own proof signed under it, is "
     "one recognised key with runtime: key_already_enrolled.",
     [estep(RUNTIME, NONCE), estep(NEGATED, NONCE_C)])
eseq("valid_then_other_key", "runtime's valid proof passes; then rotated's, another key, passes too, and both "
     "are held.", [estep(RUNTIME, NONCE), estep(ROTATED, NONCE_C)])
eseq("nonce_reused_after_pass", "runtime's valid proof passes and consumes its nonce; rotated's proof under the "
     "same nonce is nonce_mismatch.", [estep(RUNTIME, NONCE), estep(ROTATED, NONCE)])


# --- gateway-config/v2 alert_delivery ----------------------------------------------------------------
CONFIG_CASES: list[dict] = []
STATE = "/var/lib/ori-gateway/state"
EVQ, EVR = "/var/lib/ori-gateway/evidence-outbound", "/var/lib/ori-gateway/evidence-return"
ADQ = "/var/lib/ori-gateway/alert-delivery"


def trim(s: str) -> str:
    i, j = 0, len(s)
    while i < j and s[i] in WHITE_SPACE:
        i += 1
    while j > i and s[j - 1] in WHITE_SPACE:
        j -= 1
    return s[i:j]


def clean(path: str) -> list:
    out: list = []
    for c in path.split("/"):
        if c in ("", "."):
            continue
        if c == "..":
            if out:
                out.pop()
            continue
        out.append(c)
    return out


def related(a: str, b: str) -> bool:
    ca, cb = clean(a), clean(b)
    n = min(len(ca), len(cb))
    return ca[:n] == cb[:n]


def is_int(v: object) -> bool:
    return type(v) is int


def config_verdict(ad: dict, state_dir: object, evidence: dict) -> str | None:
    # Rule 1, type_mismatch, by the type the document gives each value: never coerced.
    if "enabled" in ad and type(ad["enabled"]) is not bool:
        return "type_mismatch"
    if not ad.get("enabled"):
        return None
    if ("queue_directory" in ad and not is_str(ad["queue_directory"])) or (
            "max_records_per_device" in ad and not is_int(ad["max_records_per_device"])):
        return "type_mismatch"
    for path in (state_dir, evidence["queue_directory"], evidence["return_queue_directory"]):
        if not (path is None or is_str(path)):
            raise ValueError("a non-string path in another section is outside this corpus")
    q = ad.get("queue_directory")
    q = trim(q) if q is not None else ""
    if not q:
        return "queue_directory_required"
    if not q.startswith("/"):
        return "queue_directory_absolute"
    others = []
    if state_dir is not None and trim(state_dir):
        others.append(trim(state_dir))
    if evidence["enabled"]:
        others += [trim(evidence["queue_directory"]), trim(evidence["return_queue_directory"])]
    if any(related(q, o) for o in others):
        return "queue_directory_separate"
    if not 1 <= ad.get("max_records_per_device", 4096) <= 65536:
        return "max_records_per_device_range"
    return None


def ccase(name: str, note: str, ad: dict, expected: str | None = None, *, state_dir: object = STATE,
          evidence_enabled: bool = True, evq: str = EVQ, evr: str = EVR) -> None:
    evidence = {"enabled": evidence_enabled, "queue_directory": evq, "return_queue_directory": evr}
    v = config_verdict(ad, state_dir, evidence)
    if v != expected:
        raise AssertionError(f"config {name}: computed {v}, declared {expected}")
    case = {"name": name, "note": note, "alert_delivery": ad, "state_directory": state_dir, "evidence": evidence,
            "valid": v is None}
    if v is None and ad.get("enabled"):
        case["effective_queue_directory"] = trim(ad["queue_directory"])
        case["effective_max_records_per_device"] = ad.get("max_records_per_device", 4096)
    if v is not None:
        case["rule"] = v
    CONFIG_CASES.append(case)


