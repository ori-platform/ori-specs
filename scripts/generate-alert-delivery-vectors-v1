# --- carriage sequences ------------------------------------------------------------------------------
CARRIAGE_SEQUENCES: list[dict] = []


def carriage(name: str, note: str, events: list, *, devices: tuple = (DEVICE,), max_per_device: int = 4096) -> None:
    queues: dict[str, list] = {d: [] for d in devices}
    out = []
    for topic, rec in events:
        data = rec if isinstance(rec, str) else text(rec)
        reason = gateway_stateless(data, topic, list(devices))
        ack = None
        if reason is None:
            if digest(data) in queues[topic]:
                verdict = "replayed"
            elif len(queues[topic]) >= max_per_device:
                verdict = "queue_full"
            else:
                queues[topic].append(digest(data))
                verdict = "queued"
        else:
            verdict = reason
        if verdict != "unknown_device":
            queued = verdict in ("queued", "replayed")
            ack = {"device_id": topic, "outcome": "queued" if queued else "refused",
                   "reason": "" if queued else verdict, "record_digest": digest(data)}
        out.append({"topic_device": topic, "message": data, "expected": verdict, "expected_ack": ack})
    CARRIAGE_SEQUENCES.append({"name": name, "note": note, "configured_devices": list(devices),
                               "max_records_per_device": max_per_device, "events": out})


FORGED = obs(AL1, AT1, 1, 1, None, "failed", signer=OTHER, key_identity=identity(RUNTIME.pub))
GENUINE = obs(AL1, AT1, 1, 1, None, "accepted")
