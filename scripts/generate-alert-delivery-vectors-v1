# --- enrolment ---------------------------------------------------------------------------------------
ENROL_CASES: list[dict] = []
ENROL_MEMBERS = {"device_id", "key_identity", "nonce", "purpose", "v"}


def enrol_verdict(challenge: str, signature: str, device: str, pub: bytes, nonce: str, consumed: bool) -> str | None:
    o = parse(challenge)
    if (canonical(o) != challenge.encode("utf-8") or not isinstance(o, dict) or set(o) != ENROL_MEMBERS
            or integer(o["v"]) != 1 or o["purpose"] != PURPOSE or not string(o["nonce"], NONCE_RE)
            or not string(o["device_id"], DEVICE_RE) or not string(o["key_identity"], KEY_ID_RE)):
        return "challenge_malformed"
    if o["nonce"] != nonce or consumed:
        return "nonce_mismatch"
    if o["device_id"] != device:
        return "device_mismatch"
    if o["key_identity"] != identity(pub):
        return "key_mismatch"
    if not b64_ok(signature, 64) or not verify(pub, signature, ENROL_DOMAIN + challenge.encode("utf-8")):
        return "signature_invalid"
    return None


NONCE = hashlib.sha256(b"ori alert-delivery/v1 test nonce").hexdigest()[:32]
NONCE64 = hashlib.sha256(b"ori alert-delivery/v1 test nonce 64").hexdigest()


def challenge(signer: object = RUNTIME, **over: object) -> dict:
    obj = {"device_id": DEVICE, "key_identity": identity(signer.pub), "nonce": NONCE, "purpose": PURPOSE, "v": 1}
    obj.update(over)
    return {k: v for k, v in obj.items() if v is not DROP}


DROP = object()


def ecase(name: str, note: str, chal: object, expected: str, *, signer: object = RUNTIME,
          enrolling: object = RUNTIME, device: str = DEVICE, nonce: str = NONCE, consumed: bool = False,
          domain: bytes = ENROL_DOMAIN, signature: str | None = None) -> None:
    data = chal if isinstance(chal, str) else text(chal)
    sig = signature if signature is not None else b64(signer.sign(domain + data.encode("utf-8")))
    pub = enrolling.pub if hasattr(enrolling, "pub") else enrolling
    v = enrol_verdict(data, sig, device, pub, nonce, consumed) or "pass"
    if v != expected:
        raise AssertionError(f"enrolment {name}: computed {v}, declared {expected}")
    ENROL_CASES.append({"name": name, "note": note, "enrolling_device_id": device,
                        "enrolling_public_key": "ed25519:" + b64(pub), "enrolling_key_identity": identity(pub),
                        "issued_nonce": nonce, "nonce_consumed": consumed, "challenge": data,
                        "challenge_b64": b64(data.encode("utf-8")),
                        "signing_input_hex": (ENROL_DOMAIN + data.encode("utf-8")).hex(), "signature": sig,
                        "expected": v})


ecase("valid", "runtime's proof for site-a-edge-01 under a 32-character nonce.", challenge(), "pass")
ecase("valid_nonce_64", "A 64-character nonce.", challenge(nonce=NONCE64), "pass", nonce=NONCE64)
ecase("valid_rotated", "rotated's proof for site-a-edge-01, as at a replacement.", challenge(ROTATED), "pass",
      signer=ROTATED, enrolling=ROTATED)
for name, note, chal in (
    ("member_missing", "No purpose member.", challenge(purpose=DROP)),
    ("member_extra", "An extra member.", {**challenge(), "site": "site-a"}),
    ("v_2", "v is 2.", challenge(v=2)),
    ("v_fraction", "v written 1.0.", challenge(v=Raw("1.0"))),
    ("purpose_other", "purpose is runtime_posture.", challenge(purpose="runtime_posture")),
    ("nonce_upper", "The issued nonce in upper case.", challenge(nonce=NONCE.upper())),
    ("nonce_short", "A nonce of 30 characters.", challenge(nonce=NONCE[:30])),
    ("nonce_long", "A nonce of 66 characters.", challenge(nonce=NONCE64 + "ab")),
    ("nonce_odd", "A nonce of 33 characters: an odd number.", challenge(nonce=NONCE + "a")),
    ("device_form", "device_id outside its pattern.", challenge(device_id="site a")),
    ("key_identity_form", "key_identity without its prefix.", challenge(key_identity=identity(RUNTIME.pub)[7:])),
):
    ecase("challenge_malformed_" + name, note, chal, "challenge_malformed")
ecase("challenge_malformed_not_canonical", "The challenge's bytes with a space after a colon: not its canonical "
      "bytes.", text(challenge()).replace('"v":1', '"v": 1'), "challenge_malformed")
ecase("nonce_mismatch_other", "A well-formed nonce the receiver did not issue for this enrolment.",
      challenge(nonce=NONCE64), "nonce_mismatch")
ecase("nonce_mismatch_consumed", "The issued nonce, already consumed by an earlier proof.", challenge(),
      "nonce_mismatch", consumed=True)
ecase("device_mismatch", "A proof naming site-a-edge-02 while site-a-edge-01 is being enrolled.",
      challenge(device_id=OTHER_DEVICE), "device_mismatch")
ecase("key_mismatch", "runtime's proof while other is being enrolled.", challenge(), "key_mismatch", enrolling=OTHER)
ecase("key_mismatch_negation", "A proof naming runtime's key_identity while runtime's negation is being enrolled.",
      challenge(), "key_mismatch", enrolling=NEGATED)
ecase("signature_invalid_other_signer", "Names runtime, being enrolled, but signed by other.", challenge(),
      "signature_invalid", signer=OTHER)
ecase("signature_invalid_record_domain", "Signed under the record prefix ori.alert_delivery.v1.", challenge(),
      "signature_invalid", domain=DOMAIN)
ecase("signature_invalid_no_domain", "Signed over the challenge bytes alone.", challenge(), "signature_invalid",
      domain=b"")
_ESIG = base64.b64decode(b64(RUNTIME.sign(ENROL_DOMAIN + canonical(challenge()))))
ecase("signature_invalid_s_not_reduced", "S plus the group order.", challenge(), "signature_invalid",
      signature=b64(_ESIG[:32] + (int.from_bytes(_ESIG[32:], "little") + ORDER).to_bytes(32, "little")))
_KEYLESS = b64(penc(BASE) + (1).to_bytes(32, "little"))
ecase("signature_invalid_inadmissible_key", "The identity point as the key being enrolled, named by its own "
      "key_identity, with the keyless signature R = B, S = 1: the key fails ed25519-key-admission/v1 "
      "(small_order).", challenge(key_identity=identity(SMALL_ORDER)), "signature_invalid",
      enrolling=SMALL_ORDER, signature=_KEYLESS)
ecase("precedence_malformed_over_nonce", "An upper-case nonce the receiver did not issue: check 1 wins, "
      "challenge_malformed.", challenge(nonce=NONCE64.upper()), "challenge_malformed")
ecase("precedence_nonce_over_device", "Another device and an unissued nonce: check 2 wins, nonce_mismatch.",
      challenge(device_id=OTHER_DEVICE, nonce=NONCE64), "nonce_mismatch")
ecase("precedence_device_over_key", "Another device and another key: check 3 wins, device_mismatch.",
      challenge(device_id=OTHER_DEVICE), "device_mismatch", enrolling=OTHER)
ecase("precedence_key_over_signature", "Another key named and a zero signature: check 4 wins, key_mismatch.",
      challenge(OTHER), "key_mismatch", signature=b64(b"\x00" * 64))


# --- gateway-config/v2 alert_delivery ----------------------------------------------------------------
CONFIG_CASES: list[dict] = []
STATE = "/var/lib/ori-gateway/state"
EVQ, EVR = "/var/lib/ori-gateway/evidence-outbound", "/var/lib/ori-gateway/evidence-return"
ADQ = "/var/lib/ori-gateway/alert-delivery"


def trim(s: str) -> str:
    i, j = 0, len(s)
    while i < j and s[i] in WHITE_SPACE:
        i += 1
    while j > i and s[j - 1] in WHITE_SPACE:
        j -= 1
    return s[i:j]


def clean(path: str) -> list:
    out: list = []
    for c in path.split("/"):
        if c in ("", "."):
            continue
        if c == "..":
            if out:
                out.pop()
            continue
        out.append(c)
    return out


def related(a: str, b: str) -> bool:
    ca, cb = clean(a), clean(b)
    n = min(len(ca), len(cb))
    return ca[:n] == cb[:n]


def config_verdict(ad: dict, state_dir: object, evidence: dict) -> str | None:
    if not ad.get("enabled"):
        return None
    q = ad.get("queue_directory")
    q = trim(q) if isinstance(q, str) else ""
    if not q:
        return "queue_directory_required"
    if not q.startswith("/"):
        return "queue_directory_absolute"
    others = []
    if isinstance(state_dir, str) and trim(state_dir):
        others.append(trim(state_dir))
    if evidence["enabled"]:
        others += [trim(evidence["queue_directory"]), trim(evidence["return_queue_directory"])]
    if any(related(q, o) for o in others):
        return "queue_directory_separate"
    m = ad.get("max_records_per_device", 4096)
    if isinstance(m, bool) or not isinstance(m, int) or not 1 <= m <= 65536:
        return "max_records_per_device_range"
    return None


def ccase(name: str, note: str, ad: dict, expected: str | None = None, *, state_dir: object = STATE,
          evidence_enabled: bool = True, evq: str = EVQ, evr: str = EVR) -> None:
    evidence = {"enabled": evidence_enabled, "queue_directory": evq, "return_queue_directory": evr}
    v = config_verdict(ad, state_dir, evidence)
    if v != expected:
        raise AssertionError(f"config {name}: computed {v}, declared {expected}")
    case = {"name": name, "note": note, "alert_delivery": ad, "state_directory": state_dir, "evidence": evidence,
            "valid": v is None}
    if v is None and ad.get("enabled"):
        case["effective_queue_directory"] = trim(ad["queue_directory"])
        case["effective_max_records_per_device"] = ad.get("max_records_per_device", 4096)
    if v is not None:
        case["rule"] = v
    CONFIG_CASES.append(case)


