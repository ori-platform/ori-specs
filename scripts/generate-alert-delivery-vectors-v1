# --- enrolment ---------------------------------------------------------------------------------------
ENROL_CASES: list[dict] = []
ENROL_MEMBERS = {"device_id", "key_identity", "lineage_origin", "nonce", "purpose", "v"}


def enrol_verdict(challenge: str, signature: str, device: str, pub: bytes, nonce: str, consumed: bool,
                  owner: str, held: list) -> tuple[str | None, object]:
    """The verdict, and after a pass the key_identity of the held key whose lineage the key joins, or None."""
    o = parse(challenge)
    if (canonical(o) != challenge.encode("utf-8") or not isinstance(o, dict) or set(o) != ENROL_MEMBERS
            or integer(o["v"]) != 1 or not word(o["purpose"], (PURPOSE,)) or not string(o["nonce"], NONCE_RE)
            or not string(o["device_id"], DEVICE_RE) or not string(o["key_identity"], KEY_ID_RE)
            or not string(o["lineage_origin"], KEY_ID_RE)):
        return "challenge_malformed", None
    if o["nonce"] != nonce or consumed:
        return "nonce_mismatch", None
    if o["device_id"] != device:
        return "device_mismatch", None
    if o["key_identity"] != identity(pub):
        return "key_mismatch", None
    if not b64_ok(signature, 64) or not verify(pub, signature, ENROL_DOMAIN + challenge.encode("utf-8")):
        return "signature_invalid", None
    report = [h for h in held if h["purpose"] == PURPOSE]  # a key enrolled for another purpose is not held
    named = [h for h in report if o["lineage_origin"] in (h["key_identity"], h.get("lineage_origin"))]
    if any(h["device_id"] != device or h["owner"] != owner for h in named):
        return "lineage_mismatch", None
    if any(h["key_identity"] == identity(pub) and (h["device_id"] != device or h["owner"] != owner)
           for h in report):
        return "key_already_enrolled", None
    return None, (named[0]["key_identity"] if named else None)


NONCE = hashlib.sha256(b"ori alert-delivery/v1 test nonce").hexdigest()[:32]
NONCE64 = hashlib.sha256(b"ori alert-delivery/v1 test nonce 64").hexdigest()


def challenge(signer: object = RUNTIME, origin: object = None, **over: object) -> dict:
    """origin: the key that began the signer's lineage; the signer itself when None."""
    obj = {"device_id": DEVICE, "key_identity": identity(signer.pub),
           "lineage_origin": identity((origin or signer).pub), "nonce": NONCE, "purpose": PURPOSE, "v": 1}
    obj.update(over)
    return {k: v for k, v in obj.items() if v is not DROP}


DROP = object()


def held(key: object, device: str = DEVICE, owner: str = "site-a", revoked: bool = False,
         origin: object = None, purpose: str = PURPOSE) -> dict:
    """A key the receiver holds enrolled, with the lineage_origin its proof signed (itself when None); a revoked
    key is still held, for lineage origins as for check 2. One enrolled for another purpose has no origin and is
    not held."""
    h = {"device_id": device, "key_identity": identity(key.pub), "purpose": purpose,
         "lineage_origin": identity((origin or key).pub), "owner": owner, "revoked": revoked}
    if purpose != PURPOSE:
        del h["lineage_origin"]
    return h


def ecase(name: str, note: str, chal: object, expected: str, *, signer: object = RUNTIME,
          enrolling: object = RUNTIME, device: str = DEVICE, nonce: str = NONCE, consumed: bool = False,
          domain: bytes = ENROL_DOMAIN, signature: str | None = None, owner: str = "site-a",
          held_enrolments: tuple = ()) -> None:
    data = chal if isinstance(chal, str) else text(chal)
    sig = signature if signature is not None else b64(signer.sign(domain + data.encode("utf-8")))
    pub = enrolling.pub if hasattr(enrolling, "pub") else enrolling
    v, joins = enrol_verdict(data, sig, device, pub, nonce, consumed, owner, list(held_enrolments))
    v = v or "pass"
    if v != expected:
        raise AssertionError(f"enrolment {name}: computed {v}, declared {expected}")
    case = {"name": name, "note": note, "enrolling_device_id": device, "enrolling_owner": owner,
            "enrolling_public_key": "ed25519:" + b64(pub), "enrolling_key_identity": identity(pub),
            "held_enrolments": list(held_enrolments), "issued_nonce": nonce, "nonce_consumed": consumed,
            "challenge": data, "challenge_b64": b64(data.encode("utf-8")),
            "signing_input_hex": (ENROL_DOMAIN + data.encode("utf-8")).hex(), "signature": sig, "expected": v}
    if v == "pass":
        case["expected_lineage_joins"] = joins
    ENROL_CASES.append(case)


