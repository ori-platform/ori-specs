         "retryably; a held record's retransmission is still replayed at a full queue; the third again "
         "queue_full; another device's record is queued in its own share.",
         [(DEVICE, obs(AL1, AT1, 1, 1, None, "accepted")), (DEVICE, obs(AL1, AT2, 2, 1, None, "accepted")),
          (DEVICE, obs(AL1, AT3, 3, 1, None, "accepted")), (DEVICE, obs(AL1, AT1, 1, 1, None, "accepted")),
          (DEVICE, obs(AL1, AT3, 3, 1, None, "accepted")),
          (OTHER_DEVICE, obs(AL1, AT1, 1, 1, None, "accepted", signer=OTHER, device_id=OTHER_DEVICE))],
