"""Generate the gateway-api/v2 payload member corpus: exact payload bytes and the reason each is refused for.

Every case is declared here with its expected outcome, and a small model of
gateway-api/v2 `## Payload Member Rule` recomputes each one; the corpus is
written only when the two agree. Nothing here is shared with a checker, which
recomputes every outcome from the contract's text.

    python3 scripts/generate-gateway-payload-members-vectors-v2          # write
    python3 scripts/generate-gateway-payload-members-vectors-v2 --check  # reproduce
"""

from __future__ import annotations

import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "gateway-api" / "vectors" / "payload-members-v2.json"

REASONS = (
    "invalid_unicode",
    "malformed_json",
    "nesting_too_deep",
    "trailing_data",
    "duplicate_member",
    "case_variant_member",
)
ACCEPT = "accept"
MAX_DEPTH = 32
TEXT_LIMIT = 400


# --- the model -------------------------------------------------------------


class Stop(Exception):
    """The grammar broke: nothing after this point is read."""


NUMBER = re.compile(r"-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?")
LOW_ESCAPE = re.compile(r"\\u[dD][c-fC-F][0-9a-fA-F]{2}")
SIMPLE_ESCAPES = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
WS = " \t\n\r"


def fold(name: str) -> str:
    out = []
    for ch in name:
        if "A" <= ch <= "Z":
            out.append(chr(ord(ch) + 32))
        elif ch == "\u017f":
            out.append("s")
        elif ch == "\u212a":
            out.append("k")
        else:
            out.append(ch)
    return "".join(out)


def pointer_token(name: str) -> str:
    return name.replace("~", "~0").replace("/", "~1")


class Model:
    def __init__(self, text: str) -> None:
        self.t = text
        self.i = 0
        self.lone = False
        self.deepest = 0
        self.objects: list[tuple[str, list[str]]] = []

    def ws(self) -> None:
        while self.i < len(self.t) and self.t[self.i] in WS:
            self.i += 1

    def string(self) -> str:
        t = self.t
        self.i += 1  # the opening quote
        out: list[str] = []
        while True:
            if self.i >= len(t):
                raise Stop
            ch = t[self.i]
            if ch == '"':
                self.i += 1
                return "".join(out)
            if ord(ch) < 0x20:
                raise Stop
            if ch != "\\":
                out.append(ch)
                self.i += 1
                continue
            if self.i + 1 >= len(t):
                raise Stop
            e = t[self.i + 1]
            if e in SIMPLE_ESCAPES:
                out.append(SIMPLE_ESCAPES[e])
                self.i += 2
                continue
            if e != "u":
                raise Stop
            digits = t[self.i + 2:self.i + 6]
            if not re.fullmatch(r"[0-9a-fA-F]{4}", digits):
                raise Stop
            unit = int(digits, 16)
            self.i += 6
            if 0xD800 <= unit <= 0xDBFF and LOW_ESCAPE.match(t, self.i):
                low = int(t[self.i + 2:self.i + 6], 16)
                out.append(chr(0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)))
                self.i += 6
            elif 0xD800 <= unit <= 0xDFFF:
                self.lone = True
                out.append(chr(unit))
            else:
                out.append(chr(unit))

    def value(self, ptr: str, depth: int) -> None:
        self.ws()
        if self.i >= len(self.t):
            raise Stop
        ch = self.t[self.i]
        if ch == "{":
            self.container(ptr, depth + 1, obj=True)
        elif ch == "[":
            self.container(ptr, depth + 1, obj=False)
        elif ch == '"':
            self.string()
        else:
            for word in ("true", "false", "null"):
                if self.t.startswith(word, self.i):
                    self.i += len(word)
                    return
            m = NUMBER.match(self.t, self.i)
            if not m:
                raise Stop
            self.i = m.end()

    def container(self, ptr: str, depth: int, obj: bool) -> None:
        self.deepest = max(self.deepest, depth)
        close = "}" if obj else "]"
        self.i += 1
        names: list[str] = []
        if obj:
            self.objects.append((ptr, names))
        self.ws()
        if self.i < len(self.t) and self.t[self.i] == close:
            self.i += 1
            return
        index = 0
        while True:
            if obj:
                self.ws()
                if self.i >= len(self.t) or self.t[self.i] != '"':
                    raise Stop
                name = self.string()
                names.append(name)
                self.ws()
                if self.i >= len(self.t) or self.t[self.i] != ":":
                    raise Stop
                self.i += 1
                self.value(f"{ptr}/{pointer_token(name)}", depth)
            else:
                self.value(f"{ptr}/{index}", depth)
                index += 1
            self.ws()
            if self.i >= len(self.t):
                raise Stop
            if self.t[self.i] == ",":
                self.i += 1
                continue
            if self.t[self.i] == close:
                self.i += 1
                return
            raise Stop


def assess(payload: bytes, defined: dict[str, list[str]]) -> str:
    try:
        text = payload.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        return "invalid_unicode"
    m = Model(text)
    malformed = trailing = False
    try:
        m.ws()
        if m.i >= len(text):
            raise Stop
        m.value("", 0)
        m.ws()
        trailing = m.i < len(text)
    except Stop:
        malformed = True
    if m.lone:
        return "invalid_unicode"
    if malformed:
        return "malformed_json"
    if m.deepest > MAX_DEPTH:
        return "nesting_too_deep"
    if trailing:
        return "trailing_data"
    seen = {ptr for ptr, _ in m.objects}
    for ptr in defined:
        if ptr not in seen:
            raise SystemExit(f"defined members name {ptr!r}, which is not an object of the payload")
    if any(len(set(names)) != len(names) for _, names in m.objects):
        return "duplicate_member"
    for ptr, names in m.objects:
        folded: dict[str, set[str]] = {}
        for n in names + defined.get(ptr, []):
            folded.setdefault(fold(n), set()).add(n)
        if any(len(group) > 1 for group in folded.values()):
            return "case_variant_member"
    return ACCEPT


# --- the cases -------------------------------------------------------------

HEARTBEAT = ["device_id", "status", "last_seen_ms", "gateway_seen_ms", "active_triggers", "degradation_reasons",
             "evidence", "auth"]
AUTH = ["scheme", "signed_at_ms", "signature"]
REQUEST = ["request_id", "device_id", "sensor_type", "trigger_name", "prompt", "context", "action_tier_hint",
           "timeout_ms"]
CONTEXT = ["value", "unit", "timestamp", "producer_time", "history"]
HISTORY = ["value", "timestamp", "received_at_ms", "producer_time"]
RESPONSE = ["request_id", "export_type", "device_id", "items", "next_page_token", "complete", "error"]
ACTION_ROW = ["record_kind", "record_key", "contributed_to", "action_taken", "executed"]
INBOUND = ["device_id", "artifact_type", "artifact", "auth"]
CUSTODY_ACK = ["v", "device_id", "local_seq", "envelope_digest", "custody_at_ms", "key_id", "mac"]

CASES: list[dict] = []


def case(name: str, description: str, payload: bytes | str, expected: str,
         defined: dict[str, list[str]] | None = None) -> None:
    raw = payload.encode("utf-8") if isinstance(payload, str) else payload
    CASES.append({"name": name, "description": description, "raw": raw,
                  "defined": defined or {}, "expected": expected})


def nest(depth: int, inner: str = "", kinds: str = "[") -> str:
    """depth containers around inner; kinds cycles through '[' and '{'."""
    opens, closes = [], []
    for d in range(depth):
        k = kinds[d % len(kinds)]
        if k == "[":
            opens.append("[")
            closes.append("]")
        else:
            opens.append('{"a":')
            closes.append("}")
    return "".join(opens) + inner + "".join(reversed(closes))


