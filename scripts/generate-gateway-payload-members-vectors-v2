case("high_then_pair", "A high escape followed by a complete pair.", '{"a":"\\ud800\\ud83d\\ude00"}',
     "invalid_unicode")
case("high_then_text", "A high escape followed by a letter.", '{"a":"\\ud800x"}', "invalid_unicode")
case("high_then_ascii_escape", "A high escape followed by a non-surrogate escape.", '{"a":"\\ud800\\u0041"}',
     "invalid_unicode")
case("high_then_escaped_backslash", "\\\\udc00 is a backslash and text, not a low escape.",
     '{"a":"\\ud800\\\\udc00"}', "invalid_unicode")
case("lone_in_name", "A lone escape in a name.", '{"\\ud800":1}', "invalid_unicode")

# Precedence: the earliest row names the reason.
case("precedence_surrogate_in_duplicate", "A lone surrogate inside a duplicated member.",
     '{"status":"critical","status":"\\ud800"}', "invalid_unicode", {"": HEARTBEAT})
