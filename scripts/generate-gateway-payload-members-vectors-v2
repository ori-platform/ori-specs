     '{"a":1,"A":2', "malformed_json")
case("precedence_depth_over_case_variant", "A case variant early, the depth late.",
     '{"a":1,"A":2,"b":' + nest(32) + "}", "nesting_too_deep")
case("precedence_trailing_over_case_variant", "A case variant in the value, then trailing data.",
     '{"a":1,"A":2}x', "trailing_data")
case("depth_after_first_value", "Depth past the bound after the first value is trailing data.",
     "{}" + nest(33), "trailing_data")
case("cut_short_first_escape", "An escape cut short names no code unit.",
     '{"a":"\\ud8', "malformed_json")
case("precedence_malformed_hides_later_surrogate", "Nothing after the break is read.",
     '{"a":1,,"b":"\\ud800"}', "malformed_json")
case("precedence_malformed_over_depth", "Thirty-three arrays that never close.", "[" * 33,
     "malformed_json")
case("precedence_malformed_over_depth_late", "Thirty-three deep, then a grammar break near the end.",
     nest(33)[:-1] + ",]", "malformed_json")
case("precedence_malformed_over_duplicate", "A duplicate, then the payload stops.", '{"a":1,"a":2',
     "malformed_json")
case("precedence_depth_over_trailing", "Thirty-three deep and trailing data.", nest(33) + "x",
     "nesting_too_deep")
case("precedence_depth_over_duplicate", "A duplicate early, the depth late.",
     '{"a":1,"a":2,"b":' + nest(32) + "}", "nesting_too_deep")
case("precedence_trailing_over_duplicate", "A duplicate in the value, then trailing data.",
     '{"a":1,"a":2}x', "trailing_data")
case("precedence_duplicate_over_case_variant", "A case variant earlier in the text, a duplicate later.",
     '{"A":{"x":1,"X":2},"B":{"y":1,"y":2}}', "duplicate_member")
case("precedence_duplicate_and_variant_one_object", "Both in one object.",
     '{"status":1,"STATUS":2,"status":3}', "duplicate_member", {"": HEARTBEAT})


# --- the corpus ------------------------------------------------------------


def text_of(raw: bytes) -> str | None:
    if len(raw) > TEXT_LIMIT:
        return None
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return None


def corpus() -> dict:
    names = [c["name"] for c in CASES]
    if len(set(names)) != len(names):
        raise SystemExit("case names repeat")
    out = []
    for c in CASES:
        if c["expected"] not in REASONS + (ACCEPT,):
            raise SystemExit(f"{c['name']}: unknown outcome {c['expected']!r}")
        got = assess(c["raw"], c["defined"])
        if got != c["expected"]:
            raise SystemExit(f"{c['name']}: declared {c['expected']!r}, the model gives {got!r}")
        out.append({
            "name": c["name"],
            "description": c["description"],
            "payload_hex": c["raw"].hex(),
            "payload_text": text_of(c["raw"]),
            "defined_members": c["defined"],
            "expected": c["expected"],
        })
    return {
        "vector_set": "gateway-api/v2 payload members",
        "contract": "gateway-api/v2.md",
        "section": "## Payload Member Rule",
        "conventions": {
            "payload_hex": "the exact payload bytes, lowercase hex; the only input",
            "payload_text": "the same bytes as UTF-8 text for reading, or null when they are not valid UTF-8 "
                            "or longer than 400 bytes; never an input",
            "defined_members": "for each object of the payload, by RFC 6901 JSON Pointer to it, the members "
                               "the contract defining that object names for it, as far as the case needs them: "
                               "no name in a case's payload is a fold variant of a defined member left out; an "
                               "object not listed has none",
            "expected": "accept, or the reason a receiver refuses the payload for",
        },
        "reasons": list(REASONS),
        "cases": out,
    }


def render() -> bytes:
    return (json.dumps(corpus(), indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = render()
    if argv[1:] == ["--check"]:
        if not OUT.is_file() or OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator", file=sys.stderr)
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces from its generator")
        return 0
    if argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)} ({len(CASES)} cases)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
