"""Generate the gateway-api/v2 payload member corpus: exact payload bytes and the reason each is refused for.

Every case is declared here with its expected outcome, and a small model of
gateway-api/v2 `## Payload Member Rule` recomputes each one; the corpus is
written only when the two agree. Nothing here is shared with a checker, which
recomputes every outcome from the contract's text.

    python3 scripts/generate-gateway-payload-members-vectors-v2          # write
    python3 scripts/generate-gateway-payload-members-vectors-v2 --check  # reproduce
"""

from __future__ import annotations

import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "gateway-api" / "vectors" / "payload-members-v2.json"

REASONS = (
    "invalid_unicode",
    "malformed_json",
    "nesting_too_deep",
    "trailing_data",
    "duplicate_member",
    "case_variant_member",
    "not_an_object",
)
ACCEPT = "accept"
MAX_DEPTH = 32
TEXT_LIMIT = 400


# --- the model -------------------------------------------------------------


class Stop(Exception):
    """The grammar broke: nothing after this point is read."""


LOW_ESCAPE = re.compile(r"\\u[dD][c-fC-F][0-9a-fA-F]{2}")
SIMPLE_ESCAPES = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
WS = " \t\n\r"


def fold(name: str) -> str:
    out = []
    for ch in name:
        if "A" <= ch <= "Z":
            out.append(chr(ord(ch) + 32))
        elif ch == "\u017f":
            out.append("s")
        elif ch == "\u212a":
            out.append("k")
        else:
            out.append(ch)
    return "".join(out)


def pointer_token(name: str) -> str:
    return name.replace("~", "~0").replace("/", "~1")


class Model:
    def __init__(self, text: str) -> None:
        self.t = text
        self.i = 0
        self.lone = False
        self.deepest = 0
        self.objects: list[tuple[str, list[str]]] = []
        self.top = ""

    def ws(self) -> None:
        while self.i < len(self.t) and self.t[self.i] in WS:
            self.i += 1

    def string(self) -> str:
        t = self.t
        self.i += 1  # the opening quote
        out: list[str] = []
        while True:
            if self.i >= len(t):
                raise Stop
            ch = t[self.i]
            if ch == '"':
                self.i += 1
                return "".join(out)
            if ord(ch) < 0x20:
                raise Stop
            if ch != "\\":
                out.append(ch)
                self.i += 1
                continue
            if self.i + 1 >= len(t):
                raise Stop
            e = t[self.i + 1]
            if e in SIMPLE_ESCAPES:
                out.append(SIMPLE_ESCAPES[e])
                self.i += 2
                continue
            if e != "u":
                raise Stop
            digits = t[self.i + 2:self.i + 6]
            if not re.fullmatch(r"[0-9a-fA-F]{4}", digits):
                raise Stop
            unit = int(digits, 16)
            self.i += 6
            if 0xD800 <= unit <= 0xDBFF and LOW_ESCAPE.match(t, self.i):
                low = int(t[self.i + 2:self.i + 6], 16)
                out.append(chr(0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)))
                self.i += 6
            elif 0xD800 <= unit <= 0xDFFF:
                self.lone = True
                out.append(chr(unit))
            else:
                out.append(chr(unit))

    def member_name(self, frame: list) -> str:
        """After `{` or `,` in an object: read a name and its colon; the pointer to its value."""
        self.ws()
        if self.i >= len(self.t) or self.t[self.i] != '"':
            raise Stop
        name = self.string()
        frame[2].append(name)
        self.ws()
        if self.i >= len(self.t) or self.t[self.i] != ":":
            raise Stop
        self.i += 1
        return f"{frame[1]}/{pointer_token(name)}"

    def number(self) -> None:
        """Every character that can continue a number is taken; a part begun and not completed breaks."""
        t, i = self.t, self.i
        if t[i] == "-":
            i += 1
        if i < len(t) and t[i] == "0":
            i += 1
        elif i < len(t) and "1" <= t[i] <= "9":
            while i < len(t) and t[i].isascii() and t[i].isdigit():
                i += 1
        else:
            raise Stop
        if i < len(t) and t[i] == ".":
            i += 1
            if not (i < len(t) and t[i].isascii() and t[i].isdigit()):
                raise Stop
            while i < len(t) and t[i].isascii() and t[i].isdigit():
                i += 1
        if i < len(t) and t[i] in "eE":
            i += 1
            if i < len(t) and t[i] in "+-":
                i += 1
            if not (i < len(t) and t[i].isascii() and t[i].isdigit()):
                raise Stop
            while i < len(t) and t[i].isascii() and t[i].isdigit():
                i += 1
        self.i = i

    def first_value(self) -> None:
        """One value, without recursion: a stack frame per open container."""
        t = self.t
        stack: list[list] = []  # [is_object, pointer, names, next_index]
        ptr = ""
        while True:
            self.ws()
            if self.i >= len(t):
                raise Stop
            ch = t[self.i]
            if not stack:
                self.top = ch
            if ch in "{[":
                self.i += 1
                frame = [ch == "{", ptr, [], 0]
                stack.append(frame)
                self.deepest = max(self.deepest, len(stack))
                if frame[0]:
                    self.objects.append((ptr, frame[2]))
                self.ws()
                if self.i < len(t) and t[self.i] == ("}" if frame[0] else "]"):
                    self.i += 1
                    stack.pop()
                elif frame[0]:
                    ptr = self.member_name(frame)
                    continue
                else:
                    ptr = f"{frame[1]}/0"
                    frame[3] = 1
                    continue
            elif ch == '"':
                self.string()
            elif ch == "-" or "0" <= ch <= "9":
                self.number()
            else:
                for word in ("true", "false", "null"):
                    if t.startswith(word, self.i):
                        self.i += len(word)
                        break
                else:
                    raise Stop
            # A value is complete: close containers until one wants another value.
            while stack:
                self.ws()
                if self.i >= len(t):
                    raise Stop
                frame = stack[-1]
                c = t[self.i]
                if c == ",":
                    self.i += 1
                    if frame[0]:
                        ptr = self.member_name(frame)
                    else:
                        ptr = f"{frame[1]}/{frame[3]}"
                        frame[3] += 1
                    break
                if c == ("}" if frame[0] else "]"):
                    self.i += 1
                    stack.pop()
                    continue
                raise Stop
            else:
                return


def assess(payload: bytes, family: str | None) -> str:
    try:
        text = payload.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        return "invalid_unicode"
    m = Model(text)
    malformed = trailing = False
    try:
        m.first_value()
        m.ws()
        trailing = m.i < len(text)
    except Stop:
        malformed = True
    if m.lone:
        return "invalid_unicode"
    if malformed:
        return "malformed_json"
    if m.deepest > MAX_DEPTH:
        return "nesting_too_deep"
    if trailing:
        return "trailing_data"
    defined = FAMILIES[family] if family is not None else []
    if any(len(set(names)) != len(names) for _, names in m.objects):
        return "duplicate_member"
    for _, names in m.objects:
        folded: dict[str, set[str]] = {}
        for n in names + defined:
            folded.setdefault(fold(n), set()).add(n)
        if any(len(group) > 1 for group in folded.values()):
            return "case_variant_member"
    if m.top != "{":
        return "not_an_object"
    return ACCEPT


