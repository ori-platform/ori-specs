     nest(33, '"\\ud800"'), "invalid_unicode")
case("precedence_surrogate_over_trailing", "A lone escape in the value, then trailing data.",
     '{"a":"\\ud800"}x', "invalid_unicode")
case("precedence_surrogate_over_case_variant", "A lone escape beside a case variant.",
     '{"a":"\\ud800","A":1}', "invalid_unicode")
