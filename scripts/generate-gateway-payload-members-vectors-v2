CASES: list[dict] = []


def case(name: str, description: str, payload: bytes | str, expected: str, family: str | None = None) -> None:
    raw = payload.encode("utf-8") if isinstance(payload, str) else payload
    CASES.append({"name": name, "description": description, "raw": raw,
                  "family": family, "expected": expected})


def nest(depth: int, inner: str = "", kinds: str = "[") -> str:
    """depth containers around inner; kinds cycles through '[' and '{'."""
    opens, closes = [], []
    for d in range(depth):
        k = kinds[d % len(kinds)]
        if k == "[":
            opens.append("[")
            closes.append("]")
        else:
            opens.append('{"a":')
            closes.append("}")
    return "".join(opens) + inner + "".join(reversed(closes))


