class CheckError(Exception):
    pass


def _norm(text: str) -> str:
    return re.sub(r"\s+", " ", text.replace("**", "")).strip()


def sentences(text: str) -> list[str]:
    """Every sentence, splitting table cells, list items and prose alike."""
    out: list[str] = []
    for paragraph in re.split(r"\n\s*\n", text):
        for item in re.split(r"\n(?=\s*(?:[-*] |\d+\. |\|))", paragraph):
            for cell in re.split(r"(?<!\\)\|", item):
                prose = _norm(re.sub(r"^\s*(?:[-*] |\d+\. )", "", cell))
                out.extend(s for s in re.split(r"(?<=[.;!?])\s+(?=[A-Z`(\[])", prose) if s)
    return out


def matches(texts: dict[str, str]) -> list[tuple[str, str]]:
    return [(name, s) for name, text in texts.items() for s in sentences(text) if GATE.search(s) and ACTION.search(s)]


def _section(text: str, start: str, end: str) -> str:
    a = text.find(start)
    b = text.find(end, a + len(start)) if a >= 0 else -1
    if a < 0 or b < 0:
        raise CheckError(f"no section starting {start[:50]!r}")
    return text[a:b]


def check(texts: dict[str, str], allowed: set[str] | None = None) -> None:
    for name, start, end, clause in (*CLAUSES, *REQUIRED_ONLY):
        if _norm(clause) not in _norm(_section(texts[name], start, end)):
            raise CheckError(f"{name}: the clause {clause[:70]!r} is not in its section {start[:40]!r}")
    if allowed is None:
        allowed = {s for c in CLAUSES for s in sentences(c[3])}
    for name, sentence in matches(texts):
        if sentence not in allowed:
            raise CheckError(
                f"{name}: {sentence[:120]!r} pairs a gating verb with an action and is not a reviewed clause. "
                "Evidence never gates Tier C or Tier D; if this sentence is a negation, add it to CLAUSES with its "
                "section. This scan reads one sentence at a time and cannot see a rule split across sentences."
            )
    for name, pattern, permitted, _ in CONTRADICTIONS:
        for sentence in sentences(texts[name]):
            if re.search(pattern, sentence) and sentence not in {_norm(p) for p in permitted}:
                raise CheckError(
                    f"{name}: {sentence[:120]!r} contradicts a rule this guard holds, or states it in a form no "
                    "reviewer has allowlisted. The guard is a pattern over single sentences and sees only the "
                    "phrasings it names."
                )


def reverse(clause: str) -> str:
    edited = clause
    for old, new in (("MUST NOT ", "MAY "), ("never ", ""), ("No disposition", "Any disposition"),
                     ("no delivery state may", "a delivery state may"), ("no disposition state", "disposition state"),
                     ("is refused before", "is refused after"), ("without waiting for", "after waiting for"),
                     ("non-actuating", "actuating"), ("with its existing bounded back-off", "without back-off"),
                     ("admits no bytes", "admits the bytes"), ("is no admission and signals nothing", "is an admission"),
                     ("is permitted only for", "is permitted for"), ("does not originate", "may originate"),
                     ("does not permit", "permits"), ("stops being a predecessor", "remains a predecessor"),
                     ("opens and writes neither", "opens and writes each"),
                     ("is permitted only when its entry lists it", "is always permitted"),
                     ("is not an approval", "is an approval"),
                     ("waits on no evidence state", "waits on evidence state"),
                     ("blocks only a later Tier C proposal", "blocks every later Tier C proposal"),
                     ("It does not block another outcome", "It blocks another outcome"),
                     ("no longer blocks a later Tier C proposal", "still blocks a later Tier C proposal"),
                     ("Neither state authorizes", "Either state authorizes"),
                     ("MUST additionally refuse", "MAY admit"),
                     ("The block does not affect", "The block affects"),
                     ("is never consulted", "is consulted"), ("never marks", "marks"),
                     ("No reply can approve it and no physical action executes",
                      "A reply can approve it and the physical action executes"),
                     ("remains unaffected", "is held with it"), ("No safe-default intent may", "A safe-default intent may"),
                     ("does not enter that device's lane and cannot block", "enters that device's lane and can block"),
                     ("and is not the correctness boundary", "and is the correctness boundary")):
        edited = edited.replace(old, new, 1)
    if edited == clause:
        edited = clause.replace("remains approval-gated", "is not approval-gated", 1)
    return edited


def mutants(texts: dict[str, str]):
    for name, start, end, clause in (*CLAUSES, *REQUIRED_ONLY):
        pattern = r"\s+".join(re.escape(w) for w in clause.split())
        deleted, count = re.subn(pattern, "", texts[name], count=1)
        yield f"delete {clause[:50]!r}", {**texts, name: deleted}, None, count
        edited, count = re.subn(pattern, reverse(clause).replace("\\", "\\\\"), texts[name], count=1)
        yield f"reverse {clause[:50]!r}", {**texts, name: edited}, None, count
        # Re-pin: the scan's allowlist regenerated from the reversed text, as a
        # mechanical `--print-units` refresh would; the required clause must still fail it.
        edited_texts = {**texts, name: edited}
        yield (f"re-pin reversed {clause[:40]!r}", edited_texts,
               {s for _, s in matches(edited_texts)}, count)
    for name, _, _, sample in CONTRADICTIONS:
        yield f"append to {name}: {sample[:50]!r}", {**texts, name: texts[name] + f"\n\n{sample}\n"}, None, 1
    for name in FILES:
        yield (f"append to {name}", {**texts, name: texts[name] + "\n\nEvidence state may delay an approved Tier C action.\n"},
               None, 1)
        yield (f"append a gate to {name}", {**texts, name: texts[name] + "\n\nA disposition gates Tier D execution.\n"},
               None, 1)


def main() -> int:
    texts = {name: (ROOT / name).read_text(encoding="utf-8") for name in FILES}
    if "--print-units" in sys.argv[1:]:
        for name, sentence in matches(texts):
            print(f"{name}: {sentence}")
        return 0
    try:
        check(texts)
    except CheckError as error:
        print(f"check-evidence-patf-clauses: {error}", file=sys.stderr)
        return 1
    if "--mutations" in sys.argv[1:]:
        survived, total = [], 0
        for label, edited, allowed, count in mutants(texts):
            total += 1
            if count != 1:
                survived.append(f"{label}: the mutation matches nothing")
                continue
            try:
                check(edited, allowed)
            except CheckError:
                continue
            survived.append(label)
        if survived:
            for label in survived:
                print(f"mutant survived: {label}", file=sys.stderr)
            return 1
        print(f"patf mutations: {total} refused")
    print(f"patf clauses: {len(CLAUSES) + len(REQUIRED_ONLY)} clauses hold across {len(FILES)} contracts")
    return 0


if __name__ == "__main__":
    sys.exit(main())
