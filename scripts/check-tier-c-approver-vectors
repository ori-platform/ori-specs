DEVICE_ID = "edge-1"
EPOCH_1 = base64.b64encode(bytes(range(32, 48))).decode("ascii")
EPOCH_2 = base64.b64encode(bytes(range(48, 64))).decode("ascii")
PUBLIC_KEY = "CoCYmi2u1NnDLsVzNMglg2Ied+0M9Z74rgNvSGRBAdg="
