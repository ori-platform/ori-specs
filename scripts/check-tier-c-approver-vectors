def json_string(value: str) -> bytes:
    result = bytearray(b'"')
    escapes = {'"': b'\\"', "\\": b'\\\\', "\b": b"\\b", "\f": b"\\f", "\n": b"\\n", "\r": b"\\r", "\t": b"\\t"}
    for char in value:
        if char in escapes:
            result.extend(escapes[char])
        elif ord(char) < 32:
            result.extend(f"\\u{ord(char):04x}".encode("ascii"))
        else:
            try:
                result.extend(char.encode("utf-8"))
            except UnicodeEncodeError as exc:
                raise ValueError("invalid Unicode scalar") from exc
    result.extend(b'"')
    return bytes(result)


def canonical_profile2(value: Any) -> bytes:
    """Independent Profile 2 encoder for the integer-only objects in this corpus."""
    if value is None:
        return b"null"
    if value is True:
        return b"true"
    if value is False:
        return b"false"
    if type(value) is int:
        return str(value).encode("ascii")
    if isinstance(value, str):
        return json_string(value)
    if isinstance(value, list):
        return b"[" + b",".join(canonical_profile2(item) for item in value) + b"]"
    if isinstance(value, dict):
        if any(not isinstance(key, str) for key in value):
            raise ValueError("non-string object key")
        return b"{" + b",".join(
            canonical_profile2(key) + b":" + canonical_profile2(value[key])
            for key in sorted(value)
        ) + b"}"
    raise ValueError("non-JSON value")


def verify_wire(corpus: dict[str, Any]) -> None:
    wire = corpus["wire"]
    challenge = wire["challenge"]
    if set(challenge) != {
        "v", "challenge_id", "device_id", "site_id", "identity_epoch",
        "operation", "registry_revision", "candidates",
    }:
        raise AssertionError("challenge members")
    if (
        type(challenge["v"]) is not int or challenge["v"] != 1
        or type(challenge["registry_revision"]) is not int
        or challenge["registry_revision"] < 0
        or len(strict_b64(challenge["challenge_id"])) != 16
        or not isinstance(challenge["device_id"], str) or not DEVICE.fullmatch(challenge["device_id"])
        or not SITE.fullmatch(challenge["site_id"])
        or len(strict_b64(challenge["identity_epoch"])) != 16
        or challenge["operation"] not in {"recover", "enrol", "local_seed"}
        or not isinstance(challenge["candidates"], list)
    ):
        raise AssertionError("challenge fields")
    candidates = challenge["candidates"]
    required_count = {"recover": (0,), "enrol": (1,), "local_seed": (1,)}
    if len(candidates) not in required_count[challenge["operation"]]:
        raise AssertionError("challenge candidate count")
    ids = []
    values = []
    for candidate in candidates:
        if set(candidate) != {"approver_id", "credential_id", "channel", "value"}:
            raise AssertionError("candidate members")
        if not ID.fullmatch(candidate["approver_id"]) or not ID.fullmatch(candidate["credential_id"]):
            raise AssertionError("candidate ids")
        if candidate["channel"] in {"sms", "whatsapp"}:
            if not PHONE.fullmatch(candidate["value"]):
                raise AssertionError("phone value")
        elif candidate["channel"] == "lan_ed25519":
            if not candidate["value"].startswith("ed25519:") or len(strict_b64(candidate["value"][8:])) != 32:
                raise AssertionError("LAN value")
        else:
            raise AssertionError("channel")
        ids.append(candidate["credential_id"])
        values.append((candidate["channel"], candidate["value"]))
    if ids != sorted(set(ids)) or len(values) != len(set(values)):
        raise AssertionError("candidate order or duplicate")
    challenge_bytes = canonical_profile2(challenge)
    if challenge_bytes.hex() != wire["challenge_canonical_hex"]:
        raise AssertionError("challenge canonical bytes")
    digest = hashlib.sha256(challenge_bytes).hexdigest()
    if wire["authorizer_public_key_b64"] != AUTHORIZER_KEY or wire["candidate_public_key_b64"] != CANDIDATE_KEY:
        raise AssertionError("unexpected test keys")
    for name, id_field, domain, public_key in (
        ("authorizer", "authorizer_credential_id", b"ori.tier_c_approver.enrol.v1", wire["authorizer_public_key_b64"]),
        ("possession", "candidate_credential_id", b"ori.tier_c_approver.possession.v1", wire["candidate_public_key_b64"]),
    ):
        fixture = wire[name]
        document = fixture["object"]
        if set(document) != {"v", "challenge_id", "challenge_sha256", id_field, "signature"}:
            raise AssertionError(f"{name} members")
        if (
            type(document["v"]) is not int or document["v"] != 1
            or document["challenge_id"] != challenge["challenge_id"]
            or document["challenge_sha256"] != digest
            or not ID.fullmatch(document[id_field])
        ):
            raise AssertionError(f"{name} binding")
        unsigned = {key: value for key, value in document.items() if key != "signature"}
        preimage = domain + b"\0" + canonical_profile2(unsigned)
        if preimage.hex() != fixture["preimage_hex"]:
            raise AssertionError(f"{name} preimage")
        try:
            Ed25519PublicKey.from_public_bytes(strict_b64(public_key)).verify(
                strict_b64(document["signature"]), preimage
            )
        except (InvalidSignature, ValueError) as exc:
            raise AssertionError(f"{name} signature") from exc
    candidate = candidates[0]
    if candidate["value"] != "ed25519:" + wire["candidate_public_key_b64"]:
        raise AssertionError("possession key is not candidate key")
    if wire["possession"]["object"]["candidate_credential_id"] != candidate["credential_id"]:
        raise AssertionError("possession candidate id")
    # RFC 8410 Ed25519 SPKI DER is this fixed 12-byte prefix plus the raw key.
    spki = bytes.fromhex("302a300506032b6570032100") + strict_b64(CANDIDATE_KEY)
    if hashlib.sha256(spki).hexdigest() != wire["candidate_spki_sha256"]:
        raise AssertionError("candidate SPKI digest")
    expected_phone = f"ORI-ENROL-V1 {challenge['challenge_id']} {digest}".encode("ascii")
    if wire["phone_authorization_ascii_hex"] != expected_phone.hex():
        raise AssertionError("phone authorization bytes")
    phone = wire["phone_candidate"]
    phone_challenge = phone["challenge"]
    if set(phone_challenge) != set(challenge) or phone_challenge["operation"] != "enrol":
        raise AssertionError("phone challenge members")
    if len(phone_challenge["candidates"]) != 1 or phone_challenge["candidates"][0]["channel"] != "sms":
        raise AssertionError("phone candidate channel")
    if len(strict_b64(phone_challenge["challenge_id"])) != 16:
        raise AssertionError("phone challenge id")
    if canonical_profile2(phone_challenge).hex() != phone["challenge_canonical_hex"]:
        raise AssertionError("phone challenge canonical bytes")
    reply = phone["reply"]
    if reply["sender"] != phone_challenge["candidates"][0]["value"] or reply["channel"] != "sms":
        raise AssertionError("phone reply attribution")
    sent = bytes.fromhex(phone["sent_ascii_hex"])
    if sent != bytes.fromhex(reply["text_ascii_hex"]):
        raise AssertionError("phone reply bytes")
    prefix = f"ORI-POSSESS-V1 {phone_challenge['challenge_id']} ".encode("ascii")
    if not sent.startswith(prefix):
        raise AssertionError("phone possession prefix")
    code = sent[len(prefix):].decode("ascii")
    if len(strict_b64(code)) != 16 or hashlib.sha256(code.encode("ascii")).hexdigest() != phone["code_sha256"]:
        raise AssertionError("phone possession code")
    expected_phone_values = {
        "+2348012345678": True,
        "whatsapp:+2348012345678": False,
        "+1 555 0123": False,
        "+01234": False,
        "08012345678": False,
    }
    if {case["value"]: case["valid"] for case in wire["phone_value_cases"]} != expected_phone_values:
        raise AssertionError("phone cases changed")
    for case in wire["phone_value_cases"]:
        if bool(PHONE.fullmatch(case["value"])) is not case["valid"]:
            raise AssertionError("phone normalization case")


def strict_b64(value: str) -> bytes:
    decoded = base64.b64decode(value, validate=True)
    if base64.b64encode(decoded).decode() != value:
        raise ValueError("noncanonical Base64")
    return decoded


def revocation_reason(document: Any) -> str | None:
    if not isinstance(document, dict) or set(document) != REVOKE_FIELDS:
        return "malformed"
    try:
        targets = document["targets"]
        if (
            type(document["v"]) is not int or document["v"] != 1
            or type(document["revision"]) is not int or document["revision"] < 1
            or not isinstance(document["device_id"], str) or not DEVICE.fullmatch(document["device_id"])
            or not SITE.fullmatch(document["site_id"])
            or len(strict_b64(document["identity_epoch"])) != 16
            or not isinstance(targets, list) or not targets or len(targets) > 32
            or any(not isinstance(x, str) or not re.fullmatch(r"(?:credential|approver):[A-Za-z0-9._-]{1,64}", x) for x in targets)
            or targets != sorted(set(targets))
            or not isinstance(document["signing_key"], str)
            or not document["signing_key"].startswith("ed25519:")
            or len(strict_b64(document["signing_key"][8:])) != 32
            or not isinstance(document["signature"], str)
            or len(strict_b64(document["signature"])) != 64
        ):
            return "malformed"
        unsigned = {key: value for key, value in document.items() if key != "signature"}
        payload = canonical_profile2(unsigned)
    except (ValueError, TypeError):
        return "malformed"
    key = document["signing_key"][8:]
    if key not in {PUBLIC_KEY, PREVIOUS_KEY, COMMERCIAL_KEY}:
        return "unknown_signer"
    try:
        Ed25519PublicKey.from_public_bytes(strict_b64(key)).verify(
            strict_b64(document["signature"]),
            b"ori.tier_c_approver.revoke.v1\0" + payload,
        )
    except (InvalidSignature, ValueError):
        return "signature_invalid"
    if key == PREVIOUS_KEY:
        return "superseded_signer"
    if key == COMMERCIAL_KEY:
        return "wrong_authority"
    return None


def unique_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON member")
        result[key] = value
    return result


def candidate_of(operation: dict[str, Any]) -> Any:
    if operation["op"] == "recover":
        return []
    return {
        "credential": operation["credential"],
        "approver_id": operation.get("approver_id", operation["credential"]),
        "channel": operation.get("channel", "lan_ed25519"),
        "value": operation.get("value", operation["credential"]),
    }


# Model checks that --mutations switches off one at a time to prove the corpus
# (or a stated corpus variant) depends on each.
MODEL_CHECKS = {
    "issue_channel",
    "issue_locked_first",
    "reply_auth_channel",
    "reply_channel_mismatch",
    "admit_phone_channel",
    "admit_auth_flag",
    "admit_credential_channel",
    "authorizer_same_approver",
    "guard",
    "restart_ingress",
    "restart_used_markers",
    # The device binding (tier-c-approvers/v1 "A change of either binding cannot
    # silently rebind an existing registry"; operator-socket/v3 Order of refusal).
    "device_check",
    "device_first",
    "mismatch_needs_initialized",
    "restart_device",
    "restart_site",
    "recover_binds_runtime_device",
    "recover_binds_runtime_site",
    "apply_device",
    "apply_site",
    "apply_keeps_state",
    "revoke_document_first",
} | {f"commit_order:{n}" for n in (1, 2, 3, 4, 5, 6, 7, 8)}
# The second commit's ten steps, by verdict, in the text's order.
COMMIT_STEPS = (
    "epoch_changed", "pending_unavailable", "possession_expired", "possession_invalid",
    "registry_unavailable", "authorizer_unavailable", "registry_changed",
    "device_binding_mismatch", "site_binding_mismatch", "epoch_changed",
)
# Adjacent steps no scenario can tell apart: swapping them changes no verdict.
# 9/10: "Step 10 is defence in depth: only a recovery changes the epoch, and step 1
# decides that first."
COMMIT_UNDISTINGUISHED = (9,)


def credential_channel_of_reply(channel: Any) -> Any:
    """A reply without a channel is a signed LAN reply; the local console is a
    transport for a LAN key ("Proposal cutoff and admission")."""
    if channel is None or channel == "local_console":
        return "lan_ed25519"
    return channel


class Registry:
    def __init__(self, initial_mode: str, disabled: frozenset[str] = frozenset()) -> None:
        if initial_mode != "locked":
            raise ValueError("invalid initial mode")
        self.disabled = disabled
        self.authenticated_channels = set(AUTHENTICATED_PHONE_CHANNELS)
        self.channels: dict[str, str] = {}
        self.initialized = False
        self.epoch = EPOCH_1
        self.config_site = SITE_ID
        # The runtime's device identity, and the registry header's device and site
        # bindings: "A locked registry has neither binding."
        self.config_device = DEVICE_ID
        self.device_binding: str | None = None
        self.site_binding: str | None = None
        self.revision = 0
        self.external_revision = 0
        self.last_external_document: str | None = None
        self.sequence = 0
        self.active: dict[str, int] = {}
        self.values: dict[str, str] = {}
        self.tombstones: set[str] = set()
        self.approvers: dict[str, str] = {}
        self.approver_tombstones: set[str] = set()
        self.proposals: dict[str, dict[str, Any]] = {}
        self.challenges: dict[str, dict[str, Any]] = {}
        self.used_challenges: set[str] = set()
        self.pending_phone: dict[str, dict[str, Any]] = {}
        self.invalidated_phone: dict[str, str] = {}
        self.commit_pending: dict[str, Any] | None = None   # the operation a commit judges

    def active_approvers(self) -> set[str]:
        return {self.approvers[credential] for credential in self.active}

    def binding_refusal(self) -> str | None:
        """"every registry operation on an initialized registry whose device binding
        differs from the runtime's device identity is refused
        `device_binding_mismatch`, and one whose site binding differs from the
        verified `device.site_id` is refused `site_binding_mismatch` ... When both
        differ, `device_binding_mismatch` is the answer. A locked registry has
        neither binding." (operator-socket/v3, Order of refusal)"""
        if not self.initialized and "mismatch_needs_initialized" not in self.disabled:
            return None
        checks = [
            ("device_binding_mismatch",
             self.device_binding != self.config_device and "device_check" not in self.disabled),
            ("site_binding_mismatch", self.site_binding != self.config_site),
        ]
        if "device_first" in self.disabled:
            checks.reverse()
        return next((code for code, failed in checks if failed), None)

    def require_defence_in_depth(self, pending: dict[str, Any]) -> None:
        """"Once the revision recheck holds, the authoriser's activity and the
        candidate's credential ID, approver ID and value rechecks cannot fail
        on their own, since any change to them changes the revision; they are
        defence in depth."

        With the revision unchanged since phone authorization, any of those
        rechecks failing means the model changed state without a revision:
        a checker defect, not a corpus verdict.
        """
        candidate = pending["candidate"]
        failing = [
            name for name, failed in (
                ("authorizer inactive", pending["authorizer"] not in self.active),
                ("approver tombstoned", candidate["approver_id"] in self.approver_tombstones),
                ("minted approver active", pending["approver_minted"] and candidate["approver_id"] in self.active_approvers()),
                ("credential reused", candidate["credential"] in self.approvers or candidate["credential"] in self.tombstones),
                ("value tombstoned", candidate["value"] in (self.values[x] for x in self.tombstones if x in self.values)),
                ("value active", candidate["value"] in (self.values[x] for x in self.active)),
            ) if failed
        ]
        if failing:
            raise AssertionError(f"defence-in-depth recheck failed with revision unchanged: {failing}")

    def phone_possession_refusal(self, operation: dict[str, Any], pending: dict[str, Any]) -> str | None:
        """Step 4: "the reply carries no possession text: `possession_required`; or
        it is not on an authenticated ingress, or its code's digest, sender or
        channel differs from the pending operation's: `possession_invalid`". A
        reply naming another value or channel than the pending operation's is the
        "sender or channel differs" clause."""
        challenge_id = operation["challenge_id"]
        candidate = pending["candidate"]
        reply = operation.get("phone_reply")
        if reply is None:
            return "possession_required"
        if operation.get("value") != candidate["value"] or operation.get("channel") != candidate["channel"]:
            return "possession_invalid"
        if not isinstance(reply, dict) or set(reply) != {"sender", "channel", "text", "authenticated"}:
            return "possession_invalid"
        prefix = f"ORI-POSSESS-V1 {challenge_id} "
        text = reply["text"]
        if not isinstance(text, str) or not text.startswith(prefix):
            return "possession_invalid"
        code = text[len(prefix):]
        try:
            if len(strict_b64(code)) != 16:
                return "possession_invalid"
        except (ValueError, TypeError):
            return "possession_invalid"
        if (reply["authenticated"] is not True or
            (reply["channel"] not in self.authenticated_channels
             and "reply_auth_channel" not in self.disabled) or
            reply["sender"] != candidate["value"] or
            (reply["channel"] != candidate["channel"]
             and "reply_channel_mismatch" not in self.disabled) or
            not hmac.compare_digest(hashlib.sha256(code.encode("ascii")).hexdigest(), pending["phone_code_sha256"])):
            return "possession_invalid"
        return None

    def phone_commit_refusal(self, operation: dict[str, Any]) -> str | None:
        """"At that second commit the runtime decides the reply in this order, and
        the first check that fails is the answer" (tier-c-approvers/v1, the ten
        numbered steps). "Step 10 is defence in depth: only a recovery changes the
        epoch, and step 1 decides that first. Steps 8 and 9 compare the bindings as
        they stand at the commit; a restart ends every pending operation, which step
        2 then answers. A registry locked without a recovery is step 5, not step 1. From step 3 on, every answer, a commit or any refusal,
        consumes the pending operation; step 1 consumes the record of the
        operation the recovery invalidated." `commit_order:<n>` swaps steps n and
        n + 1."""
        challenge_id = operation["challenge_id"]
        elapsed = operation.get("phone_elapsed_ms", 0)
        if type(elapsed) is not int or elapsed < 0:
            return "malformed"      # a fixture's form, before any step
        invalidated = self.invalidated_phone.pop(challenge_id, None)
        pending = self.pending_phone.pop(challenge_id, None)
        self.commit_pending = pending
        # A model invariant, not a step: with the revision unchanged since phone
        # authorization nothing the defence-in-depth rechecks read can have changed
        # (an initialized registry; a lost one is step 5).
        if pending is not None and self.initialized and self.revision == pending["revision"]:
            self.require_defence_in_depth(pending)

        def with_pending(check: Any) -> Any:
            return lambda: check(pending) if pending is not None else None

        def authorizer(p: dict[str, Any]) -> str | None:
            return "authorizer_unavailable" if p["authorizer"] not in self.active else None

        def device(p: dict[str, Any]) -> str | None:
            # "8. the registry's device binding differs from the runtime's device
            # identity"
            return "device_binding_mismatch" if self.device_binding != self.config_device else None

        def site(p: dict[str, Any]) -> str | None:
            # "9. the registry's site binding differs from the verified `device.site_id`"
            return "site_binding_mismatch" if self.site_binding != self.config_site else None
        steps = [
            lambda: invalidated,                                              # 1
            lambda: "pending_unavailable" if pending is None else None,       # 2
            lambda: "possession_expired" if elapsed > 600000 else None,      # 3
            with_pending(lambda p: self.phone_possession_refusal(operation, p)),  # 4
            lambda: "registry_unavailable" if not self.initialized else None,  # 5
            with_pending(authorizer),                                         # 6
            with_pending(lambda p: "registry_changed" if self.revision != p["revision"] else None),  # 7
            with_pending(device),                                             # 8
            with_pending(site),                                               # 9
            with_pending(lambda p: "epoch_changed" if self.epoch != p["epoch"] else None),  # 10
        ]
        for n in range(1, len(steps)):
            if f"commit_order:{n}" in self.disabled:
                steps[n - 1], steps[n] = steps[n], steps[n - 1]
        for step in steps:
            verdict = step()
            if verdict is not None:
                return verdict
        return None

    def apply(self, operation: dict[str, Any]) -> str:
        kind = operation["op"]
        # Revoke judges its document, signer and signature and a locked registry
        # first (operator-socket/v3 Revoke); `revoke_document_first` off puts the
        # bindings ahead of them.
        early = {"issue", "recover", "enrol", "local_seed", "phone_authorize", "open", "admit"}
        if "revoke_document_first" in self.disabled:
            early.add("revoke")
        refusal = self.binding_refusal()
        if refusal is not None and kind in early:
            return refusal
        if kind == "revoke" and "revoke_document_first" in self.disabled and not self.initialized:
            return "registry_unavailable"
        if kind == "issue":
            challenge_id = operation["challenge_id"]
            if challenge_id in self.challenges or challenge_id in self.used_challenges:
                return "challenge_reused"
            if operation["kind"] == "recover":
                proposed = operation.get("proposed_epoch")
                try:
                    if len(strict_b64(proposed)) != 16 or proposed == self.epoch:
                        return "malformed"
                except (TypeError, ValueError):
                    return "malformed"
            candidate = operation["candidate"]
            if (
                isinstance(candidate, dict)
                and candidate.get("channel") in PHONE_CHANNELS
                and candidate.get("channel") not in self.authenticated_channels
            ):
                # "A locked registry and a device or site binding mismatch refuse
                # such a candidate first, under their own codes": the bindings are
                # checked above for every operation.
                if not self.initialized and "issue_locked_first" not in self.disabled:
                    return "registry_unavailable"
                # Refused at issue for every operation kind: no challenge or
                # used marker is recorded, no code exists, nothing pends.
                if "issue_channel" not in self.disabled:
                    return "channel_unauthenticated"
            if operation["kind"] == "enrol" and isinstance(candidate, dict) and candidate.get("channel") in PHONE_CHANNELS:
                digest = operation.get("phone_code_sha256")
                if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
                    return "malformed"
            self.challenges[challenge_id] = {
                "kind": operation["kind"],
                "candidate": operation["candidate"],
                "revision": self.revision,
                "epoch": self.epoch,
                "proposed_epoch": operation.get("proposed_epoch"),
                "sequence": self.sequence,
                "expired": False,
                "phone_code_sha256": operation.get("phone_code_sha256"),
                # The runtime mints a new approver ID unless the enrolment
                # names an existing approver (one with an active credential).
                "approver_minted": not (
                    isinstance(candidate, dict)
                    and candidate.get("approver_id") in self.active_approvers()
                ),
            }
            return "issued"
        if kind == "expire":
            challenge = self.challenges.get(operation["challenge_id"])
            if challenge is None:
                return "challenge_unavailable"
            challenge["expired"] = True
            return "expired"
        if kind == "apply_provisioning":
            # "A document that changes `device.id` or `device.site_id` changes the
            # identity when it is accepted, whether at start or while the runtime
            # runs": unlike a restart it closes no proposal and invalidates no
            # challenge or pending operation. A fixture must name a well-formed change.
            device, site = operation.get("device_id"), operation.get("site_id")
            if device is None and site is None:
                raise AssertionError("apply_provisioning names neither device_id nor site_id")
            if device is not None and (not isinstance(device, str) or not DEVICE.fullmatch(device)):
                raise AssertionError(f"apply_provisioning under a malformed device_id: {device!r}")
            if site is not None and (not isinstance(site, str) or not SITE.fullmatch(site)):
                raise AssertionError(f"apply_provisioning under a malformed site_id: {site!r}")
            if device is not None and "apply_device" not in self.disabled:
                self.config_device = device
            if site is not None and "apply_site" not in self.disabled:
                self.config_site = site
            if "apply_keeps_state" in self.disabled:
                self.proposals.clear()
                self.pending_phone.clear()
                self.challenges.clear()
            return "applied"
        if kind == "restart":
            # "Every challenge, used or not, is invalidated at process restart"
            # and every pending phone operation dies; a used challenge is then
            # challenge_unavailable, not challenge_reused. The ingress set is
            # reread from configuration here and only here.
            # A restart step's device_id and site_id set the configuration it
            # starts under; "The runtime reads `device.id` and `device.site_id` only
            # at start". Each must be well formed (a fixture's form).
            flag = operation.get("sms_ingress")
            if flag is not None and type(flag) is not bool:
                return "malformed"
            device, site = operation.get("device_id"), operation.get("site_id")
            if device is not None and (not isinstance(device, str) or not DEVICE.fullmatch(device)):
                raise AssertionError(f"restart under a malformed device_id: {device!r}")
            if site is not None and (not isinstance(site, str) or not SITE.fullmatch(site)):
                raise AssertionError(f"restart under a malformed site_id: {site!r}")
            if device is not None and "restart_device" not in self.disabled:
                self.config_device = device
            if site is not None and "restart_site" not in self.disabled:
                self.config_site = site
            self.challenges.clear()
            if "restart_used_markers" not in self.disabled:
                self.used_challenges.clear()
            self.pending_phone.clear()
            self.invalidated_phone.clear()
            self.proposals.clear()
            if flag is not None and "restart_ingress" not in self.disabled:
                if flag:
                    self.authenticated_channels.add("sms")
                else:
                    self.authenticated_channels.discard("sms")
            return "restarted"
        if kind == "expire_phone":
            elapsed = operation.get("phone_elapsed_ms")
            if type(elapsed) is not int or elapsed <= 600000:
                return "not_expired"
            if self.pending_phone.pop(operation["challenge_id"], None) is None:
                return "pending_unavailable"
            return "expired"
        if kind in {"recover", "enrol", "local_seed", "phone_authorize"}:
            challenge_id = operation.get("challenge_id")
            if challenge_id in self.used_challenges:
                return "challenge_reused"
            challenge = self.challenges.pop(challenge_id, None)
            if challenge is None:
                return "challenge_unavailable"
            self.used_challenges.add(challenge_id)
            if challenge["expired"]:
                return "challenge_expired"
            challenge_kind = "enrol" if kind == "phone_authorize" else kind
            if challenge["kind"] != challenge_kind or challenge["candidate"] != candidate_of(operation):
                return "candidate_changed"
            if challenge["revision"] != self.revision or challenge["epoch"] != self.epoch:
                return "challenge_stale"
        if kind == "lose":
            self.initialized = False
            self.device_binding = None
            self.site_binding = None
            self.active.clear()
            self.values.clear()
            self.channels.clear()
            self.approvers.clear()
            self.tombstones.clear()
            self.approver_tombstones.clear()
            self.challenges.clear()
            return "locked"
        if kind == "recover":
            if operation.get("local_request") is not True:
                return "local_auth_required"
            if self.initialized:
                return "recovery_not_available"
            if operation["epoch"] == self.epoch:
                return "epoch_not_advanced"
            if operation["epoch"] != challenge["proposed_epoch"]:
                return "candidate_changed"
            if operation.get("contacts", []):
                return "contacts_forbidden"
            self.epoch = operation["epoch"]
            self.initialized = True
            # "committing `initialized = true` with the device, site and epoch
            # bindings": the runtime's device identity and verified site.
            self.device_binding = (DEVICE_ID if "recover_binds_runtime_device" in self.disabled
                                   else self.config_device)
            self.site_binding = (SITE_ID if "recover_binds_runtime_site" in self.disabled
                                 else self.config_site)
            self.revision = 1
            self.external_revision = 0
            self.last_external_document = None
            self.sequence = 0
            self.proposals.clear()
            for challenge_id in self.pending_phone:
                self.invalidated_phone[challenge_id] = "epoch_changed"
            self.pending_phone.clear()
            return "recovered"
        if kind == "phone_commit":
            verdict = self.phone_commit_refusal(operation)
            if verdict is not None:
                return verdict
            candidate = self.commit_pending["candidate"]
            identifier = candidate["credential"]
            approver_id = candidate["approver_id"]
            value = candidate["value"]
            # Second-commit recheck: the approver ID against tombstones, and
            # against active entries only when the runtime minted it. A minted
            # ID found active cannot reach here: with the revision unchanged
            # require_defence_in_depth already refused it, and any activation
            # changes the revision so registry_changed decided first. The text
            # names no code for it, so the model asserts instead of answering.
            if approver_id in self.approver_tombstones:
                return "approver_revoked"
            if self.commit_pending["approver_minted"] and approver_id in self.active_approvers():
                raise AssertionError("unreachable: minted approver ID active at second commit")
            if identifier in self.approvers or identifier in self.tombstones:
                return "credential_reused"
            # Duplicate and tombstone checks compare the number alone across
            # sms and whatsapp: stored values carry no channel.
            if value in (self.values[x] for x in self.tombstones if x in self.values):
                return "value_tombstoned"
            if value in (self.values[x] for x in self.active):
                return "duplicate_value"
            self.sequence += 1
            self.active[identifier] = self.sequence
            self.values[identifier] = value
            self.channels[identifier] = candidate["channel"]
            self.approvers[identifier] = approver_id
            self.revision += 1
            return "enrolled"
        if not self.initialized and kind != "revoke":
            return "registry_unavailable"
        if kind == "local_seed":
            if self.active:
                return "active_authorizer_exists"
            if operation.get("local_request") is not True:
                return "local_auth_required"
            if operation.get("channel") != "lan_ed25519":
                return "lan_key_required"
            if operation.get("possession") is not True:
                return "possession_invalid"
            identifier = operation["credential"]
            approver_id = operation["approver_id"]
            value = operation.get("value", identifier)
            if approver_id in self.approver_tombstones:
                return "approver_revoked"
            if identifier in self.tombstones or identifier in self.approvers:
                return "credential_reused"
            if value in (self.values[x] for x in self.tombstones if x in self.values):
                return "value_tombstoned"
            if value in (self.values[x] for x in self.active):
                return "duplicate_value"
            self.sequence += 1
            self.active[identifier] = self.sequence
            self.values[identifier] = value
            self.channels[identifier] = "lan_ed25519"
            self.approvers[identifier] = approver_id
            self.revision += 1
            return "seeded"
        if kind in {"enrol", "phone_authorize"}:
            # "The first ORI-ENROL-V1 text received on an authenticated ingress
            # for a challenge ID, whoever its sender, is its authorization; a
            # later text for the same challenge ID is ignored and changes
            # nothing." This model carries one
            # authorizer per presentation, so it has no multi-text case; that
            # rule is exercised by operator-socket/v3's corpus, not here.
            if operation["authorizer"] not in self.active:
                return "authorizer_unavailable"
            if self.active[operation["authorizer"]] > challenge["sequence"]:
                return "authorizer_not_preexisting"
            # "An enrolment that names an existing approver must be authorised
            # by one of that approver's own active credentials." The tier C
            # text defers the code to operator-socket/v3: authorizer_not_approver,
            # placed there after authorizer_not_preexisting.
            named = challenge["candidate"].get("approver_id") if isinstance(challenge["candidate"], dict) else None
            if (named in self.active_approvers()
                    and self.approvers.get(operation["authorizer"]) != named
                    and "authorizer_same_approver" not in self.disabled):
                return "authorizer_not_approver"
            if operation.get("local_request") is not True:
                return "local_auth_required"
            channel = operation.get("channel", "lan_ed25519")
            if kind == "phone_authorize":
                if channel not in PHONE_CHANNELS or challenge["phone_code_sha256"] is None:
                    return "malformed"
                if channel not in self.authenticated_channels:
                    # Unreachable while issue refuses the candidate; kept so a
                    # pending operation can never exist on such a channel.
                    return "channel_unauthenticated"
                candidate = candidate_of(operation)
                if any(pending["candidate"]["value"] == candidate["value"] for pending in self.pending_phone.values()):
                    return "phone_pending_for_value"
                self.pending_phone[challenge_id] = {
                    "candidate": candidate,
                    "authorizer": operation["authorizer"],
                    "revision": self.revision,
                    "epoch": self.epoch,
                    "phone_code_sha256": challenge["phone_code_sha256"],
                    "approver_minted": challenge["approver_minted"],
                }
                return "phone_pending"
            if channel != "lan_ed25519":
                return "malformed"
            if operation.get("possession") is not True:
                return "possession_invalid"
            identifier = operation["credential"]
            approver_id = operation.get("approver_id", identifier)
            value = operation.get("value", identifier)
            if approver_id in self.approver_tombstones:
                return "approver_revoked"
            if identifier in self.approvers or identifier in self.tombstones:
                return "credential_reused"
            if value in (self.values[x] for x in self.tombstones if x in self.values):
                return "value_tombstoned"
            if value in (self.values[x] for x in self.active):
                return "duplicate_value"
            self.sequence += 1
            self.active[identifier] = self.sequence
            self.values[identifier] = value
            self.channels[identifier] = "lan_ed25519"
            self.approvers[identifier] = approver_id
            self.revision += 1
            return "enrolled"
        if kind == "open":
            # Bindings decided above for every operation on an initialized registry.
            if operation["proposal"] in self.proposals:
                return "proposal_exists"
            self.proposals[operation["proposal"]] = {
                "cutoff": self.sequence,
                "epoch": self.epoch,
                "approved": False,
            }
            return "opened"
        if kind == "revoke":
            request_bytes = operation.get("document_wire")
            if request_bytes is None:
                request_bytes = canonical_profile2(operation["document"])
            else:
                request_bytes = request_bytes.encode("utf-8")
            request_bytes = b'{"operation":"approver_registry_revoke","document":' + request_bytes + b'}'
            if len(request_bytes) > 16_384:
                return "payload_too_large"
            if operation.get("config_signed", True) is not True:
                return "anchor_unavailable"
            if "document_wire" in operation:
                try:
                    document = json.loads(operation["document_wire"], object_pairs_hook=unique_pairs)
                except (ValueError, TypeError):
                    return "malformed"
            else:
                document = operation["document"]
            reason = revocation_reason(document)
            if reason is not None:
                return reason
            # "`registry_unavailable` | The registry is locked." then the device and
            # site binding rows, then `binding_mismatch`.
            if not self.initialized:
                return "registry_unavailable"
            refusal = self.binding_refusal()
            if refusal is not None:
                return refusal
            # "The document's `device_id` differs from the runtime's device identity,
            # or its `site_id` or `identity_epoch` from the registry's."
            if (
                document["device_id"] != self.config_device
                or document["site_id"] != self.site_binding
                or document["identity_epoch"] != self.epoch
            ):
                return "binding_mismatch"
            revision = document["revision"]
            fingerprint = hashlib.sha256(canonical_profile2(document)).hexdigest()
            if revision < self.external_revision:
                return "revision_regressed"
            if revision == self.external_revision:
                return (
                    "replayed"
                    if fingerprint == self.last_external_document
                    else "revision_conflict"
                )
            for target in document["targets"]:
                kind, identifier = target.split(":", 1)
                if kind == "credential":
                    if identifier not in self.active and identifier not in self.tombstones:
                        return "unknown_target"
                elif identifier not in self.approvers.values() and identifier not in self.approver_tombstones:
                    return "unknown_target"
            for target in document["targets"]:
                kind, identifier = target.split(":", 1)
                if kind == "credential":
                    self.active.pop(identifier, None)
                    self.tombstones.add(identifier)
                else:
                    self.approver_tombstones.add(identifier)
                    for credential, owner in self.approvers.items():
                        if owner == identifier:
                            self.active.pop(credential, None)
                            self.tombstones.add(credential)
            self.external_revision = revision
            self.last_external_document = fingerprint
            self.revision += 1
            return "revoked"
        if kind == "admit":
            # Bindings decided above for every operation on an initialized registry.
            proposal = self.proposals.get(operation["proposal"])
            if proposal is None:
                return "proposal_unavailable"
            if proposal["approved"]:
                return "already_decided"
            if operation.get("channel") == "local_console" and operation.get("authenticated") is not True:
                return "ingress_unauthenticated"
            reply_channel = operation.get("channel")
            if reply_channel in PHONE_CHANNELS:
                # "A Tier C reply on such a channel is refused as
                # ingress_unauthenticated." An absent flag is not authenticated.
                if (reply_channel not in self.authenticated_channels
                        and "admit_phone_channel" not in self.disabled):
                    return "ingress_unauthenticated"
                if (operation.get("authenticated") is not True
                        and "admit_auth_flag" not in self.disabled):
                    return "ingress_unauthenticated"
            if proposal["epoch"] != self.epoch:
                return "epoch_changed"
            sequence = self.active.get(operation["credential"])
            if sequence is None:
                return "credential_unavailable"
            # "No active credential for a channel admits no reply on that
            # channel": the reply's channel must be the credential's channel.
            if (self.channels.get(operation["credential"]) != credential_channel_of_reply(reply_channel)
                    and "admit_credential_channel" not in self.disabled):
                return "credential_unavailable"
            if sequence > proposal["cutoff"]:
                return "enrolled_after_proposal"
            proposal["approved"] = True
            proposal["credential_id"] = operation["credential"]
            proposal["registry_revision"] = self.revision
            return "approved"
        raise ValueError(f"unknown operation: {kind}")


def require_channel_flags(scenarios: list[dict[str, Any]]) -> None:
    """A phone-channel message must state its `authenticated` flag as a bool.

    The flag says the message's authenticator verified its bytes; it never
    makes a channel without an authenticated ingress authenticated, so a
    `true` flag on such a channel is a legitimate fixture (and the model
    refuses it). An absent flag would be ambiguous and is malformed corpus.
    """
    for scenario in scenarios:
        for index, step in enumerate(scenario["steps"]):
            where = f"{scenario['name']} step {index}"
            reply = step.get("phone_reply")
            if isinstance(reply, dict) and type(reply.get("authenticated")) is not bool:
                raise AssertionError(f"{where}: phone reply without authenticated flag")
            if step["op"] == "admit" and step.get("channel") in PHONE_CHANNELS:
                if type(step.get("authenticated")) is not bool:
                    raise AssertionError(f"{where}: phone-channel reply without authenticated flag")


def require_sms_ingress_refusal(scenarios: list[dict[str, Any]]) -> None:
    """`sms_ingress_unavailable` must show, in order: an SMS credential enrolled
    by `phone_commit` and an authenticated `sms` reply from it `approved`; an
    `sms` challenge issued and held, and another authorised to
    `phone_pending`; one `restart` with `sms_ingress: false`; then an
    authenticated `sms` reply from the same credential refused as
    `ingress_unauthenticated` on a new proposal (single fault); the pending
    operation's commit `pending_unavailable`; the held challenge and the
    enrolment's used challenge each `challenge_unavailable` (not
    `challenge_reused`); a new `sms` challenge refused at issue as
    `channel_unauthenticated` with its presentation `challenge_unavailable`;
    and a LAN reply `approved` on the new proposal after the refusal.
    """
    steps = next(x for x in scenarios if x["name"] == "sms_ingress_unavailable")["steps"]
    restarts = [i for i, x in enumerate(steps) if x["op"] == "restart" and x.get("sms_ingress") is False and x["expect"] == "restarted"]
    if len(restarts) != 1:
        raise AssertionError("restart removing sms ingress not exercised once")
    cut = restarts[0]
    head, tail = steps[:cut], steps[cut + 1:]
    sms_issued = {
        x["challenge_id"]: x["candidate"]["credential"] for x in head
        if x["op"] == "issue" and x["expect"] == "issued"
        and isinstance(x.get("candidate"), dict) and x["candidate"].get("channel") == "sms"
    }
    used = {x["challenge_id"] for x in head if x["op"] == "phone_commit" and x["expect"] == "enrolled" and x["challenge_id"] in sms_issued}
    enrolled = {sms_issued[c] for c in used}
    presented = {x.get("challenge_id") for x in head if x["op"] in {"phone_authorize", "enrol"}}
    pending = {x["challenge_id"] for x in head if x["op"] == "phone_authorize" and x["expect"] == "phone_pending"} - used
    held = set(sms_issued) - presented

    def admits(window: list[dict[str, Any]], expect: str) -> dict[str, str]:
        return {
            x["credential"]: x["proposal"] for x in window
            if x["op"] == "admit" and x.get("channel") == "sms" and x.get("authenticated") is True
            and x["expect"] == expect and x["credential"] in enrolled
        }
    approved, refused = admits(head, "approved"), admits(tail, "ingress_unauthenticated")
    proposals = {refused[c] for c in approved.keys() & refused.keys() if refused[c] != approved[c]}
    if not proposals:
        raise AssertionError("sms reply from one credential not shown approved before and refused after the restart")

    def after(op: set[str], ids: set[str], expect: str) -> bool:
        return any(x["op"] in op and x.get("challenge_id") in ids and x["expect"] == expect for x in tail)
    if not after({"phone_commit"}, pending, "pending_unavailable"):
        raise AssertionError("pending sms operation not shown invalidated by restart")
    if not after({"phone_authorize", "enrol"}, held, "challenge_unavailable"):
        raise AssertionError("held sms challenge not shown invalidated by restart")
    if not after({"phone_authorize", "enrol"}, used, "challenge_unavailable"):
        raise AssertionError("used challenge not shown challenge_unavailable after restart")
    new = {
        x["challenge_id"] for x in tail
        if x["op"] == "issue" and isinstance(x.get("candidate"), dict)
        and x["candidate"].get("channel") == "sms" and x["expect"] == "channel_unauthenticated"
    }
    if not after({"phone_authorize", "enrol"}, new, "challenge_unavailable"):
        raise AssertionError("sms without ingress not refused at issue")
    last_refusal = max(
        i for i, x in enumerate(tail)
        if x["op"] == "admit" and x.get("channel") == "sms" and x["expect"] == "ingress_unauthenticated"
    )
    if not any(
        x["op"] == "admit" and "channel" not in x and x["expect"] == "approved" and x["proposal"] in proposals
        for x in tail[last_refusal + 1:]
    ):
        raise AssertionError("LAN reply not shown approved after the refused sms reply")


def require_whatsapp_refusal(scenarios: list[dict[str, Any]]) -> None:
    """The scenario named for the WhatsApp refusal must actually exercise it.

    Required, in order: an `issue` of a `whatsapp` candidate expecting
    `channel_unauthenticated`; a later presentation of that challenge ID
    expecting `challenge_unavailable` (no challenge or used marker recorded);
    an SMS credential enrolled by `phone_commit`; then, on one open proposal
    and that SMS credential, a `whatsapp` reply refused as
    `ingress_unauthenticated`, an unauthenticated `sms` reply refused as
    `ingress_unauthenticated`, and only afterwards an authenticated `sms`
    reply `approved` (so the refusals are not due to the proposal or the
    credential).
    """
    scenario = next(x for x in scenarios if x["name"] == "whatsapp_candidate_refused_at_issue")
    steps = scenario["steps"]
    refused = [
        index for index, step in enumerate(steps)
        if step["op"] == "issue"
        and isinstance(step.get("candidate"), dict)
        and step["candidate"].get("channel") == "whatsapp"
        and step["expect"] == "channel_unauthenticated"
    ]
    if not refused:
        raise AssertionError("whatsapp refusal at issue not exercised")
    index = refused[0]
    if not any(
        x["op"] in {"phone_authorize", "enrol"}
        and x.get("challenge_id") == steps[index]["challenge_id"]
        and x["expect"] == "challenge_unavailable"
        for x in steps[index + 1:]
    ):
        raise AssertionError("refused whatsapp challenge not shown unrecorded")
    issued_sms = {
        x["challenge_id"]: x["candidate"]["credential"] for x in steps
        if x["op"] == "issue" and isinstance(x.get("candidate"), dict) and x["candidate"].get("channel") == "sms"
    }
    enrolled = {
        issued_sms[x["challenge_id"]] for x in steps[index + 1:]
        if x["op"] == "phone_commit" and x["expect"] == "enrolled" and x["challenge_id"] in issued_sms
    }

    def admits(channel: str, flag: bool | None, expect: str) -> dict[tuple[str, str], int]:
        return {
            (x["credential"], x["proposal"]): i for i, x in enumerate(steps)
            if x["op"] == "admit" and x.get("channel") == channel
            and (flag is None or (x.get("authenticated") is True) is flag) and x["expect"] == expect
            and x["credential"] in enrolled
        }
    # The WhatsApp reply is refused whatever its flag claims.
    whatsapp = admits("whatsapp", None, "ingress_unauthenticated")
    sms_false = admits("sms", False, "ingress_unauthenticated")
    for key, i in admits("sms", True, "approved").items():
        if whatsapp.get(key, i) < i and sms_false.get(key, i) < i:
            return
    raise AssertionError("whatsapp and unauthenticated sms Tier C replies not shown refused for an admissible credential")


STATE_FIELDS = (
    "initialized", "epoch", "config_site", "config_device", "device_binding", "site_binding",
    "revision", "external_revision",
    "last_external_document", "sequence", "active", "values", "channels",
    "tombstones", "approvers", "approver_tombstones", "proposals",
    "challenges", "used_challenges", "pending_phone", "invalidated_phone",
    "authenticated_channels",
)
CREDENTIAL_ADD = {"active", "values", "channels", "approvers", "sequence", "revision"}
PRESENTED = {"recover", "enrol", "local_seed", "phone_authorize"}
# Refusals that happen before a challenge is found, so nothing is consumed.
UNCONSUMED = {"challenge_unavailable", "challenge_reused", "device_binding_mismatch",
              "site_binding_mismatch"}
# Fields each successful verdict may change. Every other verdict is a refusal
# and may change only what the text says a refusal consumes.
SUCCESS_FIELDS: dict[tuple[str, str], set[str]] = {
    ("issue", "issued"): {"challenges"},
    ("expire", "expired"): {"challenges"},
    ("expire_phone", "expired"): {"pending_phone"},
    ("phone_authorize", "phone_pending"): {"challenges", "used_challenges", "pending_phone"},
    ("enrol", "enrolled"): {"challenges", "used_challenges"} | CREDENTIAL_ADD,
    ("local_seed", "seeded"): {"challenges", "used_challenges"} | CREDENTIAL_ADD,
    ("phone_commit", "enrolled"): {"pending_phone", "invalidated_phone"} | CREDENTIAL_ADD,
    ("recover", "recovered"): {
        "challenges", "used_challenges", "epoch", "initialized", "device_binding",
        "site_binding", "revision",
        "external_revision", "last_external_document", "sequence", "proposals",
        "pending_phone", "invalidated_phone",
    },
    ("revoke", "revoked"): {
        "active", "tombstones", "approver_tombstones", "revision",
        "external_revision", "last_external_document",
    },
    ("open", "opened"): {"proposals"},
    ("admit", "approved"): {"proposals"},
    ("lose", "locked"): {
        "initialized", "device_binding", "site_binding", "active", "values", "channels",
        "approvers", "tombstones", "approver_tombstones", "challenges",
    },
    ("apply_provisioning", "applied"): {"config_device", "config_site"},
    ("restart", "restarted"): {
        "challenges", "used_challenges", "pending_phone", "invalidated_phone",
        "proposals", "authenticated_channels", "config_device", "config_site",
    },
}


def snapshot(model: Registry) -> dict[str, Any]:
    return copy.deepcopy({field: getattr(model, field) for field in STATE_FIELDS})


def verify_state_change(where: str, operation: dict[str, Any], verdict: str, before: dict[str, Any], after: dict[str, Any]) -> None:
    """Every refusal changes nothing beyond what the text says it consumes.

    - Issue refusals (including `channel_unauthenticated`): nothing; no
      challenge, code, pending operation or revision ("Site enrolment").
    - A presented challenge is "marked used even when that operation is
      refused; refusal changes no credential, proposal or registry revision":
      exactly that challenge leaves `challenges` and enters the used markers.
      Refusals before the challenge is found consume nothing.
    - A phone commit refusal "removes the pending operation without adding a
      credential or changing the revision": exactly that pending entry goes.
    - Revocation refusals, including `replayed`, "refuse without changes";
      admission, proposal-open and expiry refusals change nothing.
    Successful verdicts may change only their own fields, with exact deltas
    on the challenge, used-marker and pending maps.
    """
    op = operation["op"]
    challenge_id = operation.get("challenge_id")
    allowed = SUCCESS_FIELDS.get((op, verdict))
    expected = copy.deepcopy(before)
    if allowed is None:
        if op in PRESENTED and verdict not in UNCONSUMED:
            expected["challenges"].pop(challenge_id, None)
            expected["used_challenges"].add(challenge_id)
        elif op == "phone_commit":
            expected["pending_phone"].pop(challenge_id, None)
            expected["invalidated_phone"].pop(challenge_id, None)
        if after != expected:
            changed = sorted(field for field in STATE_FIELDS if after[field] != expected[field])
            raise AssertionError(f"{where} {op}: refusal {verdict} changed {changed}")
        return
    changed = {field for field in STATE_FIELDS if after[field] != before[field]}
    if not changed <= allowed:
        raise AssertionError(f"{where} {op}: {verdict} changed {sorted(changed - allowed)}")
    if op == "restart":
        flag = operation.get("sms_ingress")
        ingress = before["authenticated_channels"] if flag is None else (
            before["authenticated_channels"] | {"sms"} if flag else before["authenticated_channels"] - {"sms"}
        )
        if (after["challenges"] or after["used_challenges"] or after["pending_phone"]
                or after["invalidated_phone"] or after["proposals"]
                or after["authenticated_channels"] != ingress):
            raise AssertionError(f"{where} restart: challenges, used markers, pending operations and proposals not all invalidated, or ingress set wrong")
        # "a restart step's sms_ingress, device_id and site_id set the
        # configuration it starts under, and a restart without one keeps that part
        # unchanged" (the corpus proof note).
        for key, field in (("device_id", "config_device"), ("site_id", "config_site")):
            if after[field] != operation.get(key, before[field]):
                raise AssertionError(f"{where} restart: started under the wrong {key}")
    if op == "apply_provisioning":
        for key, field in (("device_id", "config_device"), ("site_id", "config_site")):
            if after[field] != operation.get(key, before[field]):
                raise AssertionError(f"{where} apply_provisioning: applied the wrong {key}")
    if op == "recover" and (after["device_binding"], after["site_binding"]) != (
            before["config_device"], before["config_site"]):
        raise AssertionError(f"{where} recover: not bound to the runtime's device and site")
    if op == "issue":
        if set(after["challenges"]) != set(before["challenges"]) | {challenge_id}:
            raise AssertionError(f"{where} issue: challenge set")
    if op in PRESENTED:
        if (set(after["challenges"]) - {challenge_id} != set(before["challenges"]) - {challenge_id}
                or challenge_id in after["challenges"]
                or after["used_challenges"] != before["used_challenges"] | {challenge_id}):
            raise AssertionError(f"{where} {op}: challenge consumption")
    if op == "phone_authorize" and set(after["pending_phone"]) != set(before["pending_phone"]) | {challenge_id}:
        raise AssertionError(f"{where} phone_authorize: pending set")
    if op == "phone_commit" and (
        set(after["pending_phone"]) != set(before["pending_phone"]) - {challenge_id}
        or set(after["invalidated_phone"]) != set(before["invalidated_phone"]) - {challenge_id}
    ):
        raise AssertionError(f"{where} phone_commit: pending set")


def check(
    corpus: dict[str, Any],
    *,
    announce: bool = True,
    disabled: frozenset[str] = frozenset(),
    factory: Any = None,
) -> None:
    if corpus["contract"] != "tier-c-approvers/v1":
        raise AssertionError("wrong contract")
    if corpus["provisioning_test_public_key_b64"] != PUBLIC_KEY:
        raise AssertionError("unexpected test anchor")
    if corpus["previous_test_public_key_b64"] != PREVIOUS_KEY or corpus["commercial_test_public_key_b64"] != COMMERCIAL_KEY:
        raise AssertionError("unexpected alternate test anchors")
    verify_wire(corpus)
    scenarios = corpus["scenarios"]
    if len(scenarios) != len(NAMES) or {x["name"] for x in scenarios} != NAMES:
        raise AssertionError("required transition coverage changed")
    if "guard" not in disabled:
        require_channel_flags(scenarios)
    require_whatsapp_refusal(scenarios)
    require_sms_ingress_refusal(scenarios)
    total = 0
    same_approver: set[tuple[str, str]] = set()
    revoked_authorizer: set[tuple[str, str]] = set()
    for scenario in scenarios:
        if set(scenario) != {"name", "initial_mode", "steps"}:
            raise AssertionError(f"{scenario.get('name')}: scenario members")
        model = (factory or Registry)(scenario["initial_mode"], disabled)
        for operation in scenario["steps"]:
            if operation["op"] == "revoke" and "preimage_hex" in operation:
                unsigned = {key: value for key, value in operation["document"].items() if key != "signature"}
                if (b"ori.tier_c_approver.revoke.v1\0" + canonical_profile2(unsigned)).hex() != operation["preimage_hex"]:
                    raise AssertionError(f"{scenario['name']}: revocation preimage")
            before = snapshot(model)
            observe(model, operation, same_approver, revoked_authorizer)
            actual = model.apply(operation)
            verify_state_change(scenario["name"], operation, actual, before, snapshot(model))
            total += 1
            if actual != operation["expect"]:
                raise AssertionError(
                    f"{scenario['name']} {operation['op']}: "
                    f"{actual} != {operation['expect']}"
                )
    require_coverage(same_approver, revoked_authorizer)
    if announce:
        print(
            f"tier-c-approvers/v1: {len(scenarios)} scenarios, {total} transitions verified"
        )


def observe(model: Registry, operation: dict[str, Any], same_approver: set[tuple[str, str]], revoked_authorizer: set[tuple[str, str]]) -> None:
    """Record, from model state before the step, which authoriser cases it covers."""
    if operation["op"] not in {"enrol", "phone_authorize"}:
        return
    challenge = model.challenges.get(operation.get("challenge_id"))
    named = challenge["candidate"].get("approver_id") if challenge and isinstance(challenge["candidate"], dict) else None
    authorizer = operation.get("authorizer")
    path = "lan" if model.channels.get(authorizer) == "lan_ed25519" else "phone"
    if authorizer in model.tombstones and operation["expect"] == "authorizer_unavailable":
        revoked_authorizer.add((path, operation["op"]))
    if named in model.active_approvers() and authorizer in model.active:
        own = model.approvers.get(authorizer) == named
        if not own and operation["expect"] == "authorizer_not_approver":
            same_approver.add((path, "refused"))
        if own and operation["expect"] in {"enrolled", "phone_pending"}:
            same_approver.add((path, "accepted"))


def coverage_of(corpus: dict[str, Any]) -> tuple[set[tuple[str, str]], set[tuple[str, str]]]:
    """Observations only, without verdict or state assertions (for mutations)."""
    same_approver: set[tuple[str, str]] = set()
    revoked_authorizer: set[tuple[str, str]] = set()
    for scenario in corpus["scenarios"]:
        model = Registry(scenario["initial_mode"])
        for operation in scenario["steps"]:
            observe(model, operation, same_approver, revoked_authorizer)
            model.apply(operation)
    return same_approver, revoked_authorizer


REVOKED_AUTHORIZER_CASES = {
    (path, op) for path in ("lan", "phone") for op in ("enrol", "phone_authorize")
}


def require_coverage(same_approver: set[tuple[str, str]], revoked_authorizer: set[tuple[str, str]]) -> None:
    # An enrolment naming an existing approver: refused under another
    # approver's credential and accepted under its own, on both authoriser paths.
    missing = {(path, outcome) for path in ("lan", "phone") for outcome in ("refused", "accepted")} - same_approver
    if missing:
        raise AssertionError(f"same-approver enrolment coverage missing: {sorted(missing)}")
    # A revoked (tombstoned) authoriser is refused at enrol and at
    # phone_authorize, on both the LAN-credential and phone-credential paths.
    missing = REVOKED_AUTHORIZER_CASES - revoked_authorizer
    if missing:
        raise AssertionError(f"revoked authoriser coverage missing: {sorted(missing)}")


def mutations(corpus: dict[str, Any]) -> None:
    mutants: list[tuple[str, dict[str, Any]]] = []
    missing = copy.deepcopy(corpus)
    missing["scenarios"].pop()
    mutants.append(("missing scenario", missing))
    false_approval = copy.deepcopy(corpus)
    next(
        scenario
        for scenario in false_approval["scenarios"]
        if scenario["name"] == "empty_registry_admits_nobody"
    )["steps"][-1]["expect"] = "approved"
    mutants.append(("false approval", false_approval))
    forged = copy.deepcopy(corpus)
    next(
        operation for operation in next(
            scenario for scenario in forged["scenarios"]
            if scenario["name"] == "revocation_repeat_regression_conflict"
        )["steps"] if operation["op"] == "revoke"
    )["document"]["signature"] = "AA=="
    mutants.append(("forged revocation", forged))
    altered_preimage = copy.deepcopy(corpus)
    altered_preimage["wire"]["authorizer"]["preimage_hex"] = "00" + altered_preimage["wire"]["authorizer"]["preimage_hex"][2:]
    mutants.append(("authorizer preimage", altered_preimage))
    altered_candidate = copy.deepcopy(corpus)
    altered_candidate["wire"]["challenge"]["candidates"][0]["credential_id"] = "other-app"
    mutants.append(("challenge candidate", altered_candidate))
    false_seed = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in false_seed["scenarios"]
        if scenario["name"] == "empty_registry_local_seed_requires_site_proofs"
    )["steps"] if operation["op"] == "local_seed" and operation["expect"] == "local_auth_required")["expect"] = "seeded"
    mutants.append(("missing local authentication accepted", false_seed))
    false_expiry = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in false_expiry["scenarios"]
        if scenario["name"] == "challenge_expiry_reuse_change_and_restart"
    )["steps"] if operation["op"] == "enrol" and operation["expect"] == "challenge_expired")["expect"] = "enrolled"
    mutants.append(("expired challenge accepted", false_expiry))
    false_phone = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in false_phone["scenarios"]
        if scenario["name"] == "phone_candidate_requires_channel_possession"
    )["steps"] if operation["op"] == "phone_commit" and operation["expect"] == "possession_required")["expect"] = "enrolled"
    mutants.append(("phone without possession accepted", false_phone))
    late_phone = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in late_phone["scenarios"]
        if scenario["name"] == "phone_candidate_late_reply_refused"
    )["steps"] if operation["op"] == "phone_commit")["expect"] = "enrolled"
    mutants.append(("late phone reply accepted", late_phone))
    revoked_phone = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in revoked_phone["scenarios"]
        if scenario["name"] == "phone_authorizer_revoked_before_commit"
    )["steps"] if operation["op"] == "phone_commit")["expect"] = "enrolled"
    mutants.append(("revoked authorizer accepted at phone commit", revoked_phone))
    recovered_phone = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in recovered_phone["scenarios"]
        if scenario["name"] == "phone_recovery_before_commit"
    )["steps"] if operation["op"] == "phone_commit")["expect"] = "enrolled"
    mutants.append(("old epoch phone commit accepted", recovered_phone))
    duplicate_pending = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in duplicate_pending["scenarios"]
        if scenario["name"] == "one_pending_phone_per_candidate_value"
    )["steps"] if operation["op"] == "phone_authorize" and operation["expect"] == "phone_pending_for_value")["expect"] = "phone_pending"
    mutants.append(("second pending phone for value accepted", duplicate_pending))
    changed_registry = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in changed_registry["scenarios"]
        if scenario["name"] == "phone_registry_change_before_commit"
    )["steps"] if operation["op"] == "phone_commit")["expect"] = "enrolled"
    mutants.append(("changed registry accepted at phone commit", changed_registry))
    changed_site = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in changed_site["scenarios"]
        if scenario["name"] == "phone_site_change_before_commit"
    )["steps"] if operation["op"] == "phone_commit")["expect"] = "enrolled"
    mutants.append(("changed site accepted at phone commit", changed_site))
    # The device binding's declared verdicts, each flipped to what a wrong
    # implementation would answer.
    def scenario_steps_of(mutant: dict[str, Any], scenario: str) -> list[dict[str, Any]]:
        return next(x for x in mutant["scenarios"] if x["name"] == scenario)["steps"]

    def device_step(mutant: dict[str, Any], scenario: str, predicate: Any) -> dict[str, Any]:
        return next(x for x in scenario_steps_of(mutant, scenario) if predicate(x))
    for label, scenario, predicate, wrong in (
        ("admission while device changed", "device_identity_change_locks_admission",
         lambda x: x["op"] == "admit" and x["expect"] == "device_binding_mismatch", "approved"),
        ("proposal survives device change", "device_identity_change_locks_admission",
         lambda x: x["op"] == "admit" and x["expect"] == "proposal_unavailable", "approved"),
        ("revocation applied while device changed", "device_identity_change_locks_admission",
         lambda x: x["op"] == "revoke" and x["document"]["device_id"] == "edge-2", "revoked"),
        ("revocation judged on the document's device", "device_identity_change_locks_admission",
         lambda x: x["op"] == "revoke" and x["document"]["device_id"] == "edge-1", "binding_mismatch"),
        ("restore does not re-enable", "device_identity_change_locks_admission",
         lambda x: x["op"] == "open" and x["expect"] == "opened" and x["proposal"] == "after-restore",
         "device_binding_mismatch"),
        ("site decides over device", "device_change_decides_over_site_change",
         lambda x: x["op"] == "admit" and x["expect"] == "device_binding_mismatch", "site_binding_mismatch"),
        ("site still changed admits", "device_change_decides_over_site_change",
         lambda x: x["op"] == "open" and x["expect"] == "site_binding_mismatch", "opened"),
        # a restart ends every pending operation: step 2, not a binding recheck
        ("pending survives a device restart", "phone_device_change_before_commit",
         lambda x: x["op"] == "phone_commit", "enrolled"),
        ("pending judged on the device after restarts", "phone_device_change_before_commit",
         lambda x: x["op"] == "phone_commit", "device_binding_mismatch"),
        ("pending judged on the site after restarts", "phone_device_and_site_change_before_commit",
         lambda x: x["op"] == "phone_commit", "site_binding_mismatch"),
        ("recovery bound to a constant device", "recovery_binds_the_runtime_device",
         lambda x: x["op"] == "admit" and x["expect"] == "approved", "device_binding_mismatch"),
        ("restart back to the old device admits", "recovery_binds_the_runtime_device",
         lambda x: x["op"] == "open" and x["expect"] == "device_binding_mismatch", "opened"),
        ("lock without recovery as recovery", "phone_lock_without_recovery",
         lambda x: x["op"] == "phone_commit", "epoch_changed"),
        ("lock before window", "phone_lock_without_recovery_late",
         lambda x: x["op"] == "phone_commit", "registry_unavailable"),
        ("lock before proof", "phone_lock_without_recovery_wrong_code",
         lambda x: x["op"] == "phone_commit", "registry_unavailable"),
        ("another sender accepted", "phone_commit_names_another_value",
         lambda x: x["op"] == "phone_commit", "enrolled"),
        ("another sender as candidate_changed", "phone_commit_names_another_value",
         lambda x: x["op"] == "phone_commit", "candidate_changed"),
        ("window before pending lookup", "phone_expired_then_late_reply",
         lambda x: x["op"] == "phone_commit", "possession_expired"),
        ("proof before window", "phone_late_over_wrong_code",
         lambda x: x["op"] == "phone_commit", "possession_invalid"),
        ("authorizer before proof", "phone_wrong_code_over_revoked_authorizer",
         lambda x: x["op"] == "phone_commit", "authorizer_unavailable"),
        ("window before recovery invalidation", "phone_recovery_then_late_reply",
         lambda x: x["op"] == "phone_commit", "possession_expired"),
        ("locked registry before recovery invalidation", "phone_recovery_then_locked_registry",
         lambda x: x["op"] == "phone_commit", "registry_unavailable"),
        # In-run identity changes: nothing is cleared, and a restore re-enables use.
        ("in-run change closes the proposal", "inrun_device_change_locks_admission",
         lambda x: x["op"] == "admit" and x["expect"] == "approved", "proposal_unavailable"),
        ("in-run restore does not re-enable", "inrun_site_change_locks_admission",
         lambda x: x["op"] == "admit" and x["expect"] == "approved", "site_binding_mismatch"),
        ("an undone change still fails the commit", "inrun_phone_commit_after_restore",
         lambda x: x["op"] == "phone_commit", "device_binding_mismatch"),
        ("in-run change ends the pending operation", "inrun_phone_commit_device_changed",
         lambda x: x["op"] == "phone_commit", "pending_unavailable"),
        ("site recheck before device recheck", "inrun_phone_commit_device_over_site",
         lambda x: x["op"] == "phone_commit", "site_binding_mismatch"),
        ("device recheck before authorizer", "inrun_phone_revoked_authorizer_over_device",
         lambda x: x["op"] == "phone_commit", "device_binding_mismatch"),
        ("device recheck before revision", "inrun_phone_revision_over_device",
         lambda x: x["op"] == "phone_commit", "device_binding_mismatch"),
        ("presentation under a device change consumed", "inrun_challenge_presented_device_changed",
         lambda x: x["op"] == "enrol", "challenge_stale"),
        ("channel judged before device", "phone_issue_refused_while_device_changed",
         lambda x: x["op"] == "issue" and x.get("challenge_id") == "whatsapp-device-changed",
         "channel_unauthenticated"),
        ("sms issued while device changed", "phone_issue_refused_while_device_changed",
         lambda x: x["op"] == "issue" and x.get("challenge_id") == "sms-device-changed", "issued"),
    ):
        mutant = copy.deepcopy(corpus)
        device_step(mutant, scenario, predicate)["expect"] = wrong
        mutants.append((f"device: {label}", mutant))
    # A restart's configuration: a malformed device or site is a fixture defect;
    # a restart that drops its device_id keeps the changed device, so the step the
    # corpus says re-enables use is refused.
    for label, key, value in (("malformed device", "device_id", "edge 2"),
                              ("device over 128", "device_id", "x" * 129),
                              ("malformed site", "site_id", "site 2"),
                              ("restore without its device", "device_id", None)):
        mutant = copy.deepcopy(corpus)
        steps = scenario_steps_of(mutant, "device_identity_change_locks_admission")
        restarts = [x for x in steps if x["op"] == "restart" and "device_id" in x]
        step = restarts[-1] if value is None else restarts[0]
        if value is None:
            del step[key]
        else:
            step[key] = value
        mutants.append((f"device: restart {label}", mutant))
    # Finding 6 of the adversarial review: a revocation is judged on its form,
    # signer and signature, and on a locked registry, before the bindings
    # (operator-socket/v3 Revoke). A corrupted signature during a device mismatch is
    # signature_invalid.
    revoke_order = copy.deepcopy(corpus)
    bad = device_step(revoke_order, "device_identity_change_locks_admission",
                      lambda x: x["op"] == "revoke" and x["document"]["device_id"] == "edge-1")
    sig = bad["document"]["signature"]
    bad["document"]["signature"] = ("B" if sig[0] != "B" else "C") + sig[1:]
    bad["expect"] = "signature_invalid"
    check(revoke_order, announce=False)
    flipped_order = copy.deepcopy(revoke_order)
    device_step(flipped_order, "device_identity_change_locks_admission",
                lambda x: x["op"] == "revoke" and x["expect"] == "signature_invalid")["expect"] = \
        "device_binding_mismatch"
    mutants.append(("device: binding decided before a revocation's signature", flipped_order))
    altered_phone_wire = copy.deepcopy(corpus)
    altered_phone_wire["wire"]["phone_candidate"]["reply"]["sender"] = "+2348099999999"
    mutants.append(("phone wire wrong sender", altered_phone_wire))
    def whatsapp_issue(mutant: dict[str, Any]) -> dict[str, Any]:
        return next(operation for operation in next(
            scenario for scenario in mutant["scenarios"]
            if scenario["name"] == "whatsapp_candidate_refused_at_issue"
        )["steps"] if operation["op"] == "issue" and operation["expect"] == "channel_unauthenticated")
    whatsapp_issued = copy.deepcopy(corpus)
    whatsapp_issue(whatsapp_issued)["expect"] = "issued"
    mutants.append(("whatsapp candidate issued", whatsapp_issued))
    whatsapp_dropped = copy.deepcopy(corpus)
    whatsapp_dropped["scenarios"] = [
        scenario for scenario in whatsapp_dropped["scenarios"]
        if scenario["name"] != "whatsapp_candidate_refused_at_issue"
    ]
    mutants.append(("whatsapp refusal scenario removed", whatsapp_dropped))
    whatsapp_to_sms = copy.deepcopy(corpus)
    whatsapp_issue(whatsapp_to_sms)["candidate"]["channel"] = "sms"
    mutants.append(("sms candidate refused as unauthenticated", whatsapp_to_sms))
    whatsapp_step_dropped = copy.deepcopy(corpus)
    steps = next(
        scenario for scenario in whatsapp_step_dropped["scenarios"]
        if scenario["name"] == "whatsapp_candidate_refused_at_issue"
    )["steps"]
    steps.remove(whatsapp_issue(whatsapp_step_dropped))
    mutants.append(("whatsapp issue step removed", whatsapp_step_dropped))
    whatsapp_recorded = copy.deepcopy(corpus)
    next(operation for operation in next(
        scenario for scenario in whatsapp_recorded["scenarios"]
        if scenario["name"] == "whatsapp_candidate_refused_at_issue"
    )["steps"] if operation["op"] == "phone_authorize" and operation["expect"] == "challenge_unavailable")["expect"] = "phone_pending"
    mutants.append(("refused whatsapp challenge authorized", whatsapp_recorded))
    # Fixture claims v1 rules out: refused by the structural guard.
    def scenario_steps(mutant: dict[str, Any], name: str) -> list[dict[str, Any]]:
        return next(x for x in mutant["scenarios"] if x["name"] == name)["steps"]

    def wrong_channel_reply(mutant: dict[str, Any]) -> dict[str, Any]:
        return next(
            x for x in scenario_steps(mutant, "phone_candidate_rejects_wrong_code_and_sender")
            if isinstance(x.get("phone_reply"), dict) and x["phone_reply"]["channel"] == "whatsapp"
        )["phone_reply"]

    def whatsapp_admit(mutant: dict[str, Any]) -> dict[str, Any]:
        return next(
            x for x in scenario_steps(mutant, "whatsapp_candidate_refused_at_issue")
            if x["op"] == "admit" and x.get("channel") == "whatsapp"
        )

    def sms_unauthenticated_admit(mutant: dict[str, Any]) -> dict[str, Any]:
        return next(
            x for x in scenario_steps(mutant, "whatsapp_candidate_refused_at_issue")
            if x["op"] == "admit" and x.get("channel") == "sms" and x.get("authenticated") is False
        )
    flagged_reply = copy.deepcopy(corpus)
    wrong_channel_reply(flagged_reply)["authenticated"] = True

    flagged_admit = copy.deepcopy(corpus)
    whatsapp_admit(flagged_admit)["authenticated"] = True

    flagless_admit = copy.deepcopy(corpus)
    del sms_unauthenticated_admit(flagless_admit)["authenticated"]
    mutants.append(("phone Tier C reply without flag", flagless_admit))
    for name, step in (
        ("whatsapp Tier C reply admitted", whatsapp_admit),
        ("unauthenticated sms Tier C reply admitted", sms_unauthenticated_admit),
    ):
        mutant = copy.deepcopy(corpus)
        step(mutant)["expect"] = "approved"
        mutants.append((name, mutant))
    dropped_admit = copy.deepcopy(corpus)
    scenario_steps(dropped_admit, "whatsapp_candidate_refused_at_issue").remove(whatsapp_admit(dropped_admit))
    mutants.append(("whatsapp Tier C refusal removed", dropped_admit))

    # Issue order probes ("A locked registry and a site binding mismatch refuse
    # such a candidate first").
    def whatsapp_probe(challenge_id: str, expect: str) -> dict[str, Any]:
        return {
            "op": "issue", "kind": "enrol", "challenge_id": challenge_id,
            "candidate": {"approver_id": "probe", "channel": "whatsapp", "credential": "probe", "value": "+2348012345678"},
            "phone_code_sha256": "0" * 64, "expect": expect,
        }

    def with_probe(after_op: str, scenario: str, expect: str) -> dict[str, Any]:
        mutant = copy.deepcopy(corpus)
        steps = scenario_steps(mutant, scenario)
        at = next(i for i, x in enumerate(steps) if x["op"] == after_op) + 1
        steps.insert(at, whatsapp_probe("probe-" + after_op, expect))
        return mutant
    locked_probe = with_probe("lose", "recovery_can_seed_but_closes_old_proposals", "registry_unavailable")
    site_probe = with_probe("restart", "phone_site_change_before_commit", "site_binding_mismatch")
    for label, probe in (("locked", locked_probe), ("site mismatch", site_probe)):
        check(probe, announce=False)
        flipped = copy.deepcopy(probe)
        for scenario in flipped["scenarios"]:
            for x in scenario["steps"]:
                if x["challenge_id" if "challenge_id" in x else "op"] in {"probe-lose", "probe-restart"}:
                    x["expect"] = "channel_unauthenticated"
        mutants.append((f"channel_unauthenticated before {label} refusal", flipped))

    # Model-check removal: each check must decide a verdict in the corpus or in
    # the stated variant with the stated other checks off.
    lan_sms_admit = copy.deepcopy(corpus)
    steps = scenario_steps(lan_sms_admit, "whatsapp_candidate_refused_at_issue")
    approved_at = next(i for i, x in enumerate(steps) if x["op"] == "admit" and x["expect"] == "approved")
    steps.insert(approved_at, {
        "op": "admit", "proposal": steps[approved_at]["proposal"], "credential": "owner-key",
        "channel": "sms", "authenticated": True, "expect": "credential_unavailable",
    })
    removals: list[tuple[str, dict[str, Any], frozenset[str]]] = [
        ("issue_channel", corpus, frozenset()),
        ("issue_locked_first", locked_probe, frozenset()),
        ("admit_auth_flag", corpus, frozenset()),
        ("admit_phone_channel", corpus, frozenset()),
        ("reply_auth_channel", flagged_reply, frozenset({"reply_channel_mismatch"})),
        ("reply_channel_mismatch", flagged_reply, frozenset({"reply_auth_channel"})),
        ("restart_ingress", corpus, frozenset()),
        ("restart_used_markers", corpus, frozenset()),
        ("admit_credential_channel", lan_sms_admit, frozenset()),
        ("authorizer_same_approver", corpus, frozenset()),
        ("device_check", corpus, frozenset()),
        ("device_first", corpus, frozenset()),
        ("mismatch_needs_initialized", corpus, frozenset()),
        ("restart_device", corpus, frozenset()),
        ("restart_site", corpus, frozenset()),
        ("recover_binds_runtime_device", corpus, frozenset()),
        ("recover_binds_runtime_site", corpus, frozenset()),
        ("apply_device", corpus, frozenset()),
        ("apply_site", corpus, frozenset()),
        ("apply_keeps_state", corpus, frozenset()),
        ("revoke_document_first", corpus, frozenset()),
    ] + [(f"commit_order:{n}", corpus, frozenset()) for n in (1, 2, 3, 4, 5, 6, 7, 8)]
    if {name for name, _, _ in removals} | {"guard"} != MODEL_CHECKS:
        raise AssertionError("model check without a removal mutation")
    # The device-binding checks, each refused for its own reason: the verdict the
    # corpus declares against the one the model then gives, or the state law the
    # text gives the device change.
    device_reasons: dict[str, tuple[str, ...]] = {
        "device_check": ("!= device_binding_mismatch",),
        "device_first": ("site_binding_mismatch != device_binding_mismatch",),
        "mismatch_needs_initialized": ("device_binding_mismatch != issued",),
        "restart_device": ("restart: started under the wrong device_id",),
        "restart_site": ("restart: started under the wrong site_id",),
        "recover_binds_runtime_device": ("recover: not bound to the runtime's device and site",),
        "recover_binds_runtime_site": ("recover: not bound to the runtime's device and site",),
        "apply_device": ("apply_provisioning: applied the wrong device_id",),
        "apply_site": ("apply_provisioning: applied the wrong site_id",),
        "apply_keeps_state": ("apply_provisioning: applied changed",),
        "revoke_document_first": ("revoke: device_binding_mismatch != signature_invalid",
                                  "revoke: device_binding_mismatch != malformed",
                                  "revoke: registry_unavailable != malformed"),
    }
    # Each adjacent pair of second-commit steps swapped: a scenario the text decides
    # at step n is then answered by step n + 1.
    for n in (1, 2, 3, 4, 5, 6, 7, 8):
        device_reasons[f"commit_order:{n}"] = (
            f"phone_commit: {COMMIT_STEPS[n]} != {COMMIT_STEPS[n - 1]}",)
    for n in COMMIT_UNDISTINGUISHED:
        try:
            check(corpus, announce=False, disabled=frozenset({f"commit_order:{n}"}))
        except AssertionError as exc:
            raise AssertionError(f"commit steps {n}/{n + 1} are now told apart; make the swap a "
                                 f"model-check removal: {exc}") from exc
    for name, variant, others in removals:
        check(variant, announce=False, disabled=others)
        try:
            check(variant, announce=False, disabled=others | {name})
        except AssertionError as exc:
            if name in device_reasons and not any(r in str(exc) for r in device_reasons[name]):
                raise AssertionError(f"removing model check {name} refused for another reason: {exc}") from exc
            continue
        raise AssertionError(f"removing model check {name} was accepted")
    # Flagged fixtures on a channel without ingress are legitimate and pass;
    # the guard alone decides the flagless one.
    check(flagged_reply, announce=False)
    check(flagged_admit, announce=False)
    try:
        check(flagless_admit, announce=False)
    except AssertionError as exc:
        if "without authenticated flag" not in str(exc):
            raise AssertionError("flagless fixture refused for another reason") from exc
    else:
        raise AssertionError("flagless fixture accepted")
    check(flagless_admit, announce=False, disabled=frozenset({"guard"}))
    # Forbidden writes injected after each refusal class. Each must be caught.
    def forbidden_writes() -> dict[str, Any]:
        def pending(model: Registry) -> None:
            model.pending_phone["injected"] = {"candidate": {}, "authorizer": "", "revision": 0, "epoch": "", "phone_code_sha256": ""}
        def credential(model: Registry) -> None:
            model.active["injected"] = 0
        def approval(model: Registry) -> bool:
            for proposal in model.proposals.values():
                proposal["approved"] = not proposal["approved"]
                return True
            return False
        return {
            "revision": lambda m: setattr(m, "revision", m.revision + 1),
            "credential_sequence": lambda m: setattr(m, "sequence", m.sequence + 1),
            "last_external_revision": lambda m: setattr(m, "external_revision", m.external_revision + 1),
            "epoch": lambda m: setattr(m, "epoch", EPOCH_2 if m.epoch != EPOCH_2 else EPOCH_1),
            "recorded challenge": lambda m: m.challenges.__setitem__("injected", {"kind": "enrol", "candidate": {}, "revision": 0, "epoch": "", "proposed_epoch": None, "sequence": 0, "expired": False, "phone_code_sha256": None}),
            "used marker": lambda m: m.used_challenges.add("injected"),
            "pending phone operation": pending,
            "active credential": credential,
            "tombstone": lambda m: m.tombstones.add("injected"),
            "device binding": lambda m: setattr(m, "device_binding", "injected"),
            "site binding": lambda m: setattr(m, "site_binding", "injected"),
            "runtime device identity": lambda m: setattr(m, "config_device", "injected"),
            "new proposal": lambda m: m.proposals.__setitem__("injected", {"cutoff": 0, "epoch": m.epoch, "approved": False}),
            "proposal approval": approval,
        }
    refusal_classes = {
        "issue refusal": lambda op, verdict: op == "issue" and verdict != "issued",
        "presented challenge refusal (consumed)": lambda op, verdict: op in PRESENTED and (op, verdict) not in SUCCESS_FIELDS and verdict not in UNCONSUMED,
        "presented challenge refusal (unconsumed)": lambda op, verdict: op in PRESENTED and verdict in UNCONSUMED,
        "phone commit refusal": lambda op, verdict: op == "phone_commit" and verdict != "enrolled",
        "revocation refusal": lambda op, verdict: op == "revoke" and verdict != "revoked",
        "admission refusal": lambda op, verdict: op == "admit" and verdict != "approved",
        "open refusal": lambda op, verdict: op == "open" and verdict != "opened",
        "phone expiry refusal": lambda op, verdict: op == "expire_phone" and verdict != "expired",
    }
    # Each defence-in-depth item changed silently (no revision change) before
    # a phone commit must trip the invariant, naming that item.
    def silent(change: Any) -> type[Registry]:
        class Silent(Registry):
            def apply(self, operation: dict[str, Any]) -> str:
                pending = self.pending_phone.get(operation.get("challenge_id")) if operation["op"] == "phone_commit" else None
                if pending is not None and pending["revision"] == self.revision:
                    change(self, pending)
                return super().apply(operation)
        return Silent

    def activate(model: Registry, credential: str, approver: str, value: str) -> None:
        model.active[credential] = 0
        model.approvers[credential] = approver
        model.values[credential] = value

    def tombstone_value(model: Registry, pending: dict[str, Any]) -> None:
        model.values["silent"] = pending["candidate"]["value"]
        model.tombstones.add("silent")
    silent_changes = {
        "authorizer inactive": lambda m, p: m.active.pop(p["authorizer"], None),
        "approver tombstoned": lambda m, p: m.approver_tombstones.add(p["candidate"]["approver_id"]),
        "minted approver active": lambda m, p: activate(m, "silent", p["candidate"]["approver_id"], "silent"),
        "credential reused": lambda m, p: m.tombstones.add(p["candidate"]["credential"]),
        "value tombstoned": tombstone_value,
        "value active": lambda m, p: activate(m, "silent", "silent", p["candidate"]["value"]),
    }
    for item, change in silent_changes.items():
        try:
            check(corpus, announce=False, factory=silent(change))
        except AssertionError as exc:
            if "defence-in-depth" not in str(exc) or item not in str(exc):
                raise AssertionError(f"silent {item} refused for another reason: {exc}") from exc
        else:
            raise AssertionError(f"silent {item} was accepted")

    # The coverage requirements themselves: removing the steps they rely on
    # must be refused by the requirement, not merely pass unnoticed.
    def without(predicate: Any) -> dict[str, Any]:
        mutant = copy.deepcopy(corpus)
        for scenario in mutant["scenarios"]:
            scenario["steps"] = [x for x in scenario["steps"] if not predicate(scenario["name"], x)]
        return mutant
    dup = "duplicate_credential_and_value_refused"
    wa = "whatsapp_candidate_refused_at_issue"
    coverage_mutants = {
        "phone refused": lambda n, x: n == wa and x.get("challenge_id") == "other-phone-approver" and x["op"] == "phone_authorize",
        "phone accepted": lambda n, x: n == wa and x.get("challenge_id") == "own-phone-approver" and x["op"] in {"phone_authorize", "phone_commit"},
        "lan refused": lambda n, x: n == dup and x["expect"] == "authorizer_not_approver",
        "lan accepted": lambda n, x: (
            (n == dup and x.get("challenge_id") in {f"{dup}.7", "same-phone"})
            or (n == "approver_revocation_removes_all_credentials" and x.get("challenge_id") == "approver_revocation_removes_all_credentials.3")
        ) and x["op"] in {"enrol", "phone_authorize"},
        "revoked phone enrol": lambda n, x: n == wa and x["op"] == "enrol" and x["expect"] == "authorizer_unavailable",
        "revoked lan enrol": lambda n, x: n == dup and x["op"] == "enrol" and x["expect"] == "authorizer_unavailable",
        "revoked lan authorize": lambda n, x: n == dup and x["op"] == "phone_authorize" and x["expect"] == "authorizer_unavailable",
        "revoked phone authorize": lambda n, x: n == wa and x["op"] == "phone_authorize" and x["expect"] == "authorizer_unavailable",
    }
    coverage_count = [0]
    if coverage_of(corpus) != ({(path, outcome) for path in ("lan", "phone") for outcome in ("refused", "accepted")}, REVOKED_AUTHORIZER_CASES):
        raise AssertionError("coverage observation differs from the checked corpus")
    sms = "sms_ingress_unavailable"
    for label, predicate in {
        "sms issue refusal": lambda n, x: n == sms and x["op"] == "issue" and x["expect"] == "channel_unauthenticated",
        "sms unrecorded challenge": lambda n, x: n == sms and x["expect"] == "challenge_unavailable",
        "sms Tier C refusal": lambda n, x: n == sms and x["op"] == "admit" and x["expect"] == "ingress_unauthenticated",
        "ingress-removing restart": lambda n, x: n == sms and x["op"] == "restart",
        "held challenge invalidated": lambda n, x: n == sms and x.get("challenge_id") == "held-before-restart" and x["op"] == "phone_authorize",
        "pending operation invalidated": lambda n, x: n == sms and x.get("challenge_id") == "pending-before-restart" and x["op"] == "phone_commit",
        "used challenge unavailable": lambda n, x: n == sms and x.get("challenge_id") == f"{sms}.2" and x["expect"] == "challenge_unavailable",
        "sms approval before restart": lambda n, x: n == sms and x["op"] == "admit" and x.get("channel") == "sms" and x["expect"] == "approved",
        "LAN approval after restart": lambda n, x: n == sms and x["op"] == "admit" and "channel" not in x and x["expect"] == "approved",
    }.items():
        try:
            require_sms_ingress_refusal(without(predicate)["scenarios"])
        except AssertionError:
            coverage_count[0] += 1
            continue
        raise AssertionError(f"coverage mutant {label} was accepted")
    scenario_flag = copy.deepcopy(corpus)
    next(x for x in scenario_flag["scenarios"] if x["name"] == sms)["sms_ingress"] = False
    mutants.append(("scenario-level ingress member", scenario_flag))
    reused = copy.deepcopy(corpus)
    next(x for x in scenario_steps(reused, sms) if x.get("challenge_id") == f"{sms}.2" and x["expect"] == "challenge_unavailable")["expect"] = "challenge_reused"
    mutants.append(("used challenge reused after restart", reused))
    kept_ingress = copy.deepcopy(corpus)
    del next(x for x in scenario_steps(kept_ingress, sms) if x["op"] == "restart")["sms_ingress"]
    mutants.append(("restart without the ingress flag", kept_ingress))

    # Single-fault check for the steps the corpus flags authenticated on a
    # channel without ingress: with every other model check off the step is
    # still refused with its code, and with its deciding check off it is not.
    def verdict_at(name: str, index: int, off: frozenset[str]) -> str:
        model = Registry("locked")
        steps = scenario_steps(corpus, name)
        for x in steps[:index]:
            model.apply(x)
        model.disabled = off
        return model.apply(steps[index])
    # Agrees with the corpus proof field: an unauthenticated channel decides
    # alone only on a Tier C reply after a restart that removed SMS ingress; the WhatsApp
    # steps are two-fault by construction (the admit also fails reply lookup
    # by channel, the possession reply also fails the channel match).
    for name, predicate, deciding, single in (
        (sms, lambda x: x["op"] == "admit" and x["expect"] == "ingress_unauthenticated", "admit_phone_channel", True),
        (wa, lambda x: x["op"] == "admit" and x.get("channel") == "whatsapp", "admit_phone_channel", False),
        ("phone_candidate_rejects_wrong_code_and_sender",
         lambda x: isinstance(x.get("phone_reply"), dict) and x["phone_reply"]["channel"] == "whatsapp", "reply_auth_channel", False),
        ("phone_candidate_rejects_wrong_code_and_sender",
         lambda x: isinstance(x.get("phone_reply"), dict) and x["phone_reply"]["channel"] == "whatsapp", "reply_channel_mismatch", False),
    ):
        index = next(i for i, x in enumerate(scenario_steps(corpus, name)) if predicate(x))
        expect = scenario_steps(corpus, name)[index]["expect"]
        if verdict_at(name, index, frozenset(MODEL_CHECKS - {deciding})) != expect:
            raise AssertionError(f"{name} step {index} not refused by {deciding} alone")
        if verdict_at(name, index, frozenset(MODEL_CHECKS)) == expect:
            raise AssertionError(f"{name} step {index} refused with every check off")
        # Single fault: with the deciding check off the step is accepted.
        accepted = verdict_at(name, index, frozenset({deciding})) in {"approved", "enrolled"}
        if accepted is not single:
            raise AssertionError(f"{name} step {index} fault count changed")
    for label, predicate in coverage_mutants.items():
        try:
            require_coverage(*coverage_of(without(predicate)))
        except AssertionError as exc:
            if "coverage missing" not in str(exc):
                raise AssertionError(f"coverage mutant {label} refused for another reason: {exc}") from exc
        else:
            raise AssertionError(f"coverage mutant {label} was accepted")
    injections = 0
    for class_name, matches in refusal_classes.items():
        for write_name, write in forbidden_writes().items():
            applied = [0]

            class Injected(Registry):
                def apply(self, operation: dict[str, Any]) -> str:
                    verdict = super().apply(operation)
                    if matches(operation["op"], verdict) and write(self) is not False:
                        applied[0] += 1
                    return verdict
            try:
                check(corpus, announce=False, factory=Injected)
            except AssertionError:
                injections += 1
                continue
            if applied[0] == 0 and write_name == "proposal approval":
                continue  # no proposal existed at any refusal of this class
            raise AssertionError(f"forbidden {write_name} write at {class_name} was accepted")
    for name, mutant in mutants:
        try:
            check(mutant, announce=False)
        except AssertionError:
            continue
        raise AssertionError(f"{name} mutation was accepted")
    print(
        f"tier-c-approvers/v1: {len(mutants)} mutations refused, "
        f"{len(removals) + 1} model-check removals refused, "
        f"{injections} forbidden state writes refused, "
        f"{len(silent_changes)} silent recheck changes refused, "
        f"{len(coverage_mutants) + coverage_count[0]} coverage removals refused"
    )


if __name__ == "__main__":
    try:
        source = json.loads(CORPUS.read_text())
        check(source)
        if "--mutations" in sys.argv[1:]:
            mutations(source)
    except (AssertionError, KeyError, TypeError, ValueError) as exc:
        print(f"tier-c-approvers vectors failed: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
