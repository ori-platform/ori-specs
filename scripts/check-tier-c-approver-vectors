SITE = re.compile(r"[A-Za-z0-9._-]{1,64}\Z")
# "`device_id` matches `^[A-Za-z0-9._-]{1,128}$`, as runtime-config/v2 defines `device.id`"
DEVICE = re.compile(r"[A-Za-z0-9._-]{1,128}\Z")
PHONE = re.compile(r"\+[1-9][0-9]{1,14}\Z")
PHONE_CHANNELS = {"sms", "whatsapp"}
# "Authenticated channel" and "Limits and later versions": in v1 no WhatsApp
# ingress is authenticated, so at most SMS is a phone channel with an
# authenticated ingress, and only while the site's configuration gives it one.
# "The set of authenticated ingresses comes from the runtime's verified
# configuration and is fixed for a run; it changes only across a restart":
# a `restart` step may carry `sms_ingress`. A phone channel without an
# authenticated ingress is unauthenticated under every rule, whatever a
# fixture's `authenticated` flag (its authenticator verified the bytes) says:
# "Bytes the provider supplies never bind a channel, even when the
# authenticator covers them."
AUTHENTICATED_PHONE_CHANNELS = {"sms"}

