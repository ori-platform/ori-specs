"""Check the firmware-telemetry/v2 envelope corpus against the contracts.

Shares no code with scripts/generate-firmware-envelope-vectors-v2. Canonical
bytes come from this script's own serializer, the key is re-derived from the
disclosed seed and every signature verified with its own extended-coordinate
Ed25519 arithmetic, cofactorless with strict decoding. The versions, the nonce
grammar and the consumers' reasons with their order are read from "Reading
Envelope at `v` 2" in firmware-telemetry/v2.md; v1's verification steps, error
names, envelope and reading fields, the canonical number zone and the quality
bound are read from firmware-telemetry/v1.md. Nothing is read from the
generator.

Held to:

- each case: canonical bytes, digest, wire message and signature reproduce
  from its input, and the consumer model accepts it;
- each refusal: `signature_valid` matches this script's verification, refused
  for its declared reason by the first failing check in v1's order of steps
  and, within the sixth, in the order of the table, and breaking exactly that
  rule and no other;
- each precedence case: breaking exactly the two checks its bullet in v2.md
  names, refused for the earlier;
- coverage: every reason in the consumers' table, every accepted and refused
  case v2.md lists, every precedence bullet, the version and nonce-length
  bounds each at the edge and one past it;
- the seed is the one the signed corpora share, and the digest v2.md pins is
  the corpus's.

    python3 scripts/check-firmware-envelope-vectors-v2
    python3 scripts/check-firmware-envelope-vectors-v2 --mutations

`--mutations` corrupts the corpus, the contract text and this script's own
rule tables and constants in turn; every mutant must be refused.
"""

from __future__ import annotations

import base64
import copy
import hashlib
import importlib.machinery
import importlib.util
import types
import json
import math
import pathlib
import re
import sys
from typing import Callable


def _load_contract_markdown() -> types.ModuleType:
    """scripts/contract-markdown, by path: the repository holds no *.py file."""
    path = pathlib.Path(__file__).resolve().parent / "contract-markdown"
    loader = importlib.machinery.SourceFileLoader("contract_markdown", str(path))
    spec = importlib.util.spec_from_loader("contract_markdown", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["contract_markdown"] = module
    loader.exec_module(module)
    return module


markdown = _load_contract_markdown()

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "firmware-telemetry" / "envelope-vectors-v2.json"
