# Every sentence of an owned section is held, not only those carrying MUST,
# SHOULD, MAY, never, only or exactly: restrictions in these sections are also
# stated declaratively ("An envelope with no bound is still accepted"), and a
# keyword filter leaves those reversible. Any added, removed or changed sentence
# in an owned section fails until this table is updated in review.


def split_sections(text: str) -> list[tuple[str, str]]:
    """(heading path, own body) for every heading at any depth, by the shared
    CommonMark recognizer; fenced code is left out of each body."""
    return markdown.section_bodies(text)


def split_sentences(body: str) -> list[str]:
    blocks: list[list[str]] = []
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith(">"):
            stripped = stripped.lstrip(">").strip()
        if not stripped:
            blocks.append([])
            continue
        if stripped.startswith("|"):
            if not re.fullmatch(r"\|[\s|:-]+\|", stripped):
                blocks.append([stripped])
            blocks.append([])
            continue
        if re.match(r"(?:- |\d+\. )", stripped):
            blocks.append([re.sub(r"^(?:- |\d+\. )", "", stripped)])
            continue
        if not blocks:
            blocks.append([])
        blocks[-1].append(stripped)
    sentences = []
    for block in blocks:
        text = " ".join(block).strip()
        if text:
            sentences += [s for s in re.split(r"(?<=[.!?:;])\s+(?=[A-Z`*\[\"(])", text) if s]
    return sentences


def normative_sentences(text: str, owned: list[str]) -> dict[str, list[str]]:
    return {path: split_sentences(body) for path, body in split_sections(text) if path in owned}


def fenced_blocks(text: str, owned: list[str]) -> dict[str, list[str]]:
    """Each owned section's fenced code blocks, verbatim and in order. A fence is
    left out of the held sentences, yet an example can state a byte grammar (a
    field order, a bound), so it is held whole here."""
    lines = text.split("\n")
    fenced = markdown.fenced_lines(lines)
    out: dict[str, list[str]] = {}
    for path, start, end in markdown.sections(text):
        if path not in owned:
            continue
        blocks, current = [], []
        for index in range(start, end):
            if index in fenced:
                current.append(lines[index])
            elif current:
                blocks.append("\n".join(current))
                current = []
        if current:
            blocks.append("\n".join(current))
        out[path] = blocks
    return out


def check_normative(texts: dict[str, str], owner: str, held: dict) -> None:
    """Fail on any section unassigned, or any owned normative sentence changed."""
    for doc, table in SECTION_OWNERS.items():
        crooked = markdown.non_canonical(texts[doc])
        if crooked:
            raise Failure(f"non-canonical heading in {doc}: {crooked}")
        paths = [path for path, _ in split_sections(texts[doc])]
        if paths != [path for path, _ in table]:
            extra = [p for p in paths if p not in dict(table)]
            gone = [p for p, _ in table if p not in paths]
            raise Failure(f"normative sections of {doc} changed: unassigned {extra}, "
                          f"gone {gone}, or reordered")
        owned = [path for path, who in table if who == owner]
        found = normative_sentences(texts[doc], owned)
        fences = fenced_blocks(texts[doc], owned)
        for path in owned:
            if fences[path] != list(HELD_FENCES.get(doc, {}).get(path, ())):
                raise Failure(f"fenced example changed in {doc} {path}: a fence is held verbatim "
                              "here, since an example can state a grammar no sentence repeats")
            want, got = list(held[doc][path]), found[path]
            if got != want:
                added = [s for s in got if s not in want]
                removed = [s for s in want if s not in got]
                raise Failure(f"normative sentence changed in {doc} {path}: added {added}, "
                              f"removed {removed}" + ("" if added or removed else ", reordered"))


def section_region(raw: str, path: str) -> tuple[int, int]:
    """Where a section's own body lies in the raw text."""
    return markdown.section_offsets(raw, path)


def sentence_span(raw: str, path: str, sentence: str) -> tuple[int, int] | None:
    start, end = section_region(raw, path)
    hit = re.search(r"(?:\s|>)+".join(re.escape(w) for w in sentence.split()), raw[start:end])
    return None if hit is None else (start + hit.start(), start + hit.end())


POLARITY = (("MUST NOT", "MAY"), ("MUST", "MAY"), ("SHOULD", "MAY"), ("MAY", "MUST NOT"),
            ("is not decided", "is decided"), ("does not decide", "decides"),
            ("no other", "any other"), ("cannot", "can"), ("does not", "does"),
            ("never", "may"), ("Never", "Sometimes"), ("only", "also"), ("exactly", "about"),
            ("not", "also"), ("no", "some"))


def normative_text_mutants(texts: dict[str, str], owner: str, must: tuple[str, ...]
                           ) -> list[tuple[str, str, str]]:
    """(label, doc, mutated text): sampled deletions and reversals, the listed
    sentences among them, and one new MUST sentence per owned section."""
    out = []
    for doc, table in SECTION_OWNERS.items():
        owned = [path for path, who in table if who == owner]
        found = normative_sentences(texts[doc], owned)
        flat_list = [(p, s) for p in owned for s in found[p]]
        for index, (path, sentence) in enumerate(flat_list):
            if index % 5 and not any(m in sentence for m in must):
                continue
            span = sentence_span(texts[doc], path, sentence)
            if span is None:
                raise AssertionError(f"held sentence not found in {doc}: {sentence!r}")
            raw = texts[doc]
            out.append((f"normative deleted: {sentence[:60]}", doc,
                        raw[: span[0]] + raw[span[1]:]))
            segment = raw[span[0]:span[1]]
            for old, new in POLARITY:
                hit = re.search(rf"\b{re.escape(old)}\b", segment)
                if hit:
                    flipped = segment[: hit.start()] + new + segment[hit.end():]
                    break
            else:
                last = segment.rstrip(".;:").split()[-1]
                flipped = segment[: segment.rindex(last)] + "otherwise" + segment[
                    segment.rindex(last) + len(last):]
            out.append((f"normative reversed: {sentence[:60]}", doc,
                        raw[: span[0]] + flipped + raw[span[1]:]))
        for path, blocks in fenced_blocks(texts[doc], owned).items():
            for block in blocks:
                raw = texts[doc]
                at = raw.index(block, section_region(raw, path)[0])
                lines = block.split("\n")
                lines[min(1, len(lines) - 1)] += " x"
                out.append((f"fence edited in {doc} {path}", doc,
                            raw[:at] + "\n".join(lines) + raw[at + len(block):]))
        for path in owned:
            raw = texts[doc]
            at = section_region(raw, path)[0]
            out.append((f"normative added to {doc} {path}", doc,
                        raw[:at] + "\nEvery consumer MUST accept this added sentence.\n" + raw[at:]))
    return out


