def status_notes(record: dict) -> list[tuple[str, str]]:
    out = [("notes", record["notes"])] if "notes" in record else []
    for index, entry in enumerate(record.get("adoption", [])):
        if "notes" in entry:
            where = f"adoption[{index}] {entry['role']} {entry['repository']} notes"
            out.append((where, entry["notes"]))
    return out


def check_status_notes(raw: str) -> None:
    found = status_notes(json.loads(raw))
    if found != list(STATUS_NOTES):
        added = [n for n in found if n not in STATUS_NOTES]
        removed = [n for n in STATUS_NOTES if n not in found]
        raise Failure(f"status notes changed in status/firmware-telemetry/v2.json: added {added}, removed {removed}"
                      + ("" if added or removed else ", reordered"))


def contract_texts() -> dict[str, str]:
    return {"t1": TELEMETRY_V1.read_text(), "t2": TELEMETRY_V2.read_text()}


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = contract_texts() if texts is None else texts
    check_status_notes(texts.get("status") or STATUS.read_text())
    docs = {"commands": texts.get("c2") or COMMANDS_V2.read_text(), "telemetry": texts["t2"]}
    check_normative(docs, OWNER, HELD_SENTENCES)
    t1, t2 = texts["t1"], texts["t2"]
    env2 = section(t2, "## Reading Envelope at `v` 2")
    consumers = section(env2, "### Consumers")
    golden = section(t2, "## Golden Vectors")
    for sentence in V2_SENTENCES:
        need(env2, sentence, "firmware-telemetry/v2.md Reading Envelope at v 2")
    for clause, _ in GUARDS:
        need(env2, clause, "firmware-telemetry/v2.md Reading Envelope at v 2")
    for sentence in GOLDEN_SENTENCES:
        need(golden, sentence, "firmware-telemetry/v2.md Golden Vectors")

    rows = dict(_table(env2, "[a-z0-9_]+"))
    v_row = re.fullmatch(r"`int` \| The envelope's version: `(\d)` or `(\d)`\.", rows.get("v", ""))
    nonce_row = re.fullmatch(
        r"`string \\\| null` \| Required at `v` `(\d)` and forbidden at `v` `(\d)`\. Exactly "
        r"(\d+) characters, each one of `(.)`-`(.)` or `(.)`-`(.)`: .*", rows.get("liveness_nonce", ""))
    if v_row is None or nonce_row is None:
        raise Failure("the v and liveness_nonce rows of the envelope table changed")
    versions = (int(v_row.group(1)), int(v_row.group(2)))
    alphabet = "".join(chr(c) for lo, hi in ((nonce_row.group(4), nonce_row.group(5)),
                                             (nonce_row.group(6), nonce_row.group(7)))
                       for c in range(ord(lo), ord(hi) + 1))
    reasons = []
    for reason, cell in _table(consumers, "[a-z0-9_]+"):
        if cell not in WHEN_CELLS:
            raise Failure(f"consumers' table row {reason}: {cell!r} has no predicate here")
        reasons.append((reason, WHEN_CELLS[cell]))
    if sorted(r[1] for r in reasons) != sorted(WHEN_CELLS.values()):
        raise Failure("the consumers' table does not name every check exactly once")

    flow = section(t1, "## Consumer Verification Flow")
    steps = re.findall(r"^(\d)\. (.+?)(?=\n\d\. |\n\n)", flow, re.M | re.S)
    roles = []
    for number, words in steps:
        words = flat(words)
        if words not in V1_STEPS:
            raise Failure(f"v1 verification step {number} reads {words!r}")
        roles.append(V1_STEPS[words])
    if roles != list(V1_STEPS.values()):
        raise Failure(f"v1's verification steps are now {roles}")
    errors = {}
    for condition, name in re.findall(r"^\| (.+?) \| `([a-z0-9_]+)` \|\s*$",
                                      section(t1, "## Error Semantics"), re.M):
        if condition in V1_ERRORS:
            errors[V1_ERRORS[condition]] = name
    if sorted(errors) != sorted(V1_ERRORS.values()):
        raise Failure("v1's error table lost a condition this checker names")

    env_fields = [f for f, _ in _table(section(t1, "### Envelope Fields"), "[a-z0-9_]+")]
    reading_fields = [f for f, _ in _table(section(t1, "### Reading Fields"), "[a-z0-9_]+")]
    need(t1, "Additional reading fields are forbidden in v1.", "firmware-telemetry/v1.md")
    closed_sentence = re.search(r"\*\*The field set is closed at `v` `2`\.\*\* An envelope at "
                                r"`v` `2` has exactly these (\w+) keys and no other: (.+?)\. ",
                                flat(env2))
    if closed_sentence is None:
        raise Failure("v2.md no longer closes the field set at v 2 as this checker reads it")
    closed = re.findall(r"`([a-z0-9_]+)`", closed_sentence.group(2))
    words = {"eleven": 11, "twelve": 12, "ten": 10}
    if words.get(closed_sentence.group(1)) != len(closed) or len(set(closed)) != len(closed):
        raise Failure(f"the closed field set names {len(closed)} keys, not {closed_sentence.group(1)}")
    if sorted(closed) != sorted(env_fields + ["liveness_nonce"]):
        raise Failure("the eleven keys are not v1's envelope fields and liveness_nonce")
    quality = re.search(r"`(\d\.\d) <= quality <= (\d\.\d)`", section(t1, "### Reading Fields"))
    zone = flat(section(t1, "## Canonical JSON"))
    int_max = re.search(r"integers must satisfy `\|n\| <= (\d+)`", zone)
    float_zone = re.search(r"magnitude in `\[(\S+), (\S+)\)`", zone)
    if quality is None or int_max is None or float_zone is None:
        raise Failure("v1's quality bound or canonical number zone changed")
    need(zone, "object keys sorted lexicographically at every nesting level,", "v1 Canonical JSON")
    need(section(t1, "## Signature Encoding"), "Decoded signature length must be 64 bytes.",
         "v1 Signature Encoding")

    # The global order: v1's steps, the sixth expanded as the text states.
    order = [(errors["anchor"], "anchor"), ("alg (unnamed in v1)", "alg"),
             (errors["capability"], "capability"),
             (errors["signature_format"], "signature_format"), (errors["signature"], "signature")]
    order += reasons
    order += [("envelope field (unnamed in v1)", "envelope"), (errors["posture"], "posture"),
              (errors["channel"], "channel"), (errors["reading"], "reading")]

    golden_env = flat(golden[golden.index("[envelope-vectors-v2.json]"):
                             golden.index("[reading-age-vectors-v2.json]")])
    pin = re.search(r"Its SHA-256 is `([0-9a-f]{64})`", golden_env)
    if pin is None:
        raise Failure("v2.md pins no envelope corpus digest")
    bullets = [flat(b) for b in re.findall(r"^- (.+?)(?=\n- |\n\n)", golden[
        golden.index("[envelope-vectors-v2.json]"):golden.index("[reading-age-vectors-v2.json]")],
        re.M | re.S)]
    refusal_bullets = [b for b in bullets if not b.startswith(tuple(SECOND_RULES))]
    if refusal_bullets != list(REFUSAL_BULLETS):
        raise Failure(f"the envelope corpus's refusal list changed: {refusal_bullets}")
    precedence = []
    for bullet in bullets:
        match = re.fullmatch(r"(.+?), refused as `([a-z0-9_]+)`[;.]", bullet)
        if match and match.group(1) in SECOND_RULES:
            precedence.append((match.group(2), SECOND_RULES[match.group(1)]))
    if len(precedence) != len(SECOND_RULES):
        raise Failure("the envelope corpus's precedence list changed")
    return {
        "versions": versions,
        "nonce_required_at": int(nonce_row.group(1)),
        "nonce_forbidden_at": int(nonce_row.group(2)),
        "nonce_length": int(nonce_row.group(3)),
        "nonce_alphabet": alphabet,
        "order": order,
        "order_stated": list(order),
        "env_fields": env_fields,
        "closed_v2": closed,
        "reading_fields": reading_fields,
        "quality": (float(quality.group(1)), float(quality.group(2))),
        "int_max": int(int_max.group(1)),
        "float_lo": float(float_zone.group(1)),
        "float_hi": float(float_zone.group(2)),
        "sig_prefix": "ed25519:",
        "sig_length": 64,
        "precedence": precedence,
        "pin": pin.group(1),
    }


# --- consumer model ---------------------------------------------------------------------

def nonce_grammar(value: object, model: dict) -> bool:
    return value is None or (
        isinstance(value, str) and len(value) == model["nonce_length"]
        and all(ch in model["nonce_alphabet"] for ch in value))


def _number(value: object) -> bool:
    return type(value) in (int, float)


def broken(env: dict, wire: str, ctx: dict, public: bytes, model: dict) -> set[str]:
    """Every check this envelope fails, each judged on its own."""
    out = set()
    v = env.get("v")
    known_v = type(v) is int and v in model["versions"]
    if env.get("device_id") != ctx["device_id"]:
        out.add("anchor")
    if env.get("alg") != "ed25519":
        out.add("alg")
    if env.get("capability_hash") != ctx["capability_hash"]:
        out.add("capability")
    sig = None
    if wire.startswith(model["sig_prefix"]):
        body = wire[len(model["sig_prefix"]):]
        try:
            sig = base64.b64decode(body, validate=True)
        except ValueError:
            sig = None
        if sig is not None and (base64.b64encode(sig).decode() != body
                                or len(sig) != model["sig_length"]):
            sig = None
    if sig is None:
        out.add("signature_format")
    else:
        try:
            body_bytes = canonical(env, model).encode()
        except Failure:
            body_bytes = b""
        if not verify(public, body_bytes, sig):
            out.add("signature")
    if not known_v:
        out.add("version")
    has = "liveness_nonce" in env
    if v == model["nonce_forbidden_at"] and type(v) is int and has:
        out.add("nonce_at_v1")
    if v == model["nonce_required_at"] and type(v) is int and not has:
        out.add("nonce_missing")
    judged_at_v2 = v == model["nonce_required_at"] and type(v) is int
    if judged_at_v2 and has and not nonce_grammar(env["liveness_nonce"], model):
        out.add("nonce_invalid")
    # The field set is closed at v 2 only; v1 names no rule for an extra
    # envelope key, so only a missing or mistyped field is v1's refusal here.
    if judged_at_v2 and set(env) - set(model["closed_v2"]):
        out.add("unexpected")
    keys = set(env)
    types = {"alg": str, "device_id": str, "capability_hash": str, "posture": str,
             "readings": list}
    if set(model["env_fields"]) - keys or any(
            not isinstance(env[k], t) for k, t in types.items() if k in env) or any(
            type(env.get(k)) is not int or not 0 <= env[k] <= model["int_max"]
            for k in ("boot_id", "seq", "device_uptime_ms")) or not (
            env.get("emitted_at_ms") is None or type(env.get("emitted_at_ms")) is int):
        out.add("envelope")
    if env.get("posture") != ctx["posture"]:
        out.add("posture")
    channels = {c["channel"]: c for c in ctx["accepted_channels"]}
    for reading in env.get("readings") or []:
        if not isinstance(reading, dict) or set(reading) != set(model["reading_fields"]):
            out.add("reading")
            continue
        declared = channels.get(reading["channel"])
        if declared is None or (declared["sensor_type"], declared["unit"]) != (
                reading["sensor_type"], reading["unit"]):
            out.add("channel")
        value, quality = reading["value"], reading["quality"]
        if not _number(value) or not _number(quality):
            out.add("reading")
            continue
        try:
            canonical_number(value, model)
        except Failure:
            out.add("reading")
        if not model["quality"][0] <= quality <= model["quality"][1]:
            out.add("reading")
    return out


def judge(failed: set[str], model: dict, off: frozenset[str] = frozenset()) -> str | None:
    for reason, check in model["order"]:
        if check in failed and check not in off:
            return reason
    return None


# --- the corpus -------------------------------------------------------------------------

def check(corpus: dict, model: dict, off: frozenset[str] = frozenset(),
          fault_seed: str | None = None) -> dict:
    if fault_seed is None:
        fault_seed = json.loads(FAULT_CORPUS.read_bytes())["test_seed_hex"]
    if corpus["test_seed_hex"] != fault_seed:
        raise Failure("the seed is not the one the signed corpora share")
    public = public_from_seed(bytes.fromhex(corpus["test_seed_hex"]))
    ctx = corpus["verifier_context"]
    if corpus["public_key_hex"] != public.hex() or base64.b64decode(
            corpus["public_key_b64"], validate=True) != public or base64.b64decode(
            ctx["public_key_b64"], validate=True) != public:
        raise Failure("the public key does not derive from the seed")
    reason_of = {check: reason for reason, check in model["order"]}
    table = [r for r, c in model["order"] if c in WHEN_CELLS.values()]
    if sorted(corpus["reasons"]) != sorted(table + [reason_of["capability"], reason_of["signature"]]):
        raise Failure("the corpus's reasons are not the table's and v1's two it cites")
    if corpus["check_order"] != [r for r, c in model["order_stated"]
                                 if r in corpus["reasons"]]:
        raise Failure("the corpus's check_order differs from the text's")
    position = {reason: i for i, (reason, _) in enumerate(model["order"])}

    names: set[str] = set()
    for key in ("cases", "reject_cases", "precedence_cases"):
        for case in corpus[key]:
            if case["name"] in names:
                raise Failure(f"duplicate case {case['name']}")
            names.add(case["name"])

    def common(case: dict) -> tuple[set[str], bool]:
        label, env = case["name"], case["input"]
        body = canonical(env, model).encode()
        if bytes.fromhex(case["canonical_hex"]) != body:
            raise Failure(f"{label}: canonical bytes")
        if case["canonical_sha256_hex"] != hashlib.sha256(body).hexdigest():
            raise Failure(f"{label}: digest")
        wire = canonical({"envelope": env, "signature": case["signature"]}, model).encode()
        if bytes.fromhex(case["message_hex"]) != wire:
            raise Failure(f"{label}: wire message")
        parsed = json.loads(wire)
        if parsed["envelope"] != env:
            raise Failure(f"{label}: the wire message does not carry the input")
        failed = broken(env, case["signature"], ctx, public, model)
        return failed, "signature" not in failed and "signature_format" not in failed

    facts: dict[str, list[str]] = {}

    def note(item: str, name: str) -> None:
        facts.setdefault(item, []).append(name)

    for case in corpus["cases"]:
        failed, _ = common(case)
        verdict = judge(failed, model, off)
        if verdict is not None:
            raise Failure(f"{case['name']}: refused ({verdict})")
        env = case["input"]
        # A JSON boolean is not an integer; Python's True == 1 must not say otherwise.
        readings, v = env["readings"], env["v"] if type(env["v"]) is int else None
        nonce = env.get("liveness_nonce")
        if v == 2:
            if readings and nonce is not None:
                note("v2_reading_nonce", case["name"])
            if readings and nonce is None:
                note("v2_reading_null", case["name"])
            if len(readings) >= 2:
                note("v2_two_readings", case["name"])
            if not readings and nonce is not None:
                note("v2_heartbeat_nonce", case["name"])
            if not readings and nonce is None:
                note("v2_heartbeat_null", case["name"])
            if nonce == "0" * model["nonce_length"]:
                note("v2_zero_nonce", case["name"])
        if v == 1:
            note("v1_reading" if readings else "v1_heartbeat", case["name"])
        if type(v) is int:
            note(f"accepted v={v}", case["name"])
        if isinstance(nonce, str):
            note(f"accepted nonce length {len(nonce)}", case["name"])

    for case in corpus["reject_cases"]:
        failed, valid = common(case)
        if case["signature_valid"] is not valid or not valid:
            raise Failure(f"{case['name']}: a refusal here carries a valid signature")
        verdict = judge(failed, model, off)
        if verdict != case["reason"]:
            raise Failure(f"{case['name']}: refused for {verdict}, not {case['reason']}")
        if {reason_of[c] for c in failed} != {case["reason"]}:
            raise Failure(f"{case['name']}: breaks {sorted(failed)}, not exactly {case['reason']}")
        env = case["input"]
        nonce = env.get("liveness_nonce", ...)
        raw_v = env["v"]
        v = raw_v if type(raw_v) is int else None
        if v == 2 and nonce is ...:
            note("missing", case["name"])
        if v == 1 and isinstance(nonce, str):
            note("at_v1_populated", case["name"])
        if v == 1 and nonce is None:
            note("at_v1_null", case["name"])
        if v == 2 and isinstance(nonce, str):
            n = model["nonce_length"]
            if nonce == "":
                note("empty", case["name"])
            elif len(nonce) == n - 1:
                note("short", case["name"])
            elif len(nonce) == n + 1:
                note("long", case["name"])
            elif len(nonce) == n and nonce != nonce.lower() and nonce_grammar(nonce.lower(), model):
                note("upper", case["name"])
            elif len(nonce) == n and nonce == nonce.lower() and not nonce_grammar(nonce, model):
                note("non_hex", case["name"])
        if v == 2 and type(nonce) is int:
            note("integer", case["name"])
        if v == 2 and type(nonce) is bool:
            note("boolean", case["name"])
        if v == 2 and set(env) - set(model["closed_v2"]):
            note("extra_key", case["name"])
        if case["reason"] == reason_of["version"]:
            note(f"v={json.dumps(raw_v)}", case["name"])
        note(f"reason {case['reason']}", case["name"])

    for case in corpus["precedence_cases"]:
        failed, valid = common(case)
        if case["signature_valid"] is not valid:
            raise Failure(f"{case['name']}: signature_valid says {case['signature_valid']}")
        verdict = judge(failed, model, off)
        if verdict != case["reason"]:
            raise Failure(f"{case['name']}: refused for {verdict}, not {case['reason']}")
        pair = next(((r, s) for r, s in model["precedence"] if r == case["reason"]
                     and {reason_of[c] for c in failed} == {r, reason_of[s]}), None)
        if pair is None:
            raise Failure(f"{case['name']}: breaks {sorted(failed)}, which no precedence bullet names")
        if position[pair[0]] >= position[reason_of[pair[1]]]:
            raise Failure(f"{case['name']}: {pair[0]} is not before {reason_of[pair[1]]}")
        note(f"precedence {pair[0]} {pair[1]}", case["name"])
        note(f"reason {case['reason']}", case["name"])

    for reason in table:
        if f"reason {reason}" not in facts:
            raise Failure(f"coverage: no refusal for {reason}")
    for reason, second in model["precedence"]:
        if f"precedence {reason} {second}" not in facts:
            raise Failure(f"coverage: no precedence case {reason} before {second}")
    for item in ACCEPTED_ITEMS:
        if item not in facts:
            raise Failure(f"coverage: no accepted case for {item}")
    for group in REFUSAL_BULLETS.values():
        for item in group:
            if item not in facts:
                raise Failure(f"coverage: no refusal for {item}")
    lo, hi = model["versions"]
    n = model["nonce_length"]
    for edge in (f"accepted v={lo}", f"accepted v={hi}", f"v={lo - 1}", f"v={hi + 1}",
                 f"accepted nonce length {n}", "short", "long"):
        if edge not in facts:
            raise Failure(f"coverage: bound edge {edge} has no case")
    return facts


def run(corpus_bytes: bytes, model: dict, off: frozenset[str] = frozenset()) -> dict:
    if hashlib.sha256(corpus_bytes).hexdigest() != model["pin"]:
        raise Failure("corpus digest differs from the one firmware-telemetry/v2.md pins")
    return check(json.loads(corpus_bytes), model, off)


# --- mutations ------------------------------------------------------------------------------

def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check(mutated, model)
        return go

    def model_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            run(corpus_bytes, mutated)
        return go

    def text_mutant(key: str, old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            if old not in texts[key]:
                raise AssertionError(f"mutant target missing from {key}: {old!r}")
            texts[key] = texts[key].replace(old, new, 1)
            run(corpus_bytes, contract_model(texts))
        return go

    def find(name: str) -> Callable[[dict], dict]:
        def get(c: dict) -> dict:
            return next(x for k in ("cases", "reject_cases", "precedence_cases")
                        for x in c[k] if x["name"] == name)
        return get

    def drop(name: str) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            for key in ("cases", "reject_cases", "precedence_cases"):
                c[key] = [x for x in c[key] if x["name"] != name]
        return edit

    def flip(name: str) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            case = find(name)(c)
            raw = bytearray(base64.b64decode(case["signature"][8:]))
            raw[3] ^= 0x10
            case["signature"] = "ed25519:" + base64.b64encode(bytes(raw)).decode()
            case["message_hex"] = canonical(
                {"envelope": case["input"], "signature": case["signature"]}, model).encode().hex()
        return edit

    def check_off(name: str) -> Callable[[], None]:
        def go() -> None:
            run(corpus_bytes, model, frozenset({name}))
        return go

    def relocate(check: str, beside: str, after: bool) -> Callable[[dict], None]:
        """Move one check to just after (or before) another in the order."""
        def edit(m: dict) -> None:
            entry = next(e for e in m["order"] if e[1] == check)
            m["order"].remove(entry)
            at = next(i for i, e in enumerate(m["order"]) if e[1] == beside)
            m["order"].insert(at + 1 if after else at, entry)
        return edit

    cases: list[tuple[str, Callable[[], None]]] = [
        ("accepted signature bit flipped", corpus_mutant(flip("v2_reading_with_nonce"))),
        ("refusal signature bit flipped", corpus_mutant(flip("reject_v2_nonce_boolean"))),
        ("nonce edited after signing", corpus_mutant(
            lambda c: find("v2_reading_with_nonce")(c)["input"].update(liveness_nonce="1" * 32))),
        ("refusal relabelled", corpus_mutant(
            lambda c: find("reject_v2_nonce_integer")(c).update(reason="liveness_nonce_missing"))),
        ("precedence relabelled to the later check", corpus_mutant(
            lambda c: find("reject_capability_hash_before_nonce")(c).update(
                reason="invalid_liveness_nonce"))),
        ("signature_valid misstated", corpus_mutant(
            lambda c: find("reject_signature_before_nonce")(c).update(signature_valid=True))),
        ("refusal moved to cases", corpus_mutant(
            lambda c: c["cases"].append(dict(find("reject_v1_with_nonce")(c), name="moved")))),
        ("seed swapped", corpus_mutant(lambda c: c.update(test_seed_hex="43" * 32))),
        ("context names another channel unit", corpus_mutant(
            lambda c: c["verifier_context"]["accepted_channels"][1].update(unit="ampere"))),
        ("context posture changed", corpus_mutant(
            lambda c: c["verifier_context"].update(posture="development"))),
        ("check_order rewritten", corpus_mutant(lambda c: c["check_order"].reverse())),
        ("corpus digest pin wrong", model_mutant(lambda m: m.update(pin="0" * 64))),
        ("nonce one character shorter", model_mutant(
            lambda m: m.update(nonce_length=m["nonce_length"] - 1))),
        ("nonce one character longer", model_mutant(
            lambda m: m.update(nonce_length=m["nonce_length"] + 1))),
        ("nonce alphabet admits uppercase", model_mutant(
            lambda m: m.update(nonce_alphabet=m["nonce_alphabet"] + "ABCDEF"))),
        ("nonce alphabet admits g", model_mutant(
            lambda m: m.update(nonce_alphabet=m["nonce_alphabet"] + "g"))),
        ("v 3 admitted", model_mutant(lambda m: m.update(versions=(1, 2, 3)))),
        ("v 0 admitted", model_mutant(lambda m: m.update(versions=(0, 1, 2)))),
        ("nonce required at v 1", model_mutant(lambda m: m.update(nonce_required_at=1))),
        ("nonce forbidden at v 2", model_mutant(lambda m: m.update(nonce_forbidden_at=2))),
        ("quality ceiling lowered", model_mutant(lambda m: m.update(quality=(0.0, 0.99)))),
        ("canonical zone narrowed", model_mutant(lambda m: m.update(float_hi=100.0))),
        ("reading fields widened", model_mutant(
            lambda m: m["reading_fields"].append("unit_scale"))),
        ("signature length", model_mutant(lambda m: m.update(sig_length=32))),
        ("precedence bullet retargeted", model_mutant(
            lambda m: m["precedence"].__setitem__(3, (m["precedence"][3][0], "posture")))),
        ("text: nonce length", text_mutant(
            "t2", "Exactly 32 characters, each one of `0`-`9` or `a`-`f`: the `nonce`",
            "Exactly 33 characters, each one of `0`-`9` or `a`-`f`: the `nonce`")),
        ("text: versions", text_mutant("t2", "The envelope's version: `1` or `2`.",
                                       "The envelope's version: `1` or `3`.")),
        ("text: reason renamed", text_mutant("t2", "| `liveness_nonce_missing` |",
                                             "| `nonce_missing` |")),
        ("text: version row dropped", text_mutant(
            "t2", "| `unsupported_version` | The envelope's `v` is not the integer `1` or `2`. |\n",
            "")),
        ("text: checks after the signature moved before it", text_mutant(
            "t2", "after the signature verifies. They are made first in that",
            "before the signature verifies. They are made first in that")),
        ("text: v1 step order changed", text_mutant(
            "t1", "4. Reject telemetry whose `capability_hash` does not match the accepted\n"
                  "   manifest hash.\n5. Canonicalize `envelope` and verify `signature` against "
                  "the anchored public\n   key.",
            "4. Canonicalize `envelope` and verify `signature` against the anchored public\n   key.\n"
            "5. Reject telemetry whose `capability_hash` does not match the accepted\n   manifest hash.")),
        ("text: v1 error renamed", text_mutant(
            "t1", "| manifest hash mismatch | `capability_hash_mismatch` |",
            "| manifest hash mismatch | `manifest_mismatch` |")),
        ("text: canonical zone", text_mutant("t1", "magnitude in `[1e-4, 1e16)`",
                                             "magnitude in `[1e-4, 1e2)`")),
        ("text: refusal bullet dropped", text_mutant(
            "t2", "- the versions `0` and `3`, the string `\"2\"`, and `true`;\n", "")),
        ("text: precedence bullet reworded", text_mutant(
            "t2", "- a missing nonce with a channel the context does not accept, refused "
                  "as\n  `liveness_nonce_missing`;",
            "- a missing nonce with a wrong posture, refused as\n  `liveness_nonce_missing`;")),
        ("text: corpus digest", text_mutant(
            "t2", "`dff9e940de06bdb1dda12ec19c3f66679b39b4a1f4d7565d9a985e9282558d7f`",
            "`" + "0" * 64 + "`")),
        ("capability check after the nonce checks", model_mutant(
            relocate("capability", "nonce_invalid", after=True))),
        ("signature check after the nonce checks", model_mutant(
            relocate("signature", "nonce_invalid", after=True))),
        ("version check after the nonce checks", model_mutant(
            relocate("version", "nonce_invalid", after=True))),
        ("channel check before the nonce checks", model_mutant(
            relocate("channel", "nonce_at_v1", after=False))),
        ("v 1 nonce check after the channel check", model_mutant(
            relocate("nonce_at_v1", "channel", after=True))),
        ("field-set check before the nonce checks", model_mutant(
            relocate("unexpected", "nonce_at_v1", after=False))),
        ("field-set check after the channel check", model_mutant(
            relocate("unexpected", "channel", after=True))),
        ("closed set loses emitted_at_ms", model_mutant(
            lambda m: m["closed_v2"].remove("emitted_at_ms"))),
        ("closed set admits the corpus's extra key", model_mutant(
            lambda m: m["closed_v2"].append("emitted_at_source"))),
        ("text: closed set count", text_mutant("t2", "exactly\nthese eleven keys", "exactly\nthese ten keys")),
        ("text: field-set row dropped", text_mutant(
            "t2", "| `unexpected_field` | `v` is `2` and the envelope has a key outside the eleven above. |\n",
            "")),
    ]
    def normative_mutant(doc: str, mutated: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts[{'telemetry': 't2'}[doc]] = mutated
            run(corpus_bytes, contract_model(texts))
        return go

    def status_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            record = json.loads(STATUS.read_text())
            edit(record)
            texts = contract_texts()
            texts["status"] = json.dumps(record, indent=2)
            run(corpus_bytes, contract_model(texts))
        return go

    def reword(old: str, new: str) -> Callable[[dict], None]:
        def edit(record: dict) -> None:
            for entry in [record, *record.get("adoption", [])]:
                if old in entry.get("notes", ""):
                    entry["notes"] = entry["notes"].replace(old, new, 1)
                    return
            raise AssertionError(f"status note phrase missing: {old!r}")
        return edit

    for label, old, new in (
        ('status: implementation claimed',
         'no producer signs envelope v 2 yet.',
         'the edge firmware signs envelope v 2.'),
        ('status: proof claimed',
         'That is implementation, not end-to-end or HIL proof.',
         'That is end-to-end and HIL proof.'),
        ('status: runtime adoption claimed',
         'the bound is computed only while liveness v 2 publication is on, which it is not by default.',
         'the bound is computed for every device.'),
        ('status: producer adoption claimed',
         'It signs every envelope at v 1 and signs no liveness_nonce.',
         'It signs every envelope at v 2 with its liveness_nonce.'),
    ):
        cases.append((label, status_mutant(reword(old, new))))
    cases.append(("status: top-level note deleted", status_mutant(lambda r: r.pop("notes"))))
    for index in range(len(json.loads(STATUS.read_text())["adoption"])):
        cases.append((f"status: adoption[{index}] note deleted", status_mutant(
            lambda r, i=index: r["adoption"][i].pop("notes"))))
    cases.append(("status: a note added", status_mutant(lambda r: r["adoption"].append(
        dict(r["adoption"][0], notes="The edge firmware implements this version.")))))

    def heading_mutant(doc: str, mutated: str) -> Callable[[], None]:
        return normative_mutant(doc, mutated)

    docs_now = {"commands": contract_texts().get("c2") or COMMANDS_V2.read_text(),
                "telemetry": contract_texts().get("t2") or TELEMETRY_V2.read_text()}
    own_doc = next(doc for doc, table in SECTION_OWNERS.items()
                   if any(who == OWNER for _, who in table))
    places = {
        "owned": next(path for path, who in SECTION_OWNERS[own_doc] if who == OWNER),
        "unowned": next(path for path, who in SECTION_OWNERS[own_doc] if who is None),
    }
    for where, path in places.items():
        at = markdown.section_offsets(docs_now[own_doc], path)[0]
        for form_name, form in markdown.HEADING_FORMS:
            mutated = (docs_now[own_doc][:at] + markdown.form_insertion(form)
                       + docs_now[own_doc][at:])
            cases.append((f"heading form in an {where} section: {form_name}",
                          heading_mutant(own_doc, mutated)))

    current = contract_texts()
    for label, doc, mutated in normative_text_mutants(
            {"commands": current.get("c2") or COMMANDS_V2.read_text(),
              "telemetry": current.get("t2") or TELEMETRY_V2.read_text()}, OWNER, MUTATE_ALWAYS):
        cases.append((label, normative_mutant(doc, mutated)))

    def guard_mutant(clause: str, flip: tuple[str, str] | None) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts["t2"] = guard_text(texts["t2"], clause, flip)
            run(corpus_bytes, contract_model(texts))
        return go

    for clause, flips in GUARDS:
        short = clause[:48]
        cases.append((f"guard deleted: {short}", guard_mutant(clause, None)))
        for polarity in flips:
            cases.append((f"guard reversed ({polarity[0]} -> {polarity[1]}): {short}",
                          guard_mutant(clause, polarity)))
    for _, check_name in model["order"]:
        cases.append((f"check off: {check_name}", check_off(check_name)))
    for key in ("cases", "reject_cases", "precedence_cases"):
        for case in base[key]:
            cases.append((f"case {case['name']} dropped", corpus_mutant(drop(case["name"]))))
    # Checks no case of this corpus can reach: each case is otherwise valid
    # under v1, and v2.md lists no refusal for these.
    equivalent_reasons = {
        "check off: anchor": "every case names the context's device",
        "check off: alg": "every case carries alg ed25519",
        "check off: signature_format": "every case's signature field is well formed",
        "check off: envelope": "every case carries v1's envelope fields with their types",
        "check off: posture": "every case claims the context's posture",
        "check off: reading": "every reading is valid under v1",
        "check off: channel": "v2.md lists no refusal for an unaccepted channel alone; it "
                              "appears only as the later check of three precedence cases",
        "version check after the nonce checks":
            "every nonce check applies only at v 1 or v 2, and the field-set check only at "
            "v 2, where the version check passes, so the version check never fails beside "
            "them and their order decides no envelope",
        "case v2_reading_with_nonce dropped": "v2_two_readings and v2_all_zero_nonce are v 2 "
                                              "readings carrying a nonce too",
    }
    equivalent = [(label, m) for label, m in cases if label in equivalent_reasons]
    cases = [(label, m) for label, m in cases if label not in equivalent_reasons]
    survived = 0
    for label, mutant in cases + equivalent:
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError, IndexError) as refused:
            if label in equivalent_reasons:
                print(f"REFUSED (listed as equivalent) {label}: {refused}")
                survived += 1
            else:
                print(f"refused  {label}: {refused}")
        else:
            if label in equivalent_reasons:
                print(f"EQUIVALENT {label}: {equivalent_reasons[label]}")
            else:
                print(f"SURVIVED {label}")
                survived += 1
    # Heading-shaped lines that are not headings must change nothing.
    for where, path in places.items():
        at = markdown.section_offsets(docs_now[own_doc], path)[0]
        before = markdown.sections(docs_now[own_doc])
        for form_name, inserted in markdown.NOT_HEADINGS:
            mutated = docs_now[own_doc][:at] + "\n" + inserted + docs_now[own_doc][at:]
            shifted = [p for p, _, _ in markdown.sections(mutated)]
            wrong = shifted != [p for p, _, _ in before] or markdown.non_canonical(mutated)
            if not wrong and "fence" in form_name:
                # The inserted fence is itself a held-fence change, refused by its own
                # mutants; this probe asks only whether a heading inside a fence is read
                # as a section or a sentence, so the fence is held for its duration.
                saved = {doc: dict(paths) for doc, paths in HELD_FENCES.items()}
                owned_paths = [p for p, who in SECTION_OWNERS[own_doc] if who == OWNER]
                HELD_FENCES.setdefault(own_doc, {}).update(
                    {p: tuple(b) for p, b in fenced_blocks(mutated, owned_paths).items() if b})
                try:
                    normative_mutant(own_doc, mutated)()
                except Failure as refused:
                    wrong = str(refused)
                finally:
                    HELD_FENCES.clear()
                    HELD_FENCES.update(saved)
            if wrong:
                print(f"WRONGLY REFUSED not a heading, in an {where} section: {form_name}: {wrong}")
                survived += 1
            else:
                print(f"accepted not a heading, in an {where} section: {form_name}")
    print(f"{len(cases)} mutants, {len(equivalent)} known equivalent")
    return survived


def main(argv: list[str]) -> int:
    try:
        model = contract_model()
    except (Failure, ValueError) as failure:
        print(f"firmware-telemetry/v2 envelope contract: {failure}")
        return 1
    corpus_bytes = CORPUS.read_bytes()
    try:
        run(corpus_bytes, model)
    except (Failure, KeyError, TypeError, ValueError) as failure:
        print(f"firmware-telemetry/v2 envelope corpus: {failure!r}")
        return 1
    corpus = json.loads(corpus_bytes)
    print(
        f"firmware-telemetry/v2 envelope corpus: {len(corpus['cases'])} cases accepted, "
        f"{len(corpus['reject_cases'])} refusals each for exactly its reason, "
        f"{len(corpus['precedence_cases'])} precedence cases refused for the earlier check"
    )
    print(f"{len(STATUS_NOTES)} status notes held, unchanged, in {STATUS.relative_to(ROOT)}")
    held = [s for doc in HELD_SENTENCES.values() for body in doc.values() for s in body]
    owned = sum(len(doc) for doc in HELD_SENTENCES.values())
    print(f"{len(held)} sentences held, unchanged, in the {owned} sections this checker owns")
    if argv == ["--mutations"]:
        survived = mutations(corpus_bytes, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    elif argv:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
