COMMANDS_V2 = ROOT / "firmware-commands" / "v2.md"


class Failure(Exception):
    pass


# --- Ed25519, extended coordinates, verification only -------------------------

FIELD = 2**255 - 19
GROUP = 2**252 + 27742317777372353535851937790883648493
EDWARDS_D = -121665 * pow(121666, FIELD - 2, FIELD) % FIELD
I_ROOT = pow(2, (FIELD - 1) // 4, FIELD)


def _xrecover(y: int, sign: int) -> int | None:
    if y >= FIELD:
        return None
    xx = (y * y - 1) * pow(EDWARDS_D * y * y + 1, FIELD - 2, FIELD) % FIELD
    if xx == 0:
        return None if sign else 0
    x = pow(xx, (FIELD + 3) // 8, FIELD)
    if (x * x - xx) % FIELD:
        x = x * I_ROOT % FIELD
    if (x * x - xx) % FIELD:
        return None
    return FIELD - x if x & 1 != sign else x


def _add(p: tuple, q: tuple) -> tuple:
    a = (p[1] - p[0]) * (q[1] - q[0]) % FIELD
    b = (p[1] + p[0]) * (q[1] + q[0]) % FIELD
    c = 2 * p[3] * q[3] * EDWARDS_D % FIELD
    d = 2 * p[2] * q[2] % FIELD
    e, f, g, h = b - a, d - c, d + c, b + a
    return (e * f % FIELD, g * h % FIELD, f * g % FIELD, e * h % FIELD)


def _times(k: int, p: tuple) -> tuple:
    out = (0, 1, 1, 0)
    while k:
        if k & 1:
            out = _add(out, p)
        p = _add(p, p)
        k >>= 1
    return out


def _compress(p: tuple) -> bytes:
    zi = pow(p[2], FIELD - 2, FIELD)
    x, y = p[0] * zi % FIELD, p[1] * zi % FIELD
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def _decompress(raw: bytes) -> tuple | None:
    if len(raw) != 32:
        return None
    n = int.from_bytes(raw, "little")
    y = n & ((1 << 255) - 1)
    x = _xrecover(y, n >> 255)
    if x is None:
        return None
    p = (x, y, 1, x * y % FIELD)
    return p if _compress(p) == raw else None


_BY = 4 * pow(5, FIELD - 2, FIELD) % FIELD
_BX = _xrecover(_BY, 0)
assert _BX is not None
BASEPOINT = (_BX, _BY, 1, _BX * _BY % FIELD)


def public_from_seed(seed: bytes) -> bytes:
    h = hashlib.sha512(seed).digest()
    scalar = (int.from_bytes(h[:32], "little") & ((1 << 254) - 8)) | (1 << 254)
    return _compress(_times(scalar, BASEPOINT))


_MEMO: dict[tuple[bytes, bytes, bytes], bool] = {}


def verify(public: bytes, message: bytes, signature: bytes) -> bool:
    key = (public, message, signature)
    if key not in _MEMO:
        _MEMO[key] = _strict_verify(public, message, signature)
    return _MEMO[key]


def _strict_verify(public: bytes, message: bytes, signature: bytes) -> bool:
    if len(signature) != 64:
        return False
    a, r = _decompress(public), _decompress(signature[:32])
    s = int.from_bytes(signature[32:], "little")
    if a is None or r is None or s >= GROUP:
        return False
    k = int.from_bytes(hashlib.sha512(signature[:32] + public + message).digest(), "little")
    minus_a = ((FIELD - a[0]) % FIELD, a[1], 1, (FIELD - a[3]) % FIELD)
    return _compress(_add(_times(s, BASEPOINT), _times(k % GROUP, minus_a))) == signature[:32]


# --- canonical JSON (v1 Canonical JSON) ---------------------------------------------

def canonical_number(value: float | int, model: dict) -> str:
    if type(value) is int:
        if abs(value) > model["int_max"]:
            raise Failure(f"integer {value} outside the canonical zone")
        return str(value)
    if not math.isfinite(value) or not (value == 0 or model["float_lo"] <= abs(value) < model["float_hi"]):
        raise Failure(f"number {value!r} outside the canonical zone")
    text = repr(value)
    if "e" in text or "E" in text or "." not in text:
        raise Failure(f"number {value!r} has no fixed-notation shortest form")
    return text


def canonical(value: object, model: dict) -> str:
    if isinstance(value, dict):
        return "{" + ",".join(
            json.dumps(k, ensure_ascii=False) + ":" + canonical(value[k], model)
            for k in sorted(value)) + "}"
    if isinstance(value, list):
        return "[" + ",".join(canonical(v, model) for v in value) + "]"
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, (int, float)):
        return canonical_number(value, model)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    raise Failure(f"no canonical form for {value!r}")


# --- contract text -------------------------------------------------------------------

def flat(text: str) -> str:
    return " ".join(text.split())


def section(text: str, heading: str) -> str:
    """A heading's text and its subsections, by the shared CommonMark recognizer."""
    return markdown.subtree(text, heading)


def need(text: str, sentence: str, where: str) -> None:
    if sentence not in flat(text):
        raise Failure(f"{where} no longer says: {sentence!r}")


