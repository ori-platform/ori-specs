# The v1 contracts keep their published approval semantics word for word, and carry nothing v2 introduced.
V1_KEPT = {
    "events-v1": (
        "For C: `true` only for affirmative token; otherwise `false`.",
        "`approved=true`: operator affirmative token.",
        "`approved=false`: explicit NO, timeout/no response, or unrecognized reply.",
    ),
    "offline-tokens-v1": ("| `action_scope` | `string` | Yes | Action name or `*` |",
                          "`action_scope` matches requested action or wildcard"),
}
V2_TERMS = {
    "events-v1": ("approval_admitted", "durably admitted", "decision_state", "dispatch_not_proven",
                  "dispatch_outcome_unknown", "reconciled_", "proposal_aborted_restart", "approval_binding_changed",
                  "approval_expired_undispatched", "approval_aborted_undispatched", "proposal_blocked_uncertain_outcome",
                  "operator_reply",
                  "approved_action_outcome", "safe_default_outcome"),
    "offline-tokens-v1": ("proposal_id", "zone_id", "`target`", "token_version", "monotonic",
                          "does not authorize Tier C", "one transaction"),
}
# gateway-api/v1 keeps its shipped Tier C semantics: none of the vocabulary tier-c-approval/v1 defines enters it.
GATEWAY_FORBIDDEN = ("decision_state", "expires_at_ms", "approval_admitted", "dispatch_not_proven",
                     "dispatch_outcome_unknown", "proposal_aborted_restart", "approved_pending_dispatch",
                     "reconcile-tier-c", "Tier C Approval Admission", "proposal_blocked_uncertain_outcome")
OPERATIONAL_CODES = {"runtime_unavailable", "runtime_store_unavailable", "state_store_locked", "cancelled"}
V1_GUARD_LIMIT = (
    "this guard proves only that the published v1 prose was not edited and that proposed v2 vocabulary did not "
    "enter v1; it does not prove wire compatibility or consumer behavior, and a data vector and independent v1/v2 "
    "consumer checks are mandatory before events/v2 ratification or implementation"
)
STATE_RULE = re.compile(r"`decision_state` is one of ((?:`\w+`(?:, and |, | and )?)+)\.")
RECORDS_RULE = re.compile(r"as `\{(pending, outcome_unknown, dispatch_unproven, lost, [\w, ]+)\}`")
TIMEOUT_MIN = re.compile(r"`approval_timeout_seconds` MUST be at least (\d+) and no greater than")
REASON_RULE = re.compile(r"`--reason` is one of ((?:`\w+`(?:, and |, | and )?)+)\.")
ORDER_RULE = re.compile(r"Checks run in this order, and the first that fails is the answer: ((?:`\w+`(?:, and |, | and )?)+)\.")
NOTE_RULE = re.compile(r"`--note` is optional and at most (\d+) bytes of UTF-8\. A note MUST contain none of ([^.]+)\.")
CODE_POINTS = re.compile(r"U\+([0-9A-F]{4})(?:–U\+([0-9A-F]{4}))?")
DOMAIN_RULE = re.compile(r'A v2 token signature is Ed25519 over `"([^"`]+)" \|\| NUL \|\| canonical\(payload_without_signature\)`')
CODE_ROW = re.compile(r"^\| `(\w+)` \|", re.MULTILINE)
UNCERTAIN = ("dispatch_outcome_unknown", "dispatch_not_proven")
# Committed approvals still in flight, which also block a later reply for the same outcome and zone.
IN_FLIGHT = ("approved_pending_dispatch", "dispatch_started")
# The proposal fields the `proposal_binds` sentence names, as the corpus spells them.
PROPOSAL_BINDS = ("proposal_id", "device_id", "action", "target", "zone", "binding", "authority", "created_at_ms",
                  "expires_at_ms")
RECONCILED = ("reconciled_executed", "reconciled_not_executed")
CLOSES_WITH_SAFE_DEFAULT = ("proposal_aborted_restart", "approval_binding_changed")
REQUIRED_SEQUENCES = {
    "admission": (
        "a live approval dispatches immediately",
        "a held state-store writer leaves the reply unapproved",
        "a blocked outcome writer never delays or repeats the action",
        "a reply after the monotonic deadline is not an approval",
        "expiry between commit and dispatch",
        "a crash before the executor call with an affirmative non-dispatch record is aborted",
        "a durable approval with neither marker nor proof is dispatch_not_proven",
        "a relay that actuated while its marker lost the race is dispatch_not_proven, never aborted",
        "a durable marker without an outcome is dispatch_outcome_unknown",
        "a duplicate reply is idempotent",
        "the local console and an offline token use the same admission",
        "stopped or disabled evidence never delays dispatch",
        "an unauthenticated reply changes nothing",
        "a refused proposal applies only the non-actuating safe default",
        "a contention refusal at dispatch never actuates",
        "a failed actuation is recorded dispatch_failed, never executed",
        "a forward wall-clock jump does not shorten execution authority",
        "a backward wall-clock jump does not extend execution authority",
        "a restart with an open proposal closes it proposal_aborted_restart",
        "a restart repeated after proposal_aborted_restart creates one safe-default intent",
        "replies after approval_binding_changed create one safe-default intent",
        "an uncertain dispatch blocks only the same outcome on the same zone",
        "dispatch_not_proven blocks the same way and Tier D always continues",
        "an authenticated local operator command reconciles by appending",
        "unauthenticated operator input and uncommissioned feedback reconcile nothing",
        "commissioned feedback for the zone reconciles dispatch_not_proven",
        "a changed commissioned binding makes the reply no approval",
        "a changed authority snapshot makes the reply no approval",
        "a binding changed back after a mismatch revives nothing",
        "a backward wall-clock jump between commit and dispatch does not extend execution authority",
        "an unchanged binding and authority admit the approval",
        "a timeout result is dispatch_outcome_unknown, never dispatch_failed",
        "a lost response result is dispatch_outcome_unknown, never dispatch_failed",
        "a partial result is dispatch_outcome_unknown, never dispatch_failed",
        "an indeterminate result is dispatch_outcome_unknown, never dispatch_failed",
        "the approval commit reserves a terminal uncertainty record",
        "a reply whose uncertainty record cannot be reserved is not an approval",
        "a full pending structure leaves a live unknown that is not durable",
        "a full pending structure without a durable marker is dispatch_not_proven after restart",
        "an outcome that cannot be appended stays pending while live",
        "a store that accepts the write while live records the outcome the executor reported",
        "an approval in flight for the same outcome and zone blocks a later proposal's reply",
        "one safe-default intent per proposal",
        "local logging of the safe default is idempotent by proposal id",
        "a proposal row that cannot be committed is never sent",
        "a later proposal for a blocked outcome is refused at creation",
        "an uncertainty arising after a later proposal was created blocks its reply",
        "reconciliation after a blocked reply revives nothing and admits a fresh proposal",
    ),
    "tokens": (
        "an offline token bound to another proposal, action, target or zone approves nothing",
        "a wildcard offline token never authorizes Tier C",
        "a token still valid after the proposal's deadline approves nothing",
        "a failed approval commit consumes no token_id",
        "a token_id already claimed approves nothing",
        "a fresh nonce under a claimed token_id approves nothing",
        "a token valid longer than the proposal cannot extend it",
        "a token presented to a proposal whose binding changed is not consumed",
        "a v1 token parses as v1 and is refused as Tier C authority",
        "a v1 wildcard token is refused as Tier C authority",
        "a v1 token carrying every v2 binding claim but no version is still v1 and refused",
        "a token with an unknown version is malformed",
    ),
    "reconcile": (
        "an authenticated local reconcile is accepted, appended, and unblocks the same outcome on the same zone",
        "a request whose operation is absent or unknown is refused invalid_arguments",
        "an identical repeat appends no second reconciliation, and another principal's is audited",
        "an identical repeat by root from another login is audited",
        "operational outcomes commit no reconciliation",
        "a different request after reconciliation is refused already_reconciled",
        "an unknown proposal is refused",
        "a device or zone mismatch is refused",
        "an unauthenticated caller is refused before any record is read",
        "arguments outside the closed sets or bounds are refused",
        "an unreachable runtime or unavailable runtime store commits nothing, and the bridge creates no file",
        "a proposal that is not uncertain is refused not_uncertain",
        "reconcile never replays the action and never reaches Tier D",
        "checks run in the contract's order",
        "the device is the running runtime's own",
        "spoofed user ID fields in the request do nothing",
        "an unauthorized peer learns no state",
        "the installed operator succeeds without database write permission",
        "a lost connection cancels nothing the runtime began, and a repeat is idempotent",
        "an admitted caller's audit login user ID neither admits nor refuses",
        "the installed operator identity is read only from a trusted operator-uid file",
        "a request naming a member twice is refused invalid_arguments",
        "an audit login user ID the runtime cannot pin to the peer is recorded null",
        "a host-state Tier C approval on the existing workflow is not reconciled here",
        "a request naming operation twice is refused invalid_arguments",
        "a response from an unverified peer is runtime_unavailable, and an explicit --socket does not waive "
        "peer verification",
    ),
}
