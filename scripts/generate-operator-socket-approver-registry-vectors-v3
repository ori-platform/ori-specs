def signed_doc(**changes: object) -> dict:
    unsigned = {k: v for k, v in REVOKE_1.items() if k != "signature"}
    unsigned.update(changes)
    return sign(PROVISIONING, b"ori.tier_c_approver.revoke.v1", unsigned)


def noncanonical(value: str) -> str:
    """The same bytes with nonzero padding bits: Base64 that decodes but is not canonical."""
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    head, pad = value.rstrip("="), value[len(value.rstrip("=")):]
    return head[:-1] + alphabet[alphabet.index(head[-1]) + 1] + pad


for label, doc in (
    ("missing_member", sign(PROVISIONING, b"ori.tier_c_approver.revoke.v1",
                            {k: v for k, v in REVOKE_1.items() if k not in ("signature", "site_id")})),
    ("v_not_1", signed_doc(v=2)),
    ("targets_empty", signed_doc(targets=[])),
    ("targets_repeated", signed_doc(targets=["credential:owner-phone", "credential:owner-phone"])),
    ("targets_over_32", signed_doc(targets=sorted(f"credential:t{i:02d}" for i in range(33)))),
    ("target_badly_formed", signed_doc(targets=["phone:owner-phone"])),
    ("identity_epoch_noncanonical", signed_doc(identity_epoch=noncanonical(EPOCH))),
    ("signing_key_noncanonical",
     {**signed_doc(), "signing_key": "ed25519:" + noncanonical(b64(raw_public(PROVISIONING)))}),
    ("signature_noncanonical", {**REVOKE_1, "signature": noncanonical(REVOKE_1["signature"])}),
):
    case(f"rv_malformed_{label}", f"a malformed document: {label.replace('_', ' ')}; signed where its form allows",
         {}, request({**REVOKE_REQ, "document": doc}))

