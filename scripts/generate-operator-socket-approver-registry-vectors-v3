"""Generate the operator-socket/v3 Approver Registry Operations corpus.

Nothing here is shared with the corpus checker, which reads the order of
refusal, the members and the codes from the contract and replays every case
itself.

    python3 scripts/generate-operator-socket-approver-registry-vectors-v3          # write
    python3 scripts/generate-operator-socket-approver-registry-vectors-v3 --check  # reproduce
"""

from __future__ import annotations

import base64
import copy
import hashlib
import json
import pathlib
import re
import sys

from cryptography.exceptions import InvalidSignature

# A revision of thousands of digits is a JSON integer the contract judges (malformed, over 2^53 - 1); Python's
# default cap on integer string conversion must not turn it into a parse failure.
if hasattr(sys, "set_int_max_str_digits"):
    sys.set_int_max_str_digits(0)
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "operator-socket" / "vectors" / "approver-registry-v3.json"

BOUND = 16_384
DEVICE_ID = "edge-1"
SITE_ID = "site-1"
OPERATOR_UID = 1001


def b64(raw: bytes) -> str:
    return base64.b64encode(raw).decode("ascii")


def seeded_key(label: str) -> Ed25519PrivateKey:
    return Ed25519PrivateKey.from_private_bytes(
        hashlib.sha256(f"ori operator-socket/v3 {label} test key".encode()).digest()
    )


def raw_public(key: Ed25519PrivateKey) -> bytes:
    return key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)


def lan_value(key: Ed25519PrivateKey) -> str:
    return "ed25519:" + b64(raw_public(key))


PROVISIONING = seeded_key("current provisioning anchor")
PREVIOUS = seeded_key("previous provisioning anchor")
OTHER_CLASS = seeded_key("other class anchor")
STRANGER = seeded_key("unconfigured signer")
OWNER = seeded_key("owner LAN credential")
SECOND = seeded_key("second LAN credential")
CANDIDATE = seeded_key("candidate LAN credential")

EPOCH = b64(bytes(range(16, 32)))
OLD_EPOCH = b64(bytes(range(32, 48)))
NEW_EPOCH = b64(bytes(range(48, 64)))


def cid(n: int) -> str:
    return b64(bytes([n]) * 16)


def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def sign(key: Ed25519PrivateKey, domain: bytes, unsigned: dict) -> dict:
    signature = key.sign(domain + b"\0" + canonical(unsigned))
    return {**unsigned, "signature": b64(signature)}


def flip(signature: str) -> str:
    raw = bytearray(base64.b64decode(signature))
    raw[0] ^= 1
    return b64(bytes(raw))


# --- Ed25519 identity, admission and fixture keys ----------------------------
# Edwards25519 arithmetic for what the cryptography package does not expose:
# whether a key passes ed25519-key-admission/v1, and keys that do not.

FIELD = 2 ** 255 - 19
ORDER = 2 ** 252 + 27742317777372353535851937790883648493
EDWARDS_D = -121665 * pow(121666, FIELD - 2, FIELD) % FIELD
ZERO = (0, 1, 1, 0)


def point_add(a: tuple, b: tuple) -> tuple:
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    k1 = (y1 - x1) * (y2 - x2) % FIELD
    k2 = (y1 + x1) * (y2 + x2) % FIELD
    k3 = 2 * EDWARDS_D * t1 * t2 % FIELD
    k4 = 2 * z1 * z2 % FIELD
    e, f, g, h = k2 - k1, k4 - k3, k4 + k3, k2 + k1
    return (e * f % FIELD, g * h % FIELD, f * g % FIELD, e * h % FIELD)


def point_mul(n: int, point: tuple) -> tuple:
    acc = ZERO
    while n:
        if n & 1:
            acc = point_add(acc, point)
        point = point_add(point, point)
        n >>= 1
    return acc


def is_zero(point: tuple) -> bool:
    return point[0] % FIELD == 0 and (point[1] - point[2]) % FIELD == 0


def point_decode(raw: bytes) -> tuple | None:
    value = int.from_bytes(raw, "little")
    sign, y = value >> 255, value & ((1 << 255) - 1)
    if y >= FIELD:
        return None
    xx = (y * y - 1) * pow(EDWARDS_D * y * y + 1, FIELD - 2, FIELD) % FIELD
    x = pow(xx, (FIELD + 3) // 8, FIELD)
    if (x * x - xx) % FIELD:
        x = x * pow(2, (FIELD - 1) // 4, FIELD) % FIELD
    if (x * x - xx) % FIELD or (x == 0 and sign):
        return None
    if x & 1 != sign:
        x = FIELD - x
    return (x, y, 1, x * y % FIELD)


def point_encode(point: tuple) -> bytes:
    x, y, z, _ = point
    inv = pow(z, FIELD - 2, FIELD)
    x, y = x * inv % FIELD, y * inv % FIELD
    return (y | (x & 1) << 255).to_bytes(32, "little")


def admitted(raw: bytes) -> bool:
    """ed25519-key-admission/v1: canonical, on the curve, not of small order, of prime order."""
    point = point_decode(raw) if len(raw) == 32 else None
    return point is not None and not is_zero(point_mul(8, point)) and is_zero(point_mul(ORDER, point))


def identity(raw: bytes) -> bytes:
    """ed25519-key-admission/v1, Recognising a key: the 32 bytes with bit 255 cleared."""
    return raw[:31] + bytes([raw[31] & 0x7F])


def negated(raw: bytes) -> bytes:
    return raw[:31] + bytes([raw[31] ^ 0x80])


def sign_negated(label: str, domain: bytes, unsigned: dict) -> dict:
    """Sign under the negation of a seeded key: the holder of a signs with -a under -A."""
    h = hashlib.sha512(hashlib.sha256(f"ori operator-socket/v3 {label} test key".encode()).digest()).digest()
    a = int.from_bytes(h[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    public = negated(raw_public(seeded_key(label)))
    message = domain + b"\0" + canonical(unsigned)
    r = int.from_bytes(hashlib.sha512(h[32:] + message).digest(), "little") % ORDER
    big_r = point_encode(point_mul(r, BASE_POINT))
    k = int.from_bytes(hashlib.sha512(big_r + public + message).digest(), "little") % ORDER
    s = (r + k * (ORDER - a % ORDER)) % ORDER
    signature = big_r + s.to_bytes(32, "little")
    Ed25519PublicKey.from_public_bytes(public).verify(signature, message)
    return {**unsigned, "signature": b64(signature)}


BASE_POINT = point_decode((4 * pow(5, FIELD - 2, FIELD) % FIELD).to_bytes(32, "little"))
EIGHT_TORSION = point_decode(bytes.fromhex("c7176a703d4dd84fba3c0b760d10670f2a2053fa2c39ccc64ec7fd7792ac037a"))
assert EIGHT_TORSION is not None and is_zero(point_mul(8, EIGHT_TORSION))
assert not is_zero(point_mul(4, EIGHT_TORSION))
SMALL_ORDER_KEY = (1).to_bytes(32, "little")
EIGHT_TORSION_KEY = point_encode(EIGHT_TORSION)
NONCANONICAL_KEY = (FIELD + 1).to_bytes(32, "little")


def seed_scalar(label: str) -> int:
    h = hashlib.sha512(hashlib.sha256(f"ori operator-socket/v3 {label} test key".encode()).digest()).digest()
    a = int.from_bytes(h[:32], "little")
    return (a & ((1 << 254) - 8)) | (1 << 254)


def sign_ground(scalar: int, public: bytes, domain: bytes, unsigned: dict) -> dict:
    """Sign so the cofactorless equation [S]B = R + [k]A holds under a key that fails admission.

    A is [scalar]B plus a point of order dividing 8. The nonce is ground until k, taken both as the
    full 512-bit hash and reduced mod L, is a multiple of 8, so [k] removes the torsion component and
    admission alone refuses the key, as ed25519-key-admission/v1 describes.
    """
    message = domain + b"\0" + canonical(unsigned)
    point = point_decode(public)
    for counter in range(10_000):
        r = int.from_bytes(hashlib.sha512(counter.to_bytes(4, "little") + public + message).digest(),
                           "little") % ORDER
        big_r = point_encode(point_mul(r, BASE_POINT))
        k_full = int.from_bytes(hashlib.sha512(big_r + public + message).digest(), "little")
        if k_full % 8 or (k_full % ORDER) % 8:
            continue
        s = (r + k_full * scalar) % ORDER
        left = point_encode(point_mul(s, BASE_POINT))
        for k in (k_full, k_full % ORDER):
            assert left == point_encode(point_add(point_decode(big_r), point_mul(k, point))), "equation"
        return {**unsigned, "signature": b64(big_r + s.to_bytes(32, "little"))}
    raise AssertionError("no nonce found")


def mixed_order(raw: bytes) -> bytes:
    return point_encode(point_add(point_decode(raw), EIGHT_TORSION))


# --- the runtime as the contract describes it --------------------------------

OPERATIONS = (
    "reconcile_tier_c",
    "evidence_commission",
    "approver_registry_challenge",
    "approver_registry_recover",
    "approver_registry_local_seed",
    "approver_registry_enrol",
    "approver_registry_revoke",
    "approver_registry_binding",
)
MEMBERS = {
    "approver_registry_challenge": {"operation", "challenge_operation", "candidate"},
    "approver_registry_recover": {"operation", "challenge_id"},
    "approver_registry_local_seed": {"operation", "challenge_id", "candidate", "possession"},
    "approver_registry_enrol": {"operation", "challenge_id", "candidate", "authorization", "possession"},
    "approver_registry_revoke": {"operation", "document"},
    "approver_registry_binding": {"operation"},
}
REVOKE_MEMBERS = {"v", "device_id", "site_id", "identity_epoch", "revision", "targets", "signing_key", "signature"}
ID = re.compile(r"[A-Za-z0-9._-]{1,64}")
E164 = re.compile(r"\+[1-9][0-9]{1,14}")
HEX64 = re.compile(r"[0-9a-f]{64}")
TARGET = re.compile(r"(?:credential|approver):[A-Za-z0-9._-]{1,64}")


class Refused(Exception):
    def __init__(self, code: str, consumes: bool = False) -> None:
        super().__init__(code)
        self.code = code
        self.consumes = consumes


def canonical_b64(value: object, length: int) -> bool:
    if not isinstance(value, str):
        return False
    try:
        raw = base64.b64decode(value, validate=True)
    except ValueError:
        return False
    return len(raw) == length and b64(raw) == value


def is_int(value: object) -> bool:
    return type(value) is int


def channel_value_ok(channel: object, value: object) -> bool:
    if channel in ("sms", "whatsapp"):
        return isinstance(value, str) and E164.fullmatch(value) is not None
    if channel == "lan_ed25519":
        return isinstance(value, str) and value.startswith("ed25519:") and canonical_b64(value[8:], 32)
    return False


def candidate_ok(value: object) -> bool:
    return (
        isinstance(value, dict)
        and set(value) == {"approver_id", "credential_id", "channel", "value"}
        and all(isinstance(value[k], str) and ID.fullmatch(value[k]) for k in ("approver_id", "credential_id"))
        and channel_value_ok(value["channel"], value["value"])
    )


def proof_ok(value: object, id_member: str) -> bool:
    return (
        isinstance(value, dict)
        and set(value) == {"v", "challenge_id", "challenge_sha256", id_member, "signature"}
        and is_int(value["v"]) and value["v"] == 1
        and canonical_b64(value["challenge_id"], 16)
        and isinstance(value["challenge_sha256"], str) and HEX64.fullmatch(value["challenge_sha256"]) is not None
        and isinstance(value[id_member], str) and ID.fullmatch(value[id_member]) is not None
        and canonical_b64(value["signature"], 64)
    )


class Obj(dict):
    """A parsed JSON object that remembers whether a member was named twice in it, and whether any member,
    shadowed ones included, held a string with no UTF-8 form."""
    repeated = False
    no_utf8 = False


def no_utf8(value: object) -> bool:
    """A string, key or nested string with no UTF-8 form, such as an escaped lone surrogate."""
    if isinstance(value, str):
        try:
            value.encode("utf-8")
        except UnicodeEncodeError:
            return True
        return False
    if isinstance(value, dict):
        return getattr(value, "no_utf8", False) or any(no_utf8(k) or no_utf8(v) for k, v in value.items())
    if isinstance(value, list):
        return any(no_utf8(v) for v in value)
    return False


def unique(pairs: list) -> dict:
    """Keep every member's verdict: a value a later duplicate shadows is still judged at parse."""
    out = Obj()
    for key, value in pairs:
        if no_utf8(key) or no_utf8(value):
            out.no_utf8 = True
        if key in out:
            out.repeated = True
        out[key] = value
    return out


def no_constant(name: str) -> object:
    raise ValueError(f"{name} is not JSON")


MAX_DEPTH = 32
MAX_REVISION = 2 ** 53 - 1


def parse_faults(value: object, depth: int = 1) -> bool:
    """A string with no UTF-8 form, or nesting deeper than MAX_DEPTH, anywhere."""
    if isinstance(value, str):
        try:
            value.encode("utf-8")
        except UnicodeEncodeError:
            return True
        return False
    if isinstance(value, (dict, list)):
        if depth > MAX_DEPTH:
            return True
        items = list(value.items()) if isinstance(value, dict) else [(None, v) for v in value]
        return any((k is not None and parse_faults(k, depth)) or parse_faults(v, depth + 1) for k, v in items)
    return False


def repeats(value: object) -> bool:
    if isinstance(value, dict):
        return bool(getattr(value, "repeated", False)) or any(repeats(v) for v in value.values())
    if isinstance(value, list):
        return any(repeats(v) for v in value)
    return False


def form(request: dict) -> str:
    op = request.get("operation")
    if not isinstance(op, str) or op not in OPERATIONS:
        raise Refused("invalid_arguments")
    if op not in MEMBERS:
        raise AssertionError("v2 operations appear only in cases decided before their members")
    if set(request) != MEMBERS[op]:
        raise Refused("invalid_arguments")
    if op == "approver_registry_challenge":
        kind, cand = request["challenge_operation"], request["candidate"]
        if kind not in ("recover", "local_seed", "enrol"):
            raise Refused("invalid_arguments")
        if kind == "recover":
            if cand is not None:
                raise Refused("invalid_arguments")
        else:
            members = {"channel", "value"} | ({"approver_id"} if kind == "enrol" else set())
            if not (isinstance(cand, dict) and set(cand) == members
                    and channel_value_ok(cand["channel"], cand["value"])):
                raise Refused("invalid_arguments")
            approver = cand.get("approver_id")
            if approver is not None and not (isinstance(approver, str) and ID.fullmatch(approver)):
                raise Refused("invalid_arguments")
    if op in ("approver_registry_recover", "approver_registry_local_seed", "approver_registry_enrol"):
        if not canonical_b64(request["challenge_id"], 16):
            raise Refused("invalid_arguments")
    if op in ("approver_registry_local_seed", "approver_registry_enrol"):
        if not candidate_ok(request["candidate"]):
            raise Refused("invalid_arguments")
    if op == "approver_registry_local_seed" and not proof_ok(request["possession"], "candidate_credential_id"):
        raise Refused("invalid_arguments")
    if op == "approver_registry_enrol":
        auth, poss = request["authorization"], request["possession"]
        if auth is not None and not proof_ok(auth, "authorizer_credential_id"):
            raise Refused("invalid_arguments")
        lan = request["candidate"]["channel"] == "lan_ed25519"
        if lan and not proof_ok(poss, "candidate_credential_id"):
            raise Refused("invalid_arguments")
        if not lan and poss is not None:
            raise Refused("invalid_arguments")
    return op


def verifies(public_raw: bytes, domain: bytes, signed: dict) -> bool:
    if not admitted(public_raw):
        return False
    unsigned = {k: v for k, v in signed.items() if k != "signature"}
    try:
        Ed25519PublicKey.from_public_bytes(public_raw).verify(
            base64.b64decode(signed["signature"]), domain + b"\0" + canonical(unsigned)
        )
    except (InvalidSignature, ValueError):
        return False
    return True


def site_mismatch(ctx: dict) -> bool:
    reg = ctx["registry"]
    return reg is not None and reg["site_id"] != ctx["verified_site_id"]


def tombstoned_ids(reg: dict) -> set:
    return {entry["credential_id"] for entry in reg["tombstoned_credentials"]}


def value_key(value: str) -> tuple:
    """A LAN value is recognised by its key's identity; a phone value by its number alone."""
    if value.startswith("ed25519:"):
        return ("lan", identity(base64.b64decode(value[8:])))
    return ("phone", value)


def value_checks(ctx: dict, reg: dict, value: str, consumes: bool) -> None:
    key = value_key(value)
    if key in {value_key(v) for v in reg["tombstoned_values"]}:
        raise Refused("value_tombstoned", consumes)
    if key in {value_key(c["value"]) for c in reg["credentials"]}:
        raise Refused("duplicate_value", consumes)
    if key[0] == "phone" and value in ctx["pending_phone_values"]:
        raise Refused("phone_pending_for_value", consumes)


def candidate_checks(ctx: dict, reg: dict, cand: dict) -> None:
    if cand["approver_id"] in reg["tombstoned_approvers"]:
        raise Refused("approver_revoked", True)
    active_ids = {c["credential_id"] for c in reg["credentials"]}
    if cand["credential_id"] in active_ids or cand["credential_id"] in tombstoned_ids(reg):
        raise Refused("credential_reused", True)
    value_checks(ctx, reg, cand["value"], True)


def possession_checks(challenge: dict, digest: str, cand: dict, poss: dict) -> None:
    if (poss["challenge_id"] != challenge["challenge_id"] or poss["challenge_sha256"] != digest
            or poss["candidate_credential_id"] != cand["credential_id"]):
        raise Refused("possession_invalid", True)
    if not verifies(base64.b64decode(cand["value"][8:]), b"ori.tier_c_approver.possession.v1", poss):
        raise Refused("signature_invalid", True)


def challenge_op(ctx: dict, request: dict) -> dict:
    kind, cand = request["challenge_operation"], request["candidate"]
    if kind == "local_seed" and cand["channel"] != "lan_ed25519":
        raise Refused("lan_key_required")
    if site_mismatch(ctx):
        raise Refused("site_binding_mismatch")
    reg, minted = ctx["registry"], ctx["minted"]
    if kind == "recover" and reg is not None:
        raise Refused("recovery_not_available")
    if kind != "recover" and reg is None:
        raise Refused("registry_unavailable")
    if kind == "recover":
        epoch, revision, candidates = minted["identity_epoch"], 0, []
    else:
        if kind == "enrol" and cand["channel"] not in ("lan_ed25519", *ctx["authenticated_phone_channels"]):
            raise Refused("channel_unauthenticated")
        if kind == "local_seed" and reg["credentials"]:
            raise Refused("active_authorizer_exists")
        approver = cand.get("approver_id")
        if approver is not None:
            if approver in reg["tombstoned_approvers"]:
                raise Refused("approver_revoked")
            if approver not in {c["approver_id"] for c in reg["credentials"]}:
                raise Refused("approver_unknown")
        value_checks(ctx, reg, cand["value"], False)
        epoch, revision = reg["identity_epoch"], reg["registry_revision"]
        candidates = [{"approver_id": approver or minted["approver_id"],
                       "credential_id": minted["credential_id"],
                       "channel": cand["channel"], "value": cand["value"]}]
    CHANGES.append(f"challenge_added:{minted['challenge_id']}")
    if kind == "enrol" and cand["channel"] in ("sms", "whatsapp"):
        CHANGES.append(f"code_sent:{minted['challenge_id']}")
    return {"challenge": {
        "v": 1, "challenge_id": minted["challenge_id"], "device_id": ctx["device_id"],
        "site_id": ctx["verified_site_id"], "identity_epoch": epoch, "operation": kind,
        "registry_revision": revision, "candidates": candidates,
    }}


def presented(ctx: dict, request: dict, kind: str) -> tuple[dict, dict]:
    if site_mismatch(ctx):
        raise Refused("site_binding_mismatch")
    held = next((h for h in ctx["challenges"] if h["challenge"]["challenge_id"] == request["challenge_id"]), None)
    if held is not None and held["state"] == "used":
        raise Refused("challenge_reused")
    if held is None:
        raise Refused("challenge_unavailable")
    if held["state"] == "expired" or held["elapsed_ms"] > CHALLENGE_WINDOW_MS:
        raise Refused("challenge_expired", True)
    challenge = held["challenge"]
    if challenge["operation"] != kind:
        raise Refused("candidate_changed", True)
    if kind != "recover" and request["candidate"] != challenge["candidates"][0]:
        raise Refused("candidate_changed", True)
    reg = ctx["registry"]
    if kind == "recover":
        if reg is not None:
            raise Refused("recovery_not_available", True)
        if (challenge["device_id"], challenge["site_id"]) != (ctx["device_id"], ctx["verified_site_id"]):
            raise Refused("challenge_stale", True)
        return held, {}
    if reg is None:
        raise Refused("registry_unavailable", True)
    if (reg["registry_revision"], reg["identity_epoch"]) != (challenge["registry_revision"],
                                                             challenge["identity_epoch"]):
        raise Refused("challenge_stale", True)
    return held, reg


def recover_op(ctx: dict, request: dict) -> dict:
    held, _ = presented(ctx, request, "recover")
    CHANGES.extend([f"used:{request['challenge_id']}",
                    f"registry_created:{held['challenge']['identity_epoch']}",
                    "challenges_cleared", "phone_authorizations_cleared", "pending_phone_cleared"])
    return {"status": "recovered", "registry_revision": 1}


def local_seed_op(ctx: dict, request: dict) -> dict:
    held, reg = presented(ctx, request, "local_seed")
    if reg["credentials"]:
        raise Refused("active_authorizer_exists", True)
    challenge = held["challenge"]
    possession_checks(challenge, hashlib.sha256(canonical(challenge)).hexdigest(),
                      request["candidate"], request["possession"])
    candidate_checks(ctx, reg, request["candidate"])
    credential_added(reg, request)
    return {"status": "seeded", "registry_revision": reg["registry_revision"] + 1}


def enrol_op(ctx: dict, request: dict) -> dict:
    held, reg = presented(ctx, request, "enrol")
    challenge = held["challenge"]
    digest = hashlib.sha256(canonical(challenge)).hexdigest()
    active = {c["credential_id"]: c for c in reg["credentials"]}
    auth = request["authorization"]
    if auth is not None:
        authorizer = active.get(auth["authorizer_credential_id"])
        if authorizer is None or authorizer["channel"] != "lan_ed25519":
            raise Refused("authorizer_unavailable", True)
    else:
        # The first text recorded for the challenge is its authorization; later ones change nothing.
        record = next((p for p in ctx["phone_authorizations"] if p["challenge_id"] == challenge["challenge_id"]), None)
        if record is not None and record["challenge_sha256"] != digest:
            record = None
        authorizer = None if record is None else active.get(record["authorizer_credential_id"])
        if authorizer is None or authorizer["channel"] not in ("sms", "whatsapp"):
            raise Refused("authorizer_unavailable", True)
    if authorizer["sequence"] > held["credential_sequence_at_issue"]:
        raise Refused("authorizer_not_preexisting", True)
    if auth is not None and (
        auth["challenge_id"] != challenge["challenge_id"] or auth["challenge_sha256"] != digest
        or not verifies(base64.b64decode(authorizer["value"][8:]), b"ori.tier_c_approver.enrol.v1", auth)
    ):
        raise Refused("signature_invalid", True)
    named = challenge["candidates"][0]["approver_id"]
    if named in {c["approver_id"] for c in reg["credentials"]} and authorizer["approver_id"] != named:
        raise Refused("authorizer_not_approver", True)
    cand = request["candidate"]
    if cand["channel"] == "lan_ed25519":
        possession_checks(challenge, digest, cand, request["possession"])
        candidate_checks(ctx, reg, cand)
        credential_added(reg, request)
        return {"status": "enrolled", "registry_revision": reg["registry_revision"] + 1}
    candidate_checks(ctx, reg, cand)
    CHANGES.extend([f"used:{request['challenge_id']}", f"pending_phone_added:{cand['value']}"])
    return {"status": "phone_pending", "registry_revision": reg["registry_revision"]}


def credential_added(reg: dict, request: dict) -> None:
    CHANGES.extend([f"used:{request['challenge_id']}",
                    f"credential_added:{request['candidate']['credential_id']}",
                    f"sequence:{reg['credential_sequence'] + 1}",
                    f"revision:{reg['registry_revision'] + 1}"])


def document_malformed(doc: object) -> bool:
    if not isinstance(doc, dict) or repeats(doc) or set(doc) != REVOKE_MEMBERS:
        return True
    targets = doc["targets"]
    return not (
        is_int(doc["v"]) and doc["v"] == 1
        and is_int(doc["revision"]) and 1 <= doc["revision"] <= MAX_REVISION
        and isinstance(doc["device_id"], str) and ID.fullmatch(doc["device_id"])
        and isinstance(doc["site_id"], str) and ID.fullmatch(doc["site_id"])
        and canonical_b64(doc["identity_epoch"], 16)
        and isinstance(targets, list) and 0 < len(targets) <= 32
        and all(isinstance(t, str) and TARGET.fullmatch(t) for t in targets)
        and targets == sorted(set(targets))
        and isinstance(doc["signing_key"], str) and doc["signing_key"].startswith("ed25519:")
        and canonical_b64(doc["signing_key"][8:], 32)
        and canonical_b64(doc["signature"], 64)
    )


def revoke_op(ctx: dict, request: dict) -> dict:
    doc = request["document"]
    anchors = {role: base64.b64decode(key) for role, key in ctx["anchors"].items()}
    current = anchors["current"]
    if (not ctx["anchor_available"] or not admitted(current)
            or len({identity(key) for key in anchors.values()}) < 3):
        raise Refused("anchor_unavailable")
    if document_malformed(doc):
        raise Refused("malformed")
    key = base64.b64decode(doc["signing_key"][8:])
    role = next((r for r in ("current", "previous", "other_class")
                 if identity(anchors[r]) == identity(key)), None)
    if role is None:
        raise Refused("unknown_signer")
    if not verifies(key, b"ori.tier_c_approver.revoke.v1", doc):
        raise Refused("signature_invalid")
    if role == "previous":
        raise Refused("superseded_signer")
    if role == "other_class":
        raise Refused("wrong_authority")
    reg = ctx["registry"]
    if reg is None:
        raise Refused("registry_unavailable")
    if site_mismatch(ctx):
        raise Refused("site_binding_mismatch")
    bound_to = (ctx["device_id"], reg["site_id"], reg["identity_epoch"])
    if (doc["device_id"], doc["site_id"], doc["identity_epoch"]) != bound_to:
        raise Refused("binding_mismatch")
    last = reg["last_external_revision"]
    if doc["revision"] < last:
        raise Refused("revision_regressed")
    if doc["revision"] == last:
        if hashlib.sha256(canonical(doc)).hexdigest() != reg["last_external_document_sha256"]:
            raise Refused("revision_conflict")
        return {"status": "replayed", "registry_revision": reg["registry_revision"],
                "last_external_revision": last}
    known_credentials = {c["credential_id"] for c in reg["credentials"]} | tombstoned_ids(reg)
    known_approvers = ({c["approver_id"] for c in reg["credentials"]} | set(reg["tombstoned_approvers"])
                       | {e["approver_id"] for e in reg["tombstoned_credentials"]})
    for target in doc["targets"]:
        kind, ident = target.split(":", 1)
        if ident not in (known_credentials if kind == "credential" else known_approvers):
            raise Refused("unknown_target")
    removed = []
    for target in doc["targets"]:
        kind, ident = target.split(":", 1)
        if kind == "credential":
            removed += [c for c in reg["credentials"] if c["credential_id"] == ident]
        else:
            removed += [c for c in reg["credentials"] if c["approver_id"] == ident]
            if ident not in reg["tombstoned_approvers"]:
                CHANGES.append(f"approver_tombstoned:{ident}")
    for cred in {c["credential_id"]: c for c in removed}.values():
        CHANGES.extend([f"credential_tombstoned:{cred['credential_id']}", f"value_tombstoned:{cred['value']}"])
    CHANGES.extend([f"revision:{reg['registry_revision'] + 1}", f"last_external_revision:{doc['revision']}"])
    return {"status": "revoked", "registry_revision": reg["registry_revision"] + 1,
            "last_external_revision": doc["revision"]}


def binding_op(ctx: dict, request: dict) -> dict:
    reg = ctx["registry"]
    if reg is None:
        raise Refused("registry_unavailable")
    if site_mismatch(ctx):
        raise Refused("site_binding_mismatch")
    return {"device_id": ctx["device_id"], "site_id": reg["site_id"],
            "identity_epoch": reg["identity_epoch"], "registry_revision": reg["registry_revision"]}


HANDLERS = {
    "approver_registry_challenge": challenge_op,
    "approver_registry_recover": recover_op,
    "approver_registry_local_seed": local_seed_op,
    "approver_registry_enrol": enrol_op,
    "approver_registry_revoke": revoke_op,
    "approver_registry_binding": binding_op,
}
TABLE = [False]
CHANGES: list = []
PRESENTING = {"approver_registry_recover", "approver_registry_local_seed", "approver_registry_enrol"}


def frame(request: str) -> bytes:
    """The request is the bytes before the first LF; the replay appends one LF."""
    return (request.encode("utf-8") + b"\n").split(b"\n", 1)[0]


def answer(ctx: dict, request: str, terminated: bool = True) -> dict:
    raw = frame(request)
    op = None
    parsed: dict = {}
    CHANGES.clear()
    try:
        if len(raw) > BOUND:
            raise Refused("payload_too_large")
        if not terminated and b"\n" not in request.encode("utf-8"):
            raise Refused("invalid_arguments")
        try:
            parsed = json.loads(raw.decode("utf-8"), object_pairs_hook=unique, parse_constant=no_constant)
        except ValueError:
            raise Refused("invalid_arguments") from None
        if not isinstance(parsed, dict) or parse_faults(parsed) or no_utf8(parsed):
            raise Refused("invalid_arguments")
        if parsed.repeated or any(repeats(v) for k, v in parsed.items() if k != "document"):
            raise Refused("invalid_arguments")
        op = form(parsed)
        peer, operator = ctx["peer_uid"], ctx["operator_uid"]
        if peer is None or not (peer == 0 or (operator is not None and peer == operator)):
            raise Refused("unauthenticated")
        if ctx["registry_operation_in_flight"]:
            raise Refused("registry_busy")
        if not ctx["verified_site_id"]:
            raise Refused("registry_unavailable")
        TABLE[0] = True
        result = HANDLERS[op](ctx, parsed)
    except Refused as refusal:
        expected = {"ok": False, "code": refusal.code}
        if op in PRESENTING:
            expected["consumes_challenge"] = refusal.consumes
        expected["changes"] = [f"used:{parsed['challenge_id']}"] if refusal.consumes else []
        return expected
    expected = {"ok": True, "result": result}
    if op in PRESENTING:
        expected["consumes_challenge"] = True
    expected["changes"] = sorted(CHANGES)
    return expected


# --- fixtures ----------------------------------------------------------------

def credential(approver: str, ident: str, channel: str, value: str, sequence: int) -> dict:
    return {"approver_id": approver, "credential_id": ident, "channel": channel, "value": value, "sequence": sequence}


OWNER_CRED = credential("owner", "owner-key", "lan_ed25519", lan_value(OWNER), 1)
PHONE_CRED = credential("owner", "owner-phone", "sms", "+2348012345678", 2)


def tomb(credential_id: str, approver_id: str) -> dict:
    return {"credential_id": credential_id, "approver_id": approver_id}


def registry(**overrides: object) -> dict:
    base = {
        "site_id": SITE_ID,
        "identity_epoch": EPOCH,
        "registry_revision": 3,
        "last_external_revision": 0,
        "last_external_document_sha256": None,
        "credential_sequence": 2,
        "credentials": [OWNER_CRED, PHONE_CRED],
        "tombstoned_credentials": [],
        "tombstoned_approvers": [],
        "tombstoned_values": [],
    }
    base.update(overrides)
    return base


EMPTY = dict(registry_revision=2, credential_sequence=1, credentials=[],
             tombstoned_credentials=[tomb("old-key", "old-owner")], tombstoned_approvers=["old-owner"],
             tombstoned_values=[lan_value(SECOND)])


def ctx(**overrides: object) -> dict:
    base = {
        "device_id": DEVICE_ID,
        "verified_site_id": SITE_ID,
        "peer_uid": OPERATOR_UID,
        "operator_uid": OPERATOR_UID,
        "registry_operation_in_flight": False,
        "anchor_available": True,
        "anchors": {"current": b64(raw_public(PROVISIONING)), "previous": b64(raw_public(PREVIOUS)),
                    "other_class": b64(raw_public(OTHER_CLASS))},
        "registry": registry(),
        "challenges": [],
        "phone_authorizations": [],
        "pending_phone_values": [],
        "authenticated_phone_channels": ["sms"],
        "minted": None,
        "keys_failing_admission": [],
    }
    base.update(overrides)
    return base


def request(obj: dict) -> str:
    return json.dumps(obj, separators=(",", ":"), ensure_ascii=False)


def padded_text(text: str, size: int) -> str:
    assert text.endswith("}")
    return text[:-1] + " " * (size - len(text.encode("utf-8"))) + "}"


def padded(obj: dict, size: int) -> str:
    text = request(obj)
    assert text.endswith("}")
    gap = size - len(text.encode("utf-8"))
    assert gap >= 0
    return text[:-1] + " " * gap + "}"


def challenge(n: int, kind: str, candidates: list, *, revision: int = 3, epoch: str = EPOCH) -> dict:
    return {"v": 1, "challenge_id": cid(n), "device_id": DEVICE_ID, "site_id": SITE_ID,
            "identity_epoch": epoch, "operation": kind, "registry_revision": revision,
            "candidates": candidates}


CHALLENGE_WINDOW_MS = 60_000


def held(ch: dict, state: str = "pending", sequence: int = 2, elapsed_ms: int | None = None) -> dict:
    """A held challenge; elapsed_ms is monotonic time since issue, past 60,000 when it has expired."""
    if elapsed_ms is None:
        elapsed_ms = CHALLENGE_WINDOW_MS + 1_000 if state == "expired" else 1_000
    assert (state == "expired") == (elapsed_ms > CHALLENGE_WINDOW_MS) or state == "used", (state, elapsed_ms)
    return {"challenge": ch, "state": state, "credential_sequence_at_issue": sequence, "elapsed_ms": elapsed_ms}


def digest(ch: dict) -> str:
    return hashlib.sha256(canonical(ch)).hexdigest()


def possession(key: Ed25519PrivateKey, ch: dict, cred: str, *, sha: str | None = None) -> dict:
    return sign(key, b"ori.tier_c_approver.possession.v1", {
        "v": 1, "challenge_id": ch["challenge_id"], "challenge_sha256": sha or digest(ch),
        "candidate_credential_id": cred})


def authorization(key: Ed25519PrivateKey, ch: dict, cred: str, *, sha: str | None = None) -> dict:
    return sign(key, b"ori.tier_c_approver.enrol.v1", {
        "v": 1, "challenge_id": ch["challenge_id"], "challenge_sha256": sha or digest(ch),
        "authorizer_credential_id": cred})


def revocation(revision: int, targets: list, *, key: Ed25519PrivateKey = PROVISIONING,
               epoch: str = EPOCH, site: str = SITE_ID) -> dict:
    return sign(key, b"ori.tier_c_approver.revoke.v1", {
        "v": 1, "device_id": DEVICE_ID, "site_id": site, "identity_epoch": epoch,
        "revision": revision, "targets": sorted(targets), "signing_key": "ed25519:" + b64(raw_public(key))})


SEED_CAND = {"approver_id": "minted-a", "credential_id": "minted-c", "channel": "lan_ed25519",
             "value": lan_value(CANDIDATE)}
SMS_CAND = {"approver_id": "minted-a", "credential_id": "minted-c", "channel": "sms", "value": "+2348098765432"}
SEED_CH = challenge(1, "local_seed", [SEED_CAND], revision=2)
ENROL_CH = challenge(2, "enrol", [SEED_CAND])
SMS_CH = challenge(3, "enrol", [SMS_CAND])
RECOVER_CH = challenge(4, "recover", [], revision=0, epoch=NEW_EPOCH)
MINTED = {"challenge_id": cid(9), "approver_id": "minted-a", "credential_id": "minted-c",
          "identity_epoch": NEW_EPOCH}

BINDING = {"operation": "approver_registry_binding"}
REVOKE_1 = revocation(1, ["credential:owner-phone"])
REVOKE_REQ = {"operation": "approver_registry_revoke", "document": REVOKE_1}
RECONCILE = {"operation": "reconcile_tier_c", "proposal_id": "AB12CD34", "device_id": DEVICE_ID,
             "zone_id": "zone-1", "outcome": "executed", "reason": "site_inspection", "note": None}


def seed_req(ch: dict = SEED_CH, cand: dict = SEED_CAND, poss: dict | None = None) -> dict:
    return {"operation": "approver_registry_local_seed", "challenge_id": ch["challenge_id"],
            "candidate": cand, "possession": poss or possession(CANDIDATE, ch, cand["credential_id"])}


def enrol_req(ch: dict = ENROL_CH, cand: dict = SEED_CAND, auth: object = "owner",
              poss: object = "candidate") -> dict:
    if auth == "owner":
        auth = authorization(OWNER, ch, "owner-key")
    if poss == "candidate":
        poss = possession(CANDIDATE, ch, cand["credential_id"])
    return {"operation": "approver_registry_enrol", "challenge_id": ch["challenge_id"],
            "candidate": cand, "authorization": auth, "possession": poss}


def challenge_req(kind: str, channel: str | None = None, value: str | None = None,
                  approver: str | None = None) -> dict:
    cand = None if channel is None else {"channel": channel, "value": value}
    if cand is not None and kind == "enrol":
        cand = {"approver_id": approver, **cand}
    return {"operation": "approver_registry_challenge", "challenge_operation": kind, "candidate": cand}


RECOVER_REQ = {"operation": "approver_registry_recover", "challenge_id": RECOVER_CH["challenge_id"]}
SEED_CTX = dict(registry=registry(**EMPTY), challenges=[held(SEED_CH, sequence=1)])
ENROL_CTX = dict(challenges=[held(ENROL_CH)])
SMS_CTX = dict(challenges=[held(SMS_CH)])
LOCKED = dict(registry=None)

CASES: list[tuple[str, str, dict, str]] = []


def case(name: str, note: str, context: dict, req: str, terminated: bool = True) -> None:
    CASES.append((name, note, ctx(**context), req, terminated))


# The bound, decided before parsing.
case("binding_at_bound", "a request of exactly 16,384 bytes is parsed and answered",
     {}, padded(BINDING, BOUND))
case("binding_one_over_bound", "one byte over the bound is refused before parsing",
     {}, padded(BINDING, BOUND + 1))
case("revoke_at_bound", "a revocation of exactly 16,384 bytes is parsed and committed",
     {}, padded(REVOKE_REQ, BOUND))
case("revoke_one_over_bound", "a valid revocation one byte over the bound is refused and revokes nothing",
     {}, padded(REVOKE_REQ, BOUND + 1))
