case("enrol_same_approver", "a new key for an existing approver, authorised by that approver's own credential",
     {"registry": SAME_REG, "challenges": [held(SAME_CH, sequence=3)]},
     request(enrol_req(SAME_CH, SAME_CAND, authorization(OWNER, SAME_CH, "owner-key"))))
case("enrol_other_approver_authorizes", "a new key for an existing approver, authorised by another approver",
     {"registry": SAME_REG, "challenges": [held(SAME_CH, sequence=3)]},
     request(enrol_req(SAME_CH, SAME_CAND, authorization(THIRD, SAME_CH, "other-key"))))
case("enrol_phone_authorization_wrong_digest", "an ORI-ENROL-V1 text for this challenge ID carrying another "
     "challenge SHA-256 authorises nothing",
     {**ENROL_CTX, "phone_authorizations": [{"challenge_id": ENROL_CH["challenge_id"], "challenge_sha256": "0" * 64,
                                             "authorizer_credential_id": "owner-phone"}]},
     request(enrol_req(auth=None)))

# --- authorizer_not_approver order witnesses ---------------------------------------
OTHER_AUTH = authorization(THIRD, SAME_CH, "other-key")
case("w_en_not_preexisting_over_not_approver", "defence in depth, a fixture: authorizer_not_preexisting decides "
     "while authorizer_not_approver also fails", {"registry": SAME_REG, "challenges": [held(SAME_CH, sequence=2)]},
     request(enrol_req(SAME_CH, SAME_CAND, OTHER_AUTH)))
case("w_en_authorization_signature_over_not_approver", "the authorization's signature_invalid decides while "
     "authorizer_not_approver also fails", {"registry": SAME_REG, "challenges": [held(SAME_CH, sequence=3)]},
     request(enrol_req(SAME_CH, SAME_CAND, authorization(SECOND, SAME_CH, "other-key"))))
case("w_en_stale_over_not_approver", "challenge_stale decides while authorizer_not_approver also fails",
     {"registry": {**SAME_REG, "registry_revision": 4}, "challenges": [held(SAME_CH, sequence=3)]},
     request(enrol_req(SAME_CH, SAME_CAND, OTHER_AUTH)))
case("w_en_not_approver_over_possession_invalid", "authorizer_not_approver decides while possession_invalid also "
     "fails", {"registry": SAME_REG, "challenges": [held(SAME_CH, sequence=3)]},
     request(enrol_req(SAME_CH, SAME_CAND, OTHER_AUTH, possession(CANDIDATE, SAME_CH, "minted-c", sha="0" * 64))))

# --- authorizer_not_approver on the phone paths -----------------------------------
OTHER_PHONE = credential("other", "other-phone", "sms", "+2348011111111", 4)
OWNER_PHONE_LATE = credential("owner", "owner-phone-2", "sms", "+2348022222222", 4)
PHONE_REG = registry(credentials=[OWNER_CRED, PHONE_CRED, OTHER_APPROVER, OTHER_PHONE], credential_sequence=4)
SAME_SMS = {"approver_id": "owner", "credential_id": "minted-c", "channel": "sms", "value": PHONE_X}
SAME_SMS_CH = challenge(51, "enrol", [SAME_SMS])


def phone_auth(ch: dict, credential_id: str) -> list:
    return [{"challenge_id": ch["challenge_id"], "challenge_sha256": digest(ch),
             "authorizer_credential_id": credential_id}]


case("enrol_phone_authorizer_other_approver", "an existing approver named, and an ORI-ENROL-V1 text from another "
     "approver's phone credential", {"registry": PHONE_REG, "challenges": [held(SAME_CH, sequence=4)],
                                     "phone_authorizations": phone_auth(SAME_CH, "other-phone")},
     request(enrol_req(SAME_CH, SAME_CAND, None)))
case("enrol_phone_candidate_other_approver", "a phone candidate naming an existing approver, authorised by another "
     "approver", {"registry": PHONE_REG, "challenges": [held(SAME_SMS_CH, sequence=4)]},
     request(enrol_req(SAME_SMS_CH, SAME_SMS, authorization(THIRD, SAME_SMS_CH, "other-key"), None)))
case("enrol_phone_candidate_same_approver", "a phone candidate naming an existing approver, authorised by that "
     "approver, is recorded pending its possession reply",
     {"registry": PHONE_REG, "challenges": [held(SAME_SMS_CH, sequence=4)]},
     request(enrol_req(SAME_SMS_CH, SAME_SMS, authorization(OWNER, SAME_SMS_CH, "owner-key"), None)))
case("enrol_phone_authorizer_not_preexisting", "defence in depth, a fixture: a phone authoriser enrolled after the "
     "challenge (sequence 4, issued at sequence 3) at the challenge's revision",
     {"registry": registry(credentials=[OWNER_CRED, PHONE_CRED, OTHER_APPROVER, OWNER_PHONE_LATE],
                           credential_sequence=4),
      "challenges": [held(SAME_CH, sequence=3)], "phone_authorizations": phone_auth(SAME_CH, "owner-phone-2")},
     request(enrol_req(SAME_CH, SAME_CAND, None)))

# --- the enrolment matrix -----------------------------------------------------------
# Every cell of authoriser path x candidate kind x candidate approver, generated rather than chosen, so no
# combination is covered on one path only.
MATRIX_REG = registry(credentials=[OWNER_CRED, PHONE_CRED, OTHER_APPROVER], credential_sequence=3)
MATRIX_PATHS = (("lan", "owner-key"), ("phone", "owner-phone"))
MATRIX_CANDIDATES = (("lan", "lan_ed25519", lan_value(CANDIDATE)), ("sms", "sms", PHONE_X))
MATRIX_APPROVERS = (("minted", "minted-a"), ("own", "owner"), ("other", "other"))
MATRIX_WORDS = {"minted": "newly minted", "own": "the authoriser's own", "other": "another existing approver"}
for p_index, (path, authorizer_id) in enumerate(MATRIX_PATHS):
    for c_index, (kind, channel, value) in enumerate(MATRIX_CANDIDATES):
        for a_index, (label, approver) in enumerate(MATRIX_APPROVERS):
            cand = {"approver_id": approver, "credential_id": "minted-c", "channel": channel, "value": value}
            ch = challenge(60 + p_index * 6 + c_index * 3 + a_index, "enrol", [cand])
            auth = authorization(OWNER, ch, authorizer_id) if path == "lan" else None
            poss = possession(CANDIDATE, ch, "minted-c") if kind == "lan" else None
            context = {"registry": MATRIX_REG, "challenges": [held(ch, sequence=3)]}
            if path == "phone":
                context["phone_authorizations"] = phone_auth(ch, authorizer_id)
            case(f"m_{path}_{kind}_{label}",
                 f"matrix: a {path} authoriser of approver owner, a {kind} candidate, and a candidate approver that "
                 f"is {MATRIX_WORDS[label]}", context, request(enrol_req(ch, cand, auth, poss)))

# --- the authoriser eligibility block ------------------------------------------------
# Every authoriser condition on both paths, generated, so an ineligible authoriser is refused on each path.
ELIG_LATE_LAN = credential("late", "late-key", "lan_ed25519", lan_value(THIRD), 4)
ELIG_LATE_PHONE = credential("late", "late-phone", "sms", "+2348033333333", 5)
ELIG_REG = registry(credentials=[OWNER_CRED, PHONE_CRED, ELIG_LATE_LAN, ELIG_LATE_PHONE], credential_sequence=5,
                    tombstoned_credentials=[tomb("gone-key", "gone"), tomb("gone-phone", "gone")],
                    tombstoned_values=[lan_value(SECOND), "+2348044444444"], tombstoned_approvers=["gone"])
ELIG_CONDITIONS = {
    # condition: (authorizer credential named on the lan path, the one attributed on the phone path)
    "absent": ("nobody", None),
    "not_active": ("gone-key", "gone-phone"),
    "wrong_kind": ("owner-phone", "owner-key"),
    "not_preexisting": ("late-key", "late-phone"),
    "eligible": ("owner-key", "owner-phone"),
}
ELIG_SIGNERS = {"late-key": THIRD}
for p_index, path in enumerate(("lan", "phone")):
    for c_index, (condition, named) in enumerate(ELIG_CONDITIONS.items()):
        ch = challenge(80 + p_index * 5 + c_index, "enrol", [SEED_CAND])
        authorizer_id = named[0] if path == "lan" else named[1]
        context = {"registry": ELIG_REG, "challenges": [held(ch, sequence=3)]}
        if path == "lan":
            auth = authorization(ELIG_SIGNERS.get(authorizer_id, OWNER), ch, authorizer_id)
        else:
            auth = None
            if authorizer_id is not None:
                context["phone_authorizations"] = phone_auth(ch, authorizer_id)
        note = f"eligibility: a {path} authoriser that is {condition.replace('_', ' ')}"
        if condition == "not_preexisting":
            note = "defence in depth, a fixture: " + note + " (enrolled after the challenge, at its revision)"
        case(f"e_{path}_{condition}", note, context, request(enrol_req(ch, SEED_CAND, auth)))

case("challenge_enrol_lan_existing_approver", "an enrolment challenge for a LAN key joining an existing approver",
     {}, request(challenge_req("enrol", "lan_ed25519", lan_value(CANDIDATE), approver="owner")))
case("challenge_local_seed_whatsapp", "a local seed candidate on whatsapp is refused at the first Challenge row it "
     "fails: lan_key_required", {"registry": registry(**EMPTY)},
     request(challenge_req("local_seed", "whatsapp", PHONE_X)))
case("enrol_phone_pending_for_value_phone_path", "a phone candidate whose value is pending, on the phone "
     "authoriser path", {**SMS_CTX, "phone_authorizations": phone_auth(SMS_CH, "owner-phone"),
                         "pending_phone_values": [SMS_CAND["value"]]},
     request(enrol_req(SMS_CH, SMS_CAND, None, None)))

# --- the refusal sweep -----------------------------------------------------------------
# One generated case per refusal row and per value of every axis that row can occur on, each decided by that
# row with every earlier row holding. Axes: the Order-of-refusal steps over every registry operation; the
# Challenges presented rows over recover, local_seed and enrol; Recover, Local seed, Revoke and Binding rows
# alone; every Enrol row over authoriser path (lan, phone) x candidate kind (lan, sms), except that the
# authorization signature row is lan-path only (a phone ORI-ENROL-V1 text carries no signature), the
# possession rows are lan-candidate only (a phone candidate carries no possession object), and
# phone_pending_for_value is sms-candidate only (only a phone candidate has a pending phone operation).
SWEEP_EXPECT: dict[str, str] = {}
DID = "defence in depth, a fixture: "


def sweep(name: str, code: str, note: str, context: dict, req: str) -> None:
    SWEEP_EXPECT[name] = code
    case(name, note, context, req)


SW_CANDS = {
    "lan": {"approver_id": "minted-a", "credential_id": "minted-c", "channel": "lan_ed25519",
            "value": lan_value(CANDIDATE)},
    "sms": {"approver_id": "minted-a", "credential_id": "minted-c", "channel": "sms", "value": PHONE_X},
}
SW_COUNTER = [100]


def enrol_cell(path: str, kind: str, *, cand: dict | None = None, reg: dict | None = None, sequence: int = 2,
               authorizer: str | None = None, signer: Ed25519PrivateKey = OWNER, state: str = "pending",
               auth_sha: str | None = None, poss: object = "good", ch_override: dict | None = None,
               extra: dict | None = None) -> tuple[dict, str]:
    """An enrolment that the runtime accepts, but for the one change the caller makes."""
    SW_COUNTER[0] += 1
    cand = cand or SW_CANDS[kind]
    ch = challenge(SW_COUNTER[0] % 256, "enrol", [cand])
    context = {"registry": registry() if reg is None else reg, "challenges": [held(ch, state, sequence)]}
    if path == "lan":
        auth = authorization(signer, ch, authorizer or "owner-key", sha=auth_sha)
    else:
        auth = None
        if authorizer != "none":
            context["phone_authorizations"] = phone_auth(ch, authorizer or "owner-phone")
    if cand["channel"] != "lan_ed25519":
        possession_obj = None
    elif poss == "good":
        possession_obj = possession(CANDIDATE, ch, cand["credential_id"])
    else:
        possession_obj = poss(ch)
    request_cand = (ch_override or {}).get("candidate", cand)
    context.update(extra or {})
    return context, request(enrol_req(ch, request_cand, auth, possession_obj))


AXES = [(p, k) for p in ("lan", "phone") for k in ("lan", "sms")]
LOCKED_REG = {"registry": None}
OTHER_SECOND = credential("other", "other-key", "lan_ed25519", lan_value(SECOND), 2)
OTHER_SMS = credential("other", "other-phone", "sms", "+2348011111111", 3)
# Every Enrol row is swept over the candidate approver as the challenge names it: minted (named by no
# request), own (the authoriser's approver) and other (another existing approver). other is swept up to
# authorizer_not_approver, which refuses it; past that row only minted and own remain. authorizer_not_approver
# is other only, and approver_revoked names a tombstoned approver (minted only in the sentence's terms).
APPROVERS_BEFORE = ("minted", "own", "other")
APPROVERS_AFTER = ("minted", "own")
for path, kind in AXES:
    cell = f"{path}_{kind}"
    late = (credential("late", "late-key", "lan_ed25519", lan_value(THIRD), 3) if path == "lan"
            else credential("late", "late-phone", "sms", "+2348033333333", 3))
    for who in APPROVERS_BEFORE:
        wcell = f"{cell}_{who}"

        def cand_for(base: dict, own: str = "owner", who: str = who) -> dict:
            if who == "minted":
                return base
            return {**base, "approver_id": own if who == "own" else "other"}

        with_other = registry(credentials=[OWNER_CRED, PHONE_CRED, OTHER_SECOND])
        if who == "minted":
            # A locked registry holds no credentials, so the approver axis is not observable here.
            ctx_, req_ = enrol_cell(path, kind)
            sweep(f"x_en_registry_unavailable_{cell}", "registry_unavailable", "sweep: Enrol, a locked registry",
                  {**ctx_, "registry": None}, req_)
        ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                reg=registry(registry_revision=4, credentials=[OWNER_CRED, PHONE_CRED, OTHER_SECOND]))
        sweep(f"x_en_challenge_stale_{wcell}", "challenge_stale", "sweep: Enrol, the revision moved", ctx_, req_)
        # minted: no such authoriser. own and other: the would-be authoriser is an active credential of approver
        # owner, of the wrong kind for the path, so the candidate approver (owner for own, other for other) is
        # defined from state relative to it.
        if who == "minted":
            wrong, wrong_note = ("nobody" if path == "lan" else "none"), "no such authoriser"
        elif path == "lan":
            wrong, wrong_note = "owner-phone", "an authorization naming approver owner's sms credential"
        else:
            wrong, wrong_note = "owner-key", "a text attributed to approver owner's LAN credential"
        ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                reg=registry(credentials=[OWNER_CRED, PHONE_CRED, OTHER_SECOND, OTHER_SMS],
                                             credential_sequence=3),
                                authorizer=wrong)
        sweep(f"x_en_authorizer_unavailable_{wcell}", "authorizer_unavailable",
              f"sweep: Enrol, no eligible authoriser: {wrong_note}", ctx_, req_)
        ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind], "late"),
                                reg=registry(credentials=[OWNER_CRED, PHONE_CRED, late, OTHER_SECOND],
                                             credential_sequence=3),
                                authorizer=late["credential_id"], signer=THIRD)
        sweep(f"x_en_authorizer_not_preexisting_{wcell}", "authorizer_not_preexisting",
              DID + "sweep: Enrol, an authoriser enrolled after the challenge at its revision", ctx_, req_)
        if path == "lan":
            ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]), auth_sha="0" * 64, reg=with_other)
            sweep(f"x_en_signature_invalid_authorization_{wcell}", "signature_invalid",
                  "sweep: Enrol, an authorization over another digest", ctx_, req_)
        if who == "other":
            ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]), reg=with_other)
            sweep(f"x_en_authorizer_not_approver_{cell}", "authorizer_not_approver",
                  "sweep: Enrol, an existing approver named and another approver authorising", ctx_, req_)
            continue
        if kind == "lan":
            ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                    poss=lambda ch: possession(CANDIDATE, ch, "minted-c", sha="0" * 64))
            sweep(f"x_en_possession_invalid_{wcell}", "possession_invalid",
                  "sweep: Enrol, a possession over another digest", ctx_, req_)
            ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                    poss=lambda ch: possession(SECOND, ch, "minted-c"))
            sweep(f"x_en_signature_invalid_possession_{wcell}", "signature_invalid",
                  "sweep: Enrol, a possession signed by another key", ctx_, req_)
        if who == "minted":
            ctx_, req_ = enrol_cell(path, kind, cand={**SW_CANDS[kind], "approver_id": "gone"},
                                    reg=registry(tombstoned_approvers=["gone"]))
            sweep(f"x_en_approver_revoked_{cell}", "approver_revoked",
                  DID + "sweep: Enrol, the challenge's approver tombstoned at its revision", ctx_, req_)
        ctx_, req_ = enrol_cell(path, kind, cand=cand_for({**SW_CANDS[kind], "credential_id": "old-key"}),
                                reg=registry(tombstoned_credentials=[tomb("old-key", "old-owner")]))
        sweep(f"x_en_credential_reused_{wcell}", "credential_reused",
              DID + "sweep: Enrol, a collision fixture: the challenge's credential ID is tombstoned", ctx_, req_)
        ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                reg=registry(tombstoned_values=[SW_CANDS[kind]["value"]]))
        sweep(f"x_en_value_tombstoned_{wcell}", "value_tombstoned",
              DID + "sweep: Enrol, the challenge's value tombstoned at its revision", ctx_, req_)
        dup = credential("dup", "dup-c", SW_CANDS[kind]["channel"], SW_CANDS[kind]["value"], 2)
        ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                reg=registry(credentials=[OWNER_CRED, PHONE_CRED, dup]))
        sweep(f"x_en_duplicate_value_{wcell}", "duplicate_value",
              DID + "sweep: Enrol, the challenge's value active at its revision", ctx_, req_)
        if kind == "sms":
            ctx_, req_ = enrol_cell(path, kind, cand=cand_for(SW_CANDS[kind]),
                                    extra={"pending_phone_values": [PHONE_X]})
            sweep(f"x_en_phone_pending_for_value_{wcell}", "phone_pending_for_value",
                  "sweep: Enrol, the value already pending", ctx_, req_)

# Challenges presented, over every operation that presents a challenge. A presented request may carry a
# candidate of any channel, whatever the challenge's operation allows: local_seed (a lan challenge) and enrol
# (a lan or an sms challenge) are each swept over the presented candidate kind (lan, sms, whatsapp), a phone
# candidate presenting no possession on enrol. A kind other than the challenge's is decided at candidate_changed
# unless an earlier row fires. recover presents no candidate. An expired sms challenge sits past the 60-second
# challenge window and inside the 10-minute possession window, so expiry follows the challenge window.
SW_LS_CH = challenge(200, "local_seed", [SEED_CAND], revision=2)
PRESENTED = {
    "lan": SEED_CAND,
    "sms": {**SEED_CAND, "channel": "sms", "value": PHONE_X},
    "whatsapp": {**SEED_CAND, "channel": "whatsapp", "value": PHONE_X},
}


def recover_present(state: str) -> dict:
    return {**LOCKED_REG, "challenges": [held(RECOVER_CH, state, 0)]}


for row, state, changes in (("site_binding_mismatch", "pending", {"verified_site_id": "site-2",
                                                                  "registry": registry()}),
                            ("challenge_reused", "used", {}), ("challenge_expired", "expired", {})):
    sweep(f"x_cp_{row}_recover", row, f"sweep: Challenges presented, {row.replace('_', ' ')}",
          {**recover_present(state), **changes}, request(RECOVER_REQ))
sweep("x_cp_candidate_changed_recover", "candidate_changed", "sweep: Challenges presented, a challenge for another "
      "operation", {**LOCKED_REG, "challenges": [held(SW_LS_CH, sequence=1)]},
      request({**RECOVER_REQ, "challenge_id": SW_LS_CH["challenge_id"]}))

CP_CHALLENGES = {
    "local_seed": (SEED_CH, {"registry": registry(**EMPTY)}, 1),
    "enrol_lan": (ENROL_CH, {}, 2),
    "enrol_sms": (SMS_CH, {}, 2),
}
for op, (ch_, base_ctx, seq_) in CP_CHALLENGES.items():
    challenge_kind = "lan" if ch_["candidates"][0]["channel"] == "lan_ed25519" else "sms"
    for shown, cand_ in PRESENTED.items():
        if op == "local_seed":
            req_ = request(seed_req(ch_, cand_, possession(CANDIDATE, ch_, "minted-c")))
        else:
            poss_ = possession(CANDIDATE, ch_, "minted-c") if shown == "lan" else None
            cand_here = cand_ if shown != challenge_kind else ch_["candidates"][0]
            req_ = request(enrol_req(ch_, cand_here, poss=poss_))
        pcell = f"{op}_presents_{shown}"
        expired_ms = 300_000 if challenge_kind == "sms" else None

        def held_as(state: str, ch_: dict = ch_, seq_: int = seq_, expired_ms: int | None = expired_ms) -> list:
            return [held(ch_, state, seq_, elapsed_ms=expired_ms if state == "expired" else None)]

        site_ctx = {**base_ctx, "registry": base_ctx.get("registry", registry())}
        sweep(f"x_cp_site_binding_mismatch_{pcell}", "site_binding_mismatch",
              "sweep: Challenges presented, a site change", {**site_ctx, "challenges": held_as("pending"),
                                                             "verified_site_id": "site-2"}, req_)
        sweep(f"x_cp_challenge_reused_{pcell}", "challenge_reused", "sweep: Challenges presented, a used challenge",
              {**base_ctx, "challenges": held_as("used")}, req_)
        sweep(f"x_cp_challenge_expired_{pcell}", "challenge_expired", "sweep: Challenges presented, an expired "
              "challenge" + (", 5 minutes after issue: past the challenge window, inside the possession window"
                             if challenge_kind == "sms" else ""), {**base_ctx, "challenges": held_as("expired")},
              req_)
        if shown == challenge_kind:
            # The same kind as the challenge: a candidate whose approver the request changed.
            changed_cand = {**ch_["candidates"][0], "approver_id": "chosen"}
            if op == "local_seed":
                creq_ = request(seed_req(ch_, changed_cand, possession(CANDIDATE, ch_, "minted-c")))
            else:
                creq_ = request(enrol_req(ch_, changed_cand, poss=possession(CANDIDATE, ch_, "minted-c")
                                          if shown == "lan" else None))
        else:
            creq_ = req_
        sweep(f"x_cp_candidate_changed_{pcell}", "candidate_changed",
              "sweep: Challenges presented, a candidate other than the challenge's", {**base_ctx,
                                                                                     "challenges": held_as("pending")},
              creq_)

# Rows that hold no challenge have no challenge kind: challenge_unavailable, and site_binding_mismatch on a
# site-changed registry, which fires before the presented ID is looked up. Each is swept over the operation and
# the presented candidate kind alone, with a challenge ID the runtime does not hold, and consumes nothing.
UNHELD = {"recover": [("", request(RECOVER_REQ))]}
for op in ("local_seed", "enrol"):
    UNHELD[op] = []
    for shown, cand_ in PRESENTED.items():
        ch_ = SEED_CH if op == "local_seed" else ENROL_CH
        if op == "local_seed":
            req_ = request(seed_req(ch_, cand_, possession(CANDIDATE, ch_, "minted-c")))
        else:
            req_ = request(enrol_req(ch_, cand_, poss=possession(CANDIDATE, ch_, "minted-c") if shown == "lan"
                                     else None))
        UNHELD[op].append((f"_presents_{shown}", req_))
for op, cells in UNHELD.items():
    base_reg = LOCKED_REG if op == "recover" else ({"registry": registry(**EMPTY)} if op == "local_seed" else {})
    for suffix, req_ in cells:
        sweep(f"x_cp_challenge_unavailable_{op}{suffix}", "challenge_unavailable",
              "sweep: Challenges presented, no challenge held", {**base_reg, "challenges": []}, req_)
        site_reg = registry(**EMPTY) if op == "local_seed" else registry()
        sweep(f"x_cp_site_binding_mismatch_unheld_{op}{suffix}", "site_binding_mismatch",
              "sweep: Challenges presented, a site change, no challenge held",
              {"registry": site_reg, "verified_site_id": "site-2", "challenges": []}, req_)

# The challenge window's boundary: exactly 60,000 ms after issue the challenge still holds; 60,001 it has expired.
for kind_, (ch_, cand_, poss_) in (("sms", (SMS_CH, SMS_CAND, None)),
                                   ("lan", (ENROL_CH, SEED_CAND, "candidate"))):
    case(f"x_cp_window_at_60000_enrol_{kind_}", "the challenge window's last millisecond: the presentation proceeds",
         {"challenges": [held(ch_, elapsed_ms=CHALLENGE_WINDOW_MS)]}, request(enrol_req(ch_, cand_, poss=poss_)))
    sweep(f"x_cp_window_at_60001_enrol_{kind_}", "challenge_expired",
          "sweep: Challenges presented, one millisecond past the challenge window",
          {"challenges": [held(ch_, "expired", elapsed_ms=CHALLENGE_WINDOW_MS + 1)]},
          request(enrol_req(ch_, cand_, poss=poss_)))

# Recover.
sweep("x_rc_recovery_not_available", "recovery_not_available", "sweep: Recover, an initialized registry",
      {"challenges": [held(RECOVER_CH, sequence=0)]}, request(RECOVER_REQ))
sweep("x_rc_challenge_stale", "challenge_stale", "sweep: Recover, a challenge for another site",
      {**LOCKED_REG, "challenges": [held({**RECOVER_CH, "site_id": "site-0"}, sequence=0)]}, request(RECOVER_REQ))

# Local seed (lan candidates only: local_seed seeds a LAN key).
SW_LS = {"registry": registry(**EMPTY), "challenges": [held(SEED_CH, sequence=1)]}
sweep("x_ls_registry_unavailable", "registry_unavailable", "sweep: Local seed, a locked registry",
      {**SW_LS, "registry": None}, request(seed_req()))
sweep("x_ls_challenge_stale", "challenge_stale", "sweep: Local seed, the revision moved",
      {**SW_LS, "registry": registry(**{**EMPTY, "registry_revision": 3})}, request(seed_req()))
sweep("x_ls_active_authorizer_exists", "active_authorizer_exists", DID + "sweep: Local seed, an active credential at "
      "the challenge's revision", {**SW_LS, "registry": registry(registry_revision=2)}, request(seed_req()))
sweep("x_ls_possession_invalid", "possession_invalid", "sweep: Local seed, a possession over another digest", SW_LS,
      request(seed_req(poss=possession(CANDIDATE, SEED_CH, "minted-c", sha="0" * 64))))
sweep("x_ls_signature_invalid", "signature_invalid", "sweep: Local seed, a possession signed by another key", SW_LS,
      request(seed_req(poss=possession(SECOND, SEED_CH, "minted-c"))))
for row, field, value in (("approver_revoked", "approver_id", "old-owner"), ("credential_reused", "credential_id",
                                                                             "old-key")):
    cand_ = {**SEED_CAND, field: value}
    ch_ = challenge(210 + len(row), "local_seed", [cand_], revision=2)
    sweep(f"x_ls_{row}", row, DID + f"sweep: Local seed, a collision fixture: the challenge's {field} is tombstoned",
          {"registry": registry(**EMPTY), "challenges": [held(ch_, sequence=1)]},
          request(seed_req(ch_, cand_, possession(CANDIDATE, ch_, cand_["credential_id"]))))
cand_ = {**SEED_CAND, "value": lan_value(SECOND)}
ch_ = challenge(230, "local_seed", [cand_], revision=2)
sweep("x_ls_value_tombstoned", "value_tombstoned", DID + "sweep: Local seed, the challenge's value tombstoned at its "
      "revision", {"registry": registry(**EMPTY), "challenges": [held(ch_, sequence=1)]},
      request(seed_req(ch_, cand_, possession(SECOND, ch_, "minted-c"))))

# Revoke and Binding.
REV_DOC = REVOKE_1
for row, context_, doc_ in (
    ("anchor_unavailable", {"anchor_available": False}, REV_DOC),
    ("malformed", {}, {**REV_DOC, "add": ["credential:x"]}),
    ("unknown_signer", {}, revocation(1, ["credential:owner-phone"], key=STRANGER)),
    ("signature_invalid", {}, {**REV_DOC, "signature": flip(REV_DOC["signature"])}),
    ("superseded_signer", {}, revocation(1, ["credential:owner-phone"], key=PREVIOUS)),
    ("wrong_authority", {}, revocation(1, ["credential:owner-phone"], key=OTHER_CLASS)),
    ("registry_unavailable", LOCKED_REG, REV_DOC),
    ("site_binding_mismatch", {"verified_site_id": "site-2"}, REV_DOC),
    ("binding_mismatch", {}, revocation(1, ["credential:owner-phone"], epoch=OLD_EPOCH)),
    ("revision_regressed", {"registry": registry(last_external_revision=5, last_external_document_sha256="0" * 64)},
     REV_DOC),
    ("revision_conflict", {"registry": CONFLICT_REG}, revocation(1, OTHER_1)),
    ("unknown_target", {}, revocation(1, ["credential:never"])),
):
    sweep(f"x_rv_{row}", row, f"sweep: Revoke, {row.replace('_', ' ')}", context_,
          request({**REVOKE_REQ, "document": doc_}))
sweep("x_bd_registry_unavailable", "registry_unavailable", "sweep: Binding, a locked registry", LOCKED_REG,
      request(BINDING))
sweep("x_bd_site_binding_mismatch", "site_binding_mismatch", "sweep: Binding, a site change",
      {"verified_site_id": "site-2"}, request(BINDING))

# The Order-of-refusal steps, over every registry operation.
SW_OPS = {
    "challenge": ({}, challenge_req("enrol", "lan_ed25519", lan_value(CANDIDATE))),
    "recover": (REC, RECOVER_REQ),
    "local_seed": (SW_LS, seed_req()),
    "enrol": (ENROL_CTX, enrol_req()),
    "revoke": ({}, REVOKE_REQ),
    "binding": ({}, BINDING),
}
for op, (context_, obj_) in SW_OPS.items():
    sweep(f"x_steps_payload_too_large_{op}", "payload_too_large", "sweep: Order of refusal, over the bound",
          context_, padded(obj_, BOUND + 1))
    sweep(f"x_steps_invalid_arguments_{op}", "invalid_arguments", "sweep: Order of refusal, an unaccepted member",
          context_, request({**obj_, "extra": 1}))
    sweep(f"x_steps_unauthenticated_{op}", "unauthenticated", "sweep: Order of refusal, an unadmitted peer",
          {**context_, "peer_uid": 1002}, request(obj_))
    sweep(f"x_steps_registry_busy_{op}", "registry_busy", "sweep: Order of refusal, another operation in flight",
          {**context_, "registry_operation_in_flight": True}, request(obj_))
    sweep(f"x_steps_registry_unavailable_{op}", "registry_unavailable", "sweep: Order of refusal, no verified site",
          {**context_, "verified_site_id": None}, request(obj_))

# The two steps a v2 operation reaches before its own members are read.
COMMISSION = {"operation": "evidence_commission", "reference": "sha256:" + "ab" * 32, "force": False}
sweep("x_steps_payload_too_large_evidence_commission", "payload_too_large",
      "sweep: Order of refusal, a commissioning request over the bound", {}, padded(COMMISSION, BOUND + 1))
sweep("x_steps_invalid_arguments_evidence_commission", "invalid_arguments",
      "sweep: Order of refusal, a commissioning request naming a member twice", {},
      request(COMMISSION).replace('"force":false', '"force":false,"force":false'))

# The Challenge table for an enrolment challenge, over candidate kind (lan, sms) and the approver the request
# names (null: minted; named: an existing approver, owner). channel_unauthenticated needs a whatsapp candidate
# and phone_pending_for_value a phone candidate; approver_revoked and approver_unknown need a named approver.
CH_KINDS = {"lan": ("lan_ed25519", lan_value(CANDIDATE)), "sms": ("sms", PHONE_X)}
for kind, (channel, value) in CH_KINDS.items():
    for who, approver in (("null", None), ("named", "owner")):
        ccell = f"enrol_{kind}_{who}"
        req_ = request(challenge_req("enrol", channel, value, approver=approver))
        sweep(f"x_ch_site_binding_mismatch_{ccell}", "site_binding_mismatch", "sweep: Challenge, a site change",
              {"verified_site_id": "site-2"}, req_)
        sweep(f"x_ch_registry_unavailable_{ccell}", "registry_unavailable", "sweep: Challenge, a locked registry",
              LOCKED_REG, req_)
        sweep(f"x_ch_value_tombstoned_{ccell}", "value_tombstoned", "sweep: Challenge, a tombstoned value",
              {"registry": registry(tombstoned_values=[value])}, req_)
        dup = credential("dup", "dup-c", channel, value, 2)
        sweep(f"x_ch_duplicate_value_{ccell}", "duplicate_value", "sweep: Challenge, an active value",
              {"registry": registry(credentials=[OWNER_CRED, PHONE_CRED, dup])}, req_)
        if kind == "sms":
            sweep(f"x_ch_phone_pending_for_value_{ccell}", "phone_pending_for_value",
                  "sweep: Challenge, a pending value", {"pending_phone_values": [value]}, req_)
for who, approver in (("null", None), ("named", "owner")):
    sweep(f"x_ch_channel_unauthenticated_enrol_whatsapp_{who}", "channel_unauthenticated",
          "sweep: Challenge, a whatsapp candidate", {},
          request(challenge_req("enrol", "whatsapp", PHONE_X, approver=approver)))
    sweep(f"x_ch_channel_unauthenticated_enrol_sms_no_ingress_{who}", "channel_unauthenticated",
          "sweep: Challenge, an sms candidate while the runtime has no authenticated SMS ingress",
          {"authenticated_phone_channels": []}, request(challenge_req("enrol", "sms", PHONE_X, approver=approver)))
sweep("x_ch_approver_revoked_enrol_lan_named", "approver_revoked", "sweep: Challenge, a tombstoned approver named",
      {"registry": registry(tombstoned_approvers=["gone"])},
      request(challenge_req("enrol", "lan_ed25519", lan_value(CANDIDATE), approver="gone")))
sweep("x_ch_approver_unknown_enrol_lan_named", "approver_unknown", "sweep: Challenge, an unknown approver named",
      {}, request(challenge_req("enrol", "lan_ed25519", lan_value(CANDIDATE), approver="nobody")))

# Member strictness by where in the request the member sits: an escaped spelling of a member already present,
# a case variant of an accepted member, and an unknown member, at the top level and inside a candidate,
# possession, authorization and revocation document. Inside a document each is the document's fault.
ENROL_TEXT = request(enrol_req())
LOCATIONS = {
    "top": ('{"operation":"approver_registry_binding"', ',"\\u006fperation":"approver_registry_binding"',
            ',"Operation":"approver_registry_binding"', ',"x":1', {}, request(BINDING)),
    "candidate": ('"candidate":{"approver_id":"minted-a"', ',"\\u0061pprover_id":"minted-a"',
                  ',"Approver_id":"minted-a"', ',"x":1', ENROL_CTX, ENROL_TEXT),
    "authorization": ('"authorization":{"v":1', ',"\\u0076":1', ',"V":1', ',"x":1', ENROL_CTX, ENROL_TEXT),
    "possession": ('"possession":{"v":1', ',"\\u0076":1', ',"V":1', ',"x":1', ENROL_CTX, ENROL_TEXT),
    "document": ('"document":{"v":1', ',"\\u0076":1', ',"V":1', ',"x":1', {}, request(REVOKE_REQ)),
}
for location, (anchor_, escaped, variant, unknown, context_, text_) in LOCATIONS.items():
    assert text_.count(anchor_) == 1, location
    code = "malformed" if location == "document" else "invalid_arguments"
    for label, insert in (("escaped_duplicate", escaped), ("case_variant", variant), ("unknown_member", unknown)):
        sweep(f"x_ms_{label}_{location}", code, f"sweep: member strictness, {label.replace('_', ' ')} inside "
              f"the {location}" if location != "top" else f"sweep: member strictness, {label.replace('_', ' ')} "
              "at the top level", context_, text_.replace(anchor_, anchor_ + insert, 1))

# Lows the sweep does not reach on its own.
case("challenge_local_seed_value_tombstoned", "a local seed challenge for a key tombstoned in this epoch",
     {"registry": registry(**EMPTY)}, request(challenge_req("local_seed", "lan_ed25519", lan_value(SECOND))))

# Integer members: JSON integers only, revisions at most 2^53 - 1.
for label, text_v in (("fraction", "1.0"), ("exponent", "1e0")):
    case(f"rv_malformed_v_{label}", f"a document whose v is written {text_v}, not as a JSON integer", {},
         request(REVOKE_REQ).replace('"document":{"v":1', '"document":{"v":' + text_v, 1))
case("rv_malformed_revision_over_2_53", "a document whose revision is 2^53, past 2^53 - 1", {},
     request({**REVOKE_REQ, "document": revocation(2 ** 53, ["credential:owner-phone"])}))
case("rv_revision_at_2_53_minus_1", "a document whose revision is 2^53 - 1 is accepted", {},
     request({**REVOKE_REQ, "document": revocation(2 ** 53 - 1, ["credential:owner-phone"])}))
case("possession_v_exponent", "a request member written with an exponent is not an integer", SEED_CTX,
     request(seed_req()).replace('"possession":{"v":1', '"possession":{"v":1e0', 1))

# Raw decoding: JSON token types and every member value are kept as written.
for label, raw_value in (("exponent", "1e0"), ("integer", "1")):
    case(f"challenge_approver_id_{label}", f"an approver_id written {raw_value} is not a string",
         {}, request(challenge_req("enrol", "sms", PHONE_X, approver="owner")).replace('"approver_id":"owner"',
                                                                                     '"approver_id":' + raw_value, 1))
HUGE = "9" * 5000
case("rv_malformed_revision_5000_digits", "a revision of 5,000 digits, under the request bound, is a JSON integer "
     "over 2^53 - 1: malformed", {}, request(REVOKE_REQ).replace('"revision":1', '"revision":' + HUGE, 1))
case("rv_shadowed_no_utf8_in_document", "a member named twice inside the document whose shadowed value has no UTF-8 "
     "form: the parse failure decides before the document's malformed", {},
     request(REVOKE_REQ).replace('"document":{"v":1', '"document":{"v":1,"device_id":"\\ud800"', 1))
case("shadowed_no_utf8_top_level", "a member named twice whose shadowed value has no UTF-8 form", {},
     '{"operation":"\\ud800","operation":"approver_registry_binding"}')

# SMS ingress availability.
case("challenge_enrol_sms_no_sms_ingress", "an sms candidate while the runtime has no authenticated SMS ingress: "
     "nothing recorded, no code sent", {"authenticated_phone_channels": []},
     request(challenge_req("enrol", "sms", PHONE_X)))

# The first ORI-ENROL-V1 text for a challenge is its authorization.
TEXT_REG = registry(credentials=[OWNER_CRED, PHONE_CRED, OTHER_APPROVER, OTHER_PHONE], credential_sequence=4)
for label, order in (("own_first", ("owner-phone", "other-phone")), ("other_first", ("other-phone", "owner-phone")),
                     ("wrong_digest_first", ("wrong-digest", "owner-phone")),
                     ("later_unknown", ("owner-phone", "nobody")), ("unknown_first", ("nobody", "owner-phone"))):
    texts = [{"challenge_id": SAME_CH["challenge_id"],
              "challenge_sha256": "0" * 64 if who == "wrong-digest" else digest(SAME_CH),
              "authorizer_credential_id": "owner-phone" if who == "wrong-digest" else who} for who in order]
    case(f"enrol_phone_texts_{label}", f"two ORI-ENROL-V1 texts for one challenge, {order[0]} first: the first is "
         "its authorization and the later one changes nothing",
         {"registry": TEXT_REG, "challenges": [held(SAME_CH, sequence=4)], "phone_authorizations": texts},
         request(enrol_req(SAME_CH, SAME_CAND, None)))

CODES = (
    "payload_too_large", "invalid_arguments", "unauthenticated", "registry_busy", "lan_key_required",
    "channel_unauthenticated", "site_binding_mismatch", "recovery_not_available", "registry_unavailable",
    "active_authorizer_exists", "approver_unknown", "challenge_reused", "challenge_unavailable",
