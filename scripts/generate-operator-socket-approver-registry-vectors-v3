     {"peer_uid": 1002}, padded(BINDING, BOUND + 1))
case("over_bound_while_in_flight", "the bound is decided before serialisation",
     {"registry_operation_in_flight": True}, padded(BINDING, BOUND + 1))
case("over_bound_reconcile", "the bound applies to every operation on the socket, decided before the operation is read",
     {}, padded(RECONCILE, BOUND + 1))
case("over_bound_not_json", "bytes that would not parse are refused at the bound without parsing",
     {}, "x" * (BOUND + 1))

