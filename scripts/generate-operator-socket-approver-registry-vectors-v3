     "possession for another digest, a tombstoned approver, credential ID and value, and an active value",
     {"registry": registry(registry_revision=4, **TOMB_LAN), "challenges": [held(LS_CH)]},
     request(seed_req(LS_CH, BAD_CAND, LS_WRONG)))
case("ls_order_active_authorizer_exists", "defence in depth, a fixture: an active credential at the challenge's "
     "revision; it decides over every later row",
     {"registry": registry(**TOMB_LAN), "challenges": [held(LS_CH)]}, request(seed_req(LS_CH, BAD_CAND, LS_WRONG)))
TOMB_EMPTY = dict(registry_revision=3, credentials=[], tombstoned_values=[lan_value(SECOND)],
                  tombstoned_approvers=["gone"], tombstoned_credentials=[tomb("old-key", "gone")])
case("ls_order_possession_invalid", "possession_invalid decides over a tombstoned approver, credential ID and value",
     {"registry": registry(**TOMB_EMPTY), "challenges": [held(LS_CH)]},
     request(seed_req(LS_CH, BAD_CAND, LS_WRONG)))
case("ls_order_signature_invalid", "signature_invalid decides over a tombstoned approver, credential ID and value",
     {"registry": registry(**TOMB_EMPTY), "challenges": [held(LS_CH)]},
     request(seed_req(LS_CH, BAD_CAND, possession(OWNER, LS_CH, "old-key"))))
case("ls_order_approver_revoked", "defence in depth, a collision fixture: approver_revoked decides over a "
     "tombstoned credential ID and value",
     {"registry": registry(**TOMB_EMPTY), "challenges": [held(LS_CH)]},
     request(seed_req(LS_CH, BAD_CAND, possession(SECOND, LS_CH, "old-key"))))
LS_CH2 = seed_fixture(21, {**BAD_CAND, "approver_id": "fresh"})
case("ls_order_credential_reused", "defence in depth, a collision fixture: credential_reused decides over a "
     "tombstoned value", {"registry": registry(**TOMB_EMPTY), "challenges": [held(LS_CH2)]},
     request(seed_req(LS_CH2, {**BAD_CAND, "approver_id": "fresh"}, possession(SECOND, LS_CH2, "old-key"))))
LS_CAND3 = {**BAD_CAND, "approver_id": "fresh", "credential_id": "fresh-c"}
LS_CH3 = seed_fixture(22, LS_CAND3)
case("ls_value_tombstoned", "defence in depth, a fixture: a value tombstoned at the challenge's revision",
     {"registry": registry(**TOMB_EMPTY), "challenges": [held(LS_CH3)]},
     request(seed_req(LS_CH3, LS_CAND3, possession(SECOND, LS_CH3, "fresh-c"))))
for label, bad, scalar in (("small_order", EIGHT_TORSION_KEY, 0),
                           ("mixed_order", mixed_order(raw_public(CANDIDATE)), seed_scalar("candidate LAN credential")),
                           ("noncanonical", NONCANONICAL_KEY, None)):
    cand_bad = {**SEED_CAND, "value": "ed25519:" + b64(bad)}
    ch_bad = challenge(30 + len(label), "local_seed", [cand_bad], revision=2)
    unsigned = {"v": 1, "challenge_id": ch_bad["challenge_id"], "challenge_sha256": digest(ch_bad),
                "candidate_credential_id": "minted-c"}
    poss_bad = (possession(CANDIDATE, ch_bad, "minted-c") if scalar is None else
                sign_ground(scalar, bad, b"ori.tier_c_approver.possession.v1", unsigned))
    case(f"ls_candidate_key_{label}",
         f"a candidate key that fails ed25519-key-admission/v1 ({label.replace('_', ' ')})"
         + ("" if scalar is None else "; its possession satisfies the cofactorless equation, so admission "
            "alone refuses it"),
         {"registry": registry(**EMPTY), "challenges": [held(ch_bad, sequence=1)]},
         request(seed_req(ch_bad, cand_bad, poss_bad)))

