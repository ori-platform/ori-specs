# --- framing --------------------------------------------------------------------
case("lf_inside_json", "an LF inside the JSON text cuts the request there; the bytes before it are not one object",
     {}, '{"operation":\n"approver_registry_binding"}')
case("bytes_after_lf_ignored", "the bytes after the first LF are not read", {},
     request(BINDING) + "\n" + '{"operation":"approver_registry_add"}')
MULTI = {"operation": "approver_registry_binding", "x": ""}
MULTI_TEXT = request(MULTI)
MULTI_REQ = MULTI_TEXT[:-2] + "é" * (BOUND - len(MULTI_TEXT)) + '"}'
assert len(MULTI_REQ) == BOUND and len(MULTI_REQ.encode("utf-8")) > BOUND
case("bound_counts_bytes", "16,384 characters of which some are two UTF-8 bytes exceed the bound", {}, MULTI_REQ)

