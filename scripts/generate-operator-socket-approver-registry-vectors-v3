     request(REVOKE_REQ).replace('"device_id":"edge-1"', '"device_id":"\\ud800"', 1))
for label, changes in (("site_id_non_ascii", {"site_id": "sité"}), ("site_id_empty", {"site_id": ""}),
                       ("device_id_space", {"device_id": "edge 1"})):
    case(f"rv_malformed_{label}", f"a document whose {label.split('_')[0]}_id is outside ^[A-Za-z0-9._-]{{1,64}}$",
         {}, request({**REVOKE_REQ, "document": signed_doc(**changes)}))
