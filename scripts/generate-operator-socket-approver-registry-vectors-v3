# --- local seed order ----------------------------------------------------------
BAD_CAND = {"approver_id": "gone", "credential_id": "old-key", "channel": "lan_ed25519", "value": lan_value(SECOND)}


def seed_fixture(n: int, cand: dict, revision: int = 3) -> dict:
    return challenge(n, "local_seed", [cand], revision=revision)


LS_CH = seed_fixture(20, BAD_CAND)
LS_WRONG = possession(SECOND, LS_CH, "old-key", sha="0" * 64)
case("ls_order_registry_unavailable", "a locked registry decides over a possession for another digest",
     {**LOCKED, "challenges": [held(LS_CH)]}, request(seed_req(LS_CH, BAD_CAND, LS_WRONG)))
