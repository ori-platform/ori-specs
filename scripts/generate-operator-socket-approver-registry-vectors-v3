UP_TO_SIGNATURE_ROW = {
    ("approver_registry_revoke", "document"): ("anchor_unavailable", "malformed", "unknown_signer",
                                               "signature_invalid"),
    ("approver_registry_local_seed", "possession"): ("challenge_stale", "active_authorizer_exists",
                                                     "possession_invalid", "signature_invalid"),
    ("approver_registry_enrol", "authorization"): ("challenge_stale", "authorizer_unavailable",
                                                   "authorizer_not_preexisting", "signature_invalid"),
    ("approver_registry_enrol", "possession"): ("challenge_stale", "authorizer_unavailable",
                                                "authorizer_not_preexisting", "signature_invalid",
                                                "possession_invalid"),
}


def signature_may_fail(req: str, label: str, expected: dict) -> bool:
    """The signatures note: a deciding row at or before the object's signature row."""
    code = expected.get("code")
    if code is None:
        return False
    if code in STEP_CODES and code != "registry_unavailable":
        return True
    op = json.loads(frame(req).decode("utf-8"))["operation"]
    return code == "registry_unavailable" or code in UP_TO_SIGNATURE_ROW[(op, label)]


def context_keys(context: dict) -> list:
    keys = list(context["anchors"].values())
    for cred in (context["registry"] or {}).get("credentials", []):
        if cred["channel"] == "lan_ed25519":
            keys.append(cred["value"][8:])
    return keys


def check_fixture_keys(name: str, context: dict) -> None:
    """A context key fails admission exactly when the fixture lists it as doing so."""
    listed = set(context["keys_failing_admission"])
    for key in context_keys(context):
        assert admitted(base64.b64decode(key)) == (key not in listed), (name, key)
    assert listed <= set(context_keys(context)), name


def signed_objects_verify(context: dict, req: str) -> list:
    try:
        parsed = json.loads(frame(req).decode("utf-8"))
    except ValueError:
        return []
    if not isinstance(parsed, dict):
        return []
    creds = {c["credential_id"]: c for c in (context["registry"] or {}).get("credentials", [])}
    out = []
    cand, poss, auth, doc = (parsed.get(k) for k in ("candidate", "possession", "authorization", "document"))

    def check(label: str, value: object, domain: bytes, signed: dict) -> None:
        try:
            out.append((label, verifies(base64.b64decode(str(value)[8:]), domain, signed)))
        except (ValueError, KeyError, TypeError):
            out.append((label, False))

    if isinstance(cand, dict) and isinstance(poss, dict) and str(cand.get("value", "")).startswith("ed25519:"):
        check("possession", cand["value"], b"ori.tier_c_approver.possession.v1", poss)
    if isinstance(auth, dict) and auth.get("authorizer_credential_id") in creds:
        key = creds[auth["authorizer_credential_id"]]["value"]
        if key.startswith("ed25519:"):
            check("authorization", key, b"ori.tier_c_approver.enrol.v1", auth)
    if isinstance(doc, dict) and str(doc.get("signing_key", "")).startswith("ed25519:"):
        check("document", doc["signing_key"], b"ori.tier_c_approver.revoke.v1", doc)
    return out


def is_challenge_request(req: str) -> bool:
    try:
        parsed = json.loads(frame(req).decode("utf-8"))
    except ValueError:
        return False
    return isinstance(parsed, dict) and parsed.get("operation") == "approver_registry_challenge"


def build() -> dict:
    cases = []
    seen = set()
    for name, note, context, req, terminated in CASES:
        assert name not in seen, name
        seen.add(name)
        context = copy.deepcopy(context)
        if is_challenge_request(req):
            # context.minted is set exactly when the Challenge table judges the request.
            context["minted"] = MINTED
            TABLE[0] = False
            expected = answer(context, req, terminated)
            if not (expected["ok"] or TABLE[0]):
                context["minted"] = None
        expected = answer(context, req, terminated)
        if not expected["ok"]:
            assert expected["code"] in CODES, expected
        if name in SWEEP_EXPECT:
            assert expected.get("code") == SWEEP_EXPECT[name], (name, expected)
        check_fixture_keys(name, context)
        for label, verified in signed_objects_verify(context, req):
            assert verified or signature_may_fail(req, label, expected), f"{name}: its {label} does not verify"
        cases.append({
            "name": name,
            "note": note,
            "context": context,
            "request": req,
            "request_bytes": len(req.encode("utf-8")),
            "terminated": terminated,
            "expected": expected,
        })
    missing = set(CODES) - {c["expected"].get("code") for c in cases}
    assert not missing, sorted(missing)
    return {
        "contract": "operator-socket/v3",
        "section": "Approver Registry Operations",
        "bound_bytes": BOUND,
        "codes": list(CODES),
        "note": NOTE,
        "cases": cases,
    }


def render() -> bytes:
    return (json.dumps(build(), indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = render()
    if argv[1:] == ["--check"]:
        if not OUT.exists() or OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator", file=sys.stderr)
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
