def nested_targets(depth: int) -> str:
    """A revocation whose deepest array sits at nesting `depth`; the request object is level 1."""
    arrays = depth - 2
    doc = json.dumps({k: v for k, v in REVOKE_1.items() if k != "targets"}, separators=(",", ":"),
                     ensure_ascii=False)
    doc = doc[:-1] + ',"targets":' + "[" * arrays + "]" * arrays + "}"
    return '{"operation":"approver_registry_revoke","document":' + doc + "}"


case("nesting_at_32", "nesting of exactly 32 levels is parsed; the document is malformed", {}, nested_targets(32))
