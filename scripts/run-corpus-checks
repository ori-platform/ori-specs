#!/bin/sh
# Copyright 2026 Ori Nexus Systems LTD
# SPDX-License-Identifier: Apache-2.0
#
# Run every corpus and status check this repository's CI runs, in the same
# order, with each checker's own interface, and stop at the first failure.
# This is the finish-line gate for a change: a loop over scripts/check-* is
# not, because the scripts do not share one interface and a loop without
# fail-fast hides an earlier failure behind a later success.
set -eu
cd "$(dirname "$0")/.."
run() { printf '%s\n' "== $*"; "$@"; }
run python3 scripts/check-contract-status
run python3 scripts/check-contract-status --mutations
run python3 scripts/check-skills-package-vectors
run python3 scripts/check-safety-profile-vectors
run python3 scripts/check-runtime-config-vectors
run python3 scripts/check-runtime-config-orchestration-vectors
run python3 scripts/check-contract-yaml-blocks --mutations
run python3 scripts/check-evidence-vectors
run python3 scripts/check-evidence-vectors-mutations
run python3 scripts/check-evidence-commissioning-vectors --mutations
run python3 scripts/check-evidence-commissioning-ingest-vectors --mutations
run python3 scripts/check-evidence-transport-retention-vectors --mutations
run python3 scripts/check-evidence-handoff-vectors --mutations
run python3 scripts/check-runtime-evidence-anchor-vectors --mutations
run python3 scripts/check-tier-c-approval-vectors --mutations
run python3 scripts/check-evidence-patf-clauses --mutations
run python3 scripts/check-evidence-disposition-vectors --mutations
run python3 scripts/check-evidence-transport-refusal-policy-vectors --mutations
run python3 scripts/check-gateway-site-health-evidence-vectors --mutations
run python3 scripts/check-evidence-routing-projection-vectors --mutations
run python3 scripts/check-gateway-return-path-vectors --mutations
run python3 scripts/check-evidence-transport-capability-vectors --mutations
run python3 scripts/check-gateway-config-evidence-vectors --mutations
run python3 scripts/check-commissioned-binding-vectors
run python3 scripts/check-commissioned-binding-vectors-mutations
run python3 scripts/check-safety-qualification-fixture-vectors
run python3 scripts/check-capability-grant-vectors
run python3 scripts/check-capability-grant-issuance-vectors
run python3 scripts/check-runtime-mobile-payload-vectors
run python3 scripts/check-runtime-mobile-payload-vectors-mutations
printf '%s\n' "== every check passed"
