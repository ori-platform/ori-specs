#!/usr/bin/env python3
"""Check the runtime-evidence-anchor vectors against their contract.

Every `key_id`, `capability_hash` and `anchor_epoch_id` is derived again from
the case inputs; every refused profile must break a rule the contract states
for `artifact_purposes` (sorted, without duplicates, from the closed purpose
vocabulary evidence-exchange/v2 lists); and each migration's claims are
recomputed from the two cases it joins, against the migration rule the contract
states word for word.

    python3 scripts/check-runtime-evidence-anchor-vectors
    python3 scripts/check-runtime-evidence-anchor-vectors --mutations

`--mutations` flips one character of every derived value, drops each refused
profile and migration, sorts each refused profile into acceptance, and rewords
each rule the checker reads, and requires every mutant to be refused.
"""

from __future__ import annotations

import copy
import hashlib
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "runtime-evidence-anchor" / "v2.md"
EXCHANGE = ROOT / "evidence-exchange" / "v2.md"
VECTORS = ROOT / "runtime-evidence-anchor" / "vectors" / "runtime-anchor-v2.json"
SENTENCES = {
    "sorted": "MUST be sorted, MUST contain no duplicates, and MUST be drawn from the closed purpose vocabulary",
    "changes_epoch": (
        "Adding, removing, or renaming a verified artifact purpose changes `capability_hash` and therefore "
        "`anchor_epoch_id`."
    ),
    "migration": "A release that changes `artifact_purposes` MUST declare an evidence-epoch migration.",
    "no_transfer": (
        "it MUST NOT infer confirmation for the new epoch or transfer a reference between epochs."
    ),
    "identity_kept": (
        "The migration changes only the epoch: `device_id`, `key_id` and the identity's monotonic counters are "
        "unchanged,"
    ),
    "carriage_rule": (
        "Present only when non-empty: a profile declaring none omits the member, and an empty array, an unsorted or "
        "duplicated entry, or an entry outside the vocabulary is refused as for `artifact_purposes`."
    ),
    "carriage_epoch": (
        "Declaring it is not implied by any verified artifact purpose, including `evidence_authority_disposition`. "
        "Adding it changes `capability_hash` and therefore `anchor_epoch_id`,"
    ),
}


class CheckError(Exception):
    pass


def _norm(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def canonical(obj) -> bytes:
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False).encode()


def digest(obj) -> str:
    return "sha256:" + hashlib.sha256(canonical(obj)).hexdigest()


def load_contract(text: str, exchange: str) -> dict:
    prose = _norm(text)
    for key, sentence in SENTENCES.items():
        if _norm(sentence) not in prose:
            raise CheckError(f"runtime-evidence-anchor/v2 no longer states the {key} rule this checker reads")
    table = exchange[exchange.find("| Purpose | Held by | Trust root |"):]
    purposes = set(re.findall(r"^\| `(\w+)` \|", table.split("\n\n", 1)[0], re.MULTILINE))
    if not purposes:
        raise CheckError("evidence-exchange/v2 no longer carries the key purposes table")
    capability_table = text[text.find("| Capability | Declares |"):]
    carriage = set(re.findall(r"^\| `(\w+)` \|", capability_table.split("\n\n", 1)[0], re.MULTILINE))
    if "checkpoint_fifo_handoff_v1" not in carriage:
        raise CheckError("runtime-evidence-anchor/v2 no longer carries the carriage-capability vocabulary")
    return {"purposes": purposes, "carriage": carriage}


MODEL_MUTANTS = {"empty_capabilities_admitted": False, "unknown_capability_admitted": False}


def refusal(contract: dict, inputs: dict) -> str | None:
    profile = inputs["capability_profile"]
    purposes = profile["artifact_purposes"]
    if len(set(purposes)) != len(purposes):
        return "duplicated"
    if purposes != sorted(purposes):
        return "unsorted"
    if set(purposes) - contract["purposes"]:
        return "unknown"
    if "carriage_capabilities" in profile:
        carriage = profile["carriage_capabilities"]
        if not carriage and not MODEL_MUTANTS["empty_capabilities_admitted"]:
            return "empty_capabilities"
        if len(set(carriage)) != len(carriage):
            return "duplicated_capability"
        if carriage != sorted(carriage):
            return "unsorted_capability"
        if set(carriage) - contract["carriage"] and not MODEL_MUTANTS["unknown_capability_admitted"]:
            return "unknown_capability"
    return None


def derive(inputs: dict) -> tuple[str, str, str]:
    key_id = digest({"device_id": inputs["device_id"], "public_key_b64": inputs["public_key_b64"], "v": 1})
    capability = digest(inputs["capability_profile"])
    epoch = digest({"capability_hash": capability, "device_id": inputs["device_id"], "posture": inputs["posture"],
                    "public_key_b64": inputs["public_key_b64"], "v": 1})
    return key_id, capability, epoch


def check(contract: dict, document: dict) -> None:
    cases = {}
    for case in document["cases"]:
        if refusal(contract, case["inputs"]) is not None:
            raise CheckError(f"{case['name']}: a derived case breaks the artifact_purposes rule")
        if derive(case["inputs"]) != (case["key_id"], case["capability_hash"], case["anchor_epoch_id"]):
            raise CheckError(f"{case['name']}: the identifiers do not derive from the inputs")
        cases[case["name"]] = case
    for profile in document["refused_profiles"]:
        got = refusal(contract, profile["inputs"])
        if got != profile["refusal"]:
            raise CheckError(f"{profile['name']}: declares {profile['refusal']}, the contract gives {got}")
    if {p["refusal"] for p in document["refused_profiles"]} != {"unsorted", "duplicated", "unknown",
                                                                 "empty_capabilities", "duplicated_capability",
                                                                 "unknown_capability"}:
        raise CheckError("the refused profiles must cover unsorted, duplicated and unknown purposes, and an empty, "
                         "duplicated or unknown carriage capability")
    declaring = [c for c in document["cases"]
                 if "checkpoint_fifo_handoff_v1" in c["inputs"]["capability_profile"].get("carriage_capabilities", [])]
    if not declaring:
        raise CheckError("no case derives an epoch declaring checkpoint_fifo_handoff_v1")
    for case in declaring:
        bare = copy.deepcopy(case["inputs"])
        del bare["capability_profile"]["carriage_capabilities"]
        if derive(bare)[2] == case["anchor_epoch_id"] or derive(bare)[0] != case["key_id"]:
            raise CheckError(f"{case['name']}: declaring a carriage capability must change the epoch and not the key")
        if not any(c["inputs"] == bare for c in document["cases"]):
            raise CheckError(f"{case['name']}: no case derives the same profile without the carriage capability")
    if not document["migrations"]:
        raise CheckError("no epoch migration case")
    for migration in document["migrations"]:
        old, new = cases[migration["from"]], cases[migration["to"]]
        old_purposes = old["inputs"]["capability_profile"]["artifact_purposes"]
        new_purposes = new["inputs"]["capability_profile"]["artifact_purposes"]
        rest = {k: v for k, v in old["inputs"].items() if k != "capability_profile"}
        if rest != {k: v for k, v in new["inputs"].items() if k != "capability_profile"} or old_purposes == new_purposes:
            raise CheckError(f"{migration['name']}: a migration changes artifact_purposes and nothing else")
        want = {
            "device_id_unchanged": old["inputs"]["device_id"] == new["inputs"]["device_id"],
            "key_id_unchanged": old["key_id"] == new["key_id"],
            "epoch_changed": old["anchor_epoch_id"] != new["anchor_epoch_id"],
            "counters_unchanged": True,
            "reference_binds_new_epoch": False,
            "confirmation_transfers": False,
        }
        if migration["expected"] != want:
            raise CheckError(f"{migration['name']}: declares {migration['expected']}, the contract gives {want}")
    if "evidence_authority_disposition" not in contract["purposes"] or not any(
        "evidence_authority_disposition" in c["inputs"]["capability_profile"]["artifact_purposes"]
        for c in document["cases"]
    ):
        raise CheckError("no case derives an epoch for a runtime that verifies dispositions")


def mutants(document: dict, text: str, exchange: str):
    for i, case in enumerate(document["cases"]):
        for field in ("key_id", "capability_hash", "anchor_epoch_id"):
            bad = copy.deepcopy(document)
            value = bad["cases"][i][field]
            bad["cases"][i][field] = value[:-1] + ("0" if value[-1] != "0" else "1")
            yield f"{case['name']} {field}", bad, text, exchange
    for i, profile in enumerate(document["refused_profiles"]):
        bad = copy.deepcopy(document)
        del bad["refused_profiles"][i]
        yield f"without {profile['name']}", bad, text, exchange
    for i, migration in enumerate(document["migrations"]):
        for key in migration["expected"]:
            bad = copy.deepcopy(document)
            bad["migrations"][i]["expected"][key] = not migration["expected"][key]
            yield f"{migration['name']} {key}", bad, text, exchange
    for key, sentence in SENTENCES.items():
        pattern = r"\s+".join(re.escape(w) for w in sentence.split())
        edited = re.sub(pattern, sentence.rsplit(" ", 1)[0].replace("\\", "\\\\"), text, count=1)
        yield f"reword {key}", document, edited, exchange
    for i, case in enumerate(document["cases"]):
        if "carriage_capabilities" in case["inputs"]["capability_profile"]:
            bad = copy.deepcopy(document)
            bad["cases"][i]["inputs"]["capability_profile"]["carriage_capabilities"] = []
            yield f"{case['name']} with an empty carriage list, identifiers kept", bad, text, exchange
    yield ("drop the carriage vocabulary", document,
           text.replace("| `checkpoint_fifo_handoff_v1` |", "| `checkpoint_any_order_v1` |"), exchange)
    yield ("drop the disposition purpose", document, text,
           exchange.replace("| `evidence_authority_disposition` | runtime |", "| `evidence_authority_other` | runtime |"))


def main() -> int:
    text = CONTRACT.read_text(encoding="utf-8")
    exchange = EXCHANGE.read_text(encoding="utf-8")
    document = json.loads(VECTORS.read_text(encoding="utf-8"))
    try:
        check(load_contract(text, exchange), document)
    except (CheckError, KeyError) as error:
        print(f"check-runtime-evidence-anchor-vectors: {error}", file=sys.stderr)
        return 1
    if "--mutations" in sys.argv[1:]:
        survived, total = [], 0
        for label, bad, edited, edited_exchange in mutants(document, text, exchange):
            total += 1
            try:
                check(load_contract(edited, edited_exchange), bad)
            except (CheckError, KeyError):
                continue
            survived.append(label)
        for flag in MODEL_MUTANTS:
            total += 1
            MODEL_MUTANTS[flag] = True
            try:
                check(load_contract(text, exchange), document)
                survived.append(f"model defect {flag}")
            except (CheckError, KeyError):
                pass
            finally:
                MODEL_MUTANTS[flag] = False
        if survived:
            for label in survived:
                print(f"mutant survived: {label}", file=sys.stderr)
            return 1
        print(f"runtime-anchor mutations: {total} refused")
    print(
        f"runtime-anchor vectors: {len(document['cases'])} derivations, {len(document['refused_profiles'])} refused "
        f"profiles and {len(document['migrations'])} migration hold to runtime-evidence-anchor/v2"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
