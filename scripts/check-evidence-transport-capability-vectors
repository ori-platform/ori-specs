#!/usr/bin/env python3
"""Check the carriage-capability vectors against evidence-transport/v2.

`evidence-transport/vectors/carriage-capability-v2.json` gives the same authority
decision to an ingest credential its credential registry records as conforming
to gateway-evidence-carriage/v1 and to one it does not, and fixes the response
each receives. The model is the contract's *Carriage capability* table, whose
rows and governing sentences are held word for word:

- both requirements hold: response shapes are capability-gated, and the new
  refusal and stop policy is activated for a credential only once the
  registry records its gateway as conforming, so a legacy credential keeps
  legacy behaviour;
- where a decision in the table exists for a legacy credential, the authority
  commits and audits it as for a conforming one, and only the response
  differs;
- a legacy response carries no `refused_retained`, `retention`, `stop`,
  evidence disposition, `507`, `retention_capacity_unavailable`,
  `pending_registration_conflict` or `pending_registration_limit`, each
  of the last two mapped to `503 unavailable`, and a return set only as its
  epoch confirmations on `accepted`;
- the capability is registry state: nothing a request asserts changes it.

    python3 scripts/check-evidence-transport-capability-vectors
    python3 scripts/check-evidence-transport-capability-vectors --mutations

`--mutations` corrupts every expected response, drops each case, rewords each
held sentence and row, and switches on each model defect, and requires every
mutant to be refused.
"""

from __future__ import annotations

import copy
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "evidence-transport" / "v2.md"
VECTORS = ROOT / "evidence-transport" / "vectors" / "carriage-capability-v2.json"
SECTION = ("**Carriage capability.**", "## Device authorisation and enumeration resistance")
SENTENCES = (
    "The authority emits new response members and statuses only for ingest credentials registered as conforming "
    "to `gateway-evidence-carriage/v1`. A missing capability means legacy behaviour.",
    "The capability covers the complete response generation: `refused_retained`, the `retention` and `stop` "
    "members, evidence dispositions, `507`, `409 pending_registration_conflict`, `429 pending_registration_limit`, "
    "and the return artifacts accompanying a refusal or a pending acceptance.",
    "It is registry state the authority holds, set when the credential is registered or changed there, and never a "
    "request header or anything a gateway asserts on a request.",
    # activation_verdict()
    "Both are required: capability-gated response shapes, and a gateway upgrade before the new refusal and stop "
    "policy is activated for that credential. The authority activates that policy for a credential only once its "
    "credential registry records the gateway holding it as conforming. A legacy credential continues to receive "
    "legacy behaviour, not legacy-shaped versions of the new terminal semantics.",
    "The table below is the capability gate on response shapes, and never licenses activating the new policy for a "
    "legacy credential.",
    "Where one of its decisions exists for a request under a credential without the capability, the authority "
    "commits and audits it exactly as for a conforming credential, and changes only what the response carries:",
    "| terminal refusal retained | `refused_retained` with `retention` | `refused` at the same status and reason, "
    "with no `retention` |",
    "| epoch- or identity-scoped disposition issued | the disposition in `authority_artifacts`, with `stop` | no "
    "disposition and no `stop` |",
    "| artifact-scoped disposition issued | the disposition in `authority_artifacts` | no disposition |",
    "| registration retained pending | `200 accepted` with its `retained_pending` disposition | `200 accepted` with "
    "no authority artifact |",
    "| terminal refusal beyond an identity's allowance under an identity-scoped disposition | "
    "`507 retention_capacity_exhausted` | `503 unavailable` |",
    "| terminal refusal beyond the pre-disposition allowance | `503 retention_capacity_unavailable` | "
    "`503 unavailable` |",
    "| pending registration conflict | `409 pending_registration_conflict` | `503 unavailable` |",
    "| pending registration limit | `429 pending_registration_limit` with `Retry-After` | `503 unavailable` |",
    "| return set on `refused` or `refused_retained` | carried | not carried |",
    "| return set on `accepted` | carried | its epoch confirmations only |",
    "A legacy response carries no member, status, reason or artifact type the table withholds.",
    "Deploying every gateway before the authority is the recommended order, and is not the correctness boundary: "
    "the credential's registered capability is.",
)
MODEL_MUTANTS = {
    "legacy_refused_retained": False,
    "legacy_disposition": False,
    "legacy_stop": False,
    "legacy_507": False,
    "legacy_capacity_reason": False,
    "legacy_return_set_on_refusal": False,
    "legacy_pending_disposition": False,
    "request_claim_selects": False,
    "legacy_commits_less": False,
    "legacy_pending_registration_conflict": False,
    "legacy_pending_registration_limit": False,
    "policy_activated_for_legacy": False,
}
REQUIRED = (
    "a retained terminal refusal", "a checkpoint rollback under an identity-scoped disposition",
    "an artifact-scoped terminal disposition", "a registration retained pending",
    "a terminal refusal beyond a stopped identity's allowance", "a terminal refusal beyond the pre-disposition allowance",
    "a refusal carrying the device's return set", "an acceptance carrying the device's return set",
    "a legacy credential whose request claims conformance",
    "a pending registration conflict", "a pending registration limit",
)
REQUIRED_ACTIVATION = (
    "a conforming credential has the new policy activated", "a legacy credential keeps legacy behaviour",
    "a legacy credential whose request claims conformance keeps legacy behaviour",
)
# Legacy mappings that change the status, keyed by the conforming (status, reason).
LEGACY_MAPPED = {(409, "pending_registration_conflict"): "legacy_pending_registration_conflict",
                 (429, "pending_registration_limit"): "legacy_pending_registration_limit"}
WITHHELD = {"outcome": {"refused_retained"}, "status": {507},
            "reason": {"retention_capacity_unavailable", "pending_registration_conflict", "pending_registration_limit"},
            "members": {"retention", "stop"}, "artifact_types": {"evidence_disposition"}}


class CheckError(Exception):
    pass


def _norm(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def load_contract(text: str) -> None:
    start = text.find(SECTION[0])
    end = text.find(SECTION[1], start)
    if start < 0 or end < start:
        raise CheckError("evidence-transport/v2 no longer carries the carriage-capability section")
    section = _norm(text[start:end])
    for sentence in SENTENCES:
        if _norm(sentence) not in section:
            raise CheckError(f"evidence-transport/v2 no longer states, in its carriage-capability section: "
                             f"{sentence[:80]!r}")


def respond(case: dict) -> dict:
    """The authority's commit and the response the credential's registered capability gives it."""
    decision = case["decision"]
    conforming = case["registered_conforming"]
    if MODEL_MUTANTS["request_claim_selects"] and case.get("request_claims_conforming"):
        conforming = True
    legacy = not conforming
    commit = {"retained": decision.get("retained", False), "disposition": decision.get("disposition"),
              "stop": decision.get("disposition") in ("epoch", "identity")}
    if legacy and MODEL_MUTANTS["legacy_commits_less"]:
        commit = {**commit, "retained": False}
    status, outcome, reason = decision["status"], decision["outcome"], decision["reason"]
    members: list[str] = []
    types = list(decision.get("own_artifacts", []))
    if outcome == "refused_retained":
        if legacy and not MODEL_MUTANTS["legacy_refused_retained"]:
            outcome = "refused"
        else:
            members.append("retention")
    if decision.get("disposition"):
        if not legacy or MODEL_MUTANTS["legacy_disposition"] or (
                MODEL_MUTANTS["legacy_pending_disposition"] and decision["disposition"] == "artifact"
                and outcome == "accepted"):
            types.append("evidence_disposition")
        if decision["disposition"] in ("epoch", "identity") and (not legacy or MODEL_MUTANTS["legacy_stop"]):
            members.append("stop")
    if status == 507 and legacy and not MODEL_MUTANTS["legacy_507"]:
        status, outcome, reason = 503, "pending", "unavailable"
    if reason == "retention_capacity_unavailable" and legacy and not MODEL_MUTANTS["legacy_capacity_reason"]:
        reason = "unavailable"
    mapped = LEGACY_MAPPED.get((status, reason))
    if mapped and legacy and not MODEL_MUTANTS[mapped]:
        status, outcome, reason = 503, "pending", "unavailable"
    returned = decision.get("return_set", [])
    if outcome in ("refused", "refused_retained"):
        if not legacy or MODEL_MUTANTS["legacy_return_set_on_refusal"]:
            types += returned
    elif outcome == "accepted":
        types += returned if not legacy else [t for t in returned if t == "epoch_confirmation"]
    return {"commit": commit, "response": {"status": status, "outcome": outcome, "reason": reason,
                                           "members": sorted(members), "artifact_types": sorted(types)}}


def activation_verdict(case: dict) -> str:
    """Whether the new refusal and stop policy is active for the credential: registry state, never a request."""
    if MODEL_MUTANTS["policy_activated_for_legacy"]:
        return "new"
    conforming = case["registered_conforming"]
    if MODEL_MUTANTS["request_claim_selects"] and case.get("request_claims_conforming"):
        conforming = True
    return "new" if conforming else "legacy"


def check(document: dict) -> None:
    for case in document["activation_cases"]:
        got = activation_verdict(case)
        if got != case["expected_policy"]:
            raise CheckError(f"activation case {case['name']!r}: declares {case['expected_policy']}, the contract "
                             f"gives {got}")
    present = {c["name"] for c in document["activation_cases"]}
    if not set(REQUIRED_ACTIVATION) <= present:
        raise CheckError(f"no activation case for {sorted(set(REQUIRED_ACTIVATION) - present)}")
    names = [c["name"] for c in document["cases"]]
    for required in REQUIRED:
        if not any(n.startswith(required) for n in names):
            raise CheckError(f"no case for: {required}")
    commits: dict[str, list[dict]] = {}
    for case in document["cases"]:
        got = respond(case)
        if got["response"] != case["expected_response"]:
            raise CheckError(f"{case['name']!r}: declares {case['expected_response']}, the contract gives "
                             f"{got['response']}")
        commits.setdefault(json.dumps(case["decision"], sort_keys=True), []).append(got["commit"])
        if not case["registered_conforming"]:
            response = got["response"]
            for field, withheld in WITHHELD.items():
                values = response[field] if isinstance(response[field], list) else [response[field]]
                if set(values) & withheld:
                    raise CheckError(f"{case['name']!r}: a legacy response carries {sorted(set(values) & withheld)}, "
                                     "which the table withholds")
    for decision, seen in commits.items():
        if len(seen) < 2:
            raise CheckError(f"decision {decision} is not given to both a conforming and a legacy credential")
        if any(c != seen[0] for c in seen):
            raise CheckError(f"decision {decision} commits differently for the two credentials; only the response "
                             "may differ")


def corpus_mutants(document: dict):
    for i, case in enumerate(document["activation_cases"]):
        bad = copy.deepcopy(document)
        bad["activation_cases"][i]["expected_policy"] = "legacy" if case["expected_policy"] == "new" else "new"
        yield f"activation case {case['name']!r} verdict", bad
        bad = copy.deepcopy(document)
        del bad["activation_cases"][i]
        yield f"without activation case {case['name']!r}", bad
    for i, case in enumerate(document["cases"]):
        bad = copy.deepcopy(document)
        del bad["cases"][i]
        yield f"without {case['name']!r}", bad
        for field in ("status", "outcome", "reason", "members", "artifact_types"):
            bad = copy.deepcopy(document)
            target = bad["cases"][i]["expected_response"]
            value = target[field]
            if isinstance(value, list):
                target[field] = value[:-1] if value else ["evidence_disposition"]
            elif isinstance(value, int):
                target[field] = 507 if value != 507 else 503
            else:
                target[field] = {"refused": "refused_retained", "refused_retained": "refused", "accepted": "pending",
                                 "pending": "accepted", "unavailable": "retention_capacity_unavailable"}.get(
                    value, "unavailable")
            yield f"{case['name']!r} {field}", bad


def text_mutants(text: str):
    for sentence in SENTENCES:
        pattern = r"\s+".join(re.escape(w) for w in sentence.split())
        words = sentence.split()
        edited, count = re.subn(pattern, " ".join(words[:-2] + [words[-1]]).replace("\\", "\\\\"), text, count=1)
        yield f"reword {sentence[:50]!r}", edited, count


def main() -> int:
    text = CONTRACT.read_text(encoding="utf-8")
    document = json.loads(VECTORS.read_text(encoding="utf-8"))
    try:
        load_contract(text)
        check(document)
    except (CheckError, KeyError) as error:
        print(f"check-evidence-transport-capability-vectors: {error}", file=sys.stderr)
        return 1
    if "--mutations" in sys.argv[1:]:
        survived, total = [], 0
        for label, bad in corpus_mutants(document):
            total += 1
            try:
                check(bad)
            except (CheckError, KeyError):
                continue
            survived.append(label)
        for flag in MODEL_MUTANTS:
            total += 1
            MODEL_MUTANTS[flag] = True
            try:
                check(document)
                survived.append(f"model defect {flag}")
            except (CheckError, KeyError):
                pass
            finally:
                MODEL_MUTANTS[flag] = False
        for label, edited, count in text_mutants(text):
            total += 1
            if count != 1:
                survived.append(f"{label}: matches nothing")
                continue
            try:
                load_contract(edited)
            except CheckError:
                continue
            survived.append(label)
        if survived:
            for label in survived:
                print(f"mutant survived: {label}", file=sys.stderr)
            return 1
        print(f"carriage-capability mutations: {total} refused")
    print(f"carriage-capability vectors: {len(document['cases'])} cases hold to evidence-transport/v2")
    return 0


if __name__ == "__main__":
    sys.exit(main())
