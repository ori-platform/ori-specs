def in_range(document: dict, channel: str, value: float) -> bool:
    from decimal import Decimal
    ch = next(c for c in document["channels"] if c["name"] == channel)
    scale = Decimal(ch["scale"]["mantissa"]).scaleb(ch["scale"]["exponent"])
    offset = Decimal(ch["offset"]["mantissa"]).scaleb(ch["offset"]["exponent"])
    raw = (Decimal(repr(value)) - offset) / scale
    return raw == raw.to_integral_value() and ch["raw_min"] <= raw <= ch["raw_max"]


