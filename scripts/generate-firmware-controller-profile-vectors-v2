def build() -> bytes:
    documents = {name: doc for name, doc, _ in ACCEPT}
    cases = []
    for name, document, note in ACCEPT:
        body = canonical(document)
        cases.append({
            "name": name,
            "document": document,
            "canonical_hex": body.hex(),
            "digest": "sha256:" + hashlib.sha256(body).hexdigest(),
            "note": note,
        })
    reject_cases = []
    for name, rule, edit, note in REJECT:
        document = copy.deepcopy(RECTIFIER)
        edit(document)
        reject_cases.append({
            "name": name,
            "reason": "invalid_profile_document",
            "rule": rule,
            "document": document,
            "note": note,
        })
    reject_bytes = []
    for name, make, note in REJECT_BYTES:
        reject_bytes.append({
            "name": name,
            "reason": "non_canonical_document",
            "bytes_hex": make().hex(),
            "note": note,
        })
    interpretations = []
    for name, doc_name, channel, value, note, pinned in (
        [i + (i[1],) for i in INTERPRET] + list(PINNED_ELSEWHERE)
    ):
        interpretations.append({
            "name": name,
            "document": doc_name,
            "pinned_document": pinned,
            "profile_channel": channel,
            "registers": registers_for(documents[doc_name], channel, value),
            "value": value,
            "expected": interpret(documents[doc_name], channel, value),
            "note": note,
        })
    ranges = []
    for name, doc_name, channel, value, note, pinned in (
        [r + (r[1],) for r in RANGES] + list(RANGES_PINNED_ELSEWHERE)
    ):
        ranges.append({
            "name": name,
            "document": doc_name,
            "pinned_document": pinned,
            "profile_channel": channel,
            "value": value,
            "expected": "in_range" if in_range(documents[doc_name], channel, value) else "out_of_range",
            "note": note,
        })
    agreements = []
    digest_by_name = {c["name"]: c["digest"] for c in cases}
    for name, bid, doc_name, channel, stype, unit, note in AGREE:
        digest = OTHER_DIGEST.get(name, digest_by_name[doc_name])
        agreements.append({
            "name": name,
            "manifest_channel": {
                "sensor_type": stype,
                "unit": unit,
                "controller_profile_id": bid,
                "digest": digest,
                "profile_channel": channel,
            },
            "document": doc_name,
            "expected": agreement(bid, digest, doc_name, channel, stype, unit, documents,
                                  digest_by_name),
            "note": note,
        })
    states = []
    for name, poll, events, query, note in STATES:
        states.append({
            "name": name,
            "poll_interval_ms": poll,
            "events": events,
            "query_ms": query,
            "expected": channel_state(poll, events, query),
            "note": note,
        })
    corpus = {
        "contract": "ori-specs/firmware-telemetry/v2.md",
        "version": 2,
        "comment": (
            "Golden vectors for firmware-telemetry/v2 Controller Profiles. A "
            "consumer must accept every document in 'cases', reproducing its "
            "canonical bytes and digest; refuse every document in "
            "'reject_cases', each of which breaks exactly the one rule its "
            "'rule' names; refuse every byte string in 'reject_bytes'; "
            "reproduce every interpretation in 'interpretations' and every "
            "verdict in 'ranges' and 'agreements'; and reproduce "
            "every state case in 'states', stated at the longest bound. No "
            "profile here describes a real product."
        ),
        "reasons": {
            "invalid_profile_document": "the document breaks the grammar of "
                                        "firmware-telemetry/v2 The profile document",
            "non_canonical_document": "the document's bytes are not exactly the "
                                      "canonical bytes of the object they parse to",
        },
        "cases": cases,
        "reject_cases": reject_cases,
        "reject_bytes": reject_bytes,
        "interpretations": interpretations,
        "ranges": ranges,
        "agreements": agreements,
        "states": states,
    }
    return (json.dumps(corpus, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = build()
    if argv == ["--check"]:
        if OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator")
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv:
        print(__doc__)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)} sha256 {hashlib.sha256(data).hexdigest()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
