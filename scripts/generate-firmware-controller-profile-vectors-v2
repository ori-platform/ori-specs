     "current", "ampere", "the document's id is not the binding's"),
    ("profile_channel_missing", "example-rectifier", "rectifier", "input_voltage",
     "voltage", "volt", "the document has no channel by that name"),
    ("measurement_read_as_alarm_word", "example-rectifier", "rectifier", "output_current",
