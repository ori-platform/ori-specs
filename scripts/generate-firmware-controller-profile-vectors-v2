def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def _rectifier_bytes() -> str:
    return canonical(RECTIFIER).decode("utf-8")


def _swap_first(text: str, old: str, new: str) -> bytes:
    assert text.count(old) == 1, old
    return text.replace(old, new, 1).encode("utf-8")


# (name, bytes, note). Each is RECTIFIER's document in bytes that are not canonical.
REJECT_BYTES = (
    ("reject_bytes_duplicate_key",
     lambda: _swap_first(_rectifier_bytes(), '{"active":"clear","bit":17,',
                         '{"active":"set","active":"clear","bit":17,'),
     "a duplicate active key: a last-wins parse re-serializes to the pinned "
     "digest, and a first-wins parse reads the opposite polarity"),
    ("reject_bytes_whitespace",
     lambda: json.dumps(RECTIFIER, sort_keys=True, indent=1, ensure_ascii=False).encode("utf-8"),
     "the same object, indented"),
    ("reject_bytes_key_order",
     lambda: _swap_first(_rectifier_bytes(), '"baud_rate":9600,"channels":',
                         '"channels":').replace(b',"id":"example-rectifier"',
                                                b',"baud_rate":9600,"id":"example-rectifier"', 1),
     "baud_rate moved after channels; keys are sorted"),
    ("reject_bytes_escaped_ascii",
     lambda: _swap_first(_rectifier_bytes(), '"source":"Synthetic', '"source":"\\u0053ynthetic'),
     "a letter written as a \\u escape; canonical bytes escape only what RFC 8259 requires"),
    ("reject_bytes_trailing_newline",
     lambda: _rectifier_bytes().encode("utf-8") + b"\n",
     "a byte after the object"),
    ("reject_bytes_invalid_utf8",
     lambda: _swap_first(_rectifier_bytes(), "Synthetic", "Synthet\x00ic").replace(b"\x00", b"\xff"),
     "a byte that is not UTF-8"),
)


def registers_for(document: dict, channel: str, value: object) -> list | None:
    ch = next(c for c in document["channels"] if c["name"] == channel)
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value != int(value):
        return None
    word = int(value)
    if not 0 <= word < 2 ** (16 * ch["register_count"]):
        return None
    if ch["register_count"] == 1:
        return [word]
    high, low = word >> 16, word & 0xFFFF
    return [high, low] if ch["word_order"] == "high_first" else [low, high]


def unsigned_word(document: dict, channel: str) -> tuple[int, list]:
    ch = next(c for c in document["channels"] if c["name"] == channel)
    return 16 * ch["register_count"], ch["alarms"]


def interpret(document: dict, channel: str, value: object) -> dict:
    width, alarms = unsigned_word(document, channel)
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return {"interpreted": False}
    if value != int(value) or not 0 <= value < 2**width:
        return {"interpreted": False}
    word = int(value)
    mapped = 0
    states = {}
    for a in alarms:
        mapped |= 1 << a["bit"]
        on = (word >> a["bit"]) & 1
        states[a["id"]] = "asserted" if on == (1 if a["active"] == "set" else 0) else "not_asserted"
    unmapped = [b for b in range(width) if (word >> b) & 1 and not (mapped >> b) & 1]
    return {"interpreted": True, "alarms": states, "unmapped_set_bits": unmapped}


