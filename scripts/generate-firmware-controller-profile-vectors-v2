def agreement(binding_id: str, binding_digest: str, digest_of: str, profile_channel: str,
              sensor_type: str, unit: str, documents: dict, digests: dict) -> str:
    doc = documents[digest_of]
    if digests[digest_of] != binding_digest or doc["id"] != binding_id:
        return "disagree"
    ch = next((c for c in doc["channels"] if c["name"] == profile_channel), None)
    if ch is None:
        return "disagree"
    if ch["kind"] == "alarm_word":
        ok = (sensor_type, unit) == ("controller_alarm_word", "bitmask")
    else:
        ok = (sensor_type, unit) == (ch["sensor_type"], ch["unit"])
    return "use" if ok else "disagree"


