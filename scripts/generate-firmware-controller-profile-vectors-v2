def bound_ms(poll_interval_ms: int) -> int:
    return 3 * poll_interval_ms + 30000


def channel_state(poll_interval_ms: int, events: list, query_ms: int) -> dict:
    epoch = 0
    active = True  # an anchor is active
    revoked = False
    last = None  # greatest (boot_id, seq) accepted in the active epoch, any kind
    latest = None
    accepted_at = None
    fault = None
    interpretable = False
    for e in events:
        if e["kind"] == "restart":
            # The anchor's freshness state is durable; what a receiver holds in
            # memory about the channel is not.
            latest = accepted_at = fault = None
            continue
        if e["kind"] == "revoke":
            # Revoking a reinstated identity discards its pending anchor.
            assert not revoked, "device-provisioning: the identity is already revoked"
            active, revoked = False, True
            latest = accepted_at = fault = None
            continue
        if e["kind"] == "reinstate":
            # The retained anchor returns to pending; nothing is active yet.
            assert revoked, "device-provisioning: only a revoked identity is reinstated"
            revoked = False
            latest = accepted_at = fault = None
            continue
        if e["kind"] in ("stage_manifest", "stage_key"):
            # A pending anchor, created or replaced, affects nothing about the
            # active one.
            assert not revoked, "device-provisioning: no re-provisioning while revoked"
            continue
        if e["kind"] == "pending_reading":
            continue  # signed under the pending anchor: refused, freshness untouched
        if e["kind"] == "promote":
            assert not revoked, "device-provisioning: nothing activates while revoked"
            active = True
            # A new manifest in the same key epoch: freshness runs on.
            latest = accepted_at = fault = None
            continue
        if e["kind"] == "rotate":
            # The promotion of a re-provisioned key.
            assert not revoked, "device-provisioning: no re-provisioning while revoked"
            active = True
            epoch += 1
            last = latest = accepted_at = fault = None
            continue
        key = (e["boot_id"], e["seq"])
        # v1 freshness: one seq high-water mark per key epoch, across boots.
        if not active or e["epoch"] != epoch or (last is not None and (e["seq"] <= last[1] or e["boot_id"] < last[0])):
            continue
        last = key
        if e["kind"] == "fault":
            fault = key
        elif e["kind"] == "other":
            pass  # a heartbeat or another channel's reading: freshness only
        else:
            # A reading of the channel, interpretable or not, is its latest.
            latest, accepted_at = key, e["t"]
            interpretable = e["kind"] == "reading"
            if fault is not None and key > fault:
                fault = None
    if (latest is None or fault is not None or not interpretable
            or query_ms - accepted_at > bound_ms(poll_interval_ms)):
        return {"state": "unknown"}
    return {"state": "as_of", "epoch": epoch, "boot_id": latest[0], "seq": latest[1]}


def ev(t: int, kind: str, epoch: int = 0, boot: int = 1, seq: int = 1) -> dict:
    if kind in ("restart", "rotate", "promote", "revoke", "reinstate", "stage_manifest",
                "stage_key"):
        return {"t": t, "kind": kind}
    return {"t": t, "kind": kind, "epoch": epoch, "boot_id": boot, "seq": seq}


