"""Generate the firmware-telemetry/v2 controller profile corpus.

Nothing here is shared with scripts/check-firmware-controller-profile-vectors-v2,
which reads the grammar from the contract, canonicalises with its own
serializer and recomputes every interpretation.

    python3 scripts/generate-firmware-controller-profile-vectors-v2          # write
    python3 scripts/generate-firmware-controller-profile-vectors-v2 --check  # reproduce
"""

from __future__ import annotations

import copy
import hashlib
import json
import pathlib
import sys
from collections.abc import Callable

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "firmware-telemetry" / "controller-profile-vectors-v2.json"


def measurement(name: str, **over: object) -> dict:
    channel = {
        "name": name,
        "kind": "measurement",
        "function": "read_input_registers",
        "start_register": 40,
        "register_count": 1,
        "word_order": None,
        "raw_signed": False,
        "raw_min": 0,
        "raw_max": 2000,
        "scale": {"mantissa": 1, "exponent": -1},
        "offset": {"mantissa": 0, "exponent": 0},
        "sensor_type": "current",
        "unit": "ampere",
    }
    channel.update(over)
    return channel


def alarm_word(name: str, alarms: list, **over: object) -> dict:
    channel = {
        "name": name,
        "kind": "alarm_word",
        "function": "read_holding_registers",
        "start_register": 100,
        "register_count": 1,
        "word_order": None,
        "alarms": alarms,
    }
    channel.update(over)
    return channel


def alarm(bit: int, active: str, ident: str, meaning: str) -> dict:
    return {"bit": bit, "active": active, "id": ident, "meaning": meaning}


def profile(ident: str, channels: list, **over: object) -> dict:
    document = {
        "v": 1,
        "id": ident,
        "source": "Synthetic register map for the ori-specs corpus; describes no product",
        "baud_rate": 9600,
        "poll_interval_ms": 5000,
        "channels": channels,
    }
    document.update(over)
    return document


RECTIFIER = profile(
    "example-rectifier",
    [
        measurement("output_current"),
        measurement(
            "output_voltage",
            start_register=41,
            raw_max=6000,
            scale={"mantissa": 1, "exponent": -2},
            sensor_type="voltage",
            unit="volt",
        ),
        alarm_word(
            "alarm_word_1",
            [
                alarm(0, "set", "ac_input_fail", "AC input failure"),
                alarm(3, "set", "over_temperature", "Rectifier over temperature"),
                alarm(4, "set", "long_meaning", "M" * 256),
                alarm(17, "clear", "fan_stopped", "Fan stopped"),
                alarm(31, "set", "module_fault", "Rectifier module fault"),
            ],
            register_count=2,
            word_order="high_first",
        ),
    ],
)

RECTIFIER_REVISED = profile(
    "example-rectifier",
    [
        dict(RECTIFIER["channels"][0], raw_max=1000),
        RECTIFIER["channels"][1],
        dict(RECTIFIER["channels"][2], alarms=[
            dict(a, bit=5) if a["id"] == "over_temperature" else a
            for a in RECTIFIER["channels"][2]["alarms"]
        ]),
    ],
)

GENERATOR = profile(
    "example.genset_ctl-2",
    [
        measurement(
            "coolant_temperature",
            function="read_holding_registers",
            start_register=65534,
            register_count=2,
            word_order="low_first",
            raw_signed=True,
            raw_min=-2147483648,
            raw_max=2147483647,
            scale={"mantissa": 1, "exponent": -4},
            offset={"mantissa": -27315, "exponent": -2},
            sensor_type="temperature",
            unit="celsius",
        ),
        alarm_word(
            "shutdown_alarms",
            [
                alarm(0, "set", "low_oil_pressure", 'Low oil pressure "LOP" shutdown, path A\\B'),
                alarm(1, "set", "high_coolant_temp", "High coolant temperature shutdown"),
                alarm(15, "clear", "estop_circuit_open", "Emergency stop circuit open"),
            ],
            start_register=0,
        ),
        alarm_word(
            "warning_alarms",
            [alarm(2, "set", "battery_low", "Battery voltage low (~11.5 V)")],
            start_register=1,
            register_count=2,
            word_order="low_first",
            function="read_input_registers",
        ),
    ],
    baud_rate=115200,
    poll_interval_ms=100,
    source='Synthetic "G-2" map, section A\\B',
)

METER = profile(
    "M",
    [
        measurement(
            "frequency",
            raw_signed=True,
            raw_min=-32768,
            raw_max=32767,
            scale={"mantissa": -2147483647, "exponent": -4},
            offset={"mantissa": 2147483647, "exponent": -4},
            sensor_type="frequency",
            unit="hertz",
        ),
        measurement(
            "energy",
            start_register=41,
            raw_max=999,
            scale={"mantissa": 1, "exponent": 6},
            offset={"mantissa": 1, "exponent": 6},
            sensor_type="energy",
            unit="watt_hour",
        ),
    ],
    baud_rate=1200,
    poll_interval_ms=3600000,
    source=" " + "x" * 254 + "~",
)

SIXTEEN = profile(
    "sixteen-channels",
    [measurement(f"c{i:02d}", start_register=i) for i in range(15)]
    + [alarm_word("alarms", [alarm(b, "set", f"a{b:02d}", f"Alarm {b}") for b in range(16)])],
)

DECODE_BOUNDS = profile(
    "decode-bounds",
    [
        measurement("last_register", start_register=65535, raw_max=65535,
                    scale={"mantissa": 1, "exponent": 0}),
        measurement("full_unsigned_32", start_register=0, register_count=2,
                    word_order="low_first", raw_min=0, raw_max=4294967295,
                    scale={"mantissa": 1, "exponent": 0}),
        measurement("fifteen_nines", start_register=2, register_count=2,
                    word_order="high_first", raw_min=0, raw_max=999999999,
                    scale={"mantissa": 1, "exponent": 6},
                    offset={"mantissa": 999999, "exponent": 0},
                    sensor_type="energy", unit="watt_hour"),
        measurement("value_at_limit", start_register=4, register_count=2,
                    word_order="high_first", raw_min=0, raw_max=100000,
                    scale={"mantissa": 1000000000, "exponent": 1},
                    offset={"mantissa": 0, "exponent": 1},
                    sensor_type="energy", unit="watt_hour"),
    ],
    source="S",
)

THIRTY_TWO = profile(
    "thirty-two-alarms",
    [
        alarm_word(
            "alarms",
            [alarm(b, "clear" if b % 2 else "set", f"bit{b}", "A" if b == 0 else f"Alarm bit {b}")
             for b in range(32)],
            register_count=2,
            word_order="low_first",
            start_register=65534,
        )
    ],
    id="a" * 48,
    poll_interval_ms=1190000,
)

ACCEPT = (
    ("rectifier", RECTIFIER,
     "measurements and a 32-bit high_first alarm word with both polarities; the "
     "manifest corpus names this document"),
    ("rectifier_revised", RECTIFIER_REVISED,
     "the rectifier's id under another digest: output_current's range halved and "
     "over_temperature moved from bit 3 to bit 5, so a reading read through the "
     "wrong one is misread"),
    ("generator", GENERATOR,
     "a signed 32-bit low_first measurement at the full signed range with a "
     "negative offset, the last register pair of the space, and alarm words of "
     "both widths"),
    ("meter_bounds", METER,
     "the one-character id, the longest source with both ends of the printable "
     "range, the slowest rate and interval, "
     "mantissas at both bounds and exponents at both bounds, every decode within "
     "fifteen digits"),
    ("sixteen_channels", SIXTEEN, "the most channels a profile may carry"),
    ("decode_bounds", DECODE_BOUNDS,
     "the one-character source, the last register, the full unsigned 32-bit "
     "range, a decode of exactly fifteen nines and a value of exactly 10^15"),
    ("thirty_two_alarms", THIRTY_TWO,
     "the longest id, a one-character meaning, the slowest poll a profile with an "
     "alarm word may declare, and the most alarms a channel may carry, one on "
     "every bit of a two-register word"),
)


def at(path: tuple) -> Callable[[dict], tuple[dict | list, object]]:
    def locate(document: dict) -> tuple[dict | list, object]:
        node: object = document
        for key in path[:-1]:
            node = node[key]  # type: ignore[index]
        return node, path[-1]  # type: ignore[return-value]
    return locate


def set_(path: tuple, value: object) -> Callable[[dict], None]:
    def edit(document: dict) -> None:
        node, key = at(path)(document)
        node[key] = value  # type: ignore[index]
    return edit


def drop(path: tuple) -> Callable[[dict], None]:
    def edit(document: dict) -> None:
        node, key = at(path)(document)
        del node[key]  # type: ignore[arg-type]
    return edit


def add(path: tuple, value: object) -> Callable[[dict], None]:
    return set_(path, value)


def edits(*steps: Callable[[dict], None]) -> Callable[[dict], None]:
    def edit(document: dict) -> None:
        for step in steps:
            step(document)
    return edit


