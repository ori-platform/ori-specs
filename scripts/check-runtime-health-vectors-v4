        ("text: T3 bound", text_mutant("v4", "an array of at most 32 strings",
                                       "an array of at most 31 strings")),
        ("text: gateway severity", text_mutant(
            "gw", "| `sensor_unconnected` | `degraded` |", "| `sensor_unconnected` | `critical` |")),
        ("text: gateway row 8", text_mutant(
            "gw", "`\"degraded\"` or `\"critical\"`", "`\"degraded\"` or `\"healthy\"`")),
