"""Check the runtime-health/v4 corpus against the contract text.

Shares no code with scripts/generate-runtime-health-vectors-v4, and was written
without reading it. Every expected value is recomputed by this script's own
model, built from runtime-health/v4.md and the runtime node heartbeat sections
of gateway-api/v2.md: the condition table and its fold, the snapshot's shape
for the blocks the table reads, the startup deadline, snapshot checks 5 to 9,
the triple check T1 to T4 and the heartbeat mapping, the fallback heartbeat,
whole served responses through snapshot checks 1 to 10 (the payload's members,
JSON types at every depth, value vocabularies, diagnostics namespaces, states,
tied booleans and Present columns, all read from the tables),
unrepresentable integers, the gateway's validation steps (each looked up by its
exact wording), request framing, the integer range and the expiry
representation. Severities, the vocabulary, step
orders and verdicts, the request bound, the reasons bound, the accepted
request bytes, the integer range and the subsystem lists are read from the
text; each predicate is looked up by its exact wording, so a predicate the
text rewords has no model until this script is reviewed. Every sentence of
the sections this script owns is held word for word.

Held to:

- each case's declared outcome equals the recomputed one; every disagreement
  is listed, not only the first;
- each response case fails exactly one check, less those another failure
  forces, so no earlier step catches its defect and no second defect hides;
- each snapshot carries exactly the states and members its blocks' Present
  columns and section flags allow, and its integers are in range;
- coverage, as properties of the cases rather than of their names: every
  condition alone and every ordered pair in the fold, every condition raised
  by a snapshot alone, every disjunct of every predicate alone, every
  boundary the predicates and the startup deadline name at and either side,
  every subsystem starting and unread, every check step's failure, every
  gateway verdict, every refused byte class the request text lists, split
  writes, discarded bytes, the 1024 boundary, an unfinished request, and
  each integer and expiry rule.

    python3 scripts/check-runtime-health-vectors-v4
    python3 scripts/check-runtime-health-vectors-v4 --mutations

`--mutations` corrupts the corpus, the contract text and this script's own
model in turn; every mutant must be refused, except those listed as
equivalent with the reason no corpus could refuse them.
"""

from __future__ import annotations

import copy
import importlib.machinery
import importlib.util
import itertools
import json
import math
import pathlib
import re
import sys
import types
from collections.abc import Callable
from typing import Any


def _load_contract_markdown() -> types.ModuleType:
    """scripts/contract-markdown, by path: the repository holds no *.py file."""
    path = pathlib.Path(__file__).resolve().parent / "contract-markdown"
    loader = importlib.machinery.SourceFileLoader("contract_markdown", str(path))
    spec = importlib.util.spec_from_loader("contract_markdown", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["contract_markdown"] = module
    loader.exec_module(module)
    return module


markdown = _load_contract_markdown()

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "runtime-health" / "health-vectors-v4.json"
HEALTH_V4 = ROOT / "runtime-health" / "v4.md"
GATEWAY_V2 = ROOT / "gateway-api" / "v2.md"


class Failure(Exception):
    pass


# --- contract text ------------------------------------------------------------------

def flat(text: str) -> str:
    return " ".join(text.split())


def need(text: str, sentence: str, where: str) -> None:
    if sentence not in flat(text):
        raise Failure(f"{where} no longer says: {sentence!r}")


def cells(row: str) -> list[str]:
    """A table row's cells, split on pipes that are not escaped."""
    inner = row.strip()
    if not (inner.startswith("|") and inner.endswith("|")):
        raise Failure(f"not a table row: {row!r}")
    parts = re.split(r"(?<!\\)\|", inner[1:-1])
    return [flat(p.replace("\\|", "|")) for p in parts]


def table(body: str, header: list[str]) -> list[list[str]]:
    """The rows of the first table in `body` whose header is `header`."""
    lines = body.splitlines()
    for i, line in enumerate(lines):
        if line.strip().startswith("|") and cells(line) == header:
            rows = []
            for row in lines[i + 2:]:
                if not row.strip().startswith("|"):
                    break
                rows.append(cells(row))
            return rows
    raise Failure(f"no table headed {header}")


def unquote(cell: str) -> str:
    m = re.fullmatch(r"`([^`]+)`", cell)
    if m is None:
        raise Failure(f"not a single code span: {cell!r}")
    return m.group(1)


