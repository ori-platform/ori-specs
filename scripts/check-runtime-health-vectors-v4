# gateway-api/v2.md is not held to the canonical heading form, so only these
# two sections are read from it, by path.
GATEWAY_SECTIONS = (
    "## Runtime Node Heartbeat Payload",
    "## Runtime Node Heartbeat Payload > ### `degradation_reasons`",
)


def split_sentences(body: str) -> list[str]:
    blocks: list[list[str]] = []
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith(">"):
            stripped = stripped.lstrip(">").strip()
        if not stripped:
            blocks.append([])
            continue
        if stripped.startswith("|"):
            if not re.fullmatch(r"\|[\s|:-]+\|", stripped):
                blocks.append([stripped])
            blocks.append([])
            continue
        if re.match(r"(?:- |\d+\. )", stripped):
            blocks.append([re.sub(r"^(?:- |\d+\. )", "", stripped)])
            continue
        if not blocks:
            blocks.append([])
        blocks[-1].append(stripped)
    sentences = []
    for block in blocks:
        text = " ".join(block).strip()
        if text:
            sentences += [s for s in re.split(r"(?<=[.!?:;])\s+(?=[A-Z`*\[\"(])", text) if s]
    return sentences


def owned_sentences(texts: dict[str, str]) -> dict[str, dict[str, list[str]]]:
    bodies = dict(markdown.section_bodies(texts["v4"]))
    gw = dict(markdown.section_bodies(texts["gw"]))
    return {
        "v4": {path: split_sentences(bodies[path]) for path, own in V4_SECTIONS if own},
        "gw": {path: split_sentences(gw[path]) for path in GATEWAY_SECTIONS},
    }


def check_text(texts: dict[str, str]) -> None:
    crooked = markdown.non_canonical(texts["v4"])
    if crooked:
        raise Failure(f"non-canonical heading in runtime-health/v4.md: {crooked}")
    paths = [path for path, _ in markdown.section_bodies(texts["v4"])]
    if paths != [path for path, _ in V4_SECTIONS]:
        raise Failure(f"sections of runtime-health/v4.md changed: unassigned "
                      f"{[p for p in paths if p not in dict(V4_SECTIONS)]}, gone "
                      f"{[p for p, _ in V4_SECTIONS if p not in paths]}, or reordered")
    gw_paths = [path for path, _ in markdown.section_bodies(texts["gw"])]
    for path in GATEWAY_SECTIONS:
        if path not in gw_paths:
            raise Failure(f"gateway-api/v2.md has no section {path!r}")
    found = owned_sentences(texts)
    for doc, sections in HELD_SENTENCES.items():
        if set(sections) != set(found[doc]):
            raise Failure(f"owned sections of {doc} changed")
        for path, want in sections.items():
            got = found[doc][path]
            if got != list(want):
                added = [s for s in got if s not in want]
                removed = [s for s in want if s not in got]
                raise Failure(f"sentence changed in {doc} {path}: added {added}, removed "
                              f"{removed}" + ("" if added or removed else ", reordered"))


# --- the model's predicates, by the exact wording of their rows ----------------------------

def available(block: Any) -> bool:
    return isinstance(block, dict) and block.get("state") == "available"


def _fl(s: dict) -> dict | None:
    b = s.get("firmware_liveness")
    return b if available(b) else None


def _alr(s: dict) -> dict | None:
    b = s.get("action_log_records")
    return b if available(b) else None


def _ar(s: dict) -> dict | None:
    b = s.get("evidence", {}).get("action_records")
    return b if available(b) else None


def _ev(s: dict) -> dict | None:
    b = s.get("evidence")
    return b if available(b) else None


def _blk(s: dict, name: str) -> dict | None:
    b = s.get(name)
    return b if available(b) else None


def flagged(s: dict, m: dict, flag: str, row: str) -> bool:
    """A section row's predicate: decided by its flag, whatever the evidence state."""
    ev = s.get("evidence", {})
    if m["flag_rows_need_available"] and not available(ev):
        return False
    return ev.get(flag) is True and ev.get(row, 0) > 0


def tick_stale(s: dict, m: dict) -> bool:
    fl = _fl(s)
    if fl is None or fl["loop"] not in m["stale_loops"]:
        return False
    window = fl["expiry_window_ms"]
    tick = fl["last_successful_tick_age_ms"]
    reached = m["reached"]
    if tick is not None:
        return reached(tick, window)
    return m["null_tick_counts_start"] and reached(fl["started_age_ms"], window)


def block_named(s: dict, name: str) -> Any:
    node: Any = s
    for part in name.split("."):
        node = node.get(part) if isinstance(node, dict) else None
    return node


def subsystem(state: str, sensor_state: str) -> Callable[[dict, dict], bool]:
    def holds(s: dict, m: dict) -> bool:
        names = m["starting_blocks" if state == "starting" else "unknown_blocks"]
        if any(isinstance(block_named(s, n), dict) and block_named(s, n).get("state") == state
               for n in names):
            return True
        if any(x.get("connection") == sensor_state for x in s.get("sensors", [])):
            return True
        if state == "unavailable":
            ev = _ev(s)
            if ev is not None and any(ev[f] is False for f in m["unknown_flags"]):
                return True
        return False
    return holds


def _live(s: dict, m: dict) -> dict | None:
    """The liveness block when available and not cleanly stopped."""
    fl = _fl(s)
    if fl is None or (m["clean_stop_exempt"] and fl["loop"] == "stopped_cleanly"):
        return None
    return fl


def _incident(s: dict, m: dict, kind: str) -> bool:
    b = _alr(s)
    return b is not None and any(
        i["kind"] == kind and (i["acknowledged"] is False or not m["ack_clears"])
        for i in b["loss_incidents"])


def _zone_sensor_down(s: dict, m: dict, zone_id: str) -> bool:
    if not m["zone_sensor_path"]:
        return False
    zones = (s.get("commissioning") or {}).get("zones") or []
    names = {z["sensor_id"] for z in zones if z.get("zone_id") == zone_id}
    return any(x["id"] in names and (x.get("stale") is True or x["connection"] != "connected")
               for x in s["sensors"])


REFUSALS = ("unit_mismatch", "direction_unsupported", "parameter_mismatch",
            "trip_point_unobservable", "undemonstrated_binding")


def trip_unresolved(s: dict, m: dict) -> bool:
    reg = s.get("safety_registry") or {}
    for z in s["safety_zones"]:
        if m["trip_needs_active"] and z["activation"] != "active":
            continue
        if z["trip_state"] != "tripped":
            continue
        if z["command_status"] == "driver_refused" or z["effect_verified"] == "mismatched":
            return True
        if z["effect_verified"] == "unknown" and z["trip_age_ms"] is not None and m["reached"](
                z["trip_age_ms"], reg.get("trip_verification_deadline_ms", float("inf"))):
            return True
    return False


SUBSYSTEMS = ("Any of `alert_outbox`, `commissioning`, `safety_registry`, `community_skills`, "
              "`config_authority`, `action_log_records`, `firmware_liveness`, `skill_hooks`, "
              "`evidence` or `evidence.action_records` has ")
UNKNOWN_DEGRADED = ("Any of `commissioning`, `community_skills`, `config_authority`, `evidence` or "
                    "`evidence.action_records` has ")


def unknown_critical(s: dict, m: dict) -> bool:
    return any(isinstance(block_named(s, n), dict) and block_named(s, n).get("state")
               == "unavailable" for n in m["critical_capable"])


PREDICATES: dict[str, tuple[str, Callable[[dict, dict], bool]]] = {
    "firmware_liveness_stopped": (
        "`firmware_liveness.loop` is `stopped_unexpectedly`.",
        lambda s, m: (fl := _fl(s)) is not None and fl["loop"] == "stopped_unexpectedly"),
    "firmware_liveness_tick_stale": (
        ("`firmware_liveness.loop` is `running` or `stopped_unexpectedly`, and either "
         "`last_successful_tick_age_ms` is not `null` and `≥ expiry_window_ms`, or it is `null` "
         "and `started_age_ms ≥ expiry_window_ms`."), tick_stale),
    "firmware_liveness_device_expired": (
        ("`firmware_liveness.loop` is not `stopped_cleanly`, and `expiring_device_ids` is "
         "non-empty."),
        lambda s, m: (fl := _live(s, m)) is not None and len(fl["expiring_device_ids"]) > 0),
    "firmware_liveness_over_capacity": (
        ("`firmware_liveness.loop` is not `stopped_cleanly`, and `supervised_devices > "
         "supported_device_capacity`."),
        lambda s, m: (fl := _live(s, m)) is not None
        and m["over"](fl["supervised_devices"], fl["supported_device_capacity"])),
    "firmware_liveness_tick_failures": (
        ("`firmware_liveness.loop` is not `stopped_cleanly`, and `consecutive_tick_failures > "
         "0`."),
        lambda s, m: (fl := _live(s, m)) is not None and fl["consecutive_tick_failures"] > 0),
    "decision_record_lost": (
        ("Some `action_log_records.loss_incidents[]` entry has `kind: \"decision_record_lost\"` "
         "and `acknowledged: false`."),
        lambda s, m: _incident(s, m, "decision_record_lost")),
    "action_log_records_lost": (
        ("Some `action_log_records.loss_incidents[]` entry has `kind: \"action_record_lost\"` "
         "and `acknowledged: false`."),
        lambda s, m: _incident(s, m, "action_record_lost")),
    "action_log_records_stalled": (
        "`action_log_records.oldest_pending_age_ms` is not `null` and `> stall_bound_ms`.",
        lambda s, m: (b := _alr(s)) is not None and b["oldest_pending_age_ms"] is not None
        and m["over"](b["oldest_pending_age_ms"], b["stall_bound_ms"])),
    "tier_c_records_degraded": (
        ("`evidence.action_records` is `available` and `lost > 0`, `unknown_live > 0`, or "
         "`pending ≥ ceiling`."),
        lambda s, m: (b := _ar(s)) is not None and (
            b["lost"] > 0 or b["unknown_live"] > 0 or m["reached"](b["pending"], b["ceiling"]))),
    "tier_c_recovery_failed": (
        "`evidence.action_records.recovery_failed` is `true`.",
        lambda s, m: (b := _ar(s)) is not None and b["recovery_failed"] is True),
    "sensor_unconnected": (
        "Some `sensors[]` entry has `connection: \"failed\"`.",
        lambda s, m: any(x["connection"] == "failed" for x in s["sensors"])),
    "sensor_measurement_degraded": (
        "Some `sensors[]` entry has `measurement_degraded: true`.",
        lambda s, m: any(x["measurement_degraded"] is True for x in s["sensors"])),
    "sensor_stale": (
        "Some `sensors[]` entry has `stale: true`.",
        lambda s, m: any(x.get("stale") is True for x in s["sensors"])),
    "tier_d_alert_delivery_unconfirmed": (
        ("`alert_outbox.tier_d_unresolved_count > 0`, and `tier_d_max_attempts ≥ "
         "tier_d_critical_warning_threshold` or `tier_d_oldest_age_ms ≥ tier_d_age_bound_ms`."),
        lambda s, m: (b := _blk(s, "alert_outbox")) is not None
        and b["tier_d_unresolved_count"] > 0 and (
            (b["tier_d_max_attempts"] is not None and m["reached"](
                b["tier_d_max_attempts"], b["tier_d_critical_warning_threshold"]))
            or (b["tier_d_oldest_age_ms"] is not None and m["reached"](
                b["tier_d_oldest_age_ms"], b["tier_d_age_bound_ms"])))),
    "alert_delivery_overdue": (
        ("`alert_outbox.oldest_non_tier_d_age_ms` is not `null` and `≥ overdue_bound_ms`."),
        lambda s, m: (b := _blk(s, "alert_outbox")) is not None
        and b["oldest_non_tier_d_age_ms"] is not None
        and m["reached"](b["oldest_non_tier_d_age_ms"], b["overdue_bound_ms"])),
    "skill_required_hooks_unavailable": (
        "`skill_hooks.required_unavailable > 0`.",
        lambda s, m: (b := _blk(s, "skill_hooks")) is not None and b["required_unavailable"] > 0),
    "skill_optional_hooks_unavailable": (
        "`skill_hooks.optional_unavailable > 0`.",
        lambda s, m: (b := _blk(s, "skill_hooks")) is not None and b["optional_unavailable"] > 0),
    "community_skills_refused": (
        "`community_skills.refused_skills > 0`.",
        lambda s, m: (b := _blk(s, "community_skills")) is not None and b["refused_skills"] > 0),
    "config_unsigned_value_source": (
        "`config_authority.unsigned_value_source` is `true`.",
        lambda s, m: (b := _blk(s, "config_authority")) is not None
        and b["unsigned_value_source"] is True),
    "evidence_posture_problem": (
        "`evidence.posture_problems` is non-empty. Holds in every evidence state.",
        lambda s, m: (len(s["evidence"]["posture_problems"]) > 0
                      and (m["posture_every_state"] or available(s["evidence"])))),
    "evidence_courier_answer_unrecognised": (
        ("`evidence.delivery_ledger_available` is `true` and `courier_answer_faults > 0`."),
        lambda s, m: flagged(s, m, "delivery_ledger_available", "courier_answer_faults")),
    "evidence_contributor_link_unresolved": (
        ("`evidence.attestation_summary_available` is `true` and "
         "`contributor_links_unresolved > 0`, in every evidence state."),
        lambda s, m: flagged(s, m, "attestation_summary_available",
                             "contributor_links_unresolved")),
    "commissioning_problem": (
        "`commissioning.problems` is non-empty.",
        lambda s, m: (b := _blk(s, "commissioning")) is not None and len(b["problems"]) > 0),
    "safety_zone_active_unprotected": (
        ("Some `safety_zones[]` entry has `activation: \"active\"`, and either its "
         "`protection_claim` is `unprotected`, or the `commissioning.zones[]` entry with its "
         "`zone_id` names a sensor whose `sensors[]` entry has `stale: true` or a `connection` "
         "other than `connected`."),
        lambda s, m: any(z["activation"] == "active" and (
            z["protection_claim"] in m["unprotected"] or _zone_sensor_down(s, m, z["zone_id"]))
            for z in s["safety_zones"])),
    "safety_zone_activation_refused": (
        ("Some `safety_zones[]` entry has an `activation` that is a refusal verdict: "
         "`unit_mismatch`, `direction_unsupported`, `parameter_mismatch`, "
         "`trip_point_unobservable` or `undemonstrated_binding`. Not `pending_ratification`."),
        lambda s, m: any(z["activation"] in m["refusals"] for z in s["safety_zones"])),
    "safety_zone_trip_unresolved": (
        ("Some `safety_zones[]` entry has `activation: \"active\"` and `trip_state: "
         "\"tripped\"`, and its `command_status` is `driver_refused`, or its `effect_verified` "
         "is `mismatched`, or its `effect_verified` is `unknown` and `trip_age_ms ≥ "
         "safety_registry.trip_verification_deadline_ms`."), trip_unresolved),
    "subsystem_starting": (
        (SUBSYSTEMS + "`state: \"starting\"`; or some `sensors[]` entry has `connection: "
         "\"pending\"`."),
        subsystem("starting", "pending")),
    "subsystem_state_unknown_critical": (
        ("A [critical-capable block](#unknown-critical-visibility) has `state: "
         "\"unavailable\"`."), unknown_critical),
    "subsystem_state_unknown": (
        (UNKNOWN_DEGRADED + "`state: \"unavailable\"`; or some `sensors[]` entry has `connection: "
         "\"unavailable\"`; or `evidence.state` is `available` and "
         "`attestation_summary_available`, `registration_available` or "
         "`delivery_ledger_available` is `false`."),
        subsystem("unavailable", "unavailable")),
}


# --- the model, read from the text ------------------------------------------------------

BLOCK_SECTIONS = {
    "capability_posture": "## Health Payload > ### `capability_posture` object",
    "sensors": "## Health Payload > ### `sensors[]` object",
    "last_alert_timestamps": "## Health Payload > ### `last_alert_timestamps` object",
    "device_policy": "## Health Payload > ### `device_policy` object",
    "alert_outbox": "## Health Payload > ### `alert_outbox` object",
    "remote_command_lockout": "## Health Payload > ### `remote_command_lockout` object",
    "gateway_broker_posture": "## Health Payload > ### `gateway_broker_posture` object",
    "state_store_encryption": "## Health Payload > ### `state_store_encryption` object",
    "evidence": "## Health Payload > ### `evidence` object",
    "evidence.action_records": "## Health Payload > ### `evidence` object > #### `action_records` object",
    "action_log_records": "## Health Payload > ### `action_log_records` object",
    "commissioning": "## Health Payload > ### `commissioning` object",
    "safety_registry": "## Health Payload > ### `safety_registry` object",
    "community_skills": "## Health Payload > ### `community_skills` object",
    "config_authority": "## Health Payload > ### `config_authority` object",
    "firmware_liveness": "## Health Payload > ### `firmware_liveness` object",
    "firmware_reading_age": "## Health Payload > ### `firmware_reading_age` object",
    "firmware_controller_profiles": "## Health Payload > ### `firmware_controller_profiles` object",
    "telemetry_export": "## Health Payload > ### `telemetry_export` object",
    "skill_hooks": "## Health Payload > ### `skill_hooks` object",
    "safety_zones": "## Health Payload > ### `safety_zones[]` object",
}
STATELESS = ("sensors", "last_alert_timestamps", "safety_zones")
SECTION_FLAGS = {"attestation summary": "attestation_summary_available",
                 "registration": "registration_available",
                 "delivery ledger": "delivery_ledger_available"}
# The members the condition table reads, per block and per entry; a snapshot case carries
# each wherever its Present column allows, and may carry any other member its table lists.
READ_MEMBERS = {
    "firmware_liveness": ("loop", "started_age_ms", "expiry_window_ms", "supervised_devices",
                          "supported_device_capacity", "consecutive_tick_failures",
                          "last_successful_tick_age_ms", "expiring_device_ids", "degraded"),
    "action_log_records": ("pending", "oldest_pending_age_ms", "ceiling", "lost", "stall_bound_ms",
                           "decision_records_lost", "loss_incidents"),
    "evidence.action_records": ("pending", "outcome_unknown", "dispatch_unproven", "lost",
                                "ceiling", "unknown_live", "oldest_pending_age_ms",
                                "recovery_failed"),
    "alert_outbox": ("tier_d_unresolved_count", "tier_d_max_attempts", "tier_d_oldest_age_ms",
                     "tier_d_age_bound_ms", "tier_d_critical_warning_threshold",
                     "oldest_non_tier_d_age_ms", "overdue_bound_ms"),
    "skill_hooks": ("required_unavailable", "optional_unavailable"),
    "community_skills": ("refused_skills",),
    "config_authority": ("unsigned_value_source",),
    "commissioning": ("problems", "zones"),
    "safety_registry": ("trip_verification_deadline_ms",),
    "sensors": ("id", "connection", "connected", "stale", "measurement_degraded"),
    "safety_zones": ("zone_id", "profile_id", "activation", "trip_state", "command_status",
                     "effect_verified", "trip_age_ms", "protection_claim"),
}
ALERT_DEFAULTS = {"tier_d_age_bound_ms": 300000, "overdue_bound_ms": 3600000,
                  "tier_d_critical_warning_threshold": 3}
COMMISSIONING_PROBLEMS = ("binding_missing", "retained_binding_not_in_force",
                          "retained_binding_unreadable", "retained_binding_for_another_device",
                          "binding_verifier_error")
POSTURE_PROBLEMS = ("signing_unavailable", "authority_keys_missing", "authority_keys_refused",
                    "authority_keys_incomplete", "custody_unconfigured")  # runtime-health/v3.md
CONNECTIONS = ("pending", "connected", "failed", "unavailable")
LOOPS = ("running", "stopped_cleanly", "stopped_unexpectedly")
CLAIMS = ("protected", "unprotected", "unavailable")  # runtime-health/v3.md, held below


def _states(body: str) -> list[str]:
    """The backticked states after "States:", up to the first full stop outside parentheses."""
    text = flat(body)
    at = text.find("States: ")
    if at < 0:
        raise Failure("a block section names no states")
    depth, kept = 0, []
    for ch in text[at + len("States: "):]:
        if ch == "." and depth == 0:
            break
        depth += ch == "("
        if depth == 0:
            kept.append(ch)
        depth -= ch == ")"
    return re.findall(r"`(\w+)`", "".join(kept))


def _types(cell: str) -> tuple[set[str], bool]:
    """The types a Type cell allows, and whether an object's values are `int`."""
    span = re.match(r"`([^`]+)`", cell)
    if span is None:
        raise Failure(f"a Type cell with no type: {cell!r}")
    return {kind.strip() for kind in span.group(1).split("|")}, "to `int`" in cell


INLINE = re.compile(r"`\{([^}]+)\}`,? (?:typed ((?:`\w+`(?:, )?)+)|both `(\w+)`|all `(\w+)`)")


def _inline(text: str) -> dict | None:
    """An object a row's text spells inline, `{a, b}` with its member types."""
    hit = INLINE.search(flat(text))
    if hit is None:
        return None
    names = [n.strip() for n in hit.group(1).split(",")]
    if hit.group(2):
        kinds = re.findall(r"`(\w+)`", hit.group(2))
    else:
        kinds = [hit.group(3) or hit.group(4)] * len(names)
    if len(kinds) != len(names):
        raise Failure(f"inline object types do not match its members: {hit.group(0)!r}")
    return {n: _row({k}, "always") for n, k in zip(names, kinds, strict=True)}


def _row(types: set[str], present: str, int_values: bool = False,
         tie: tuple[bool, str] | None = None, sub: dict | None = None) -> dict:
    return {"types": types, "present": present, "int_values": int_values, "tie": tie,
            "sub": sub, "set": False}


def sequence_ok(m: dict, field: str, row: dict, v: Any) -> bool:
    """Step 5's ordering rule: a set in byte order without duplicates; an ascending member
    ascending without duplicates. A value of the wrong type is step 4's."""
    if not isinstance(v, list):
        return True
    if row["set"] and all(isinstance(x, str) for x in v):
        keys = [x.encode() for x in v]
        if m["set_order"] and keys != sorted(keys):
            return False
        if m["set_dups"] and len(set(keys)) != len(keys):
            return False
    if field in m["ascending"] and m["ascending_check"] and all(
            isinstance(x, Num) and INT_FORM.fullmatch(x) for x in v):
        nums = [int(x) for x in v]
        if any(b <= a for a, b in itertools.pairwise(nums)):
            return False
    return True


def _tables(body: str) -> list[tuple[str, list[str], list[list[str]]]]:
    """(the line before it, header, rows) for every Field/Type table in a section."""
    lines = body.splitlines()
    out, i = [], 0
    while i < len(lines):
        ln = lines[i].strip()
        if ln.startswith("|") and cells(ln)[:2] == ["Field", "Type"]:
            label = next((x.strip() for x in reversed(lines[:i]) if x.strip()), "")
            rows, j = [], i + 2
            while j < len(lines) and lines[j].strip().startswith("|"):
                rows.append(cells(lines[j]))
                j += 1
            out.append((label, cells(ln), rows))
            i = j
        else:
            i += 1
    return out


def _schema_rows(header: list[str], rows: list[list[str]], body: str) -> dict:
    every_but_state = ("Every member other than `state` and `available` is present when "
                       "`available`.") in flat(body)
    out: dict = {}
    for c in rows:
        field = unquote(c[0])
        types, int_values = _types(c[1])
        rest = " ".join(c[2:])
        if "Present" in header:
            present = flat(c[header.index("Present")].split(";")[0]).strip("`")
        elif every_but_state and field not in ("state", "available"):
            present = "available"
        else:
            present = "always"
        tie = re.search(r"`(true|false)` exactly when `state` is `(\w+)`", rest)
        out[field] = _row(types, present, int_values or "values `int`" in rest,
                          None if tie is None else (tie.group(1) == "true", tie.group(2)),
                          _inline(rest))
        out[field]["set"] = types == {"string[]"} and re.search(r"\b[Aa] set\b", rest) is not None
    return out


def _attach(schema: dict, field: str, sub: dict) -> bool:
    for name, row in schema.items():
        if name == field and row["sub"] is None and row["types"] & {"object", "object[]"}:
            row["sub"] = sub
            return True
    return any(row["sub"] is not None and _attach(row["sub"], field, sub)
               for row in schema.values())


def section_schema(body: str, name: str) -> dict:
    """The section's first Field/Type table, with each later one attached to the member its
    preceding line names."""
    found = _tables(body)
    if not found:
        raise Failure(f"{name}: no Field/Type table")
    _, header, rows = found[0]
    schema = _schema_rows(header, rows, body)
    for label, header, rows in found[1:]:
        named = re.search(r"`(\w+)(?:\[\])?`", label)
        if named is None or not _attach(schema, named.group(1),
                                        _schema_rows(header, rows, body)):
            raise Failure(f"{name}: a table after {label!r} attaches to no member")
    return schema


def prose_objects(body: str, schema: dict) -> None:
    """Objects the evidence prose types: `x` is `{a, b, c}`, typed ..."""
    for hit in re.finditer(r"`(\w+)` is `\{([^}]+)\}`, typed ((?:`\w+`,? ?)+)", flat(body)):
        names = [n.strip() for n in hit.group(2).split(",")]
        kinds = re.findall(r"`(\w+)`", hit.group(3))
        if hit.group(1) not in schema or len(kinds) != len(names):
            raise Failure(f"evidence prose types {hit.group(1)} inconsistently")
        schema[hit.group(1)]["sub"] = {n: _row({k}, "always")
                                       for n, k in zip(names, kinds, strict=True)}


def vocabularies(body: str) -> dict[str, list[str]]:
    rows = table(body, ["Member", "Values"])
    out: dict[str, list[str]] = {}
    for member, values in rows:
        if member == ("`firmware_reading_age.devices[].liveness_bound` and every other "
                      "`liveness_bound`"):
            if values != "the string `unbounded`, or a liveness bound object":
                raise Failure(f"liveness_bound values reworded: {values!r}")
            out["*liveness_bound"] = ["unbounded"]
            continue
        if member == "projection `unknown_critical_blocks[]`":
            out["*projection.unknown_critical_blocks"] = re.findall(r"`([^`]*)`", values)
            continue
        if member == "liveness bound `name`":
            out["*liveness_bound.name"] = re.findall(r"`([^`]*)`", values)
            continue
        out[unquote(member)] = [v if v != "''" else "" for v in re.findall(r"`([^`]*)`", values)]
    return out


def contract_texts() -> dict[str, str]:
    return {"v4": HEALTH_V4.read_text(encoding="utf-8"),
            "gw": GATEWAY_V2.read_text(encoding="utf-8"),
            "v3": (ROOT / "runtime-health" / "v3.md").read_text(encoding="utf-8")}


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = texts or contract_texts()
    check_text(texts)
    v4 = dict(markdown.section_bodies(texts["v4"]))
    gw = dict(markdown.section_bodies(texts["gw"]))
    m: dict = {}

    conditions = table(v4["## Severity > ### Conditions"], ["Token", "Severity", "Holds when"])
    m["severity"], m["pred"], m["raised_order"] = {}, {}, []
    for token_cell, sev_cell, holds in conditions:
        token = unquote(token_cell)
        if token not in PREDICATES or PREDICATES[token][0] != holds:
            raise Failure(f"no model for condition {token!r} as worded: {holds!r}")
        m["severity"][token] = unquote(sev_cell)
        m["pred"][token] = PREDICATES[token][1]
        m["raised_order"].append(token)
    if set(PREDICATES) - set(m["pred"]):
        raise Failure(f"conditions gone from the table: {set(PREDICATES) - set(m['pred'])}")
    sev = re.search(r"in the order `(\w+)` < `(\w+)` < `(\w+)`, and `(\w+)` when none holds",
                    flat(v4["## Severity > ### Conditions"]))
    if sev is None:
        raise Failure("the severity order is not stated")
    m["order"] = list(sev.group(1, 2, 3))
    m["none_status"] = sev.group(4)
    umb = re.search(r"`(\w+)` is an umbrella token, not a condition",
                    flat(v4["## Severity > ### Conditions"]))
    if umb is None:
        raise Failure("no umbrella token")
    m["umbrella"] = umb.group(1)
    m["umbrella_of"] = [t for t in m["severity"] if t.startswith("firmware_liveness_")]
    if len(m["umbrella_of"]) != 5 or "exactly when one of the five `firmware_liveness_*` " \
            "conditions above holds" not in flat(v4["## Severity > ### Conditions"]):
        raise Failure("the umbrella no longer covers five liveness conditions")
    owners = {"safety_zones": "safety_registry"}  # safety_zones is [] unless the registry is
    # available: the registry decides the pairs' conditions (safety_zones[] object section)
    need(v4["## Health Payload > ### `safety_zones[]` object"], "It is `[]` unless "
         "`safety_registry.state` is `available`", "safety_zones")
    capable = []
    for token, sev in m["severity"].items():
        if sev != m["order"][-1] or token == "subsystem_state_unknown_critical":
            continue
        first = re.search(r"`([a-z_]+)", PREDICATES[token][0])
        if first is None:
            raise Failure(f"{token}: no block named first")
        block = owners.get(first.group(1), first.group(1))
        if block not in capable:
            capable.append(block)
    m["critical_capable"] = capable
    listed = re.search(r"The rule yields exactly (.+?)\. Every other block",
                       flat(v4["## Severity > ### Unknown critical visibility"]))
    if listed is None or sorted(re.findall(r"`([a-z_]+)` \(", listed.group(1))) != sorted(capable):
        raise Failure(f"the listed critical-capable blocks differ from the rule's {capable}")
    starting = flat(PREDICATES["subsystem_starting"][0]).split(" has ")[0]
    m["starting_blocks"] = re.findall(r"`([\w.]+)`", starting)
    unknown = flat(PREDICATES["subsystem_state_unknown"][0]).split(" has ")[0]
    m["unknown_blocks"] = re.findall(r"`([\w.]+)`", unknown)
    m["unknown_flags"] = ["attestation_summary_available", "registration_available",
                          "delivery_ledger_available"]

    vocab = table(gw["## Runtime Node Heartbeat Payload > ### `degradation_reasons`"],
                  ["Token", "Severity", "Meaning"])
    m["vocabulary"] = {unquote(t): (None if s == "none" else unquote(s)) for t, s, _ in vocab}
    only = [unquote(t) for t, _, meaning in vocab if "Published by the heartbeat alone" in meaning]
    if len(only) != 1:
        raise Failure("no heartbeat-only token")
    m["heartbeat_only"] = only[0]
    for token, severity in m["severity"].items():
        if m["vocabulary"].get(token, "missing") != severity:
            raise Failure(f"gateway-api/v2 gives {token} severity "
                          f"{m['vocabulary'].get(token, 'missing')}, runtime-health/v4 {severity}")
    extra = set(m["vocabulary"]) - set(m["severity"]) - {m["umbrella"], m["heartbeat_only"]}
    if extra or m["vocabulary"].get(m["umbrella"], "x") is not None:
        raise Failure(f"gateway vocabulary holds tokens no condition names: {extra}")
    count = re.search(r"The vocabulary holds (\d+) tokens\. A conforming heartbeat names either "
                      r"`(\w+)` alone, or a combination of the other (\d+)\. Not all (\d+) can hold "
                      r"at once, because a block that names `subsystem_state_unknown_critical` cannot "
                      r"also name its own conditions, but the bound admits all (\d+) together\.",
                      flat(gw["## Runtime Node Heartbeat Payload > ### `degradation_reasons`"]))
    if count is None or int(count.group(1)) != len(m["vocabulary"]) \
            or count.group(2) != m["heartbeat_only"] \
            or len({int(count.group(i)) for i in (3, 4, 5)} | {len(m["vocabulary"]) - 1}) != 1:
        raise Failure("the gateway's stated token counts disagree with its table")

    t_rows = table(v4["## Heartbeat Mapping"], ["Step", "Check", "Failure"])
    m["t_steps"] = [(step, unquote(fail)) for step, _, fail in t_rows]
    if [s for s, _ in m["t_steps"]] != ["T1", "T2", "T3", "T4", "T5"]:
        raise Failure("the triple check is not T1 to T5")
    t5 = re.fullmatch(r"The whole snapshot passes \[snapshot checks\]\(#snapshot-checks\) "
                      r"(\d+) to (\d+)", t_rows[4][1])
    if t5 is None:
        raise Failure("T5 reworded")
    m["t5_steps"] = list(range(int(t5.group(1)), int(t5.group(2)) + 1))
    bound = re.search(r"an array of at most (\d+) strings", t_rows[2][1])
    if bound is None:
        raise Failure("T3 states no bound")
    m["max_reasons"] = int(bound.group(1))
    mapping = table(v4["## Heartbeat Mapping"],
                    ["Snapshot", "Heartbeat `status`", "Heartbeat `degradation_reasons`"])
    m["mapping"] = {}
    for snap, status, reasons in mapping:
        hit = re.fullmatch(r"Passes, `status: \"(\w+)\"`", snap)
        if hit:
            m["mapping"][hit.group(1)] = (unquote(status), reasons)
        elif snap == "Fails a step":
            m["mapping"][None] = (unquote(status), reasons)
        else:
            raise Failure(f"unknown mapping row {snap!r}")
    rules = split_sentences(dict(markdown.section_bodies(texts["v4"]))[
        "## Conformance > ### Snapshot checks > #### Consistency rules"])
    if rules != ["Snapshot check 5 enforces each of these:", *(r for r, _ in CONSISTENCY)]:
        raise Failure("the consistency rules changed")
    snap_rows = table(v4["## Conformance > ### Snapshot checks"], ["Step", "Check", "Verdict"])
    shape_cell = next(c for _, c, v in snap_rows if v == "`shape_invalid`")
    m["ascending"] = re.findall(r"`(\w+)` is ascending without duplicates", shape_cell)
    if not m["ascending"] or "every [set](#representation) other than `degradation_reasons` is " \
            "in byte order and holds no duplicates" not in shape_cell:
        raise Failure("the shape check no longer states the set rule")
    need(v4["## Conformance > ### Snapshot checks"], "A member that fails step 3 or step 4 leaves "
         "the conditions it feeds undefined, so steps 9 and 10 are not judged for that response; "
         "its verdict is still the first failing step.", "Snapshot checks")
    m["snapshot_steps"] = {int(step): unquote(v) for step, _, v in snap_rows}
    gw_rows = table(gw["## Runtime Node Heartbeat Payload > ### `degradation_reasons`"],
                    ["Step", "Check", "Verdict on failure"])
    m["gateway_steps"] = []
    for step, check_text_, v in gw_rows:
        if check_text_ not in GATEWAY_CHECKS:
            raise Failure(f"no model for gateway step {step} as worded: {check_text_!r}")
        m["gateway_steps"].append((int(step), check_text_, None if v == "—" else unquote(v)))
    if [s_ for s_, _, _ in m["gateway_steps"]] != list(range(1, len(gw_rows) + 1)):
        raise Failure("gateway steps are not numbered in order")
    first = re.fullmatch(r"`status` is the string `\"(\w+)\"`, `\"(\w+)\"` or `\"(\w+)\"`; never "
                         r"`\"starting\"` on this topic", gw_rows[0][1])
    if first is None:
        raise Failure("gateway step 1 names no statuses")
    m["runtime_statuses"] = list(first.group(1, 2, 3))
    row = next(r for r in gw_rows if r[1].startswith("non-empty reasons require"))
    row8 = re.search(r"require `status` to be `\"(\w+)\"` or `\"(\w+)\"`", row[1])
    if row8 is None:
        raise Failure("the status row names no statuses")
    m["reason_statuses"] = list(row8.group(1, 2))
    glen = next(re.fullmatch(r"length is `(\d+) \.\. (\d+)`", r[1]) for r in gw_rows
                if r[1].startswith("length is"))
    if glen is None:
        raise Failure("the gateway length row is not a range")
    m["gateway_length"] = (int(glen.group(1)), int(glen.group(2)))
    m["gateway_order"] = [s_ for s_, _, _ in m["gateway_steps"]]

    req = v4["## Request"]
    req_rows = table(req, ["Step", "Rule", "Result"])
    m["request_steps"] = [(int(step), rule, result) for step, rule, result in req_rows]
    big = re.fullmatch(r"The request is longer than (\d+) bytes, counting its LF", req_rows[0][1])
    if big is None:
        raise Failure("request step 1 states no bound")
    m["request_bound"] = int(big.group(1))
    hexes = re.search(r"`GET_HEALTH` is the ten ASCII bytes `([0-9a-f ]+)`; LF is the byte `0a`",
                      flat(req))
    if hexes is None:
        raise Failure("the request bytes are not stated")
    get = bytes.fromhex(hexes.group(1))
    if get != b"GET_HEALTH":
        raise Failure("the stated bytes are not GET_HEALTH")
    if req_rows[2][1] != ("The request is exactly one of `GET_HEALTH`, `GET_HEALTH` LF, the empty "
                          "request, or LF"):
        raise Failure("request step 3 changed")
    m["accepted"] = {get, get + b"\n", b"", b"\n"}
    m["refused_classes"] = {
        "CR": [b"\r"], "tab": [b"\t"], "x0b": [b"\x0b"], "x0c": [b"\x0c"],
        "x1c": [b"\x1c"], "x1d": [b"\x1d"], "x1e": [b"\x1e"], "x1f": [b"\x1f"],
        "NEL": ["\u0085".encode()], "NBSP": [" ".encode()], "U+2028": [" ".encode()],
        "U+2029": [" ".encode()], "BOM": ["﻿".encode()], "NUL": [b"\x00"],
        "invalid UTF-8": [], "space": [b" "],
    }
    need(req, "A carriage return, any other ASCII or Unicode whitespace or separator (`\\t`, "
         "`\\x0b`, `\\x0c`, `\\x1c` to `\\x1f`, NEL U+0085, NBSP U+00A0, U+2028, U+2029, a byte "
         "order mark), a NUL, and any byte that is not valid UTF-8, anywhere before the "
         "terminating LF, makes the request one that step 4 refuses.", "Request")

    rep = flat(v4["## Representation"])
    rng = re.search(r"A row that gives no range means `(\d+)` to `(\d+)` \(2\^53−1\)", rep)
    if rng is None:
        raise Failure("the default integer range is not stated")
    m["int_range"] = (int(rng.group(1)), int(rng.group(2)))
    if m["int_range"][1] != 2**53 - 1:
        raise Failure("the stated range is not 2^53-1")

    proj = table(v4["## Remote Health Projection"], ["Projection member", "Content"])
    rows = {r[0]: r[1] for r in proj}
    m["projection_name"] = unquote(rows["`projection`"].rstrip("."))
    if rows.get("`device_id`") != "The snapshot's: the node's routing identity.":
        raise Failure("the projection's device_id row changed")
    copied = next(k for k in rows if k.startswith("`uptime_s`"))
    if rows[copied] != "The snapshot's.":
        raise Failure("the projection's copied row changed")
    m["projection_copied"] = re.findall(r"`(\w+)`", copied)
    blocks = next(k for k, v in rows.items() if v == (
        "The snapshot's block, with only its present members that this version's tables list, "
        "nested ones included, except `commissioning.last_verdict`, which is projected as "
        "`{binding_seq, at_ms}`."))
    ucb = rows.get("`unknown_critical_blocks`", "")
    if sorted(re.findall(r"`([a-z_]+)`", ucb.split("from ", 1)[-1])) != sorted(
            m["critical_capable"]):
        raise Failure("the projection's unknown_critical_blocks names other blocks")
    need(v4["## Remote Health Projection"], "**A snapshot that fails the triple check**, T1 to "
         "T5, projects to the minimal projection: `projection`, the runtime's own `device_id`, "
         "`status: \"critical\"`, `critical: true` and `degradation_reasons: "
         "[\"health_snapshot_invalid\"]`, and nothing else from the snapshot.", "projection")
    m["projection_blocks"] = re.findall(r"`(\w+)`", blocks)
    for name, content in PROJECTION_ROWS.items():
        if rows.get(f"`{name}`") != content:
            raise Failure(f"the projection row for {name} changed")
    if set(rows) != {"`projection`", "`device_id`", copied, blocks, "`unknown_critical_blocks`",
                     *(f"`{n}`" for n in PROJECTION_ROWS)}:
        raise Failure("the projection table gained or lost a row")
    never = re.search(r"Never projected: (.+?)\. The projection follows",
                      flat(v4["## Remote Health Projection"]))
    if never is None:
        raise Failure("the never-projected list is gone")
    never_top = {n for n in re.findall(r"`([\w.]+)`", never.group(1)) if "." not in n}
    assigned = {"device_id", *m["projection_copied"], *m["projection_blocks"], *PROJECTION_ROWS}
    payload_members = {unquote(r[0]) for r in table(v4["## Health Payload"],
                                                   ["Field", "Type", "Notes"])}
    unassigned = payload_members - assigned - never_top
    if unassigned or assigned & never_top:
        raise Failure(f"payload members neither projected nor listed as local: {unassigned}, "
                      f"or both: {assigned & never_top}")
    m["project_local"] = False
    m["verdict_trimmed"] = True
    m["project_unknown_critical"] = True
    m["minimal_projection"] = True
    m["minimal_from_snapshot"] = False
    m["count_all_locked"] = False
    m["states"] = {name: _states(v4[path]) for name, path in BLOCK_SECTIONS.items()
                   if name not in STATELESS}
    m["schema"] = {name: section_schema(v4[path], name) for name, path in BLOCK_SECTIONS.items()}
    prose_objects(v4[BLOCK_SECTIONS["evidence"]], m["schema"]["evidence"])
    m["schema"]["evidence"]["action_records"]["sub"] = m["schema"]["evidence.action_records"]
    m["bound"] = section_schema(
        v4["## Health Payload > ### `firmware_reading_age` object > #### Liveness bound object"],
        "liveness bound")
    m["vocab"] = vocabularies(v4["## Representation > ### Value vocabularies"])
    diag = flat(v4["## Health Payload > ### Diagnostics"])
    ns = re.search(r"namespaced by subsystem, each an object of unspecified content: ((?:`\w+`,? ?)+)\.",
                   diag)
    if ns is None:
        raise Failure("the diagnostics namespaces are not listed")
    m["namespaces"] = re.findall(r"`(\w+)`", ns.group(1))
    need(diag, "Each namespace's value is an object. The integer rule does not apply inside "
         "`diagnostics`, and no check judges a value there", "Diagnostics")
    need(v4["## Health Payload > ### `device_policy` object"], "A member whose Present is `held` "
         "is present exactly when `state` is `available` and `policy_held` is `true`.",
         "device_policy")
    need(v4["## Health Payload > ### `alert_outbox` object"], "A deployment may set one lower "
         "than its default, never higher: a configured value above the default is refused when "
         "the configuration loads, never clamped.", "alert_outbox")
    for key, default in ALERT_DEFAULTS.items():
        need(v4["## Health Payload > ### `alert_outbox` object"], f"Default `{default}`",
             f"alert_outbox {key}")
    need(v4["## Health Payload > ### `safety_registry` object"], "Release-owned: `10000` in this "
         "release, and never above `60000` in any.", "safety_registry")
    payload = table(v4["## Health Payload"], ["Field", "Type", "Notes"])
    m["payload"] = {unquote(f): _types(t)[0] for f, t, _ in payload}
    need(v4["## Representation"], "**Floats.** A member typed `float` is a finite JSON number, at "
         "least `0`.", "Representation")
    for name in m["states"]:
        if "state" not in m["schema"][name]:
            raise Failure(f"{name} names states and has no state row")
    dl = flat(v4["## Representation > ### Block states > #### Startup deadline"])
    need(dl, "Once the time since that start reaches the deadline, a block that is not yet ready "
         "reports `unavailable`, never `starting`, and a sensor whose adapter has not been "
         "connected reports `connection: \"unavailable\"`.", "Startup deadline")
    m["deadline_passed"] = lambda elapsed, deadline: elapsed >= deadline
    m["stale_loops"] = ("running", "stopped_unexpectedly")
    m["reached"] = lambda a, b: a >= b
    m["over"] = lambda a, b: a > b
    m["null_tick_counts_start"] = True
    m["posture_every_state"] = True
    m["unprotected"] = ("unprotected",)
    m["fold"] = "max"
    m["umbrella_in_reasons"] = True
    m["skip_t"] = None
    m["consistency"] = [name for _, name in CONSISTENCY]
    m["needle_completeness"] = False
    m["umbrella_counts_nothing"] = True
    m["hb_evidence_always"] = False
    m["trip_deadline_max"] = 60000
    m["trip_deadline"] = 10000
    m["clean_stop_exempt"] = True
    m["ack_clears"] = True
    m["zone_sensor_path"] = True
    m["trip_needs_active"] = True
    m["refusals"] = REFUSALS
    m["int_form_required"] = True
    m["negative_floats"] = False
    m["check_states"] = True
    m["check_ties"] = True
    m["check_presence"] = True
    m["check_flags"] = True
    m["dup_step"] = 2
    m["set_order"] = True
    m["set_dups"] = True
    m["ascending_check"] = True
    m["forced_by_type"] = True
    m["check_types"] = True
    m["check_vocab"] = True
    m["type_after_shape"] = False
    m["diag_namespaces"] = True
    m["diag_ints"] = False
    m["held_rule"] = True
    m["diag_namespace_objects"] = True
    m["skip_response_step"] = None
    m["not_alone_needs_critical"] = True
    m["presence_terminates"] = True
    m["flag_rows_need_available"] = False
    m["refuse_heartbeat_token"] = True
    m["skip_snapshot_step"] = None
    m["skip_gateway_step"] = None
    m["judge_discarded"] = False
    m["time_bound"] = True
    m["size_first"] = True
    m["expiry_never_null"] = True
    m["expiry_never_not_expired"] = True
    m["fallback_from_snapshot"] = False
    m["ok_reasons_present"] = False
    m["evidence_unavailable_signs"] = True
    m["lost_is_sum"] = True
    m["stall_bound"] = 30000
    m["expiry_window"] = 60000
    need(v4["## Health Payload > ### `action_log_records` object"],
         "| `stall_bound_ms` | `int` | available | Release-owned. `30000` in this version. |",
         "action_log_records")
    need(v4["## Health Payload > ### `firmware_liveness` object"],
         "[firmware-commands/v1.md](../firmware-commands/v1.md), `60000`.", "firmware_liveness")
    need(texts["v3"], "Closed vocabulary: `protected`, `unprotected`, `unavailable`.",
         "runtime-health/v3 protection_claim")
    need(texts["v3"], "from the closed vocabulary `signing_unavailable` (the ledger or device key "
         "did not open), `authority_keys_missing`", "runtime-health/v3 posture_problems")
    for word in POSTURE_PROBLEMS:
        need(texts["v3"], f"`{word}` (", "runtime-health/v3 posture_problems")
    return m


# --- the model's verdicts ------------------------------------------------------------------

def rank(m: dict, status: str) -> int:
    return m["order"].index(status)


def fold(m: dict, holding: list[str]) -> dict:
    """status, critical and degradation_reasons from the conditions that hold, as raised."""
    status = m["none_status"]
    if m["fold"] == "max":
        for token in holding:
            if rank(m, m["severity"][token]) > rank(m, status):
                status = m["severity"][token]
    elif m["fold"] == "last":
        for token in holding:
            status = m["severity"][token]
    elif m["fold"] == "min" and holding:
        status = min((m["severity"][t] for t in holding), key=lambda x: rank(m, x))
    reasons = set(holding)
    if m["umbrella_in_reasons"] and reasons & set(m["umbrella_of"]):
        reasons.add(m["umbrella"])
    return {"status": status, "critical": status == m["order"][-1],
            "degradation_reasons": sorted(reasons, key=lambda t: t.encode())}


def holding(m: dict, s: dict) -> list[str]:
    return [t for t in m["raised_order"] if t in m["pred"] and m["pred"][t](s, m)]


def is_int(v: Any, m: dict) -> bool:
    return type(v) is int and m["int_range"][0] <= v <= m["int_range"][1]


def is_set(v: Any) -> bool:
    return (isinstance(v, list) and all(isinstance(x, str) for x in v)
            and [x.encode() for x in v] == sorted({x.encode() for x in v}))


def plain_type_ok(m: dict, v: Any, types: set[str]) -> bool:
    for t in types:
        if t == "int" and type(v) is int and is_int(v, m):
            return True
        if t == "float" and type(v) in (int, float) and math.isfinite(v) and v >= 0:
            return True
        if t == "int[]" and isinstance(v, list) and all(type(x) is int for x in v):
            return True
        if t not in ("int", "float", "int[]") and TYPE_TESTS[t](v):
            return True
    return False


def allowed_members(schema: dict, block: dict) -> tuple[set[str], set[str]]:
    """(members the Present column allows here, members it requires here)."""
    state = block.get("state")
    allow = set()
    for field, row in schema.items():
        present = row["present"]
        if present == "always" or (present == "available" and state == "available") or (
                present in SECTION_FLAGS and block.get(SECTION_FLAGS[present]) is True) or (
                present == "held" and state == "available" and block.get("policy_held") is True) \
                or present == state:
            allow.add(field)
    return allow, allow


def subset_ok(m: dict, name: str, block: Any, read: tuple[str, ...]) -> list[str]:
    """A snapshot case's block or entry: its members a subset of what its table allows,
    every member the conditions read present where allowed, each of its row's type."""
    schema = m["schema"].get(name)
    if schema is None or not isinstance(block, dict):
        return [f"{name}: not an object"]
    if name in m["states"] and block.get("state") not in m["states"][name]:
        return [f"{name}: state {block.get('state')!r}"]
    allow, _ = allowed_members(schema, block)
    bad = []
    if set(block) - allow:
        bad.append(f"{name}: members its Present column does not allow: "
                   f"{sorted(set(block) - allow)}")
    if block.get("state", "available") == "available" and (set(read) & allow) - set(block):
        bad.append(f"{name}: condition members missing: {sorted((set(read) & allow) - set(block))}")
    for k, v in block.items():
        if k in schema and not plain_type_ok(m, v, schema[k]["types"]):
            bad.append(f"{name}.{k}: {v!r} is not {sorted(schema[k]['types'])}")
        if k in schema and schema[k]["set"] and not is_set(v):
            bad.append(f"{name}.{k}: not a set")
        row = schema.get(k)
        if row is not None and row["tie"] is not None:
            truth, tied = row["tie"]
            if v is not ((block.get("state") == tied) is truth):
                bad.append(f"{name}.{k} disagrees with state")
    return bad


def entries(m: dict, name: str, block: dict, field: str) -> list[str]:
    sub = m["schema"][name][field]["sub"]
    bad = []
    for x in block.get(field) or []:
        if not isinstance(x, dict) or set(x) != set(sub) or not all(
                plain_type_ok(m, x[k], sub[k]["types"]) for k in sub):
            bad.append(f"{name}.{field} entry {x!r}")
    return bad


def shape(m: dict, s: dict, startup: dict | None) -> list[str]:
    """Why a snapshot case breaks a Present column, a section flag, a state, a type or a
    stated relation between its members."""
    bad: list[str] = []
    want = {"firmware_liveness", "action_log_records", "evidence", "sensors", "alert_outbox",
            "skill_hooks", "community_skills", "config_authority", "commissioning",
            "safety_registry", "safety_zones"}
    if not want <= set(s) or not set(s) <= set(m["payload"]):
        return [f"blocks {sorted(set(s) ^ want)}"]
    for name in sorted(set(s) - want - {"sensors", "safety_zones"}):
        bad += subset_ok(m, name, s[name], ())
        if (s[name] or {}).get("state") != "available" and len(s[name]) > len(
                [f for f, r in m["schema"][name].items() if r["present"] == "always"]):
            bad.append(f"{name}: members beside state while {s[name].get('state')}")
    for name, read in READ_MEMBERS.items():
        if name in ("sensors", "safety_zones"):
            continue
        bad += subset_ok(m, name, block_named(s, name), read)
    if bad:
        return bad
    fl = s["firmware_liveness"]
    if available(fl):
        if fl["expiry_window_ms"] != m["expiry_window"]:
            bad.append("firmware_liveness.expiry_window_ms is not the release value")
        live = [t for t in m["umbrella_of"] if m["pred"].get(t, lambda *_: False)(s, m)]
        if fl["degraded"] is not bool(live):
            bad.append("firmware_liveness.degraded is not the umbrella")
    alr = s["action_log_records"]
    if available(alr):
        if alr["stall_bound_ms"] != m["stall_bound"]:
            bad.append("action_log_records.stall_bound_ms is not the release value")
        if (alr["oldest_pending_age_ms"] is None) is not (alr["pending"] == 0):
            bad.append("action_log_records.oldest_pending_age_ms null exactly when pending is 0")
        bad += entries(m, "action_log_records", alr, "loss_incidents")
        for i in alr["loss_incidents"]:
            if i.get("kind") not in m["vocab"]["action_log_records.loss_incidents[].kind"] \
                    or i.get("count", 0) < 1:
                bad.append(f"loss incident {i!r}")
    ar = s["evidence"]["action_records"]
    if available(ar):
        if m["lost_is_sum"] and ar["lost"] != ar["outcome_unknown"] + ar["dispatch_unproven"]:
            bad.append("action_records.lost is not outcome_unknown plus dispatch_unproven")
        if (ar["oldest_pending_age_ms"] is None) is not (ar["pending"] == 0):
            bad.append("action_records.oldest_pending_age_ms null exactly when pending is 0")
    ao = s["alert_outbox"]
    if available(ao):
        none = ao["tier_d_unresolved_count"] == 0
        if (ao["tier_d_max_attempts"] is None) is not none \
                or (ao["tier_d_oldest_age_ms"] is None) is not none:
            bad.append("alert_outbox Tier D members null exactly when none is unresolved")
    reg = s["safety_registry"]
    bad += [f"consistency rule {r}" for r in consistency_faults(m, s)]
    if available(reg) and reg["trip_verification_deadline_ms"] != m["trip_deadline"]:
        bad.append("trip_verification_deadline_ms is not this release's value")
    com = s["commissioning"]
    if available(com):
        if not set(com["problems"]) <= set(m["vocab"]["commissioning.problems[]"]):
            bad.append("commissioning.problems outside its vocabulary")
        bad += entries(m, "commissioning", com, "zones")
    ev = s["evidence"]
    flags = ("attestation_summary_available", "registration_available", "delivery_ledger_available")
    evkeys = {"state", "posture_problems", "action_records", *flags}
    if not all(type(ev.get(f)) is bool for f in flags):
        bad.append("evidence flags not booleans")
    else:
        st = ev["state"]
        bad += flag_faults(ev)
        want_keys = set(evkeys)
        if ev["attestation_summary_available"]:
            want_keys.add("contributor_links_unresolved")
        if ev["delivery_ledger_available"]:
            want_keys.add("courier_answer_faults")
        allow, _ = allowed_members(m["schema"]["evidence"], ev)
        if not want_keys <= set(ev) or set(ev) - allow:
            bad.append(f"evidence members missing {sorted(want_keys - set(ev))} or not "
                       f"allowed {sorted(set(ev) - allow)}")
        pp = ev["posture_problems"]
        if not is_set(pp) or not set(pp) <= set(m["vocab"]["evidence.posture_problems[]"]):
            bad.append(f"evidence.posture_problems {pp!r}")
        elif m["evidence_unavailable_signs"] and ("signing_unavailable" in pp) is not (
                st == "unavailable"):
            bad.append(f"signing_unavailable listed is {'signing_unavailable' in pp}, "
                       f"evidence is {st}")
    sensors = s["sensors"]
    if not isinstance(sensors, list) or not sensors:
        bad.append("sensors")
    else:
        for x in sensors:
            if set(x) != set(READ_MEMBERS["sensors"]) \
                    or x["connection"] not in m["vocab"]["sensors[].connection"] \
                    or x["connected"] is not (x["connection"] == "connected") \
                    or type(x["measurement_degraded"]) is not bool or type(x["stale"]) is not bool \
                    or (x["stale"] and x["connection"] != "connected"):
                bad.append(f"sensor {x!r}")
        if len({x.get("id") for x in sensors}) != len(sensors):
            bad.append("sensor ids repeat")
    zones = s["safety_zones"]
    if not isinstance(zones, list) or (zones and not available(reg)):
        bad.append("safety_zones not [] under a registry that is not available")
    else:
        pairs = set()
        for z in zones:
            vocab_ok = all(z.get(k) in m["vocab"][f"safety_zones[].{k}"] for k in (
                "activation", "trip_state", "command_status", "effect_verified",
                "protection_claim"))
            if set(z) != set(READ_MEMBERS["safety_zones"]) or not vocab_ok:
                bad.append(f"safety zone {z!r}")
                continue
            if (z["trip_age_ms"] is None) is not (z["trip_state"] != "tripped"):
                bad.append(f"trip_age_ms null exactly when not tripped: {z!r}")
            pairs.add((z["zone_id"], z["profile_id"]))
        if len(pairs) != len(zones):
            bad.append("a (zone_id, profile_id) pair repeats")
    if startup is not None:
        bad += startup_states(m, s, startup)
    return bad


def startup_states(m: dict, s: dict, st: dict) -> list[str]:
    """The states a startup case's inputs resolve to, against those shown."""
    bad = []
    if set(st) != {"not_ready", "elapsed_ms", "deadline_ms"} or not st["not_ready"]:
        return [f"startup inputs {sorted(st)}"]
    passed = m["deadline_passed"](st["elapsed_ms"], st["deadline_ms"])
    block_state = "unavailable" if passed else "starting"
    sensor_state = "unavailable" if passed else "pending"
    named = set(st["not_ready"])
    for name in m["starting_blocks"]:
        b = block_named(s, name)
        got = b.get("state")
        if name in named and got != block_state:
            bad.append(f"startup: {name} is {got}, the inputs give {block_state}")
        if name not in named and got in ("starting", "unavailable"):
            bad.append(f"startup: {name} is {got} and is not named not ready")
    for i, x in enumerate(s["sensors"]):
        key = f"sensor:{i}"
        if key in named and x["connection"] != sensor_state:
            bad.append(f"startup: {key} is {x['connection']}, the inputs give {sensor_state}")
        if key not in named and x["connection"] in ("pending", "unavailable"):
            bad.append(f"startup: {key} is {x['connection']} and is not named not ready")
    unknown = named - set(m["starting_blocks"]) - {f"sensor:{i}" for i in range(len(s["sensors"]))}
    if unknown:
        bad.append(f"startup: unknown names {sorted(unknown)}")
    return bad


def triple_check(m: dict, snap: Any, whole: bool = False) -> str | None:
    """The first T-step the snapshot fails, or None. T5 judges a whole snapshot; a case that
    carries only the triple is judged by T1 to T4."""
    vocab = m["vocabulary"]
    obj = snap if isinstance(snap, dict) else {}
    status = obj.get("status")
    r = obj.get("degradation_reasons")
    tokens = r if isinstance(r, list) else []
    for step, verdict in m["t_steps"]:
        if step == m["skip_t"]:
            continue
        if step == "T1":
            if not isinstance(snap, dict) or not isinstance(status, str) \
                    or status not in m["order"]:
                return verdict
        elif step == "T2":
            if type(obj.get("critical")) is not bool \
                    or obj["critical"] is not (status == m["order"][-1]):
                return verdict
        elif step == "T3":
            if not isinstance(r, list) or len(r) > m["max_reasons"] or not is_set(r) \
                    or any(t not in vocab or (m["refuse_heartbeat_token"]
                                              and t == m["heartbeat_only"]) for t in r):
                return verdict
        elif step == "T4":
            if (not tokens) is not (status == m["none_status"]):
                return verdict
            liveness = any(t in m["umbrella_of"] for t in tokens)
            if (m["umbrella"] in tokens) is not liveness:
                return verdict
            if status != m["none_status"]:
                ranks = [rank(m, vocab[t]) for t in tokens
                         if isinstance(t, str) and vocab.get(t) is not None]
                if not ranks or status not in m["order"] or max(ranks) != rank(m, status):
                    return verdict
        elif step == "T5" and whole:
            text = json.dumps({"schema_version": 1, "ok": True, "health": snap}) + "\n"
            if set(response_failures(m, text)) & set(m["t5_steps"]):
                return verdict
    return None


def heartbeat(m: dict, snap: Any, whole: bool = False) -> dict:
    failed = triple_check(m, snap, whole)
    status, reasons = m["mapping"][None if failed is not None else snap["status"]]
    out: dict = {"failed_step": failed, "status": status}
    if failed is not None:
        if reasons != "`[\"health_snapshot_invalid\"]`":
            raise Failure(f"the failing row maps reasons to {reasons!r}")
        out["degradation_reasons"] = [m["heartbeat_only"]]
    elif reasons == "the snapshot's reasons":
        out["degradation_reasons"] = list(snap["degradation_reasons"])
    elif reasons == "absent":
        if m["ok_reasons_present"]:
            out["degradation_reasons"] = []
    else:
        raise Failure(f"unknown mapping of reasons: {reasons!r}")
    return out


def heartbeat_message(m: dict, case: dict) -> tuple[str | None, dict]:
    """The exact heartbeat a whole snapshot maps to, every field from its stated source."""
    snap, rt = case["snapshot"], case["runtime"]
    mapped = heartbeat(m, snap, whole=True)
    out: dict = {"device_id": rt["device_id"], "status": mapped["status"],
                 "last_seen_ms": rt["now_ms"], "gateway_seen_ms": 0, "active_triggers": []}
    if "degradation_reasons" in mapped:
        out["degradation_reasons"] = mapped["degradation_reasons"]
    ev = snap.get("evidence") if isinstance(snap, dict) else None
    if mapped["failed_step"] is None and isinstance(ev, dict) and (
            m["hb_evidence_always"] or (ev.get("state") == "available"
                                        and ev.get("attestation_summary_available") is True)):
        out["evidence"] = {"chain_head_hash": ev.get("chain_head_hash", ""),
                           "attestation_gap_count": ev.get("attestation_gap_count", 0),
                           "available": True, "action_event_type": ev.get("action_event_type", "")}
    if rt["auth_enabled"]:
        out["auth"] = case["expected"].get("auth", "missing")
    return mapped["failed_step"], out


PROJECTION_ROWS = {
    "last_alert_timestamps": "`{by_channel}` only. Trigger names are site-authored.",
    "remote_command_lockout": (
        "`state`; when `available`, `enforcement_enabled`, `risk_window_ms`, `stale_after_ms` and "
        "`incident_sender_limit`, with `sender_count` and `locked_out_sender_count` (both `int`) in "
        "place of `senders`."),
    "firmware_liveness": (
        "`state`; when `available`, every listed member except `expiring_device_ids`, with "
        "`expiring_device_count` (`int`) in its place."),
    "firmware_reading_age": (
        "`state`; when `available`, `signing_runtime`, with `device_count` and "
        "`unbounded_device_count` (both `int`) in place of `devices`."),
    "firmware_controller_profiles": (
        "`state`; when `available`, `documents_held`, with `documents_refused_count`, "
        "`alarm_channel_count`, `alarm_as_of_count` and `alarm_unknown_count` (all `int`) in place "
        "of `documents_refused` and `alarm_channels`."),
}


def _listed(v: Any, schema: dict | None) -> Any:
    """A value with exactly the members its tables list, nested ones included."""
    if schema is None:
        return copy.deepcopy(v)
    if isinstance(v, dict):
        return {k: _listed(x, schema[k]["sub"]) for k, x in v.items() if k in schema}
    if isinstance(v, list):
        return [_listed(x, schema) for x in v]
    return copy.deepcopy(v)


def projection(m: dict, snap: dict, runtime_device: str | None = None) -> dict:
    if m["minimal_projection"] and triple_check(m, snap, whole=True) is not None:
        out_min: dict = {"projection": m["projection_name"],
                         "device_id": runtime_device if not m["minimal_from_snapshot"]
                         else snap.get("device_id"),
                         "status": m["order"][-1], "critical": True,
                         "degradation_reasons": [m["heartbeat_only"]]}
        return out_min
    out: dict = {"projection": m["projection_name"], "device_id": snap["device_id"]}
    for k in m["projection_copied"]:
        out[k] = copy.deepcopy(snap[k])
    for name in m["projection_blocks"]:
        out[name] = _listed(snap[name], m["schema"][name])
    com = out.get("commissioning", {})
    if isinstance(com.get("last_verdict"), dict) and m["verdict_trimmed"]:
        com["last_verdict"] = {k: com["last_verdict"][k] for k in ("binding_seq", "at_ms")
                               if k in com["last_verdict"]}
    if m["project_unknown_critical"]:
        out["unknown_critical_blocks"] = sorted(
            (n for n in m["critical_capable"]
             if (block_named(snap, n) or {}).get("state") == "unavailable"),
            key=lambda x: x.encode())
    if m["project_local"]:
        for k in ("health_socket_path", "diagnostics", "contract_version"):
            out[k] = copy.deepcopy(snap[k])
    lat = snap["last_alert_timestamps"]
    out["last_alert_timestamps"] = ({"by_channel": copy.deepcopy(lat["by_channel"])}
                                    if not m["project_local"] else copy.deepcopy(lat))
    rc = snap["remote_command_lockout"]
    p: dict = {"state": rc["state"]}
    if rc["state"] == "available":
        for k in ("enforcement_enabled", "risk_window_ms", "stale_after_ms", "incident_sender_limit"):
            p[k] = rc[k]
        p["sender_count"] = len(rc["senders"])
        p["locked_out_sender_count"] = sum(
            1 for x in rc["senders"] if x.get("locked_out") is True or m["count_all_locked"])
    out["remote_command_lockout"] = p
    fl = snap["firmware_liveness"]
    p = {"state": fl["state"]}
    if fl["state"] == "available":
        p.update({k: copy.deepcopy(fl[k]) for k in m["schema"]["firmware_liveness"]
                  if k not in ("state", "expiring_device_ids") and k in fl})
        p["expiring_device_count"] = len(fl["expiring_device_ids"])
    out["firmware_liveness"] = p
    ra = snap["firmware_reading_age"]
    p = {"state": ra["state"]}
    if ra["state"] == "available":
        p["signing_runtime"] = ra["signing_runtime"]
        p["device_count"] = len(ra["devices"])
        p["unbounded_device_count"] = sum(1 for d in ra["devices"]
                                          if d.get("liveness_bound") == "unbounded")
    out["firmware_reading_age"] = p
    cp = snap["firmware_controller_profiles"]
    p = {"state": cp["state"]}
    if cp["state"] == "available":
        p["documents_held"] = _listed(cp["documents_held"],
                                      m["schema"]["firmware_controller_profiles"]["documents_held"]["sub"])
        p["documents_refused_count"] = len(cp["documents_refused"])
        p["alarm_channel_count"] = len(cp["alarm_channels"])
        p["alarm_as_of_count"] = sum(1 for a in cp["alarm_channels"] if a.get("state") == "as_of")
        p["alarm_unknown_count"] = sum(1 for a in cp["alarm_channels"]
                                       if a.get("state") == "unknown")
    out["firmware_controller_profiles"] = p
    return out


def public_strings(m: dict, snap: dict) -> set[str]:
    """Strings the projection's approved members carry: a local string equal to one of these
    (a channel name, say) is not a leak."""
    found: set[str] = set()

    def walk(v: Any) -> None:
        if isinstance(v, str):
            found.add(v)
        elif isinstance(v, dict):
            for k, x in v.items():
                found.add(k)
                walk(x)
        elif isinstance(v, list):
            for x in v:
                walk(x)

    walk(projection_public(m, snap))
    return found


def projection_public(m: dict, snap: dict) -> dict:
    return projection({**m, "project_local": False}, snap)


def local_strings(snap: dict) -> set[str]:
    """Every string the snapshot's local-only members carry, found by this checker."""
    found: set[str] = set()

    def walk(v: Any) -> None:
        if isinstance(v, str) and v:
            found.add(v)
        elif isinstance(v, dict):
            for k, x in v.items():
                found.add(k)
                walk(x)
        elif isinstance(v, list):
            for x in v:
                walk(x)

    walk(snap["health_socket_path"])
    walk(snap["diagnostics"])
    walk(list(snap["last_alert_timestamps"]["by_trigger"]))
    rc = snap["remote_command_lockout"]
    walk([x.get("from_number") for x in rc.get("senders", [])])
    walk(snap["firmware_liveness"].get("expiring_device_ids", []))
    walk([d.get("device_id") for d in snap["firmware_reading_age"].get("devices", [])])
    cp = snap["firmware_controller_profiles"]
    walk([d.get("file") for d in cp.get("documents_refused", [])])
    walk([a.get("device_id") for a in cp.get("alarm_channels", [])])
    return found


SERVED = ("status_invalid", "critical_mismatch", "reasons_malformed", "reasons_mismatch",
          "status_mismatch")


def step_of(m: dict, verdict: str) -> int:
    return next(n for n, v in m["snapshot_steps"].items() if v == verdict)


def served_verdict(m: dict, s: dict, served: dict, only: int | None = None) -> str:
    """The status, critical and reasons checks, against the reasons recomputed from s."""
    recomputed = fold(m, holding(m, s))
    for verdict in sorted(SERVED, key=lambda v: step_of(m, v)):
        n = step_of(m, verdict)
        if n == m["skip_snapshot_step"] or (only is not None and n != only):
            continue
        if verdict == "status_invalid" and (not isinstance(served.get("status"), str)
                                            or served["status"] not in m["order"]):
            return verdict
        if verdict == "critical_mismatch" and (
                type(served.get("critical")) is not bool
                or served["critical"] is not (served.get("status") == m["order"][-1])):
            return verdict
        if verdict == "reasons_malformed":
            r = served.get("degradation_reasons")
            if not is_set(r) or len(r) > m["max_reasons"] \
                    or any(t not in m["vocabulary"] or (m["refuse_heartbeat_token"]
                                                        and t == m["heartbeat_only"]) for t in r):
                return verdict
        if verdict == "reasons_mismatch" and served.get(
                "degradation_reasons") != recomputed["degradation_reasons"]:
            return verdict
        if verdict == "status_mismatch" and served.get("status") != recomputed["status"]:
            return verdict
    return "accept"


class Num(str):
    """A JSON number as written."""


class Obj(dict):
    """A JSON object that remembers whether a member was named twice."""

    dup = False


def _obj(pairs: list[tuple[str, Any]]) -> Obj:
    o = Obj(pairs)
    o.dup = len(o) != len(pairs)
    return o


def _bad_constant(text: str) -> Any:
    raise ValueError(f"not JSON: {text}")


def parse_response(text: str) -> Any:
    return json.loads(text, object_pairs_hook=_obj, parse_int=Num, parse_float=Num,
                      parse_constant=_bad_constant)


def plain(v: Any) -> Any:
    if isinstance(v, Num):
        return int(v) if INT_FORM.fullmatch(v) else float(v)
    if isinstance(v, dict):
        return {k: plain(x) for k, x in v.items()}
    if isinstance(v, list):
        return [plain(x) for x in v]
    return v


def any_dup(v: Any) -> bool:
    if isinstance(v, Obj) and v.dup:
        return True
    if isinstance(v, dict):
        return any(any_dup(x) for x in v.values())
    if isinstance(v, list):
        return any(any_dup(x) for x in v)
    return False


def num_ok(m: dict, v: Any, types: set[str]) -> bool:
    """The integer check for one member: an `int` a number in integer form and range, a
    `float` finite and >= 0."""
    if v is None and "null" in types:
        return True
    if "int" in types:
        if not isinstance(v, Num):
            return False
        if INT_FORM.fullmatch(v):
            value = int(v)
        elif m["int_form_required"]:
            return False
        else:
            f = float(v)
            if not math.isfinite(f) or f != int(f):
                return False
            value = int(f)
        return m["int_range"][0] <= value <= m["int_range"][1]
    if "float" in types:
        if not isinstance(v, Num):
            return False
        f = float(v)
        return math.isfinite(f) and (f >= 0 or m["negative_floats"])
    return True


def _top_rows(m: dict) -> dict:
    """The payload as a schema: each top-level member's row, blocks carrying their tables."""
    rows = {}
    for name, allowed in m["payload"].items():
        rows[name] = _row(allowed, "always", sub=m["schema"].get(name))
    return rows


def _members(v: Any, row: dict) -> list[tuple[str, Any, dict]]:
    """(suffix, value, row) for each member under an object or each object of an array."""
    sub = row["sub"]
    out: list[tuple[str, Any, dict]] = []
    if sub is None:
        return out
    if isinstance(v, dict):
        out += [(f".{k}", v[k], r) for k, r in sub.items() if k in v]
    elif isinstance(v, list):
        out += [(f"[].{k}", x[k], r) for x in v if isinstance(x, dict)
                for k, r in sub.items() if k in x]
    return out


def numbers_ok(m: dict, health: dict) -> bool:
    def walk(v: Any, row: dict, path: str) -> bool:
        types = row["types"]
        if types & {"int", "float"} and not num_ok(m, v, types):
            return False
        if "int[]" in types and isinstance(v, list) and not all(
                num_ok(m, x, {"int"}) for x in v):
            return False
        if row["int_values"] and isinstance(v, dict) and not all(
                num_ok(m, x, {"int"}) for x in v.values()):
            return False
        if path.endswith("liveness_bound") and isinstance(v, dict):
            return all(walk(v[k], r, f"{path}.{k}") for k, r in m["bound"].items() if k in v)
        return all(walk(x, r, path + suffix) for suffix, x, r in _members(v, row))

    def diag_ints(v: Any) -> bool:
        if isinstance(v, Num):
            return not INT_FORM.fullmatch(v) or is_int(int(v), m)
        if isinstance(v, dict):
            return all(diag_ints(x) for x in v.values())
        if isinstance(v, list):
            return all(diag_ints(x) for x in v)
        return True

    top = _top_rows(m)
    if not all(walk(health[k], r, k) for k, r in top.items() if k in health):
        return False
    return not m["diag_ints"] or diag_ints(health.get("diagnostics"))


TYPE_TESTS: dict[str, Callable[[Any], bool]] = {
    "string": lambda v: isinstance(v, str) and not isinstance(v, Num),
    "bool": lambda v: isinstance(v, bool),
    "null": lambda v: v is None,
    "object": lambda v: isinstance(v, dict),
    "object[]": lambda v: isinstance(v, list) and all(isinstance(x, dict) for x in v),
    "string[]": lambda v: isinstance(v, list) and all(
        isinstance(x, str) and not isinstance(x, Num) for x in v),
    "int[]": lambda v: isinstance(v, list),
    "int": lambda v: True,
    "float": lambda v: True,
}
LEFT_TO_LATER = ("status", "critical", "degradation_reasons")


def types_ok(m: dict, health: dict) -> bool:
    """Every member's JSON type at every depth, and every listed vocabulary."""
    vocab = m["vocab"]

    def in_vocab(path: str, v: Any) -> bool:
        if not m["check_vocab"]:
            return True
        if path in vocab:
            return v in vocab[path]
        if path + "[]" in vocab and isinstance(v, list):
            return all(x in vocab[path + "[]"] for x in v)
        if path.endswith("liveness_bound.name"):
            return v in vocab["*liveness_bound.name"]
        return True

    def walk(v: Any, row: dict, path: str) -> bool:
        types = row["types"]
        if types & {"int", "float"} and not (types & {"object", "string"}):
            return True
        if m["check_types"] and not any(TYPE_TESTS[t](v) for t in types):
            return False
        if path.endswith("liveness_bound"):
            if isinstance(v, str):
                return not m["check_vocab"] or v in vocab["*liveness_bound"]
            if isinstance(v, dict):
                return all(walk(v[k], r, f"{path}.{k}") for k, r in m["bound"].items() if k in v)
        if not in_vocab(path, v):
            return False
        return all(walk(x, r, path + suffix) for suffix, x, r in _members(v, row))

    top = _top_rows(m)
    if not all(walk(health[k], r, k) for k, r in top.items()
               if k in health and k not in LEFT_TO_LATER):
        return False
    diag = health.get("diagnostics")
    return not m["diag_namespace_objects"] or not isinstance(diag, dict) or all(
        isinstance(x, dict) for x in diag.values())


def entries_ok(m: dict, v: Any, row: dict, path: str) -> bool:
    """Step 5 below the blocks: each nested object carries exactly its members."""
    if not m["check_presence"]:
        return True
    if path.endswith("liveness_bound") and isinstance(v, dict):
        return set(v) == set(m["bound"])
    sub = row["sub"]
    if sub is None:
        return True
    objs = [v] if isinstance(v, dict) else [x for x in v if isinstance(x, dict)] \
        if isinstance(v, list) else []
    for o in objs:
        want = {k for k, r in sub.items() if r["present"] == "always"
                or r["present"] == o.get("state")}
        if set(o) != want:
            return False
        for k, r in sub.items():
            if k in o and not (entries_ok(m, o[k], r, f"{path}.{k}")
                               and sequence_ok(m, k, r, o[k])):
                return False
    return True


def block_shape_ok(m: dict, name: str, block: Any) -> bool:
    """Step 5 for one block: its state, the booleans tied to it, and every member's presence."""
    schema = m["schema"][name]
    if not isinstance(block, dict):
        return False
    state = block.get("state")
    if name in m["states"] and m["check_states"] and state not in m["states"][name]:
        return False
    required = set()
    for field, row in schema.items():
        present = row["present"]
        if present == "always":
            required.add(field)
        elif present == "available":
            if state == "available":
                required.add(field)
        elif present in SECTION_FLAGS:
            if block.get(SECTION_FLAGS[present]) is True:
                required.add(field)
        elif present == "held":
            if state == "available" and block.get("policy_held") is True \
                    and m["held_rule"]:
                required.add(field)
        else:
            raise Failure(f"{name}.{field}: unknown Present {present!r}")
        if row["tie"] is not None and field in block and m["check_ties"]:
            truth, tied = row["tie"]
            if block[field] is not ((state == tied) is truth):
                return False
    if m["check_presence"] and set(block) != required:
        return False
    for field, row in schema.items():
        if field in block and field != "action_records" and not (entries_ok(
                m, block[field], row, f"{name}.{field}") and sequence_ok(
                m, field, row, block[field])):
            return False
    if name == "evidence":
        if not block_shape_ok(m, "evidence.action_records", block.get("action_records")):
            return False
        if m["check_flags"] and flag_faults(block):
            return False
    return True


CONSISTENCY = (
    (("`safety_zones[].trip_age_ms` is an integer exactly when `trip_state` is `tripped`, and "
      "`null` otherwise;"), "trip_age"),
    ("`safety_registry.trip_verification_deadline_ms` is at most `60000`;", "deadline"),
    (("`alert_outbox.tier_d_critical_warning_threshold` is `1` to `3`, `tier_d_age_bound_ms` is "
      "`1` to `300000`, and `overdue_bound_ms` is `1` to `3600000`;"), "alert_bounds"),
    (("`action_log_records.lost` is the sum of `count` over every `action_record_lost` "
      "incident, and `decision_records_lost` the sum over every `decision_record_lost` "
      "incident;"), "loss_sums"),
    (("each `loss_incidents[]` entry's `acknowledged_at_ms` is `null` exactly when "
      "`acknowledged` is `false`;"), "ack_pairing"),
    (("`loss_incidents` is ordered by `incident_id` in byte order, without a repeated "
      "`incident_id`."), "incident_order"),
)


def _int(v: Any) -> int | None:
    if isinstance(v, Num) and INT_FORM.fullmatch(v):
        return int(v)
    if type(v) is int:
        return v
    return None


def consistency_faults(m: dict, h: dict) -> list[str]:
    """The consistency rules check 5 enforces, on a whole or partial snapshot."""
    on = set(m["consistency"])
    bad = []
    reg = h.get("safety_registry") or {}
    if "trip_age" in on:
        for z in h.get("safety_zones") or []:
            if isinstance(z, dict) and "trip_age_ms" in z and (
                    (_int(z["trip_age_ms"]) is not None) is not (z.get("trip_state") == "tripped")
                    or (z.get("trip_state") != "tripped" and z["trip_age_ms"] is not None)):
                bad.append("trip_age")
    if "deadline" in on and "trip_verification_deadline_ms" in reg:
        d = _int(reg["trip_verification_deadline_ms"])
        if d is None or d > m["trip_deadline_max"]:
            bad.append("deadline")
    ao = h.get("alert_outbox") or {}
    if "alert_bounds" in on:
        for key, ceiling in ALERT_DEFAULTS.items():
            if key in ao and not (_int(ao[key]) is not None and 1 <= _int(ao[key]) <= ceiling):
                bad.append("alert_bounds")
    alr = h.get("action_log_records") or {}
    inc = alr.get("loss_incidents")
    if isinstance(inc, list):
        if "loss_sums" in on:
            for kind, total in (("action_record_lost", "lost"),
                                ("decision_record_lost", "decision_records_lost")):
                if total in alr and _int(alr[total]) != sum(
                        _int(i.get("count")) or 0 for i in inc
                        if isinstance(i, dict) and i.get("kind") == kind):
                    bad.append("loss_sums")
        if "ack_pairing" in on and any(
                isinstance(i, dict) and (i.get("acknowledged_at_ms") is None)
                is not (i.get("acknowledged") is False) for i in inc):
            bad.append("ack_pairing")
        if "incident_order" in on:
            ids = [str(i.get("incident_id")) for i in inc if isinstance(i, dict)]
            keys = [x.encode() for x in ids]
            if keys != sorted(set(keys)):
                bad.append("incident_order")
    return bad


def flag_faults(ev: dict) -> list[str]:
    """The evidence flags' own table: when each may be true."""
    st, bad = ev.get("state"), []
    if st in ("disabled", "starting") and ev.get("attestation_summary_available") is not False:
        bad.append(f"attestation_summary_available true while {st}")
    if st == "disabled" and ev.get("registration_available") is not True:
        bad.append("registration_available false while disabled")
    if st == "starting" and ev.get("registration_available") is not False:
        bad.append("registration_available true while starting")
    if st != "available" and ev.get("delivery_ledger_available") is not False:
        bad.append(f"delivery_ledger_available true while {st}")
    return bad


def response_failures(m: dict, text: str) -> list[int]:
    """Every snapshot check the response fails, each judged alone where it can be."""
    step = {v: n for n, v in m["snapshot_steps"].items()}
    fails: list[int] = []
    body = text[:-1] if text.endswith("\n") else None
    try:
        doc = parse_response(body) if body is not None and "\n" not in body else None
    except ValueError:
        doc = None
    if not isinstance(doc, dict):
        return [step["envelope_invalid"]]
    envelope = (not doc.dup and set(doc) == {"schema_version", "ok", "health"}
                and doc.get("schema_version") == "1" and isinstance(doc.get("schema_version"), Num)
                and doc.get("ok") is True and isinstance(doc.get("health"), dict))
    if not envelope or (m["dup_step"] == 1 and any_dup(doc.get("health"))):
        fails.append(step["envelope_invalid"])
    health = doc.get("health")
    if not isinstance(health, dict):
        return fails or [step["envelope_invalid"]]
    diag = health.get("diagnostics")
    if set(health) != set(m["payload"]) or (m["dup_step"] == 2 and any_dup(health)) or (
            m["diag_namespaces"] and isinstance(diag, dict)
            and not set(diag) <= set(m["namespaces"])):
        fails.append(step["members_invalid"])
    judged = [("integer_invalid", lambda: numbers_ok(m, health)),
              ("type_invalid", lambda: types_ok(m, health)),
              ("shape_invalid", lambda: not consistency_faults(m, health) and all(
                  block_shape_ok(m, name, health.get(name)) for name in m["schema"]
                  if name not in ("evidence.action_records", "sensors", "safety_zones"))
               and all(entries_ok(m, health.get(k), _row({"object[]"}, "always",
                                                         sub=m["schema"][k]), k)
                       for k in ("sensors", "safety_zones")))]
    for verdict, test in judged:
        try:
            ok = test()
        except (KeyError, TypeError, AttributeError, IndexError, ValueError):
            ok = False
        if not ok:
            fails.append(step[verdict])
    flat_health = plain(health)
    for verdict in SERVED:
        try:
            got = served_verdict(m, flat_health, flat_health, only=step[verdict])
        except (KeyError, TypeError, AttributeError, IndexError):
            got = "unjudgeable"
        if got != "accept":
            fails.append(step[verdict])
    return sorted(fails)


def independent(m: dict, fails: list[int]) -> list[int]:
    """The failing checks less those another failure forces: an invalid status is never the
    fold, malformed reasons never equal the recomputed set, and a member of the wrong type or
    range leaves the recomputed conditions undefined."""
    step = {v: n for n, v in m["snapshot_steps"].items()}
    forced = {step["status_mismatch"]} if step["status_invalid"] in fails else set()
    if m["forced_by_type"] and (step["integer_invalid"] in fails
                                or step["type_invalid"] in fails):
        forced |= {step["reasons_mismatch"], step["status_mismatch"]}
    forced |= {step["reasons_mismatch"]} if step["reasons_malformed"] in fails else set()
    return [n for n in fails if n not in forced]


def response_verdict(m: dict, text: str) -> str:
    fails = [n for n in response_failures(m, text) if n != m["skip_response_step"]]
    if m["type_after_shape"]:
        step = {v: n for n, v in m["snapshot_steps"].items()}
        swap = {step["type_invalid"]: step["shape_invalid"],
                step["shape_invalid"]: step["type_invalid"]}
        fails = [swap.get(n, n) for n in fails]
    if not fails:
        return "accept"
    return m["snapshot_steps"][min(fails)]


def unrepresentable_verdict(m: dict, case: dict) -> str:
    block, _, field = case["member"].rpartition(".")
    row = m["schema"][block][field]
    if "int" not in row["types"]:
        raise Failure(f"{case['member']} is not an int member")
    text = case["value"]
    if INT_FORM.fullmatch(text) and is_int(int(text), m):
        return "serve"
    return "internal_error"


def _reasons(hb: dict) -> list:
    r = hb.get("degradation_reasons")
    return r if isinstance(r, list) else []


PRESENCE = "presence of `degradation_reasons` — absent is valid and terminates validation"
GATEWAY_CHECKS: dict[str, Callable[[dict, dict], bool]] = {
    ('`status` is the string `"healthy"`, `"degraded"` or `"critical"`; never `"starting"` on '
     'this topic'): lambda hb, m: isinstance(hb.get("status"), str)
    and hb["status"] in m["runtime_statuses"],
    PRESENCE: lambda hb, m: True,
    "value is an array": lambda hb, m: isinstance(hb.get("degradation_reasons"), list),
    "length is `1 .. 32`": lambda hb, m: m["gateway_length"][0] <= len(_reasons(hb))
    <= m["gateway_length"][1],
    "every element is a string": lambda hb, m: all(isinstance(t, str) for t in _reasons(hb)),
    "elements are unique": lambda hb, m: len({json.dumps(t) for t in _reasons(hb)})
    == len(_reasons(hb)),
    "elements are in byte order of their UTF-8 encoding": lambda hb, m: [
        str(t).encode() for t in _reasons(hb)] == sorted(str(t).encode() for t in _reasons(hb)),
    "every token is in the closed vocabulary": lambda hb, m: all(
        t in m["vocabulary"] for t in _reasons(hb)),
    ('`health_snapshot_invalid`, when present, is the only token and `status` is '
     '`"critical"`'): lambda hb, m: m["heartbeat_only"] not in _reasons(hb) or (
        _reasons(hb) == [m["heartbeat_only"]]
        and (hb.get("status") == "critical" or not m["not_alone_needs_critical"])),
    'non-empty reasons require `status` to be `"degraded"` or `"critical"`': lambda hb, m: (
        not _reasons(hb) or hb.get("status") in m["reason_statuses"]),
    ("`status` is at least the most severe token's severity, `critical` over `degraded`, "
     "`firmware_liveness_degraded` counting for nothing"): lambda hb, m: _not_understated(hb, m),
}


def _not_understated(hb: dict, m: dict) -> bool:
    ranks = {"healthy": 0, "degraded": 1, "critical": 2}
    worst = max((ranks[m["vocabulary"][t]] for t in _reasons(hb)
                 if isinstance(t, str) and m["vocabulary"].get(t) is not None
                 and (t != m["umbrella"] or not m["umbrella_counts_nothing"])),
                default=0)
    if m["umbrella"] in _reasons(hb) and not m["umbrella_counts_nothing"]:
        worst = max(worst, 2)
    return ranks.get(hb.get("status"), 0) >= worst


def gateway_verdict(m: dict, hb: dict) -> str:
    steps = {step: (text, verdict) for step, text, verdict in m["gateway_steps"]}
    for step in m["gateway_order"]:
        if step == m["skip_gateway_step"]:
            continue
        text, verdict = steps[step]
        if text == PRESENCE:
            if "degradation_reasons" not in hb and m["presence_terminates"]:
                return "accept"
            continue
        if not GATEWAY_CHECKS[text](hb, m):
            return verdict or "accept"
    return "accept"


def request_verdict(m: dict, writes: list[bytes], after: str) -> str:
    """The server's result for a request delivered as these writes, then `after`."""
    bound = m["request_bound"]

    def judge(request: bytes) -> str:
        if len(request) > bound:
            return "request_too_large"
        return "ok" if request in m["accepted"] else "unsupported_request"

    held = b""
    for chunk in writes:
        held += chunk
        if not m["judge_discarded"] and b"\n" in held:
            return judge(held[: held.index(b"\n") + 1])
        if m["size_first"] and len(held) > bound:
            return "request_too_large"
    if after == "silent" and m["time_bound"]:
        return "unsupported_request"
    return judge(held)


INT_FORM = re.compile(r"-?(?:0|[1-9][0-9]*)")


def integer_verdict(m: dict, text: str) -> str:
    if not INT_FORM.fullmatch(text):
        return "refuse"
    return "accept" if is_int(int(text), m) else "refuse"


def expiry_verdict(m: dict, dp: dict) -> str:
    if set(dp) != {"expiry", "valid_until", "is_expired"} or type(dp["is_expired"]) is not bool:
        return "refuse"
    if dp["expiry"] == "never":
        if m["expiry_never_null"] and dp["valid_until"] is not None:
            return "refuse"
        if m["expiry_never_not_expired"] and dp["is_expired"]:
            return "refuse"
        return "accept"
    if dp["expiry"] == "at":
        return "accept" if is_int(dp["valid_until"], m) else "refuse"
    return "refuse"


def fallback(m: dict, case: dict) -> dict:
    """The exact fallback heartbeat; `auth`, when enabled, is the corpus's own, checked present."""
    rt = case["runtime"]
    if set(rt) != {"device_id", "now_ms", "auth_enabled"} or type(rt["auth_enabled"]) is not bool:
        raise Failure(f"fallback runtime inputs {sorted(rt)}")
    source = case["snapshot"] if m["fallback_from_snapshot"] else {}
    out = {"device_id": source.get("device_id", rt["device_id"]), "status": m["mapping"][None][0],
           "last_seen_ms": rt["now_ms"], "gateway_seen_ms": 0,
           "active_triggers": list(source.get("active_triggers", [])),
           "degradation_reasons": [m["heartbeat_only"]]}
    if rt["auth_enabled"]:
        out["auth"] = case["expected"].get("auth", "missing")
    return out


# --- the corpus ----------------------------------------------------------------------------

def _pairs(pairs: list[tuple[str, Any]]) -> dict:
    keys = [k for k, _ in pairs]
    if len(set(keys)) != len(keys):
        raise Failure(f"a member named twice: {keys}")
    return dict(pairs)


def load(corpus_bytes: bytes) -> dict:
    return json.loads(corpus_bytes, object_pairs_hook=_pairs)


SETS = ("fold_cases", "snapshot_cases", "served_cases", "heartbeat_cases", "response_cases",
        "projection_cases", "heartbeat_snapshot_cases", "unrepresentable_cases",
        "gateway_reason_cases", "request_cases", "integer_cases", "expiry_cases")


def check(corpus: dict, m: dict) -> list[str]:
    """Every disagreement between the corpus and the model."""
    out: list[str] = []
    top = {"contract", "version", "comment", "conditions", "heartbeat_only", "max_reasons",
           "fallback_heartbeat_case", *SETS}
    if set(corpus) != top:
        out.append(f"corpus members {sorted(set(corpus) ^ top)}")
        return out
    want_conditions = {**m["severity"], m["umbrella"]: None,
                       m["heartbeat_only"]: m["vocabulary"][m["heartbeat_only"]]}
    if corpus["conditions"] != want_conditions:
        diff = {k for k in set(want_conditions) | set(corpus["conditions"])
                if corpus["conditions"].get(k, "-") != want_conditions.get(k, "-")}
        out.append(f"conditions table differs at {sorted(diff)}")
    if corpus["heartbeat_only"] != [m["heartbeat_only"]]:
        out.append("heartbeat_only")
    if corpus["max_reasons"] != m["max_reasons"]:
        out.append("max_reasons")
    for name in SETS:
        names = [c.get("name", json.dumps(c, sort_keys=True)) for c in corpus[name]]
        if len(set(names)) != len(names):
            out.append(f"{name}: case names repeat")

    for c in corpus["fold_cases"]:
        if any(t not in m["severity"] for t in c["holding"]) \
                or len(set(c["holding"])) != len(c["holding"]):
            out.append(f"fold {c['name']}: holding is not distinct conditions")
            continue
        got = fold(m, c["holding"])
        if c["expected"] != got:
            out.append(f"fold {c['name']}: corpus {c['expected']}, text {got}")

    for c in corpus["snapshot_cases"]:
        bad = shape(m, c["snapshot"], c.get("startup"))
        if bad:
            out.append(f"snapshot {c['name']}: shape {bad}")
            continue
        got = fold(m, holding(m, c["snapshot"]))
        if c["expected"] != got:
            out.append(f"snapshot {c['name']}: corpus {c['expected']}, text {got}")

    for c in corpus["served_cases"]:
        bad = shape(m, c["snapshot"], None)
        if bad:
            out.append(f"served {c['name']}: shape {bad}")
            continue
        got = served_verdict(m, c["snapshot"], c["served"])
        if c["expected"] != got:
            out.append(f"served {c['name']}: corpus {c['expected']}, text {got}")

    for c in corpus["heartbeat_cases"]:
        got = heartbeat(m, c["snapshot"])
        if c["expected"] != got:
            out.append(f"heartbeat {c['name']}: corpus {c['expected']}, text {got}")

    fb = corpus["fallback_heartbeat_case"]
    got_step = triple_check(m, fb["snapshot"])
    if got_step is None or fb["failed_step"] != got_step:
        out.append(f"fallback: corpus step {fb['failed_step']}, text {got_step}")
    if fb["expected"] != fallback(m, fb):
        out.append(f"fallback: corpus {fb['expected']}, text {fallback(m, fb)}")

    for c in corpus["response_cases"]:
        if not isinstance(c["response"], str):
            out.append(f"response {c['name']}: not text")
            continue
        got = response_verdict(m, c["response"])
        if c["expected"] != got:
            out.append(f"response {c['name']}: corpus {c['expected']}, text {got} "
                       f"(steps failing: {response_failures(m, c['response'])})")
        elif len(independent(m, response_failures(m, c["response"]))) > 1:
            out.append(f"response {c['name']}: more than one defect, steps "
                       f"{response_failures(m, c['response'])}")

    for c in corpus["projection_cases"]:
        runtime_device = (c.get("runtime") or {}).get("device_id")
        if triple_check(m, c["snapshot"], whole=True) is not None and runtime_device is None:
            out.append(f"projection {c['name']}: the minimal projection names the runtime's own "
                       f"device_id, and the case gives no runtime")
        got = projection(m, c["snapshot"], runtime_device)
        if c["expected"] != got:
            diff = sorted(k for k in set(got) | set(c["expected"])
                          if got.get(k) != c["expected"].get(k))
            out.append(f"projection {c['name']}: corpus and text differ at {diff}")
        dumped = json.dumps(got)
        for needle in c["must_not_contain"]:
            if needle in dumped:
                out.append(f"projection {c['name']}: carries local-only {needle!r}")
        leaked = sorted(x for x in local_strings(c["snapshot"]) if json.dumps(x)[1:-1] in dumped
                        and x not in json.dumps(projection_public(m, c["snapshot"])))
        if leaked:
            out.append(f"projection {c['name']}: local-only strings reach it: {leaked}")
        uncovered = sorted(x for x in local_strings(c["snapshot"]) - public_strings(m, c["snapshot"])
                           if not any(n in x for n in c["must_not_contain"])
                           and x not in m["namespaces"] and len(x) > 12)
        if uncovered and m["needle_completeness"]:
            out.append(f"projection {c['name']}: must_not_contain names nothing in {uncovered}")

    for c in corpus["heartbeat_snapshot_cases"]:
        step, got = heartbeat_message(m, c)
        if step != c["failed_step"] or got != c["expected"]:
            out.append(f"heartbeat snapshot {c['name']}: corpus {c['failed_step']} "
                       f"{c['expected']}, text {step} {got}")

    for c in corpus["unrepresentable_cases"]:
        got = unrepresentable_verdict(m, c)
        if c["expected"] != got:
            out.append(f"unrepresentable {c['member']}={c['value']}: corpus {c['expected']}, "
                       f"text {got}")

    for c in corpus["gateway_reason_cases"]:
        got = gateway_verdict(m, c["heartbeat"])
        if c["expected"] != got:
            out.append(f"gateway {c['name']}: corpus {c['expected']}, text {got}")

    for c in corpus["request_cases"]:
        writes = [bytes.fromhex(w) for w in c["writes_hex"]]
        if any(not w for w in writes) or c["after"] not in ("eof", "silent") \
                or c["bytes_written"] != sum(map(len, writes)):
            out.append(f"request {c['name']}: malformed case")
            continue
        got = request_verdict(m, writes, c["after"])
        if c["expected"] != got:
            out.append(f"request {c['name']}: corpus {c['expected']}, text {got}")

    for c in corpus["integer_cases"]:
        got = integer_verdict(m, c["json"])
        if c["expected"] != got:
            out.append(f"integer {c['json']}: corpus {c['expected']}, text {got}")

    for c in corpus["expiry_cases"]:
        got = expiry_verdict(m, c["device_policy"])
        if c["expected"] != got:
            out.append(f"expiry {c['device_policy']}: corpus {c['expected']}, text {got}")
    return out


# --- coverage --------------------------------------------------------------------------------

def _with(s: dict, path: str, value: Any) -> dict:
    t = copy.deepcopy(s)
    node = t
    parts = path.split(".")
    for p in parts[:-1]:
        node = node[p]
    node[parts[-1]] = value
    return t


def coverage(corpus: dict, m: dict) -> list[str]:
    """What the text names that no case exercises, as properties of the cases."""
    gaps: list[str] = []
    conds = list(m["severity"])
    held = [tuple(c["holding"]) for c in corpus["fold_cases"]]
    for t in conds:
        if (t,) not in held:
            gaps.append(f"fold: {t} alone")
    for a, b in itertools.permutations(conds, 2):
        if (a, b) not in held:
            gaps.append(f"fold: ordered pair ({a}, {b})")
    if () not in held:
        gaps.append("fold: nothing holds")

    snaps = [(c["snapshot"], c.get("startup")) for c in corpus["snapshot_cases"]]
    holds = [set(holding(m, s)) for s, _ in snaps]
    # A failed trip leaves its pair unprotected under v3's protection_claim rule, so the trip
    # condition's nearest to alone carries the unprotected condition beside it.
    companions = {"safety_zone_trip_unresolved": {"safety_zone_active_unprotected"}}
    for t in conds:
        if not any(t in h and h - {t} <= companions.get(t, set()) for h in holds):
            gaps.append(f"snapshot: {t} alone")
    if set() not in holds:
        gaps.append("snapshot: nothing holds")
    # A block that names subsystem_state_unknown_critical cannot also raise its own conditions.
    if set(conds) - {"subsystem_state_unknown_critical"} not in holds:
        gaps.append("snapshot: every condition but the unknown-critical one at once")
    for name in m["critical_capable"]:
        if not any(set(holding(m, s_)) == {"subsystem_state_unknown_critical"}
                   and (block_named(s_, name) or {}).get("state") == "unavailable"
                   for s_, _ in snaps):
            gaps.append(f"snapshot: {name} unavailable alone, unknown-critical")

    if not any(st is not None and set(st["not_ready"]) & set(m["critical_capable"])
               and st["elapsed_ms"] >= st["deadline_ms"]
               and "subsystem_state_unknown_critical" in h for (_, st), h in zip(snaps, holds,
                                                                                 strict=True)):
        gaps.append("snapshot: a critical-capable block past the startup deadline")
    if not any("subsystem_state_unknown_critical" in h and len(
            {t for t in h if m["severity"][t] == m["order"][-1]}) > 1 for h in holds):
        gaps.append("snapshot: a known critical beside unknown-critical")
    crit = [t for t in conds if m["severity"][t] == m["order"][-1]]
    for name in ("subsystem_starting", "subsystem_state_unknown"):
        if not any(name in h and h & set(crit) for h in holds):
            gaps.append(f"snapshot: {name} beside a known critical")

    def some(label: str, test: Callable[[dict, dict | None], bool]) -> None:
        if not any(test(s, st) for s, st in snaps):
            gaps.append(f"snapshot: {label}")

    def fl(s: dict) -> dict:
        return s["firmware_liveness"]

    def av(s: dict, name: str) -> bool:
        return available(block_named(s, name))

    some("tick age equal to the window", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["loop"] == "running"
         and fl(s)["last_successful_tick_age_ms"] == fl(s)["expiry_window_ms"])
    some("tick age one under the window", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["last_successful_tick_age_ms"] == fl(s)["expiry_window_ms"] - 1)
    some("no tick, started at the window", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["loop"] == "running" and fl(s)["last_successful_tick_age_ms"] is None
         and fl(s)["started_age_ms"] == fl(s)["expiry_window_ms"])
    some("no tick, started one under the window", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["last_successful_tick_age_ms"] is None
         and fl(s)["started_age_ms"] == fl(s)["expiry_window_ms"] - 1)
    some("a stale tick after a clean stop", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["loop"] == "stopped_cleanly"
         and (fl(s)["last_successful_tick_age_ms"] or 0) >= fl(s)["expiry_window_ms"])
    some("a stopped loop with a stale tick", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["loop"] == "stopped_unexpectedly"
         and (fl(s)["last_successful_tick_age_ms"] or 0) >= fl(s)["expiry_window_ms"])
    def ao(s: dict) -> dict:
        return s["alert_outbox"] if available(s["alert_outbox"]) else {}

    some("Tier D attempts at the threshold", lambda s, _: ao(s).get("tier_d_unresolved_count", 0)
         and ao(s)["tier_d_max_attempts"] == ao(s)["tier_d_critical_warning_threshold"])
    some("Tier D attempts one under the threshold, young", lambda s, _: ao(s).get(
        "tier_d_unresolved_count", 0) and ao(s)["tier_d_max_attempts"]
        == ao(s)["tier_d_critical_warning_threshold"] - 1
        and ao(s)["tier_d_oldest_age_ms"] < ao(s)["tier_d_age_bound_ms"])
    some("Tier D age at its bound", lambda s, _: ao(s).get("tier_d_unresolved_count", 0)
         and ao(s)["tier_d_oldest_age_ms"] == ao(s)["tier_d_age_bound_ms"])
    some("Tier D age one under its bound", lambda s, _: ao(s).get("tier_d_unresolved_count", 0)
         and ao(s)["tier_d_oldest_age_ms"] == ao(s)["tier_d_age_bound_ms"] - 1)
    some("an overdue age at its bound", lambda s, _: ao(s).get("oldest_non_tier_d_age_ms")
         == ao(s).get("overdue_bound_ms", -1))
    some("an overdue age one under its bound", lambda s, _: ao(s).get("oldest_non_tier_d_age_ms")
         == ao(s).get("overdue_bound_ms", 0) - 1)
    some("a bound lowered below its default", lambda s, _: any(
        ao(s).get(k, d) < d for k, d in ALERT_DEFAULTS.items()))

    def zones(s: dict) -> list:
        return s["safety_zones"]

    def dl(s: dict) -> int:
        return s["safety_registry"].get("trip_verification_deadline_ms", -2)
    some("a trip refused by the driver", lambda s, _: any(
        z["trip_state"] == "tripped" and z["command_status"] == "driver_refused"
        and z["activation"] == "active" for z in zones(s)))
    some("a trip whose effect mismatched", lambda s, _: any(
        z["trip_state"] == "tripped" and z["effect_verified"] == "mismatched" for z in zones(s)))
    some("a trip unverified at its deadline", lambda s, _: any(
        z["trip_state"] == "tripped" and z["effect_verified"] == "unknown"
        and z["trip_age_ms"] == dl(s) for z in zones(s)))
    some("a trip unverified one under its deadline", lambda s, _: any(
        z["trip_state"] == "tripped" and z["effect_verified"] == "unknown"
        and z["trip_age_ms"] == dl(s) - 1 for z in zones(s)))
    some("a verified trip", lambda s, _: any(
        z["trip_state"] == "tripped" and z["effect_verified"] == "matched" for z in zones(s)))
    some("a failed trip on a pair that is not active", lambda s, _: any(
        z["trip_state"] == "tripped" and z["command_status"] == "driver_refused"
        and z["activation"] != "active" for z in zones(s)))
    for verdict in REFUSALS:
        some(f"activation refused as {verdict}", lambda s, _, v=verdict: any(
            z["activation"] == v for z in zones(s)))
    some("an active pair's sensor stale, claim protected", lambda s, _: any(
        z["activation"] == "active" and z["protection_claim"] != "unprotected"
        and _zone_sensor_down(s, m, z["zone_id"]) for z in zones(s))
        and any(x["stale"] for x in s["sensors"]))
    some("an active pair's sensor not connected, claim protected", lambda s, _: any(
        z["activation"] == "active" and z["protection_claim"] != "unprotected"
        and _zone_sensor_down(s, m, z["zone_id"]) for z in zones(s))
        and any(x["connection"] != "connected" for x in s["sensors"]))
    some("a stale sensor feeding no pair", lambda s, _: any(x["stale"] for x in s["sensors"])
         and not any(_zone_sensor_down(s, m, z["zone_id"]) for z in zones(s)))

    def incidents(s: dict) -> list:
        b = s["action_log_records"]
        return b["loss_incidents"] if available(b) else []

    for kind in m["vocab"]["action_log_records.loss_incidents[].kind"]:
        some(f"an acknowledged {kind} alone", lambda s, _, k=kind: incidents(s) and all(
            i["kind"] == k and i["acknowledged"] for i in incidents(s)))
    some("a clean stop with expiring devices, over capacity and failing ticks", lambda s, _:
         available(fl(s)) and fl(s)["loop"] == "stopped_cleanly" and fl(s)["expiring_device_ids"]
         and fl(s)["supervised_devices"] > fl(s)["supported_device_capacity"]
         and fl(s)["consecutive_tick_failures"] > 0)
    some("supervised equal to capacity", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["supervised_devices"] == fl(s)["supported_device_capacity"])
    some("supervised one over capacity", lambda s, _: av(s, "firmware_liveness")
         and fl(s)["supervised_devices"] == fl(s)["supported_device_capacity"] + 1)
    some("over capacity with every device in window, degraded", lambda s, _: set(
        holding(m, s)) == {"firmware_liveness_over_capacity"})
    some("pending age equal to the stall bound", lambda s, _: av(s, "action_log_records")
         and s["action_log_records"]["oldest_pending_age_ms"] == m["stall_bound"])
    some("pending age one over the stall bound", lambda s, _: av(s, "action_log_records")
         and s["action_log_records"]["oldest_pending_age_ms"] == m["stall_bound"] + 1)
    for flag, label in (("lost", "Tier C lost alone"), ("unknown_live", "Tier C unknown_live alone")):
        some(label, lambda s, _, flag=flag: av(s, "evidence.action_records")
             and s["evidence"]["action_records"][flag] > 0
             and all(s["evidence"]["action_records"][k] == 0 for k in ("lost", "unknown_live")
                     if k != flag)
             and s["evidence"]["action_records"]["pending"] < s["evidence"]["action_records"]["ceiling"])
    some("Tier C pending equal to ceiling", lambda s, _: av(s, "evidence.action_records")
         and s["evidence"]["action_records"]["pending"] == s["evidence"]["action_records"]["ceiling"])
    some("Tier C pending one under ceiling", lambda s, _: av(s, "evidence.action_records")
         and s["evidence"]["action_records"]["pending"]
         == s["evidence"]["action_records"]["ceiling"] - 1)
    for name in m["starting_blocks"]:
        for state in ("starting", "unavailable"):
            some(f"{name} {state}", lambda s, _, name=name, state=state:
                 block_named(s, name).get("state") == state)
    for state in ("pending", "unavailable", "failed"):
        some(f"a sensor {state}", lambda s, _, state=state:
             any(x["connection"] == state for x in s["sensors"]))
    for name, states in m["states"].items():
        if name in m["starting_blocks"]:
            for state in states:
                some(f"{name} {state}", lambda s, _, name=name, state=state:
                     (block_named(s, name) or {}).get("state") == state)
        elif "unavailable" in states:
            def unread(s: dict, _: Any, name: str = name) -> bool:
                return (block_named(s, name) or {}).get("state") == "unavailable" \
                    and not holding(m, s)
            if not any(unread(s, None) for s, _ in snaps) and not any(
                    response_failures(m, c["response"]) == [] and unread(
                        plain(_doc(c["response"])["health"]), None)
                    for c in corpus["response_cases"]):
                gaps.append(f"snapshot or response: {name} unavailable, deciding nothing")
    for flag in m["unknown_flags"]:
        some(f"evidence available with {flag} alone false", lambda s, _, flag=flag:
             available(s["evidence"]) and not s["evidence"][flag]
             and all(s["evidence"][f] for f in m["unknown_flags"] if f != flag))
    for state in m["states"]["evidence"]:
        if state != "available":
            some(f"a posture problem while evidence is {state}", lambda s, _, state=state:
                 s["evidence"]["state"] == state and s["evidence"]["posture_problems"])
    some("an active pair that is not unprotected", lambda s, _: any(
        z["activation"] == "active" and z["protection_claim"] != "unprotected"
        for z in s["safety_zones"]))
    some("an unprotected pair that is not active", lambda s, _: any(
        z["activation"] != "active" and z["protection_claim"] == "unprotected"
        for z in s["safety_zones"]))
    some("startup one before the deadline", lambda _, st: st is not None
         and st["elapsed_ms"] == st["deadline_ms"] - 1)
    some("startup at the deadline", lambda _, st: st is not None
         and st["elapsed_ms"] == st["deadline_ms"])
    some("startup past the deadline", lambda _, st: st is not None
         and st["elapsed_ms"] > st["deadline_ms"])
    some("a sensor past the deadline", lambda _, st: st is not None
         and st["elapsed_ms"] >= st["deadline_ms"]
         and any(n.startswith("sensor:") for n in st["not_ready"]))
    some("a known critical past the deadline", lambda s, st: st is not None
         and st["elapsed_ms"] >= st["deadline_ms"] and set(holding(m, s)) & set(crit))
    some("a known critical within the deadline", lambda s, st: st is not None
         and st["elapsed_ms"] < st["deadline_ms"] and set(holding(m, s)) & set(crit))

    served = [served_verdict(m, c["snapshot"], c["served"]) for c in corpus["served_cases"]]
    for verdict in [*SERVED, "accept"]:
        if verdict not in served:
            gaps.append(f"served: {verdict}")
    for status in m["order"]:
        if not any(c["served"].get("status") == status and served_verdict(
                m, c["snapshot"], c["served"]) == "accept" for c in corpus["served_cases"]):
            gaps.append(f"served: an accepted {status}")
    if not any(m["umbrella"] in fold(m, holding(m, c["snapshot"]))["degradation_reasons"]
               and m["umbrella"] not in (c["served"].get("degradation_reasons") or [])
               for c in corpus["served_cases"]):
        gaps.append("served: the umbrella omitted")

    hbs = [c["snapshot"] for c in corpus["heartbeat_cases"]]
    steps = [triple_check(m, s) for s in hbs]
    whole_steps = [triple_check(m, c["snapshot"], whole=True)
                   for c in corpus["heartbeat_snapshot_cases"]]
    if m["t_steps"][4][1] not in whole_steps:
        gaps.append(f"heartbeat snapshot: {m['t_steps'][4][1]}")
    hs = corpus["heartbeat_snapshot_cases"]
    for label, test in (
            ("an evidence block from an available, read snapshot", lambda c: "evidence" in c[
                "expected"]),
            ("no evidence block while the attestation summary is unread", lambda c: c[
                "snapshot"]["evidence"]["state"] == "available" and not c["snapshot"]["evidence"][
                "attestation_summary_available"] and "evidence" not in c["expected"]),
            ("no evidence block while evidence is not available", lambda c: c["snapshot"][
                "evidence"]["state"] != "available" and "evidence" not in c["expected"]),
            ("a critical snapshot mapped", lambda c: c["failed_step"] is None
             and c["expected"]["status"] == "critical")):
        if not any(test(c) for c in hs):
            gaps.append(f"heartbeat snapshot: {label}")
    pc = corpus["projection_cases"]
    for label, test in (
            ("senders", lambda x: x["remote_command_lockout"].get("senders")),
            ("expiring devices", lambda x: x["firmware_liveness"].get("expiring_device_ids")),
            ("reading-age devices", lambda x: x["firmware_reading_age"].get("devices")),
            ("refused documents", lambda x: x["firmware_controller_profiles"].get(
                "documents_refused")),
            ("alarm channels", lambda x: x["firmware_controller_profiles"].get("alarm_channels")),
            ("trigger timestamps", lambda x: x["last_alert_timestamps"]["by_trigger"]),
            ("diagnostics", lambda x: x["diagnostics"]),
            ("an unreadable critical-capable block", lambda x: any(
                (x.get(n) or {}).get("state") == "unavailable" for n in m["critical_capable"])),
            ("a commissioning verdict with free text", lambda x: isinstance(
                (x["commissioning"].get("last_verdict")), dict)),
            ("a snapshot that fails the triple check", lambda x: triple_check(
                m, x, whole=True) is not None),
            ("a sender locked out beside one that is not", lambda x: {
                y.get("locked_out") for y in x["remote_command_lockout"].get("senders", [])}
             == {True, False})):
        if not any(test(c["snapshot"]) for c in pc):
            gaps.append(f"projection: a snapshot carrying {label}")
    for _, verdict in m["t_steps"][:4]:
        if verdict not in steps:
            gaps.append(f"heartbeat: {verdict}")
    for status in m["order"]:
        if not any(s is None and h["status"] == status for s, h in zip(steps, hbs)):
            gaps.append(f"heartbeat: a {status} that passes")
    def top_rank(h: dict) -> int:
        return max((rank(m, m["vocabulary"][t]) for t in h["degradation_reasons"]
                    if m["vocabulary"][t] is not None), default=-1)

    t4 = {
        "reasons on ok": lambda h: h["status"] == m["none_status"] and h["degradation_reasons"],
        "no reasons on a status other than ok": lambda h: h["status"] != m["none_status"]
        and not h["degradation_reasons"],
        "the umbrella without a liveness token": lambda h: m["umbrella"] in h["degradation_reasons"]
        and not set(h["degradation_reasons"]) & set(m["umbrella_of"]),
        "a liveness token without the umbrella": lambda h: m["umbrella"] not in h[
            "degradation_reasons"] and set(h["degradation_reasons"]) & set(m["umbrella_of"]),
        "severity understated": lambda h: h["status"] != m["none_status"]
        and top_rank(h) > rank(m, h["status"]),
        "severity overstated": lambda h: h["status"] != m["none_status"]
        and 0 <= top_rank(h) < rank(m, h["status"]),
    }
    t4_failures = [h for h, step in zip(hbs, steps) if step == m["t_steps"][3][1]]
    for label, test in t4.items():
        if not any(test(h) for h in t4_failures):
            gaps.append(f"heartbeat T4: {label}")
    t3 = {
        "not an array": lambda r: not isinstance(r, list),
        "over the bound": lambda r: isinstance(r, list) and len(r) > m["max_reasons"],
        "unsorted": lambda r: isinstance(r, list) and len(set(r)) == len(r)
        and r != sorted(r),
        "duplicate": lambda r: isinstance(r, list) and len(set(map(str, r))) != len(r),
        "unknown token": lambda r: isinstance(r, list) and any(t not in m["vocabulary"] for t in r),
        "the heartbeat's token": lambda r: isinstance(r, list) and m["heartbeat_only"] in r,
        "absent or null": lambda r: r is None,
    }
    for label, test in t3.items():
        if not any(s == m["t_steps"][2][1] and test(h.get("degradation_reasons"))
                   for s, h in zip(steps, hbs)):
            gaps.append(f"heartbeat T3: {label}")
    if not any(not isinstance(h, dict) for h in hbs):
        gaps.append("heartbeat T1: a snapshot that is not an object")

    gws = [(gateway_verdict(m, c["heartbeat"]), c["heartbeat"]) for c in corpus["gateway_reason_cases"]]
    for _, _, verdict in m["gateway_steps"]:
        if verdict is not None and verdict not in [v for v, _ in gws]:
            gaps.append(f"gateway: {verdict}")
    for status in ("healthy", *m["reason_statuses"]):
        if not any(v == "accept" and "degradation_reasons" not in h and h["status"] == status
                   for v, h in gws):
            gaps.append(f"gateway: {status} with reasons absent")
    for status in m["reason_statuses"]:
        if not any(v == "accept" and h.get("degradation_reasons") and h["status"] == status
                   for v, h in gws):
            gaps.append(f"gateway: {status} with reasons accepted")
    def verdict_of(prefix: str) -> str | None:
        return next(v for _, t, v in m["gateway_steps"] if t.startswith(prefix))

    def listed(h: dict) -> list:
        r = h.get("degradation_reasons")
        return r if isinstance(r, list) else []

    gw_cover = {
        "every snapshot token accepted": lambda v, h: v == "accept"
        and set(listed(h)) == set(m["vocabulary"]) - {m["heartbeat_only"]},
        "over the length bound": lambda v, h: v == verdict_of("length is")
        and len(listed(h)) > m["gateway_length"][1],
        "duplicates at the length bound": lambda v, h: v == verdict_of("elements are unique")
        and len(listed(h)) == m["gateway_length"][1],
        "an invalid status with reasons absent": lambda v, h: v == verdict_of("`status` is")
        and "degradation_reasons" not in h,
        "starting with reasons, refused at the status": lambda v, h: v == verdict_of("`status` is")
        and h.get("status") == "starting" and listed(h),
        "status absent": lambda v, h: v == verdict_of("`status` is") and "status" not in h,
        "health_snapshot_invalid accepted alone under critical": lambda v, h: v == "accept"
        and listed(h) == [m["heartbeat_only"]],
        "health_snapshot_invalid beside another token": lambda v, h: v == verdict_of(
            "`health_snapshot_invalid`") and len(listed(h)) > 1,
        "health_snapshot_invalid alone under degraded": lambda v, h: v == verdict_of(
            "`health_snapshot_invalid`") and listed(h) == [m["heartbeat_only"]]
        and h.get("status") == "degraded",
        "health_snapshot_invalid alone under healthy": lambda v, h: v == verdict_of(
            "`health_snapshot_invalid`") and listed(h) == [m["heartbeat_only"]]
        and h.get("status") == "healthy",
    }
    for label, test in gw_cover.items():
        if not any(test(v, h) for v, h in gws):
            gaps.append(f"gateway: {label}")

    resp = [(response_failures(m, c["response"]), c["response"]) for c in corpus["response_cases"]]
    for n in m["snapshot_steps"]:
        if not any(f[:1] == [n] for f, _ in resp):
            gaps.append(f"response: check {n} the first to fail")
    if not any(not f for f, _ in resp):
        gaps.append("response: a whole response accepted")
    for label, test in (
            ("not JSON", lambda t: _not_json(t)),
            ("a refusal envelope", lambda t: '"ok": false' in t),
            ("a duplicate envelope member", lambda t: _dup_level(t) == "envelope"),
            ("a duplicate top-level health member", lambda t: _dup_level(t) == "health"),
            ("a duplicate nested member", lambda t: _dup_level(t) == "nested")):
        if not any(test(t) for _, t in resp):
            gaps.append(f"response: {label}")
    def relaxed(text: str, step: int, **knobs: Any) -> bool:
        """The response fails `step` alone, and passes it once these rules are relaxed."""
        if independent(m, response_failures(m, text)) != [step]:
            return False
        return step not in response_failures({**m, **knobs}, text)

    wide = (-(2**63), 2**64)
    S_MEMBERS, S_INT, S_TYPE, S_SHAPE = (step_of(m, v) for v in (
        "members_invalid", "integer_invalid", "type_invalid", "shape_invalid"))
    kinds = {
        "a schema_version other than 1": lambda t: _envelope(t, lambda d: d.get(
            "schema_version") not in (None, "1") and set(d) == {"schema_version", "ok", "health"}),
        "an extra envelope member": lambda t: _envelope(
            t, lambda d: set(d) > {"schema_version", "ok", "health"}),
        "an extra health member": lambda t: _health_keys(t, m) == "extra",
        "a missing health member": lambda t: _health_keys(t, m) == "missing",
        "an int over its range": lambda t: relaxed(t, S_INT, int_range=(0, 2**64)),
        "an int under its range": lambda t: relaxed(t, S_INT, int_range=(-(2**63), m["int_range"][1])),
        "an int with a fraction": lambda t: relaxed(t, S_INT, int_form_required=False),
        "a negative float": lambda t: relaxed(t, S_INT, negative_floats=True),
        "the int64 sentinel": lambda t: str(2**63 - 1) in t and relaxed(t, S_INT, int_range=wide),
        "a state alone not allowed": lambda t: relaxed(t, S_SHAPE, check_states=False),
        "a tied boolean alone disagreeing": lambda t: relaxed(t, S_SHAPE, check_ties=False),
        "a member alone present against its Present column": lambda t: relaxed(
            t, S_SHAPE, check_presence=False),
        "a set alone out of byte order": lambda t: relaxed(t, S_SHAPE, set_order=False),
        "a set alone holding a duplicate": lambda t: relaxed(t, S_SHAPE, set_dups=False),
        "unmapped_set_bits alone not ascending": lambda t: relaxed(
            t, S_SHAPE, ascending_check=False),
        "a type alone wrong": lambda t: relaxed(t, S_TYPE, check_types=False),
        **{f"consistency rule {r} alone broken": (lambda t, r=r: relaxed(
            t, S_SHAPE, consistency=[x for _, x in CONSISTENCY if x != r]))
           for _, r in CONSISTENCY},
        "a vocabulary value alone wrong": lambda t: relaxed(t, S_TYPE, check_vocab=False),
        "a diagnostics namespace not listed": lambda t: relaxed(
            t, S_MEMBERS, diag_namespaces=False),
        "a diagnostics namespace that is not an object": lambda t: relaxed(
            t, S_TYPE, diag_namespace_objects=False),
    }
    for label, test in kinds.items():
        if not any(test(t) for _, t in resp):
            gaps.append(f"response: {label}")
    for label, test in (
            ("a row behind a false flag", lambda t: _flag_row(t, m)),
            ("an available-only member while unavailable", lambda t: _state_rows(t, m, "unavailable")),
            ("a member in a disabled block", lambda t: _state_rows(t, m, "disabled"))):
        if not any(test(t) and response_failures(m, t)[:1] == [S_SHAPE] for _, t in resp):
            gaps.append(f"response: {label}")
    if not any(v == verdict_of("elements are unique") and listed(h) != sorted(
            listed(h), key=lambda t: str(t).encode()) for v, h in gws):
        gaps.append("gateway: duplicates out of byte order, refused as duplicates")
    unrep = [(c["value"], unrepresentable_verdict(m, c)) for c in corpus["unrepresentable_cases"]]
    hi = m["int_range"][1]
    for value, want in ((str(hi), "serve"), (str(hi + 1), "internal_error"),
                        (str(2**63 - 1), "internal_error")):
        if (value, want) not in unrep:
            gaps.append(f"unrepresentable: {value} {want}")

    reqs = [([bytes.fromhex(w) for w in c["writes_hex"]], c["after"], c["expected"])
            for c in corpus["request_cases"]]
    whole = [(b"".join(w), w, a, e) for w, a, e in reqs]
    for acc in m["accepted"]:
        if not any(b == acc and a == "eof" and e == "ok" for b, _, a, e in whole):
            gaps.append(f"request: {acc!r} accepted")
    for label, needles in m["refused_classes"].items():
        def before_lf(b: bytes) -> bytes:
            return b.split(b"\n", 1)[0]
        if label == "invalid UTF-8":
            hit = any(e == "unsupported_request" and _invalid_utf8(before_lf(b))
                      for b, _, _, e in whole)
        else:
            hit = any(e == "unsupported_request" and any(n in before_lf(b) for n in needles)
                      for b, _, _, e in whole)
        if not hit:
            gaps.append(f"request: refused {label}")
    bound = m["request_bound"]
    edges = {
        "split writes accepted": lambda b, w, a, e: len(w) > 1 and e == "ok",
        "byte by byte": lambda b, w, a, e: len(w) == len(b) > 2,
        "bytes after the LF": lambda b, w, a, e: b"\n" in b and len(b) > b.index(b"\n") + 1
        and b[: b.index(b"\n") + 1] in m["accepted"] and b[b.index(b"\n") + 1:] not in (b"", b"\n"),
        "bytes after the LF in a later write": lambda b, w, a, e: len(w) > 1
        and b"\n" in w[0] and w[0].endswith(b"\n") and e == "ok",
        "over the bound after an accepted LF": lambda b, w, a, e: len(b) > bound and e == "ok",
        f"{bound} bytes, no LF": lambda b, w, a, e: len(b) == bound and b"\n" not in b and a == "eof",
        f"{bound + 1} bytes, no LF": lambda b, w, a, e: len(b) == bound + 1 and b"\n" not in b,
        f"{bound} bytes ending in LF": lambda b, w, a, e: len(b) == bound and b.endswith(b"\n")
        and b.count(b"\n") == 1,
        f"{bound + 1} bytes ending in LF": lambda b, w, a, e: len(b) == bound + 1
        and b.endswith(b"\n") and b.count(b"\n") == 1,
        "1000 + 25 split": lambda b, w, a, e: [len(x) for x in w] == [1000, 25],
        "1000 + 24 split": lambda b, w, a, e: [len(x) for x in w] == [1000, 24],
        "unfinished GET_HEALTH past the bound": lambda b, w, a, e: a == "silent"
        and b"\n" not in b and b in m["accepted"],
        "nothing sent, past the bound": lambda b, w, a, e: a == "silent" and not b,
        "unfinished at the size bound past the time bound": lambda b, w, a, e: a == "silent"
        and len(b) == bound and b"\n" not in b,
        "closed before any byte": lambda b, w, a, e: a == "eof" and not b,
        "an LF first, then GET_HEALTH": lambda b, w, a, e: b.startswith(b"\n") and len(b) > 1,
    }
    for label, test in edges.items():
        if not any(test(b, w, a, e) for b, w, a, e in whole):
            gaps.append(f"request: {label}")

    ints = [(c["json"], c["expected"]) for c in corpus["integer_cases"]]
    hi = m["int_range"][1]
    for text, want in ((str(hi), "accept"), (str(hi + 1), "refuse"), ("0", "accept"),
                       ("-1", "refuse"), (str(-hi), "refuse")):
        if (text, want) not in ints:
            gaps.append(f"integer: {text}")
    for label, test in (("a fraction", lambda t: "." in t), ("an exponent", lambda t: "e" in t.lower()),
                        ("a leading zero", lambda t: re.fullmatch(r"0\d+", t) is not None),
                        ("a string", lambda t: t.startswith('"')),
                        ("a boolean", lambda t: t in ("true", "false")), ("null", lambda t: t == "null")):
        if not any(test(t) for t, _ in ints):
            gaps.append(f"integer: {label}")

    exps = [c["device_policy"] for c in corpus["expiry_cases"]]
    rules = {
        "never accepted": lambda d, v: v == "accept" and d.get("expiry") == "never",
        "at accepted, not expired": lambda d, v: v == "accept" and d.get("expiry") == "at"
        and not d["is_expired"],
        "at accepted, expired": lambda d, v: v == "accept" and d.get("expiry") == "at" and d["is_expired"],
        "the int64 sentinel": lambda d, v: d.get("valid_until") == 2**63 - 1,
        "never and expired": lambda d, v: d.get("expiry") == "never" and d.get("is_expired") is True,
        "at with null": lambda d, v: d.get("expiry") == "at" and d.get("valid_until") is None,
        "expiry absent": lambda d, v: "expiry" not in d,
        "expiry null": lambda d, v: "expiry" in d and d["expiry"] is None,
        "an unknown expiry word": lambda d, v: d.get("expiry") not in (None, "never", "at"),
        "valid_until out of range": lambda d, v: type(d.get("valid_until")) is int
        and d.get("expiry") == "at" and d["valid_until"] > hi,
        "valid_until a string": lambda d, v: isinstance(d.get("valid_until"), str),
    }
    for label, test in rules.items():
        if not any(test(d, expiry_verdict(m, d)) for d in exps):
            gaps.append(f"expiry: {label}")
    return gaps


def _doc(text: str) -> Any:
    try:
        return parse_response(text.removesuffix("\n"))
    except ValueError:
        return None


def _envelope(text: str, test: Callable[[dict], bool]) -> bool:
    doc = _doc(text)
    return isinstance(doc, dict) and test(doc)


def _health_keys(text: str, m: dict) -> str | None:
    doc = _doc(text)
    health = doc.get("health") if isinstance(doc, dict) else None
    if not isinstance(health, dict):
        return None
    if set(health) > set(m["payload"]):
        return "extra"
    if set(health) < set(m["payload"]):
        return "missing"
    return None


def _flag_row(text: str, m: dict) -> bool:
    doc = _doc(text)
    ev = (doc.get("health") or {}).get("evidence") if isinstance(doc, dict) else None
    if not isinstance(ev, dict):
        return False
    return any(ev.get(flag) is False and any(
        f in ev for f, r in m["schema"]["evidence"].items() if r["present"] == section)
        for section, flag in SECTION_FLAGS.items())


def _state_rows(text: str, m: dict, state: str) -> bool:
    doc = _doc(text)
    health = doc.get("health") if isinstance(doc, dict) else None
    if not isinstance(health, dict):
        return False
    for name, b in health.items():
        if isinstance(b, dict) and b.get("state") == state and name in m["schema"] and any(
                f in b for f, r in m["schema"][name].items() if r["present"] == "available"):
            return True
    return False


def _not_json(text: str) -> bool:
    try:
        parse_response(text)
    except ValueError:
        return True
    return False


def _dup_level(text: str) -> str | None:
    try:
        doc = parse_response(text)
    except ValueError:
        return None
    if not isinstance(doc, Obj):
        return None
    if doc.dup:
        return "envelope"
    health = doc.get("health")
    if isinstance(health, Obj) and health.dup:
        return "health"
    return "nested" if any_dup(health) else None


def _invalid_utf8(b: bytes) -> bool:
    try:
        b.decode("utf-8")
    except UnicodeDecodeError:
        return True
    return False


def run(corpus_bytes: bytes, m: dict, coverage_model: dict | None = None) -> None:
    corpus = load(corpus_bytes)
    problems = check(corpus, m)
    problems += [f"not covered: {g}" for g in dict.fromkeys(coverage(corpus, coverage_model or m))]
    if problems:
        raise Failure(f"{len(problems)} disagreement(s):\n  " + "\n  ".join(problems))


# --- mutations ---------------------------------------------------------------------------

def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            run(json.dumps(mutated).encode(), model)
        return go

    def model_mutant(**changes: Any) -> Callable[[], None]:
        def go() -> None:
            mutated = dict(model)
            for key, value in changes.items():
                if isinstance(value, dict) and isinstance(mutated.get(key), dict):
                    mutated[key] = {**mutated[key], **value}
                else:
                    mutated[key] = value
            run(corpus_bytes, mutated, coverage_model=model)
        return go

    def text_mutant(doc: str, old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            if old not in texts[doc]:
                raise AssertionError(f"mutant target missing: {old!r}")
            texts[doc] = texts[doc].replace(old, new, 1)
            run(corpus_bytes, contract_model(texts))
        return go

    def named(c: dict, kind: str, name: str) -> dict:
        return next(x for x in c[kind] if x.get("name") == name)

    sev = model["severity"]
    flip = {"degraded": "critical", "critical": "degraded"}

    def never(s: dict, m: dict) -> bool:
        return False

    cases: list[tuple[str, Callable[[], None]]] = []
    for token in model["raised_order"]:
        cases.append((f"condition dropped: {token}", model_mutant(pred={token: never})))
        cases.append((f"severity swapped: {token}", model_mutant(severity={token: flip[sev[token]]})))
    cases += [
        ("fold takes the minimum", model_mutant(fold="min")),
        ("fold takes the last raised", model_mutant(fold="last")),
        ("umbrella not emitted", model_mutant(umbrella_in_reasons=False)),
        ("boundaries exclusive (≥ read as >)", model_mutant(reached=lambda a, b: a > b)),
        ("boundaries inclusive (> read as ≥)", model_mutant(over=lambda a, b: a >= b)),
        ("a clean stop owes ticks", model_mutant(stale_loops=LOOPS)),
        ("a stopped loop owes no ticks", model_mutant(stale_loops=("running",))),
        ("no tick reads as fresh", model_mutant(null_tick_counts_start=False)),
        ("posture only while evidence is available", model_mutant(posture_every_state=False)),
        ("a pair under qualification read as unprotected",
         model_mutant(unprotected=("unprotected", "unavailable"))),
        ("the deadline exclusive", model_mutant(deadline_passed=lambda e, d: e > d)),
