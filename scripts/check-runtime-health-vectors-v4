    for kind in SETS:
        for c in base[kind]:
            if "name" in c:
                cases.append((f"case {kind}/{c['name']} dropped", corpus_mutant(
                    lambda x, kind=kind, n=c["name"]: x.update(
                        {kind: [y for y in x[kind] if y.get("name") != n]}))))
    # Cases whose every covered property another case also shows.
    redundant_ok = re.compile(r"^case (fold_cases|request_cases|snapshot_cases|served_cases|"
                              r"heartbeat_cases|gateway_reason_cases|response_cases|"
                              r"unrepresentable_cases|projection_cases|heartbeat_snapshot_cases)/")
    survived = 0
    dropped_survivors = []
    for label, mutant in cases:
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError, IndexError,
                AttributeError) as refused:
            first = str(refused).splitlines()[0][:110]
            print(f"refused  {label}: {first}")
        else:
            if redundant_ok.match(label):
                dropped_survivors.append(label)
            else:
                print(f"SURVIVED {label}")
                survived += 1
    if dropped_survivors:
        print(f"{len(dropped_survivors)} case drops not refused: no coverage property this "
              f"checker names rests on that case alone: {', '.join(dropped_survivors)}")
    print(f"{len(cases)} mutants")
    return survived


HELD_SENTENCES: dict[str, dict[str, tuple[str, ...]]] = {
    'v4': {
        '## Request': (
            'The request is line-framed, with one request per connection.',
            ('A request is the bytes up to and including its first LF, or up to the end '
             'of the stream when no LF comes first.'),
            'It is compared as exact bytes: nothing is decoded, trimmed, case-folded or normalised.',
            ('Bytes after the terminating LF are discarded and never judged, so whether a '
             'request is accepted never depends on how the transport splits writes, or on '
             'what follows its LF.'),
            'A connection closed before any byte arrives is the empty request.',
            'The server decides in this order, and the first rule that applies decides:',
            '| Step | Rule | Result |',
            '| 1 | The request is longer than 1024 bytes, counting its LF | `request_too_large` |',
            '| 2 | The request has not ended when a time bound expires | `unsupported_request` |',
            ('| 3 | The request is exactly one of `GET_HEALTH`, `GET_HEALTH` LF, the '
             'empty request, or LF | success |'),
            '| 4 | Anything else | `unsupported_request` |',
            ('Step 1 applies as soon as the server holds more than 1024 bytes of a '
             'request that has not ended, however they arrive.'),
            "The time bound is finite, and its value is the producer's.",
            ('The server writes one response line, a JSON object followed by LF, then '
             'closes the connection.'),
            ('It may close with discarded bytes unread, and on some platforms, Linux '
             'AF_UNIX among them, the client then sees a connection reset after the '
             'complete response rather than a clean end of stream.'),
            'A client sends nothing after its request and reads exactly one response line.',
            '`GET_HEALTH` is the ten ASCII bytes `47 45 54 5f 48 45 41 4c 54 48`;',
            'LF is the byte `0a`.',
            ('A carriage return, any other ASCII or Unicode whitespace or separator '
             '(`\\t`, `\\x0b`, `\\x0c`, `\\x1c` to `\\x1f`, NEL U+0085, NBSP U+00A0, U+2028, '
             'U+2029, a byte order mark), a NUL, and any byte that is not valid UTF-8, '
             'anywhere before the terminating LF, makes the request one that step 4 refuses.'),
            ('Why lines and not end of stream: a client that does not half-close gives '
             'the server no way to know whether more bytes follow the LF, so requiring '
             'end of stream would break those clients.'),
            ('The endpoint is read-only and grants no authority, so nothing requires '
             'judging what follows a complete request.'),
        ),
