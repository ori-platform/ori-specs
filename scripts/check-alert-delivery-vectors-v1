def norm(text: str) -> str:
    return " ".join(text.split())


def section(text: str, title: str, level: int) -> str:
    lines = text.split("\n")
    head = "#" * level + " " + title
    starts = [i for i, ln in enumerate(lines) if ln.rstrip() == head]
    if len(starts) != 1:
        raise Failure(f"text: heading {head!r} found {len(starts)} times")
    start = starts[0]
    end = len(lines)
    for j in range(start + 1, len(lines)):
        m = re.match(r"^(#+) ", lines[j])
        if m and len(m.group(1)) <= level:
            end = j
            break
    return "\n".join(lines[start + 1:end])


def numbered(body: str) -> list[str]:
    """Top-level numbered items of the first Markdown ordered list in body."""
    items: list[str] = []
    cur: list[str] | None = None
    done = False
    for ln in body.split("\n"):
        if done:
            break
        m = re.match(r"^(\d+)\. (.*)$", ln)
        if m:
            if cur is not None:
                items.append(norm(" ".join(cur)))
            if int(m.group(1)) != len(items) + 1:
                raise Failure(f"text: ordered list numbered {m.group(1)} at position {len(items) + 1}")
            cur = [m.group(2)]
        elif cur is not None and ln.startswith(" ") and ln.strip():
            cur.append(ln)
        elif cur is not None and not ln.strip():
            continue
        elif cur is not None:
            items.append(norm(" ".join(cur)))
            cur = None
            done = True
    if cur is not None:
        items.append(norm(" ".join(cur)))
    return items


def table(body: str, first_header: str) -> list[list[str]]:
    """Rows of the first Markdown table whose first header cell is first_header."""
    lines = body.split("\n")
    for i, ln in enumerate(lines):
        if ln.startswith("|"):
            cells = split_row(ln)
            if cells and cells[0] == first_header and i + 1 < len(lines) and re.match(r"^\|[\s\-:|]+\|$", lines[i + 1]):
                rows = []
                for r in lines[i + 2:]:
                    if not r.startswith("|"):
                        break
                    rows.append(split_row(r))
                return rows
    raise Failure(f"text: table headed {first_header!r} not found")


def split_row(ln: str) -> list[str]:
    inner = ln.strip()[1:-1]
    cells, cur, i = [], "", 0
    while i < len(inner):
        if inner[i] == "\\" and i + 1 < len(inner) and inner[i + 1] == "|":
            cur += "|"
            i += 2
            continue
        if inner[i] == "|":
            cells.append(cur.strip())
            cur = ""
        else:
            cur += inner[i]
        i += 1
    cells.append(cur.strip())
    return cells


def ticks(s: str) -> list[str]:
    return re.findall(r"`([^`]*)`", s)


def one(pattern: str, text: str, where: str) -> re.Match:
    m = re.search(pattern, norm(text))
    if not m:
        raise Failure(f"text: {where}: {pattern!r} not found")
    return m


def load_texts() -> dict[str, str]:
    return {k: p.read_text(encoding="utf-8") for k, p in TEXT_FILES.items()}


def build_model(texts: dict[str, str]) -> dict:
    flat = {k: norm(v) for k, v in texts.items()}
    for key, sentence in PINS:
        if norm(sentence) not in flat[key]:
            raise Failure(f"text: pinned sentence missing from {TEXT_FILES[key].relative_to(ROOT)}: {sentence!r}")
    ad = texts["ad"]
    m: dict = {}

    # Identities (runtime-posture/v1 cites)
    ident = section(texts["posture"], "Identities", 2)
    m["spki_prefix"] = bytes.fromhex(one(r"12-byte prefix `([0-9a-f]{24})`", ident, "posture Identities").group(1))
    m["key_identity_re"] = "^sha256:[0-9a-f]{64}$"
    one(r"`sha256:` followed by the (64) lowercase hex characters", ident, "posture Identities")

    # Records: integers
    recs = section(ad, "Records", 2)
    g = one(r"every integer a JSON integer token from `(\d+)` to 2\^(\d+) − (\d+)", recs, "Records integers")
    m["int_min"] = int(g.group(1))
    m["int_max"] = 2 ** int(g.group(2)) - int(g.group(3))

    # Member tables
    def members(title: str) -> list[tuple[str, str]]:
        rows = table(section(ad, title, 3), "Member")
        out = []
        for r in rows:
            names = ticks(r[0])
            if len(names) != 1:
                raise Failure(f"text: {title}: member cell {r[0]!r}")
            out.append((names[0], r[1]))
        return out

    sub = members("Submission observation")
    tal = members("Withholding tally")
    m["submission_members"] = [n for n, _ in sub]
    m["tally_members"] = [n for n, _ in tal]
    sd, td = dict(sub), dict(tal)
    m["kind_submission"] = ticks(sd["kind"])[0].strip('"')
    m["kind_tally"] = ticks(td["kind"])[0].strip('"')

    def pat(cell: str) -> str:
        ps = [p for p in ticks(cell) if p.startswith("^") and p.endswith("$")]
        if len(ps) != 1:
            raise Failure(f"text: pattern cell {cell!r}")
        return ps[0]

    m["patterns"] = {
        "device_id": pat(sd["device_id"]),
        "alert_id": pat(sd["alert_id"]),
        "delivery_attempt_id": pat(sd["delivery_attempt_id"]),
        "class": pat(sd["class"]),
        "month": pat(td["month"]),
    }
    if not re.fullmatch(r"As above\.", td["device_id"]) or not re.fullmatch(r"As above, or `null`\.", td["class"]):
        raise Failure("text: tally's device_id/class rows changed")
    if "or `null`" not in sd["class"]:
        raise Failure("text: class row no longer admits null")
    m["v"] = int(one(r"The integer `(\d+)`\.", sd["v"], "v row").group(1))
    if td["v"] != sd["v"]:
        raise Failure("text: tally v row differs")
    m["notices"] = ticks(sd["notice"])[:3]
    m["channels"] = ticks(sd["channel"])
    if ticks(td["channel"]) != m["channels"]:
        raise Failure("text: tally channel set differs")
    m["obs_seqs"] = [int(x) for x in ticks(sd["observation_seq"])[:3]]
    m["attempt_seq_min"] = int(one(r"at least `(\d+)`", sd["attempt_seq"], "attempt_seq").group(1))
    m["count_min"] = int(one(r"at least `(\d+)`", td["count"], "count").group(1))
    m["tally_reasons"] = ticks(td["reason"])
    m["outcome_members"] = ticks(sd["outcome"])
    pv = re.match(r"^((?:`\w+`, )*`\w+` or `\w+`):", sd["prior_outcome"])
    if not pv:
        raise Failure(f"text: prior_outcome row changed: {sd['prior_outcome']!r}")
    m["prior_vocab"] = [None if t == "null" else t for t in ticks(pv.group(1))]
    if not re.fullmatch(r"`null`, or one of the codes the table of \[Detail codes\]\(#detail-codes\) lists\.", sd["detail"]):
        raise Failure(f"text: detail row changed: {sd['detail']!r}")
    one(r"canonical padded RFC 4648 Base64 of its (64) bytes", sd["signature"], "signature")

    # Outcomes table
    outs = section(ad, "Outcomes", 2)
    m["outcomes"] = [ticks(r[0])[0] for r in table(outs, "Outcome")]
    m["reserved_outcome"] = one(r"\*\*`(\w+)` is reserved\.\*\*", outs, "reserved").group(1)
    m["delivered_reason"] = one(r"so a record whose `outcome` is `delivered`, or any other value, is `(\w+)`", outs, "delivered").group(1)
    obs = section(ad, "Observations of one attempt", 3)
    rows = table(obs, "`observation_seq`")
    m["obs_table"] = []
    for r in rows:
        seq = int(ticks(r[0])[0])
        prior = ticks(r[1])[0]
        prior = None if prior == "null" else prior
        if not re.fullmatch(r"(`\w+`, )*`\w+`", r[2]):
            raise Failure(f"text: observation table cell changed: {r[2]!r}")
        m["obs_table"].append((seq, prior, tuple(ticks(r[2])), ""))
    m["transition_refused"] = one(r"Any other combination is refused as `(\w+)`", obs, "transition").group(1)
    m["ends"] = one(r"`(\w+)` ends an attempt", obs, "ends").group(1)

    # Notices
    nots = section(ad, "Notices", 2)
    mand = one(r"`(\w+)` and `(\w+)` are \*\*mandatory\*\*", nots, "mandatory")
    m["mandatory"] = [mand.group(1), mand.group(2)]
    m["optional_notice"] = [n for n in m["notices"] if n not in m["mandatory"]]

    # Class
    cls = section(ad, "Class", 2)
    m["class_refused"] = one(r"a mandatory notice with a non-`null` class is refused as `(\w+)`", cls, "class").group(1)
    g = one(r"In a tally, `reason: \"(\w+)\"` with `class: null` is refused as `(\w+)`", cls, "tally class")
    m["class_needs"] = g.group(1)
    if g.group(2) != m["class_refused"]:
        raise Failure("text: two class refusal names")

    # Detail codes
    det = section(ad, "Detail codes", 2)
    m["detail_table"] = {}
    for r in table(det, "`outcome`"):
        codes = ticks(r[1])
        m["detail_table"][ticks(r[0])[0]] = [None if c == "null" else c for c in codes]
    g = one(r"A code no row lists is outside `detail`'s form, and is `(\w+)`\. A listed code is refused as `(\w+)` when its row is not the record's `outcome`, and also when `prior_outcome` is `(\w+)` and the code is not `(\w+)` or `null`, or `prior_outcome` is not `(\w+)` and the code is `(\w+)`\.", det, "detail")
    m["detail_unlisted"] = g.group(1)
    m["detail_refused"] = g.group(2)
    if not (g.group(3) == g.group(5) and g.group(4) == g.group(6)):
        raise Failure("text: the detail rule's prior clauses no longer mirror each other")
    m["detail_prior_only"] = (g.group(4), g.group(3))
    m["detail_codes"] = [c for cs in m["detail_table"].values() for c in cs if c is not None]

    # Tallies: the bound
    wt = section(ad, "Withholding tallies", 2)
    g = one(r"at most (\d+) distinct class names on each channel", wt, "tally bound")
    m["tally_class_names"] = int(g.group(1))
    g = one(r"at most (\d+) `(\w+)` tallies and (\d+) `(\w+)` tallies, and a runtime keeps at most \((\d+) \+ (\d+)\) × (\d+) channels × (\d+) months = (\d+) tallies", wt, "tally bound")
    m["tally_bound"] = {
        "disabled_per": int(g.group(1)), "disabled_name": g.group(2),
        "capped_per": int(g.group(3)), "capped_name": g.group(4),
        "a": int(g.group(5)), "b": int(g.group(6)), "channels": int(g.group(7)), "months": int(g.group(8)),
        "total": int(g.group(9)),
    }
    tb = m["tally_bound"]
    if not (tb["disabled_per"] == m["tally_class_names"] and tb["capped_per"] == m["tally_class_names"] + 1
            and tb["a"] == tb["disabled_per"] and tb["b"] == tb["capped_per"]
            and tb["channels"] == len(m["channels"]) and tb["months"] == 2
            and tb["total"] == (tb["a"] + tb["b"]) * tb["channels"] * tb["months"]
            and [tb["disabled_name"], tb["capped_name"]] == m["tally_reasons"]):
        raise Failure(f"text: the tally bound's arithmetic does not hold: {tb}")
    g = one(r"A count that reaches 2\^(\d+) − (\d+) stays there", wt, "overflow")
    m["count_max"] = 2 ** int(g.group(1)) - int(g.group(2))
    if m["count_max"] != m["int_max"]:
        raise Failure("text: tally overflow differs from the integer maximum")
    pub = section(ad, "Publication", 2)
    g = one(r"so the queue holds at most one snapshot per tally key, and at most (\d+) of the current epoch", pub, "queue tallies")
    if int(g.group(1)) != tb["total"]:
        raise Failure("text: publication's tally bound differs from Withholding tallies'")
    g = one(r"the queue reserves (\d+) places for tallies", pub, "reserved places")
    if int(g.group(1)) != tb["total"]:
        raise Failure("text: reserved tally places differ from the tally bound")

    # Signature prefixes
    sig = section(ad, "Signature", 2)
    m["record_prefix"] = one(r"The signing input is the ASCII bytes `([a-z0-9._]+)`, one NUL byte", sig, "signature").group(1).encode() + b"\x00"

    # Carriage: the gateway's checks
    cc = section(ad, "Carriage and custody", 2)
    items = numbered(cc)
    if len(items) != 7:
        raise Failure(f"text: carriage lists {len(items)} checks")
    gw = []
    for i, it in enumerate(items, 1):
        reasons = [t for t in ticks(it) if re.fullmatch(r"[a-z_]+", t) and t not in ("device_id", "outcome", "gateway.device_ids")]
        gw.append((i, it, reasons))
    m["gw_checks"] = gw
    m["gw_reason"] = {3: gw[2][2][-1], 4: gw[3][2][-1], 5: gw[4][2][-1], 6: gw[5][2][-1]}
    g4 = re.fullmatch(r"`v` is an integer under the integer rule of \[Records\]\(#records\), other than `(\d+)`: `(\w+)`\. A `v` outside that rule, `0`, a negative or one above 2\^53 − 1 among them, is `(\w+)`\. Otherwise, not a record of either kind, with every member present, of its type and within its form: `(\w+)`\.", items[3])
    if not g4 or int(g4.group(1)) != m["v"] or g4.group(3) != g4.group(4):
        raise Failure(f"text: carriage check 4 changed: {items[3]!r}")
    m["gw_unsupported"], m["gw_reason"][4] = g4.group(2), g4.group(4)
    g7 = re.search(r"a digest already held is `(\w+)`, and changes nothing\. A queue holding `max_records_per_device` records for the device is `(\w+)`\..*a record that passes checks 1 to 6 is `(\w+)`", items[6])
    if not g7:
        raise Failure(f"text: carriage check 7 changed: {items[6]!r}")
    m["gw_replayed"], m["gw_queue_full"], m["gw_store_unavailable"] = g7.groups()
    if "A held digest is `replayed` even when the queue is full." not in items[6]:
        raise Failure("text: check 7 no longer replays before the bound")
    ack_rows = {ticks(r[0])[0]: r[1] for r in table(cc, "Member")}
    if sorted(ack_rows) != ["acknowledged_at_ms", "device_id", "outcome", "reason", "record_digest"]:
        raise Failure(f"text: acknowledgement members changed: {sorted(ack_rows)}")
    ga = re.fullmatch(r"`(\w+)` for a commit or a `(\w+)` record; `(\w+)` otherwise\.", ack_rows["outcome"])
    if not ga or ga.group(2) != m["gw_replayed"]:
        raise Failure(f"text: acknowledgement outcome row changed: {ack_rows['outcome']!r}")
    if ack_rows["reason"] != '`""` when `queued`; otherwise the refusing check\'s reason.':
        raise Failure(f"text: acknowledgement reason row changed: {ack_rows['reason']!r}")
    m["ack_outcomes"] = (ga.group(1), ga.group(2), ga.group(3), m["gw_queue_full"], m["gw_store_unavailable"])
    gr = one(r"`(\w+)` and `(\w+)` describe the gateway's state, and `(\w+)` the versions the gateway takes, never a fault in the record, so all three are \*\*retryable\*\*", cc, "retryable")
    if set(gr.groups()) != {m["gw_queue_full"], m["gw_store_unavailable"], m["gw_unsupported"]}:
        raise Failure(f"text: the retryable set changed: {gr.groups()}")
    m["ack_unanswered_check"] = int(one(r"A message refused at check (\d) is not acknowledged", cc, "ack").group(1))
    m["ack_from"] = tuple(int(x) for x in one(r"or a refusal at checks (\d) to (\d) for a configured device", cc, "ack").groups())

    # Verifying: the receiver's checks
    ver = section(ad, "Verifying", 2)
    items = numbered(ver)
    if len(items) != 6:
        raise Failure(f"text: verifying lists {len(items)} checks")
    g1 = one(r"^Checks (\d) to (\d) of \[Carriage and custody\]\(#carriage-and-custody\), and, in place of check 1's MQTT bounds, its own bound of (\d+) bytes on the record: `(\w+)`\.", items[0], "rx 1")
    m["rx_check1"] = (int(g1.group(1)), int(g1.group(2)))
    m["rx_bound"], m["rx_too_large"] = int(g1.group(3)), g1.group(4)
    m["rx_reasons"] = {
        2: [t for t in ticks(items[1]) if t == "not_owned" or t.endswith("_owned")],
        3: [one(r"otherwise `(\w+)`\. A key so enrolled and since revoked: `(\w+)`\.", items[2], "rx 3").group(1),
            one(r"otherwise `(\w+)`\. A key so enrolled and since revoked: `(\w+)`\.", items[2], "rx 3").group(2)],
        4: [ticks(items[3])[-1]],
        5: [t for t in ticks(items[4])],
        6: [t for t in ticks(items[5])],
    }
    m["rx_check3_text"] = items[2]
    m["rx_check5_text"] = items[4]
    m["rx_check6_text"] = items[5]
    g5 = re.fullmatch(r"The rules that relate members, in this order: (.*)\.", items[4])
    if not g5:
        raise Failure(f"text: receiver check 5 changed: {items[4]!r}")
    parts = [x.strip() for x in g5.group(1).split(";")]
    labels = {"the observation table": "transition", "the class rules of [Class](#class)": "class",
              "the detail table": "detail"}
    m["rx5"] = []
    m["rx5_rule"] = {}
    for part in parts:
        lab, _, reason = part.rpartition(", ")
        if lab not in labels or not re.fullmatch(r"`\w+`", reason):
            raise Failure(f"text: receiver check 5 part {part!r}")
        m["rx5"].append(reason.strip("`"))
        m["rx5_rule"][reason.strip("`")] = labels[lab]
    for r in (m["transition_refused"], m["class_refused"], m["detail_refused"]):
        if r not in m["rx5"]:
            raise Failure(f"text: {r} is not among receiver check 5's reasons")
    m["rx_reasons"][5] = list(m["rx5"])
    m["rx6_dup_pool"] = one(r"in this order: bytes identical to a record it holds, as `(\w+)` or as `(\w+)`, are `(\w+)`", items[5], "rx 6").groups()
    m["rx6"] = one(r"are `(\w+)`\. Different bytes under a held identity, an observation's or a tally snapshot's, or a record that breaks \[Consistency across records\]\(#consistency-across-records\) against one held, are `(\w+)`\. A tally whose count is below the greatest held for its key is `(\w+)`", items[5], "rx 6").groups()
    m["stored"] = one(r"Any other record is `(\w+)`\.", items[5], "rx 6").group(1)
    if m["rx6_dup_pool"] != (m["stored"], m["rx6"][1], m["rx6"][0]):
        raise Failure(f"text: check 6's duplicate pool changed: {m['rx6_dup_pool']}")

    # Consistency across records
    con = section(ad, "Consistency across records", 3)
    g = one(r"\*\*Every observation of one `delivery_attempt_id`\*\* carries the same ((?:`\w+`, )*`\w+` and `\w+`)\.", con, "consistency")
    m["attempt_fields"] = ticks(g.group(1))
    m["obs_identity"] = [x.strip() for x in one(r"An observation's identity is `\(([\w, ]+)\)`", con, "identity").group(1).split(",")]
    m["consistency_scope"] = one(r"Every rule here holds within one `(\w+)` and one \[lineage\]\(#lineage\), whatever key of that lineage signs each record", con, "scope").group(1)
    lin = section(ad, "Lineage", 3)
    one(r"The rules of \[Consistency across records\]\(#consistency-across-records\), the uniqueness of `attempt_seq`, and \[Reading a notice\]\(#reading-a-notice\) hold within one lineage\.", lin, "lineage")
    one(r"An enrolment to another owner never continues a lineage\.", lin, "lineage")

    # Enrolment proof
    kt = section(ad, "Key trust", 2)
    pr = kt[kt.index("**The enrolment proof.**"):]
    m["nonce_re"] = one(r"an even number, matching `(\^[^`]+\$)`", pr, "nonce").group(1)
    g = one(r"written as (\d+) to (\d+) lowercase hexadecimal characters", pr, "nonce")
    m["nonce"] = (int(g.group(1)), int(g.group(2)))
    for n in range(0, 80):
        if bool(re.fullmatch(m["nonce_re"][1:-1], "a" * n)) != (m["nonce"][0] <= n <= m["nonce"][1] and n % 2 == 0):
            raise Failure("text: the nonce pattern and the nonce's stated length disagree")
    m["enrol_prefix"] = one(r"the ASCII bytes `([a-z0-9._]+)`, one NUL byte", pr, "enrol prefix").group(1).encode() + b"\x00"
    blk = re.search(r"```json\n(.*?)\n```", pr, re.S)
    m["enrol_members"] = sorted(json.loads(blk.group(1)).keys())
    m["enrol_v"] = json.loads(blk.group(1))["v"]
    m["enrol_purpose"] = one(r"`purpose` is the constant `(\w+)`", pr, "purpose").group(1)
    if json.loads(blk.group(1))["purpose"] != m["enrol_purpose"]:
        raise Failure("text: enrolment example purpose differs from the constant")
    items = numbered(pr)
    if len(items) != 6:
        raise Failure(f"text: the enrolment proof lists {len(items)} refusals")
    if "lineage_origin" not in m["enrol_members"]:
        raise Failure("text: the challenge no longer carries lineage_origin")
    if "or `lineage_origin` not a `key_identity`" not in items[0]:
        raise Failure(f"text: enrolment check 1 changed: {items[0]!r}")
    one(r"`lineage_origin` is the `key_identity` of the key that began the key's lineage: its own, when the key was made at the store's first commissioning or by the act that begins a lineage; and the origin of the key it replaced, when it was made by a rotation", pr, "origin")
    if not re.fullmatch(r"`lineage_origin` is the `key_identity`, or the recorded lineage origin, of a key the receiver holds enrolled for this device to another owner than this enrolment's: `\w+`\. A move begins a new lineage, so its keys name themselves; one that names the earlier owner's lineage was moved without that act\.", items[5]):
        raise Failure(f"text: enrolment check 6 changed: {items[5]!r}")
    m["enrol_order"] = [ticks(it)[-1] for it in items]
    m["enrol_items"] = items

    # Config load rules (gateway-config/v2 alert_delivery)
    gc = section(texts["gateway_config"], "`alert_delivery`", 2)
    rows = table(gc, "Key")
    keys = {ticks(r[0])[0]: r for r in rows}
    m["cfg_keys"] = list(keys)
    m["cfg_default_max"] = int(ticks(keys["max_records_per_device"][2])[0])
    g = one(r"^(\d+) to (\d+)\.", keys["max_records_per_device"][4], "max_records range")
    m["cfg_range"] = (int(g.group(1)), int(g.group(2)))
    m["cfg_enabled_default"] = ticks(keys["enabled"][2])[0]
    items = numbered(gc)
    m["cfg_rules"] = [re.match(r"`(\w+)`:", it).group(1) for it in items]
    m["cfg_items"] = items
    kinds = (("type", "`enabled` is not a boolean, `queue_directory` is not a string, or `max_records_per_device` is not an integer, each by the type the configuration document itself gives the value. A loader never coerces one"),
             ("required", "`queue_directory` is absent or empty"),
             ("absolute", "it does not begin with `/`"),
             ("separate", "the state directory, `evidence.queue_directory` or `evidence.return_queue_directory`"),
             ("range", "is not from "))
    m["cfg_order"] = []
    for name, it in zip(m["cfg_rules"], items):
        ks = [k for k, want in kinds if want in it]
        if len(ks) != 1:
            raise Failure(f"text: config rule not recognised: {it!r}")
        m["cfg_order"].append((name, ks[0]))
    if sorted(k for _, k in m["cfg_order"]) != sorted(k for k, _ in kinds):
        raise Failure(f"text: config rules changed: {m['cfg_order']}")
    rng = items[[k for _, k in m["cfg_order"]].index("range")]
    g = one(r"is not from (\d+) to (\d+)", rng, "range rule")
    if (int(g.group(1)), int(g.group(2))) != m["cfg_range"]:
        raise Failure("text: the range rule and the table disagree")
    typ = items[[k for _, k in m["cfg_order"]].index("type")]
    if "`enabled` is judged whenever the section is present; the other two only when `enabled` is true" not in typ \
            or "and so is an explicit `null`, which is no value of any of those types. A key that is absent takes its default and is not judged here." not in typ:
        raise Failure("text: the type rule's scope changed")

    # gateway-api/v2 payload size
    g = one(r"\| `ori/\{device_id\}/runtime/alert-delivery` \| Runtime -> Gateway \| (\d+) \|", texts["gateway_api"], "payload size")
    m["payload_max"] = int(g.group(1))
    return m


# ---------------------------------------------------------------------------
# Ed25519: this script's own arithmetic, from ed25519-key-admission/v1 and
# ed25519-verification/v1, cross-checked against OpenSSL via `cryptography`.
# ---------------------------------------------------------------------------

Q = 2 ** 255 - 19
ORDER = 2 ** 252 + 27742317777372353535851937790883648493
CURVE_D = (-121665 * pow(121666, Q - 2, Q)) % Q
I_SQRT = pow(2, (Q - 1) // 4, Q)
ZERO_PT = (0, 1, 1, 0)


def pt_add(a: tuple, b: tuple) -> tuple:
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    p1 = (y1 - x1) * (y2 - x2) % Q
    p2 = (y1 + x1) * (y2 + x2) % Q
    p3 = t1 * 2 * CURVE_D * t2 % Q
    p4 = z1 * 2 * z2 % Q
    e, f, g, h = p2 - p1, p4 - p3, p4 + p3, p2 + p1
    return (e * f % Q, g * h % Q, f * g % Q, e * h % Q)


def pt_mul(n: int, pt: tuple) -> tuple:
    out = ZERO_PT
    while n > 0:
        if n & 1:
            out = pt_add(out, pt)
        pt = pt_add(pt, pt)
        n >>= 1
    return out


def pt_is_zero(pt: tuple) -> bool:
    return pt[0] % Q == 0 and (pt[1] - pt[2]) % Q == 0


def pt_bytes(pt: tuple) -> bytes:
    zi = pow(pt[2], Q - 2, Q)
    x, y = pt[0] * zi % Q, pt[1] * zi % Q
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def pt_from(raw: bytes) -> tuple[str | None, tuple | None]:
    v = int.from_bytes(raw, "little")
    sign, y = v >> 255, v & ((1 << 255) - 1)
    if y >= Q:
        return "non_canonical", None
    u = (y * y - 1) % Q
    w = (CURVE_D * y * y + 1) % Q
    xx = u * pow(w, Q - 2, Q) % Q
    x = pow(xx, (Q + 3) // 8, Q)
    if (x * x - xx) % Q != 0:
        x = x * I_SQRT % Q
    if (x * x - xx) % Q != 0:
        return "off_curve", None
    if x == 0 and sign == 1:
        return "invalid_sign", None
    if x & 1 != sign:
        x = Q - x
    return None, (x, y, 1, x * y % Q)


G = pt_from((4 * pow(5, Q - 2, Q) % Q).to_bytes(32, "little"))[1]


@functools.lru_cache(maxsize=None)
def admit(raw: bytes) -> str | None:
    if len(raw) != 32:
        return "length"
    why, pt = pt_from(raw)
    if why:
        return why
    if pt_is_zero(pt_mul(8, pt)):
        return "small_order"
    if not pt_is_zero(pt_mul(ORDER, pt)):
        return "mixed_order"
    return None


def mine_verify(pub: bytes, msg: bytes, sig: bytes) -> bool:
    if admit(pub) or len(sig) != 64:
        return False
    s = int.from_bytes(sig[32:], "little")
    if s >= ORDER:
        return False
    r = sig[:32]
    if pt_from(r)[0]:
        return False
    a = pt_from(pub)[1]
    k = int.from_bytes(hashlib.sha512(r + pub + msg).digest(), "little")
    minus_a = ((-a[0]) % Q, a[1], a[2], (-a[3]) % Q)
    return pt_bytes(pt_add(pt_mul(s, G), pt_mul(k, minus_a))) == r


def openssl_verify(pub: bytes, msg: bytes, sig: bytes) -> bool:
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
    try:
        Ed25519PublicKey.from_public_bytes(pub).verify(sig, msg)
        return True
    except (InvalidSignature, ValueError):
        return False


@functools.lru_cache(maxsize=None)
def ed_verify(pub: bytes, msg: bytes, sig: bytes) -> bool:
    """ed25519-verification/v1 behind ed25519-key-admission/v1; both verifiers must agree."""
    if admit(pub):
        return False
    a, b = mine_verify(pub, msg, sig), openssl_verify(pub, msg, sig)
    if a != b:
        raise Failure(f"verifiers disagree under {pub.hex()}: own {a}, OpenSSL {b}")
    return a


def seed_public(seed: bytes) -> bytes:
    h = hashlib.sha512(seed).digest()
    s = int.from_bytes(h[:32], "little")
    s = (s & ((1 << 254) - 8)) | (1 << 254)
    return pt_bytes(pt_mul(s, G))


def openssl_public(seed: bytes) -> bytes:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
    return Ed25519PrivateKey.from_private_bytes(seed).public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)


def openssl_spki(seed: bytes) -> bytes:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
    return Ed25519PrivateKey.from_private_bytes(seed).public_key().public_bytes(Encoding.DER, PublicFormat.SubjectPublicKeyInfo)


def key_identity_of(raw: bytes, model: dict) -> str:
    return "sha256:" + hashlib.sha256(model["spki_prefix"] + raw).hexdigest()


def recognised(raw: bytes) -> bytes:
    return raw[:31] + bytes([raw[31] & 0x7F])


def b64_exact(s: object, n: int) -> bytes | None:
    """Canonical padded RFC 4648 Base64 of exactly n bytes, or None."""
    if not isinstance(s, str) or not re.fullmatch(r"[A-Za-z0-9+/]*={0,2}", s) or len(s) % 4:
        return None
    try:
        raw = base64.b64decode(s, validate=True)
    except ValueError:
        return None
    if len(raw) != n or base64.b64encode(raw).decode("ascii") != s:
        return None
    return raw


# ---------------------------------------------------------------------------
# JSON: a strict reader that keeps number tokens and reports duplicate names,
# and the canonical form of gateway-mqtt-canonical-json/v1.
# ---------------------------------------------------------------------------

class Tok:
    __slots__ = ("text",)

    def __init__(self, text: str):
        self.text = text

    def __eq__(self, other: object) -> bool:
        return isinstance(other, Tok) and other.text == self.text

    def __hash__(self) -> int:
        return hash(("tok", self.text))

    def __repr__(self) -> str:
        return f"Tok({self.text})"


class BadJSON(Exception):
    pass


class JReader:
    WS = " \t\n\r"

    def __init__(self, s: str):
        self.s, self.i = s, 0
        self.dupes = False

    def ws(self) -> None:
        while self.i < len(self.s) and self.s[self.i] in self.WS:
            self.i += 1

    def value(self, depth: int) -> object:
        if depth > 32:
            raise BadJSON("nesting")
        self.ws()
        if self.i >= len(self.s):
            raise BadJSON("end")
        c = self.s[self.i]
        if c == "{":
            self.i += 1
            out: dict = {}
            self.ws()
            if self.s[self.i:self.i + 1] == "}":
                self.i += 1
                return out
            while True:
                self.ws()
                k = self.string()
                self.ws()
                if self.s[self.i:self.i + 1] != ":":
                    raise BadJSON("colon")
                self.i += 1
                v = self.value(depth + 1)
                if k in out:
                    self.dupes = True
                out[k] = v
                self.ws()
                c = self.s[self.i:self.i + 1]
                self.i += 1
                if c == "}":
                    return out
                if c != ",":
                    raise BadJSON("object")
        if c == "[":
            self.i += 1
            arr: list = []
            self.ws()
            if self.s[self.i:self.i + 1] == "]":
                self.i += 1
                return arr
            while True:
                arr.append(self.value(depth + 1))
                self.ws()
                c = self.s[self.i:self.i + 1]
                self.i += 1
                if c == "]":
                    return arr
                if c != ",":
                    raise BadJSON("array")
        if c == '"':
            return self.string()
        for word, val in (("true", True), ("false", False), ("null", None)):
            if self.s.startswith(word, self.i):
                self.i += len(word)
                return val
        m = re.compile(r"-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?").match(self.s, self.i)
        if not m or not m.group(0) or m.group(0) == "-":
            raise BadJSON("value")
        self.i = m.end()
        return Tok(m.group(0))

    def string(self) -> str:
        if self.s[self.i:self.i + 1] != '"':
            raise BadJSON("string")
        self.i += 1
        out = []
        while True:
            if self.i >= len(self.s):
                raise BadJSON("unterminated")
            c = self.s[self.i]
            if c == '"':
                self.i += 1
                return "".join(out)
            if ord(c) < 0x20:
                raise BadJSON("control")
            if c == "\\":
                e = self.s[self.i + 1:self.i + 2]
                simple = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
                if e in simple:
                    out.append(simple[e])
                    self.i += 2
                    continue
                if e == "u":
                    h = self.s[self.i + 2:self.i + 6]
                    if not re.fullmatch(r"[0-9a-fA-F]{4}", h):
                        raise BadJSON("escape")
                    cp = int(h, 16)
                    self.i += 6
                    if 0xD800 <= cp <= 0xDBFF:
                        h2 = self.s[self.i:self.i + 6]
                        if re.fullmatch(r"\\u[dD][c-fC-F][0-9a-fA-F]{2}", h2):
                            cp = 0x10000 + ((cp - 0xD800) << 10) + (int(h2[2:], 16) - 0xDC00)
                            self.i += 6
                        else:
                            raise BadJSON("lone surrogate")
                    elif 0xDC00 <= cp <= 0xDFFF:
                        raise BadJSON("lone surrogate")
                    out.append(chr(cp))
                    continue
                raise BadJSON("escape")
            out.append(c)
            self.i += 1


def parse_payload(raw: bytes) -> tuple[str | None, object]:
    """gateway-api/v2 checks 1 and 2 as far as this corpus needs them: the
    payload is read only if it passes; returns (refusal, value)."""
    try:
        s = raw.decode("utf-8")
    except UnicodeDecodeError:
        return "invalid_unicode", None
    r = JReader(s)
    try:
        v = r.value(1)
    except BadJSON as e:
        return f"json:{e}", None
    except IndexError:
        return "json:end", None
    r.ws()
    if r.i != len(s):
        return "trailing_data", None
    if r.dupes:
        return "duplicate_member", None
    if not isinstance(v, dict):
        return "not_an_object", None
    fold = [k.lower().replace("ſ", "s").replace("K", "k") for k in v]
    if len(set(fold)) != len(fold):
        return "case_variant_member", None
    return None, v


def canon_str(s: str) -> str:
    out = ['"']
    short = {'"': '\\"', "\\": "\\\\", "\b": "\\b", "\f": "\\f", "\n": "\\n", "\r": "\\r", "\t": "\\t"}
    for ch in s:
        if ch in short:
            out.append(short[ch])
        elif ord(ch) < 0x20:
            out.append("\\u%04x" % ord(ch))
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def canon(v: object) -> str:
    if v is None:
        return "null"
    if v is True:
        return "true"
    if v is False:
        return "false"
    if isinstance(v, Tok):
        return v.text
    if isinstance(v, int):
        return str(v)
    if isinstance(v, str):
        return canon_str(v)
    if isinstance(v, list):
        return "[" + ",".join(canon(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{" + ",".join(canon_str(k) + ":" + canon(v[k]) for k in sorted(v)) + "}"
    raise Failure(f"canon: {type(v)}")


def canon_bytes(v: object) -> bytes:
    return canon(v).encode("utf-8")


# ---------------------------------------------------------------------------
# Record judges. `mut` names a deliberately wrong rule (see JUDGE_MUTANTS).
# ---------------------------------------------------------------------------

def full(pattern: str, v: object, mut: frozenset, name: str) -> bool:
    if not isinstance(v, str):
        return False
    body = pattern[1:-1] if pattern.startswith("^") and pattern.endswith("$") else pattern
    if f"loose_pattern:{name}" in mut:
        body = body.replace("{1,128}", "{1,129}").replace("{16,64}", "{15,65}").replace("{0,31}", "{0,32}")
        body = body.replace("[A-Za-z0-9._-]", "[A-Za-z0-9._:-]").replace("[A-Za-z0-9_-]", "[A-Za-z0-9_.-]")
        body = body.replace("(0[1-9]|1[0-2])", "(0[0-9]|1[0-2])").replace("^[a-z]", "^[a-z0-9]")
        body = body.replace("[a-z][a-z0-9_]", "[a-z0-9_][a-z0-9_]")
    if f"loose_pattern:{name}" in mut:
        body = body.replace("{64}", "{63,65}").replace("{16,32}", "{16,33}")
    if "dollar_pattern" in mut:
        return re.match(pattern, v) is not None
    return re.fullmatch(body, v) is not None


def int_ok(v: object, lo: int, hi: int, model: dict, mut: frozenset) -> bool:
    if not isinstance(v, Tok):
        return "int_bool_ok" in mut and isinstance(v, bool)
    t = v.text
    if not re.fullmatch(r"0|[1-9][0-9]*", t):
        if "int_spelling_ok" in mut and re.fullmatch(r"[0-9]+(\.0+)?(e0)?", t):
            t = str(int(float(t)))
        else:
            return False
    n = int(t)
    if "int_no_max" in mut:
        hi = 2 ** 64
    if "int_no_min" in mut:
        lo = 0
    return lo <= n <= hi


STRING_MEMBERS = ("kind", "device_id", "key_identity", "alert_id", "notice", "class", "channel",
                  "delivery_attempt_id", "prior_outcome", "outcome", "detail", "reason", "month", "signature")


def num_as_str(obj: dict, names: tuple) -> dict:
    """A wrong reader's view: a JSON number token taken as the string of its digits."""
    return {k: (v.text if isinstance(v, Tok) and k in names else v) for k, v in obj.items()}


def form_faults(obj: dict, model: dict, mut: frozenset) -> list[str]:
    """Check 4 of Carriage and custody: every way the object is not a record."""
    f: list[str] = []
    if "num_as_str_record" in mut:
        obj = num_as_str(obj, STRING_MEMBERS)
    kind = obj.get("kind")
    if kind == model["kind_submission"]:
        want = model["submission_members"]
    elif kind == model["kind_tally"]:
        want = model["tally_members"]
    else:
        return ["kind"]
    have = set(obj)
    if "members_extra_ok" in mut:
        missing = set(want) - have
        if missing:
            f.append(f"members:{sorted(missing)}")
    elif have != set(want):
        f.append(f"members:{sorted(have ^ set(want))}")
    P = model["patterns"]
    lo, hi = model["int_min"], model["int_max"]

    def chk(name: str, ok: bool) -> None:
        if name in obj and not ok and f"skip_form:{name}" not in mut:
            f.append(name)

    g = obj.get
    chk("v", int_ok(g("v"), model["v"], model["v"], model, mut) or ("v_any" in mut and int_ok(g("v"), lo, hi, model, mut)))
    chk("device_id", full(P["device_id"], g("device_id"), mut, "device_id"))
    chk("key_identity", full(model["key_identity_re"], g("key_identity"), mut, "key_identity"))
    chk("class", g("class") is None or full(P["class"], g("class"), mut, "class"))
    chk("channel", g("channel") in model["channels"])
    chk("issued_at_ms", int_ok(g("issued_at_ms"), lo, hi, model, mut))
    chk("signature", b64_exact(g("signature"), 64) is not None or ("sig_form_loose" in mut and isinstance(g("signature"), str)))
    if kind == model["kind_submission"]:
        chk("alert_id", full(P["alert_id"], g("alert_id"), mut, "alert_id"))
        chk("delivery_attempt_id", full(P["delivery_attempt_id"], g("delivery_attempt_id"), mut, "delivery_attempt_id"))
        chk("notice", g("notice") in model["notices"])
        chk("attempt_seq", int_ok(g("attempt_seq"), model["attempt_seq_min"], hi, model, mut))
        chk("attempted_at_ms", int_ok(g("attempted_at_ms"), lo, hi, model, mut))
        seqs = model["obs_seqs"]
        chk("observation_seq", int_ok(g("observation_seq"), min(seqs), max(seqs) + (1 if "obs_seq_4" in mut else 0), model, mut))
        outs = model["outcome_members"]
        if "outcome_open" in mut:
            chk("outcome", isinstance(g("outcome"), str))
        else:
            chk("outcome", g("outcome") in outs)
        chk("prior_outcome", g("prior_outcome") in model["prior_vocab"] or ("prior_open" in mut and isinstance(g("prior_outcome"), str)))
        d = g("detail")
        chk("detail", d is None or d in model["detail_codes"] or ("detail_open" in mut and isinstance(d, str)))
    else:
        chk("reason", g("reason") in model["tally_reasons"])
        chk("month", full(P["month"], g("month"), mut, "month"))
        chk("count", int_ok(g("count"), model["count_min"], model["count_max"], model, mut))
    return f


def rule5_faults(obj: dict, model: dict, mut: frozenset) -> list[str]:
    """Receiver check 5, every rule that fails, in the order check 5 names its reasons."""
    out: dict[str, bool] = {}
    if obj.get("kind") == model["kind_submission"]:
        oc, pr, seq, det = obj.get("outcome"), obj.get("prior_outcome"), obj.get("observation_seq"), obj.get("detail")
        seqn = int(seq.text) if isinstance(seq, Tok) and re.fullmatch(r"[0-9]+", seq.text) else None
        rows = model["obs_table"]
        if "transition_any_seq" in mut:
            ok = any(p == pr and oc in perm for _, p, perm, _ in rows)
        elif "transition_any_prior" in mut:
            ok = any(s == seqn and oc in perm for s, _, perm, _ in rows)
        else:
            ok = any(s == seqn and p == pr and oc in perm for s, p, perm, _ in rows)
        if "after_failed_ok" in mut and pr == model["ends"]:
            ok = True
        out[model["transition_refused"]] = not ok and "no_transition_rule" not in mut
        cls_bad = obj.get("notice") in model["mandatory"] and obj.get("class") is not None
        if "class_any_mandatory_ok" in mut:
            cls_bad = False
        if "class_optional_null_refused" in mut:
            cls_bad = cls_bad or (obj.get("notice") not in model["mandatory"] and obj.get("class") is None)
        out[model["class_refused"]] = cls_bad
        table = model["detail_table"]
        if "detail_any_outcome" in mut:
            allowed = {c for cs in table.values() for c in cs}
        else:
            allowed = set(table.get(oc, []))
        bad = det not in allowed
        code, prior_needed = model["detail_prior_only"]
        if det == code and pr != prior_needed and "detail_prior_any" not in mut:
            bad = True
        if pr == prior_needed and det not in (code, None) and "detail_after_accepted_any" not in mut:
            bad = True
        if "no_detail_rule" in mut:
            bad = False
        out[model["detail_refused"]] = bad
    else:
        bad = obj.get("reason") == model["class_needs"] and obj.get("class") is None
        if "tally_class_ok" in mut:
            bad = False
        if "tally_capped_needs_class" in mut and obj.get("class") is None:
            bad = True
        out[model["class_refused"]] = bad
    order = list(model["rx5"])
    if "rx5_reversed" in mut:
        order.reverse()
    return [r for r in order if out.get(r)]


def signing_input(obj: dict, model: dict, mut: frozenset) -> bytes:
    body = {k: v for k, v in obj.items() if k != "signature"}
    if "sign_with_signature" in mut:
        body = dict(obj)
    prefix = model["record_prefix"]
    if "no_prefix" in mut:
        prefix = b""
    return prefix + canon_bytes(body)


class Ctx:
    """One case's fixture: the gateway's configuration and topic, and the
    receiver's forwarding registry and enrolment registry."""

    def __init__(self, configured: list[str], topic_device: str, forwarder: str = "",
                 registry: dict | None = None, enrolments: list | None = None,
                 keyring: dict[str, bytes] | None = None):
        self.configured = configured
        self.topic_device = topic_device
        self.forwarder = forwarder
        self.registry = registry or {}
        self.enrolments = enrolments or []   # (device_id, public key, purpose)
        self.keyring = keyring or {}         # key_identity -> public key of every disclosed test key


def gateway_faults(raw: bytes, ctx: Ctx, model: dict, mut: frozenset) -> tuple[list[str], dict | None]:
    """Every failing gateway check from 1 to 6, in order (precedence list),
    and the parsed object when there is one."""
    f: list[str] = []
    if len(raw) > model["payload_max"]:
        return ["payload_too_large"], None
    why, obj = parse_payload(raw)
    if why:
        return [why], None
    def unsupported() -> bool:
        v = obj.get("v")
        if "unsupported_as_malformed" in mut or not isinstance(v, Tok):
            return False
        if "unsupported_any_json_integer" in mut:
            return re.fullmatch(r"-?(0|[1-9][0-9]*)", v.text) is not None and v.text != str(model["v"])
        return int_ok(v, model["int_min"], model["int_max"], model, mut) and v.text != str(model["v"])

    checks: list[tuple[int, Callable[[], bool]]] = [
        (3, lambda: canon_bytes(obj) != raw),
        (40, unsupported),
        (4, lambda: bool(form_faults(obj, model, mut))),
        (5, lambda: ctx.topic_device not in ctx.configured),
        (6, lambda: obj.get("device_id") != ctx.topic_device),
    ]
    if "gw_swap_3_4" in mut:
        checks[0], checks[1] = checks[1], checks[0]
    if "gw_swap_4_6" in mut:
        checks[1], checks[3] = checks[3], checks[1]
    for n, c in checks:
        if f"gw_drop_{n}" in mut:
            continue
        if n == 4 and model["gw_unsupported"] in f:
            # check 4 names one reason; a second fault behind unsupported_version
            # is any form fault other than v's own
            if form_faults(obj, model, mut | {"skip_form:v"}):
                f.append(model["gw_reason"][4])
            continue
        if c():
            f.append(model["gw_unsupported"] if n == 40 else model["gw_reason"][n])
    return f, obj


def receiver_faults(raw: bytes, obj: dict, ctx: Ctx, model: dict, mut: frozenset) -> tuple[list[str], bytes | None]:
    """Every failing receiver rule of checks 2 to 5, in order, and the
    enrolled key that verified the record when it passed checks 3 and 4."""
    f: list[str] = []
    dev, ki = obj.get("device_id"), obj.get("key_identity")
    pubs = [en for en in ctx.enrolments
            if (en[0] == dev or "enrol_any_device" in mut)
            and (en[2] == model["enrol_purpose"] or "enrol_any_purpose_rx" in mut)]
    match = [en for en in pubs if key_identity_of(en[1], model) == ki
             or ("enrol_by_recognised" in mut and ki in ctx.keyring and recognised(ctx.keyring[ki]) == recognised(en[1]))]
    pairs = ctx.registry.get(ctx.forwarder, [])
    if "revoked_not_held" in mut:
        match = [en for en in match if not en[6]]
    if match and "owner_ignored" not in mut:
        owner = match[0][3]
        if "owner_current" in mut:
            mine = [en for en in ctx.enrolments if en[0] == dev]
            owner = max(mine, key=lambda en: en[5])[3]
        owned = (dev, owner) in pairs
    else:
        owned = isinstance(dev, str) and any(d == dev for d, _ in pairs)
    if not owned and "rx_drop:2" not in mut:
        f.append(model["rx_reasons"][2][0])
    lineage = (dev, match[0][4]) if match else None
    match_rows = match
    match = [en[1] for en in match]
    bound = bool(match)
    # Check 4 is judged under the enrolled key the record names; for a record
    # already refused at check 3 it is judged under the test key the record
    # names, so that a case refused at check 3 "alone" is one whose signature
    # is otherwise good.
    pub = match[0] if bound else ctx.keyring.get(ki) if isinstance(ki, str) else None
    if "enrol_by_recognised" in mut and bound and isinstance(ki, str) and ki in ctx.keyring:
        pub = ctx.keyring[ki]
    revoked = bound and match_rows[0][6]
    r3 = model["rx_reasons"][3][0]
    if revoked:
        r3 = model["rx_reasons"][3][0] if "revoked_as_not_enrolled" in mut else model["rx_reasons"][3][1]
    steps: list[tuple[str, Callable[[], bool]]] = [
        (r3, lambda: not bound or revoked),
        (model["rx_reasons"][4][0], lambda: not sig_ok(obj, pub, model, mut)),
    ]
    if "rx_swap_3_4" in mut:
        steps.reverse()
    for name, c in steps:
        if f"rx_drop:{name}" in mut:
            continue
        if c():
            f.append(name)
    if "rx_drop:5" not in mut:
        f += rule5_faults(obj, model, mut)
    return f, ((pub, lineage) if bound else None)


def sig_ok(obj: dict, pub: bytes | None, model: dict, mut: frozenset) -> bool:
    if "no_signature_check" in mut:
        return True
    if pub is None:
        return False
    sig = b64_exact(obj.get("signature"), 64)
    if sig is None:
        return False
    try:
        msg = signing_input(obj, model, mut)
    except Failure:
        return False
    return ed_verify(pub, msg, sig)


# ---------------------------------------------------------------------------
# Receiver check 6 and the reading (Consistency across records, Withholding
# tallies, Reading a notice).
# ---------------------------------------------------------------------------

ATTEMPT_FIELDS = ["device_id", "key_identity", "alert_id", "notice", "class", "channel", "attempt_seq", "attempted_at_ms"]


class Receiver:
    """What a receiver holds after check 5: every verified record it kept
    (held, or conflict kept beside the record it conflicts with), and for
    each tally key and epoch the record with the greatest count."""

    def __init__(self) -> None:
        self.kept: list[tuple[bytes, dict, bytes, str]] = []  # (raw, obj, epoch, verdict)
        self.tallies: dict[tuple, tuple[bytes, dict]] = {}
        self.unsettled_alerts: set[tuple] = set()
        self.unsettled_tallies: set[tuple] = set()

    def judge(self, raw: bytes, obj: dict, epoch: bytes, model: dict, mut: frozenset, lineage: tuple = ()) -> str:
        dup, conflict, lower = model["rx6"]
        # A record held as conflict is never the earlier record a later one is
        # judged against, for duplicate as for the rest.
        dup_pool = self.kept if "dup_stored_only" not in mut else [k for k in self.kept if k[3] != conflict]
        if "no_duplicate" not in mut and any(k[0] == raw for k in dup_pool):
            return dup
        pool = [k for k in self.kept if k[3] != conflict or "conflicts_in_pool" in mut]
        if obj["kind"] == model["kind_submission"]:
            other = self._submission(raw, obj, epoch, pool, model, mut, lineage)
            if other is not None:
                self.unsettled_alerts.add((lineage, obj["alert_id"]))
                self.unsettled_alerts.add((other[4], other[1]["alert_id"]))
                v = conflict
            else:
                v = model["stored"]
        else:
            v = self._tally(raw, obj, epoch, model, mut) or model["stored"]
        if v not in (lower, dup):
            self.kept.append((raw, obj, epoch, v, lineage))
        return v

    def _submission(self, raw, obj, epoch, pool, model, mut, lineage=()):
        """The kept record this one conflicts with, or None. Every rule,
        identity included, holds within one device and one lineage."""
        seq = int(obj["observation_seq"].text)
        scope = model["consistency_scope"]
        ident = model["obs_identity"]
        for k in pool:
            r, o, e, _, lin = k
            if o["kind"] != model["kind_submission"]:
                continue
            if "identity_without_device" in mut or "no_device_scope" in mut:
                same_lin = (lin[1:] if lin else lin) == (lineage[1:] if lineage else lineage)
            else:
                same_lin = lin == lineage
            if not same_lin and "lineage_ignored" not in mut:
                continue
            # The identity rule is judged on the identity the text names, before
            # and apart from the consistency rules' device scope.
            ids = ident if "identity_without_device" not in mut else [x for x in ident if x != "device_id"]
            if "no_identity_rule" not in mut and all(o.get(x) == obj.get(x) for x in ids) and r != raw:
                return k
            if o.get(scope) != obj.get(scope) and "no_device_scope" not in mut:
                continue
            if "scope_per_epoch" in mut and e != epoch:
                continue
            same_attempt = o["delivery_attempt_id"] == obj["delivery_attempt_id"]
            if same_attempt and "no_attempt_fields_rule" not in mut:
                fields = list(model["attempt_fields"])
                if "attempt_fields_short" in mut:
                    fields = fields[:-2]
                if "attempt_fields_with_key" in mut:
                    fields.append("key_identity")
                if any(o.get(fl) != obj.get(fl) for fl in fields):
                    return k
            if o["alert_id"] == obj["alert_id"] and "no_alert_rule" not in mut:
                if o["notice"] != obj["notice"] or o["class"] != obj["class"]:
                    return k
            if (e == epoch or "attempt_seq_per_epoch" not in mut) and o["attempt_seq"] == obj["attempt_seq"] \
                    and not same_attempt and "no_attempt_seq_rule" not in mut:
                return k
            if same_attempt and "no_prior_rule" not in mut:
                oseq = int(o["observation_seq"].text)
                if oseq == seq - 1 and o["outcome"] != obj["prior_outcome"]:
                    return k
                if oseq == seq + 1 and o["prior_outcome"] != obj["outcome"] and "prior_one_way" not in mut:
                    return k
        return None

    def tally_key(self, obj: dict, epoch: bytes, mut: frozenset) -> tuple:
        key = (epoch if "tally_no_epoch" not in mut else b"", obj["device_id"], obj["channel"], obj["class"], obj["reason"], obj["month"])
        if "tally_key_no_class" in mut:
            key = key[:3] + key[4:]
        return key

    def _tally(self, raw, obj, epoch, model, mut) -> str | None:
        dup, conflict, lower = model["rx6"]
        key = self.tally_key(obj, epoch, mut)
        held = self.tallies.get(key)
        n = int(obj["count"].text)
        stored = [o for r, o, e, v, _ in self.kept if v == model["stored"] and o["kind"] == model["kind_tally"]
                  and self.tally_key(o, e, mut) == key]
        if "tally_conflict_greatest_only" in mut:
            stored = [held[1]] if held is not None else []
        if "no_tally_conflict" not in mut and any(int(o["count"].text) == n for o in stored):
            self.unsettled_tallies.add(key)
            return conflict
        if held is not None:
            hn = int(held[1]["count"].text)
            if n < hn and "no_lower_count" not in mut:
                return lower
        if held is None or n > int(held[1]["count"].text) or "tally_last_wins" in mut:
            self.tallies[key] = (raw, obj)
        return None

    def reading(self, model: dict, mut: frozenset) -> list[dict]:
        """Reading a notice, per device_id and alert_id, from the records held
        as stored; a notice with a record held as conflict is unsettled."""
        per: dict[tuple, list] = {}
        for _, o, e, v, lin in self.kept:
            if o["kind"] != model["kind_submission"]:
                continue
            if v != model["stored"] and "reading_with_conflicts" not in mut:
                continue
            if "reading_per_epoch" in mut:
                lin = (o["device_id"], e)
            elif "lineage_ignored" in mut:
                lin = (o["device_id"], 1)
            key = (lin, o["alert_id"])
            per.setdefault(key, []).append(o)
        out = []
        for (d, a), obs in per.items():
            chans: dict = {}
            for ch in sorted({o["channel"] for o in obs}):
                on = [o for o in obs if o["channel"] == ch or "channels_merged" in mut]
                if "latest_by_issued" in mut:
                    top = max(int(o["issued_at_ms"].text) for o in on)
                    latest = [o for o in on if int(o["issued_at_ms"].text) == top]
                elif "latest_by_arrival" in mut:
                    latest = [on[-1]]
                else:
                    top = max(int(o["attempt_seq"].text) for o in on)
                    latest = [o for o in on if int(o["attempt_seq"].text) == top]
                pick = min if "latest_first_obs" in mut else max
                st = pick(latest, key=lambda o: int(o["observation_seq"].text))["outcome"]
                pool = latest if "ever_latest_only" in mut else on
                ever = any(o["outcome"] == "accepted" for o in pool)
                chans[ch] = {"latest_attempt_state": st, "ever_accepted": ever}
            some = any(c["ever_accepted"] for c in chans.values())
            if "some_channel_sms_only" in mut:
                some = chans.get("sms", {}).get("ever_accepted", False)
            out.append({"device_id": d[0], "lineage": d[1], "alert_id": a, "channels": chans, "accepted_on_some_channel": some,
                        "settled": (d, a) not in self.unsettled_alerts or "settled_always" in mut})
        return out


# ---------------------------------------------------------------------------
# Gateway custody (check 7) and the acknowledgement.
# ---------------------------------------------------------------------------

class Custody:
    def __init__(self, configured: list[str], max_per_device: int, available: bool = True):
        self.configured = configured
        self.max = max_per_device
        self.available = available
        self.queue: dict[str, list[str]] = {}
        self._held: dict[str, list] = {}

    def receive(self, topic_device: str, raw: bytes, model: dict, mut: frozenset) -> tuple[str, dict | None]:
        ctx = Ctx(self.configured, topic_device)
        f, obj = gateway_faults(raw, ctx, model, mut)
        digest = "sha256:" + hashlib.sha256(raw).hexdigest()
        q = self.queue.setdefault(topic_device, [])
        if f:
            verdict = f[0]
        elif not self.available and "store_after_replay" not in mut:
            verdict = model["gw_store_unavailable"]
        elif digest in q and "no_replay" not in mut:
            verdict = model["gw_replayed"]
        elif "replay_by_identity" in mut and obj is not None and any(identity_of(o, model) == identity_of(obj, model) for o in self._objs(topic_device)):
            verdict = model["gw_replayed"]
        elif len(q) >= self.max + (1 if "queue_off_by_one" in mut else 0):
            verdict = model["gw_queue_full"]
        else:
            q.append(digest)
            self._held.setdefault(topic_device, []).append(obj)
            verdict = "queued"
        return verdict, self.ack(topic_device, digest, verdict, model, mut)

    def _objs(self, dev: str) -> list:
        return self._held.get(dev, [])

    def ack(self, dev: str, digest: str, verdict: str, model: dict, mut: frozenset) -> dict | None:
        q_out, replayed, refused, qf, su = model["ack_outcomes"]
        lo, hi = model["ack_from"]
        reasons_acked = [model["gw_reason"][n] for n in range(lo, hi) if n in model["gw_reason"] and n != model["ack_unanswered_check"]]
        reasons_acked.append(model["gw_unsupported"])
        if "ack_unknown_device" in mut:
            reasons_acked.append(model["gw_reason"][5])
        if verdict in ("queued", replayed):
            return {"outcome": q_out, "reason": "", "record_digest": digest, "device_id": dev}
        if verdict in reasons_acked or verdict in (qf, su, model["gw_replayed"]):
            return {"outcome": refused, "reason": verdict, "record_digest": digest, "device_id": dev}
        return None


def identity_of(obj: dict, model: dict) -> tuple:
    if obj.get("kind") == model["kind_submission"]:
        return ("s", obj.get("delivery_attempt_id"), canon(obj.get("observation_seq")))
    return ("t", obj.get("channel"), obj.get("class"), obj.get("reason"), obj.get("month"), canon(obj.get("count")))


# ---------------------------------------------------------------------------
# The enrolment proof (Key trust).
# ---------------------------------------------------------------------------

def enrol_faults(challenge: bytes, sig: bytes | None, issued_nonce: str, consumed: bool,
                 device: str, pub: bytes, model: dict, mut: frozenset,
                 owner: object = None, held: list | None = None) -> tuple[list[str], object]:
    """The enrolment proof's failing checks in order, and, for a pass, the
    held key whose lineage the key joins (None when it begins its own)."""
    held = held or []
    r_malformed, r_nonce, r_device, r_key, r_sig, r_lineage = model["enrol_order"]
    f: list[str] = []
    why, obj = parse_payload(challenge)
    malformed = why is not None
    orig = obj
    if obj is not None and "num_as_str_enrol" in mut:
        obj = num_as_str(obj, ("device_id", "key_identity", "nonce", "purpose", "lineage_origin"))
    if not malformed:
        lo, hi = model["nonce"]
        malformed = (
            canon_bytes(orig) != challenge and "enrol_noncanonical_ok" not in mut
            or sorted(obj) != model["enrol_members"] and not ("enrol_extra_ok" in mut and set(model["enrol_members"]) <= set(obj))
            or not int_ok(obj.get("v"), model["enrol_v"], model["enrol_v"], model, mut)
            or (obj.get("purpose") != model["enrol_purpose"] and "enrol_any_purpose" not in mut)
            or not full(model["patterns"]["device_id"], obj.get("device_id"), mut, "device_id")
            or not full(model["key_identity_re"], obj.get("key_identity"), mut, "key_identity")
            or (not full(model["key_identity_re"], obj.get("lineage_origin"), mut, "lineage_origin") and "enrol_origin_form_any" not in mut)
            or not (full(model["nonce_re"] if "enrol_nonce_odd_ok" not in mut else "^[0-9a-f]{%d,%d}$" % (lo, hi),
                         obj.get("nonce"), mut, "nonce") or "enrol_nonce_form_any" in mut)
        )
    if malformed and "enrol_drop_1" not in mut:
        f.append(r_malformed)
        if obj is None:
            return f, None
    obj = obj or {}
    origin = obj.get("lineage_origin")

    def of_lineage(h: dict) -> bool:
        # the origin is the held key's key_identity or its recorded origin
        return h["key_identity"] == origin or (h["lineage_origin"] == origin and "origin_by_identity_only" not in mut)

    on_device = [h for h in held if (h["device_id"] == device or "origin_any_device" in mut) and of_lineage(h)]
    other_owner = any(h["owner"] != owner for h in on_device) and "origin_other_owner_ok" not in mut
    tests = [
        (r_nonce, obj.get("nonce") != issued_nonce or (consumed and "enrol_reuse_ok" not in mut)),
        (r_device, obj.get("device_id") != device),
        (r_key, obj.get("key_identity") != key_identity_of(pub, model)),
        (r_sig, sig is None or not ed_verify(pub, model["enrol_prefix"] + challenge, sig) if "enrol_no_prefix" not in mut
         else not ed_verify(pub, challenge, sig or b"")),
        (r_lineage, other_owner),
    ]
    if "enrol_lineage_before_signature" in mut:
        tests[3], tests[4] = tests[4], tests[3]
    if "enrol_swap_2_3" in mut:
        tests[0], tests[1] = tests[1], tests[0]
    if "enrol_swap_3_4" in mut:
        tests[1], tests[2] = tests[2], tests[1]
    for name, bad in tests:
        if f"enrol_drop:{name}" in mut:
            continue
        if bad:
            f.append(name)
    joins = None
    same = [h for h in on_device if h["owner"] == owner or "origin_other_owner_ok" in mut]
    if same:
        joins = same[0]["key_identity"]
    if "lineage_join_any_origin" in mut and origin != obj.get("key_identity"):
        joins = origin
    return f, joins


# ---------------------------------------------------------------------------
# gateway-config/v2 `alert_delivery` load rules.
# ---------------------------------------------------------------------------

WHITE_SPACE = set("\u0009\u000a\u000b\u000c\u000d \u0085  "
                  "           "
                  "    　")


def ws_trim(s: str, mut: frozenset) -> str:
    if "trim_python_strip" in mut:
        return s.strip()
    if "no_trim" in mut:
        return s
    i, j = 0, len(s)
    while i < j and s[i] in WHITE_SPACE:
        i += 1
    while j > i and s[j - 1] in WHITE_SPACE:
        j -= 1
    return s[i:j]


def clean(path: str, mut: frozenset) -> list[str]:
    parts: list[str] = []
    for c in path.split("/"):
        if c in ("", "."):
            continue
        if c == ".." and "no_dotdot" not in mut:
            if parts:
                parts.pop()
            continue
        parts.append(c if "fold_case" not in mut else c.lower())
    return parts


def related(a: list[str], b: list[str], mut: frozenset) -> bool:
    if "prefix_by_string" in mut:
        sa, sb = "/" + "/".join(a), "/" + "/".join(b)
        return sa.startswith(sb) or sb.startswith(sa)
    n = min(len(a), len(b))
    if "no_containing" in mut:
        return len(a) >= len(b) and a[:len(b)] == b
    return a[:n] == b[:n]


def load_alert_delivery(cfg: dict, model: dict, mut: frozenset) -> str | None:
    """cfg: {"alert_delivery": {...}, "state_directory": ..., "evidence": {...}};
    returns the refused rule or None."""
    names = {k: n for n, k in model["cfg_order"]}
    ad = cfg.get("alert_delivery")
    if not isinstance(ad, dict):
        return None
    coerce = "num_as_str_config" in mut

    def is_int(v: object) -> bool:
        if isinstance(v, bool):
            return False
        return isinstance(v, int) or ("range_float_ok" in mut and isinstance(v, float) and v == int(v))

    en = ad.get("enabled", False)
    if "enabled" in ad and not isinstance(en, bool) and "type_enabled_unchecked" not in mut:
        return names["type"]
    if en is not True and "validate_disabled" not in mut:
        return None
    qd = ad.get("queue_directory")
    if coerce and isinstance(qd, (int, float)) and not isinstance(qd, bool):
        qd = str(qd)
    mr = ad.get("max_records_per_device", model["cfg_default_max"])

    def typ() -> bool:
        return ("queue_directory" in ad and not isinstance(qd, str)) or \
            ("max_records_per_device" in ad and not is_int(mr))

    tq = ws_trim(qd, mut) if isinstance(qd, str) else None

    def sep() -> bool:
        others = [cfg.get("state_directory")]
        ev = cfg.get("evidence") or {}
        # The state directory counts when present after trimming; the evidence
        # queue directories count while evidence.enabled is true.
        if "sep_evidence_always" in mut or ev.get("enabled") is True:
            others += [ev.get("queue_directory"), ev.get("return_queue_directory")]
        if "sep_no_state_dir" in mut:
            others = others[1:]
        mine = clean(tq, mut)
        for o in others:
            if not isinstance(o, str):
                continue
            o = ws_trim(o, mut)
            if o and related(mine, clean(o, mut), mut):
                return True
        return False

    def rng() -> bool:
        lo, hi = model["cfg_range"]
        if not is_int(mr):
            return False
        return not (lo - (1 if "range_zero_ok" in mut else 0) <= mr <= hi + (1 if "range_high_ok" in mut else 0))

    tests = {"type": typ, "required": lambda: not tq, "absolute": lambda: not tq.startswith("/"),
             "separate": sep, "range": rng}
    order = [k for _, k in model["cfg_order"]]
    if "cfg_swap_2_3" in mut:
        i, j = order.index("absolute"), order.index("separate")
        order[i], order[j] = order[j], order[i]
    if "cfg_type_last" in mut:
        order.remove("type")
        order.append("type")
    for k in order:
        if f"cfg_drop:{names[k]}" in mut:
            continue
        if tests[k]():
            return names[k]
    return None


# ---------------------------------------------------------------------------
# The at-bound records: the greatest length a record of each kind can take
# while passing every rule, computed from the member tables.
# ---------------------------------------------------------------------------

def longest(pattern: str) -> int:
    ms = re.findall(r"\{(\d+),(\d+)\}", pattern)
    if pattern == "^[0-9]{4}-(0[1-9]|1[0-2])$":
        return 7
    if len(ms) != 1:
        raise Failure(f"at-bound: cannot bound {pattern!r}")
    lo, hi = map(int, ms[0])
    fixed = 1 if pattern.startswith("^[a-z][") else 0
    return hi + fixed


def at_bound_lengths(model: dict, mut: frozenset = frozenset()) -> dict[str, int]:
    """For each kind, the maximum canonical length over every admitted
    combination of vocabulary values, every string at its longest and every
    integer at its bound."""
    P = model["patterns"]
    ki = len("sha256:") + 64
    sig = 88
    best: dict[str, int] = {}

    def size(obj: dict) -> int:
        return len(canon_bytes(obj))

    def S(n: int) -> str:
        return "a" * n

    base = {"v": Tok(str(model["v"])), "device_id": S(longest(P["device_id"])), "key_identity": S(ki),
            "issued_at_ms": Tok(str(model["int_max"])), "signature": S(sig)}
    cls = S(longest(P["class"]))
    for notice in model["notices"]:
        for c in (None, cls):
            for ch in model["channels"]:
                for seq, prior, perm, _ in model["obs_table"]:
                    for oc in perm:
                        for d in model["detail_table"][oc]:
                            o = dict(base, kind=model["kind_submission"], alert_id=S(longest(P["alert_id"])),
                                     delivery_attempt_id=S(longest(P["delivery_attempt_id"])), notice=notice,
                                     **{"class": c}, channel=ch, attempt_seq=Tok(str(model["int_max"])),
                                     attempted_at_ms=Tok(str(model["int_max"])), observation_seq=Tok(str(seq)),
                                     prior_outcome=prior, outcome=oc, detail=d)
                            if rule5_faults(o, model, mut):
                                continue
                            best["submission"] = max(best.get("submission", 0), size(o))
                            if notice in model["mandatory"]:
                                best["submission_mandatory"] = max(best.get("submission_mandatory", 0), size(o))
    for ch in model["channels"]:
        for c in (None, cls):
            for rs in model["tally_reasons"]:
                o = dict(base, kind=model["kind_tally"], channel=ch, **{"class": c}, reason=rs,
                         month="9999-12", count=Tok(str(model["int_max"])))
                if rule5_faults(o, model, mut):
                    continue
                best["withheld_tally"] = max(best.get("withheld_tally", 0), size(o))
    return best


# ---------------------------------------------------------------------------
# Text mutants: every pinned sentence cut, and each parsed list, table and
# bound altered in place.
# ---------------------------------------------------------------------------

def _sub(texts: dict[str, str], key: str, old: str, new: str, regex: bool = False) -> dict[str, str] | None:
    t = dict(texts)
    if regex:
        t[key], n = re.subn(old, new, t[key], count=1)
    else:
        n = t[key].count(old)
        t[key] = t[key].replace(old, new, 1)
    return t if n and t[key] != texts[key] else None


def _swap(texts: dict[str, str], key: str, a: str, b: str) -> dict[str, str] | None:
    t = dict(texts)
    s = t[key]
    if a not in s or b not in s:
        return None
    s = s.replace(a, "\x00A\x00", 1).replace(b, a, 1).replace("\x00A\x00", b, 1)
    t[key] = s
    return t


