    "reading_with_conflicts", "reading_per_epoch", "channels_merged", "latest_by_issued", "latest_by_arrival", "latest_first_obs",
    "ever_latest_only", "some_channel_sms_only", "settled_always",
    # custody and acknowledgement
    "no_replay", "replay_by_identity", "queue_off_by_one", "ack_unknown_device",
    # enrolment
    "enrol_noncanonical_ok", "enrol_extra_ok", "enrol_any_purpose", "enrol_nonce_form_any", "enrol_drop_1",
