def text_mutants(texts: dict[str, str]) -> list[tuple[str, dict[str, str] | None]]:
    out: list[tuple[str, dict[str, str] | None]] = []
    for key, sentence in PINS:
        words = sentence.split()
        pattern = r"\s+".join(re.escape(w) for w in words)
        t = dict(texts)
        t[key], n = re.subn(pattern, lambda _m: " ".join(words[:-1]) + " XX", t[key], count=1)
        out.append((f"text cut: {key}: {sentence[:60]}", t if n == 1 else None))
    for label, key, old, new, rx in TEXT_EDITS:
        out.append((f"text edit: {label}", _sub(texts, key, old, new, rx)))
    return out


# ---------------------------------------------------------------------------
# The corpus.
# ---------------------------------------------------------------------------

def pub_of(s: object) -> bytes | None:
    if not isinstance(s, str) or not s.startswith("ed25519:"):
        return None
    return b64_exact(s[len("ed25519:"):], 32)


def keys_of(corpus: dict, model: dict, bad: Callable[[str], None]) -> dict[str, bytes]:
    out: dict[str, bytes] = {}
    tk = corpus.get("test_keys")
    if not isinstance(tk, dict) or not tk:
        bad("test_keys: missing")
        return out
    for name, k in tk.items():
        pub = pub_of(k.get("public_key"))
        if pub is None:
            bad(f"test_keys.{name}: public_key is not ed25519:<canonical Base64 of 32 bytes>")
            continue
        if "seed_label" in k:
            if k["seed_label"] != f"ori alert-delivery/v1 {name} test key":
                bad(f"test_keys.{name}: seed label {k['seed_label']!r} is not the disclosed form")
            seed = hashlib.sha256(k["seed_label"].encode("ascii")).digest()
            mine = seed_public(seed)
            if mine != openssl_public(seed):
                raise Failure(f"test_keys.{name}: own and OpenSSL key derivation disagree")
            if openssl_spki(seed) != model["spki_prefix"] + mine:
                raise Failure(f"test_keys.{name}: OpenSSL SPKI DER is not the pinned prefix and the key")
            if mine != pub:
                bad(f"test_keys.{name}: public_key is not derived from its seed label")
        elif "negation_of" in k:
            base = pub_of((tk.get(k["negation_of"]) or {}).get("public_key"))
            if base is None or pub != base[:31] + bytes([base[31] ^ 0x80]):
                bad(f"test_keys.{name}: not the negation of {k['negation_of']}")
            elif recognised(pub) != recognised(base):
                bad(f"test_keys.{name}: negation does not share a recognised key")
        else:
            bad(f"test_keys.{name}: neither a seed label nor a negation")
        if admit(pub) is not None:
            bad(f"test_keys.{name}: refused by key admission ({admit(pub)})")
        if k.get("key_identity") != key_identity_of(pub, model):
            bad(f"test_keys.{name}: key_identity is not SHA-256 of the SPKI DER")
        out[name] = pub
    return out


def fixture(case: dict, keys: dict[str, bytes], model: dict, bad: Callable[[str], None], where: str,
            mut: frozenset = frozenset()) -> Ctx:
    """The receiver's registries. Each enrolment names a device, a key, a
    purpose, an owner, a revision strictly increasing for the device, whether
    it is revoked, and the lineage origin its proof signed. In revision order,
    an origin that is a key enrolled earlier for the device to the same owner
    joins that key's lineage; any other origin begins a new one. A device's
    lineages are numbered from 1 in the order they begin."""
    enrol = []
    by_dev: dict = {}
    for e in case.get("enrolments", []):
        if e.get("key") not in keys:
            bad(f"{where}: enrolment names unknown key {e.get('key')!r}")
            continue
        if not isinstance(e.get("revoked"), bool):
            bad(f"{where}: enrolment {e.get('key')} revoked is not a boolean")
        if not full(model["key_identity_re"], e.get("lineage_origin"), frozenset(), "key_identity") \
                or not isinstance(e.get("revision"), int) or isinstance(e.get("revision"), bool) \
                or not isinstance(e.get("owner"), str):
            bad(f"{where}: enrolment {e.get('key')} lacks an owner, a revision or a lineage origin")
            continue
        by_dev.setdefault(e.get("device_id"), []).append(e)
    for dev, es in by_dev.items():
        revs = [e["revision"] for e in es]
        if len(set(revs)) != len(revs):
            bad(f"{where}: two enrolments of {dev} share a revision")
        n = 0
        lineage_of: dict[str, tuple] = {}  # key_identity -> (owner, lineage number)
        prev = None
        for e in sorted(es, key=lambda e: e["revision"]):
            ki = key_identity_of(keys[e["key"]], model)
            origin = e["lineage_origin"]
            # held keys whose key_identity or recorded origin is this origin
            held = next((v for k2, v in lineage_of.items()
                         if k2 == origin or (v[2] == origin and "origin_by_identity_only" not in mut)), None)
            if "lineage_by_revision" in mut:
                # the old flag-free reading: a later revision to the same owner
                # continues the one before it, whatever origin it signed
                joins = prev is not None and prev[0] == e["owner"]
                ln = prev[1] if joins else None
            elif held is not None and (held[0] == e["owner"] or "lineage_origin_other_owner_joins" in mut):
                joins, ln = True, held[1]
            else:
                joins, ln = False, None
            if not joins:
                n += 1
                ln = n
            if (e.get("purpose") == model["enrol_purpose"] or "origin_any_purpose" in mut) \
                    and not (e["revoked"] and "revoked_not_held" in mut):
                lineage_of[ki] = (e["owner"], ln, origin)
            prev = (e["owner"], ln)
            if e["revoked"] is not True or "revoked_ok" in mut:
                revoked = False
            else:
                revoked = True
            enrol.append((dev, keys[e["key"]], e.get("purpose"), e["owner"], ln, e["revision"], revoked))
    ring = {key_identity_of(p, model): p for p in keys.values()}
    reg = {}
    for fwd, pairs in (case.get("forwarding_registry") or {}).items():
        reg[fwd] = [(pp.get("device_id"), pp.get("owner")) for pp in pairs]
    return Ctx(case.get("configured_devices", []), case.get("topic_device", ""), case.get("forwarder", ""),
               reg, enrol, ring)


def judge_record(raw: bytes, ctx: Ctx, model: dict, mut: frozenset) -> dict:
    """Gateway verdict at checks 3 to 6 of Carriage and custody; receiver
    verdict at checks 1 to 5 of Verifying, its check 1 being carriage checks
    3, 4 and 6 (it holds no gateway.device_ids); every failing rule, in order;
    and the epoch a passing record verifies in."""
    gw, obj = gateway_faults(raw, ctx, model, mut)
    out = {"obj": obj, "pre": None, "gw": "pass", "rx": "pass", "fails": [], "gw_fails": list(gw),
           "epoch": None, "lineage": None, "form": []}
    too_large = len(raw) > model["rx_bound"] + (1 if "rx_bound_off_by_one" in mut else 0) and "rx_no_bound" not in mut
    if obj is None and gw == ["payload_too_large"]:
        out["gw"] = gw[0]
        out["rx"] = model["rx_too_large"] if too_large else "?"
        out["fails"] = [out["rx"]]
        return out
    if obj is None:
        out["pre"] = gw[0]
        return out
    if too_large:
        out["rx"] = model["rx_too_large"]
        out["fails"] = [out["rx"]]
        if gw:
            out["gw"] = gw[0]
        return out
    if gw:
        out["gw"] = gw[0]
    lo, hi = model["rx_check1"]
    rx1_reasons = {model["gw_reason"][n] for n in range(3, hi + 1) if n in model["gw_reason"]} | {model["gw_unsupported"]}
    if "rx_checks_device_ids" in mut:
        rx1_reasons |= {model["gw_reason"][5], model["gw_reason"][6]}
    if "rx_checks_topic" in mut:
        rx1_reasons.add(model["gw_reason"][6])
    rx1 = [f for f in gw if f in rx1_reasons]
    out["fails"] = list(rx1)
    out["gw_fails"] = list(gw)
    if rx1:
        out["rx"] = rx1[0]
    form = form_faults(obj, model, mut)
    out["form"] = form
    try:
        rx, pub = receiver_faults(raw, obj, ctx, model, mut)
    except (KeyError, AttributeError, TypeError, ValueError):
        rx, pub = [], None
    out["fails"] += rx
    if not rx1 and rx:
        out["rx"] = rx[0]
    if not rx1 and not rx and pub is not None:
        out["epoch"] = recognised(pub[0])
        out["lineage"] = pub[1]
    return out


def entailed(name: str, j: dict, model: dict) -> set[str]:
    """Rules that a record's declared failure itself makes fail, so a case
    "refused for that reason alone" may still fail them."""
    out: set[str] = set()
    sig_r, key_r = model["rx_reasons"][4][0], model["rx_reasons"][3][0]
    form = set(j.get("form") or [])
    if form & {"signature", "kind", "v"} or any(f.startswith("members") for f in form):
        out.add(sig_r)  # a signature over a non-record, or of the wrong form
    if form & {"key_identity", "device_id", "kind"} or any(f.startswith("members") for f in form):
        out |= {key_r, sig_r, model["rx_reasons"][2][0]}
    if form & {"device_id"}:
        out.add(model["gw_reason"][6])
    if not form and j.get("gw") == model["gw_reason"][6]:
        # another device's record: the forwarder's permission and the device's
        # enrolment are both judged against that other device_id
        out |= {key_r, model["rx_reasons"][2][0]}
    if form & {"outcome", "observation_seq", "prior_outcome"}:
        out |= {model["transition_refused"], model["detail_refused"]}
    if form & {"notice", "class"}:
        out.add(model["class_refused"])
    if form & {"detail"}:
        out.add(model["detail_refused"])
    if form & {"reason"}:
        out.add(model["class_refused"])
    return out


ENROL_NOT_ALONE: list[str] = []


class Seen(dict):
    """A corpus object that records which of its members the checker reads.
    Equality reads every member, so a compared expectation is read whole."""

    def __init__(self, *a, **k):
        super().__init__(*a, **k)
        self.read: set = set()

    def __getitem__(self, k):
        self.read.add(k)
        return super().__getitem__(k)

    def get(self, k, default=None):
        self.read.add(k)
        return super().get(k, default)

    def __contains__(self, k):
        self.read.add(k)
        return super().__contains__(k)

    def __iter__(self):
        self.read.update(super().keys())
        return super().__iter__()

    def items(self):
        self.read.update(super().keys())
        return [(k, super(Seen, self).__getitem__(k)) for k in super().keys()]

    def keys(self):
        self.read.update(super().keys())
        return super().keys()

    def values(self):
        return [self[k] for k in super().keys()]

    def _all(self):
        for k in super().keys():
            self.read.add(k)
            v = super().__getitem__(k)
            if isinstance(v, (Seen, SeenList)):
                v._all()

    def __eq__(self, other):
        self._all()
        if isinstance(other, (Seen, SeenList)):
            other._all()
        return dict.__eq__(self, other)

    def __ne__(self, other):
        return not self.__eq__(other)

    __hash__ = None


class SeenList(list):
    def _all(self):
        for v in list.__iter__(self):
            if isinstance(v, (Seen, SeenList)):
                v._all()

    def __eq__(self, other):
        self._all()
        if isinstance(other, (Seen, SeenList)):
            other._all()
        return list.__eq__(self, other)

    def __ne__(self, other):
        return not self.__eq__(other)

    __hash__ = None


def watch(v: object) -> object:
    if isinstance(v, dict):
        return Seen({k: watch(x) for k, x in v.items()})
    if isinstance(v, list):
        return SeenList(watch(x) for x in v)
    return v


# Maps whose keys are data, not members: every key is a name the corpus chooses.
DATA_MAPS = ("forwarding_registry", "channels")


def _walk(v: object, path: tuple, data_map: bool, visit) -> None:
    if isinstance(v, Seen):
        for k in dict.keys(v):
            visit(v, k, path, data_map)
            _walk(dict.__getitem__(v, k), path + ("*" if data_map else k,), k in DATA_MAPS, visit)
    elif isinstance(v, SeenList):
        for x in list.__iter__(v):
            _walk(x, path + ("[]",), False, visit)


def unread(v: object, path: str, out: list[str]) -> None:
    """The corpus schema is closed at every level. The allowed members at each
    place (a case of a section, an entry of a sequence, a nested object) are
    exactly those the checker read at that place in some case of this run; any
    other member is unknown. Keys of a data map (forwarder names, channels) are
    the corpus's own names, and their values are judged the same way."""
    allowed: dict[tuple, set] = {}

    def collect(obj, k, at, data_map):
        if data_map or k in obj.read:
            allowed.setdefault(at, set()).add("*" if data_map else k)

    def judge(obj, k, at, data_map):
        names = allowed.get(at, set())
        if not ("*" in names if data_map else k in names):
            out.append(f"schema: {path}{''.join('.' + x if x != '[]' else x for x in at)}.{k} is a member this checker never reads")

    _walk(v, (), False, collect)
    _walk(v, (), False, judge)


def check(corpus: dict, model: dict, mut: frozenset = frozenset()) -> list[str]:
    errs: list[str] = []
    if not isinstance(corpus, dict):
        return ["fatal: corpus root is not an object"]
    corpus = watch(corpus)
    try:
        _check(corpus, model, mut, errs.append)
        unread(corpus, "corpus", errs)
    except Failure as e:
        errs.append(f"fatal: {e}")
    except (KeyError, TypeError, AttributeError, ValueError, IndexError) as e:
        errs.append(f"fatal: corpus shape: {type(e).__name__}: {e}")
    return errs


def _check(corpus: dict, model: dict, mut: frozenset, bad: Callable[[str], None]) -> None:
    if corpus.get("contract") != "alert-delivery/v1":
        bad("contract: not alert-delivery/v1")

    def notes(obj: object, where: str) -> None:
        if isinstance(obj, dict) and "note" in obj and not isinstance(obj["note"], (str, dict)):
            bad(f"{where}: note is not text")
    notes(corpus, "corpus")
    for k, v in (corpus.get("note") or {}).items():
        if not isinstance(v, str):
            bad(f"note.{k}: not text")
    for sec in ("records", "receiver_sequences", "carriage_sequences", "enrolment", "config"):
        for case in corpus.get(sec, []):
            notes(case, f"{sec}.{case.get('name')}")
    keys = keys_of(corpus, model, bad)
    cov: dict[str, set] = {k: set() for k in (
        "gw_alone", "rx_alone", "outcomes", "rows", "details", "kinds", "delivered", "bound",
        "rx6", "rules", "seq_shapes", "carriage", "enrol_alone", "enrol_pass", "cfg")}
    # The gateway's list at checks 1 and 3 to 6: check 1's Payload Size reason
    # is gateway-api/v2's, the rest this contract's.
    every_reason_gw = ["payload_too_large"] + [model["gw_reason"][n] for n in (3, 4, 5, 6)] + [model["gw_unsupported"]]
    every_reason_rx = [model["rx_too_large"]] + model["rx_reasons"][2] + model["rx_reasons"][3] + model["rx_reasons"][4] + model["rx5"]


    # --- records ---------------------------------------------------------
    bounds = at_bound_lengths(model)
    if bounds.get("submission_mandatory", 0) >= 1024:
        bad(f"bound: a mandatory submission at its bound is {bounds['submission_mandatory']} bytes")
    names = set()
    for case in corpus.get("records", []):
        name = case["name"]
        where = f"records.{name}"
        if name in names:
            bad(f"{where}: duplicate case name")
        names.add(name)
        raw = case["record"].encode("utf-8")
        ctx = fixture(case, keys, model, bad, where, mut)
        j = judge_record(raw, ctx, model, mut)
        if j["pre"]:
            bad(f"{where}: refused at {j['pre']}, outside checks 3, 4 and 6")
            continue
        obj = j["obj"]
        if j["gw"] != case["expected_gateway"]:
            bad(f"{where}: gateway verdict {j['gw']}, corpus says {case['expected_gateway']}")
        if j["rx"] != case["expected_receiver"]:
            bad(f"{where}: receiver verdict {j['rx']}, corpus says {case['expected_receiver']}")
        fails = j["fails"]
        declared = case["expected_receiver"]
        if name.startswith("precedence_"):
            if len(fails) < 2:
                bad(f"{where}: a precedence case with no second failing rule (fails {fails})")
            m = re.fullmatch(r"precedence_(.+)_over_(.+)", name)
            if m and len(fails) >= 2:
                second = m.group(2)
                later = fails[1:] + [f for f in j["gw_fails"][1:] if f not in fails]
                if not any(f.split("_")[0] == second.split("_")[0] for f in later) \
                        and not (second in (j.get("form") or []) and len(fails) >= 2):
                    bad(f"{where}: the rule its name puts second ({second}) does not fail behind {fails[0]} (fails {fails})")
        elif declared != "pass" or case["expected_gateway"] != "pass":
            extra = [f for f in fails[1:] if f not in entailed(name, j, model)]
            if extra:
                bad(f"{where}: refused for {fails[0]} but not alone: also fails {extra}")
            if j["gw"] != "pass":
                cov["gw_alone"].add(j["gw"])
            if j["rx"] != "pass" and (j["gw"] == "pass" or j["rx"] == model["rx_too_large"]):
                cov["rx_alone"].add(j["rx"])
        if obj is not None and obj.get("outcome") == model["reserved_outcome"] and declared != "pass":
            cov["delivered"].add(True)
        if declared == "pass" and j["rx"] == "pass":
            cov["kinds"].add(obj["kind"])
            if obj["kind"] == model["kind_submission"]:
                cov["outcomes"].add(obj["outcome"])
                cov["rows"].add((int(obj["observation_seq"].text), obj["prior_outcome"], obj["outcome"]))
                cov["details"].add((obj["outcome"], obj["detail"]))
            ints = [k for k in ("attempt_seq", "attempted_at_ms", "issued_at_ms", "count") if k in obj]
            at_max = all(obj[k].text == str(model["int_max"]) for k in ints)
            if len(raw) == bounds.get(obj["kind"]) and at_max:
                cov["bound"].add(obj["kind"])
            if obj.get("notice") in model["mandatory"] and len(raw) == bounds["submission_mandatory"] and at_max:
                cov["bound"].add("submission_mandatory")
            if obj.get("notice") in model["mandatory"] and len(raw) > bounds["submission_mandatory"]:
                bad(f"{where}: {len(raw)} bytes, longer than the {bounds['submission_mandatory']} a mandatory submission can be")
            if len(raw) > bounds.get(obj["kind"], 0):
                bad(f"{where}: {len(raw)} bytes, longer than the {bounds.get(obj['kind'])} this checker computes as the bound")
    for r in every_reason_gw:
        if r not in cov["gw_alone"]:
            bad(f"coverage: no record case refused by the gateway for {r} alone")
    for r in every_reason_rx:
        if r not in cov["rx_alone"]:
            bad(f"coverage: no record case refused by the receiver for {r} alone")
    for o in model["outcomes"]:
        if o not in cov["outcomes"]:
            bad(f"coverage: no accepted case with outcome {o}")
    for seq, prior, perm, _ in model["obs_table"]:
        for o in perm:
            if (seq, prior, o) not in cov["rows"]:
                bad(f"coverage: no accepted case for observation row ({seq}, {prior}, {o})")
    for o, codes in model["detail_table"].items():
        for d in codes:
            if (o, d) not in cov["details"]:
                bad(f"coverage: no accepted case with outcome {o} and detail {d}")
    if "submission_mandatory" not in cov["bound"]:
        bad(f"coverage: no accepted mandatory submission at its bound ({bounds.get('submission_mandatory')} bytes)")
    for k in (model["kind_submission"], model["kind_tally"]):
        if k not in cov["kinds"]:
            bad(f"coverage: no accepted {k}")
        if k not in cov["bound"]:
            bad(f"coverage: no accepted {k} at its bound ({bounds.get(k)} bytes, every free integer {model['int_max']})")
        if bounds.get(k, 0) >= 1024:
            bad(f"bound: a {k} at its bound is {bounds.get(k)} bytes, not under the 1024 gateway-api/v2 claims")
    if not cov["delivered"]:
        bad("coverage: no case with outcome delivered refused")

    # --- receiver sequences ----------------------------------------------
    for seq in corpus.get("receiver_sequences", []):
        where = f"receiver_sequences.{seq['name']}"
        ctx = fixture(seq, keys, model, bad, where, mut)
        rcv = Receiver()
        verdicts = []
        epoch_label: dict[bytes, str] = {}
        for i, ev in enumerate(seq["records"]):
            raw = ev["record"].encode("utf-8")
            ctx.topic_device = ev.get("topic_device", "")
            j = judge_record(raw, ctx, model, mut)
            if "rx_volume" in mut and i >= 10:
                # a receiver wrongly spending gateway-api/v2's Payload Volume
                # bucket of 10 records, with no time between arrivals
                j = dict(j, rx="volume_dropped")
            if j["pre"]:
                bad(f"{where}[{i}]: refused at {j['pre']}")
                continue
            if j["rx"] != "pass":
                v = j["rx"]
            elif j["epoch"] is None:
                bad(f"{where}[{i}]: passes checks 1 to 5 with no enrolled key")
                continue
            else:
                epoch_label.setdefault(j["epoch"], j["obj"]["key_identity"])
                if epoch_label[j["epoch"]] != j["obj"]["key_identity"]:
                    bad(f"{where}[{i}]: two key_identity values share one recognised key in this sequence")
                v = rcv.judge(raw, j["obj"], j["epoch"], model, mut, j["lineage"])
                if v == model["rx6"][1]:
                    cov["rules"].add(conflict_rule(rcv, raw, j["obj"], j["epoch"], model, j["lineage"]))
            verdicts.append(v)
            cov["rx6"].add(v)
            if v != ev["expected"]:
                bad(f"{where}[{i}]: verdict {v}, corpus says {ev['expected']}")
        rk = lambda r: (str(r["device_id"]), str(r["lineage"]), str(r["alert_id"]))
        want_reading = sorted(seq.get("expected_reading", []), key=rk)
        got = sorted(rcv.reading(model, mut), key=rk)
        if got != want_reading:
            bad(f"{where}: reading {json.dumps(got, sort_keys=True)} but corpus says {json.dumps(want_reading, sort_keys=True)}")
        tal = []
        for key, (raw, obj) in rcv.tallies.items():
            tal.append({"device_id": obj["device_id"], "epoch": epoch_label.get(key[0], "?"), "channel": obj["channel"], "class": obj["class"],
                        "reason": obj["reason"], "month": obj["month"], "count": int(obj["count"].text),
                        "record_digest": "sha256:" + hashlib.sha256(raw).hexdigest(),
                        "settled": key not in rcv.unsettled_tallies})
        k = lambda t: (t["device_id"], t["epoch"], t["channel"], str(t["class"]), t["reason"], t["month"])
        if sorted(tal, key=k) != sorted(seq.get("expected_tallies", []), key=k):
            bad(f"{where}: tallies held {json.dumps(sorted(tal, key=k))} but corpus says {json.dumps(sorted(seq.get('expected_tallies', []), key=k))}")
        shape_coverage(rcv, verdicts, model, cov)
    for v in model["rx6"] + (model["stored"],):
        if v not in cov["rx6"]:
            bad(f"coverage: no receiver sequence gives {v}")
    for r in ("identity", "attempt_fields", "alert", "attempt_seq", "prior"):
        if r not in cov["rules"]:
            bad(f"coverage: no receiver sequence breaches the {r} rule of Consistency across records")
    for s in ("later_failure", "failed_retry", "failover", "tally_epochs"):
        if s not in cov["seq_shapes"]:
            bad(f"coverage: no receiver sequence shows {s}")

    # --- carriage ----------------------------------------------------------
    for seq in corpus.get("carriage_sequences", []):
        where = f"carriage_sequences.{seq['name']}"
        cu = Custody(seq["configured_devices"], seq["max_records_per_device"])
        for i, ev in enumerate(seq["events"]):
            raw = ev["message"].encode("utf-8")
            v, ack = cu.receive(ev["topic_device"], raw, model, mut)
            if v != ev["expected"]:
                bad(f"{where}[{i}]: custody verdict {v}, corpus says {ev['expected']}")
            if ack != ev.get("expected_ack"):
                bad(f"{where}[{i}]: acknowledgement {ack}, corpus says {ev.get('expected_ack')}")
            cov["carriage"].add(v)
            if v == model["gw_queue_full"] and len(cu.queue.get(ev["topic_device"], [])) == seq["max_records_per_device"]:
                cov["carriage"].add("queue_full_at_bound")
        same_id: dict[tuple, set] = {}
        for dev, objs in cu._held.items():
            for o in objs:
                same_id.setdefault((dev, identity_of(o, model)), set()).add(canon(o))
        if any(len(v) > 1 for v in same_id.values()):
            cov["carriage"].add("pair_queued")
    for v in ("queued", "replayed", "queue_full_at_bound", "pair_queued"):
        if v not in cov["carriage"]:
            bad(f"coverage: no carriage sequence shows {v}")

    # --- enrolment -------------------------------------------------------
    for case in corpus.get("enrolment", []):
        where = f"enrolment.{case['name']}"
        pub = pub_of(case["enrolling_public_key"])
        if pub is None:
            bad(f"{where}: enrolling_public_key unreadable")
            continue
        if case["enrolling_key_identity"] != key_identity_of(pub, model):
            bad(f"{where}: enrolling_key_identity is not the key's")
        ch = case["challenge"].encode("utf-8")
        if bytes.fromhex(case["signing_input_hex"]) != model["enrol_prefix"] + ch:
            bad(f"{where}: signing_input_hex is not the enrolment prefix, NUL and the challenge")
        if case.get("challenge_b64") != base64.b64encode(ch).decode("ascii"):
            bad(f"{where}: challenge_b64 is not canonical Base64 of the challenge bytes")
        sig = b64_exact(case["signature"], 64)
        if sig is None:
            bad(f"{where}: signature is not canonical Base64 of 64 bytes")
        held = case["held_enrolments"]
        for h in held:
            if not (isinstance(h.get("device_id"), str) and isinstance(h.get("owner"), str)
                    and isinstance(h.get("revoked"), bool)
                    and full(model["key_identity_re"], h.get("lineage_origin"), frozenset(), "key_identity")
                    and full(model["key_identity_re"], h.get("key_identity"), frozenset(), "key_identity")):
                bad(f"{where}: a held enrolment outside its form")
        # A revoked key is still held: revocation ends its trust, not its place in a lineage.
        held_now = [h for h in held if not (h["revoked"] and "revoked_not_held" in mut)]
        f, joins = enrol_faults(ch, sig, case["issued_nonce"], case["nonce_consumed"], case["enrolling_device_id"], pub, model, mut,
                                case["enrolling_owner"], held_now)
        if not f and joins != case["expected_lineage_joins"]:
            bad(f"{where}: the key joins {joins}, corpus says {case['expected_lineage_joins']}")
        v = f[0] if f else "pass"
        if v != case["expected"]:
            bad(f"{where}: verdict {v}, corpus says {case['expected']} (fails {f})")
        if case["name"].startswith("precedence_"):
            if len(f) < 2:
                bad(f"{where}: a precedence case with no second failing rule (fails {f})")
        elif v != "pass":
            # *Vectors* asks one case for each reason, not a case refused for it
            # alone; a later rule's failure is recorded, not refused.
            if len(f) == 1:
                cov["enrol_alone"].add(v)
            else:
                ENROL_NOT_ALONE.append(f"{case['name']}: {v} also fails {f[1:]}")
        else:
            cov["enrol_pass"].add(True)
    for r in model["enrol_order"]:
        if r not in cov["enrol_alone"]:
            # Every reason's check can fail alone: a non-canonical challenge that
            # is otherwise right, a consumed nonce, and a challenge naming another
            # device or key signed by the key being enrolled, or a bad signature.
            bad(f"coverage: no enrolment case refused for {r} alone")
    if not cov["enrol_pass"]:
        bad("coverage: no enrolment proof that passes")

    # --- config ----------------------------------------------------------
    for case in corpus.get("config", []):
        where = f"config.{case['name']}"
        r = load_alert_delivery(case, model, mut)
        if (r is None) != case["valid"] or (r is not None and r != case.get("rule")):
            bad(f"{where}: load gives {r or 'valid'}, corpus says {case.get('rule') if not case['valid'] else 'valid'}")
        cov["cfg"].add(r or ("enabled" if case["alert_delivery"].get("enabled") is True else "disabled"))
        ad = case["alert_delivery"]
        if r is None and ad.get("enabled") is True:
            eq = ws_trim(ad["queue_directory"], mut) if isinstance(ad["queue_directory"], str) else ad["queue_directory"]
            em = ad.get("max_records_per_device", model["cfg_default_max"])
            if case.get("effective_queue_directory") != eq or case.get("effective_max_records_per_device") != em:
                bad(f"{where}: in force {eq!r}, {em}; corpus says {case.get('effective_queue_directory')!r}, {case.get('effective_max_records_per_device')}")
    for r in model["cfg_rules"] + ["enabled", "disabled"]:
        if r not in cov["cfg"]:
            bad(f"coverage: no config case for {r}")


def conflict_rule(rcv: Receiver, raw: bytes, obj: dict, epoch: bytes, model: dict, lineage: tuple = ()) -> str:
    """Which rule of Consistency (or the identity rule) made this record conflict."""
    for rule, m in (("identity", {"no_attempt_fields_rule", "no_alert_rule", "no_attempt_seq_rule", "no_prior_rule"}),
                    ("attempt_fields", {"no_identity_rule", "no_alert_rule", "no_attempt_seq_rule", "no_prior_rule"}),
                    ("alert", {"no_identity_rule", "no_attempt_fields_rule", "no_attempt_seq_rule", "no_prior_rule"}),
                    ("attempt_seq", {"no_identity_rule", "no_attempt_fields_rule", "no_alert_rule", "no_prior_rule"}),
                    ("prior", {"no_identity_rule", "no_attempt_fields_rule", "no_alert_rule", "no_attempt_seq_rule"})):
        pool = [k for k in rcv.kept[:-1]]
        if obj["kind"] == model["kind_submission"] and rcv._submission(raw, obj, epoch, pool, model, frozenset(m), lineage) is not None:
            return rule
    return "tally" if obj["kind"] == model["kind_tally"] else "?"


def shape_coverage(rcv: Receiver, verdicts: list[str], model: dict, cov: dict) -> None:
    held = [(o, e) for _, o, e, v, _ in rcv.kept if v == model["stored"] and o["kind"] == model["kind_submission"]]
    for o, e in held:
        for p, pe in held:
            if pe != e or p["alert_id"] != o["alert_id"]:
                continue
            if p["delivery_attempt_id"] == o["delivery_attempt_id"] and o["outcome"] == "accepted" and p["outcome"] == "failed" \
                    and p["prior_outcome"] == "accepted":
                cov["seq_shapes"].add("later_failure")
            if p["delivery_attempt_id"] != o["delivery_attempt_id"] and p["channel"] == o["channel"] \
                    and o["outcome"] == "accepted" and p["outcome"] == "failed" \
                    and int(p["attempt_seq"].text) > int(o["attempt_seq"].text):
                cov["seq_shapes"].add("failed_retry")
            if p["channel"] != o["channel"] and o["outcome"] == "accepted":
                cov["seq_shapes"].add("failover")
    keys = {}
    for k in rcv.tallies:
        keys.setdefault(k[1:], set()).add(k[0])
    if any(len(v) > 1 for v in keys.values()):
        cov["seq_shapes"].add("tally_epochs")


# ---------------------------------------------------------------------------
# --mutations
# ---------------------------------------------------------------------------

JUDGE_MUTANTS = [
    # gateway checks 3, 4, 6: dropped, reordered
    "gw_drop_3", "gw_drop_4", "gw_drop_6", "gw_swap_3_4", "gw_swap_4_6",
    # check 4 loosened, one form at a time
    "members_extra_ok", "int_bool_ok", "int_spelling_ok", "int_no_max", "int_no_min",
    "unsupported_as_malformed", "unsupported_any_json_integer", "num_as_str_record", "dollar_pattern", "obs_seq_4", "outcome_open", "sig_form_loose", "prior_open", "detail_open",
    "loose_pattern:device_id", "loose_pattern:alert_id", "loose_pattern:delivery_attempt_id",
