    # config
    "num_as_str_config", "validate_disabled", "trim_python_strip", "no_trim", "no_dotdot", "fold_case", "prefix_by_string",
    "no_containing", "sep_evidence_always", "sep_no_state_dir", "range_float_ok", "range_zero_ok", "range_high_ok",
    "cfg_swap_2_3", "cfg_type_last", "type_enabled_unchecked", "cfg_drop:type_mismatch", "cfg_drop:queue_directory_required", "cfg_drop:queue_directory_absolute",
    "cfg_drop:queue_directory_separate", "cfg_drop:max_records_per_device_range",
]


def corpus_mutants(corpus: dict) -> list[tuple[str, dict]]:
    out = []

    def mk(label: str, f: Callable[[dict], None]) -> None:
        x = copy.deepcopy(corpus)
        f(x)
        out.append((label, x))

    other_gw = {"pass": "malformed", "malformed": "pass", "not_canonical": "malformed", "device_mismatch": "pass"}
    for i, c in enumerate(corpus.get("records", [])):
        mk(f"records.{c['name']}: expected_gateway flipped",
           lambda x, i=i: x["records"][i].__setitem__("expected_gateway", other_gw.get(x["records"][i]["expected_gateway"], "pass")))
        mk(f"records.{c['name']}: expected_receiver flipped",
           lambda x, i=i: x["records"][i].__setitem__("expected_receiver", "class_refused" if x["records"][i]["expected_receiver"] != "class_refused" else "pass"))
    for reason in sorted({c["expected_receiver"] for c in corpus.get("records", [])} | {c["expected_gateway"] for c in corpus.get("records", [])}):
        if reason == "pass":
            continue
        mk(f"records: every case refused for {reason} removed",
           lambda x, reason=reason: x.__setitem__("records", [c for c in x["records"]
                                                              if reason not in (c["expected_receiver"], c["expected_gateway"])]))
    for name in ("bound_submission", "bound_tally", "bound_submission_mandatory"):
        mk(f"records.{name}: removed", lambda x, name=name: x.__setitem__("records", [c for c in x["records"] if c["name"] != name]))
    for i, s in enumerate(corpus.get("receiver_sequences", [])):
        for j, _ in enumerate(s["records"]):
            mk(f"receiver_sequences.{s['name']}[{j}]: verdict flipped",
               lambda x, i=i, j=j: x["receiver_sequences"][i]["records"][j].__setitem__(
                   "expected", "conflict" if x["receiver_sequences"][i]["records"][j]["expected"] != "conflict" else "stored"))
        if s.get("expected_reading"):
            def flip_reading(x, i=i):
                r = x["receiver_sequences"][i]["expected_reading"][0]
                r["accepted_on_some_channel"] = not r["accepted_on_some_channel"]
            mk(f"receiver_sequences.{s['name']}: reading flipped", flip_reading)

            def flip_settled(x, i=i):
                r = x["receiver_sequences"][i]["expected_reading"][-1]
                r["settled"] = not r["settled"]
            mk(f"receiver_sequences.{s['name']}: settled flipped", flip_settled)
        if s.get("expected_tallies"):
            def bump(x, i=i):
                x["receiver_sequences"][i]["expected_tallies"][0]["count"] += 1
            mk(f"receiver_sequences.{s['name']}: tally count changed", bump)
    for i, s in enumerate(corpus.get("carriage_sequences", [])):
        for j, _ in enumerate(s["events"]):
            mk(f"carriage_sequences.{s['name']}[{j}]: verdict flipped",
               lambda x, i=i, j=j: x["carriage_sequences"][i]["events"][j].__setitem__(
                   "expected", "replayed" if x["carriage_sequences"][i]["events"][j]["expected"] != "replayed" else "queued"))

            def ack_flip(x, i=i, j=j):
                e = x["carriage_sequences"][i]["events"][j]
                e["expected_ack"] = None if e["expected_ack"] else {"outcome": "refused", "reason": e["expected"], "record_digest": "", "device_id": e["topic_device"]}
            mk(f"carriage_sequences.{s['name']}[{j}]: ack flipped", ack_flip)
    for i, c in enumerate(corpus.get("enrolment", [])):
        mk(f"enrolment.{c['name']}: verdict flipped",
           lambda x, i=i: x["enrolment"][i].__setitem__("expected", "pass" if x["enrolment"][i]["expected"] != "pass" else "nonce_mismatch"))
    for i, c in enumerate(corpus.get("config", [])):
        mk(f"config.{c['name']}: verdict flipped", lambda x, i=i: x["config"][i].__setitem__("valid", not x["config"][i]["valid"]))
    # The closed schema: an unknown member at every level the checker reads.
    def first(x, *path):
        for key in path:
            try:
                x = x[key]
            except (KeyError, IndexError, TypeError):
                return None
        return x if isinstance(x, dict) else None

    places = [(), ("note",), ("test_keys", "runtime"), ("records", 0), ("records", 0, "enrolments", 0),
              ("receiver_sequences", 0), ("receiver_sequences", 0, "records", 0), ("receiver_sequences", 0, "enrolments", 0),
              ("receiver_sequences", 0, "expected_reading", 0), ("receiver_sequences", 0, "expected_reading", 0, "channels", "sms"),
              ("carriage_sequences", 0), ("carriage_sequences", 0, "events", 0), ("carriage_sequences", 0, "events", 0, "expected_ack"),
              ("enrolment", 0), ("config", 0), ("config", 0, "alert_delivery"), ("config", 0, "evidence")]
    for path in places:
        def add(x, path=path):
            t = first(x, *path) if path else x
            t["unchecked_extra"] = 1
        if (first(corpus, *path) if path else corpus) is not None:
            mk(f"schema: unknown member at {'.'.join(map(str, path)) or 'root'}", add)
    tal = next((i for i, s in enumerate(corpus.get("receiver_sequences", [])) if s.get("expected_tallies")), None)
    if tal is not None:
        mk("schema: unknown member in an expected tally",
           lambda x: x["receiver_sequences"][tal]["expected_tallies"][0].__setitem__("unchecked_extra", 1))
    for name in list(corpus.get("test_keys", {})):
        def flipkey(x, name=name):
            k = x["test_keys"][name]
            k["key_identity"] = k["key_identity"][:-1] + ("0" if k["key_identity"][-1] != "0" else "1")
        mk(f"test_keys.{name}: key_identity altered", flipkey)
    return out


def run_mutations(corpus: dict, model: dict, texts: dict[str, str]) -> int:
    survivors: list[str] = []
    total = 0
    baseline = set(check(corpus, model))
    for m in JUDGE_MUTANTS:
        total += 1
        errs = set(check(corpus, model, frozenset([m]))) - baseline
        if not [e for e in errs if not e.startswith("coverage:")]:
            survivors.append(f"judge mutant {m}")
    for name, x in corpus_mutants(corpus):
        total += 1
        if not (set(check(x, model)) - baseline):
            survivors.append(f"corpus mutant {name}")
    for name, t in text_mutants(texts):
        total += 1
        if t is None:
            survivors.append(f"{name} (did not apply)")
            continue
        try:
            mm = build_model(t)
        except Failure:
            continue
        if not (set(check(corpus, mm)) - baseline):
            survivors.append(name)
    for s in survivors:
        print(f"SURVIVED: {s}", file=sys.stderr)
    if survivors:
        print(f"check-alert-delivery-vectors-v1 --mutations: {len(survivors)} of {total} mutants survived", file=sys.stderr)
        return 1
    print(f"check-alert-delivery-vectors-v1 --mutations: all {total} mutants refused")
    return 0


def main(argv: list[str]) -> int:
    args = argv[1:]
    if args not in ([], ["--mutations"]):
        print(__doc__, file=sys.stderr)
        return 2
    try:
        texts = load_texts()
        model = build_model(texts)
        corpus = json.loads(CORPUS.read_text(encoding="utf-8"))
    except (Failure, OSError, ValueError) as e:
        print(f"FAIL: {e}", file=sys.stderr)
        return 1
    errs = check(corpus, model)
    for e in errs:
        print(f"FAIL: {e}", file=sys.stderr)
    if errs:
        print(f"check-alert-delivery-vectors-v1: {len(errs)} failures", file=sys.stderr)
    else:
        print(f"check-alert-delivery-vectors-v1: {len(corpus['records'])} records, "
              f"{len(corpus['receiver_sequences'])} receiver sequences, {len(corpus['carriage_sequences'])} carriage "
              f"sequences, {len(corpus['enrolment'])} enrolment and {len(corpus['config'])} config cases hold "
              f"against the text; {len(PINS)} sentences pinned")
    if args == ["--mutations"]:
        rc = run_mutations(corpus, model, texts)
        return 1 if errs else rc
    return 1 if errs else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
