     '{"boot_id":41,"capability_hash":"sha256:13751b5335ccedcd4ffcc82bbda28ebfb7558859f36a74e710f1a0b0ab23da8d","device_id":"ori-fw-7c9f2b3a","runtime_seq":2,"v":1}'),
)

# Each signed by the runtime key over the same bytes in a form the device refuses.
V1_SIGNATURE_REFUSALS = (
    ("reject_signed_over_object_alone", "alone",
     "signed by the runtime key over the object bytes alone, v1's form, which no domain "
     "begins"),
    ("reject_signed_in_command_domain", "command",
     "signed by the runtime key in the command domain: a command signature is never a "
     "liveness signature"),
    ("reject_liveness_domain_without_nul", "liveness_no_nul",
     "signed by the runtime key over the liveness domain and the object bytes with no NUL "
     "between them"),
)
V1_SIGNATURE_REFUSAL_OBJECT = (
    '{"boot_id":41,"capability_hash":"sha256:13751b5335ccedcd4ffcc82bbda28ebfb7558859f36a74e7'
    '10f1a0b0ab23da8d","device_id":"ori-fw-7c9f2b3a","runtime_seq":3,"v":1}')
V1_RETAINED = (
    "reject_retained_delivery",
    "byte-identical to a message the device must accept when delivered live. A device "
    "reconnecting after the runtime died would otherwise suppress its own backstop for a full "
    "expiry window on the strength of a stored message",
    V1_SIGNATURE_REFUSAL_OBJECT,
)


def build_v1() -> bytes:
    runtime = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(RUNTIME_SEED_HEX))
    rogue = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(ROGUE_SEED_HEX))
    runtime_public = runtime.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    rogue_public = rogue.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)

    def sign(body: bytes, key: Ed25519PrivateKey = runtime, form: str = "liveness") -> str:
        return "ed25519:" + base64.b64encode(key.sign(PREIMAGES[form](body))).decode("ascii")

    def wire(body: bytes, signature: str) -> str:
        return (b'{"liveness":' + body + b',"signature":"' + signature.encode() + b'"}').hex()

    accepted = {}
    cases = []
    for name, note, ctx, obj in V1_ACCEPT:
        body = obj.encode()
        signature = sign(body)
        accepted[name] = signature
        cases.append({"name": name, "note": note, "input": json.loads(body),
                      "verifier_context": ctx, "liveness_hex": body.hex(),
                      "signature_b64": signature[len("ed25519:"):],
                      "message_hex": wire(body, signature)})
    reject_cases = []
    for name, reason, source, note, ctx, obj in V1_REJECT:
        body = obj.encode()
        if source == "own":
            signature = sign(body)
        elif source == "rogue":
            signature = sign(body, rogue)
        elif source in accepted:
            signature = accepted[source]
        else:
            signature = source
        reject_cases.append({"name": name, "reason": reason,
                             "signature_valid": source == "own", "verifier_context": ctx,
                             "message_hex": wire(body, signature), "note": note})
    for name, form, note in V1_SIGNATURE_REFUSALS:
        body = V1_SIGNATURE_REFUSAL_OBJECT.encode()
        reject_cases.append({"name": name, "reason": "signature_invalid",
                             "signature_valid": False,
                             "verifier_context": ctx1(DEVICE_ID, BOOT_ID, CAPABILITY_HASH, 2),
                             "message_hex": wire(body, sign(body, form=form)), "note": note})
    name, note, obj = V1_RETAINED
    transport = [{"name": name, "reason": "retained", "signature_valid": True,
                  "verifier_context": ctx1(DEVICE_ID, BOOT_ID, CAPABILITY_HASH, 2),
                  "transport": {"topic": f"ori/fw/{DEVICE_ID}/runtime", "retain": True},
                  "message_hex": wire(obj.encode(), sign(obj.encode())), "note": note}]
    corpus = {
        "contract": "ori-specs/firmware-commands/v2.md#runtime-liveness",
        "version": 1,
        "comment": (
            "Cross-language golden vectors for runtime liveness. The runtime signer (Python) "
            "must produce these exact bytes; the device verifier (C) must accept every case in "
            "'cases' and refuse every case in 'reject_cases' and 'transport_reject_cases', with "
            "the declared reason, evaluated against the declared verifier_context. Signed with "
            "the TEST-ONLY runtime command seed below - never use it in production - in the "
            "liveness domain of Signing Domains unless a case's note names another preimage. "
            "Liveness reuses the runtime command key deliberately: the device pins one runtime "
            "key and there is no second trust root, and the domain keeps a liveness signature "
            "from ever being a command signature."
        ),
        "acceptance_order": ["parses", "device_id", "signature", "boot_id", "capability_hash",
                             "runtime_seq"],
        "runtime_test_seed_hex": RUNTIME_SEED_HEX,
        "runtime_public_key_hex": runtime_public.hex(),
        "runtime_public_key_b64": base64.b64encode(runtime_public).decode("ascii"),
        "rogue_test_seed_hex": ROGUE_SEED_HEX,
        "rogue_public_key_hex": rogue_public.hex(),
        "signature_encoding": "ed25519:<standard-base64-64-byte-signature>",
        "topic": "ori/fw/<device_id>/runtime",
        "retain": False,
        "qos": 1,
        "cases": cases,
        "reject_cases": reject_cases,
        "transport_reject_cases": transport,
    }
    return (json.dumps(corpus, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    outputs = ((OUT_V1, build_v1()), (OUT, build()))
    if argv == ["--check"]:
        failed = 0
        for out, data in outputs:
            if not out.exists() or out.read_bytes() != data:
                print(f"{out.relative_to(ROOT)} does not reproduce from its generator")
                failed = 1
            else:
                print(f"{out.relative_to(ROOT)} reproduces byte for byte")
        return failed
    if argv:
        print(__doc__)
        return 2
    for out, data in outputs:
        out.write_bytes(data)
        print(f"wrote {out.relative_to(ROOT)} sha256 {hashlib.sha256(data).hexdigest()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
