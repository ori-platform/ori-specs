"""Generate runtime-posture/v1 vectors.

Writes runtime-posture/vectors/posture-v1.json: signed records as exact bytes,
each with the verdict a receiver gives it at checks 3 to 10 of Receiving;
receiver sequences, each event with its verdict and the posture state after
it; the gateway-config/v2 posture key load rules; and the operator-socket/v3
runtime_device_key readback. Keys are SHA-256 of a published label and are test
keys only.

Usage: generate-runtime-posture-vectors-v1 [--check]
"""

from __future__ import annotations

import base64
import copy
import hashlib
import json
import pathlib
import re
import sys

from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "runtime-posture" / "vectors" / "posture-v1.json"

DOMAIN = b"ori.runtime_posture.v1\x00"
SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")
SKEW_MS = 300_000
CURRENT_MS = 900_000
MAX_INT = 2**53 - 1
DEVICE = "site-a-edge-01"
OTHER_DEVICE = "site-a-edge-02"
BINDING = "sha256:" + hashlib.sha256(b"ori runtime-posture/v1 test binding").hexdigest()
INADMISSIBLE = bytes.fromhex("01" + "00" * 31)  # ed25519-key-admission/v1 vectors: small order

DEVICE_RE = re.compile(r"[A-Za-z0-9._-]{1,128}")
RELEASE_RE = re.compile(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?")
HASH_RE = re.compile(r"sha256:[0-9a-f]{64}")
CLASS_RE = re.compile(r"[a-z][a-z0-9_]{0,31}")
MAX_CLASSES = 10
CLASSES = ["unusual_consumption_spike"]
MEMBERS = {"v", "device_id", "release", "deployment_profile", "commissioned_binding", "alert_classes",
           "key_identity", "boot_generation", "posture_seq", "issued_at_ms", "signature"}


def key(label: str) -> Ed25519PrivateKey:
    return Ed25519PrivateKey.from_private_bytes(
        hashlib.sha256(f"ori runtime-posture/v1 {label} test key".encode()).digest())


def raw(k: object) -> bytes:
    if hasattr(k, "public") and not hasattr(k, "public_key"):
        return k.public()
    return k.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)


def b64(b: bytes) -> str:
    return base64.b64encode(b).decode("ascii")


def identity(pub: bytes) -> str:
    return "sha256:" + hashlib.sha256(SPKI_PREFIX + pub).hexdigest()


def recognised(pub: bytes) -> bytes:
    return pub[:31] + bytes([pub[31] & 0x7F])


KEY_A, KEY_B = key("posture A"), key("posture B")
PUB_A, PUB_B = raw(KEY_A), raw(KEY_B)


class Number(str):
    """A JSON number token kept exactly as written, as gateway-mqtt-canonical-json/v1's verifier keeps it."""


def parse(data: str) -> object:
    return json.loads(data, parse_int=Number, parse_float=Number)


def emit(value: object) -> str:
    if isinstance(value, Number):
        return str(value)
    if isinstance(value, dict):
        return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + emit(value[k]) for k in sorted(value)) + "}"
    if isinstance(value, list):
        return "[" + ",".join(emit(v) for v in value) + "]"
    return json.dumps(value, ensure_ascii=False)


def canonical(obj: dict) -> bytes:
    """Sorted members, no insignificant whitespace, number tokens as written."""
    return emit(obj).encode("utf-8")


def integer(value: object) -> int | None:
    """The value of an integer token: digits with no sign, fraction, exponent or leading zero."""
    if isinstance(value, Number) and re.fullmatch(r"0|[1-9][0-9]*", value):
        return int(value)
    if isinstance(value, int) and not isinstance(value, bool):
        return value
    return None


# Edwards25519 arithmetic, to sign under a key's negation: the holder of a signs with -a under -A.
FIELD = 2 ** 255 - 19
ORDER = 2 ** 252 + 27742317777372353535851937790883648493
EDWARDS_D = -121665 * pow(121666, FIELD - 2, FIELD) % FIELD
ZERO = (0, 1, 1, 0)


def point_add(a: tuple, b: tuple) -> tuple:
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    k1 = (y1 - x1) * (y2 - x2) % FIELD
    k2 = (y1 + x1) * (y2 + x2) % FIELD
    k3 = 2 * EDWARDS_D * t1 * t2 % FIELD
    k4 = 2 * z1 * z2 % FIELD
    e, f, g, h = k2 - k1, k4 - k3, k4 + k3, k2 + k1
    return (e * f % FIELD, g * h % FIELD, f * g % FIELD, e * h % FIELD)


def point_mul(n: int, point: tuple) -> tuple:
    acc = ZERO
    while n:
        if n & 1:
            acc = point_add(acc, point)
        point = point_add(point, point)
        n >>= 1
    return acc


def point_decode(raw_key: bytes) -> tuple:
    value = int.from_bytes(raw_key, "little")
    sign, y = value >> 255, value & ((1 << 255) - 1)
    xx = (y * y - 1) * pow(EDWARDS_D * y * y + 1, FIELD - 2, FIELD) % FIELD
    x = pow(xx, (FIELD + 3) // 8, FIELD)
    if (x * x - xx) % FIELD:
        x = x * pow(2, (FIELD - 1) // 4, FIELD) % FIELD
    if x & 1 != sign:
        x = FIELD - x
    return (x, y, 1, x * y % FIELD)


def point_encode(point: tuple) -> bytes:
    x, y, z, _ = point
    inv = pow(z, FIELD - 2, FIELD)
    x, y = x * inv % FIELD, y * inv % FIELD
    return (y | (x & 1) << 255).to_bytes(32, "little")


BASE_POINT = point_decode((4 * pow(5, FIELD - 2, FIELD) % FIELD).to_bytes(32, "little"))


class NegatedA:
    """Signs as the holder of key A does under A's negation, -A."""

    label = "posture A"

    def public(self) -> bytes:
        return PUB_A[:31] + bytes([PUB_A[31] ^ 0x80])

    def sign(self, message: bytes) -> bytes:
        h = hashlib.sha512(hashlib.sha256(f"ori runtime-posture/v1 {self.label} test key".encode()).digest()).digest()
        a = int.from_bytes(h[:32], "little")
        a &= (1 << 254) - 8
        a |= 1 << 254
        r = int.from_bytes(hashlib.sha512(h[32:] + message).digest(), "little") % ORDER
        big_r = point_encode(point_mul(r, BASE_POINT))
        k = int.from_bytes(hashlib.sha512(big_r + self.public() + message).digest(), "little") % ORDER
        sig = big_r + ((r + k * (ORDER - a % ORDER)) % ORDER).to_bytes(32, "little")
        Ed25519PublicKey.from_public_bytes(self.public()).verify(sig, message)
        return sig


NEG_A = NegatedA()
PUB_NEG_A = NEG_A.public()


def record(signer: object = KEY_A, *, boot: int = 1, seq: int = 1, issued: int = 1_787_000_000_000,
           device: str = DEVICE, release: object = "2.5.1", profile: str = "production",
           binding: object = BINDING, classes: object = None, key_identity: str | None = None,
           **override: object) -> dict:
    obj = {"v": 1, "device_id": device, "release": release, "deployment_profile": profile,
           "commissioned_binding": binding, "alert_classes": list(CLASSES) if classes is None else classes,
           "key_identity": key_identity or identity(raw(signer)),
           "boot_generation": boot, "posture_seq": seq, "issued_at_ms": issued}
    obj.update({k: v for k, v in override.items() if k != "signature"})
    obj["signature"] = b64(signer.sign(DOMAIN + canonical(obj)))
    if "signature" in override:
        obj["signature"] = override["signature"]
    return obj


def text(obj: dict) -> str:
    return canonical(obj).decode("utf-8")


def is_int(v: object) -> bool:
    n = integer(v)
    return n is not None and 1 <= n <= MAX_INT


def canonical_b64(s: object, n: int) -> bool:
    if not isinstance(s, str):
        return False
    try:
        d = base64.b64decode(s, validate=True)
    except ValueError:
        return False
    return len(d) == n and b64(d) == s


def classes_ok(v: object) -> bool:
    if not isinstance(v, list) or len(v) > MAX_CLASSES:
        return False
    if not all(isinstance(c, str) and CLASS_RE.fullmatch(c) for c in v):
        return False
    return all(a.encode() < b.encode() for a, b in zip(v, v[1:]))


def schema_ok(o: dict) -> bool:
    if set(o) != MEMBERS:
        return False
    return (integer(o["v"]) == 1
            and isinstance(o["device_id"], str) and DEVICE_RE.fullmatch(o["device_id"]) is not None
            and (o["release"] is None or (isinstance(o["release"], str) and len(o["release"]) <= 64
                                          and RELEASE_RE.fullmatch(o["release"]) is not None))
            and o["deployment_profile"] in ("development", "staging", "production")
            and (o["commissioned_binding"] is None
                 or (isinstance(o["commissioned_binding"], str) and HASH_RE.fullmatch(o["commissioned_binding"])))
            and classes_ok(o["alert_classes"])
            and isinstance(o["key_identity"], str) and HASH_RE.fullmatch(o["key_identity"]) is not None
            and all(is_int(o[m]) for m in ("boot_generation", "posture_seq", "issued_at_ms"))
            and canonical_b64(o["signature"], 64))


def stateless(data: str, topic_device: str, devices: list, pins: dict, wall: int) -> tuple[str | None, dict | None]:
    """Checks 3 to 10. pins: device -> raw key."""
    obj = parse(data)
    if canonical(obj) != data.encode("utf-8"):
        return "not_canonical", None
    if not schema_ok(obj):
        return "malformed", None
    if topic_device not in devices:
        return "unknown_device", None
    if obj["device_id"] != topic_device:
        return "device_mismatch", None
    pin = pins.get(topic_device)
    if pin is None:
        return "no_pinned_key", None
    if obj["key_identity"] != identity(pin):
        return "key_mismatch", None
    unsigned = {k: v for k, v in obj.items() if k != "signature"}
    try:
        Ed25519PublicKey.from_public_bytes(pin).verify(base64.b64decode(obj["signature"]),
                                                      DOMAIN + canonical(unsigned))
    except InvalidSignature:
        return "signature_invalid", None
    issued = integer(obj["issued_at_ms"])
    if issued < wall - SKEW_MS:
        return "stale_timestamp", None
    if issued > wall + SKEW_MS:
        return "future_timestamp", None
    obj = {**obj, **{m: integer(obj[m]) for m in ("v", "boot_generation", "posture_seq", "issued_at_ms")}}
    return None, obj


class Gateway:
    def __init__(self, devices: list, pins: dict, store_ok: bool = True) -> None:
        self.devices, self.pins = list(devices), dict(pins)
        self.store_mode: str | None = None if store_ok else "unreadable"  # or "unwritten"
        self.states: dict[tuple[str, bytes], dict] = {}
        self.durable: dict[tuple[str, bytes], dict] = {}
        self.last_refusal: dict[str, tuple[str, int]] = {}
        self.run = 0

    def slot(self, device: str) -> dict:
        return self.states.setdefault((device, recognised(self.pins[device])), {"held": None, "sticky": None})

    def receive(self, topic_device: str, data: str, wall: int, mono: int, write_fails: bool = False) -> str:
        reason, obj = stateless(data, topic_device, self.devices, self.pins, wall)
        if reason is not None:
            if topic_device in self.devices:
                self.last_refusal[topic_device] = (reason, wall)
            return reason
        if self.store_mode is not None:
            return "store_unavailable"
        st = self.slot(topic_device)
        pair = (obj["boot_generation"], obj["posture_seq"])
        held = st["held"]
        if held is not None and pair == held["pair"] and data == held["bytes"]:
            return "replayed"
        if held is None or pair > held["pair"]:
            if held is not None and obj["issued_at_ms"] < held["issued"] - SKEW_MS:
                verdict, change = "conflict", {"sticky": "conflict"}
            else:
                verdict = "accepted"
                change = {"held": {"bytes": data, "pair": pair, "issued": obj["issued_at_ms"], "wall": wall,
                                   "mono": mono, "run": self.run}, "sticky": None}
        elif pair == held["pair"]:
            verdict, change = "conflict", {"sticky": "conflict"}
        else:
            verdict, change = "lower_tuple", {"sticky": "lower_tuple_seen"}
        if all(st.get(k) == v for k, v in change.items()):
            return verdict  # nothing durable changes, so nothing is written and no write can fail
        st.update(change)
        if write_fails:
            self.store_mode = "unwritten"
        else:
            self.durable = copy.deepcopy(self.states)
        return verdict

    def state(self, device: str, wall: int, mono: int) -> dict:
        extra = {}
        if device in self.last_refusal:
            extra = {"last_refusal": self.last_refusal[device][0], "last_refusal_at_ms": self.last_refusal[device][1]}
        if device not in self.pins:
            return {"state": "unknown", "reason": "no_pinned_key", **extra}
        if self.store_mode is not None:
            return {"state": "unknown", "reason": "store_unavailable", **extra}
        st = self.slot(device)
        if st["sticky"] is not None:
            return {"state": "unknown", "reason": st["sticky"], **extra}
        held = st["held"]
        if held is None:
            return {"state": "unknown", "reason": "no_record", **extra}
        out = {"record_b64": b64(held["bytes"].encode("utf-8")), "received_at_ms": held["wall"], **extra}
        if held["run"] != self.run:
            return {"state": "stale", **out}
        age = max(0, held["wall"] - held["issued"]) + max(mono - held["mono"], wall - held["wall"])
        if age > CURRENT_MS:
            held["stale_seen"] = True  # a held record that has read stale stays stale until a fresh one
        return {"state": "stale" if held.get("stale_seen") else "current", **out}

    def restart(self, pins: dict | None = None, devices: list | None = None, readable: bool = True) -> None:
        self.run += 1
        self.last_refusal = {}
        # The gateway starts from the store as it was last written; state held only in memory is lost.
        unreadable = self.store_mode == "unreadable"
        self.states, self.store_mode = copy.deepcopy(self.durable), None
        if unreadable or not readable:  # a store unreadable before a restart is unreadable after it
            self.states, self.store_mode = {}, "unreadable"
        if pins is not None:
            self.pins = dict(pins)
        if devices is not None:
            self.devices = list(devices)


# --- record cases (checks 3 to 10) --------------------------------------------------------------
WALL = 1_787_000_000_000
RECORD_CASES: list[dict] = []


def rcase(name: str, note: str, data: str, *, topic: str = DEVICE, devices: tuple = (DEVICE,),
          pins: dict | None = None, wall: int = WALL) -> None:
    pins = {DEVICE: PUB_A} if pins is None else pins
    reason, _ = stateless(data, topic, list(devices), pins, wall)
    RECORD_CASES.append({"name": name, "note": note, "record": data, "topic_device": topic,
                         "configured_devices": list(devices),
                         "pinned_keys": {d: "ed25519:" + b64(p) for d, p in sorted(pins.items())},
                         "gateway_wall_ms": wall, "expected": reason or "pass"})


GOOD = record()
rcase("valid", "A record that passes every check up to ordering.", text(GOOD))
rcase("valid_nulls", "release and commissioned_binding may be null.", text(record(release=None, binding=None)))
rcase("valid_rc_release", "A release candidate's SemVer.", text(record(release="2.5.1-rc.13")))
BOUND_CLASSES = ["c" * 31 + str(i) for i in range(MAX_CLASSES)]
rcase("valid_no_alert_classes", "No alert class has a handler installed.", text(record(classes=[])))
rcase("valid_one_character_alert_class", "A class name of one character.", text(record(classes=["a"])))
rcase("valid_undefined_alert_class", "A class name device-policy/v2 does not define is carried unchanged.",
      text(record(classes=["later_class", "unusual_consumption_spike"])))
rcase("valid_bounds", "Every bounded member at its largest value.",
      text(record(device="d" * 128, release="9" * 55 + ".0.0-rc.1", boot=MAX_INT, seq=MAX_INT, issued=WALL,
                  classes=BOUND_CLASSES)),
      topic="d" * 128, devices=("d" * 128,), pins={"d" * 128: PUB_A})
rcase("not_canonical_whitespace", "A space after a colon.", text(GOOD).replace('"v":1', '"v": 1'))
assert list(GOOD) != sorted(GOOD)
rcase("not_canonical_order", "Members out of order.", json.dumps(GOOD, separators=(",", ":")))
rcase("not_canonical_trailing_lf", "A line feed after the object.", text(GOOD) + "\n")
rcase("malformed_integer_exponent", "An integer written with an exponent: the token is kept as written, so the "
      "bytes are canonical and the value is no integer.", text(GOOD).replace('"posture_seq":1', '"posture_seq":1e0'))
rcase("not_canonical_over_malformed", "Not canonical and also malformed: canonical is decided first.",
      text(record(v=2)).replace('"v":2', '"v": 2'))
for name, note, obj in (
    ("malformed_member_missing", "No issued_at_ms.", {k: v for k, v in GOOD.items() if k != "issued_at_ms"}),
    ("malformed_member_unknown", "An extra member.", {**GOOD, "zones": []}),
    ("malformed_v", "v is 2.", {**GOOD, "v": 2}),
    ("malformed_v_true", "v is true.", {**GOOD, "v": True}),
    ("malformed_integer_float", "boot_generation is 1.0.", {**GOOD, "boot_generation": 1.0}),
    ("malformed_integer_zero", "posture_seq is 0.", {**GOOD, "posture_seq": 0}),
    ("malformed_integer_over", "issued_at_ms is 2^53.", {**GOOD, "issued_at_ms": MAX_INT + 1}),
    ("malformed_integer_string", "boot_generation is \"1\".", {**GOOD, "boot_generation": "1"}),
    ("malformed_device_long", "device_id of 129 characters.", {**GOOD, "device_id": "d" * 129}),
    ("malformed_release_pattern", "release is not SemVer.", {**GOOD, "release": "v2.5.1"}),
    ("malformed_release_long", "release of 65 characters.", {**GOOD, "release": "1" * 61 + ".0.0"}),
    ("malformed_release_beta", "Only -rc.N pre-releases.", {**GOOD, "release": "2.5.1-beta.1"}),
    ("malformed_profile", "deployment_profile outside its set.", {**GOOD, "deployment_profile": "prod"}),
    # Each list case is signed over its own content, so its form is its only defect.
    ("malformed_alert_classes_null", "alert_classes is null.", record(classes=None, alert_classes=None)),
    ("malformed_alert_classes_string", "alert_classes is a string, not an array.",
     record(classes="unusual_consumption_spike")),
    ("malformed_alert_classes_entry_type", "An entry that is not a string.", record(classes=[1])),
    ("malformed_alert_classes_upper", "An entry outside the pattern.", record(classes=["Grid_power"])),
    ("malformed_alert_classes_leading_digit", "An entry beginning with a digit.", record(classes=["1grid"])),
    ("malformed_alert_classes_leading_underscore", "An entry beginning with an underscore.",
     record(classes=["_grid"])),
    ("malformed_alert_classes_empty_name", "An empty entry.", record(classes=[""])),
    ("malformed_alert_classes_hyphen", "An entry with a hyphen after its first character.",
     record(classes=["grid-power"])),
    ("malformed_alert_classes_long", "An entry of 33 characters.", record(classes=["c" * 33])),
    ("malformed_alert_classes_many", "11 entries.",
     record(classes=["c" * 30 + f"{i:02d}" for i in range(MAX_CLASSES + 1)])),
    ("malformed_alert_classes_duplicate", "One name twice.",
     record(classes=["unusual_consumption_spike", "unusual_consumption_spike"])),
    ("malformed_alert_classes_unsorted", "Names out of ascending order.",
     record(classes=["unusual_consumption_spike", "grid_power_restored"])),
    ("malformed_binding_upper", "commissioned_binding in upper-case hex.",
     {**GOOD, "commissioned_binding": BINDING.upper().replace("SHA256", "sha256")}),
    ("malformed_key_identity", "key_identity of 63 hex characters.", {**GOOD, "key_identity": GOOD["key_identity"][:-1]}),
    ("malformed_signature_short", "A signature of 63 bytes.", {**GOOD, "signature": b64(b"\x00" * 63)}),
    ("malformed_signature_noncanonical", "Base64 with nonzero pad bits.",
     {**GOOD, "signature": GOOD["signature"][:-3] + "B=="}),
):
    rcase(name, note, text(obj))
rcase("unknown_device", "The topic's device is not configured.", text(record(device=OTHER_DEVICE)), topic=OTHER_DEVICE)
rcase("device_mismatch", "The record names another configured device.", text(record(device=OTHER_DEVICE)),
      devices=(DEVICE, OTHER_DEVICE), pins={DEVICE: PUB_A, OTHER_DEVICE: PUB_B})
rcase("no_pinned_key", "No key is pinned for the device.", text(GOOD), pins={})
rcase("key_mismatch", "Signed by key B, which the record names, while A is pinned.", text(record(KEY_B)))
rcase("signature_invalid_other_key", "Signed by key B but naming key A.", text(record(KEY_B, key_identity=identity(PUB_A))))
rcase("signature_invalid_flipped", "A corrupted signature.",
      text({**GOOD, "signature": b64(bytes([base64.b64decode(GOOD["signature"])[0] ^ 1])
                                         + base64.b64decode(GOOD["signature"])[1:])}))
rcase("signature_invalid_no_domain", "Signed over the canonical bytes without the domain prefix.",
      text({**{k: v for k, v in GOOD.items() if k != "signature"},
            "signature": b64(KEY_A.sign(canonical({k: v for k, v in GOOD.items() if k != "signature"})))}))
_SIG = base64.b64decode(GOOD["signature"])
_S_PLUS_L = (int.from_bytes(_SIG[32:], "little") + ORDER).to_bytes(32, "little")
rcase("signature_invalid_s_not_reduced", "The signature's S plus the group order, a malleable form "
      "ed25519-verification/v1 refuses.", text({**GOOD, "signature": b64(_SIG[:32] + _S_PLUS_L)}))
for name, note, obj in (
    ("malformed_release_newline", "release with a trailing line feed.", {**GOOD, "release": "2.5.1\n"}),
    ("malformed_release_rc_leading_zero", "rc.01.", {**GOOD, "release": "2.5.1-rc.01"}),
    ("malformed_release_rc_zero", "rc.0, which no runtime release uses.", {**GOOD, "release": "2.5.1-rc.0"}),
    ("malformed_release_leading_zero", "01.2.3.", {**GOOD, "release": "01.2.3"}),
    ("malformed_device_empty", "An empty device_id.", {**GOOD, "device_id": ""}),
    ("malformed_device_angle", "A literal < in device_id: canonical, and outside the pattern.",
     {**GOOD, "device_id": "a<b"}),
    ("malformed_device_line_separator", "A literal U+2028 in device_id: canonical, and outside the pattern.",
     {**GOOD, "device_id": "a\u2028b"}),
):
    rcase(name, note, text(obj))
rcase("not_canonical_escaped_value", "A value with a character written as an escape the canonical form writes "
      "literally.", text(GOOD).replace('"production"', '"pr\\u006fduction"'))
rcase("not_canonical_escaped_name", "A member name written with an escape.", text(GOOD).replace('"v":1', '"\\u0076":1'))
rcase("skew_past_edge", "issued_at_ms exactly 300000 ms before the gateway's clock.", text(GOOD),
      wall=GOOD["issued_at_ms"] + SKEW_MS)
rcase("stale_timestamp", "One millisecond past the bound.", text(GOOD), wall=GOOD["issued_at_ms"] + SKEW_MS + 1)
rcase("skew_future_edge", "issued_at_ms exactly 300000 ms after the gateway's clock.", text(GOOD),
      wall=GOOD["issued_at_ms"] - SKEW_MS)
rcase("future_timestamp", "One millisecond past the bound.", text(GOOD), wall=GOOD["issued_at_ms"] - SKEW_MS - 1)
rcase("precedence_malformed_over_unknown_device", "A malformed record on an unconfigured device's topic.",
      text(record(device=OTHER_DEVICE, v=2)), topic=OTHER_DEVICE)
rcase("precedence_unknown_device_over_mismatch", "An unconfigured topic whose record names the configured device.",
      text(GOOD), topic=OTHER_DEVICE)
rcase("precedence_mismatch_over_no_pin", "A record naming another device on a configured topic that has no pin.",
      text(GOOD), topic=OTHER_DEVICE, devices=(DEVICE, OTHER_DEVICE), pins={DEVICE: PUB_A})
rcase("negated_key_mismatch", "Signed under A's negation and naming it while A is pinned: key_identity compares "
      "the encoding, so the negation is key_mismatch.", text(record(NEG_A)))
rcase("precedence_device_over_key", "Another device's record signed by an unpinned key: device_mismatch first.",
      text(record(KEY_B, device=OTHER_DEVICE)), devices=(DEVICE, OTHER_DEVICE),
      pins={DEVICE: PUB_A, OTHER_DEVICE: PUB_A})
rcase("precedence_key_over_signature", "key_mismatch before the signature is checked.",
      text({**record(KEY_B), "signature": b64(b"\x00" * 64)}))
rcase("precedence_signature_over_skew", "A bad signature on a stale record: signature first.",
      text({**GOOD, "signature": b64(b"\x00" * 64)}), wall=GOOD["issued_at_ms"] + SKEW_MS + 1)


# --- receiver sequences -------------------------------------------------------------------------
SEQUENCES: list[dict] = []


def rx(rec: dict, wall: int, mono: int, device: str = DEVICE, write: str | None = None) -> dict:
    ev = {"event": "receive", "topic_device": device, "record": text(rec), "wall_ms": wall, "mono_ms": mono}
    if write is not None:
        ev["store_write"] = write
    return ev


def store_read(wall: int, mono: int) -> dict:
    return {"event": "store_read_succeeds", "wall_ms": wall, "mono_ms": mono}


def store_written(wall: int, mono: int) -> dict:
    return {"event": "store_write_completes", "wall_ms": wall, "mono_ms": mono}


def observe(wall: int, mono: int) -> dict:
    return {"event": "observe", "wall_ms": wall, "mono_ms": mono}


def restart(wall: int, mono: int, pins: dict | None = None, devices: tuple | None = None,
            readable: bool = True) -> dict:
    ev = {"event": "restart", "wall_ms": wall, "mono_ms": mono}
    if not readable:
        ev["store_readable"] = False
    if pins is not None:
        ev["pinned_keys"] = {d: "ed25519:" + b64(p) for d, p in sorted(pins.items())}
    if devices is not None:
        ev["configured_devices"] = list(devices)
    return ev


def sequence(name: str, note: str, events: list, *, pins: dict | None = None, store_ok: bool = True,
             devices: tuple = (DEVICE,), store_condition: str = "unreadable") -> None:
    pins = {DEVICE: PUB_A} if pins is None else pins
    gw = Gateway(list(devices), pins, store_ok)
    out = []
    for ev in events:
        exp: dict = {}
        if ev["event"] == "receive":
            exp["verdict"] = gw.receive(ev["topic_device"], ev["record"], ev["wall_ms"], ev["mono_ms"],
                                        ev.get("store_write") in ("fails", "stalls"))
        elif ev["event"] == "restart":
            gw.restart({d: base64.b64decode(k[8:]) for d, k in ev["pinned_keys"].items()}
                       if "pinned_keys" in ev else None, ev.get("configured_devices"),
                       ev.get("store_readable", True))
        elif ev["event"] == "store_read_succeeds":
            if gw.store_mode == "unreadable":
                gw.store_mode, gw.states = None, copy.deepcopy(gw.durable)
        elif ev["event"] == "store_write_completes":
            if gw.store_mode == "unwritten":
                gw.store_mode = None
                gw.durable = copy.deepcopy(gw.states)
        exp["states"] = {d: gw.state(d, ev["wall_ms"], ev["mono_ms"]) for d in gw.devices}
        out.append({**ev, "expected": exp})
    seq = {"name": name, "note": note, "configured_devices": list(devices),
           "pinned_keys": {d: "ed25519:" + b64(p) for d, p in sorted(pins.items())},
           "store_readable": store_ok, "events": out}
    if not store_ok:
        seq["store_condition"] = store_condition
    SEQUENCES.append(seq)


