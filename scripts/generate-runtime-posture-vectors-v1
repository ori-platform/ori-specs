# --- operator-socket/v3 runtime_device_key ---------------------------------------------------------
READBACK_CASES: list[dict] = []
BOUND = 16_384


def readback(request: str, peer: str | None, key_loaded: bool) -> dict:
    # `request` is the frame's body, the bytes before its first LF; the framing is operator-socket/v3's.
    if "\n" in request:
        raise ValueError("a request body holds no LF")
    raw_req = request.encode("utf-8")
    def refused(code: str) -> dict:
        return {"schema_version": 1, "ok": False, "error": {"code": code}}
    if len(raw_req) > BOUND:
        return refused("payload_too_large")
    def pairs(items: list) -> dict:
        names = [k for k, _ in items]
        if len(set(names)) != len(names):
            raise ValueError("member named twice")
        return dict(items)
    try:
        obj = json.loads(raw_req, object_pairs_hook=pairs)
    except ValueError:
        return refused("invalid_arguments")
    if not (isinstance(obj, dict) and set(obj) == {"operation"} and obj["operation"] == "runtime_device_key"):
        return refused("invalid_arguments")
    if peer not in ("root", "operator"):
        return refused("unauthenticated")
    if not key_loaded:
        return refused("key_unavailable")
    return {"schema_version": 1, "ok": True,
            "result": {"device_id": DEVICE, "public_key": KA, "key_identity": identity(PUB_A)}}


def kcase(name: str, note: str, request: str, peer: str | None = "operator", key_loaded: bool = True) -> None:
    READBACK_CASES.append({"name": name, "note": note, "request": request, "peer": peer,
                           "key_loaded": key_loaded, "device_id": DEVICE, "posture_key": KA,
                           "expected": readback(request, peer, key_loaded)})


REQ = '{"operation":"runtime_device_key"}'
kcase("readback", "The installed operator reads the key.", REQ)
kcase("readback_root", "Root reads the key.", REQ, "root")
kcase("extra_member", "A member the operation does not accept.", '{"operation":"runtime_device_key","x":1}')
kcase("unadmitted_peer", "Another user.", REQ, "other")
kcase("no_peer_credentials", "Peer credentials cannot be established.", REQ, None)
kcase("key_not_loaded", "The posture key is not loaded in this run.", REQ, "operator", False)
kcase("form_before_caller", "An unaccepted member from an unadmitted peer: form first.",
      '{"operation":"runtime_device_key","x":1}', "other")
kcase("caller_before_key", "An unadmitted peer while the key is not loaded: the caller first.", REQ, "other", False)
kcase("over_bound", "A request over 16384 bytes.", REQ[:-1] + " " * (BOUND - len(REQ) + 1) + "}")
kcase("operation_twice", "The operation member named twice.",
      '{"operation":"runtime_device_key","operation":"runtime_device_key"}')
kcase("operation_case_variant", "A member that differs from operation only in case.", '{"Operation":"runtime_device_key"}')
kcase("operation_escaped", "operation written with an escape is operation.", '{"\\u006fperation":"runtime_device_key"}')
kcase("over_bound_before_form", "Over the bound and not JSON: the bound is decided first.", "x" * (BOUND + 1))


def build() -> dict:
    return {
        "contract": "runtime-posture/v1",
        "note": {
            "keys": ("Ed25519 private keys are SHA-256 of 'ori runtime-posture/v1 <label> test key', labels "
                     "'posture A' and 'posture B'. Test keys only."),
            "records": ("Each record case is one message on the topic of `topic_device`, judged at checks 3 to 10 "
                        "of Receiving by a gateway configured with `configured_devices` and `pinned_keys` whose "
                        "wall clock reads `gateway_wall_ms`; `expected` is `pass` or the reason. Checks 1 and 2 are "
                        "gateway-api/v2's corpora's."),
            "sequences": ("Each sequence runs its events in order against one gateway. `receive` judges a message "
                          "and gives its verdict, its store write failing when `store_write` is `fails`, or "
                          "outstanding past 1000 ms when it is `stalls`, whose `states` are those once that bound has "
                          "passed; `observe` "
                          "reads the state; `restart` restarts the gateway, resetting its monotonic clock and its "
                          "last refusals, starting from the store as it was last written, finding it unreadable "
                          "when `store_readable` is false, and installs `pinned_keys` and `configured_devices` "
                          "when given; "
                          "`store_read_succeeds` is a read of an unreadable store that succeeds, finding the "
                          "store as it was last written, which is empty when the sequence starts unreadable; and "
                          "`store_write_completes` a write of the state in memory that completes, either the "
                          "outstanding one or a retry. The two causes never hold together. `store_readable` false "
                          "starts with the store unreadable, for the reason `store_condition` names. A write that "
                          "would change nothing durable is not made, so `store_write` has no effect on it. "
                          "`wall_ms` and `mono_ms` are the "
                          "gateway's wall and monotonic clocks at the event. `expected` holds the verdict, for a "
                          "receive, and in `states` the state of each device configured after the event, each a "
                          "judgement the gateway makes then, so a record that reads `stale` stays `stale` until a "
                          "fresh one is accepted, with "
                          "`reason`, `record_b64`, `received_at_ms`, `last_refusal` and `last_refusal_at_ms` as Carriage gives "
                          "them: each is the device's `posture_record` in Site Health, and its object in the LAN "
                          "posture body without `device_id`."),
            "config": ("gateway-config/v2 posture key load rules, after gateway.state_directory's, whose value "
                       "here is null or one absolute path of printable ASCII with no space; gateway-config/v2's "
                       "state-directory corpus judges every other value. With "
                       "gateway.auth and evidence disabled: `valid`, and `rule` when refused. `runtime_keys` "
                       "lists its entries in the order they are written."),
            "readback": ("Owned by the runtime, which serves it; a gateway does not consume these cases. "
                         "`request` is the frame's body, the bytes before its first LF, and holds no LF; the "
                         "socket's framing is operator-socket/v3's and is not judged here. "
                         "operator-socket/v3 runtime_device_key: the request bytes, the peer (`root`, "
                         "`operator`, `other` or null when credentials cannot be established), whether the "
                         "posture key is loaded, the device and key it would answer, and the answer, whose "
                         "`detail` is never compared."),
        },
        "test_keys": {"A": {"public_key": KA, "key_identity": identity(PUB_A)},
                      "B": {"public_key": KB, "key_identity": identity(PUB_B)}},
        "records": RECORD_CASES,
        "sequences": SEQUENCES,
        "config": CONFIG_CASES,
        "readback": READBACK_CASES,
    }


def render() -> bytes:
    return (json.dumps(build(), indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = render()
    if argv[1:] == ["--check"]:
        if not OUT.exists() or OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator", file=sys.stderr)
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
