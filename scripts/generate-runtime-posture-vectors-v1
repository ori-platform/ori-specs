# --- gateway-config/v2 posture key load rules ------------------------------------------------------
CONFIG_CASES: list[dict] = []


def config_verdict(devices: list, keys: dict, state_dir: object) -> str | None:
    # gateway.state_directory's load rules come first. These cases hold its value to absent or one plain
    # absolute path; its own corpus judges every other value.
    if not (state_dir is None or (isinstance(state_dir, str) and state_dir.startswith("/")
                                  and all(0x21 <= ord(c) <= 0x7e for c in state_dir))):
        raise ValueError("state_directory outside this corpus's scope")
    if keys and not state_dir:
        return "required_under_posture"
    seen: dict[bytes, str] = {}
    for dev in sorted(keys):
        val = keys[dev]
        if dev not in devices:
            return "unknown_device"
        if not (isinstance(val, str) and val.startswith("ed25519:") and canonical_b64(val[8:], 32)):
            return "malformed_key"
        pub = base64.b64decode(val[8:])
        if pub == INADMISSIBLE:
            return "inadmissible_key"
    for dev in sorted(keys):
        rk = recognised(base64.b64decode(keys[dev][8:]))
        if rk in seen:
            return "duplicate_key"
        seen[rk] = dev
    return None


def ccase(name: str, note: str, devices: list, keys: dict, state_dir: object = "/var/lib/ori-gateway/state") -> None:
    v = config_verdict(devices, keys, state_dir)
    CONFIG_CASES.append({"name": name, "note": note, "device_ids": devices, "runtime_keys": keys,
                         "state_directory": state_dir, "valid": v is None, **({"rule": v} if v else {})})


KA, KB = "ed25519:" + b64(PUB_A), "ed25519:" + b64(PUB_B)
NEG_A = PUB_A[:31] + bytes([PUB_A[31] ^ 0x80])
