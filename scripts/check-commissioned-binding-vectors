#!/usr/bin/env python3
"""Check the commissioned-safety-binding/v2 corpus against the contract.

The corpus is the normative fixture for this contract, and until now it was
checked only inside a consumer repository. A hand edit here would travel to
every consumer at the next re-vendor, arriving as a contract change nobody
wrote. This script holds the corpus to the rules the contract states, in the
repository that owns it:

- every recorded byte string reproduces from the document beside it, so a
  document and its `canonical_hex`, `canonical_sha256` and `message_hex`
  cannot drift apart;
- every signature verifies, or fails, exactly as `signature_valid` declares,
  and a case refused after the signature stage must carry a valid one;
- every reason maps to the one stage the contract decides it at, and every
  stage in each declared acceptance order has at least one case that stops
  there;
- every number is spelled as its field's declared type requires, which is the
  rule a decoded corpus cannot otherwise show;
- every `raw_reject_cases` entry really is raw: its bytes must not be the
  canonical form of what they decode to, or must not decode at all. An entry
  that is already canonical proves nothing a decoded case could not.

It also holds the corpus to a table of misreadings of the revision rule: each
revision vector is decided under the rule and under every misreading, and each
misreading must decide some vector against its declared verdict.

It is deliberately **not** a third implementation of the twelve stages. The
runtime's verifier is the first implementation and ori-cli's Go verifier is the
independent second; this script checks that the fixture those two are held to
says what the contract says.

Run from the repository root:

    python3 scripts/check-commissioned-binding-vectors

Requires the `cryptography` package for Ed25519 verification; it refuses to run
without it rather than skipping the signatures. Exits non-zero on the first
unmet requirement, so it is usable as a gate.
"""

from __future__ import annotations

import json
import pathlib
import sys
import types
from typing import Any

try:
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
except ImportError:  # pragma: no cover - the gate must not pass silently
    print(
        "check-commissioned-binding-vectors: the cryptography package is required",
        file=sys.stderr,
    )
    sys.exit(1)

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "commissioned-safety-binding" / "binding-vectors-v2.json"

# The contract's error-semantics table: one stage decides each reason.
VERDICT_STAGE = {
    "malformed": "parses",
    "wrong_device": "device_id",
    "anchor_collision": "key_selection",
    "unknown_signer": "key_selection",
    "bad_signature": "signature",
    "wrong_authority": "authority",
    "superseded_signer": "authority",
    "stale": "freshness",
    "mapping_contradiction": "mapping_self_consistency",
    "proof_contradiction": "proof_consistency",
    "stale_proof": "proof_consistency",
    "out_of_bounds": "bounds",
    "ambiguous_binding": "disambiguation",
    "unknown_hardware": "inventory",
    "unbound_actuator": "inventory",
    "undemonstrated_binding": "activation_posture",
}
PROFILE_VERDICT_STAGE = {
    "malformed": "parses",
    "wrong_device": "device_binding",
    "profile_channel_mismatch": "device_binding",
    "anchor_collision": "key_selection",
    "unknown_signer": "key_selection",
    "bad_signature": "signature",
    "wrong_authority": "authority",
    "superseded_signer": "authority",
    "profile_binding_mismatch": "binding_match",
    "profile_mapping_mismatch": "mapping_match",
}

# The field-type table. A number's spelling follows the field's declared type,
# not its value, so the two sets are what decide whether a literal is legal.
INTEGER_FIELDS = {
    "v",
    "binding_seq",
    "issued_at_ms",
    "inventory_generation",
    "performed_at_ms",
    "gpio_pin",
}
NUMBER_FIELDS = {
    "value",
    "range_min",
    "range_max",
    "noise_floor",
    "sensor_before",
    "sensor_after",
}

CONTROL_METHODS = {"commanded_and_observed", "undemonstrated"}

failures: list[str] = []


def fail(message: str) -> None:
    failures.append(message)


class Literal:
    """A JSON number with the spelling it was written with."""

    def __init__(self, text: str) -> None:
        self.text = text


def canonical(value: Any) -> bytes:
    """The contract's canonical form: sorted keys, no insignificant space."""
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def literals(node: Any, path: str = "") -> Any:
    """Every number in the tree, with its path and its spelling."""
    if isinstance(node, Literal):
        yield path, node.text
    elif isinstance(node, dict):
        for key, value in node.items():
            yield from literals(value, f"{path}.{key}")
    elif isinstance(node, list):
        for index, value in enumerate(node):
            yield from literals(value, f"{path}[{index}]")


def check_number_spelling(label: str, raw: bytes) -> None:
    """Every number is spelled as its field's declared type requires."""
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        fail(f"{label}: canonical bytes are not valid UTF-8")
        return
    decoded = json.loads(text, parse_float=Literal, parse_int=Literal)
    for path, spelling in literals(decoded):
        field = path.rsplit(".", 1)[-1].split("[")[0]
        fractional = "." in spelling
        exponent = "e" in spelling.lower()
        if field in INTEGER_FIELDS:
            if fractional or exponent:
                fail(
                    f"{label}: {path} is an integer field spelled {spelling!r}; "
                    "an integer carries no fractional part and no exponent"
                )
            elif spelling != str(int(spelling)):
                fail(f"{label}: {path} spelled {spelling!r}, not its shortest form")
        elif field in NUMBER_FIELDS:
            if exponent:
                fail(
                    f"{label}: {path} is a number field spelled {spelling!r}; "
                    "exponent notation never appears on the wire"
                )
            elif not fractional:
                fail(
                    f"{label}: {path} is a number field spelled {spelling!r}; "
                    "a number carries a mandatory fractional part"
                )
            elif spelling != repr(float(spelling)):
                fail(f"{label}: {path} spelled {spelling!r}, not its shortest form")
        else:
            fail(f"{label}: {path} is a number in no field the type table declares")


def verifies(public_key_hex: str, signature_b64: str, message: bytes) -> bool:
    import base64

    try:
        Ed25519PublicKey.from_public_bytes(bytes.fromhex(public_key_hex)).verify(
            base64.b64decode(signature_b64), message
        )
    except (InvalidSignature, ValueError):
        return False
    return True


def check_document_case(corpus: dict, case: dict, key: str, label: str) -> None:
    """Recorded bytes reproduce, and the signature is what the case claims.

    The spelling rule is applied to every case except the ones whose declared
    verdict is `malformed`, where a spelling the grammar refuses may be the
    point. Everywhere else a bad spelling would refuse the document at `parses`
    — before the stage the case claims to exercise — so the case would prove
    nothing about the rule it names.
    """
    document = case[key]
    body = canonical(document)
    if body.hex() != case["canonical_hex"]:
        fail(f"{label}: canonical_hex does not reproduce from the document")
        return
    if "canonical_sha256" in case:
        import hashlib

        want = "sha256:" + hashlib.sha256(body).hexdigest()
        if case["canonical_sha256"] != want:
            fail(f"{label}: canonical_sha256 is not the digest of its own bytes")
    if "message_hex" in case:
        envelope = {key: document, "signature": "ed25519:" + case["signature_b64"]}
        if canonical(envelope).hex() != case["message_hex"]:
            fail(f"{label}: message_hex does not reproduce from the envelope")

    if case.get("reason") != "malformed":
        check_number_spelling(label, body)

    # The signature is checked against the key the document names, which is the
    # only key a consumer would select for it.
    named = document.get("signing_key", "")
    if not isinstance(named, str) or not named.startswith("ed25519:"):
        return
    import base64

    try:
        key_hex = base64.b64decode(named.removeprefix("ed25519:"), validate=True).hex()
    except Exception:  # noqa: BLE001 - a malformed key is a case, not a crash
        return
    if len(key_hex) != 64:
        return
    valid = verifies(key_hex, case["signature_b64"], body)
    declared = case.get("signature_valid")
    if declared is not None and valid != declared:
        fail(
            f"{label}: signature_valid says {declared} and the signature "
            f"{'verifies' if valid else 'does not verify'}"
        )


def check_stage(case: dict, table: dict, order: list, label: str) -> None:
    reason, stage = case["reason"], case["stage"]
    if reason not in table:
        fail(f"{label}: refuses with {reason!r}, which the contract does not define")
        return
    if table[reason] != stage:
        fail(
            f"{label}: names stage {stage!r} for {reason!r}; the contract "
            f"decides it at {table[reason]!r}"
        )
    if stage not in order:
        fail(f"{label}: stage {stage!r} is not in the declared acceptance order")
        return
    declared = case.get("signature_valid")
    if declared is False and order.index(stage) > order.index("signature"):
        fail(
            f"{label}: refused after the signature stage while declaring the "
            "signature invalid; the stage could not have been reached"
        )


def control_leg(zone: Any) -> Any:
    proof = zone.get("proof") if isinstance(zone, dict) else None
    return proof.get("control_path") if isinstance(proof, dict) else None


def expected_state(binding: Any) -> str:
    """Verification is not authority, recomputed from the contract's rule.

    A binding is in force only when **both** legs are proven for every zone,
    and only a `local_gpio` zone can prove a control leg: the method names an
    operation that has no design for a firmware channel.

    Neither leg substitutes for the other. A proven control leg over an
    undemonstrated circuit leg means the pin is known to move the coil and
    nothing is known about which circuit that coil switches, so commanding it
    opens an unidentified one — the transposition hazard, reached by a route
    that looks well proven.
    """
    for zone in binding.get("zones", []):
        proof = zone.get("proof") if isinstance(zone, dict) else None
        if not isinstance(proof, dict) or proof.get("method") == "undemonstrated":
            return "provisional"
        leg = control_leg(zone)
        if not isinstance(leg, dict) or leg.get("method") != "commanded_and_observed":
            return "provisional"
        if zone.get("actuator", {}).get("kind") != "local_gpio":
            return "provisional"
    return "in_force"


def whole(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def retained_row(case: dict, zone_id: str) -> Any:
    state = case.get("verifier_context", {}).get("accepted_zone_state") or {}
    return state.get(zone_id)


def outcomes_in(leg: Any) -> set:
    if not isinstance(leg, dict):
        return set()
    return {
        o.get("commanded") for o in leg.get("observations", []) if isinstance(o, dict)
    }


def coil_disagrees(zone: Any, leg: Any) -> bool:
    """One observation records a coil state the mapping assigns to the other outcome."""
    if not isinstance(leg, dict) or not isinstance(zone, dict):
        return False
    mapping = zone.get("actuator", {}).get("commissioned_mapping", {})
    return any(
        isinstance(o, dict) and o.get("coil_state") != mapping.get(o.get("commanded"))
        for o in leg.get("observations", [])
    )


def check_per_leg_coverage(corpus: dict) -> None:
    """Every rule the control leg inherits by reference needs its own vector.

    The contract binds the control leg with "checked by the same rules", so a
    consumer implementing it as a separate code path is conforming in intent
    and divergent in fact. Circuit-leg coverage standing in for both is the
    failure this check exists to refuse, so each rule is required in each leg.
    """
    found = {
        ("one_sided", "circuit"): [],
        ("one_sided", "control"): [],
        ("coil", "circuit"): [],
        ("coil", "control"): [],
    }
    for case in corpus["reject_cases"]:
        if (case.get("stage"), case.get("reason")) != (
            "proof_consistency",
            "proof_contradiction",
        ):
            continue
        for zone in case["binding"].get("zones", []):
            proof = zone.get("proof") if isinstance(zone, dict) else None
            if not isinstance(proof, dict):
                continue
            legs = {"circuit": proof, "control": control_leg(zone)}
            for which, leg in legs.items():
                if not isinstance(leg, dict):
                    continue
                if leg.get("method") in ("undemonstrated", None):
                    continue
                if len(outcomes_in(leg)) == 1:
                    found[("one_sided", which)].append(case["name"])
                if coil_disagrees(zone, leg):
                    found[("coil", which)].append(case["name"])

    wanted = {
        ("one_sided", "circuit"): "a circuit leg observing one outcome",
        ("one_sided", "control"): "a control leg observing one outcome",
        ("coil", "circuit"): "a circuit-leg coil_state disagreeing with the mapping",
        ("coil", "control"): "a control-leg coil_state disagreeing with the mapping",
    }
    for key, described in wanted.items():
        if not found[key]:
            fail(
                f"reject_cases: no proof_contradiction case carries {described} -- "
                "the rule is stated once and binds both legs, so coverage of one "
                "leg holds no consumer to the other"
            )

    # An accept case carrying either shape would publish, as a conforming
    # fixture, exactly what the contract forbids.
    for case in corpus["cases"]:
        for zone in case["binding"].get("zones", []):
            proof = zone.get("proof") if isinstance(zone, dict) else None
            if not isinstance(proof, dict):
                continue
            for which, leg in (("circuit", proof), ("control", control_leg(zone))):
                if not isinstance(leg, dict) or leg.get("method") in (
                    "undemonstrated",
                    None,
                ):
                    continue
                if len(outcomes_in(leg)) == 1:
                    fail(
                        f"{case['name']}: an accept case carries a one-sided "
                        f"{which} leg"
                    )
                if coil_disagrees(zone, leg):
                    fail(
                        f"{case['name']}: an accept case carries a {which}-leg "
                        "coil_state disagreeing with the mapping"
                    )


def check_revision_freshness(corpus: dict) -> None:
    """A revision is stale leg by leg, and the corpus must show which leg decided.

    A `stale_proof` vector whose circuit leg is also stale proves the circuit
    rule twice and the control rule not at all, so the control-leg case is
    required to carry a circuit leg that is demonstrably fresh.
    """
    for case in corpus["cases"] + corpus["reject_cases"]:
        for zone_id, row in (
            case.get("verifier_context", {}).get("accepted_zone_state") or {}
        ).items():
            at_ms = row.get("control_proof_at_ms")
            if at_ms is None:
                continue
            if not whole(at_ms):
                fail(
                    f"{case['name']}: accepted_zone_state[{zone_id}]."
                    "control_proof_at_ms is not a whole number"
                )

    decided_by_control = []
    for case in corpus["reject_cases"]:
        if case.get("reason") != "stale_proof":
            continue
        for zone in case["binding"].get("zones", []):
            row = retained_row(case, zone.get("zone_id"))
            leg = control_leg(zone)
            if not isinstance(row, dict) or not isinstance(leg, dict):
                continue
            if leg.get("method") != "commanded_and_observed":
                continue
            was_control = row.get("control_proof_at_ms")
            if was_control is None:
                continue
            times = (
                zone["proof"].get("performed_at_ms"),
                row.get("proof_at_ms"),
                leg.get("performed_at_ms"),
                was_control,
            )
            if not all(whole(t) for t in times):
                continue
            circuit_fresh = times[0] > times[1]
            control_stale = times[2] <= times[3]
            if circuit_fresh and control_stale:
                decided_by_control.append(case["name"])

    if not decided_by_control:
        fail(
            "reject_cases: no stale_proof case is decided by the control leg "
            "alone -- a revision reusing a control proof taken at the old "
            "polarity would reach in force uncontradicted"
        )

    if not any(
        case.get("expected_state") == "in_force"
        and any(
            isinstance(retained_row(case, z.get("zone_id")), dict)
            for z in case["binding"].get("zones", [])
        )
        for case in corpus["cases"]
    ):
        fail(
            "cases: no revision with both legs refreshed reaches in force -- "
            "the rule would be indistinguishable from refusing every revision"
        )


def zone_changes(zone: Any, row: Any) -> set:
    """Which retained parts of a zone a revision changed."""
    actuator = zone.get("actuator", {})
    changed = set()
    if row.get("identity") != actuator.get("identity"):
        changed.add("identity")
    if row.get("mapping") != actuator.get("commissioned_mapping"):
        changed.add("mapping")
    if row.get("sensor") != zone.get("sensor"):
        changed.add("sensor")
    return changed


def legs_carried(zone: Any, row: Any) -> bool:
    """Neither leg is later than the retained proof it would have to replace."""
    leg = control_leg(zone)
    circuit = zone.get("proof", {}).get("performed_at_ms")
    if not whole(circuit) or not whole(row.get("proof_at_ms")):
        return False
    if circuit > row["proof_at_ms"]:
        return False
    if isinstance(leg, dict) and whole(row.get("control_proof_at_ms")):
        return leg.get("performed_at_ms", 0) <= row["control_proof_at_ms"]
    return True


def check_retained_sensor(corpus: dict) -> None:
    """The revision rule covers the whole sensor, so retention must hold it.

    A retained row that kept only `calibration_ref` could not decide a revision
    that rebinds the zone to another sensor, and the corpus would teach a
    consumer to retain too little. Two properties pin the rule's edges: a
    sensor change with carried legs is refused, decided by the sensor alone,
    and some accepted revision carries a proof on a zone it left unchanged,
    since a rule that refused every carried proof would satisfy the first by
    itself.
    """
    for case in corpus["cases"] + corpus["reject_cases"]:
        for zone_id, row in (
            case.get("verifier_context", {}).get("accepted_zone_state") or {}
        ).items():
            if "calibration_ref" in row:
                fail(
                    f"{case['name']}: accepted_zone_state[{zone_id}] keeps "
                    "calibration_ref beside the sensor; it belongs inside it"
                )
            if not isinstance(row.get("sensor"), dict):
                fail(
                    f"{case['name']}: accepted_zone_state[{zone_id}] does not "
                    "retain the zone's sensor"
                )

    decided_by_sensor = [
        case["name"]
        for case in corpus["reject_cases"]
        if case.get("reason") == "stale_proof"
        and any(
            isinstance(row := retained_row(case, zone.get("zone_id")), dict)
            and zone_changes(zone, row) == {"sensor"}
            and legs_carried(zone, row)
            for zone in case["binding"].get("zones", [])
        )
    ]
    if not decided_by_sensor:
        fail(
            "reject_cases: no stale_proof case is decided by a sensor change "
            "alone -- a revision rebinding a zone to another clamp would carry "
            "its proof uncontradicted"
        )

    capacity_only = [
        case["name"]
        for case in corpus["cases"]
        if any(
            isinstance(row := retained_row(case, zone.get("zone_id")), dict)
            and not zone_changes(zone, row)
            and legs_carried(zone, row)
            for zone in case["binding"].get("zones", [])
        )
    ]
    if not capacity_only:
        fail(
            "cases: no revision carrying its proof is accepted -- the rule "
            "would be indistinguishable from refusing every carried proof"
        )


def same_actuator(retained: Any, identity: Any) -> bool:
    """One actuator as the inventory reads it: a GPIO line by its pin alone."""
    if not isinstance(retained, dict) or not isinstance(identity, dict):
        return False
    if "gpio_pin" in retained and "gpio_pin" in identity:
        return retained["gpio_pin"] == identity["gpio_pin"]
    return retained == identity


def match_ways(zone: Any, zone_id: str, row: Any) -> set:
    """How a revision's zone finds a retained zone: by name, actuator or sensor."""
    ways = set()
    if zone_id == zone.get("zone_id"):
        ways.add("name")
    if same_actuator(row.get("identity"), zone.get("actuator", {}).get("identity")):
        ways.add("actuator")
    if row.get("sensor", {}).get("sensor_id") == zone.get("sensor", {}).get("sensor_id"):
        ways.add("sensor")
    return ways


def claimed_circuit(zone: Any) -> bool:
    return zone.get("proof", {}).get("method") not in (None, "undemonstrated")


def stale_against(zone: Any, row: Any) -> bool:
    """A change against this retained zone that a claimed leg does not follow."""
    if not zone_changes(zone, row):
        return False
    circuit = zone.get("proof", {}).get("performed_at_ms")
    if claimed_circuit(zone) and whole(circuit) and circuit <= row.get("proof_at_ms", 0):
        return True
    leg = control_leg(zone)
    at = row.get("control_proof_at_ms")
    return (
        isinstance(leg, dict)
        and leg.get("method") == "commanded_and_observed"
        and whole(at)
        and leg.get("performed_at_ms", 0) <= at
    )


def matches(case: dict, zone: Any) -> list:
    """Every retained zone this one is held to, in the retained record's order."""
    state = case.get("verifier_context", {}).get("accepted_zone_state") or {}
    return [
        (zone_id, row)
        for zone_id, row in state.items()
        if match_ways(zone, zone_id, row)
    ]


def check_retained_matching(corpus: dict) -> None:
    """Hold the corpus to every clause of the revision rule, each on its own.

    A refused revision is credited only on the retained zone that decides it,
    and there must be exactly one: crediting any matching zone lets a padded
    case satisfy an isolation it does not exercise. From that one pair the
    checker requires, each at least once:

    - the zone found by its name alone, by a GPIO pin alone while the identity
      differs as a whole, by a firmware identity alone, and by its sensor alone,
      once while the sensor otherwise differs, so a consumer matching the whole
      sensor finds nothing;
    - a change to a GPIO identity, a firmware identity, the mapping and the
      sensor, each alone with legs carried;
    - a change that is not to the actuator decided by a stale control leg
      behind a fresh circuit leg;
    - a zone held to every match: the deciding zone neither the first nor the
      last of three or more matches.

    Accepted revisions must show a pure rename carrying its proof, a changed
    zone after a record with no control time, an unclaimed stale leg left
    provisional, and firmware actuators on the same board or channel that
    match nothing. Every retained record must itself be disambiguated.
    """
    for case in corpus["cases"] + corpus["reject_cases"]:
        state = case.get("verifier_context", {}).get("accepted_zone_state") or {}
        pins, firmware, sensors = [], [], []
        for row in state.values():
            identity = row.get("identity", {})
            if "gpio_pin" in identity:
                pins.append(identity["gpio_pin"])
            else:
                firmware.append(json.dumps(identity, sort_keys=True))
            sensors.append(row.get("sensor", {}).get("sensor_id"))
        for label, values in (("pin", pins), ("firmware identity", firmware), ("sensor_id", sensors)):
            if len(values) != len(set(values)):
                fail(f"{case['name']}: accepted_zone_state repeats a {label}")

    found: set = set()
    for case in corpus["reject_cases"]:
        if case.get("reason") != "stale_proof":
            continue
        if not case.get("verifier_context", {}).get("accepted_zone_state"):
            continue
        decisive = []
        for zone in case["binding"].get("zones", []):
            held = matches(case, zone)
            for index, (zone_id, row) in enumerate(held):
                if stale_against(zone, row):
                    decisive.append((zone, zone_id, row, index, len(held)))
        if len(decisive) != 1:
            fail(
                f"{case['name']}: {len(decisive)} retained zones decide this "
                "case; exactly one must, so each isolation is credited once"
            )
            continue
        zone, zone_id, row, index, count = decisive[0]
        ways = match_ways(zone, zone_id, row)
        identity = zone.get("actuator", {}).get("identity", {})
        gpio = "gpio_pin" in identity
        if ways == {"name"}:
            found.add("found by name alone")
        elif ways == {"sensor"}:
            found.add("found by sensor alone")
            if row.get("sensor") != zone.get("sensor"):
                found.add("found by sensor_id while the sensor differs")
        elif ways == {"actuator"} and gpio and row.get("identity") != identity:
            found.add("found by a GPIO pin alone")
        elif ways == {"actuator"} and not gpio:
            found.add("found by a firmware identity alone")
        changes = zone_changes(zone, row)
        if len(changes) == 1 and legs_carried(zone, row):
            (only,) = changes
            if only == "identity":
                only = "a GPIO identity" if gpio else "a firmware identity"
            found.add(f"{only} changed alone")
        circuit = zone.get("proof", {}).get("performed_at_ms", 0)
        if "identity" not in changes and claimed_circuit(zone) and circuit > row.get("proof_at_ms", 0):
            found.add("decided by the control leg for a change not to the actuator")
        if count >= 3 and 0 < index < count - 1:
            found.add("held to every match")
    for need in (
        "found by name alone",
        "found by sensor alone",
        "found by sensor_id while the sensor differs",
        "found by a GPIO pin alone",
        "found by a firmware identity alone",
        "a GPIO identity changed alone",
        "a firmware identity changed alone",
        "mapping changed alone",
        "sensor changed alone",
        "decided by the control leg for a change not to the actuator",
        "held to every match",
    ):
        if need not in found:
            fail(f"reject_cases: no stale_proof case is {need}")

    accepted: set = set()
    for case in corpus["cases"]:
        state = case.get("verifier_context", {}).get("accepted_zone_state") or {}
        if not state:
            continue
        for zone in case["binding"].get("zones", []):
            identity = zone.get("actuator", {}).get("identity", {})
            held = matches(case, zone)
            for zone_id, row in held:
                ways = match_ways(zone, zone_id, row)
                changes = zone_changes(zone, row)
                if "name" not in ways and not changes:
                    accepted.add("a pure rename carrying its proof")
                if changes and "control_proof_at_ms" not in row and control_leg(zone):
                    accepted.add("a change after a record with no control time")
                if (
                    changes
                    and not claimed_circuit(zone)
                    and zone.get("proof", {}).get("performed_at_ms", 0)
                    <= row.get("proof_at_ms", 0)
                ):
                    accepted.add("an unclaimed stale leg left provisional")
            if held or "channel" not in identity:
                continue
            for row in state.values():
                was = row.get("identity", {})
                if was.get("channel") == identity.get("channel") and was != identity:
                    accepted.add("the same channel on another board matching nothing")
                if (
                    was.get("firmware_device_id") == identity.get("firmware_device_id")
                    and was != identity
                ):
                    accepted.add("another channel on the same board matching nothing")
    for need in (
        "a pure rename carrying its proof",
        "a change after a record with no control time",
        "an unclaimed stale leg left provisional",
        "the same channel on another board matching nothing",
        "another channel on the same board matching nothing",
    ):
        if need not in accepted:
            fail(f"cases: no accepted revision shows {need}")


# ── misreadings of the revision rule ─────────────────────────────────────────
#
# The rule as the contract states it, and a table of ways a consumer could read
# it wrongly. Each revision vector is decided under the rule and under every
# misreading, and each misreading must decide some vector against its declared
# verdict. A structural requirement on the corpus says a case of some shape
# exists; this says the case actually separates the right reading from a wrong
# one, which an edit to a retained time or order can silently undo.


class Stale(Exception):
    """The revision rule refuses the document as stale_proof."""


MISREADINGS = ROOT / "commissioned-safety-binding" / "revision-misreadings-v2.json"


def rule_switches(raw: dict) -> dict:
    """A rule from the published table, with its collections made comparable."""
    rule = dict(raw)
    rule["exempt"] = tuple(tuple(pair) for pair in raw.get("exempt", ()))
    rule["exempt_sets"] = tuple(
        (leg, frozenset(fields)) for leg, fields in raw.get("exempt_sets", ())
    )
    rule["exempt_at_least"] = tuple(tuple(pair) for pair in raw.get("exempt_at_least", ()))
    rule["exempt_postures"] = tuple(tuple(pair) for pair in raw.get("exempt_postures", ()))
    rule["exempt_kind_change"] = tuple(raw.get("exempt_kind_change", ()))
    return rule


TABLE = json.loads(MISREADINGS.read_text())
REFERENCE = rule_switches(TABLE["reference"])
CHANGE_EVENTS = {name: frozenset(fields) for name, fields in TABLE["change_events"].items()}
MUTANTS = TABLE["misreadings"]


def _same_actuator(retained: dict, identity: dict, rule: dict) -> bool:
    if "gpio_pin" in retained and "gpio_pin" in identity:
        if rule["gpio_match"] == "whole":
            return retained == identity
        return bool(retained["gpio_pin"] == identity["gpio_pin"])
    if rule["firmware_match"] == "board":
        return retained.get("firmware_device_id") == identity.get("firmware_device_id")
    if rule["firmware_match"] == "channel":
        return retained.get("channel") == identity.get("channel")
    return retained == identity


def _same_sensor(was: Any, sensor: dict, rule: dict) -> bool:
    if rule["sensor_match"] == "whole":
        return bool(was.sensor == sensor)
    if rule["sensor_match"].startswith("id_and:"):
        field = rule["sensor_match"].removeprefix("id_and:")
        return bool(
            was.sensor.get("sensor_id") == sensor["sensor_id"]
            and was.sensor.get(field) == sensor.get(field)
        )
    return bool(was.sensor.get("sensor_id") == sensor["sensor_id"])


def _ways(zone_id: str, was: Any, zone: dict, rule: dict) -> set:
    ways = set()
    if rule["match_name"] and zone_id == zone["zone_id"]:
        ways.add("name")
    if rule["match_actuator"] and _same_actuator(
        was.identity, zone["actuator"]["identity"], rule
    ):
        ways.add("actuator")
    if rule["match_sensor"] and _same_sensor(was, zone["sensor"], rule):
        ways.add("sensor")
    return ways


def _identity_differs(was: dict, now: dict, rule: dict) -> bool:
    if rule["identity_compare"] == "ignore_board":
        was = {k: v for k, v in was.items() if k != "firmware_device_id"}
        now = {k: v for k, v in now.items() if k != "firmware_device_id"}
    if rule["identity_compare"] == "ignore_channel":
        was = {k: v for k, v in was.items() if k != "channel"}
        now = {k: v for k, v in now.items() if k != "channel"}
    return was != now


def _changes(zone_id: str, was: Any, zone: dict, rule: dict) -> set:
    changed = set()
    if rule["change_identity"] and _identity_differs(
        was.identity, zone["actuator"]["identity"], rule
    ):
        changed.add("identity")
    if (
        rule["change_mapping"]
        and was.mapping != zone["actuator"]["commissioned_mapping"]
    ):
        changed.add("mapping")
    sensor = zone["sensor"]
    if rule["change_sensor"] == "sensor_id":
        differs = was.sensor.get("sensor_id") != sensor["sensor_id"]
    elif rule["change_sensor"] == "id_and_calibration":
        differs = was.sensor.get("sensor_id") != sensor["sensor_id"] or was.sensor.get(
            "calibration_ref"
        ) != sensor.get("calibration_ref")
    elif rule["change_sensor"].startswith("ignore:"):
        field = rule["change_sensor"].removeprefix("ignore:")
        skip = {"range_min", "range_max"} if field == "range" else {field}
        differs = {k: v for k, v in was.sensor.items() if k not in skip} != {
            k: v for k, v in sensor.items() if k not in skip
        }
    else:
        differs = was.sensor != sensor
    if differs:
        changed.add("sensor")
    if rule["proof_change_is_change"]:
        leg = zone["proof"].get("control_path")
        if zone["proof"]["performed_at_ms"] != was.proof_at_ms or (
            isinstance(leg, dict)
            and leg.get("performed_at_ms") != was.control_proof_at_ms
        ):
            changed.add("proof")
    if rule["rename_is_change"] and zone_id != zone["zone_id"]:
        changed.add("name")
    return changed


def _field_changes(zone: dict, was: Any) -> set:
    """The individual fields a revision changed against one retained zone."""
    fields = set()
    now = zone["actuator"]["identity"]
    for key in set(was.identity) | set(now):
        if was.identity.get(key) != now.get(key):
            fields.add(key)
    if was.mapping != zone["actuator"]["commissioned_mapping"]:
        fields.add("mapping")
    for key in set(was.sensor) | set(zone["sensor"]):
        if was.sensor.get(key) != zone["sensor"].get(key):
            fields.add(key)
    return fields


def _exempt(leg: str, zone: dict, was: Any, rule: dict, posture: str) -> bool:
    fields = _field_changes(zone, was)
    if len(fields) == 1 and (leg, next(iter(fields))) in rule["exempt"]:
        return True
    if (leg, frozenset(fields)) in rule["exempt_sets"]:
        return True
    if any(leg == at and len(fields) >= k for at, k in rule["exempt_at_least"]):
        return True
    if (leg, posture) in rule["exempt_postures"]:
        return True
    if leg == "circuit":
        was_gpio = "gpio_pin" in was.identity
        now_gpio = "gpio_pin" in zone["actuator"]["identity"]
        if was_gpio and not now_gpio and "firmware" in rule["exempt_kind_change"]:
            return True
        if now_gpio and not was_gpio and "GPIO" in rule["exempt_kind_change"]:
            return True
    if (
        leg == "control"
        and rule["exempt_control_behind_pre_energisation"]
        and zone["proof"]["method"] == "pre_energisation"
    ):
        return True
    return False


def _stale(
    zone: dict,
    was: Any,
    changed: set,
    single: bool,
    rule: dict,
    posture: str = "production",
) -> bool:
    proof = zone["proof"]
    leg = proof.get("control_path")
    if rule["claimed_methods"] == "actuate_and_observe":
        unclaimed = proof["method"] != "actuate_and_observe"
    else:
        unclaimed = proof["method"] == "undemonstrated"
    control_fresh = (
        isinstance(leg, dict)
        and leg["method"] == "commanded_and_observed"
        and was.control_proof_at_ms is not None
        and leg["performed_at_ms"] > was.control_proof_at_ms
    )
    check_circuit = not (rule["circuit_unclaimed_exempt"] and unclaimed)
    if (
        rule["circuit_skip_if_control_unclaimed"]
        and isinstance(leg, dict)
        and leg["method"] == "undemonstrated"
    ):
        check_circuit = False
    if _exempt("circuit", zone, was, rule, posture):
        check_circuit = False
    circuit_retained = was.proof_at_ms
    if (
        rule["circuit_retained_time"] == "earlier"
        and was.control_proof_at_ms is not None
    ):
        circuit_retained = min(was.proof_at_ms, was.control_proof_at_ms)
    if rule["single_retained_time"] and was.control_proof_at_ms is not None:
        circuit_retained = max(was.proof_at_ms, was.control_proof_at_ms)
    if rule["circuit_skip_if_control_fresh"] and control_fresh:
        check_circuit = False
    if rule["circuit_only_single_match"] and not single:
        check_circuit = False
    if check_circuit:
        at = proof["performed_at_ms"]
        if (
            (at < circuit_retained)
            if rule["circuit_strict"]
            else (at <= circuit_retained)
        ):
            return True
    if not isinstance(leg, dict):
        return bool(
            rule["control_absent_stale"]
            and not unclaimed
            and was.control_proof_at_ms is not None
        )
    if rule["control_only_single_match"] and not single:
        return False
    if _exempt("control", zone, was, rule, posture):
        return False
    if rule["control_requires_claim"] and leg["method"] != "commanded_and_observed":
        return False
    if rule["control_skip_if_circuit_unclaimed"] and unclaimed:
        return False
    if rule["control_on"] == "identity" and "identity" not in changed:
        return False
    if rule["control_on"] == "identity_or_mapping" and not changed & {
        "identity",
        "mapping",
    }:
        return False
    retained = was.control_proof_at_ms
    if (
        rule["single_retained_time"] or rule["control_retained_time"] == "later"
    ) and retained is not None:
        retained = max(was.proof_at_ms, retained)
    if retained is None:
        if rule["control_missing"] == "stale":
            return True
        if rule["control_missing"] == "circuit_time":
            retained = was.proof_at_ms
        else:
            return False
    at = leg["performed_at_ms"]
    return (at < retained) if rule["control_strict"] else (at <= retained)


def _rule(rule: dict):
    def st_proof_consistency(b: dict[str, Any], ctx: Any) -> None:
        consumed: set = set()
        for zone in b["zones"]:
            held = [
                (zone_id, was, ways)
                for zone_id, was in ctx.accepted_zone_state.items()
                if (ways := _ways(zone_id, was, zone, rule))
                and not (rule["one_to_one"] and zone_id in consumed)
            ]
            if rule["one_to_one"]:
                consumed |= {zone_id for zone_id, _was, _ways_found in held}
            if rule["fresh_against_every_match_once_changed"] and any(
                _changes(zone_id, was, zone, rule) for zone_id, was, _ in held
            ):
                for _zone_id, was, _ in held:
                    if _stale(
                        zone,
                        was,
                        {"identity"},
                        len(held) == 1,
                        rule,
                        ctx.deployment_posture,
                    ):
                        raise Stale
                continue
            if rule["visit"] == "first":
                held = held[:1]
            elif rule["visit"] == "last":
                held = held[-1:]
            elif rule["visit"] == "latest_proof" and held:
                held = [max(held, key=lambda h: h[1].proof_at_ms)]
            elif rule["visit"] == "sensor_first":
                sensor = [h for h in held if "sensor" in h[2]]
                held = sensor[:1] or held[:1]
            elif rule["visit"] == "name_if_no_actuator":
                if any("actuator" in h[2] for h in held):
                    held = [h for h in held if h[2] != {"name"}]
            for zone_id, was, _ways_found in held:
                changed = _changes(zone_id, was, zone, rule)
                if not changed:
                    if rule["visit"] == "break_on_unchanged":
                        break
                    continue
                if _stale(
                    zone, was, changed, len(held) == 1, rule, ctx.deployment_posture
                ):
                    raise Stale
                if rule["visit"] == "stop_after_pass":
                    break

    return st_proof_consistency



def decides_stale(rule: dict, case: dict) -> bool:
    ctx = case.get("verifier_context", {})
    state = {
        zone_id: types.SimpleNamespace(
            identity=row.get("identity", {}),
            mapping=row.get("mapping"),
            sensor=row.get("sensor", {}),
            proof_at_ms=row.get("proof_at_ms"),
            control_proof_at_ms=row.get("control_proof_at_ms"),
        )
        for zone_id, row in (ctx.get("accepted_zone_state") or {}).items()
    }
    context = types.SimpleNamespace(
        accepted_zone_state=state,
        deployment_posture=ctx.get("deployment_posture"),
    )
    try:
        _rule(rule)(case["binding"], context)
    except Stale:
        return True
    return False


def revision_verdicts(corpus: dict) -> list:
    """Every case the revision rule decides, with whether it must find it stale.

    A refusal at a stage before the rule, or at its own stage for another
    reason, never reaches it; a case refused after it, or accepted, passed it.
    """
    order = corpus["acceptance_order"]
    after = set(order[order.index("proof_consistency") + 1 :])
    decided = []
    for case in corpus["cases"]:
        if case.get("verifier_context", {}).get("accepted_zone_state"):
            decided.append((case, False))
    for case in corpus["reject_cases"]:
        if not case.get("verifier_context", {}).get("accepted_zone_state"):
            continue
        if case.get("reason") == "stale_proof":
            decided.append((case, True))
        elif case.get("stage") in after:
            decided.append((case, False))
    return decided


def check_misreadings(corpus: dict) -> None:
    decided = revision_verdicts(corpus)
    if not decided or not MUTANTS:
        fail(
            f"{MISREADINGS.name}: no revision case or no misreading to decide; the "
            "misreading check would pass by measuring nothing"
        )
    if set(TABLE["reference"]) != set(REFERENCE) or any(
        set(change) - set(TABLE["reference"]) for change in MUTANTS.values()
    ):
        fail(f"{MISREADINGS.name}: a misreading sets a switch the reference lacks")
    for case, stale in decided:
        if decides_stale(REFERENCE, case) != stale:
            fail(
                f"{case['name']}: the revision rule does not reach the declared "
                "verdict, so no misreading can be measured against it"
            )
    for name, change in MUTANTS.items():
        rule = rule_switches({**TABLE["reference"], **change})
        if all(decides_stale(rule, case) == stale for case, stale in decided):
            fail(
                f"no vector refuses the misreading {name!r}: a consumer that read "
                "the revision rule this way would pass every case. Only the "
                "misreadings in MUTANTS are checked, and of the exemptions keyed "
                "on a set of fields only the sets in CHANGE_EVENTS "
                f"({', '.join(CHANGE_EVENTS)})"
            )


def check_published_description(corpus: dict) -> None:
    """The contract publishes the corpus's digest and counts; they must be true.

    A consumer pins the corpus by the digest the contract prints, so a stale
    digest is a pin that looks authoritative and names a file that no longer
    exists. The counts are derived here for the same reason.
    """
    import hashlib
    import re

    text = (ROOT / "commissioned-safety-binding" / "v2.md").read_text(encoding="utf-8")
    digest = hashlib.sha256(CORPUS.read_bytes()).hexdigest()
    # Exactly one of each: a second, contradictory description would otherwise
    # pass behind a correct first one.
    published = re.findall(r"SHA-256 is\s+`([0-9a-f]{64})`", text)
    if published != [digest]:
        fail(
            "v2.md: the published corpus SHA-256 is not the corpus's own "
            f"({digest})"
        )
    counts = re.findall(r"(\d+) accept and (\d+) reject binding cases", text)
    want = (len(corpus["cases"]), len(corpus["reject_cases"]))
    if [(int(a), int(b)) for a, b in counts] != [want]:
        fail(f"v2.md: the published binding case counts are not {want[0]} and {want[1]}")
    tail = re.findall(
        r"(\d+) accept and (\d+)\s+reject firmware-profile cases, (\d+) "
        r"envelope reject cases[\s\S]*?(\d+) raw byte-level reject cases",
        text,
    )
    want_tail = (
        len(corpus["firmware_profile_cases"]),
        len(corpus["firmware_profile_reject_cases"]),
        len(corpus["envelope_reject_cases"]),
        len(corpus["raw_reject_cases"]),
    )
    if [tuple(int(g) for g in match) for match in tail] != [want_tail]:
        fail(f"v2.md: the published profile, envelope and raw counts are not {want_tail}")
    table = hashlib.sha256(MISREADINGS.read_bytes()).hexdigest()
    listed = re.findall(
        r"revision-misreadings-v2\.json\)[\s\S]*?lists (\d+) misreadings[\s\S]*?"
        r"SHA-256 digest is\s+`([0-9a-f]{64})`",
        text,
    )
    if listed != [(str(len(MUTANTS)), table)]:
        fail(
            f"v2.md: the published misreading count and SHA-256 are not "
            f"{len(MUTANTS)} and {table}"
        )


def check_control_legs(label: str, binding: Any) -> None:
    """The leg's own grammar, where it is present at all."""
    for index, zone in enumerate(binding.get("zones", [])):
        leg = control_leg(zone)
        if leg is None:
            continue
        where = f"{label}: zones[{index}].proof.control_path"
        if not isinstance(leg, dict):
            fail(f"{where} is not an object")
            continue
        method = leg.get("method")
        if method not in CONTROL_METHODS:
            fail(f"{where} names method {method!r}, which the contract does not define")
            continue
        kind = zone.get("actuator", {}).get("kind")
        if method == "commanded_and_observed" and kind != "local_gpio":
            fail(
                f"{where} claims a commanded proof on a {kind!r} actuator; the "
                "method is admissible only for local_gpio"
            )
        observations = leg.get("observations")
        if not isinstance(observations, list):
            fail(f"{where}.observations is not a list")
            continue
        if method == "undemonstrated":
            if observations:
                fail(f"{where} is undemonstrated and carries observations")
            if not str(leg.get("reason", "")).strip():
                fail(f"{where} is undemonstrated with no reason")
            continue
        if not observations:
            fail(f"{where} claims a proof with no observations")
        for j, observation in enumerate(observations):
            if not isinstance(observation, dict):
                fail(f"{where}.observations[{j}] is not an object")
                continue
            if kind == "local_gpio" and "gpio_level" not in observation:
                fail(
                    f"{where}.observations[{j}] has no gpio_level; the level "
                    "driven is the evidence this leg exists to record"
                )


def main() -> int:
    corpus = json.loads(CORPUS.read_text(encoding="utf-8"))
    order = corpus["acceptance_order"]
    profile_order = corpus["firmware_profile_acceptance_order"]

    for case in corpus["cases"]:
        label = f"cases/{case['name']}"
        check_document_case(corpus, case, "binding", label)
        check_control_legs(label, case["binding"])
        # Verification is not authority. A case that does not say which state a
        # consumer reaches leaves the boundary this corpus exists to fix untested.
        declared = case.get("expected_state")
        if declared not in {"provisional", "in_force"}:
            fail(f"{label}: expected_state is {declared!r}")
        else:
            computed = expected_state(case["binding"])
            if declared != computed:
                fail(
                    f"{label}: declares {declared!r} and the contract's rule "
                    f"gives {computed!r}"
                )
        # A provisional record is not in the freshness chain. Where one is held,
        # the floor must still be the in-force sequence, so the document is
        # accepted rather than refused as stale behind a record that carried no
        # authority.
        provisional = case["verifier_context"].get("provisional_binding_seq")
        if provisional is not None:
            floor = case["verifier_context"]["accepted_binding_seq"]
            if case["binding"]["binding_seq"] > provisional:
                fail(
                    f"{label}: binding_seq {case['binding']['binding_seq']} already "
                    f"exceeds the provisional {provisional}, so the case cannot show "
                    "that a provisional record fails to raise the floor"
                )
            if case["binding"]["binding_seq"] <= floor:
                fail(f"{label}: not accepted against the in-force floor {floor}")
    for case in corpus["reject_cases"]:
        label = f"reject_cases/{case['name']}"
        # Undeclared, the signature's validity is inferred by each consumer, and
        # a refusal the corpus places after the signature stage could be
        # reproduced by one that never verified it.
        if not isinstance(case.get("signature_valid"), bool):
            fail(f"{label}: signature_valid is not declared")
        check_document_case(corpus, case, "binding", label)
        check_stage(case, VERDICT_STAGE, order, label)
        if case["reason"] != "malformed":
            check_control_legs(label, case["binding"])
    for case in corpus["firmware_profile_cases"]:
        check_document_case(
            corpus, case, "firmware_profile", f"firmware_profile_cases/{case['name']}"
        )
    for case in corpus["firmware_profile_reject_cases"]:
        label = f"firmware_profile_reject_cases/{case['name']}"
        check_document_case(corpus, case, "firmware_profile", label)
        check_stage(case, PROFILE_VERDICT_STAGE, profile_order, label)

    check_retained_sensor(corpus)
    check_retained_matching(corpus)
    check_misreadings(corpus)
    check_published_description(corpus)

    for case in corpus["envelope_reject_cases"]:
        label = f"envelope_reject_cases/{case['name']}"
        if canonical(case["envelope"]).hex() != case["canonical_hex"]:
            fail(f"{label}: canonical_hex does not reproduce from the envelope")
        if (case["reason"], case["stage"]) != ("malformed", "parses"):
            fail(f"{label}: the wrapper is grammar, so every case is malformed/parses")

    # A raw case earns its section only by carrying something a decoded case
    # cannot. If its bytes are already the canonical form of what they decode
    # to, an ordinary case would have covered it.
    for case in corpus.get("raw_reject_cases", []):
        label = f"raw_reject_cases/{case['name']}"
        raw = bytes.fromhex(case["envelope_hex"])
        if (case["reason"], case["stage"]) != ("malformed", "parses"):
            fail(f"{label}: raw cases are refused by the grammar, at parses")
        try:
            decoded = json.loads(raw.decode("utf-8"))
            reserialised = canonical(decoded)
        except (UnicodeDecodeError, ValueError, UnicodeEncodeError):
            # Bytes that will not decode, or that decode to something no
            # canonical serialiser will re-emit — a lone surrogate is the
            # second kind — are raw by construction. This check had to learn
            # that itself: it first crashed here on exactly that case.
            continue
        if reserialised == raw:
            fail(
                f"{label}: the bytes are already canonical, so decoding loses "
                "nothing and an ordinary case would cover this"
            )

    # An in-force case must carry both legs on every zone. A case reaching it
    # on one leg would publish, as a fixture, the state this contract forbids.
    for case in corpus["cases"]:
        if case.get("expected_state") != "in_force":
            continue
        for zone in case["binding"]["zones"]:
            if zone.get("proof", {}).get("method") == "undemonstrated":
                fail(
                    f"cases/{case['name']}: reaches in_force with an "
                    "undemonstrated circuit leg"
                )

    # Both independent gaps need a case, or the corpus proves only the one that
    # was fixed most recently.
    def mixed(case: dict) -> bool:
        return any(
            z.get("proof", {}).get("method") == "undemonstrated"
            and (control_leg(z) or {}).get("method") == "commanded_and_observed"
            for z in case["binding"]["zones"]
        )

    if not any(mixed(case) for case in corpus["cases"]):
        fail(
            "cases: no case carries a proven control leg over an undemonstrated "
            "circuit leg, so nothing shows that one leg does not substitute for "
            "the other"
        )

    # No accept case may bring a firmware zone into force: the method that
    # would do it has no design, and admitting one here would publish the
    # contradiction as a fixture.
    for case in corpus["cases"]:
        if case.get("expected_state") != "in_force":
            continue
        for zone in case["binding"]["zones"]:
            if zone.get("actuator", {}).get("kind") != "local_gpio":
                fail(
                    f"cases/{case['name']}: reaches in_force with a "
                    f"{zone['actuator'].get('kind')!r} zone"
                )

    # The two states and the leg's refusals each need a case, or the corpus
    # certifies a consumer that implements neither.
    states = {case.get("expected_state") for case in corpus["cases"]}
    for state in ("provisional", "in_force"):
        if state not in states:
            fail(f"cases: no case reaches {state!r}")
    if not any(control_leg(z) for c in corpus["cases"] for z in c["binding"]["zones"]):
        fail("cases: no accept case carries a control_path leg")

    check_revision_freshness(corpus)
    check_per_leg_coverage(corpus)

    # A stage no case stops at is a rule the corpus holds nobody to.
    for name, cases, expected in (
        ("acceptance_order", corpus["reject_cases"], order),
        (
            "firmware_profile_acceptance_order",
            corpus["firmware_profile_reject_cases"],
            profile_order,
        ),
    ):
        reached = {case["stage"] for case in cases}
        for stage in expected:
            if stage not in reached:
                fail(f"{name}: no case stops at {stage!r}")

    for failure in failures:
        print("FAIL", failure)
    counts = (
        f"{len(corpus['cases'])} accept, {len(corpus['reject_cases'])} reject, "
        f"{len(corpus['envelope_reject_cases'])} envelope, "
        f"{len(corpus.get('raw_reject_cases', []))} raw, "
        f"{len(corpus['firmware_profile_cases'])} profile accept, "
        f"{len(corpus['firmware_profile_reject_cases'])} profile reject"
    )
    print(f"\n{counts}; {len(failures)} failures")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
