#!/usr/bin/env python3
"""Check the skills-package/v3 corpus against the requirements it claims to meet.

Two things, both of which were got wrong by hand first.

**Descriptor-core coverage.** The required-case list is parsed out of
`schema-descriptor/v1.md` rather than transcribed here. An earlier audit
compared the corpus against a hand-copied list whose reading had stopped one
bullet short, so it reported complete coverage while a required case was
missing. Checking a corpus against a transcription proves the transcription.

**Case isolation.** A vector carrying a second, independent defect lets a
conforming implementation refuse for that instead and never reach the boundary
under test, which reports coverage that does not exist. Every manifest is
checked for the defects v3 refuses on its own terms, and a case that exists to
test one of those declares it.

**Tier B execution policy.** `tier-b-policy.json` is evaluated case by case
against the three rules of v3's *Tier B execution policy*, read from the
contract's sentences: each refused case must carry exactly the defect its
`rule` names and name what the rule requires, each accepted case none, every
value kind and alternative the contract lists must have a case, and no manifest
in any other file may carry one of the three defects.

**Field types.** `field-types.json` is evaluated against a type model of its
own, checked against v3's field tables: each refused case must carry exactly
the one defect its `field` and `kind` name, each accepted case none, every
member the tables type must have a `null` case and a wrong-type case, and
each case must differ from the accepted base manifest at its `field` alone.

Run from the repository root:

    python3 scripts/check-skills-package-vectors
    python3 scripts/check-skills-package-vectors --mutations

Exits non-zero on the first unmet requirement, so it is usable as a gate.
`--mutations` corrupts the Tier B corpus and the contract sentences, switches
on each defect a loader could have, and requires every mutant to be refused.
"""

from __future__ import annotations

import copy
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
VECTORS = ROOT / "skills-package" / "vectors"
CORE = ROOT / "schema-descriptor" / "v1.md"
CONTRACT = ROOT / "skills-package" / "v3.md"
TIER_B = "tier-b-policy.json"
FIELD_TYPES = "field-types.json"
DECLARED_CONTRACT = "skills-package/v3"

#: Which cases discharge each requirement of the descriptor core, in the order
#: the core lists them. Adding a requirement to the core fails this script until
#: the mapping is extended, which is the point.
CORE_COVERAGE: dict[int, list[str]] = {
    1: [
        "boolean_accepted",
        "array_accepted",
        "object_accepted",
        "exact_satisfaction_accepted",
        "wrong_type_refused",
        "wrong_type_for_string",
        "wrong_type_for_boolean",
        "wrong_type_for_array",
        "wrong_type_for_array_item",
        "wrong_type_for_object",
    ],
    2: ["float_where_integer_declared"],
    3: ["boolean_where_integer_declared", "boolean_where_number_declared"],
    4: ["below_minimum_refused", "above_maximum_refused"],
    5: ["outside_enum_refused"],
    6: ["non_numeric_bound", "nan_bound", "infinite_bound", "boolean_bound"],
    7: ["fractional_bound_on_an_integer"],
    8: ["minimum_above_maximum"],
    9: ["empty_enum", "enum_member_its_own_descriptor_rejects"],
    10: ["object_without_properties", "array_without_items"],
    11: ["undeclared_key_two_levels_deep"],
    12: ["default_its_own_descriptor_rejects"],
    13: ["unrecognised_descriptor_property"],
}

#: Every primitive must appear both accepted and refused for a wrong-type value.
PRIMITIVES: dict[str, tuple[str, str]] = {
    "string": ("exact_satisfaction_accepted", "wrong_type_for_string"),
    "number": ("exact_satisfaction_accepted", "wrong_type_refused"),
    "integer": ("exact_satisfaction_accepted", "float_where_integer_declared"),
    "boolean": ("boolean_accepted", "wrong_type_for_boolean"),
    "array": ("array_accepted", "wrong_type_for_array"),
    "object": ("object_accepted", "wrong_type_for_object"),
}

#: Cases whose whole purpose is one of the defects the isolation check looks
#: for. Each is exempt from that defect only, never from the others.
ISOLATION_EXEMPT: dict[str, str] = {
    "default_action_not_declared_in_available_refused": "undeclared_default",
}


#: The Tier B execution policy's rules, and the identifiers a refusal under each
#: must name beside the trigger or action entry carrying the defect.
RULES: dict[str, tuple[str, ...]] = {
    "one_policy": ("requires_approval", "post_action"),
    "trigger_only": ("requires_approval", "actions.available"),
    "boolean": ("requires_approval",),
}

#: The sentences of v3 the model below encodes. Rewording one fails the check
#: until the model is reviewed against the new text.
RULE_SENTENCES: dict[str, str] = {
    "one_policy": "A trigger declaring both `requires_approval: true` and "
    "`reasoning_policy: post_action` is refused, whatever its default actions.",
    "one_policy_false": "`requires_approval: false` beside `post_action` "
    "declares one policy and is accepted.",
    "trigger_only": "An `actions.available` entry carrying a `requires_approval` "
    "member is refused, whatever its value, `false` included.",
    "boolean": "`requires_approval`, where present, is a boolean.",
    "boolean_kinds": "Any other value is refused and never coerced: a string, "
    '`"true"` and `"false"` included, a number, `null`, a sequence or a mapping.',
    "absent": "An absent member means `false`.",
    "informational_defaults": "rule 1 binds Tier B triggers, including one whose "
    "defaults are all Tier A.",
}

#: Value kinds the boolean rule's cases must cover, as the contract lists them.
BOOLEAN_KINDS = frozenset(
    {"string_true", "string_false", "number_truthy", "number_falsy", "null", "sequence", "mapping"}
)

#: Alternatives the contract accepts, each of which must have an accepted case.
ACCEPTED_SHAPES = frozenset({"approval_only", "post_action_only", "post_action_with_false"})

#: Loader defects the corpus must catch; each is switched on alone under --mutations.
MODEL_MUTANTS: dict[str, bool] = {
    "one_policy_only_physical": False,
    "one_policy_on_presence": False,
    "trigger_only_true_only": False,
    "boolean_accepts_strings": False,
    "boolean_accepts_numbers": False,
    "boolean_null_is_absent": False,
    "boolean_accepts_collections": False,
}


def is_boolean(value: object) -> bool:
    if MODEL_MUTANTS["boolean_accepts_strings"] and isinstance(value, str):
        return True
    if MODEL_MUTANTS["boolean_accepts_numbers"] and type(value) in (int, float):
        return True
    if MODEL_MUTANTS["boolean_null_is_absent"] and value is None:
        return True
    if MODEL_MUTANTS["boolean_accepts_collections"] and isinstance(value, (list, dict)):
        return True
    return isinstance(value, bool)


def policy_defects(manifest: dict, registry: dict[str, str]) -> dict[str, set[str]]:
    """Every defect a manifest carries under the Tier B rules and those beside them.

    Returns each defect with the trigger or action names carrying it.
    """
    found: dict[str, set[str]] = {}

    def add(defect: str, where: str) -> None:
        found.setdefault(defect, set()).add(where)

    tiers: dict[str, str] = {}
    for entry in manifest["actions"]["available"]:
        name = entry["name"]
        tiers[name] = entry.get("tier", "")
        if "requires_approval" in entry and not (
            MODEL_MUTANTS["trigger_only_true_only"] and entry["requires_approval"] is not True
        ):
            add("trigger_only", name)
        floor = registry.get(name)
        if floor and tiers[name] < floor:
            add("below_floor", name)
    defaults = manifest["actions"]["defaults"]
    if set(defaults) != {trigger["name"] for trigger in manifest["triggers"]}:
        add("defaults_mismatch", "actions.defaults")
    for name in {a for names in defaults.values() for a in names} - set(tiers):
        add("undeclared_default", name)
    for trigger in manifest["triggers"]:
        name, tier = trigger["name"], trigger.get("action_tier")
        if tier not in ("A", "B", "C"):
            add("action_tier", name)
        approval = False
        if "requires_approval" in trigger:
            value = trigger["requires_approval"]
            if not is_boolean(value):
                add("boolean", name)
            else:
                approval = value is True
        policy = trigger.get("reasoning_policy", "")
        if policy not in ("", "post_action"):
            add("reasoning_policy", name)
        post_action = policy == "post_action"
        actions = defaults.get(name, [])
        physical = tier == "B" and any(tiers.get(a) == "B" for a in actions)
        if post_action and tier != "B":
            add("post_action_not_tier_b", name)
        if MODEL_MUTANTS["one_policy_on_presence"]:
            approval = "requires_approval" in trigger
        if approval and post_action and (physical or not MODEL_MUTANTS["one_policy_only_physical"]):
            add("one_policy", name)
        if physical and not (approval or post_action):
            add("no_policy", name)
        if physical and post_action and not any(tiers.get(a) == "A" for a in actions):
            add("post_action_without_notice", name)
    return found


def boolean_kind(value: object) -> str:
    if value == "true" and isinstance(value, str):
        return "string_true"
    if value == "false" and isinstance(value, str):
        return "string_false"
    if type(value) in (int, float):
        return "number_truthy" if value else "number_falsy"
    if value is None:
        return "null"
    return {list: "sequence", dict: "mapping"}.get(type(value), type(value).__name__)


def accepted_shape(manifest: dict) -> str:
    trigger = manifest["triggers"][0]
    approval = trigger.get("requires_approval", None)
    post_action = trigger.get("reasoning_policy") == "post_action"
    if approval is True and not post_action:
        return "approval_only"
    if approval is None and post_action:
        return "post_action_only"
    if approval is False and post_action:
        return "post_action_with_false"
    return "other"


def _norm(text: str) -> str:
    return " ".join(text.split())


def check_tier_b(documents: dict[str, dict], contract_text: str) -> list[str]:
    """The Tier B execution-policy corpus, against the contract's three rules."""
    failures: list[str] = []
    text = _norm(contract_text)
    for key, sentence in RULE_SENTENCES.items():
        if _norm(sentence) not in text:
            failures.append(f"v3 no longer states the {key} sentence this checker encodes")
    try:
        document = documents[TIER_B]
        declared = set(re.findall(r"skills-package/v\d+", str(document.get("contract", ""))))
        if declared != {DECLARED_CONTRACT}:
            failures.append(f"{TIER_B} declares {sorted(declared)}; it exercises {DECLARED_CONTRACT}")
        registry = document["action_registry"]
        kinds: set[str] = set()
        shapes: set[str] = set()
        one_policy_physical: set[bool] = set()
        trigger_only_values: set[object] = set()
        for case in document["cases"]:
            name, manifest = case["name"], case["manifest"]
            if case.get("registry") != "action_registry":
                failures.append(f"{name}: does not name the action_registry fixture")
            found = policy_defects(manifest, registry)
            if case["expect"] == "accepted":
                if "rule" in case or found:
                    failures.append(f"{name}: accepted, but carries {sorted(found)}")
                shapes.add(accepted_shape(manifest))
                continue
            if case["expect"] != "refused":
                failures.append(f"{name}: expect is {case['expect']!r}")
                continue
            rule = case.get("rule")
            if rule not in RULES:
                failures.append(f"{name}: names no rule of the Tier B execution policy")
                continue
            if set(found) != {rule}:
                failures.append(f"{name}: declares {rule}, carries {sorted(found)}")
                continue
            if case.get("error") != "SkillValidationError":
                failures.append(f"{name}: a Tier B policy refusal is a SkillValidationError")
            must = set(RULES[rule]) | found[rule]
            missing = must - set(case.get("must_name", []))
            if missing:
                failures.append(f"{name}: must_name omits {sorted(missing)}")
            trigger = manifest["triggers"][0]
            if rule == "boolean":
                kinds.add(boolean_kind(trigger["requires_approval"]))
            elif rule == "one_policy":
                defaults = manifest["actions"]["defaults"][trigger["name"]]
                tiers = {e["name"]: e.get("tier") for e in manifest["actions"]["available"]}
                one_policy_physical.add(any(tiers.get(a) == "B" for a in defaults))
            else:
                for entry in manifest["actions"]["available"]:
                    if "requires_approval" in entry:
                        trigger_only_values.add(entry["requires_approval"])
        if not BOOLEAN_KINDS <= kinds:
            failures.append(f"boolean rule: no case for {sorted(BOOLEAN_KINDS - kinds)}")
        if not ACCEPTED_SHAPES <= shapes:
            failures.append(f"no accepted case for {sorted(ACCEPTED_SHAPES - shapes)}")
        if one_policy_physical != {True, False}:
            failures.append("one_policy: needs a case with a physical default and one without")
        if not {True, False} <= trigger_only_values:
            failures.append("trigger_only: needs a case with true and one with false")
        for filename, other in documents.items():
            if filename in (TIER_B, FIELD_TYPES):
                continue
            for case in other["cases"]:
                manifest = case.get("manifest")
                if not manifest:
                    continue
                stray = set(policy_defects(manifest, {})) & set(RULES)
                if stray:
                    failures.append(f"{filename} {case['name']}: carries Tier B policy defect {sorted(stray)}")
    except (KeyError, TypeError, IndexError, AttributeError) as error:
        failures.append(f"{TIER_B}: malformed ({error!r})")
    return failures


#: Member types, by path pattern: `[]` is any list index and `*` any mapping key.
#: Written from v3's tables, which `field_type_tables_agree` reads back.
#: `requires_approval` is typed in tier-b-policy.json and is left out here.
TYPED: dict[str, str] = {
    "name": "string", "version": "string", "author": "string", "signature": "string",
    "triggers": "array", "sensors_required": "array", "actions": "object",
    "prompts": "object", "config": "object", "config_schema": "object",
    "triggers[]": "object",
    "triggers[].name": "string", "triggers[].condition": "string",
    "triggers[].action_tier": "string", "triggers[].cooldown_seconds": "integer",
    "triggers[].escalate_to": "string", "triggers[].bypass_llm": "bool",
    "triggers[].reasoning_policy": "string",
    "triggers[].approval_timeout_seconds": "integer",
    "triggers[].safe_default_action": "string",
    "sensors_required[]": "object", "sensors_required[].type": "string",
    "actions.available": "array", "actions.available[]": "object",
    "actions.available[].name": "string", "actions.available[].tier": "string",
    "actions.defaults": "object", "actions.defaults.*": "array",
    "actions.defaults.*[]": "string", "prompts.*": "string",
}

#: How each table names a member, mapped to the pattern above.
TABLE_NAMES: dict[str, str] = {
    "triggers[]": "triggers[]", "sensors_required[]": "sensors_required[]",
    "sensors_required[].type": "sensors_required[].type",
    "actions.available": "actions.available", "actions.available[]": "actions.available[]",
    "actions.available[].name": "actions.available[].name",
    "actions.available[].tier": "actions.available[].tier",
    "actions.defaults": "actions.defaults", "actions.defaults.<trigger>": "actions.defaults.*",
    "prompts.<name>": "prompts.*",
}

FIELD_SENTENCES: dict[str, str] = {
    "one_type": "Every field a loader reads admits exactly one type.",
    "null": "A member present with `null` is refused as a wrong type.",
    "integer": "An `integer` field refuses a boolean and a floating-point number, `1.0` included.",
    "type_first": "A type is checked before anything reads the member.",
    "tier": "`actions.available[].tier`, where present, is exactly `A`, `B` or `C`, "
    "like a trigger's `action_tier`.",
    "cooldown": "**`cooldown_seconds` is from `0` to `86400`.**",
    "condition": "A non-empty `condition` longer than 4,096 characters, or one the "
    "runtime rule engine cannot evaluate, is refused at load.",
}

CONDITION_MAX = 4096
COOLDOWN_MAX = 86400

FIELD_MUTANTS: dict[str, bool] = {
    "null_is_absent": False,
    "integer_admits_bool": False,
    "integer_admits_float": False,
    "tier_upper_cased": False,
    "tier_stripped": False,
    "negative_cooldown_admitted": False,
    "cooldown_bound_exclusive": False,
    "cooldown_unbounded": False,
    "condition_bound_inclusive": False,
}


def _admits(value: object, kind: str) -> bool:
    if value is None:
        return False
    if kind == "integer":
        if type(value) is bool:
            return FIELD_MUTANTS["integer_admits_bool"]
        if type(value) is float:
            return FIELD_MUTANTS["integer_admits_float"]
        return type(value) is int
    return isinstance(value, {"string": str, "bool": bool, "array": list, "object": dict}[kind])


def field_defects(manifest: object) -> set[tuple[str, str]]:
    """Every (path, kind) defect a manifest carries under v3's field types."""
    found: set[tuple[str, str]] = set()

    def walk(value: object, path: str, pattern: str) -> None:
        kind = TYPED.get(pattern)
        if kind is not None and not _admits(value, kind):
            if value is None and FIELD_MUTANTS["null_is_absent"]:
                return
            found.add((path, "type"))
            return
        if isinstance(value, dict):
            for key, child in value.items():
                child_path = f"{path}.{key}" if path else key
                exact = f"{pattern}.{key}" if pattern else key
                walk(child, child_path, exact if exact in TYPED else f"{pattern}.*")
        elif isinstance(value, list):
            for index, child in enumerate(value):
                walk(child, f"{path}[{index}]", f"{pattern}[]")
        elif pattern == "actions.available[].tier" and isinstance(value, str) and value != "D":
            # A Tier D action is refused under v3's Tier D rule, which
            # tier-authority.json exercises; this model owns the letter's form.
            tier = value
            if FIELD_MUTANTS["tier_stripped"]:
                tier = tier.strip()
            if FIELD_MUTANTS["tier_upper_cased"] and tier.isascii():
                tier = tier.upper()
            if tier not in ("A", "B", "C"):
                found.add((path, "value"))
        elif pattern == "triggers[].cooldown_seconds" and type(value) is int:
            if value < 0 and not FIELD_MUTANTS["negative_cooldown_admitted"]:
                found.add((path, "value"))
            limit = COOLDOWN_MAX - (1 if FIELD_MUTANTS["cooldown_bound_exclusive"] else 0)
            if value > limit and not FIELD_MUTANTS["cooldown_unbounded"]:
                found.add((path, "value"))
        elif pattern == "triggers[].condition" and isinstance(value, str):
            limit = CONDITION_MAX + (1 if FIELD_MUTANTS["condition_bound_inclusive"] else 0)
            if len(value) > limit:
                found.add((path, "value"))

    walk(manifest, "", "")
    return found


def _steps(field: str) -> list[object]:
    return [int(p) if p.isdigit() else p for p in re.findall(r"[^.\[\]]+", field)]


def _restore(manifest: dict, base: dict, field: str) -> dict:
    """*manifest* with *field* put back as *base* holds it, or removed."""
    out = copy.deepcopy(manifest)
    steps = _steps(field)
    target, source = out, base
    for step in steps[:-1]:
        target, source = target[step], source[step]
    last = steps[-1]
    try:
        target[last] = copy.deepcopy(source[last])
    except (KeyError, IndexError):
        del target[last]
    return out


def _must_name(manifest: dict, field: str) -> set[str]:
    """What a refusal must name: the trigger or action by its name where it has
    one, and otherwise every named step of the path to the member."""
    steps = _steps(field)
    for prefix in (["triggers"], ["actions", "available"]):
        n = len(prefix)
        if steps[:n] == prefix and len(steps) > n + 1:
            entry = manifest
            for step in steps[: n + 1]:
                entry = entry[step]
            name = entry.get("name") if isinstance(entry, dict) else None
            if isinstance(name, str) and steps[n + 1] != "name":
                return {name} | {s for s in steps[n + 1 :] if isinstance(s, str)}
    return {s for s in steps if isinstance(s, str)}


def field_type_tables_agree(contract_text: str) -> list[str]:
    failures: list[str] = []
    text = _norm(contract_text)
    for key, sentence in FIELD_SENTENCES.items():
        if _norm(sentence) not in text:
            failures.append(f"v3 no longer states the {key} sentence this checker encodes")

    def rows(heading: str) -> dict[str, str]:
        section = contract_text.split(heading, 1)[1].split("\n## ", 1)[0]
        found = re.findall(r"^\| `([^`]+)` \| `(\w+)`(?: of `(\w+)`)?", section, flags=re.M)
        return {name: (kind, item) for name, kind, item in found}

    tables: dict[str, str] = {}
    for prefix, heading in (("", "## skill.yaml Top-Level Fields"), ("triggers[].", "## Trigger Fields"), (None, "## Field types")):
        for name, (kind, item) in rows(heading).items():
            pattern = f"{prefix}{name}" if prefix is not None else TABLE_NAMES.get(name, f"?{name}")
            tables[pattern] = kind
            if item:
                tables[f"{pattern}[]"] = item
    tables.pop("triggers[].requires_approval", None)
    if tables != TYPED:
        differ = sorted(set(tables.items()) ^ set(TYPED.items()))
        failures.append(f"v3's field tables and this checker's type model differ: {differ}")
    return failures


def check_field_types(documents: dict[str, dict], contract_text: str) -> list[str]:
    failures = field_type_tables_agree(contract_text)
    try:
        document = documents[FIELD_TYPES]
        declared = set(re.findall(r"skills-package/v\d+", str(document.get("contract", ""))))
        if declared != {DECLARED_CONTRACT}:
            failures.append(f"{FIELD_TYPES} declares {sorted(declared)}; it exercises {DECLARED_CONTRACT}")
        cases = {case["name"]: case for case in document["cases"]}
        base_case = cases.get("every_field_typed_accepted")
        if base_case is None:
            return failures + [f"{FIELD_TYPES}: no base case every_field_typed_accepted"]
        base = base_case["manifest"]
        base_defects = set(policy_defects(base, {"alert_sms": "A"})) | field_defects(base)
        if base_defects:
            failures.append(f"every_field_typed_accepted: base carries {sorted(base_defects)}")
        covered: dict[str, set[str]] = {}
        by_pattern: dict[str, set[str]] = {}
        for name, case in cases.items():
            manifest, field = case["manifest"], case.get("field", "")
            if "requires_approval" in json.dumps(manifest):
                failures.append(f"{name}: requires_approval belongs to {TIER_B}")
            try:
                restored = _restore(manifest, base, field)
            except (KeyError, IndexError, TypeError):
                failures.append(f"{name}: field {field!r} is not a member of the manifest")
                continue
            if restored != base:
                failures.append(f"{name}: differs from the base manifest beyond {field!r}")
            found = field_defects(manifest)
            if case["expect"] == "accepted":
                if found or "kind" in case:
                    failures.append(f"{name}: accepted, but carries {sorted(found)}")
                covered.setdefault(field, set()).add(f"accepted:{_value_tag(manifest, field)}")
                by_pattern.setdefault(_pattern(field), set()).add(f"accepted:{_value_tag(manifest, field)}")
                continue
            if case["expect"] != "refused":
                failures.append(f"{name}: expect is {case['expect']!r}")
                continue
            kind = case.get("kind")
            if found != {(field, kind)}:
                failures.append(f"{name}: declares {field} {kind}, carries {sorted(found)}")
                continue
            if case.get("error") != "SkillValidationError":
                failures.append(f"{name}: a field-type refusal is a SkillValidationError")
            missing = _must_name(manifest, field) - set(case.get("must_name", []))
            if missing:
                failures.append(f"{name}: must_name omits {sorted(missing)}")
            covered.setdefault(field, set()).add(f"{kind}:{_value_tag(manifest, field)}")
            by_pattern.setdefault(_pattern(field), set()).add(f"{kind}:{_value_tag(manifest, field)}")
        failures += _field_coverage(covered, by_pattern)
    except (KeyError, TypeError, IndexError, AttributeError) as error:
        failures.append(f"{FIELD_TYPES}: malformed ({error!r})")
    return failures


def _value_tag(manifest: dict, field: str) -> str:
    value: object = manifest
    for step in _steps(field):
        value = value[step]  # type: ignore[index]
    if value is None:
        return "null"
    if type(value) is bool:
        return "bool"
    if type(value) is float:
        return "float"
    if isinstance(value, str) and field.endswith("condition"):
        return f"len{len(value)}"
    if type(value) is int:
        if field.endswith("cooldown_seconds") and value >= COOLDOWN_MAX:
            return "max" if value == COOLDOWN_MAX else "over"
        return "negative" if value < 0 else "zero" if value == 0 else "positive"
    return repr(value) if isinstance(value, str) else type(value).__name__


def _pattern(field: str) -> str:
    """The TYPED pattern a concrete member path falls under."""
    pattern = ""
    for step in _steps(field):
        if isinstance(step, int):
            pattern += "[]"
        else:
            exact = f"{pattern}.{step}" if pattern else step
            pattern = exact if exact in TYPED else f"{pattern}.*"
    return pattern


def _field_coverage(covered: dict[str, set[str]], by_pattern: dict[str, set[str]]) -> list[str]:
    failures: list[str] = []
    for pattern, kind in sorted(TYPED.items()):
        tags = by_pattern.get(pattern, set())
        if "type:null" not in tags:
            failures.append(f"{pattern}: no null case")
        if not any(t.startswith("type:") and t != "type:null" for t in tags):
            failures.append(f"{pattern}: no wrong-type case")
        if kind == "integer" and not ({"type:bool", "type:float"} <= tags and any(t.startswith("type:'") for t in tags)):
            failures.append(f"{pattern}: integer needs a boolean, a float and a string case")
    required = {
        "actions.available[0].tier": {"value:'a'", "value:''", "value:' A'", "value:'Ａ'"},
        "triggers[0].cooldown_seconds": {"value:negative", "value:over", "accepted:zero", "accepted:max"},
        "triggers[0].condition": {f"value:len{CONDITION_MAX + 1}", f"accepted:len{CONDITION_MAX}", "accepted:len0"},
    }
    for path, tags in required.items():
        absent = tags - covered.get(path, set())
        if absent:
            failures.append(f"{path}: no case for {sorted(absent)}")
    return failures


def field_corpus_mutants(documents: dict[str, dict]):
    document = documents[FIELD_TYPES]

    def with_doc(bad: dict) -> dict[str, dict]:
        return {**documents, FIELD_TYPES: bad}

    bad = copy.deepcopy(document)
    bad["contract"] = "skills-package/v2 — field types"
    yield "field types declares v2", with_doc(bad)
    base = next(c for c in document["cases"] if c["name"] == "every_field_typed_accepted")["manifest"]
    for i, case in enumerate(document["cases"]):
        name = case["name"]
        bad = copy.deepcopy(document)
        del bad["cases"][i]
        yield f"without {name}", with_doc(bad)
        bad = copy.deepcopy(document)
        if case["expect"] == "refused":
            bad["cases"][i]["expect"] = "accepted"
            for key in ("kind", "error", "must_name"):
                bad["cases"][i].pop(key)
            yield f"{name} expected accepted", with_doc(bad)
            bad = copy.deepcopy(document)
            bad["cases"][i]["kind"] = "value" if case["kind"] == "type" else "type"
            yield f"{name} with the other kind", with_doc(bad)
            for j in range(len(case["must_name"])):
                bad = copy.deepcopy(document)
                del bad["cases"][i]["must_name"][j]
                yield f"{name} must_name without {case['must_name'][j]}", with_doc(bad)
            bad = copy.deepcopy(document)
            bad["cases"][i]["manifest"] = _restore(case["manifest"], base, case["field"])
            yield f"{name} repaired, still expected refused", with_doc(bad)
            bad = copy.deepcopy(document)
            other = "author" if case["field"] == "version" else "version"
            bad["cases"][i]["manifest"][other] = None
            yield f"{name} with a second defect", with_doc(bad)
        else:
            bad["cases"][i].update(expect="refused", kind="type", error="SkillValidationError", must_name=["x"])
            yield f"{name} expected refused", with_doc(bad)
            if name != "every_field_typed_accepted":
                bad = copy.deepcopy(document)
                bad["cases"][i]["manifest"]["triggers"][0]["cooldown_seconds"] = 7
                yield f"{name} differing beyond its field", with_doc(bad)


def run_field_mutations(documents: dict[str, dict], contract_text: str) -> list[str]:
    survived: list[str] = []
    total = 0
    for label, bad in field_corpus_mutants(documents):
        total += 1
        if not check_field_types(bad, contract_text):
            survived.append(label)
    for flag in FIELD_MUTANTS:
        total += 1
        FIELD_MUTANTS[flag] = True
        try:
            if not check_field_types(documents, contract_text):
                survived.append(f"field model mutant {flag}")
        finally:
            FIELD_MUTANTS[flag] = False
    for key, sentence in FIELD_SENTENCES.items():
        total += 1
        pattern = r"\s+".join(re.escape(w) for w in sentence.split())
        edited, count = re.subn(pattern, sentence.rsplit(" ", 1)[0].replace("\\", "\\\\"), contract_text, count=1)
        if count != 1 or not check_field_types(documents, edited):
            survived.append(f"reword {key}")
    for row, replacement in (
        ("| `cooldown_seconds` | `integer` |", "| `cooldown_seconds` | `string` |"),
        ("| `prompts.<name>` | `string` |", "| `prompts.<name>` | `object` |"),
    ):
        total += 1
        if row not in contract_text or not check_field_types(documents, contract_text.replace(row, replacement)):
            survived.append(f"table row {row}")
    if not survived:
        print(f"  field-type mutations: {total} refused")
    return survived


def _repair(case: dict) -> dict:
    manifest = copy.deepcopy(case["manifest"])
    trigger = manifest["triggers"][0]
    if case["rule"] == "boolean":
        trigger["requires_approval"] = False
    elif case["rule"] == "one_policy":
        del trigger["requires_approval"]
    else:
        for entry in manifest["actions"]["available"]:
            entry.pop("requires_approval", None)
    return manifest


def corpus_mutants(documents: dict[str, dict]):
    document = documents[TIER_B]
    registry = document["action_registry"]

    def with_tier_b(bad: dict) -> dict[str, dict]:
        return {**documents, TIER_B: bad}

    for label, value in (
        ("declares skills-package/v2", "skills-package/v2 — Tier B execution policy"),
        ("declares v2 beside v3", document["contract"] + ", skills-package/v2"),
        ("declares no contract", ""),
    ):
        bad = copy.deepcopy(document)
        bad["contract"] = value
        yield label, with_tier_b(bad)
    for i, case in enumerate(document["cases"]):
        name = case["name"]
        bad = copy.deepcopy(document)
        del bad["cases"][i]
        yield f"without {name}", with_tier_b(bad)
        bad = copy.deepcopy(document)
        flipped = bad["cases"][i]
        if case["expect"] == "refused":
            flipped["expect"] = "accepted"
            for key in ("rule", "error", "must_name"):
                flipped.pop(key)
            yield f"{name} expected accepted", with_tier_b(bad)
            for rule in RULES:
                if rule != case["rule"]:
                    bad = copy.deepcopy(document)
                    bad["cases"][i]["rule"] = rule
                    yield f"{name} blamed on {rule}", with_tier_b(bad)
            for j in range(len(case["must_name"])):
                bad = copy.deepcopy(document)
                del bad["cases"][i]["must_name"][j]
                yield f"{name} must_name without {case['must_name'][j]}", with_tier_b(bad)
            bad = copy.deepcopy(document)
            bad["cases"][i]["error"] = "SkillSecurityError"
            yield f"{name} as a security error", with_tier_b(bad)
            bad = copy.deepcopy(document)
            bad["cases"][i]["manifest"] = _repair(case)
            yield f"{name} repaired, still expected refused", with_tier_b(bad)
        else:
            flipped["expect"] = "refused"
            flipped.update(rule="boolean", error="SkillValidationError", must_name=["requires_approval"])
            yield f"{name} expected refused", with_tier_b(bad)
        before = policy_defects(case["manifest"], registry)
        for label, inject in (
            ("a false requires_approval on an action entry",
             lambda m: m["actions"]["available"][0].__setitem__("requires_approval", False)),
            ("a string requires_approval",
             lambda m: m["triggers"][0].__setitem__("requires_approval", "true")),
            ("both policies",
             lambda m: m["triggers"][0].update(requires_approval=True, reasoning_policy="post_action")),
        ):
            bad = copy.deepcopy(document)
            inject(bad["cases"][i]["manifest"])
            if policy_defects(bad["cases"][i]["manifest"], registry) != before:
                yield f"{name} with {label}", with_tier_b(bad)
    for filename, other in documents.items():
        if filename in (TIER_B, FIELD_TYPES):
            continue
        for i, case in enumerate(other["cases"]):
            if case.get("manifest"):
                bad = copy.deepcopy(other)
                bad["cases"][i]["manifest"]["triggers"][0]["requires_approval"] = "false"
                yield f"{filename} {case['name']} with a string requires_approval", {**documents, filename: bad}
                break


def text_mutants(contract_text: str):
    for key, sentence in RULE_SENTENCES.items():
        pattern = r"\s+".join(re.escape(w) for w in sentence.split())
        reworded = sentence.rsplit(" ", 1)[0].replace("\\", "\\\\")
        edited, count = re.subn(pattern, reworded, contract_text, count=1)
        yield f"reword {key}", edited, count


def run_mutations(documents: dict[str, dict], contract_text: str) -> list[str]:
    survived: list[str] = []
    total = 0
    for label, bad in corpus_mutants(documents):
        total += 1
        if not check_tier_b(bad, contract_text):
            survived.append(label)
    for flag in MODEL_MUTANTS:
        total += 1
        MODEL_MUTANTS[flag] = True
        try:
            if not check_tier_b(documents, contract_text):
                survived.append(f"model mutant {flag}")
        finally:
            MODEL_MUTANTS[flag] = False
    for label, edited, count in text_mutants(contract_text):
        total += 1
        if count != 1:
            survived.append(f"{label}: matches nothing")
        elif not check_tier_b(documents, edited):
            survived.append(label)
    if not survived:
        print(f"  tier B policy mutations: {total} refused")
    return survived


def core_requirements() -> list[str]:
    """The core's required-case bullets, read from the contract."""
    lines = CORE.read_text(encoding="utf-8").splitlines()
    start = next(i for i, line in enumerate(lines) if "MUST cover, at minimum" in line)
    bullets: list[str] = []
    current: str | None = None
    for line in lines[start + 1 :]:
        if line.startswith("- "):
            if current:
                bullets.append(current)
            current = line[2:].strip()
        elif line.startswith("  ") and current:
            current += " " + line.strip()
        elif line.strip() == "":
            continue
        else:
            break
    if current:
        bullets.append(current)
    return bullets


def load_documents() -> dict[str, dict]:
    documents: dict[str, dict] = {}
    for path in sorted(VECTORS.glob("*.json")):
        with path.open(encoding="utf-8") as handle:
            documents[path.name] = json.load(
                handle,
                parse_constant=lambda name, path=path: (_ for _ in ()).throw(
                    ValueError(f"{path.name}: {name} is not JSON")
                ),
            )
    return documents


def load_cases(documents: dict[str, dict]) -> dict[str, dict]:
    cases: dict[str, dict] = {}
    for filename, document in documents.items():
        for case in document["cases"]:
            if case["name"] in cases:
                raise ValueError(f"{filename}: case {case['name']!r} is named twice")
            cases[case["name"]] = case
    return cases


def check_core(cases: dict[str, dict], failures: list[str]) -> None:
    bullets = core_requirements()
    if set(CORE_COVERAGE) != set(range(1, len(bullets) + 1)):
        failures.append(
            f"the core lists {len(bullets)} requirements and this script maps "
            f"{len(CORE_COVERAGE)}; extend CORE_COVERAGE"
        )
        return
    for number, names in sorted(CORE_COVERAGE.items()):
        missing = [name for name in names if name not in cases]
        if missing:
            failures.append(
                f"core requirement {number} ({bullets[number - 1]}): {missing}"
            )
    for kind, (accepted, refused) in PRIMITIVES.items():
        for name in (accepted, refused):
            if name not in cases:
                failures.append(f"primitive {kind}: missing case {name!r}")


def check_isolation(cases: dict[str, dict], failures: list[str], skip: set[str]) -> None:
    for name, case in cases.items():
        manifest = case.get("manifest")
        if not manifest or name in skip:
            continue
        exempt = ISOLATION_EXEMPT.get(name)
        triggers = {trigger["name"] for trigger in manifest["triggers"]}
        defaults = manifest["actions"]["defaults"]
        declared = {action["name"] for action in manifest["actions"]["available"]}
        if set(defaults) != triggers and exempt != "defaults_mismatch":
            failures.append(f"{name}: actions.defaults keys do not match trigger names")
        undeclared = {a for names_ in defaults.values() for a in names_} - declared
        if undeclared and exempt != "undeclared_default":
            failures.append(
                f"{name}: default actions not in available: {sorted(undeclared)}"
            )


def main() -> int:
    documents = load_documents()
    contract_text = CONTRACT.read_text(encoding="utf-8")
    cases = load_cases(documents)
    failures: list[str] = []
    check_core(cases, failures)
    field_cases = {case["name"] for case in documents.get(FIELD_TYPES, {}).get("cases", [])}
    check_isolation(cases, failures, field_cases)
    failures += check_tier_b(documents, contract_text)
    failures += check_field_types(documents, contract_text)
    others = {f: d for f, d in documents.items() if f != FIELD_TYPES}
    for filename, other in others.items():
        for case in other["cases"]:
            if case.get("manifest") and field_defects(case["manifest"]):
                failures.append(f"{filename} {case['name']}: carries field-type defect {sorted(field_defects(case['manifest']))}")
    if not failures and "--mutations" in sys.argv[1:]:
        failures += [f"mutant survived: {label}" for label in run_mutations(documents, contract_text)]
        failures += [f"mutant survived: {label}" for label in run_field_mutations(documents, contract_text)]
    if failures:
        print("skills-package vector check FAILED")
        for failure in failures:
            print(f"  - {failure}")
        return 1
    print(f"skills-package vector check OK: {len(cases)} cases")
    print(f"  {len(core_requirements())} descriptor-core requirements mapped")
    print(f"  {len(PRIMITIVES)} primitives accepted and refused")
    tier_b = documents[TIER_B]["cases"]
    print(f"  {len(tier_b)} Tier B execution-policy cases hold to {DECLARED_CONTRACT}'s three rules")
    print(f"  {len(documents[FIELD_TYPES]['cases'])} field-type cases hold to {DECLARED_CONTRACT}'s field tables")
    return 0


if __name__ == "__main__":
    sys.exit(main())
