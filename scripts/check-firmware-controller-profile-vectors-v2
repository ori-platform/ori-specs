            "`clear` when the alarm is asserted by a 1 in that bit, `set` when")),
        ("bits per register halved in v2.md", text_mutant(
            "`0` to `16 × register_count − 1`", "`0` to `8 × register_count − 1`")),
        ("fleet alphabet lengthened in v2.md", text_mutant(
            "a string of 1 to 48\ncharacters", "a string of 1 to 49\ncharacters")),
        ("hyphen dropped from the fleet alphabet in v2.md", text_mutant(
            "`.`,\n`_` and `-`.", "`.`\nand `_`.")),
        ("space added to the fleet alphabet in v2.md", text_mutant(
            "`.`,\n`_` and `-`.", "`.`,\n`_`, `-` and ` `.")),
        ("dependency paragraph dropped in v2.md", text_mutant(
            "A document whose\n`register_count` is `3` breaks the `register_count` rule, not also the\n"
            "`word_order` rule.", "")),
        ("dependency paragraph inverted for word_order in v2.md", text_mutant(
            "A document whose\n`register_count` is `3` breaks the `register_count` rule, not also the",
            "A document whose\n`register_count` is `3` breaks the `register_count` rule, and also the")),
        ("fleet identifier sized per section in v2.md", text_mutant(
            "A fleet identifier, wherever Controller Profiles names one,",
            "A fleet identifier, wherever this subsection names one,")),
        ("name row loses its fleet identifier in v2.md", text_mutant(
            "| `name` | A fleet identifier; unique in the profile. |",
            "| `name` | A string; unique in the profile. |")),
        ("unmapped-bit bullet allows naming in v2.md", text_mutant(
            "and MUST NOT name an unmapped bit,", "and may name an unmapped bit,")),
        ("integer rule dropped in v2.md", text_mutant(
            " Every number in it is an integer.", "")),
        ("forbidden token renamed in v2.md", text_mutant(
            "never `controller_alarm_word` or `bitmask`.",
            "never `controller_alarm_word` or `bits`.")),
        ("forbidden tokens dropped in v2.md", text_mutant(
            "fleet identifiers, never `controller_alarm_word` or `bitmask`.",
            "fleet identifiers.")),
        ("sensor_type and unit loosened to strings in v2.md", text_mutant(
            "declares: fleet identifiers, never", "declares: non-empty strings, never")),
        ("kind renamed in v2.md", text_mutant(
            "| `kind` | `measurement` or `alarm_word`. |",
            "| `kind` | `measurement` or `status_word`. |")),
        ("function added in v2.md", text_mutant(
            "`read_holding_registers` or `read_input_registers`.",
            "`read_holding_registers`, `read_coils` or `read_input_registers`.")),
        ("measurement may carry other fields in v2.md", text_mutant(
            "exactly these, and no other field:", "at least these:")),
        ("row added to the measurement table in v2.md", text_mutant(
            "| `offset` | The same form;",
            "| `deadband` | Integer. |\n| `offset` | The same form;")),
        ("assertion rule inverted in v2.md", text_mutant(
            "when its bit has the value its\n  `active` names, and not asserted otherwise",
            "when its bit does not have the value its\n  `active` names")),
        ("range clause dropped from the uninterpreted-reading bullet in v2.md", text_mutant(
            " or because its `value` is not an integer in the word's range,", "")),
        ("float reading clause dropped in v2.md", text_mutant(
            " whether it is encoded as `5` or `5.0`", "")),
        ("unmapped bits clause widened in v2.md", text_mutant(
            "the unmapped bits that are set", "every unmapped bit")),
        ("bool admitted as an integer", lambda: run(
            corpus_bytes, model, frozenset({"bool_is_int"}))),
        ("integral float admitted as an integer", lambda: run(
            corpus_bytes, model, frozenset({"float_is_int"}))),
    ]
    def strings_only(c: dict) -> None:
        c["reject_cases"] = [x for x in c["reject_cases"] if not _non_string(x["document"])]

    def ints_only(trap: str) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            c["reject_cases"] = [x for x in c["reject_cases"] if broken_rules(
                x["document"], model, frozenset({trap})) == {x["rule"]}]
        return edit

    cases += [
        ("every non-string refusal dropped", corpus_mutant(strings_only)),
        ("every boolean-integer refusal dropped", corpus_mutant(ints_only("bool_is_int"))),
        ("every float-integer refusal dropped", corpus_mutant(ints_only("float_is_int"))),
        ("dependent rules judged before their premise", rule_off("dependents")),
    ]
    def guard_mutant(clause: str, flip: tuple[str, str] | None) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts["t2"] = guard_text(texts["t2"], clause, flip)
            run(corpus_bytes, contract_model(texts))
        return go

    for clause, flips in RECEIVER_GUARDS:
        short = clause[:48]
        cases.append((f"guard deleted: {short}", guard_mutant(clause, None)))
        for polarity in flips:
            cases.append((f"guard reversed ({polarity[0]} -> {polarity[1]}): {short}",
                          guard_mutant(clause, polarity)))
    for state in base["states"]:
        cases.append((f"state case {state['name']} dropped",
                      corpus_mutant(drop("states", state["name"]))))
    for rule in RULES:
        cases.append((f"rule off: {rule}", rule_off(rule)))
        cases.append((f"last refusal under {rule} dropped", corpus_mutant(drop_rule(rule))))
    # Mutants no corpus case can refuse, because the clause they remove is implied
    # by others: listed, never counted as survivors. Each holds because the
    # legality check refuses any other event order:
    # - a promotion keeps freshness, so the first reading accepted after it is
    #   later than any fault in the same epoch and ends the hold by itself;
    # - after a revocation nothing is accepted until a reinstatement and a
    #   promotion, and the promotion clears the fault, so the revocation's own
    #   clearing is never observed;
    # - a reinstatement follows a revocation, which has already left no latest
    #   reading and no fault, so it has nothing of either to keep;
    # - capping the bound at an hour changes nothing while every state case's
    #   poll interval is held to the alarm-word ceiling, where the bound is
    #   exactly an hour; the shape check is what refuses a case past it.
    equivalent = {
        "the bound capped at an hour again": rule_off("hour_cap"),
        "revocation keeps the fault": rule_off("revoke_keeps_fault"),
        "promotion keeps the fault": rule_off("promote_keeps_fault"),
        "reinstatement keeps the latest reading": rule_off("reinstate_keeps_latest"),
        "reinstatement keeps the fault": rule_off("reinstate_keeps_fault"),
    }
    survived = 0
    for label, mutant in cases + list(equivalent.items()):
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError) as refused:
            print(f"refused  {label}: {refused}")
        else:
            if label in equivalent:
                print(f"EQUIVALENT {label} (implied; not counted)")
            else:
                print(f"SURVIVED {label}")
                survived += 1
    # A heading-shaped line inside a fence in Receivers must not end the section.
    texts = contract_texts()
    at = texts["t2"].index("\n### Receivers\n") + len("\n### Receivers\n")
    for fence in ("```text\n### Not A Heading\n## Nor This\n```\n\n", "~~~\n#### Not A Heading\n~~~\n\n"):
        texts["t2"] = contract_texts()["t2"][:at] + "\n" + fence + contract_texts()["t2"][at:]
        try:
            run(corpus_bytes, contract_model(texts))
        except (Failure, KeyError, StopIteration, ValueError, TypeError) as refused:
            print(f"WRONGLY REFUSED a fenced heading-shaped line in Receivers: {refused}")
            survived += 1
        else:
            print(f"accepted a fenced heading-shaped line in Receivers: {fence.split(chr(10))[1]!r}")
    print(f"{len(cases)} mutants, {len(equivalent)} known equivalent")
    return survived


def main(argv: list[str]) -> int:
    try:
        model = contract_model()
    except (Failure, ValueError, KeyError) as failure:
        print(f"firmware-telemetry/v2 contract: {failure}")
        return 1
    corpus_bytes = CORPUS.read_bytes()
    try:
        run(corpus_bytes, model)
    except (Failure, KeyError, TypeError, ValueError, StopIteration) as failure:
        print(f"firmware-telemetry/v2 controller profile corpus: {failure!r}")
        return 1
    corpus = json.loads(corpus_bytes)
    print(
        f"firmware-telemetry/v2 controller profile corpus: {len(corpus['cases'])} "
        f"documents accepted, {len(corpus['reject_cases'])} refusals each for exactly "
        f"its rule, {len(corpus['reject_bytes'])} byte strings refused, "
        f"{len(corpus['interpretations'])} interpretations, {len(corpus['ranges'])} range "
        f"cases, "
        f"{len(corpus['agreements'])} agreement cases and {len(corpus['states'])} "
        f"state cases reproduced"
    )
    if argv == ["--mutations"]:
        survived = mutations(corpus_bytes, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    elif argv:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
