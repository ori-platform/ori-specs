            ],
        ),
        scenario(
            "inrun_site_change_locks_admission",
            base() + [
                step("open", "opened", proposal="before-change"),
                step("apply_provisioning", "applied", site_id="site-2"),
                step("admit", "site_binding_mismatch", proposal="before-change", credential="owner-key"),
                step("open", "site_binding_mismatch", proposal="during-change"),
                step("apply_provisioning", "applied", site_id="site-1"),
                step("admit", "approved", proposal="before-change", credential="owner-key"),
            ],
        ),
        scenario(
            "inrun_device_and_site_change_device_decides",
            base() + [
                step("open", "opened", proposal="before-change"),
                step("apply_provisioning", "applied", site_id="site-2"),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("admit", "device_binding_mismatch", proposal="before-change", credential="owner-key"),
                step("apply_provisioning", "applied", device_id="edge-1"),
                step("admit", "site_binding_mismatch", proposal="before-change", credential="owner-key"),
                step("apply_provisioning", "applied", site_id="site-1"),
                step("admit", "approved", proposal="before-change", credential="owner-key"),
            ],
        ),
        scenario(
            "inrun_phone_commit_device_changed",
            base() + [
                phone_issue("ip-device", "phone-ip-device", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="ip-device", credential="phone-ip-device", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("phone_commit", "device_binding_mismatch", challenge_id="ip-device", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "inrun_phone_commit_site_changed",
            base() + [
                phone_issue("ip-site", "phone-ip-site", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="ip-site", credential="phone-ip-site", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("apply_provisioning", "applied", site_id="site-2"),
                step("phone_commit", "site_binding_mismatch", challenge_id="ip-site", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "inrun_phone_commit_device_over_site",
            base() + [
                phone_issue("ip-both", "phone-ip-both", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="ip-both", credential="phone-ip-both", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("apply_provisioning", "applied", site_id="site-2"),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("phone_commit", "device_binding_mismatch", challenge_id="ip-both", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "inrun_phone_commit_after_restore",
            base() + [
                phone_issue("ip-restored", "phone-ip-restored", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="ip-restored", credential="phone-ip-restored", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("apply_provisioning", "applied", device_id="edge-1"),
                step("phone_commit", "enrolled", challenge_id="ip-restored", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "inrun_phone_revoked_authorizer_over_device",
            base() + [
                phone_issue("ip-auth", "phone-ip-auth", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="ip-auth", credential="phone-ip-auth", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("revoke", "revoked", document=revoke(1, ["owner-key"])),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("phone_commit", "authorizer_unavailable", challenge_id="ip-auth", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "inrun_phone_revision_over_device",
            base() + [
                phone_issue("ip-rev", "phone-ip-rev", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="ip-rev", credential="phone-ip-rev", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("enrol", "enrolled", credential="app-other", authorizer="owner-key", local_request=True, possession=True),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("phone_commit", "registry_changed", challenge_id="ip-rev", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "inrun_challenge_presented_device_changed",
            base() + [
                step("issue", "issued", challenge_id="ip-lan", kind="enrol", candidate=candidate_of({"op": "enrol", "credential": "app-ip"})),
                step("apply_provisioning", "applied", device_id="edge-2"),
                step("enrol", "device_binding_mismatch", challenge_id="ip-lan", credential="app-ip", authorizer="owner-key", local_request=True, possession=True),
            ],
        ),
        scenario(
            "recovery_binds_the_runtime_device",
            base() + [
                step("lose", "locked"),
                step("restart", "restarted", device_id="edge-2"),
                step("recover", "recovered", local_request=True, epoch=EPOCH_3, contacts=[]),
                step("local_seed", "seeded", credential="edge2-key", approver_id="edge2-key", channel="lan_ed25519", local_request=True, possession=True),
                step("open", "opened", proposal="under-edge-2"),
                step("admit", "approved", proposal="under-edge-2", credential="edge2-key"),
                step("restart", "restarted", device_id="edge-1"),
                step("open", "device_binding_mismatch", proposal="back-on-edge-1"),
                step("revoke", "device_binding_mismatch", document=revoke(1, ["edge2-key"], epoch=EPOCH_3, device="edge-2")),
            ],
        ),
        scenario(
            "recovery_binds_the_runtime_site",
            base() + [
                step("lose", "locked"),
                step("restart", "restarted", site_id="site-2"),
                step("recover", "recovered", local_request=True, epoch=EPOCH_3, contacts=[]),
                step("local_seed", "seeded", credential="site2-key", approver_id="site2-key", channel="lan_ed25519", local_request=True, possession=True),
                step("open", "opened", proposal="under-site-2"),
                step("admit", "approved", proposal="under-site-2", credential="site2-key"),
                step("restart", "restarted", site_id="site-1"),
                step("open", "site_binding_mismatch", proposal="back-on-site-1"),
                step("revoke", "site_binding_mismatch", document=revoke(1, ["site2-key"], epoch=EPOCH_3, site="site-2")),
            ],
        ),
        scenario(
            "revocation_document_decided_before_binding",
            base() + [
                step("restart", "restarted", device_id="edge-2"),
                step("revoke", "signature_invalid", document=revoke(1, ["owner-key"], domain=b"wrong.domain")),
                step("revoke", "malformed", document={**revoke(1, ["owner-key"]), "unexpected": 1}),
                step("revoke", "device_binding_mismatch", document=revoke(1, ["owner-key"])),
                step("restart", "restarted", device_id="edge-1"),
                step("lose", "locked"),
                step("revoke", "malformed", document={**revoke(1, ["owner-key"]), "unexpected": 1}),
                step("revoke", "registry_unavailable", document=revoke(1, ["owner-key"])),
            ],
        ),
        scenario(
            "device_change_decides_over_site_change",
            base() + [
                step("open", "opened", proposal="before-change"),
                step("restart", "restarted", site_id="site-2"),
                step("restart", "restarted", device_id="edge-2"),
                step("admit", "device_binding_mismatch", proposal="before-change", credential="owner-key"),
                step("open", "device_binding_mismatch", proposal="during-change"),
                step("revoke", "device_binding_mismatch", document=revoke(1, ["owner-key"])),
                step("restart", "restarted", device_id="edge-1"),
                step("open", "site_binding_mismatch", proposal="site-still-changed"),
                step("revoke", "site_binding_mismatch", document=revoke(1, ["owner-key"])),
                step("restart", "restarted", site_id="site-1"),
                step("admit", "proposal_unavailable", proposal="before-change", credential="owner-key"),
            ],
        ),
        scenario(
            "revocation_before_admission",
            base()
            + [
                step("open", "opened", proposal="p1"),
                step("revoke", "revoked", document=revoke(1, ["owner-key"])),
                step(
                    "admit",
                    "credential_unavailable",
                    proposal="p1",
                    credential="owner-key",
                ),
            ],
        ),
        scenario(
            "admission_before_revocation_stands",
            base()
            + [
                step("open", "opened", proposal="p1"),
                step("admit", "approved", proposal="p1", credential="owner-key"),
                step("revoke", "revoked", document=revoke(1, ["owner-key"])),
                step(
                    "admit", "already_decided", proposal="p1", credential="owner-key"
                ),
            ],
        ),
    ]
    return {
        "contract": "tier-c-approvers/v1",
        "proof": (
            "state-model representability only; no runtime or gateway consumer. Channel match on possession and "
            "Tier C replies cannot decide alone in v1, and neither can a channel without an authenticated ingress on "
            "a possession reply: the set of authenticated ingresses changes only across a restart, which invalidates "
            "every pending operation first. The WhatsApp steps are two-fault by construction. A channel without an "
            "authenticated ingress decides alone only on a Tier C reply after a restart that removed SMS ingress. "
            "Each scenario starts with SMS as its one authenticated ingress, device edge-1 and site site-1; a restart "
            "step's sms_ingress, device_id and site_id set the configuration it starts under, and a restart without "
            "one keeps that part unchanged. A change of "
            "either is a restart or an apply_provisioning step, which changes it while the runtime runs, as "
            "runtime-config-orchestration/v1 applies an accepted document whole."
        ),
        "provisioning_test_public_key_b64": base64.b64encode(
            KEY.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
        ).decode(),
        "previous_test_public_key_b64": public_b64(PREVIOUS_KEY),
        "commercial_test_public_key_b64": public_b64(COMMERCIAL_KEY),
        "wire": wire_vectors(),
        "scenarios": cases,
    }


def main() -> int:
    rendered = json.dumps(make(), indent=2, sort_keys=True) + "\n"
    if "--check" in sys.argv[1:]:
        if not OUT.exists() or OUT.read_text() != rendered:
            print("tier-c-approvers/v1 corpus differs from generator", file=sys.stderr)
            return 1
        print("tier-c-approvers/v1 corpus reproduces")
        return 0
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
