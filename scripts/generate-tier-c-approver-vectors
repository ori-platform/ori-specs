        scenario(
            "replacement_does_not_inherit_cutoff",
            base()
            + [
                step(
                    "enrol",
                    "enrolled",
                    credential="app-old",
                    authorizer="owner-phone",
                    local_request=True,
                    presence=True,
                    possession=True,
                ),
                step("open", "opened", proposal="p1"),
                step("revoke", "revoked", document=revoke(1, ["app-old"])),
                step(
                    "enrol",
                    "enrolled",
                    credential="app-new",
                    authorizer="owner-phone",
                    local_request=True,
                    presence=True,
                    possession=True,
                ),
                step(
                    "admit",
                    "enrolled_after_proposal",
                    proposal="p1",
                    credential="app-new",
                ),
            ],
        ),
        scenario(
            "revoked_value_cannot_be_relabelled_in_same_epoch",
            base()
            + [
                step("enrol", "enrolled", credential="app-old", value="key-value", authorizer="owner-phone", local_request=True, presence=True, possession=True),
                step("revoke", "revoked", document=revoke(1, ["app-old"])),
                step("enrol", "value_tombstoned", credential="app-new", value="key-value", authorizer="owner-phone", local_request=True, presence=True, possession=True),
            ],
        ),
        scenario(
            "revocation_repeat_regression_conflict",
            base()
            + [
                step("revoke", "revoked", document=revoke(2, ["owner-phone"])),
                step("revoke", "replayed", document=revoke(2, ["owner-phone"]), document_wire=json.dumps(revoke(2, ["owner-phone"]), indent=2)),
                step(
                    "revoke", "revision_regressed", document=revoke(1, ["owner-phone"])
                ),
