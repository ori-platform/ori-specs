                step("lose", "locked"),
                step("phone_commit", "possession_expired", challenge_id="pending-lock-late", channel="sms", value="+2348012345678", phone_case="late"),
            ],
        ),
        scenario(
            "phone_lock_without_recovery_wrong_code",
            base() + [
                phone_issue("pending-lock-code", "phone-lock-code", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="pending-lock-code", credential="phone-lock-code", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("lose", "locked"),
                step("phone_commit", "possession_invalid", challenge_id="pending-lock-code", channel="sms", value="+2348012345678", phone_case="wrong_code"),
            ],
        ),
        scenario(
            "phone_late_over_wrong_code",
            base() + [
                phone_issue("pending-late-code", "phone-late-code", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="pending-late-code", credential="phone-late-code", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("phone_commit", "possession_expired", challenge_id="pending-late-code", channel="sms", value="+2348012345678", phone_case="late_wrong_code"),
            ],
        ),
        scenario(
            "phone_wrong_code_over_revoked_authorizer",
            base() + [
                phone_issue("pending-code-auth", "phone-code-auth", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="pending-code-auth", credential="phone-code-auth", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("revoke", "revoked", document=revoke(1, ["owner-key"])),
                step("phone_commit", "possession_invalid", challenge_id="pending-code-auth", channel="sms", value="+2348012345678", phone_case="wrong_code"),
            ],
        ),
        scenario(
            "phone_recovery_then_late_reply",
            base() + [
                phone_issue("pending-recovery-late", "phone-old-late", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="pending-recovery-late", credential="phone-old-late", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("lose", "locked"),
                step("recover", "recovered", local_request=True, epoch=EPOCH_3),
                step("phone_commit", "epoch_changed", challenge_id="pending-recovery-late", channel="sms", value="+2348012345678", phone_case="late"),
            ],
        ),
        scenario(
            "phone_recovery_then_locked_registry",
            base() + [
                phone_issue("pending-recovery-locked", "phone-old-locked", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="pending-recovery-locked", credential="phone-old-locked", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("lose", "locked"),
                step("recover", "recovered", local_request=True, epoch=EPOCH_3),
                step("lose", "locked"),
                step("phone_commit", "epoch_changed", challenge_id="pending-recovery-locked", channel="sms", value="+2348012345678", phone_case="valid"),
            ],
        ),
        scenario(
            "phone_recovery_before_commit",
            base() + [
                phone_issue("pending-recovery", "phone-old-epoch", "+2348012345678"),
                step("phone_authorize", "phone_pending", challenge_id="pending-recovery", credential="phone-old-epoch", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True),
                step("lose", "locked"),
