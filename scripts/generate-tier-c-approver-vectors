#!/usr/bin/env python3
"""Generate deterministic tier-c-approvers/v1 state-model fixtures."""

from __future__ import annotations

import base64
import hashlib
import json
import pathlib
import sys

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

OUT = (
    pathlib.Path(__file__).resolve().parent.parent
    / "tier-c-approvers"
    / "vectors"
    / "transitions.json"
)
KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 published test key").digest()
)
AUTHORIZER_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 authorizer test key").digest()
)
CANDIDATE_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 candidate test key").digest()
)
PREVIOUS_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 previous provisioning test key").digest()
)
COMMERCIAL_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 commercial test key").digest()
)


def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def public_b64(key: Ed25519PrivateKey) -> str:
    return base64.b64encode(
        key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    ).decode()


def signed_proof(unsigned: dict, *, domain: bytes, key: Ed25519PrivateKey) -> dict:
    preimage = domain + b"\0" + canonical(unsigned)
    return {
        "object": {
            **unsigned,
            "signature": base64.b64encode(key.sign(preimage)).decode(),
        },
        "preimage_hex": preimage.hex(),
    }


def wire_vectors() -> dict:
    challenge = {
        "v": 1,
        "challenge_id": base64.b64encode(bytes(range(16))).decode(),
        "device_id": "edge-1",
        "site_id": "site-1",
        "identity_epoch": "epoch-1",
        "operation": "enrol",
        "registry_revision": 1,
        "candidates": [
            {
                "approver_id": "operator-2",
                "credential_id": "app-2",
                "channel": "lan_ed25519",
                "value": "ed25519:" + public_b64(CANDIDATE_KEY),
            }
        ],
    }
    digest = hashlib.sha256(canonical(challenge)).hexdigest()
    authorizer = signed_proof(
        {
            "v": 1,
            "challenge_id": challenge["challenge_id"],
            "challenge_sha256": digest,
            "authorizer_credential_id": "app-1",
        },
        domain=b"ori.tier_c_approver.enrol.v1",
        key=AUTHORIZER_KEY,
    )
    possession = signed_proof(
        {
            "v": 1,
            "challenge_id": challenge["challenge_id"],
            "challenge_sha256": digest,
            "candidate_credential_id": "app-2",
        },
        domain=b"ori.tier_c_approver.possession.v1",
        key=CANDIDATE_KEY,
    )
    phone_text = f"ORI-ENROL-V1 {challenge['challenge_id']} {digest}"
    return {
        "challenge": challenge,
        "challenge_canonical_hex": canonical(challenge).hex(),
        "authorizer_public_key_b64": public_b64(AUTHORIZER_KEY),
        "authorizer": authorizer,
        "candidate_public_key_b64": public_b64(CANDIDATE_KEY),
        "candidate_spki_sha256": hashlib.sha256(
            CANDIDATE_KEY.public_key().public_bytes(
                Encoding.DER, PublicFormat.SubjectPublicKeyInfo
            )
        ).hexdigest(),
        "possession": possession,
        "phone_authorization_ascii_hex": phone_text.encode("ascii").hex(),
        "phone_value_cases": [
            {"value": "+2348012345678", "valid": True},
            {"value": "whatsapp:+2348012345678", "valid": False},
            {"value": "+1 555 0123", "valid": False},
            {"value": "+01234", "valid": False},
            {"value": "08012345678", "valid": False},
        ],
    }


def revoke(
    revision: int,
    targets: list[str],
    *,
    epoch: str = "epoch-1",
    site: str = "site-1",
    key: Ed25519PrivateKey = KEY,
    domain: bytes = b"ori.tier_c_approver.revoke.v1",
) -> dict:
    unsigned = {
        "v": 1,
        "device_id": "edge-1",
        "site_id": site,
        "identity_epoch": epoch,
        "revision": revision,
        "targets": sorted(
            target if target.startswith("approver:") else f"credential:{target}"
            for target in targets
        ),
        "signing_key": "ed25519:" + public_b64(key),
    }
    signature = key.sign(domain + b"\0" + canonical(unsigned))
    return {**unsigned, "signature": base64.b64encode(signature).decode()}


def scenario(name: str, steps: list[dict], *, initial_mode: str = "factory_fresh") -> dict:
    expanded = []
    for index, operation in enumerate(steps):
        if operation["op"] in {"bootstrap", "recover", "enrol", "local_seed"} and "challenge_id" not in operation:
            challenge_id = f"{name}.{index}"
            expanded.append(step("issue", "issued", challenge_id=challenge_id, kind=operation["op"], candidate=candidate_of(operation)))
            operation = {**operation, "challenge_id": challenge_id}
        expanded.append(operation)
    return {"name": name, "initial_mode": initial_mode, "steps": expanded}


def step(op: str, expect: str, **data: object) -> dict:
    if op == "revoke" and "document" in data:
        unsigned = {
            key: value for key, value in data["document"].items() if key != "signature"
        }
        data["preimage_hex"] = (
            b"ori.tier_c_approver.revoke.v1\0" + canonical(unsigned)
        ).hex()
    return {"op": op, "expect": expect, **data}


def candidate_of(operation: dict) -> object:
    if operation["op"] == "bootstrap":
        return operation.get("contacts", [])
    if operation["op"] == "recover":
        return []
    return {
        "credential": operation["credential"],
        "approver_id": operation.get("approver_id", operation["credential"]),
        "channel": operation.get("channel", "lan_ed25519"),
        "value": operation.get("value", operation["credential"]),
    }


def base() -> list[dict]:
    return [
        step(
            "bootstrap",
            "bootstrapped",
            local_request=True,
            presence=True,
            contacts=["owner-phone"],
        ),
    ]


def make() -> dict:
    cases = [
        scenario(
            "bootstrap_once",
            base()
