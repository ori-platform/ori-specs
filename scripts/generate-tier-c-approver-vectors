                step("recover", "contacts_forbidden", local_request=True, epoch=EPOCH_2, contacts=["owner-key"]),
                step("recover", "recovered", local_request=True, epoch=EPOCH_2, contacts=[]),
            ],
        ),
        scenario(
            "recovery_refuses_multiple_contacts",
