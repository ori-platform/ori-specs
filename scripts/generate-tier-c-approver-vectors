                step("enrol", "possession_invalid", credential="phone-wrong-sender", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True, phone_case="wrong_sender"),
                step("enrol", "possession_invalid", credential="phone-wrong-channel", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True, phone_case="wrong_channel"),
                step("enrol", "possession_invalid", credential="phone-unauthed", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True, phone_case="unauthenticated"),
                step("enrol", "enrolled", credential="phone-good", channel="sms", value="+2348012345678", authorizer="owner-key", local_request=True, phone_case="valid"),
            ],
        ),
        scenario(
            "phone_candidate_late_reply_refused",
