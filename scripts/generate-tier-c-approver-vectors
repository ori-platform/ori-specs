                step("local_seed", "local_auth_required", credential="app-1", approver_id="new-owner", channel="lan_ed25519", local_request=False, presence=True, possession=True),
                step("local_seed", "presence_required", credential="app-1", approver_id="new-owner", channel="lan_ed25519", local_request=True, presence=False, possession=True),
                step("local_seed", "lan_key_required", credential="app-1", approver_id="new-owner", channel="sms", local_request=True, presence=True, possession=True),
                step("local_seed", "possession_invalid", credential="app-1", approver_id="new-owner", channel="lan_ed25519", local_request=True, presence=True, possession=False),
                step("local_seed", "seeded", credential="app-1", approver_id="new-owner", channel="lan_ed25519", local_request=True, presence=True, possession=True),
                step("admit", "enrolled_after_proposal", proposal="before-seed", credential="app-1"),
                step("open", "opened", proposal="after-seed"),
                step("admit", "approved", proposal="after-seed", credential="app-1"),
                step("local_seed", "active_authorizer_exists", credential="app-2", approver_id="other-owner", channel="lan_ed25519", local_request=True, presence=True, possession=True),
            ],
        ),
        scenario(
            "recovery_can_seed_but_closes_old_proposals",
            base()
            + [
                step("open", "opened", proposal="old"),
                step("lose", "locked"),
                step("local_seed", "registry_unavailable", credential="new-app", approver_id="new-owner", channel="lan_ed25519", local_request=True, presence=True, possession=True),
                step("recover", "recovered", local_request=True, presence=True, epoch="epoch-2"),
                step("local_seed", "seeded", credential="new-app", approver_id="new-owner", channel="lan_ed25519", local_request=True, presence=True, possession=True),
                step("admit", "proposal_unavailable", proposal="old", credential="new-app"),
            ],
        ),
        scenario(
            "all_revoked_can_seed_new_identity",
            base()
            + [
                step("revoke", "revoked", document=revoke(1, ["approver:owner-phone"])),
                step("local_seed", "approver_revoked", credential="app-1", approver_id="owner-phone", channel="lan_ed25519", local_request=True, presence=True, possession=True),
                step("local_seed", "seeded", credential="app-1", approver_id="new-owner", channel="lan_ed25519", local_request=True, presence=True, possession=True),
