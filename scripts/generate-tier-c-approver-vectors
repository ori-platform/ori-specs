#!/usr/bin/env python3
"""Generate deterministic tier-c-approvers/v1 state-model fixtures."""

from __future__ import annotations

import base64
import hashlib
import json
import pathlib
import sys

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

OUT = (
    pathlib.Path(__file__).resolve().parent.parent
    / "tier-c-approvers"
    / "vectors"
    / "transitions.json"
)
SITE_ID = "site-1"
EPOCH_1 = base64.b64encode(bytes(range(32, 48))).decode("ascii")
EPOCH_2 = base64.b64encode(bytes(range(48, 64))).decode("ascii")
EPOCH_3 = base64.b64encode(bytes(range(64, 80))).decode("ascii")
KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 published test key").digest()
)
AUTHORIZER_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 authorizer test key").digest()
)
CANDIDATE_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 candidate test key").digest()
)
PREVIOUS_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 previous provisioning test key").digest()
)
COMMERCIAL_KEY = Ed25519PrivateKey.from_private_bytes(
    hashlib.sha256(b"ori tier-c-approvers/v1 commercial test key").digest()
)


def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def public_b64(key: Ed25519PrivateKey) -> str:
    return base64.b64encode(
        key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    ).decode()


def signed_proof(unsigned: dict, *, domain: bytes, key: Ed25519PrivateKey) -> dict:
    preimage = domain + b"\0" + canonical(unsigned)
    return {
        "object": {
            **unsigned,
            "signature": base64.b64encode(key.sign(preimage)).decode(),
        },
        "preimage_hex": preimage.hex(),
    }


def wire_vectors() -> dict:
    challenge = {
        "v": 1,
        "challenge_id": base64.b64encode(bytes(range(16))).decode(),
        "device_id": "edge-1",
        "site_id": SITE_ID,
        "identity_epoch": EPOCH_1,
        "operation": "enrol",
        "registry_revision": 1,
        "candidates": [
            {
                "approver_id": "operator-2",
                "credential_id": "app-2",
                "channel": "lan_ed25519",
                "value": "ed25519:" + public_b64(CANDIDATE_KEY),
            }
        ],
    }
    digest = hashlib.sha256(canonical(challenge)).hexdigest()
    authorizer = signed_proof(
        {
            "v": 1,
            "challenge_id": challenge["challenge_id"],
            "challenge_sha256": digest,
            "authorizer_credential_id": "app-1",
        },
        domain=b"ori.tier_c_approver.enrol.v1",
        key=AUTHORIZER_KEY,
    )
    possession = signed_proof(
        {
            "v": 1,
            "challenge_id": challenge["challenge_id"],
            "challenge_sha256": digest,
            "candidate_credential_id": "app-2",
        },
        domain=b"ori.tier_c_approver.possession.v1",
        key=CANDIDATE_KEY,
    )
    phone_text = f"ORI-ENROL-V1 {challenge['challenge_id']} {digest}"
    phone_challenge = {
        **challenge,
        "challenge_id": base64.b64encode(bytes(range(80, 96))).decode("ascii"),
        "candidates": [{
            "approver_id": "operator-phone",
            "credential_id": "phone-1",
            "channel": "sms",
            "value": "+2348012345678",
        }],
    }
    phone_code = base64.b64encode(bytes(range(96, 112))).decode("ascii")
    phone_possession_text = f"ORI-POSSESS-V1 {phone_challenge['challenge_id']} {phone_code}"
    return {
        "challenge": challenge,
        "challenge_canonical_hex": canonical(challenge).hex(),
        "authorizer_public_key_b64": public_b64(AUTHORIZER_KEY),
        "authorizer": authorizer,
        "candidate_public_key_b64": public_b64(CANDIDATE_KEY),
        "candidate_spki_sha256": hashlib.sha256(
            CANDIDATE_KEY.public_key().public_bytes(
                Encoding.DER, PublicFormat.SubjectPublicKeyInfo
            )
        ).hexdigest(),
        "possession": possession,
        "phone_authorization_ascii_hex": phone_text.encode("ascii").hex(),
        "phone_candidate": {
            "challenge": phone_challenge,
            "challenge_canonical_hex": canonical(phone_challenge).hex(),
            "code_sha256": hashlib.sha256(phone_code.encode("ascii")).hexdigest(),
            "sent_ascii_hex": phone_possession_text.encode("ascii").hex(),
            "reply": {"channel": "sms", "sender": "+2348012345678", "text_ascii_hex": phone_possession_text.encode("ascii").hex()},
        },
        "phone_value_cases": [
            {"value": "+2348012345678", "valid": True},
            {"value": "whatsapp:+2348012345678", "valid": False},
            {"value": "+1 555 0123", "valid": False},
            {"value": "+01234", "valid": False},
            {"value": "08012345678", "valid": False},
        ],
    }


def revoke(
    revision: int,
    targets: list[str],
    *,
    epoch: str = EPOCH_2,
    site: str = SITE_ID,
    device: str = "edge-1",
    key: Ed25519PrivateKey = KEY,
    domain: bytes = b"ori.tier_c_approver.revoke.v1",
) -> dict:
    unsigned = {
        "v": 1,
        "device_id": device,
        "site_id": site,
        "identity_epoch": epoch,
        "revision": revision,
        "targets": sorted(
            target if target.startswith("approver:") else f"credential:{target}"
            for target in targets
        ),
        "signing_key": "ed25519:" + public_b64(key),
    }
    signature = key.sign(domain + b"\0" + canonical(unsigned))
    return {**unsigned, "signature": base64.b64encode(signature).decode()}


def scenario(name: str, steps: list[dict], *, initial_mode: str = "locked") -> dict:
    expanded = []
    for index, operation in enumerate(steps):
        if operation["op"] in {"recover", "enrol", "local_seed"} and "challenge_id" not in operation:
            challenge_id = f"{name}.{index}"
            issue_data = {"challenge_id": challenge_id, "kind": operation["op"], "candidate": candidate_of(operation)}
            if operation["op"] == "recover":
                issue_data["proposed_epoch"] = operation["epoch"]
            if operation["op"] == "enrol" and operation.get("channel") in {"sms", "whatsapp"}:
                code = base64.b64encode(hashlib.sha256(challenge_id.encode("ascii")).digest()[:16]).decode("ascii")
                issue_data["phone_code_sha256"] = hashlib.sha256(code.encode("ascii")).hexdigest()
            expanded.append(step("issue", "issued", **issue_data))
            operation = {**operation, "challenge_id": challenge_id}
        if operation["op"] == "enrol" and operation.get("channel") in {"sms", "whatsapp"}:
            expanded.append({
                **{key: value for key, value in operation.items() if key not in {"expect", "phone_case"}},
                "op": "phone_authorize",
                "expect": "phone_pending",
            })
            operation = {
                "op": "phone_commit",
                "expect": operation["expect"],
                "challenge_id": operation["challenge_id"],
                "value": operation["value"],
                "channel": operation["channel"],
                "phone_case": operation["phone_case"],
            }
        if operation["op"] == "phone_commit" and "phone_case" in operation:
            case = operation["phone_case"]
            operation = {key: value for key, value in operation.items() if key != "phone_case"}
            challenge_id = operation["challenge_id"]
            code = base64.b64encode(hashlib.sha256(challenge_id.encode("ascii")).digest()[:16]).decode("ascii")
            # late_wrong_code is a reply both past its window and carrying the wrong code.
            late, wrong_code = case in ("late", "late_wrong_code"), case in ("wrong_code", "late_wrong_code")
            if case != "missing":
                # A wrong-channel reply is flagged authenticated. It is refused by
                # two rules at once: the channel rule (v1 has no authenticated
                # whatsapp ingress) and the channel match (the candidate is sms).
                reply_channel = "whatsapp" if case == "wrong_channel" else operation["channel"]
                operation["phone_reply"] = {
                    "sender": "+2348099999999" if case == "wrong_sender" else operation["value"],
                    "channel": reply_channel,
                    "authenticated": case != "unauthenticated",
                    "text": f"ORI-POSSESS-V1 {challenge_id} " + ("AAAAAAAAAAAAAAAAAAAAAA==" if wrong_code else code),
                }
                operation["phone_elapsed_ms"] = 600001 if late else 1000
        expanded.append(operation)
    return {"name": name, "initial_mode": initial_mode, "steps": expanded}


def step(op: str, expect: str, **data: object) -> dict:
    if op == "revoke" and "document" in data:
        unsigned = {
            key: value for key, value in data["document"].items() if key != "signature"
        }
        data["preimage_hex"] = (
            b"ori.tier_c_approver.revoke.v1\0" + canonical(unsigned)
        ).hex()
    return {"op": op, "expect": expect, **data}


def candidate_of(operation: dict) -> object:
    if operation["op"] == "recover":
        return []
    return {
        "credential": operation["credential"],
        "approver_id": operation.get("approver_id", operation["credential"]),
        "channel": operation.get("channel", "lan_ed25519"),
        "value": operation.get("value", operation["credential"]),
    }


def phone_issue(challenge_id: str, credential: str, value: str, *, channel: str = "sms", expect: str = "issued",
                approver_id: str | None = None) -> dict:
    code = base64.b64encode(hashlib.sha256(challenge_id.encode("ascii")).digest()[:16]).decode("ascii")
    operation = {"op": "enrol", "credential": credential, "channel": channel, "value": value}
    if approver_id is not None:
        operation["approver_id"] = approver_id
    return step(
        "issue", expect, challenge_id=challenge_id, kind="enrol",
        candidate=candidate_of(operation),
        phone_code_sha256=hashlib.sha256(code.encode("ascii")).hexdigest(),
    )


def base() -> list[dict]:
    return [
        step(
            "recover",
            "recovered",
            local_request=True,
            epoch=EPOCH_2,
            contacts=[],
        ),
        step("local_seed", "seeded", credential="owner-key", approver_id="owner-key", channel="lan_ed25519", local_request=True, possession=True),
    ]


def make() -> dict:
    cases = [
        scenario(
            "recovery_once",
            base()
            + [
                step(
                    "recover",
                    "recovery_not_available",
                    local_request=True,
