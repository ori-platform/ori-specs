            "previous_and_wrong_class_anchors_refused",
            base()
            + [
                step("revoke", "superseded_signer", document=revoke(1, ["owner-phone"], key=PREVIOUS_KEY)),
                step("revoke", "wrong_authority", document=revoke(1, ["owner-phone"], key=COMMERCIAL_KEY)),
                step("revoke", "revoked", document=revoke(1, ["owner-phone"])),
            ],
        ),
        scenario(
            "malformed_revocation_documents",
            base()
            + [
                step("revoke", "malformed", document={**revoke(1, ["owner-phone"]), "unexpected": 1}),
                step("revoke", "malformed", document={**revoke(1, ["owner-phone"]), "targets": ["credential:owner-phone", "credential:owner-phone"]}),
                step("revoke", "malformed", document={**revoke(1, ["owner-phone"]), "targets": ["credential:z", "credential:a"]}),
                step("revoke", "malformed", document={**revoke(1, ["owner-phone"]), "revision": True}),
                step("revoke", "malformed", document={**revoke(1, ["owner-phone"]), "targets": []}),
                step("revoke", "unknown_signer", document={**revoke(1, ["owner-phone"]), "signing_key": "ed25519:" + public_b64(CANDIDATE_KEY)}),
                step("revoke", "signature_invalid", document=revoke(1, ["owner-phone"], domain=b"wrong.domain")),
                step("revoke", "malformed", document=revoke(1, ["owner-phone"]), document_wire='{"v":1,"v":1}'),
                step("revoke", "revoked", document=revoke(1, ["owner-phone"])),
            ],
        ),
        scenario(
            "unknown_target_makes_revocation_atomic",
            base()
            + [
                step("revoke", "unknown_target", document=revoke(1, ["owner-phone", "zzz-absent"])),
                step("open", "opened", proposal="p1"),
                step("admit", "approved", proposal="p1", credential="owner-phone"),
            ],
        ),
        scenario(
            "approver_revocation_removes_all_credentials",
            [
                step("bootstrap", "bootstrapped", local_request=True, presence=True, contacts=["owner-phone", "secondary-phone"]),
                step("enrol", "enrolled", credential="app-1", approver_id="owner-phone", authorizer="owner-phone", local_request=True, presence=True, possession=True),
                step("revoke", "revoked", document=revoke(1, ["approver:owner-phone"])),
                step("open", "opened", proposal="p1"),
                step("admit", "credential_unavailable", proposal="p1", credential="app-1"),
                step("enrol", "approver_revoked", credential="app-2", approver_id="owner-phone", authorizer="secondary-phone", local_request=True, presence=True, possession=True),
            ],
        ),
        scenario(
            "revocation_wrong_epoch",
            base()
            + [
                step(
                    "revoke",
                    "binding_mismatch",
                    document=revoke(1, ["owner-phone"], epoch="epoch-2"),
                )
            ],
        ),
        scenario(
            "unicode_binding_is_canonical_but_wrong_site",
            base()
            + [
                step("revoke", "binding_mismatch", document=revoke(1, ["owner-phone"], site="sité")),
            ],
        ),
        scenario(
            "revocation_before_admission",
            base()
            + [
                step("open", "opened", proposal="p1"),
                step("revoke", "revoked", document=revoke(1, ["owner-phone"])),
                step(
                    "admit",
                    "credential_unavailable",
                    proposal="p1",
                    credential="owner-phone",
                ),
            ],
        ),
        scenario(
            "admission_before_revocation_stands",
            base()
            + [
                step("open", "opened", proposal="p1"),
                step("admit", "approved", proposal="p1", credential="owner-phone"),
                step("revoke", "revoked", document=revoke(1, ["owner-phone"])),
                step(
                    "admit", "already_decided", proposal="p1", credential="owner-phone"
                ),
            ],
        ),
    ]
    return {
        "contract": "tier-c-approvers/v1",
        "proof": "state-model representability only; no runtime or gateway consumer",
        "provisioning_test_public_key_b64": base64.b64encode(
            KEY.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
        ).decode(),
        "previous_test_public_key_b64": public_b64(PREVIOUS_KEY),
        "commercial_test_public_key_b64": public_b64(COMMERCIAL_KEY),
        "wire": wire_vectors(),
        "scenarios": cases,
    }


def main() -> int:
    rendered = json.dumps(make(), indent=2, sort_keys=True) + "\n"
    if "--check" in sys.argv[1:]:
        if not OUT.exists() or OUT.read_text() != rendered:
            print("tier-c-approvers/v1 corpus differs from generator", file=sys.stderr)
            return 1
        print("tier-c-approvers/v1 corpus reproduces")
        return 0
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(rendered)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
