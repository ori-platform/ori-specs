                step("revoke", "revoked", document=revoke(1, ["owner-key"])),
                step("phone_commit", "authorizer_unavailable", challenge_id="pending-revoked", channel="sms", value="+2348012345678", phone_case="valid"),
                step("open", "opened", proposal="after-revoke"),
