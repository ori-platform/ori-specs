                step("enrol", "enrolled", challenge_id="good", credential="app-1", authorizer="owner-phone", local_request=True, presence=True, possession=True),
                step("enrol", "challenge_reused", challenge_id="good", credential="app-1", authorizer="owner-phone", local_request=True, presence=True, possession=True),
                step("issue", "issued", challenge_id="restart", kind="enrol", candidate=candidate_of({"op": "enrol", "credential": "app-2"})),
                step("restart", "restarted"),
                step("enrol", "challenge_unavailable", challenge_id="restart", credential="app-2", authorizer="owner-phone", local_request=True, presence=True, possession=True),
            ],
        ),
        scenario(
            "late_authorizer_cannot_use_stale_challenge",
            base()
            + [
                step("issue", "issued", challenge_id="old-challenge", kind="enrol", candidate=candidate_of({"op": "enrol", "credential": "app-2"})),
                step("enrol", "enrolled", credential="app-1", authorizer="owner-phone", local_request=True, presence=True, possession=True),
                step("enrol", "challenge_stale", challenge_id="old-challenge", credential="app-2", authorizer="app-1", local_request=True, presence=True, possession=True),
