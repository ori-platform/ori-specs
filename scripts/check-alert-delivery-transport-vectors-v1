    ("check 2 content type", "tr", "the media type `application/octet-stream`, compared", "the media type `application/json`, compared"),
    ("check 2 method", "tr", "The method is `POST`, compared", "The method is `PUT`, compared"),
    ("check 3 status 403", "tr", "held for another client selects nothing. Otherwise 401.", "held for another client selects nothing. Otherwise 403."),
