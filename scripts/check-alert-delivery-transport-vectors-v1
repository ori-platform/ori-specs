def text_mutants(texts: dict[str, str]) -> list[tuple[str, dict[str, str] | None]]:
    out: list[tuple[str, dict[str, str] | None]] = []
    for key, sentence in PINS:
        words = sentence.split()
        pattern = r"\s+".join(re.escape(w) for w in words)
        t = dict(texts)
        t[key], n = re.subn(pattern, lambda _m: " ".join(words[:-1]) + " XX", t[key], count=1)
        out.append((f"text cut: {key}: {sentence[:60]}", t if n == 1 else None))
    for label, key, old, new in TEXT_EDITS:
        out.append((f"text edit: {label}", _sub(texts, key, old, new)))
    return out


def run_mutations(corpus: dict, model: dict, texts: dict[str, str]) -> int:
    survivors: list[str] = []
    total = 0
    baseline = set(check(corpus, model))
    for m in judge_mutants(model):
        total += 1
        errs = set(check(corpus, model, frozenset([m]))) - baseline
        # A judge mutant leaves the corpus's shape alone: a crash is no refusal.
        if not [e for e in errs if not e.startswith(("coverage:", "fatal: corpus shape:"))]:
            survivors.append(f"judge mutant {m}")
    for name, x in corpus_mutants(corpus, model):
        total += 1
        new = set(check(x, model)) - baseline
        # A mutant that changes only a value keeps the corpus's shape, so it is
        # refused for its property only by a judgement, never by a crash.
        if name.endswith(("flipped", "altered", "moved", "renamed", "changed", "made the named one")):
            new = {e for e in new if not e.startswith("fatal: corpus shape:")}
        if not new:
            survivors.append(f"corpus mutant {name}")
    for name, t in text_mutants(texts):
        total += 1
        if t is None:
            survivors.append(f"{name} (did not apply)")
            continue
        try:
            mm = build_model(t)
        except Failure:
            continue
        if not (set(check(corpus, mm)) - baseline):
            survivors.append(name)
    for s in survivors:
        print(f"SURVIVED: {s}", file=sys.stderr)
    if survivors:
        print(f"check-alert-delivery-transport-vectors-v1 --mutations: {len(survivors)} of {total} mutants survived", file=sys.stderr)
        return 1
    print(f"check-alert-delivery-transport-vectors-v1 --mutations: all {total} mutants refused")
    return 0


def self_test() -> None:
    """RFC 5869 test case 1 and RFC 4231 test case 2, for this script's own HKDF and HMAC."""
    okm = my_hkdf(bytes.fromhex("0b" * 22), bytes.fromhex("000102030405060708090a0b0c"),
                  bytes.fromhex("f0f1f2f3f4f5f6f7f8f9"), 42)
    if okm.hex() != ("3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf"
                     "34007208d5b887185865"):
        raise Failure("crypto: own HKDF fails RFC 5869 test case 1")
    if my_hmac(b"Jefe", b"what do ya want for nothing?").hex() != \
            "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843":
        raise Failure("crypto: own HMAC fails RFC 4231 test case 2")


def main(argv: list[str]) -> int:
    args = argv[1:]
    if args not in ([], ["--mutations"]):
        print(__doc__, file=sys.stderr)
        return 2

    def pairs(ps):
        d = {}
        for k, v in ps:
            if k in d:
                raise ValueError(f"duplicate member {k}")
            d[k] = v
        return d

    try:
        self_test()
        texts = load_texts()
        model = build_model(texts)
        corpus = json.loads(CORPUS.read_text(encoding="utf-8"), object_pairs_hook=pairs)
    except (Failure, OSError, ValueError) as e:
        print(f"FAIL: {e}", file=sys.stderr)
        return 1
    errs = check(corpus, model)
    for e in errs:
        print(f"FAIL: {e}", file=sys.stderr)
    if errs:
        print(f"check-alert-delivery-transport-vectors-v1: {len(errs)} failures", file=sys.stderr)
    else:
        print(f"check-alert-delivery-transport-vectors-v1: {len(corpus['key_ids'])} key_ids, "
              f"{len(corpus['requests'])} requests, {len(corpus['responses'])} responses and "
              f"{len(corpus['config'])} config cases hold against the text; {len(PINS)} sentences pinned")
    if args == ["--mutations"]:
        rc = run_mutations(corpus, model, texts)
        return 1 if errs else rc
    return 1 if errs else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
