# --- status-record notes ---------------------------------------------------------
#
# Every note in status/firmware-commands/v2.json, the top-level one and each adoption
# entry's, held verbatim: a note states what implements this contract and what
# proof exists, and the status checker reads neither. A note added, removed or
# changed fails here until this table is updated in review.
STATUS_NOTES: tuple[tuple[str, str], ...] = (
    ('notes',
     'Exists for the rate_limited verdict, which answers relay_close only, and for the '
     'rule that a runtime never reissues a command to recover its delivery. Fresh '
     'open_protected_circuit attempts for a latched Tier D trip are not reissues and '
     'continue, under the binding the governing safety-profile contract authorizes. '
     "Command and provisioning approval bytes are v1's and keep v 1. Runtime liveness "
     "keeps v1's grammar at v 1 and gains v 2, carrying a fresh 128-bit nonce from which "
     'the signing runtime bounds how long ago a device began the transaction behind a '
     'reading, under firmware-telemetry/v2; nothing implements liveness v 2 yet. Runtime '
     'liveness at v 1 is implemented by the runtime signer and the edge firmware '
     'verifier, which is implementation and not end-to-end or HIL proof; no device image '
     'gates a Local Interlock on it. The runtime has adopted the rate_limited and '
     'no-reissue rules; the edge firmware has not. The runtime adopts it before any '
     'device signs a v 2 fault, and devices accept liveness v 2 before the runtime '
     'publishes it.'),
    ('adoption[0] producer runtime notes',
     'The runtime signs the unchanged command bytes and never reissues a command: egress '
     'publishes once, held by tests on its call sites, its scheduling and its client. It '
     'reads rate_limited only as a firmware-telemetry/v2 fault. It drives no '
     'firmware-commanded zone, so the Tier D attempt carve-out has no runtime path yet. '
     'No conformance claim is made, so the version is not frozen by this merge. It '
     'publishes liveness at v 1 only: it generates no nonce and keeps no liveness table.'),
)


def status_notes(record: dict) -> list[tuple[str, str]]:
    out = [("notes", record["notes"])] if "notes" in record else []
    for index, entry in enumerate(record.get("adoption", [])):
        if "notes" in entry:
            where = f"adoption[{index}] {entry['role']} {entry['repository']} notes"
            out.append((where, entry["notes"]))
    return out


def check_status_notes(raw: str) -> None:
    found = status_notes(json.loads(raw))
    if found != list(STATUS_NOTES):
        added = [n for n in found if n not in STATUS_NOTES]
        removed = [n for n in STATUS_NOTES if n not in found]
        raise Failure(f"status notes changed in status/firmware-commands/v2.json: added {added}, removed {removed}"
                      + ("" if added or removed else ", reordered"))


def contract_texts() -> dict[str, str]:
    return {"c1": COMMANDS_V1.read_text(), "c2": COMMANDS_V2.read_text()}


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = contract_texts() if texts is None else texts
    check_status_notes(texts.get("status") or STATUS.read_text())
    docs = {"commands": texts["c2"], "telemetry": texts.get("t2") or TELEMETRY_V2.read_text()}
    check_normative(docs, OWNER, HELD_SENTENCES)
    c1, c2 = texts["c1"], texts["c2"]
    live2 = section(c2, "## Runtime Liveness at `v` 2")
    wire2 = section(live2, "### Wire format")
    accept2 = section(live2, "### Acceptance")
    held2 = section(live2, "### The held nonce")
    golden2 = section(live2, "### Golden vectors")
    live1 = section(c1, "## Runtime Liveness")
    wire1 = section(live1, "### Wire format")
    fresh1 = section(live1, "### Freshness without a device clock")
    for sentence in V2_WIRE:
        need(wire2, sentence, "firmware-commands/v2.md Wire format")
    for sentence in V2_ACCEPTANCE:
        need(accept2, sentence, "firmware-commands/v2.md Acceptance")
    for sentence in V2_HELD:
        need(held2, sentence, "firmware-commands/v2.md The held nonce")
    for clause, _ in GUARDS:
        need(live2, clause, "firmware-commands/v2.md Runtime Liveness at v 2")
    for sentence in ROLLOUT_GOLDEN:
        need(golden2, sentence, "firmware-commands/v2.md Golden vectors")
    for sentence in V2_GOLDEN:
        need(golden2, sentence, "firmware-commands/v2.md Golden vectors")
    for sentence in V1_WIRE[:-1]:
        need(wire1, sentence, "firmware-commands/v1.md Wire format")
    need(fresh1, V1_WIRE[-1], "firmware-commands/v1.md Freshness")

    order2 = _field_order(wire2)
    order1 = _field_order(wire1)
    for order in (order1, order2):
        if order != sorted(order):
            raise Failure(f"field order {order} is not the lexicographic one the text claims")
    nonce = re.search(
        r"`nonce` is a JSON string of exactly (\d+) characters, each one of `(.)`-`(.)` "
        r"or `(.)`-`(.)`", flat(wire2))
    assert nonce is not None
    alphabet = "".join(
        chr(c) for lo, hi in ((nonce.group(2), nonce.group(3)), (nonce.group(4), nonce.group(5)))
        for c in range(ord(lo), ord(hi) + 1))
    versions = re.search(r"A `v` other than the integer `(\d)` or `(\d)` is `malformed`", flat(wire2))
    assert versions is not None
    bounds = {}
    for field in ("boot_id", "runtime_seq"):
        match = re.search(
            rf"`{field}` is a canonical decimal integer[^.]*?within `(\d+) \.\. 2\^(\d+) - 1`",
            flat(wire1))
        if match is None:
            raise Failure(f"v1.md states no range for {field}")
        bounds[field] = (int(match.group(1)), 2 ** int(match.group(2)) - 1)
    fleet = re.search(r"`device_id` is a fleet identifier: `(\[[^`]+\])`, non-empty", flat(wire1))
    assert fleet is not None
    rows = re.findall(r"^\| (\d+) \| (.+?) \| `([a-z0-9_]+)` \|\s*$", accept2, re.M)
    if [int(r[0]) for r in rows] != list(range(1, len(rows) + 1)):
        raise Failure("the acceptance table's order column is not 1..n")
    order = []
    for _, cell, reason in rows:
        if cell not in CHECK_CELLS:
            raise Failure(f"acceptance table check {cell!r} has no predicate here")
        order.append((reason, CHECK_CELLS[cell]))
    if sorted(p for _, p in order) != sorted(CHECK_CELLS.values()):
        raise Failure("the acceptance table does not name every check exactly once")
    mqtt = re.search(r"^\| `(ori/fw/<device_id>/runtime)` \| (\d) \| \*\*(no|yes)\*\* \|",
                     section(c1, "## MQTT Transport Binding"), re.M)
    assert mqtt is not None
    refusals_part, _, rollout_part = golden2.partition("They cover:")
    bullets = [flat(b) for b in re.findall(r"^- (.+?)(?=\n- |\n\n)", refusals_part, re.M | re.S)]
    if bullets != list(REFUSAL_BULLETS):
        raise Failure(f"the golden-vectors refusal list changed: {bullets}")
    rollout_bullets = [flat(b) for b in re.findall(r"^- (.+?)(?=\n- |\n\n)", rollout_part,
                                                   re.M | re.S)]
    if rollout_bullets != list(ROLLOUT_BULLETS):
        raise Failure(f"the rollout sequences' cover list changed: {rollout_bullets}")
    rollout = section(live2, "### Publication during rollout")
    for sentence in ROLLOUT_SENTENCES:
        need(rollout, sentence, "firmware-commands/v2.md Publication during rollout")
    pin = re.search(r"\[liveness-vectors-v2\.json\]\(liveness-vectors-v2\.json\).*?"
                    r"Its SHA-256 is `([0-9a-f]{64})`", flat(golden2))
    if pin is None:
        raise Failure("firmware-commands/v2.md pins no liveness corpus digest")
    return {
        "order": order,
        "fields": {1: order1, 2: order2},
        "nonce_length": int(nonce.group(1)),
        "nonce_alphabet": alphabet,
        "versions": (int(versions.group(1)), int(versions.group(2))),
        "bounds": bounds,
        "fleet": fleet.group(1),
        "hash_hex": 64,
        "topic": mqtt.group(1),
        "qos": int(mqtt.group(2)),
        "retain": mqtt.group(3) == "yes",
        "sig_prefix": "ed25519:",
        "sig_length": 64,
        "seq_strict": True,
        "closed_keys": True,
        "v1_seq_exempt": False,
        "v2_sets_nonce": True,
        "v1_clears_nonce": True,
        "refusal_keeps_nonce": True,
        "pin": pin.group(1),
    }


# --- the device -------------------------------------------------------------------

def _int_ok(value: object, bounds: tuple[int, int]) -> bool:
    return type(value) is int and bounds[0] <= value <= bounds[1]


def split_message(raw: bytes) -> tuple[bytes, bytes] | None:
    """The liveness object bytes and the signature field bytes, by position."""
    head, tail = b'{"liveness":', b',"signature":"'
    cut = raw.rfind(tail)
    if not raw.startswith(head) or cut < 0 or not raw.endswith(b'"}'):
        return None
    return raw[len(head):cut], raw[cut + len(tail):-2]


def decode_signature(field: bytes, model: dict) -> bytes | None:
    try:
        text = field.decode("ascii")
    except UnicodeDecodeError:
        return None
    if not text.startswith(model["sig_prefix"]):
        return None
    body = text[len(model["sig_prefix"]):]
    try:
        raw = base64.b64decode(body, validate=True)
    except ValueError:
        return None
    if base64.b64encode(raw).decode() != body or len(raw) != model["sig_length"]:
        return None
    return raw


def grammar_ok(raw: bytes, model: dict) -> bool:
    """firmware-commands/v2's grammar, by the `v` the object carries."""
    try:
        top = parse_pairs(raw)
    except (ValueError, UnicodeDecodeError):
        return False
    if not isinstance(top, list) or [k for k, _ in top] != ["liveness", "signature"]:
        return False
    obj, signature = top[0][1], top[1][1]
    if not isinstance(obj, list) or not isinstance(signature, str):
        return False
    if serialize(top).encode() != raw:
        return False
    fields = dict(obj)
    if len(fields) != len(obj):
        return False
    v = fields.get("v")
    if type(v) is not int or v not in model["versions"]:
        return False
    keys = [k for k, _ in obj]
    if not model["closed_keys"]:
        keys = [k for k in keys if k in model["fields"][v]]
    if keys != model["fields"][v]:
        return False
    if not _int_ok(fields["boot_id"], model["bounds"]["boot_id"]):
        return False
    if not _int_ok(fields["runtime_seq"], model["bounds"]["runtime_seq"]):
        return False
    if not isinstance(fields["device_id"], str) or not re.fullmatch(
            model["fleet"] + "+", fields["device_id"]):
        return False
    if not isinstance(fields["capability_hash"], str) or not re.fullmatch(
            "sha256:[0-9a-f]{%d}" % model["hash_hex"], fields["capability_hash"]):
        return False
    if "nonce" in fields:
        nonce = fields["nonce"]
        if not isinstance(nonce, str) or len(nonce) != model["nonce_length"]:
            return False
        if any(ch not in model["nonce_alphabet"] for ch in nonce):
            return False
    return decode_signature(signature.encode(), model) is not None


def lenient_fields(raw: bytes) -> dict:
    """Whatever fields a message carries, for judging the later checks alone."""
    try:
        top = parse_pairs(raw)
        assert isinstance(top, list)
        return dict(dict(top)["liveness"])
    except (ValueError, UnicodeDecodeError, TypeError, KeyError, AssertionError):
        return {}


def broken_checks(raw: bytes, retained: bool, ctx: dict, model: dict,
                  runtime_key: bytes) -> set[str]:
    """Every check this message fails, each judged on its own."""
    fields = lenient_fields(raw)
    parts = split_message(raw)
    signature = decode_signature(parts[1], model) if parts else None
    signed = parts is not None and signature is not None and ed25519_verify(
        runtime_key, parts[0], signature)
    last = ctx["last_accepted_runtime_seq"]
    seq = fields.get("runtime_seq")
    fails = {
        "retained": retained,
        "grammar": not grammar_ok(raw, model),
        "device": "device_id" in fields and fields["device_id"] != ctx["device_id"],
        "signature": not signed,
        "boot": "boot_id" in fields and fields["boot_id"] != ctx["boot_id"],
        "manifest": "capability_hash" in fields
        and fields["capability_hash"] != ctx["capability_hash"],
        "seq": type(seq) is int and (seq <= last if model["seq_strict"] else seq < last)
        and not (model["v1_seq_exempt"] and fields.get("v") == 1),
    }
    return {name for name, failed in fails.items() if failed}


def judge(raw: bytes, retained: bool, ctx: dict, held: object, model: dict,
          runtime_key: bytes, off: frozenset[str] = frozenset()) -> tuple[str | None, object]:
    """(None or the reason of the first failing check, the held nonce after)."""
    broken = broken_checks(raw, retained, ctx, model, runtime_key)
    for reason, check in model["order"]:
        if check in broken and check not in off:
            return reason, (held if model["refusal_keeps_nonce"] else None)
    fields = lenient_fields(raw)
    if fields.get("v") == 2:
        return None, fields.get("nonce") if model["v2_sets_nonce"] else held
    return None, None if model["v1_clears_nonce"] else held


# --- the corpus ---------------------------------------------------------------------

def _rebuild(case: dict, label: str) -> bytes:
    """The case's wire bytes, recomputed from its input and signature."""
    obj = serialize(list(case["input"].items()) if case["input"] else {}).encode()
    if bytes.fromhex(case["liveness_hex"]) != obj:
        raise Failure(f"{label}: liveness bytes do not reproduce from input")
    wire = serialize([("liveness", json.loads(obj, object_pairs_hook=lambda p: p)),
                      ("signature", "ed25519:" + case["signature_b64"])]).encode()
    if bytes.fromhex(case["message_hex"]) != wire:
        raise Failure(f"{label}: wire message does not reproduce")
    return wire


def check(corpus: dict, v1_corpus: dict, model: dict,
          off: frozenset[str] = frozenset()) -> dict:
    for key in ("runtime_test_seed_hex", "rogue_test_seed_hex"):
        if corpus[key] != v1_corpus[key]:
            raise Failure(f"{key} is not v1's liveness corpus seed")
    runtime_key = derive_public(bytes.fromhex(corpus["runtime_test_seed_hex"]))
    rogue_key = derive_public(bytes.fromhex(corpus["rogue_test_seed_hex"]))
    if corpus["runtime_public_key_hex"] != runtime_key.hex() or base64.b64decode(
            corpus["runtime_public_key_b64"]) != runtime_key:
        raise Failure("runtime public key does not derive from the seed")
    if corpus["rogue_public_key_hex"] != rogue_key.hex():
        raise Failure("rogue public key does not derive from the seed")
    if (corpus["topic"], corpus["qos"], corpus["retain"]) != (
            model["topic"], model["qos"], model["retain"]):
        raise Failure("corpus transport binding differs from v1's MQTT table")
    reasons = [r for r, _ in model["order"]]
    if sorted(corpus["reasons"]) != sorted(reasons):
        raise Failure("corpus reasons differ from the acceptance table")
    v1_reasons = {c["reason"] for k in ("reject_cases", "transport_reject_cases")
                  for c in v1_corpus[k]}
    if v1_reasons != set(reasons):
        raise Failure(f"v1's liveness corpus uses reasons {sorted(v1_reasons)}, not the table's")
    position = {r: i for i, (r, _) in enumerate(model["order"])}
    check_of = dict(model["order"])
    sig_at = next(i for i, (_, c) in enumerate(model["order"]) if c == "signature")

    names: set[str] = set()
    sections = ("cases", "reject_cases", "precedence_cases", "transport_reject_cases")
    for key in sections:
        for case in corpus[key]:
            if case["name"] in names:
                raise Failure(f"duplicate case {case['name']}")
            names.add(case["name"])

    facts: dict[str, list[str]] = {}

    def note(fact: str, name: str) -> None:
        facts.setdefault(fact, []).append(name)

    def run_case(case: dict, refused: bool) -> set[str]:
        label = case["name"]
        raw = _rebuild(case, label)
        ctx = case["verifier_context"]
        transport = case.get("transport")
        retained = bool(transport and transport["retain"])
        if transport is not None and transport["topic"] != model["topic"].replace(
                "<device_id>", ctx["device_id"]):
            raise Failure(f"{label}: delivered on another topic")
        held = ctx["held_nonce"]
        reason, after = judge(raw, retained, ctx, held, model, runtime_key, off)
        if after != case["expected_held_nonce"]:
            raise Failure(f"{label}: held nonce after is {after!r}, not "
                          f"{case['expected_held_nonce']!r}")
        parts = split_message(raw)
        assert parts is not None
        valid = ed25519_verify(runtime_key, parts[0], base64.b64decode(case["signature_b64"]))
        broken = broken_checks(raw, retained, ctx, model, runtime_key)
        if not refused:
            if reason is not None:
                raise Failure(f"{label}: refused ({reason})")
            return broken
        if case["reason"] not in reasons:
            raise Failure(f"{label}: undeclared reason {case['reason']}")
        if reason != case["reason"]:
            raise Failure(f"{label}: refused for {reason}, not {case['reason']}")
        if case["signature_valid"] is not valid:
            raise Failure(f"{label}: signature_valid says {case['signature_valid']}")
        if position[case["reason"]] > sig_at and not valid:
            raise Failure(f"{label}: refused after the signature without a valid one")
        if (not valid and len(broken) == 1 and ed25519_verify(
                rogue_key, parts[0], base64.b64decode(case["signature_b64"]))):
            note("rogue_key", label)
        return broken

    for case in corpus["cases"]:
        run_case(case, refused=False)
        held = case["verifier_context"]["held_nonce"]
        v = case["input"]["v"]
        if v == 2 and held != case["input"]["nonce"]:
            note("v2_sets", case["name"])
        if v == 1 and held is not None:
            note("v1_clears", case["name"])
        if v == 2 and case["input"]["nonce"] == "0" * model["nonce_length"]:
            note("zero_nonce", case["name"])
        for field in ("boot_id", "runtime_seq"):
            lo, hi = model["bounds"][field]
            if v == 2 and case["input"][field] == hi:
                note(f"v2_{field}_max", case["name"])
            if v == 2 and case["input"][field] == lo:
                note(f"v2_{field}_min", case["name"])
        for field in ("boot_id", "runtime_seq"):
            if case["input"][field] == model["bounds"][field][1]:
                note(f"{field}_max", case["name"])
            if case["input"][field] == model["bounds"][field][0]:
                note(f"{field}_min", case["name"])

    accepted_bytes = {c["message_hex"] for c in corpus["cases"]}
    single = corpus["reject_cases"] + [
        c for c in corpus["transport_reject_cases"] if len(_broken(c, model, runtime_key)) == 1]
    for case in single:
        broken = run_case(case, refused=True)
        if broken != {check_of[case["reason"]]}:
            raise Failure(f"{case['name']}: breaks {sorted(broken)}, not exactly "
                          f"{check_of[case['reason']]}")
        for item in _classify(case, model, accepted_bytes):
            note(item, case["name"])
    pairs_seen = set()
    for case in corpus["precedence_cases"] + [
            c for c in corpus["transport_reject_cases"] if c not in single]:
        broken = run_case(case, refused=True)
        index = position[case["reason"]]
        if index + 1 >= len(model["order"]) or broken != {
                check_of[case["reason"]], model["order"][index + 1][1]}:
            raise Failure(f"{case['name']}: breaks {sorted(broken)}, not "
                          f"{case['reason']} and the check after it")
        pairs_seen.add(index)

    # v1's corpus through the same device: a v 2 device accepts liveness at v 1.
    sentinel = "f" * model["nonce_length"]
    for key in ("cases", "reject_cases", "transport_reject_cases"):
        for case in v1_corpus[key]:
            raw = bytes.fromhex(case["message_hex"])
            transport = case.get("transport")
            retained = bool(transport and transport["retain"])
            reason, after = judge(raw, retained, case["verifier_context"], sentinel,
                                  model, runtime_key, off)
            want = case.get("reason")
            if reason != want:
                raise Failure(f"v1 {case['name']}: {reason} where v1's corpus says {want}")
            if after != (None if want is None else sentinel):
                raise Failure(f"v1 {case['name']}: held nonce after is {after!r}")
            if want is None:
                fields = lenient_fields(raw)
                for field in ("boot_id", "runtime_seq"):
                    if fields[field] == model["bounds"][field][1]:
                        note(f"{field}_max", "v1 " + case["name"])
                    if fields[field] == model["bounds"][field][0]:
                        note(f"{field}_min", "v1 " + case["name"])
            else:
                fields = lenient_fields(raw)
                for field in ("boot_id", "runtime_seq"):
                    lo, hi = model["bounds"][field]
                    if fields.get(field) == hi + 1:
                        note(f"{field}_above", "v1 " + case["name"])
                    if fields.get(field) == lo - 1:
                        note(f"{field}_below", "v1 " + case["name"])

    for seq in corpus["rollout_sequences"]:
        for fact in run_sequence(seq, model, runtime_key, off):
            note(fact, seq["name"])

    # coverage
    for reason in reasons:
        if not any(c["reason"] == reason for k in sections[1:] for c in corpus[k]):
            raise Failure(f"coverage: no refusal for {reason}")
    for index in range(len(model["order"]) - 1):
        if index not in pairs_seen:
            a, b = model["order"][index][0], model["order"][index + 1][0]
            raise Failure(f"coverage: no precedence case for {a} before {b}")
    # v2.md lists v 2 messages at the smallest and largest boot_id and the largest
    # runtime_seq; the rest of each bound pair is v1's, held by v1's corpus.
    for fact in ("v2_sets", "v1_clears", "zero_nonce", "v2_runtime_seq_max",
                 "v2_boot_id_min", "v2_boot_id_max", "runtime_seq_min",
                 "runtime_seq_above", "runtime_seq_below", "boot_id_above", "boot_id_below"):
        if fact not in facts:
            raise Failure(f"coverage: no case for {fact}")
    for group in ROLLOUT_BULLETS.values():
        for item in group:
            if item not in facts:
                raise Failure(f"coverage: no rollout sequence shows {item}")
    items = [i for group in REFUSAL_BULLETS.values() for i in group]
    _match(items, facts)
    return facts


def run_sequence(seq: dict, model: dict, runtime_key: bytes,
                 off: frozenset[str] = frozenset()) -> set[str]:
    """Drive one rollout sequence through the device, delivery by delivery."""
    label = seq["name"]
    if set(seq) != {"name", "device_accepts_versions", "verifier_context", "note", "deliveries"}:
        raise Failure(f"{label}: fields {sorted(seq)}")
    accepts = seq["device_accepts_versions"]
    if accepts not in ([1], [1, 2]):
        raise Failure(f"{label}: a device accepts only v 1 or both, not {accepts}")
    device = dict(model, versions=tuple(v for v in model["versions"] if v in accepts))
    ctx = dict(seq["verifier_context"])
    held = ctx["held_nonce"]
    facts: set[str] = set()
    v1_seqs = [d["input"]["runtime_seq"] for d in seq["deliveries"] if d["input"]["v"] == 1]
    v2_seqs = [d["input"]["runtime_seq"] for d in seq["deliveries"] if d["input"]["v"] == 2]
    if set(v1_seqs) & set(v2_seqs) or any(m - 1 in v2_seqs for m in v2_seqs):
        raise Failure(f"{label}: one runtime_seq serves both versions, or two v 2 messages")
    history = []
    for i, d in enumerate(seq["deliveries"]):
        if set(d) != {"input", "liveness_hex", "signature_b64", "message_hex", "expected_reason",
                      "expected_held_nonce", "expected_last_accepted_runtime_seq"}:
            raise Failure(f"{label} delivery {i}: fields {sorted(d)}")
        raw = _rebuild(d, f"{label} delivery {i}")
        parts = split_message(raw)
        assert parts is not None
        if not ed25519_verify(runtime_key, parts[0], base64.b64decode(d["signature_b64"])):
            raise Failure(f"{label} delivery {i}: a rollout message the runtime did not sign")
        reason, after = judge(raw, False, ctx, held, device, runtime_key, off)
        last = ctx["last_accepted_runtime_seq"]
        if reason is None:
            last = d["input"]["runtime_seq"]
        got = (reason, after, last)
        want = (d["expected_reason"], d["expected_held_nonce"],
                d["expected_last_accepted_runtime_seq"])
        if got != want:
            raise Failure(f"{label} delivery {i}: recomputed {got}, expected {want}")
        history.append((d["input"]["v"], d["input"]["runtime_seq"], reason, held, after))
        ctx["last_accepted_runtime_seq"], held = last, after
    accepted = [h for h in history if h[2] is None]
    if accepts == [1] and any(h[0] == 1 for h in accepted) and all(
            h[2] == "malformed" for h in history if h[0] == 2) and all(
            h[4] is None for h in history) and any(h[0] == 2 for h in history):
        facts.add("v1_only_supervised")
    if accepts == [1, 2]:
        last_v2 = [h for h in accepted if h[0] == 2]
        if last_v2 and held is not None and held == last_v2[-1][4] and accepted[-1] is last_v2[-1]:
            facts.add("ends_holding_v2")
        for a, b in zip(history[:-1], history[1:], strict=True):
            if a[0] == 1 and a[2] is None and a[4] is None and a[3] is not None and (
                    b[0] == 2 and b[1] == a[1] + 1 and b[2] is None):
                facts.add("none_between_pair")
            if a[0] == 2 and a[2] is None and b[0] == 1 and b[1] == a[1] - 1 and (
                    b[2] == "seq_not_increasing" and b[4] == a[4]):
                facts.add("reordered_keeps_v2")
        if any(h[0] == 2 and h[2] is None and h[1] - 1 not in v1_seqs for h in history):
            facts.add("v1_missing")
        if any(h[0] == 1 and h[2] is None and h[1] + 1 not in v2_seqs for h in history):
            facts.add("v2_missing")
    return facts


def _broken(case: dict, model: dict, runtime_key: bytes) -> set[str]:
    raw = bytes.fromhex(case["message_hex"])
    transport = case.get("transport")
    return broken_checks(raw, bool(transport and transport["retain"]),
                         case["verifier_context"], model, runtime_key)


def _classify(case: dict, model: dict, accepted_bytes: set[str]) -> list[str]:
    """The listed refusals a single-rule case exhibits, by its own content."""
    out = []
    inp, ctx = case["input"], case["verifier_context"]
    nonce = inp.get("nonce", ...)
    raw_v = inp.get("v")
    # A JSON boolean is not an integer; Python's True == 1 must not say otherwise.
    v = raw_v if type(raw_v) is int else None
    reason = case["reason"]
    if case.get("transport", {}).get("retain"):
        out.append("retained")
    if v == 2 and nonce is ...:
        out.append("v2_no_nonce")
    if v == 1 and nonce is not ...:
        out.append("v1_with_nonce")
    if v == 2 and isinstance(nonce, str):
        n = model["nonce_length"]
        if nonce == "":
            out.append("nonce_empty")
        elif len(nonce) == n - 1:
            out.append("nonce_short")
        elif len(nonce) == n + 1:
            out.append("nonce_long")
        elif len(nonce) == n and nonce.lower() != nonce and all(
                ch in model["nonce_alphabet"] for ch in nonce.lower()):
            out.append("nonce_upper")
        elif len(nonce) == n and nonce == nonce.lower() and any(
                ch not in model["nonce_alphabet"] for ch in nonce):
            out.append("nonce_non_hex")
    if v == 2 and nonce is None:
        out.append("nonce_null")
    if v == 2 and type(nonce) is int:
        out.append("nonce_integer")
    if v == 2 and type(nonce) is bool:
        out.append("nonce_boolean")
    if v == 2 and set(inp) > set(model["fields"][2]):
        out.append("v2_extra_key")
    keys = list(inp)
    if v == 2 and set(keys) == set(model["fields"][2]) and keys != model["fields"][2]:
        out.append("nonce_out_of_order")
    if v not in model["versions"]:
        out.append("unsupported_v")
    if reason == "seq_not_increasing":
        seq, last, held = inp["runtime_seq"], ctx["last_accepted_runtime_seq"], ctx["held_nonce"]
        # A held nonce names the version last accepted: none after a v 1 (the
        # contexts here are mid-boot, last > 0), the accepted message's after a v 2.
        if seq == last and v == 2 and case["message_hex"] in accepted_bytes and nonce == held:
            out.append("seq_replayed_exact")
        if seq == last and v == 2 and held is not None and nonce != held:
            out.append("seq_reissued_fresh")
        if seq == last and v == 2 and held is None and last > 0:
            out.append("v2_at_seq_of_accepted_v1")
        if seq == last and v == 1 and held is not None:
            out.append("v1_at_seq_of_accepted_v2")
        if seq < last:
            out.append("seq_regressing")
    if reason == "device_mismatch":
        out.append("wrong_device")
    if reason == "boot_mismatch":
        out.append("wrong_boot")
    if reason == "capability_hash_mismatch":
        out.append("wrong_manifest")
    return out


def _match(items: list[str], facts: dict[str, list[str]]) -> None:
    """Each listed refusal needs a case of its own: a bipartite matching."""
    owner: dict[str, str] = {}

    def place(item: str, seen: set[str]) -> bool:
        for name in facts.get(item, []):
            if name in seen:
                continue
            seen.add(name)
            if name not in owner or place(owner[name], seen):
                owner[name] = item
                return True
        return False

    for item in items:
        if not place(item, set()):
            raise Failure(f"coverage: no case of its own for the listed refusal {item}")


def run(corpus_bytes: bytes, model: dict, off: frozenset[str] = frozenset()) -> dict:
    if hashlib.sha256(corpus_bytes).hexdigest() != model["pin"]:
        raise Failure("corpus digest differs from the one firmware-commands/v2.md pins")
    return check(json.loads(corpus_bytes), json.loads(CORPUS_V1.read_bytes()), model, off)


# --- mutations -------------------------------------------------------------------------

def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)
    v1_base = json.loads(CORPUS_V1.read_bytes())

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check(mutated, v1_base, model)
        return go

    def v1_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(v1_base)
            edit(mutated)
            check(base, mutated, model)
        return go

    def model_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            run(corpus_bytes, mutated)
        return go

    def text_mutant(key: str, old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            if old not in texts[key]:
                raise AssertionError(f"mutant target missing from {key}: {old!r}")
            texts[key] = texts[key].replace(old, new, 1)
            run(corpus_bytes, contract_model(texts))
        return go

    def find(name: str) -> Callable[[dict], dict]:
        def get(c: dict) -> dict:
            for key in ("cases", "reject_cases", "precedence_cases", "transport_reject_cases"):
                for case in c[key]:
                    if case["name"] == name:
                        return case
            raise StopIteration(name)
        return get

    def drop(name: str) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            for key in ("cases", "reject_cases", "precedence_cases", "transport_reject_cases"):
                c[key] = [x for x in c[key] if x["name"] != name]
        return edit

    def flip_signature(name: str) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            case = find(name)(c)
            raw = bytearray(base64.b64decode(case["signature_b64"]))
            raw[40] ^= 1
            case["signature_b64"] = base64.b64encode(bytes(raw)).decode()
            obj = bytes.fromhex(case["liveness_hex"])
            case["message_hex"] = (b'{"liveness":' + obj + b',"signature":"ed25519:'
                                   + case["signature_b64"].encode() + b'"}').hex()
        return edit

    def admit_v3(m: dict) -> None:
        m.update(versions=(1, 2, 3))
        m["fields"][3] = m["fields"][2]

    def swap(i: int) -> Callable[[dict], None]:
        def edit(m: dict) -> None:
            m["order"][i], m["order"][i + 1] = m["order"][i + 1], m["order"][i]
        return edit

    def check_off(name: str) -> Callable[[], None]:
        def go() -> None:
            run(corpus_bytes, model, frozenset({name}))
        return go

    cases: list[tuple[str, Callable[[], None]]] = [
        ("accepted signature bit flipped", corpus_mutant(flip_signature("liveness_v2_first_after_boot"))),
        ("replay refusal signature bit flipped",
         corpus_mutant(flip_signature("reject_v2_replayed_exact_bytes"))),
        ("nonce edited after signing", corpus_mutant(
            lambda c: find("liveness_v2_replaces_held_nonce")(c)["input"].update(nonce="1" * 32))),
        ("declared held nonce wrong", corpus_mutant(
            lambda c: find("liveness_v1_clears_held_nonce")(c).update(
                expected_held_nonce="ed8e30f48bdd225a9acdd357aaa379f2"))),
        ("refusal changes the held nonce", corpus_mutant(
            lambda c: find("reject_v2_wrong_boot")(c).update(expected_held_nonce=None))),
        ("refusal relabelled", corpus_mutant(
            lambda c: find("reject_v2_wrong_boot")(c).update(reason="capability_hash_mismatch"))),
        ("precedence relabelled to the later check", corpus_mutant(
            lambda c: find("reject_boot_before_manifest")(c).update(
                reason="capability_hash_mismatch"))),
        ("signature_valid misstated", corpus_mutant(
            lambda c: find("reject_v2_wrong_device")(c).update(signature_valid=False))),
        ("retained flag cleared", corpus_mutant(
            lambda c: find("reject_v2_retained_delivery")(c)["transport"].update(retain=False))),
        ("delivered on another device's topic", corpus_mutant(
            lambda c: find("reject_v2_retained_delivery")(c)["transport"].update(
                topic="ori/fw/ori-fw-00000000/runtime"))),
        ("refusal moved to cases", corpus_mutant(
            lambda c: c["cases"].append(dict(find("reject_v2_nonce_null")(c), name="moved")))),
        ("runtime seed swapped", corpus_mutant(
            lambda c: c.update(runtime_test_seed_hex="12" * 32))),
        ("rogue seed swapped", corpus_mutant(lambda c: c.update(rogue_test_seed_hex="98" * 32))),
        ("corpus reason renamed", corpus_mutant(
            lambda c: c["reasons"].__setitem__("bad_signature", c["reasons"].pop("signature_invalid")))),
        ("v1 corpus reason renamed", v1_mutant(
            lambda c: c["reject_cases"][0].update(reason="replayed"))),
        ("v1 corpus case dropped from the bound pairs", v1_mutant(
            lambda c: c.update(reject_cases=[x for x in c["reject_cases"]
                                             if x["name"] != "reject_runtime_seq_above_max"]))),
        ("corpus digest pin wrong", model_mutant(lambda m: m.update(pin="0" * 64))),
        ("nonce one character shorter", model_mutant(
            lambda m: m.update(nonce_length=m["nonce_length"] - 1))),
        ("nonce one character longer", model_mutant(
            lambda m: m.update(nonce_length=m["nonce_length"] + 1))),
        ("nonce alphabet admits uppercase", model_mutant(
            lambda m: m.update(nonce_alphabet=m["nonce_alphabet"] + "ABCDEF"))),
        ("nonce alphabet admits g", model_mutant(
            lambda m: m.update(nonce_alphabet=m["nonce_alphabet"] + "g"))),
        ("v 2 takes v1's grammar", model_mutant(
            lambda m: m["fields"].__setitem__(2, m["fields"][1]))),
        ("nonce allowed at v 1", model_mutant(
            lambda m: m["fields"].__setitem__(1, m["fields"][2]))),
        ("v 3 admitted under v 2's grammar", model_mutant(admit_v3)),
        ("v 1 refused", model_mutant(lambda m: m.update(versions=(2,)))),
        ("boot_id ceiling lowered", model_mutant(
            lambda m: m["bounds"].__setitem__("boot_id", (1, 2**32 - 2)))),
        ("boot_id ceiling raised", model_mutant(
            lambda m: m["bounds"].__setitem__("boot_id", (1, 2**32)))),
        ("boot_id zero admitted", model_mutant(
            lambda m: m["bounds"].__setitem__("boot_id", (0, 2**32 - 1)))),
        ("runtime_seq ceiling lowered", model_mutant(
            lambda m: m["bounds"].__setitem__("runtime_seq", (1, 2**53 - 2)))),
        ("runtime_seq ceiling raised", model_mutant(
            lambda m: m["bounds"].__setitem__("runtime_seq", (1, 2**53)))),
        ("runtime_seq zero admitted", model_mutant(
            lambda m: m["bounds"].__setitem__("runtime_seq", (0, 2**53 - 1)))),
        ("equal runtime_seq admitted", model_mutant(lambda m: m.update(seq_strict=False))),
        ("extra keys admitted", model_mutant(lambda m: m.update(closed_keys=False))),
        ("a late v 1 message exempt from the high-water mark", model_mutant(
            lambda m: m.update(v1_seq_exempt=True))),
        ("rollout held nonce misdeclared", corpus_mutant(
            lambda c: c["rollout_sequences"][3]["deliveries"][1].update(expected_held_nonce=None))),
        ("rollout last accepted misdeclared", corpus_mutant(
            lambda c: c["rollout_sequences"][3]["deliveries"][1].update(
                expected_last_accepted_runtime_seq=10))),
        ("rollout device said to accept v 2", corpus_mutant(
            lambda c: c["rollout_sequences"][0].update(device_accepts_versions=[1, 2]))),
        ("text: reordered v 1 accepted", text_mutant(
            "c2", "the `v` `1` message is refused as\n  `seq_not_increasing`",
            "the `v` `1` message is accepted as\n  `seq_not_increasing`")),
        ("text: rollout cover bullet dropped", text_mutant(
            "c2", "- either message of the pair missing.\n", "")),
        ("v 2 does not set the nonce", model_mutant(lambda m: m.update(v2_sets_nonce=False))),
        ("v 1 does not clear the nonce", model_mutant(lambda m: m.update(v1_clears_nonce=False))),
        ("refusal clears the nonce", model_mutant(lambda m: m.update(refusal_keeps_nonce=False))),
        ("identifier alphabet widened", model_mutant(lambda m: m.update(fleet="[A-Za-z0-9._ /-]"))),
        ("capability hash length", model_mutant(lambda m: m.update(hash_hex=63))),
        ("signature prefix", model_mutant(lambda m: m.update(sig_prefix="ed25519-"))),
        ("signature length", model_mutant(lambda m: m.update(sig_length=32))),
        ("topic retained", model_mutant(lambda m: m.update(retain=True))),
        ("text: nonce length", text_mutant("c2", "exactly 32 characters, each one of",
                                           "exactly 33 characters, each one of")),
        ("text: uppercase admitted", text_mutant(
            "c2", "one containing an uppercase letter\n  or any other character, ", "")),
        ("text: v 3 admitted", text_mutant("c2", "A `v` other than the integer `1` or `2` is",
                                           "A `v` other than the integer `1` or `3` is")),
        ("text: field order", text_mutant(
            "c2", "`device_id`, `nonce`, `runtime_seq`, `v`, the lexicographic",
            "`device_id`, `runtime_seq`, `nonce`, `v`, the lexicographic")),
        ("text: retained check reworded", text_mutant(
            "c2", "| 1 | it was not delivered retained |", "| 1 | it arrived live |")),
        ("text: reason renamed", text_mutant("c2", "| `signature_invalid` |", "| `bad_signature` |")),
        ("text: checks reordered", text_mutant(
            "c2", "| 5 | `boot_id` equals the current boot | `boot_mismatch` |\n"
                  "| 6 | `capability_hash` equals the accepted manifest hash | `capability_hash_mismatch` |",
            "| 5 | `capability_hash` equals the accepted manifest hash | `capability_hash_mismatch` |\n"
            "| 6 | `boot_id` equals the current boot | `boot_mismatch` |")),
        ("text: refusal keeps nothing", text_mutant(
            "c2", "A refused message changes nothing, including the held nonce\nbelow.",
            "A refused message clears the held nonce.")),
        ("text: v 1 keeps the nonce", text_mutant("c2", "- Accepting a `v` `1` message clears it.",
                                                  "- Accepting a `v` `1` message keeps it.")),
        ("text: shared high-water mark dropped", text_mutant(
            "c2", "One high-water mark serves both versions", "Each version has its own high-water mark")),
        ("text: precedence list changed", text_mutant(
            "c2", "a wrong boot and a\nmanifest mismatch, and ", "")),
        ("text: the reverse dropped from the refusal list", text_mutant(
            "c2", ", and a `v` `1` message at the\n  `runtime_seq` of an accepted `v` `2` message;", ";")),
        ("text: refusal bullet dropped", text_mutant("c2", "- a message delivered retained.\n", "")),
        ("text: boot_id range", text_mutant("c1", "within `1 .. 2^32 - 1`", "within `1 .. 2^31 - 1`")),
        ("text: runtime_seq range", text_mutant(
            "c1", "(no leading zeros, no sign)\n  within `1 .. 2^53 - 1`. **Zero",
            "(no leading zeros, no sign)\n  within `1 .. 2^52 - 1`. **Zero")),
        ("text: runtime topic retained", text_mutant(
            "c1", "| `ori/fw/<device_id>/runtime` | 1 | **no** |",
            "| `ori/fw/<device_id>/runtime` | 1 | **yes** |")),
        ("text: corpus digest", text_mutant(
            "c2", "`26296ed9e2a9e5b2fafff4dd1be3cf0deccef674c148818e9f1205ff805da13d`",
            "`" + "0" * 64 + "`")),
    ]
    for index in range(len(model["order"]) - 1):
        a, b = model["order"][index][0], model["order"][index + 1][0]
        cases.append((f"checks {a} and {b} swapped", model_mutant(swap(index))))
    def normative_mutant(doc: str, mutated: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts[{'commands': 'c2'}[doc]] = mutated
            run(corpus_bytes, contract_model(texts))
        return go

    def status_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            record = json.loads(STATUS.read_text())
            edit(record)
            texts = contract_texts()
            texts["status"] = json.dumps(record, indent=2)
            run(corpus_bytes, contract_model(texts))
        return go

    def reword(old: str, new: str) -> Callable[[dict], None]:
        def edit(record: dict) -> None:
            for entry in [record, *record.get("adoption", [])]:
                if old in entry.get("notes", ""):
                    entry["notes"] = entry["notes"].replace(old, new, 1)
                    return
            raise AssertionError(f"status note phrase missing: {old!r}")
        return edit

    for label, old, new in (
        ('status: implementation claimed',
         'nothing implements liveness v 2 yet',
         'the runtime and the edge firmware implement liveness v 2'),
        ('status: proof claimed',
         'which is implementation and not end-to-end or HIL proof',
         'which is end-to-end and HIL proof'),
        ('status: runtime adoption claimed',
         'It publishes liveness at v 1 only: it generates no nonce and keeps no liveness table.',
         'It publishes liveness at v 2 and keeps the liveness table.'),
    ):
        cases.append((label, status_mutant(reword(old, new))))
    cases.append(("status: top-level note deleted", status_mutant(lambda r: r.pop("notes"))))
    for index in range(len(json.loads(STATUS.read_text())["adoption"])):
        cases.append((f"status: adoption[{index}] note deleted", status_mutant(
            lambda r, i=index: r["adoption"][i].pop("notes"))))
    cases.append(("status: a note added", status_mutant(lambda r: r["adoption"].append(
        dict(r["adoption"][0], notes="The edge firmware implements this version.")))))

    def heading_mutant(doc: str, mutated: str) -> Callable[[], None]:
        return normative_mutant(doc, mutated)

    docs_now = {"commands": contract_texts().get("c2") or COMMANDS_V2.read_text(),
                "telemetry": contract_texts().get("t2") or TELEMETRY_V2.read_text()}
    own_doc = next(doc for doc, table in SECTION_OWNERS.items()
                   if any(who == OWNER for _, who in table))
    places = {
        "owned": next(path for path, who in SECTION_OWNERS[own_doc] if who == OWNER),
        "unowned": next(path for path, who in SECTION_OWNERS[own_doc] if who is None),
    }
    for where, path in places.items():
        at = markdown.section_offsets(docs_now[own_doc], path)[0]
        for form_name, form in markdown.HEADING_FORMS:
            mutated = (docs_now[own_doc][:at] + markdown.form_insertion(form)
                       + docs_now[own_doc][at:])
            cases.append((f"heading form in an {where} section: {form_name}",
                          heading_mutant(own_doc, mutated)))

    current = contract_texts()
    for label, doc, mutated in normative_text_mutants(
            {"commands": current.get("c2") or COMMANDS_V2.read_text(),
              "telemetry": current.get("t2") or TELEMETRY_V2.read_text()}, OWNER, MUTATE_ALWAYS):
        cases.append((label, normative_mutant(doc, mutated)))

    def guard_mutant(clause: str, flip: tuple[str, str] | None) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts["c2"] = guard_text(texts["c2"], clause, flip)
            run(corpus_bytes, contract_model(texts))
        return go

    for clause, flips in GUARDS:
        short = clause[:48]
        cases.append((f"guard deleted: {short}", guard_mutant(clause, None)))
        for polarity in flips:
            cases.append((f"guard reversed ({polarity[0]} -> {polarity[1]}): {short}",
                          guard_mutant(clause, polarity)))
    for _, check_name in model["order"]:
        cases.append((f"check off: {check_name}", check_off(check_name)))
    for key in ("cases", "reject_cases", "precedence_cases", "transport_reject_cases"):
        for case in base[key]:
            cases.append((f"case {case['name']} dropped", corpus_mutant(drop(case["name"]))))
    for index, seq in enumerate(base["rollout_sequences"]):
        cases.append((f"rollout sequence {seq['name']} dropped", corpus_mutant(
            lambda c, i=index: c["rollout_sequences"].pop(i))))
    # Dropping an accepted case that no coverage item needs on its own is not
    # refusable by coverage: each holds a message beyond the listed ones.
    equivalent_drops = {
        "case liveness_v2_after_v1 dropped":
            "a v 2 accepted after a v 1; other v 2 cases set a held nonce, and the "
            "shared high-water mark is held by reject_v2_same_seq_as_accepted_v1 and "
            "reject_v1_same_seq_as_accepted_v2",
        "rollout sequence rollout_between_pair_holds_none dropped":
            "rollout_v2_device_ends_holding_v2_nonce also holds none after its second "
            "interval's v 1 message and before that interval's v 2 message",
        "rollout sequence rollout_v2_missing dropped":
            "rollout_between_pair_holds_none also ends on an accepted v 1 message whose v 2 "
            "message never arrives; a device cannot tell a lost v 2 from one not yet "
            "delivered",
        "case liveness_v2_after_sequence_gap dropped":
            "v2.md does not list a sequence gap among its accepted cases; v1's corpus "
            "holds one, which this script drives",
        "case liveness_v2_first_after_boot dropped":
            "runtime_seq 1 is also accepted at liveness_v2_min_boot_id, "
            "liveness_v2_max_boot_id and in v1's corpus, and a first message of a boot "
            "is not a listed item",
    }
    equivalent = {label: m for label, m in cases if label in equivalent_drops}
    cases = [(label, m) for label, m in cases if label not in equivalent_drops]
    survived = 0
    for label, mutant in cases + list(equivalent.items()):
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError) as refused:
            if label in equivalent:
                print(f"REFUSED (listed as equivalent) {label}: {refused}")
                survived += 1
            else:
                print(f"refused  {label}: {refused}")
        else:
            if label in equivalent:
                print(f"EQUIVALENT {label}: {equivalent_drops[label]}")
            else:
                print(f"SURVIVED {label}")
                survived += 1
    # Heading-shaped lines that are not headings must change nothing.
    for where, path in places.items():
        at = markdown.section_offsets(docs_now[own_doc], path)[0]
        before = markdown.sections(docs_now[own_doc])
        for form_name, inserted in markdown.NOT_HEADINGS:
            mutated = docs_now[own_doc][:at] + "\n" + inserted + docs_now[own_doc][at:]
            shifted = [p for p, _, _ in markdown.sections(mutated)]
            wrong = shifted != [p for p, _, _ in before] or markdown.non_canonical(mutated)
            if not wrong and "fence" in form_name:
                try:
                    normative_mutant(own_doc, mutated)()
                except Failure as refused:
                    wrong = str(refused)
            if wrong:
                print(f"WRONGLY REFUSED not a heading, in an {where} section: {form_name}: {wrong}")
                survived += 1
            else:
                print(f"accepted not a heading, in an {where} section: {form_name}")
    print(f"{len(cases)} mutants, {len(equivalent)} known equivalent")
    return survived


def main(argv: list[str]) -> int:
    try:
        model = contract_model()
    except (Failure, ValueError, AttributeError) as failure:
        print(f"firmware-commands/v2 liveness contract: {failure}")
        return 1
    corpus_bytes = CORPUS.read_bytes()
    try:
        run(corpus_bytes, model)
    except (Failure, KeyError, TypeError, ValueError) as failure:
        print(f"firmware-commands/v2 liveness corpus: {failure!r}")
        return 1
    corpus = json.loads(corpus_bytes)
    v1 = json.loads(CORPUS_V1.read_bytes())
    print(
        f"firmware-commands/v2 liveness corpus: {len(corpus['cases'])} cases accepted with "
        f"their held nonce, {len(corpus['reject_cases'])} refusals each for exactly its "
        f"check, {len(corpus['precedence_cases']) + len(corpus['transport_reject_cases'])} "
        f"transport and precedence refusals, and v1's "
        f"{len(v1['cases']) + len(v1['reject_cases']) + len(v1['transport_reject_cases'])} "
        f"cases through the same device, and {len(corpus['rollout_sequences'])} rollout "
        f"sequences of {sum(len(s['deliveries']) for s in corpus['rollout_sequences'])} "
        f"deliveries replayed"
    )
    print(f"{len(STATUS_NOTES)} status notes held, unchanged, in {STATUS.relative_to(ROOT)}")
    held = [s for doc in HELD_SENTENCES.values() for body in doc.values() for s in body]
    owned = sum(len(doc) for doc in HELD_SENTENCES.values())
    print(f"{len(held)} sentences held, unchanged, in the {owned} sections this checker owns")
    if argv == ["--mutations"]:
        survived = mutations(corpus_bytes, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    elif argv:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
