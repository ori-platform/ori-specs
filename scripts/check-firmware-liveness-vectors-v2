"""Check the firmware-commands/v2 liveness corpus against the contracts.

Shares no code with scripts/generate-firmware-liveness-vectors-v2. Object and
wire bytes come from this script's own serializer, and every signature is
verified with its own extended-coordinate Ed25519 arithmetic, cofactorless
with strict decoding as ed25519-verification/v1 requires. The field orders,
the nonce grammar, the versions, the integer bounds, the identifier alphabet,
the MQTT binding, the acceptance checks with their reasons and order, and the
corpus digest are read from firmware-commands/v2.md and v1.md; the seeds are
read from v1's liveness corpus, as v2.md says they are. Nothing is read from
the generator.

Held to:

- each accepted case: its object and wire bytes reproduce from its input, its
  signature verifies under the runtime key, and the device model accepts it
  and leaves the held nonce the case declares;
- each refusal: refused for its declared reason, by the first failing check in
  the text's order, with the held nonce unchanged; its `signature_valid`
  matches this script's verification, a rogue signature verifies under the
  rogue seed, and a refusal decided after the signature carries a valid one;
- each single-rule refusal breaks exactly one check, and each precedence case
  exactly two adjacent checks, refused for the earlier;
- v1's liveness corpus, driven through the same v2 device model: every v1
  case accepted (clearing the held nonce) and every v1 refusal refused for
  its reason, whose names are the ones the v2 table uses;
- coverage: every reason, every listed accepted and refused case, every
  adjacent precedence pair, and each bound's at-edge and past-edge pair
  across the two corpora;
- the digest firmware-commands/v2.md pins is the corpus's.

    python3 scripts/check-firmware-liveness-vectors-v2
    python3 scripts/check-firmware-liveness-vectors-v2 --mutations

`--mutations` corrupts the corpus, the contract text and this script's own
rule tables and constants in turn; every mutant must be refused.
"""

from __future__ import annotations

import base64
import copy
import hashlib
import importlib.machinery
import importlib.util
import types
import json
import pathlib
import re
import sys
from typing import Callable


def _load_contract_markdown() -> types.ModuleType:
    """scripts/contract-markdown, by path: the repository holds no *.py file."""
    path = pathlib.Path(__file__).resolve().parent / "contract-markdown"
    loader = importlib.machinery.SourceFileLoader("contract_markdown", str(path))
    spec = importlib.util.spec_from_loader("contract_markdown", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["contract_markdown"] = module
    loader.exec_module(module)
    return module


markdown = _load_contract_markdown()

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "firmware-commands" / "liveness-vectors-v2.json"
CORPUS_V1 = ROOT / "firmware-commands" / "liveness-vectors-v1.json"
COMMANDS_V1 = ROOT / "firmware-commands" / "v1.md"
COMMANDS_V2 = ROOT / "firmware-commands" / "v2.md"
STATUS = ROOT / "status" / "firmware-commands" / "v2.json"
TELEMETRY_V2 = ROOT / "firmware-telemetry" / "v2.md"


class Failure(Exception):
    pass


# --- Ed25519, extended coordinates, verification only -------------------------

Q = 2**255 - 19
ORDER = 2**252 + 27742317777372353535851937790883648493
CURVE_D = -121665 * pow(121666, Q - 2, Q) % Q
ROOT_M1 = pow(2, (Q - 1) // 4, Q)


def _x_from_y(y: int, sign: int) -> int | None:
    if y >= Q:
        return None
    x2 = (y * y - 1) * pow(CURVE_D * y * y + 1, Q - 2, Q) % Q
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (Q + 3) // 8, Q)
    if (x * x - x2) % Q:
        x = x * ROOT_M1 % Q
    if (x * x - x2) % Q:
        return None
    if x & 1 != sign:
        x = Q - x
    return x


def _point_add(a: tuple, b: tuple) -> tuple:
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    pa = (y1 - x1) * (y2 - x2) % Q
    pb = (y1 + x1) * (y2 + x2) % Q
    pc = 2 * t1 * t2 * CURVE_D % Q
    pd = 2 * z1 * z2 % Q
    e, f, g, h = pb - pa, pd - pc, pd + pc, pb + pa
    return (e * f % Q, g * h % Q, f * g % Q, e * h % Q)


def _scalar(k: int, point: tuple) -> tuple:
    acc = (0, 1, 1, 0)
    while k:
        if k & 1:
            acc = _point_add(acc, point)
        point = _point_add(point, point)
        k >>= 1
    return acc


def _to_bytes(point: tuple) -> bytes:
    x, y, z, _ = point
    zi = pow(z, Q - 2, Q)
    x, y = x * zi % Q, y * zi % Q
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def _from_bytes(raw: bytes) -> tuple | None:
    if len(raw) != 32:
        return None
    n = int.from_bytes(raw, "little")
    y = n & ((1 << 255) - 1)
    x = _x_from_y(y, n >> 255)
    if x is None:
        return None
    point = (x, y, 1, x * y % Q)
    return point if _to_bytes(point) == raw else None


_GY = 4 * pow(5, Q - 2, Q) % Q
_GX = _x_from_y(_GY, 0)
assert _GX is not None
GENERATOR = (_GX, _GY, 1, _GX * _GY % Q)


def derive_public(seed: bytes) -> bytes:
    digest = hashlib.sha512(seed).digest()
    a = int.from_bytes(digest[:32], "little")
    a = (a & ((1 << 254) - 8)) | (1 << 254)
    return _to_bytes(_scalar(a, GENERATOR))


_VERIFIED: dict[tuple[bytes, bytes, bytes], bool] = {}


def ed25519_verify(public: bytes, message: bytes, signature: bytes) -> bool:
    key = (public, message, signature)
    if key not in _VERIFIED:
        _VERIFIED[key] = _verify(public, message, signature)
    return _VERIFIED[key]


def _verify(public: bytes, message: bytes, signature: bytes) -> bool:
    if len(signature) != 64:
        return False
    a = _from_bytes(public)
    r = _from_bytes(signature[:32])
    s = int.from_bytes(signature[32:], "little")
    if a is None or r is None or s >= ORDER:
        return False
    k = int.from_bytes(hashlib.sha512(signature[:32] + public + message).digest(), "little")
    neg_a = (Q - a[0], a[1], 1, (Q - a[3]) % Q)
    check = _point_add(_scalar(s, GENERATOR), _scalar(k % ORDER, neg_a))
    return _to_bytes(check) == signature[:32]


# --- serializer ------------------------------------------------------------------

def serialize(value: object) -> str:
    """Compact JSON, object keys in the order given (a list of pairs or a dict)."""
    if isinstance(value, list) and value and all(
        isinstance(p, tuple) and len(p) == 2 for p in value
    ):
        return "{" + ",".join(
            json.dumps(k, ensure_ascii=False) + ":" + serialize(v) for k, v in value
        ) + "}"
    if isinstance(value, dict):
        return serialize(list(value.items())) if value else "{}"
    if isinstance(value, list):
        return "[" + ",".join(serialize(v) for v in value) + "]"
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    raise Failure(f"no liveness grammar serializes {value!r}")


def _refuse_constant(token: str) -> object:
    raise ValueError(f"non-finite {token}")


def parse_pairs(raw: bytes) -> object:
    """Parse JSON keeping every object as its list of pairs, duplicates included."""
    return json.loads(
        raw.decode("utf-8"),
        object_pairs_hook=lambda pairs: pairs,
        parse_constant=_refuse_constant,
    )


# --- contract text -----------------------------------------------------------------

def flat(text: str) -> str:
    return " ".join(text.split())


def section(text: str, heading: str) -> str:
    """A heading's text and its subsections, by the shared CommonMark recognizer."""
    return markdown.subtree(text, heading)


def need(text: str, sentence: str, where: str) -> None:
    if sentence not in flat(text):
        raise Failure(f"{where} no longer says: {sentence!r}")


