def _field_order(sentence_region: str) -> list[str]:
    match = re.search(
        r"Field order is exactly as shown: (.*?)(?:,| —) the lexicographic canonical order",
        flat(sentence_region),
    )
    if match is None:
        raise Failure("no field order sentence")
    return re.findall(r"`([a-z0-9_]+)`", match.group(1))


def _words(text: str) -> str:
    return r"\s+".join(re.escape(word) for word in text.split())


def guard_text(raw: str, clause: str, flip: tuple[str, str] | None) -> str:
    """The text with a pinned clause deleted, or with one polarity in it reversed."""
    span = re.search(_words(clause), raw)
    if span is None:
        raise AssertionError(f"guard clause missing: {clause!r}")
    if flip is None:
        return raw[: span.start()] + raw[span.end():]
    segment = span.group(0)
    hit = re.search(_words(flip[0]), segment)
    if hit is None:
        raise AssertionError(f"polarity {flip[0]!r} missing from its clause")
    return (raw[: span.start()] + segment[: hit.start()] + flip[1] + segment[hit.end():]
            + raw[span.end():])


# --- normative sentences ---------------------------------------------------------
#
# Every section of firmware-commands/v2.md and firmware-telemetry/v2.md, by its
# heading path, with the checker that owns its normative sentences. The section
# list itself is held: a section added, removed or renamed fails every checker
# until it is assigned here. None marks a section this amendment did not add or
# change.
SECTION_OWNERS = {
    "commands": (
