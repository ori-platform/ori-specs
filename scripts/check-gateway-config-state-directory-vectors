#!/usr/bin/env python3
# Copyright 2026 Ori Nexus Systems LTD
# SPDX-License-Identifier: Apache-2.0
"""Check the state directory vectors against gateway-config/v2.

The model below is read from the load rules of the `gateway.state_directory`
section of `gateway-config/v2.md` and from nothing else. The load-rule lead
paragraph and each load-rule bullet must equal, word for word, the sentences
this model implements, the limits must still say the comparison is lexical and
blind to the filesystem (so case-sensitive), and the
`state_directory` row of the `gateway` table must keep the default and the
condition the model assumes, so a contract that changes a load rule fails here
until the model changes with it.

Each case is `gateway.auth.enabled`, the `gateway.state_directory` value as
written (`null` when the key is absent) and the courier's `enabled` flag and two
queue directories. The checker recomputes each verdict, and the effective value
of a valid case or the rule of a refused case, and requires the corpus to
exercise every rule and every boundary the text draws.

    python3 scripts/check-gateway-config-state-directory-vectors
    python3 scripts/check-gateway-config-state-directory-vectors --mutations

`--mutations` flips each verdict, changes each refused case's rule, perturbs
each valid case's effective value, removes each rule's refused cases, breaks
the corpus shape, drops each bound sentence (and its last word) from the
contract, adds a fourth rule, changes the table row, and plants each defect a
loader is likely to have in the model; every mutant must be refused.
"""

from __future__ import annotations

import copy
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "gateway-config" / "v2.md"
VECTORS = ROOT / "gateway-config" / "vectors" / "state-directory-v2.json"
SECTION_START = "### `gateway.state_directory`"
SECTION_END = "**Start and mark requirements.**"
LOAD_RULES = "**Load rules.**"

REQUIRED = "required_under_auth"
ABSOLUTE = "absolute"
SEPARATE = "separate_from_evidence_queues"
RULES = (REQUIRED, ABSOLUTE, SEPARATE)

# The load-rule lead paragraph and the three bullets, in order, each the exact sentences this model implements.
LEAD = (
    "**Load rules.**",
    "Before any rule applies, surrounding whitespace is removed from the value, from the queue directories alike.",
    "Whitespace here is every character with the Unicode `White_Space` property.",
    "A value that is then empty is absent.",
    "The trimmed value is the configured state directory.",
    ("The rules below apply in order, whether or not authentication is enabled unless a rule says otherwise, and a "
     "configuration is refused at load for the first rule it breaks:"),
)
BULLETS = (
    (REQUIRED, (
        "`state_directory` is required when `gateway.auth.enabled` is true.",
        ("A configuration that enables authentication without it, which loaded before this key existed, is refused, "
         "so upgrading such a gateway means adding the key."),
    )),
    (ABSOLUTE, ("A value that is present is an absolute path: it begins with `/`.",)),
    (SEPARATE, (
        ("While `evidence.enabled` is true, a present state directory is neither equal to, inside, nor containing "
         "`evidence.queue_directory` or `evidence.return_queue_directory`."),
        ("Each path is first cleaned lexically: repeated and trailing `/` and `.` components are removed, each `..` removes the "
         "component before it, and a `..` at the root stays at the root."),
        ("Inside and containing are decided on whole components, so `/` contains every queue directory and `/a/b-c` "
         "is not inside `/a/b`."),
    )),
)
# After the bullets, in the section: exact comparison, and nothing else about the value refused at load.
AFTER = (
    "Components compare exactly, so letter case matters.",
    "Load refuses nothing else about the value: characters inside it are left to the start requirements.",
)
# Outside the load rules: the comparison is blind to the filesystem, and queue directories are trimmed.
LIMITS = (
    # From the evidence section: the queue directories the corpus holds valid are valid after trimming.
    ("Surrounding whitespace is removed from each queue directory before these rules apply, and the courier uses "
     "the trimmed path."),
    "The load rule compares cleaned paths, not the filesystem.",
    ("A symbolic link above the state directory, a queue directory reached through one, a bind mount, or a "
     "case-insensitive filesystem can place the state directory inside evidence storage without breaking the load "
     "rule."),
)
TABLE_ROW = re.compile(
    r"^\|\s*`state_directory`\s*\|\s*`string`\s*\|\s*`\"\"`\s*\|\s*When `gateway\.auth\.enabled`\s*\|", re.MULTILINE)

# The Unicode White_Space property (PropList.txt), written as code points.
WHITE_SPACE = frozenset(chr(c) for c in (
    *range(0x0009, 0x000E), 0x0020, 0x0085, 0x00A0, 0x1680, *range(0x2000, 0x200B),
    0x2028, 0x2029, 0x202F, 0x205F, 0x3000))
# What a hand-rolled trim tends to remove instead.
ASCII_SPACE = frozenset(" \t\n\r\v\f")
PYTHON_SPACE = frozenset(chr(c) for c in range(0x110000) if chr(c).isspace())

CASE_KEYS = {"name", "auth_enabled", "state_directory", "evidence", "valid"}
EVIDENCE_KEYS = {"enabled", "queue_directory", "return_queue_directory"}
QUEUES = ("queue_directory", "return_queue_directory")

# Defects a loader plausibly has; --mutations plants each one and requires the corpus to expose it.
MODEL_MUTANTS = {
    "no_trim": False,                       # whitespace is not removed
    "trim_spaces_only": False,              # only U+0020 is removed
    "trim_ascii_only": False,               # only ASCII whitespace is removed
    "trim_python_isspace": False,           # Python's str.strip set, which adds U+001C to U+001F
    "no_trim_queues": False,                # the queue directories are compared untrimmed
    "case_insensitive": False,              # paths are compared without regard to letter case
    "trim_only_under_auth": False,          # whitespace is removed only when auth is enabled
    "blank_present_without_auth": False,    # a whitespace-only value is present while auth is disabled
    "absolute_only_under_auth": False,      # the absolute rule is checked only when auth is enabled
    "separation_ignores_courier": False,    # the separation rule applies with the courier disabled
    "separation_only_under_auth": False,    # the separation rule applies only when auth is enabled
    "separation_on_raw_value": False,       # the separation rule compares the untrimmed value
    "no_clean_state": False,                # the state directory is compared as written
    "no_clean_queues": False,               # the queue directories are compared as written
    "no_clean_return_queue": False,         # only queue_directory is cleaned
    "dotdot_not_resolved": False,           # `..` is kept as a name
    "dotdot_above_root_kept": False,        # `..` above the root is kept instead of staying at the root
    "trailing_slash_kept": False,           # a trailing `/` survives cleaning
    "inside_by_string_prefix": False,       # inside is a string prefix, without a component boundary
    "containing_by_string_prefix": False,   # containing is a string prefix, without a component boundary
    "no_inside": False,
    "no_containing": False,
    "no_equal": False,
    "only_outbound_queue": False,
    "only_return_queue": False,
    "state_root_contains_nothing": False,   # containing is `q.startswith(s + "/")`, so a state `/` contains nothing
    "queue_root_contains_nothing": False,   # inside is `s.startswith(q + "/")`, so a queue `/` contains nothing
    "queue_checks_untrimmed": False,        # the checker's own queue checks read the untrimmed value
    "refuse_inner_characters": False,       # whitespace or a control character inside the value is refused
    "effective_cleaned": False,             # the effective value is the cleaned path
    "effective_untrimmed": False,           # the effective value keeps its whitespace
    "separation_before_absolute": False,    # a relative value is compared after resolving against `/`
}


class Refused(Exception):
    def __init__(self, rule: str) -> None:
        super().__init__(rule)
        self.rule = rule


def _norm(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def section_of(text: str) -> str | None:
    start = text.find(SECTION_START)
    end = text.find(SECTION_END, start)
    if start < 0 or end < start:
        return None
    return text[start:end]


def contract_errors(text: str) -> list[str]:
    """Bind the model to the contract: the table row and every load-rule bullet, word for word."""
    errors: list[str] = []
    if not TABLE_ROW.search(text):
        errors.append("the gateway table no longer gives state_directory type string, default \"\", required "
                      "when gateway.auth.enabled")
    section = section_of(text)
    if section is None:
        return errors + ["gateway-config/v2.md lacks the gateway.state_directory section before its start rules"]
    at = section.find(LOAD_RULES)
    if at < 0:
        return errors + ["the state_directory section has no load rules"]
    paragraphs = section[at:].split("\n\n")
    lines = paragraphs[0].split("\n") + (paragraphs[1].split("\n") if len(paragraphs) > 1 else [])
    preamble, bullets = [], []
    for line in lines:
        if line.startswith("- "):
            bullets.append([line[2:]])
        elif bullets:
            bullets[-1].append(line)
        else:
            preamble.append(line)
    if _norm(" ".join(preamble)) != _norm(" ".join(LEAD)):
        errors.append("the load-rule lead paragraph no longer reads as this model implements it (trimming, "
                      "absence, rule order); change the model and LEAD with it")
    if len(bullets) != len(BULLETS):
        errors.append(f"the load rules have {len(bullets)} bullets; this model implements {len(BULLETS)}")
    for (rule, sentences), bullet in zip(BULLETS, bullets):
        if _norm(" ".join(bullet)) != _norm(" ".join(sentences)):
            errors.append(f"the {rule} load rule no longer reads as this model implements it; change the model "
                          "and BULLETS with it")
    tail = _norm(paragraphs[2]) if len(paragraphs) > 2 else ""
    if tail != _norm(" ".join(AFTER)):
        errors.append("the paragraph after the load rules no longer reads as this model implements it (exact "
                      "comparison, nothing else refused); change the model and AFTER with it")
    whole = _norm(text)
    for sentence in LIMITS:
        if _norm(sentence) not in whole:
            errors.append(f"gateway-config/v2 no longer states, as this model assumes: {sentence[:60]}...")
    return errors


def trim(value: str, auth: bool) -> str:
    if MODEL_MUTANTS["no_trim"] or (MODEL_MUTANTS["trim_only_under_auth"] and not auth):
        return value
    blank = WHITE_SPACE
    if MODEL_MUTANTS["trim_spaces_only"]:
        blank = frozenset(" ")
    elif MODEL_MUTANTS["trim_ascii_only"]:
        blank = ASCII_SPACE
    elif MODEL_MUTANTS["trim_python_isspace"]:
        blank = PYTHON_SPACE
    start, end = 0, len(value)
    while start < end and value[start] in blank:
        start += 1
    while end > start and value[end - 1] in blank:
        end -= 1
    return value[start:end]


def clean(path: str) -> str:
    """Lexical form: drop `.` and empty components, resolve `..`, which stays at the root above it."""
    parts: list[str] = []
    for component in path.split("/"):
        if component == "" or component == ".":
            continue
        if component == ".." and not MODEL_MUTANTS["dotdot_not_resolved"]:
            if parts and parts[-1] != "..":
                parts.pop()
            elif MODEL_MUTANTS["dotdot_above_root_kept"]:
                parts.append("..")
            continue
        parts.append(component)
    cleaned = "/" + "/".join(parts)
    if MODEL_MUTANTS["trailing_slash_kept"] and path.endswith("/") and cleaned != "/":
        cleaned += "/"
    return cleaned


def under(outer: str, inner: str, naive: bool, root_defect: str) -> bool:
    """Whether `inner` lies strictly below `outer`, both cleaned."""
    if naive:
        return inner != outer and inner.startswith(outer)
    if outer == "/":
        return inner != "/" and not MODEL_MUTANTS[root_defect]
    return inner.startswith(outer + "/")


def relation(state: str, queue: str) -> str | None:
    """How the state directory stands to a queue directory: equal, inside, containing, or apart."""
    if not MODEL_MUTANTS["no_trim_queues"]:
        queue = trim(queue, True)
    s = state if MODEL_MUTANTS["no_clean_state"] else clean(state)
    q = queue if MODEL_MUTANTS["no_clean_queues"] else clean(queue)
    if MODEL_MUTANTS["case_insensitive"]:
        s, q = s.casefold(), q.casefold()
    if s == q and not MODEL_MUTANTS["no_equal"]:
        return "equal"
    if under(q, s, MODEL_MUTANTS["inside_by_string_prefix"], "queue_root_contains_nothing") and not MODEL_MUTANTS["no_inside"]:
        return "inside"
    if under(s, q, MODEL_MUTANTS["containing_by_string_prefix"], "state_root_contains_nothing") and not MODEL_MUTANTS["no_containing"]:
        return "containing"
    return None


def validate(case: dict) -> str:
    """The effective state directory of an accepted case; raises Refused naming the rule broken."""
    auth = case["auth_enabled"]
    raw = case["state_directory"]
    value = "" if raw is None else trim(raw, auth)
    present = value != "" or (MODEL_MUTANTS["blank_present_without_auth"] and not auth and raw not in (None, ""))
    if auth and not present:
        raise Refused(REQUIRED)
    if not present:
        return ""
    evidence = case["evidence"]
    courier = evidence["enabled"] or MODEL_MUTANTS["separation_ignores_courier"]
    if MODEL_MUTANTS["separation_only_under_auth"] and not auth:
        courier = False
    compared = raw if MODEL_MUTANTS["separation_on_raw_value"] else value
    absolute_checked = auth or not MODEL_MUTANTS["absolute_only_under_auth"]
    if MODEL_MUTANTS["separation_before_absolute"] and courier and not compared.startswith("/"):
        compared = "/" + compared
    elif absolute_checked and not value.startswith("/"):
        raise Refused(ABSOLUTE)
    if MODEL_MUTANTS["refuse_inner_characters"] and any(ch in WHITE_SPACE or ord(ch) < 0x20 for ch in value):
        raise Refused(ABSOLUTE)
    if courier:
        queues = QUEUES
        if MODEL_MUTANTS["only_outbound_queue"]:
            queues = ("queue_directory",)
        if MODEL_MUTANTS["only_return_queue"]:
            queues = ("return_queue_directory",)
        for key in queues:
            queue = evidence[key]
            if MODEL_MUTANTS["no_clean_return_queue"] and key == "return_queue_directory":
                saved = MODEL_MUTANTS["no_clean_queues"]
                MODEL_MUTANTS["no_clean_queues"] = True
                try:
                    found = relation(compared, queue)
                finally:
                    MODEL_MUTANTS["no_clean_queues"] = saved
            else:
                found = relation(compared, queue)
            if found:
                raise Refused(SEPARATE)
    if absolute_checked and not value.startswith("/"):
        raise Refused(ABSOLUTE)
    if MODEL_MUTANTS["effective_untrimmed"]:
        return raw
    if MODEL_MUTANTS["effective_cleaned"]:
        return clean(value)
    return value


def facts(case: dict) -> dict:
    """The true (unmutated) shape of a case, for the coverage requirements."""
    raw = case["state_directory"]
    value = "" if raw is None else trim_true(raw)
    ev = case["evidence"]
    rel = {k: true_relation(value, ev[k]) for k in QUEUES} if value.startswith("/") else {k: None for k in QUEUES}
    return {"raw": raw, "value": value, "auth": case["auth_enabled"], "courier": ev["enabled"], "rel": rel}


def trim_true(value: str) -> str:
    saved = dict(MODEL_MUTANTS)
    for k in MODEL_MUTANTS:
        MODEL_MUTANTS[k] = False
    try:
        return trim(value, True)
    finally:
        MODEL_MUTANTS.update(saved)


def true_relation(state: str, queue: str) -> str | None:
    saved = dict(MODEL_MUTANTS)
    for k in MODEL_MUTANTS:
        MODEL_MUTANTS[k] = False
    try:
        return relation(state, queue)
    finally:
        MODEL_MUTANTS.update(saved)


def true_clean(path: str) -> str:
    saved = dict(MODEL_MUTANTS)
    for k in MODEL_MUTANTS:
        MODEL_MUTANTS[k] = False
    try:
        return clean(path)
    finally:
        MODEL_MUTANTS.update(saved)


def shape_errors(document: dict) -> list[str]:
    errors: list[str] = []
    if set(document) != {"contract", "note", "cases"}:
        errors.append(f"top-level keys {sorted(document)}")
    if document.get("contract") != "gateway-config/v2 gateway.state_directory":
        errors.append("the corpus does not name gateway-config/v2 gateway.state_directory")
    note = document.get("note", "")
    for rule in RULES:
        if f"`{rule}`" not in note:
            errors.append(f"the note does not name rule {rule}")
    names: set[str] = set()
    for i, case in enumerate(document.get("cases", [])):
        label = case.get("name", f"case {i}")
        if not isinstance(case.get("name"), str) or not case["name"]:
            errors.append(f"case {i} has no name")
        elif case["name"] in names:
            errors.append(f"duplicate case {case['name']!r}")
        names.add(case.get("name"))
        valid = case.get("valid")
        if not isinstance(valid, bool):
            errors.append(f"{label}: valid is not a bool")
            continue
        want = CASE_KEYS | ({"effective"} if valid else {"rule"})
        if set(case) != want:
            errors.append(f"{label}: keys {sorted(case)}, want {sorted(want)}")
            continue
        if not isinstance(case["auth_enabled"], bool):
            errors.append(f"{label}: auth_enabled is not a bool")
        if case["state_directory"] is not None and not isinstance(case["state_directory"], str):
            errors.append(f"{label}: state_directory is neither null nor a string")
        ev = case["evidence"]
        if not isinstance(ev, dict) or set(ev) != EVIDENCE_KEYS:
            errors.append(f"{label}: evidence keys {sorted(ev) if isinstance(ev, dict) else ev}")
            continue
        if not isinstance(ev["enabled"], bool):
            errors.append(f"{label}: evidence.enabled is not a bool")
        # Every other courier key holds a valid value: the queue directories are absolute and distinct.
        if not all(isinstance(ev[k], str) and queue(case, k).startswith("/") for k in QUEUES):
            errors.append(f"{label}: a queue directory is not an absolute path")
        elif true_clean(queue(case, "queue_directory")) == true_clean(queue(case, "return_queue_directory")):
            errors.append(f"{label}: the queue directories are not distinct")
        if valid and not isinstance(case["effective"], str):
            errors.append(f"{label}: effective is not a string")
        if not valid and case["rule"] not in RULES:
            errors.append(f"{label}: unknown rule {case['rule']!r}")
    return errors


def verdict_errors(document: dict) -> list[str]:
    errors: list[str] = []
    for case in document["cases"]:
        try:
            value = validate(case)
        except Refused as refusal:
            if case["valid"]:
                errors.append(f"{case['name']}: refused for {refusal.rule}, declared valid")
            elif refusal.rule != case["rule"]:
                errors.append(f"{case['name']}: refused for {refusal.rule}, declared {case['rule']}")
            continue
        if not case["valid"]:
            errors.append(f"{case['name']}: accepted, declared refused for {case['rule']}")
        elif value != case["effective"]:
            errors.append(f"{case['name']}: effective {value!r}, declared {case['effective']!r}")
    return errors


def queue(case: dict, key: str) -> str:
    """A queue directory as every check reads it: trimmed first, as both sections require."""
    value = case["evidence"][key]
    return value if MODEL_MUTANTS["queue_checks_untrimmed"] else trim_true(value)


def _ws_only(f: dict) -> bool:
    return f["raw"] not in (None, "") and f["value"] == ""


def _padded(f: dict) -> bool:
    return f["raw"] is not None and f["value"] != "" and f["raw"] != f["value"]


def _overlap(f: dict, kind: str | None = None, key: str | None = None) -> bool:
    return any(r and (kind is None or r == kind) and (key is None or k == key) for k, r in f["rel"].items())


def _cleaning_changes_state(f: dict) -> bool:
    v = f["value"]
    return v.startswith("/") and v != "/" and true_clean(v) != v.rstrip("/") and ("//" in v or "/./" in v
                                                                                     or v.endswith("/."))


def _dotdot(path: str) -> bool:
    return ".." in path.split("/")


def _dotdot_above_root(path: str) -> bool:
    depth = 0
    for c in path.split("/"):
        if c in ("", "."):
            continue
        if c == "..":
            if depth == 0:
                return True
            depth -= 1
        else:
            depth += 1
    return False


def _escapes_by_dotdot(f: dict, c: dict) -> bool:
    """Read as written the state directory lies in a queue directory; resolved, it does not."""
    v = f["value"]
    return _dotdot(v) and not _overlap(f) and any(v.startswith(true_clean(queue(c, k)) + "/") for k in QUEUES)


def _name_extends_queue(f: dict, c: dict) -> bool:
    s = true_clean(f["value"]) if f["value"].startswith("/") else None
    return bool(s) and not _overlap(f) and any(
        s.startswith(true_clean(queue(c, k))) and s != true_clean(queue(c, k)) for k in QUEUES)


def _queue_extends_name(f: dict, c: dict) -> bool:
    s = true_clean(f["value"]) if f["value"].startswith("/") else None
    return bool(s) and s != "/" and not _overlap(f) and any(
        true_clean(queue(c, k)).startswith(s) and s != true_clean(queue(c, k)) for k in QUEUES)


def _queue_needs_cleaning(f: dict, case: dict, key: str) -> bool:
    """The overlap with this queue directory is found only once the queue directory itself is cleaned."""
    if not f["rel"][key]:
        return False
    saved = dict(MODEL_MUTANTS)
    for k in MODEL_MUTANTS:
        MODEL_MUTANTS[k] = False
    MODEL_MUTANTS["no_clean_queues"] = True
    try:
        return relation(f["value"], case["evidence"][key]) is None
    finally:
        MODEL_MUTANTS.update(saved)


def _relative_names_queue(f: dict, case: dict) -> bool:
    """A relative value that would overlap a queue directory if it were read from the root."""
    v = f["value"]
    return v != "" and not v.startswith("/") and any(true_relation("/" + v, case["evidence"][k]) for k in QUEUES)


# Every boundary the load rules draw, as (description, verdict, rule, predicate over (facts, case)).
COVERAGE = (
    ("auth disabled and the key absent", True, None, lambda f, c: not f["auth"] and f["raw"] is None),
    ("auth disabled and the key empty", True, None, lambda f, c: not f["auth"] and f["raw"] == ""),
    ("auth disabled and the key only whitespace, which is absent", True, None,
     lambda f, c: not f["auth"] and _ws_only(f)),
    ("auth disabled and an absolute value", True, None, lambda f, c: not f["auth"] and f["value"] != ""),
    ("auth disabled and surrounding whitespace removed from a present value", True, None,
     lambda f, c: not f["auth"] and _padded(f)),
    ("auth enabled, the courier disabled", True, None, lambda f, c: f["auth"] and not f["courier"]),
    ("auth enabled, the courier enabled, apart from both queues", True, None,
     lambda f, c: f["auth"] and f["courier"]),
    ("auth enabled and surrounding whitespace removed", True, None, lambda f, c: f["auth"] and _padded(f)),
    ("surrounding whitespace outside ASCII removed", True, None,
     lambda f, c: _padded(f) and any(ch not in ASCII_SPACE for ch in f["raw"].replace(f["value"], "", 1))),
    ("a path equal to a queue directory but for letter case, accepted: the comparison is lexical", True, None,
     lambda f, c: f["courier"] and not _overlap(f) and any(
         true_clean(f["value"]).casefold() == true_clean(queue(c, k)).casefold() for k in QUEUES)),
    ("a value with a trailing slash", True, None, lambda f, c: len(f["value"]) > 1 and f["value"].endswith("/")),
    ("a state directory whose name extends a queue directory's name", True, None,
     lambda f, c: f["courier"] and _name_extends_queue(f, c)),
    ("a queue directory whose name extends the state directory's name", True, None,
     lambda f, c: f["courier"] and _queue_extends_name(f, c)),
    ("a value with whitespace or a control character inside it, accepted at load", True, None,
     lambda f, c: any(ch in WHITE_SPACE or ord(ch) < 0x20 for ch in f["value"])),
    ("a queue directory with surrounding whitespace, accepted", True, None,
     lambda f, c: any(c["evidence"][k] != trim_true(c["evidence"][k]) for k in QUEUES)),
    ("an overlap accepted while the courier is disabled", True, None, lambda f, c: not f["courier"] and _overlap(f)),
    ("a value that reads as inside a queue but resolves outside it through `..`", True, None,
     lambda f, c: f["courier"] and _escapes_by_dotdot(f, c)),
    ("auth enabled and the key absent", False, REQUIRED, lambda f, c: f["raw"] is None),
    ("auth enabled and the key empty", False, REQUIRED, lambda f, c: f["raw"] == ""),
    ("auth enabled and the key only whitespace", False, REQUIRED, lambda f, c: _ws_only(f)),
    ("a relative value, auth disabled", False, ABSOLUTE, lambda f, c: not f["auth"]),
    ("a leading character Python's str.strip removes but White_Space does not, kept", False, ABSOLUTE,
     lambda f, c: f["value"][:1] in PYTHON_SPACE - WHITE_SPACE),
    ("a relative value, auth enabled", False, ABSOLUTE, lambda f, c: f["auth"]),
    ("a relative value, the courier enabled", False, ABSOLUTE, lambda f, c: f["courier"]),
    ("a relative value naming a queue directory, the courier enabled: absolute comes first", False, ABSOLUTE,
     lambda f, c: f["courier"] and _relative_names_queue(f, c)),
    ("equal to queue_directory", False, SEPARATE, lambda f, c: _overlap(f, "equal", "queue_directory")),
    ("equal to return_queue_directory", False, SEPARATE,
     lambda f, c: _overlap(f, "equal", "return_queue_directory")),
    ("inside queue_directory", False, SEPARATE, lambda f, c: _overlap(f, "inside", "queue_directory")),
    ("inside return_queue_directory", False, SEPARATE, lambda f, c: _overlap(f, "inside", "return_queue_directory")),
    ("containing queue_directory", False, SEPARATE, lambda f, c: _overlap(f, "containing", "queue_directory")),
    ("containing return_queue_directory", False, SEPARATE,
     lambda f, c: _overlap(f, "containing", "return_queue_directory")),
    ("the filesystem root", False, SEPARATE, lambda f, c: true_clean(f["value"]) == "/"),
    ("a queue directory at the root", False, SEPARATE,
     lambda f, c: any(true_clean(queue(c, k)) == "/" for k in QUEUES)),
    ("an overlap found only after removing `.` or repeated `/` in the state directory", False, SEPARATE,
     lambda f, c: _cleaning_changes_state(f)),
    ("an overlap found only after resolving `..` in the state directory", False, SEPARATE,
     lambda f, c: _dotdot(f["value"])),
    ("a state directory with a trailing `/` containing a queue directory", False, SEPARATE,
     lambda f, c: len(f["value"]) > 1 and f["value"].endswith("/") and _overlap(f, "containing")),
    ("an overlap found only after cleaning queue_directory", False, SEPARATE,
     lambda f, c: _queue_needs_cleaning(f, c, "queue_directory")),
    ("an overlap found only after cleaning return_queue_directory", False, SEPARATE,
     lambda f, c: _queue_needs_cleaning(f, c, "return_queue_directory")),
    ("an overlap found only after surrounding whitespace is removed", False, SEPARATE, lambda f, c: _padded(f)),
    ("an overlap found only after a queue directory's surrounding whitespace is removed", False, SEPARATE,
     lambda f, c: any(f["rel"][k] and trim_true(c["evidence"][k]) != c["evidence"][k] for k in QUEUES)),
    ("an overlap while authentication is disabled", False, SEPARATE, lambda f, c: not f["auth"]),
    ("`..` above the root, which stays at the root", None, None,
     lambda f, c: f["value"].startswith("/") and _dotdot_above_root(f["value"])),
)


def coverage_errors(document: dict) -> list[str]:
    errors: list[str] = []
    cases = document["cases"]
    for rule in RULES:
        if not any(not c["valid"] and c["rule"] == rule for c in cases):
            errors.append(f"no refused case for rule {rule}")
    for description, valid, rule, predicate in COVERAGE:
        hit = False
        for c in cases:
            if valid is not None and c["valid"] != valid:
                continue
            if rule is not None and c.get("rule") != rule:
                continue
            if predicate(facts(c), c):
                hit = True
                break
        if not hit:
            kind = "accepted" if valid else f"refused for {rule}" if valid is False else "any verdict"
            errors.append(f"no case ({kind}): {description}")
    return errors


def check(document: dict, contract_text: str) -> list[str]:
    errors = contract_errors(contract_text)
    shape = shape_errors(document)
    if shape:
        return errors + shape
    return errors + verdict_errors(document) + coverage_errors(document)


def drop(text: str, sentence: str, keep_last_word: bool) -> tuple[str, int]:
    pattern = r"\s+".join(re.escape(w) for w in sentence.split())
    replacement = "" if keep_last_word else sentence.rsplit(" ", 1)[0]
    return re.subn(pattern, replacement.replace("\\", "\\\\"), text, count=1)


def mutate(document: dict, text: str, baseline: list[str]) -> tuple[int, list[str]]:
    """Run every mutant; a mutant is refused when it raises an error the unmutated corpus does not."""
    survived: list[str] = []
    total = 0
    base = set(baseline)

    def killed(doc: dict, contract_text: str = text) -> bool:
        return bool(set(check(doc, contract_text)) - base)

    def run(label: str, doc: dict, contract_text: str = text) -> None:
        nonlocal total
        total += 1
        if not killed(doc, contract_text):
            survived.append(label)

    cases = document["cases"]
    for i, case in enumerate(cases):
        bad = copy.deepcopy(document)
        bad["cases"][i]["valid"] = not case["valid"]
        if case["valid"]:
            bad["cases"][i]["rule"] = RULES[0]
            del bad["cases"][i]["effective"]
        else:
            bad["cases"][i]["effective"] = ""
            del bad["cases"][i]["rule"]
        run(f"verdict of {case['name']}", bad)
        bad = copy.deepcopy(document)
        bad["cases"][i]["valid"] = not case["valid"]
        run(f"verdict flag only of {case['name']}", bad)
        if not case["valid"]:
            for other in RULES:
                if other != case["rule"]:
                    bad = copy.deepcopy(document)
                    bad["cases"][i]["rule"] = other
                    run(f"rule of {case['name']} -> {other}", bad)
        else:
            raw = case["state_directory"]
            perturbed = {case["effective"] + "x", case["effective"] + "/", "" if case["effective"] else "/"}
            if raw is not None:
                perturbed.add(raw)
            if case["effective"]:
                perturbed.add(true_clean(case["effective"]))
            for value in sorted(perturbed - {case["effective"]}):
                bad = copy.deepcopy(document)
                bad["cases"][i]["effective"] = value
                run(f"effective of {case['name']} -> {value!r}", bad)
    for rule in RULES:
        bad = copy.deepcopy(document)
        bad["cases"] = [c for c in cases if c["valid"] or c["rule"] != rule]
        run(f"without refused cases of {rule}", bad)
    shapes = (
        ("duplicate name", lambda d: d["cases"][1].__setitem__("name", d["cases"][0]["name"])),
        ("extra case key", lambda d: d["cases"][0].__setitem__("extra", True)),
        ("valid case without effective", lambda d: next(c for c in d["cases"] if c["valid"]).pop("effective")),
        ("refused case with effective",
         lambda d: next(c for c in d["cases"] if not c["valid"]).__setitem__("effective", "")),
        ("extra evidence key", lambda d: d["cases"][0]["evidence"].__setitem__("max_items", 1)),
        ("relative queue directory", lambda d: d["cases"][0]["evidence"].__setitem__("queue_directory", "q")),
        ("queue directories not distinct", lambda d: d["cases"][0]["evidence"].__setitem__(
            "return_queue_directory", d["cases"][0]["evidence"]["queue_directory"] + "/.")),
        ("auth as a string", lambda d: d["cases"][0].__setitem__("auth_enabled", "true")),
        ("unknown rule", lambda d: next(c for c in d["cases"] if not c["valid"]).__setitem__("rule", "other")),
        ("note loses a rule name", lambda d: d.__setitem__("note", d["note"].replace(f"`{SEPARATE}`", ""))),
    )
    for label, edit in shapes:
        bad = copy.deepcopy(document)
        edit(bad)
        run(f"shape: {label}", bad)
    for rule, sentences in BULLETS:
        for sentence in sentences:
            for whole in (True, False):
                edited, count = drop(text, sentence, whole)
                label = f"contract: {rule} sentence {'dropped' if whole else 'without its last word'}: {sentence[:40]}"
                if count != 1:
                    total += 1
                    survived.append(label + " (not found once)")
                else:
                    run(label, document, edited)
    for group, sentences in (("lead", LEAD[1:]), ("after", AFTER), ("limits", LIMITS)):
        for sentence in sentences:
            for whole in (True, False):
                edited, count = drop(text, sentence, whole)
                label = f"contract: {group} sentence {'dropped' if whole else 'without its last word'}: {sentence[:40]}"
                if count != 1:
                    total += 1
                    survived.append(label + " (not found once)")
                else:
                    run(label, document, edited)
    last = BULLETS[-1][1][-1]
    pattern = r"\s+".join(re.escape(w) for w in last.split())
    edited, count = re.subn(pattern, lambda m: m.group(0) + "\n- A fourth rule.", text, count=1)
    run("contract: a fourth load rule", document, edited) if count == 1 else survived.append("last rule not found")
    for old, new in (("When `gateway.auth.enabled`", "Yes"), ("| `string`   | `\"\"`    |", "| `string`   | `\"/\"`   |")):
        row = next((ln for ln in text.splitlines() if ln.startswith("| `state_directory`")), "")
        run(f"contract: table row {old!r} -> {new!r}", document, text.replace(row, row.replace(old, new), 1))
    for flag in MODEL_MUTANTS:
        MODEL_MUTANTS[flag] = True
        try:
            run(f"model defect {flag}", document)
        finally:
            MODEL_MUTANTS[flag] = False
    return total, survived


def main() -> int:
    text = CONTRACT.read_text(encoding="utf-8")
    document = json.loads(VECTORS.read_text(encoding="utf-8"))
    errors = check(document, text)
    status = 0
    for error in errors:
        print(f"check-gateway-config-state-directory-vectors: {error}", file=sys.stderr)
    if errors:
        status = 1
    if "--mutations" in sys.argv[1:]:
        if contract_errors(text) or shape_errors(document) or verdict_errors(document):
            print("check-gateway-config-state-directory-vectors: mutations need a corpus whose verdicts hold",
                  file=sys.stderr)
            return 1
        total, survived = mutate(document, text, errors)
        for label in survived:
            print(f"mutant survived: {label}", file=sys.stderr)
        print(f"state-directory mutations: {total - len(survived)} of {total} refused")
        if survived:
            status = 1
    if not errors:
        print(f"state-directory vectors: {len(document['cases'])} cases hold to gateway-config/v2")
    return status


if __name__ == "__main__":
    sys.exit(main())
