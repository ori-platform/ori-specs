"""Check the firmware-command-result/v1 corpus against the contracts.

Shares no code with scripts/generate-firmware-command-result-vectors-v1. Both
keys are re-derived from their disclosed seeds and every signature verified
with this script's own affine curve arithmetic. The result object's members,
the kinds and the outcomes each allows, the stored dispositions, the duplicate
and conflict table, the refusal reasons, the lifecycle events, the command
domain, the Layer 1 family keys and the corpus digest are read from the
contract documents, never from the corpus or the generator.

Held to:

- each result: canonical bytes and wire payload reproduce from its object, its
  signature verifies under the device key; an accept case is accepted by the
  receiver model below, and a refusal is refused for its declared reason and
  accepted once that one rule is switched off, so no other rule refuses it;
- each digest: the command is v1's grammar, its bytes and wire message
  reproduce, the runtime key's signature verifies over the command domain's
  preimage and over no other, and `command_digest` is SHA-256 of that preimage;
- each judgment: exactly one row of the duplicate and conflict table holds,
  and its result is the expected one;
- each lifecycle: the events are recordable in that order, and the Tier D,
  `outcome_uncertain` and executed conclusions follow from the text;
- coverage: an accept case per (kind, outcome), a refusal per reason and for
  the reserved kind, every table row and every stored disposition judged, and
  every lifecycle event recorded;
- the corpus seeds are the fault corpus's and the command corpus's, as the
  text says, and the digest firmware-command-result/v1.md pins is the corpus's.

    python3 scripts/check-firmware-command-result-vectors-v1
    python3 scripts/check-firmware-command-result-vectors-v1 --mutations

`--mutations` corrupts the corpus and the contract text and switches off each
rule of the model in turn; every mutant must be refused.
"""

from __future__ import annotations

import base64
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
import pathlib
import re
import sys
import types
from typing import Callable


def _load_contract_markdown() -> types.ModuleType:
    """scripts/contract-markdown, by path: the repository holds no *.py file."""
    path = pathlib.Path(__file__).resolve().parent / "contract-markdown"
    loader = importlib.machinery.SourceFileLoader("contract_markdown", str(path))
    spec = importlib.util.spec_from_loader("contract_markdown", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["contract_markdown"] = module
    loader.exec_module(module)
    return module


markdown = _load_contract_markdown()

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "firmware-command-result" / "command-result-vectors-v1.json"
RESULT_V1 = ROOT / "firmware-command-result" / "v1.md"
TELEMETRY_V2 = ROOT / "firmware-telemetry" / "v2.md"
COMMANDS_V1 = ROOT / "firmware-commands" / "v1.md"
COMMANDS_V2 = ROOT / "firmware-commands" / "v2.md"
# The text names these corpora as the source of its seeds.
FAULT_CORPUS = ROOT / "firmware-telemetry" / "fault-vectors-v2.json"
COMMAND_CORPUS = ROOT / "firmware-commands" / "command-vectors-v2.json"

P = 2**255 - 19
D = (-121665 * pow(121666, -1, P)) % P
L = 2**252 + 27742317777372353535851937790883648493
SQRT_M1 = pow(2, (P - 1) // 4, P)
BY = 4 * pow(5, -1, P) % P
# firmware-telemetry/v1.md's canonical integer zone, and firmware-commands/v1.md's
# fleet identifier alphabet. Both are prose the checker cannot parse into a
# value, so they are held here and their sentences in CLAUSES below.
INT_MAX = 2**53 - 1
FLEET = re.compile(r"[A-Za-z0-9._-]+\Z")
DIGEST_FORM = re.compile(r"sha256:[0-9a-f]{64}\Z")
SIGNATURE_PREFIX = "ed25519:"

# The sentences whose rules this checker evaluates by its own code rather than
# reads as a table or list. Each must stand verbatim, whitespace folded, so a
# sentence whose meaning changes, its polarity included, fails here.
CLAUSES = {
    "r": (
