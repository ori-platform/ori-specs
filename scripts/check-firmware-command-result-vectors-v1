# Receiver rules a refusal reason names, in the order the model applies them.
REASON_RULES = (
    "family_keys", "member_set", "unsupported_version", "digest_form",
    "unknown_kind", "outcome_not_allowed",
)


class Failure(Exception):
    pass


# --- Ed25519, affine, verification only --------------------------------------

def _add(p: tuple[int, int], q: tuple[int, int]) -> tuple[int, int]:
    x1, y1 = p
    x2, y2 = q
    t = D * x1 * x2 * y1 * y2 % P
    x3 = (x1 * y2 + x2 * y1) * pow(1 + t, -1, P) % P
    y3 = (y1 * y2 + x1 * x2) * pow(1 - t, -1, P) % P
    return x3, y3


def _mul(k: int, p: tuple[int, int]) -> tuple[int, int]:
    acc = (0, 1)
    while k:
        if k & 1:
            acc = _add(acc, p)
        p = _add(p, p)
        k >>= 1
    return acc


def _recover_x(y: int, sign: int) -> int | None:
    if y >= P:
        return None
    u = (y * y - 1) % P
    v = (D * y * y + 1) % P
    x = u * pow(v, 3, P) * pow(u * pow(v, 7, P), (P - 5) // 8, P) % P
    if v * x * x % P == (P - u) % P:
        x = x * SQRT_M1 % P
    elif v * x * x % P != u:
        return None
    if x == 0 and sign:
        return None
    if x & 1 != sign:
        x = P - x
    return x


def _decode(raw: bytes) -> tuple[int, int] | None:
    n = int.from_bytes(raw, "little")
    y = n & ((1 << 255) - 1)
    x = _recover_x(y, n >> 255)
    return None if x is None else (x, y)


def _encode(point: tuple[int, int]) -> bytes:
    x, y = point
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


BASE = (_recover_x(BY, 0), BY)


def public_key(seed: bytes) -> bytes:
    h = hashlib.sha512(seed).digest()
    a = int.from_bytes(h[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    return _encode(_mul(a, BASE))  # type: ignore[arg-type]


def verify(public: bytes, message: bytes, signature: bytes) -> bool:
    """ed25519-verification/v1: S < L, R canonical, [S]B = R + [k]A by bytes."""
    if len(signature) != 64 or len(public) != 32:
        return False
    a = _decode(public)
    r = _decode(signature[:32])
    s = int.from_bytes(signature[32:], "little")
    if a is None or _encode(a) != public:
        return False
    if s >= L or r is None or _encode(r) != signature[:32]:
        return False
    k = int.from_bytes(
        hashlib.sha512(signature[:32] + public + message).digest(), "little"
    )
    return _mul(s, BASE) == _add(r, _mul(k, a))  # type: ignore[arg-type]


def signature_bytes(wire: object, where: str) -> bytes:
    if type(wire) is not str or not wire.startswith(SIGNATURE_PREFIX):
        raise Failure(f"{where}: signature encoding")
    text = wire[len(SIGNATURE_PREFIX):]
    try:
        raw = base64.b64decode(text, validate=True)
    except ValueError as error:
        raise Failure(f"{where}: signature base64: {error}") from None
    if len(raw) != 64 or base64.b64encode(raw).decode() != text:
        raise Failure(f"{where}: signature is not canonical base64 of 64 bytes")
    return raw


# --- canonical JSON ------------------------------------------------------------

def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")


def parse_exact(raw: bytes, where: str) -> object:
    """Parse JSON bytes refusing duplicate keys, and require them canonical."""
    def pairs(items: list[tuple[str, object]]) -> dict:
        keys = [k for k, _ in items]
        if len(keys) != len(set(keys)):
            raise Failure(f"{where}: duplicate key")
        return dict(items)
    try:
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise Failure(f"{where}: not JSON: {error}") from None
    if canonical(value) != raw:
        raise Failure(f"{where}: bytes are not canonical JSON")
    return value


# --- contract text ------------------------------------------------------------

def _flat(text: str) -> str:
    return " ".join(text.split())


def _table(body: str) -> list[list[str]]:
    """Body rows of the first table in `body`, cells stripped, `\\|` unescaped."""
    rows: list[list[str]] = []
    seen_separator = False
    for line in body.split("\n"):
        if not line.startswith("|"):
            if seen_separator:
                break
            continue
        cells = [c.strip().replace("\\|", "|")
                 for c in re.split(r"(?<!\\)\|", line)[1:-1]]
        if all(re.fullmatch(r":?-{3,}:?", c) for c in cells):
            seen_separator = True
            continue
        if seen_separator:
            rows.append(cells)
    if not rows:
        raise Failure("expected table not found")
    return rows


def _ticks(cell: str) -> list[str]:
    return re.findall(r"`([^`]+)`", cell)


def _token_list(cell: str, where: str) -> list[str]:
    """A cell that is only backticked tokens joined by ', ' and ' or '."""
    if not re.fullmatch(r"`[a-z_]+`(?:(?:, | or |, or )`[a-z_]+`)*", cell):
        raise Failure(f"{where}: cell is not a token list: {cell!r}")
    return _ticks(cell)


def _json_fence(body: str, where: str) -> object:
    match = re.search(r"```json\n(.*?)\n```", body, re.S)
    if match is None:
        raise Failure(f"{where}: no JSON example")
    return json.loads(match.group(1))


def contract_texts() -> dict[str, str]:
    return {
        "r": RESULT_V1.read_text(),
        "t2": TELEMETRY_V2.read_text(),
        "c1": COMMANDS_V1.read_text(),
        "c2": COMMANDS_V2.read_text(),
    }


STORED = "<stored disposition>"


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = contract_texts() if texts is None else texts
    r, t2, c1, c2 = texts["r"], texts["t2"], texts["c1"], texts["c2"]
    if markdown.non_canonical(r):
        raise Failure(f"non-canonical headings: {markdown.non_canonical(r)}")
    for key, clauses in CLAUSES.items():
        flat = _flat(texts[key])
        for clause in clauses:
            if clause not in flat:
                raise Failure(f"{key} no longer says: {clause!r}")

    # The result object: its members from the field table, which the example
    # must agree with, and `v` from its row.
    obj_body = markdown.own_body(r, "## The result object")
    field_rows = _table(obj_body)
    members: list[str] = []
    for row in field_rows:
        members += _ticks(row[0])
    if len(members) != len(set(members)):
        raise Failure("the field table names a member twice")
    example = _json_fence(obj_body, "result object")
    if sorted(example) != ["command_result", "signature"]:
        raise Failure("the example payload's top-level keys")
    if sorted(example["command_result"]) != sorted(members):
        raise Failure("the example and the field table name different members")
    v_row = next((row for row in field_rows if row[0] == "`v`"), None)
    if v_row is None or not re.fullmatch(r"`(\d+)`\.", v_row[2]):
        raise Failure("no `v` row giving its value")
    version = int(_ticks(v_row[2])[0])
    if example["command_result"]["v"] != version:
        raise Failure("the example's `v` differs from the field table's")
    digest_row = next((row for row in field_rows if row[0] == "`command_digest`"), None)
    if digest_row is None:
        raise Failure("no `command_digest` row")
    named_domains = [t for t in _ticks(digest_row[2]) if t.startswith("ori.")]

    # The command domain, from firmware-commands/v2's Signing Domains table.
    domain_rows = _table(markdown.own_body(c2, "## Signing Domains"))
    command_domain = [_ticks(row[1]) for row in domain_rows if row[0] == "Command"]
    if len(command_domain) != 1 or len(command_domain[0]) != 1:
        raise Failure("firmware-commands/v2 names no single command domain")
    liveness_domain = [_ticks(row[1]) for row in domain_rows
                       if row[0].startswith("Runtime liveness")]
    if len(liveness_domain) != 1 or len(liveness_domain[0]) != 1:
        raise Failure("firmware-commands/v2 names no single liveness domain")
    domain = command_domain[0][0]
    if named_domains != [domain]:
        raise Failure(f"command_digest names {named_domains}, firmware-commands/v2 {domain}")

    # The command grammar, from firmware-commands/v1's Wire Format.
    wire_body = markdown.own_body(c1, "## Wire Format")
    order = re.search(r"Field order is exactly as shown: (.*?) —", _flat(wire_body))
    if order is None:
        raise Failure("firmware-commands/v1 gives no field order")
    command_fields = _ticks(order.group(1))
    wire_example = _json_fence(wire_body, "command wire format")
    if list(wire_example["command"]) != command_fields or \
            sorted(wire_example) != ["command", "signature"]:
        raise Failure("firmware-commands/v1's example and field order disagree")

    # Kinds and the outcomes each allows.
    kinds_body = markdown.own_body(r, "### Kinds")
    dup_body = markdown.own_body(r, "### Duplicate and conflict")
    dispositions = _dispositions(dup_body)
    allowed: dict[str, list[str]] = {}
    for row in _table(kinds_body):
        kind = _ticks(row[0])
        if len(kind) != 1 or row[0] != f"`{kind[0]}`":
            raise Failure(f"kind cell {row[0]!r}")
        cell = row[1]
        if cell == '`""`':
            outcomes = [""]
        elif cell.startswith("The stored disposition, under [Duplicate and conflict]"):
            outcomes = list(dispositions)
        else:
            outcomes = _token_list(cell, f"kind {kind[0]}")
        if kind[0] in allowed:
            raise Failure(f"kind {kind[0]} twice")
        allowed[kind[0]] = outcomes
    reserved = re.findall(r"`([a-z_]+)` is reserved for", _flat(kinds_body))
    if len(reserved) != 1 or reserved[0] in allowed:
        raise Failure("the reserved kind is not one name outside the table")
    unauth = re.search(r"A message refused as (.*?) gets no result\.", _flat(kinds_body))
    if unauth is None:
        raise Failure("no sentence naming the unauthenticated verdicts")
    unauthenticated = _token_list(unauth.group(1), "unauthenticated verdicts")
    unanswered = re.search(r"- A command refused as (.*?) gets no result, only its",
                           kinds_body.replace("\n  ", " "))
    if unanswered is None:
        raise Failure("no sentence naming the verdicts a replay gets no result for")
    unanswered_verdicts = _token_list(unanswered.group(1), "unanswered verdicts")

    # The refused outcomes are firmware-commands/v2's verdicts less the ones
    # that get no result. A refusal disposition is stored only by a verdict that
    # consumes the sequence, since only those leave a record at the mark.
    error_rows = _table(markdown.own_body(c2, "## Error Semantics"))
    verdicts = [_ticks(row[0])[0] for row in error_rows]
    consuming = [_ticks(row[0])[0] for row in error_rows if "Consumes the sequence." in row[1]]
    if "refused" not in allowed or sorted(allowed["refused"]) != sorted(
            set(verdicts) - set(unauthenticated) - set(unanswered_verdicts)):
        raise Failure("refused outcomes are not firmware-commands/v2's verdicts less "
                      "the ones that get no result")
    refusal_dispositions = [d for d in dispositions if d in verdicts]
    if sorted(refusal_dispositions) != sorted(consuming):
        raise Failure("refusal dispositions are not the verdicts that consume the sequence")

    # The duplicate and conflict table.
    table = []
    for row in _table(dup_body):
        if len(row) != 4:
            raise Failure(f"duplicate table row {row}")
        table.append(_judgment_row(row))

    # Refusal reasons.
    golden = markdown.own_body(r, "## Golden vectors")
    reasons = re.findall(r"^  - `([a-z_]+)`:", golden, re.M)
    if len(reasons) != len(set(reasons)) or not reasons:
        raise Failure("reasons list")

    # Lifecycle events. The table names what a runtime records; the Golden
    # vectors name the corpus's tokens for them. `name(a | b)` is one token per
    # alternative; device_refused and device_duplicate carry their verdict or
    # disposition; an observation carries the two values the Golden vectors
    # give; any other argument is a value the token does not carry. The
    # `timed_out(kind)` rows are the runtime's conclusions, not inputs: the
    # corpus records, for each kind, the one input token the table does not
    # name and whose name contains that kind (deadline_passed, restart).
    life_body = markdown.own_body(r, "## Runtime lifecycle")
    bullet = re.search(r"\*\*`lifecycle`\*\*: what happened to a command, in order: (.*?)\. "
                       r"With it,", _flat(golden))
    if bullet is None:
        raise Failure("no lifecycle group in the Golden vectors")
    golden_tokens = _ticks(bullet.group(1))
    observed_values = re.search(r"`terminal_outcome_observed_([a-z]+)` or `_([a-z]+)`",
                                bullet.group(1))
    if observed_values is None:
        raise Failure("the Golden vectors give no observation values")
    match_value, differ_value = observed_values.groups()
    carried = {"device_refused": list(allowed.get("refused", [])),
               "device_duplicate": list(dispositions)}
    for prefix in carried:
        if f"{prefix}_" not in golden_tokens:
            raise Failure(f"the Golden vectors give no {prefix}_ token form")
    life_rows = _table(life_body)
    recorded: list[str] = []
    timed_rows: dict[str, str] = {}
    for row in life_rows:
        for token in _ticks(row[0]):
            m = re.fullmatch(r"([a-z_]+)(?:\((.*)\))?", token)
            if m is None:
                raise Failure(f"event token {token!r}")
            name, argument = m.groups()
            if name == "timed_out":
                if not argument or argument in timed_rows:
                    raise Failure(f"timed_out row {token!r}")
                timed_rows[argument] = row[1]
            elif argument and "|" in argument:
                recorded += [f"{name}_{a.strip()}" for a in argument.split("|")]
            elif name in carried:
                recorded += [f"{name}_{v}" for v in carried[name]]
            elif name == "terminal_outcome_observed":
                recorded += [f"{name}_{match_value}", f"{name}_{differ_value}"]
            else:
                recorded.append(name)
    named = [t for t in golden_tokens
             if not t.startswith("_") and not t.endswith("_")
             and not t.startswith("terminal_outcome_observed_")]
    inputs = [t for t in named if t not in recorded]
    timed_inputs: dict[str, str] = {}
    for kind_ in timed_rows:
        holders = [t for t in inputs if kind_ in t]
        if len(holders) != 1:
            raise Failure(f"no single input token for timed_out({kind_})")
        timed_inputs[holders[0]] = kind_
    if sorted(timed_inputs) != sorted(inputs) or "deadline" not in timed_rows \
            or "restart" not in timed_rows:
        raise Failure("the inputs beside the table's events are not one per timed_out kind")
    deadline = next(t for t, k in timed_inputs.items() if k == "deadline")
    restart = next(t for t, k in timed_inputs.items() if k == "restart")
    events = recorded + inputs
    first = named[0]
    if first not in events:
        raise Failure("the lifecycle's first token is not an event")

    def expand(token: str) -> list[str]:
        m = re.fullmatch(r"([a-z_]+)(?:\(([a-z_]+)\))?", token)
        if m is None:
            raise Failure(f"event token {token!r}")
        name, argument = m.groups()
        if argument:
            return [f"{name}_{argument}"]
        return [e for e in events if e == name or
                (e.startswith(name + "_") and name != "device_duplicate")]

    finality = re.search(
        r"no final result attached: no (.*?), and no `device_duplicate` with a final "
        r"disposition\. (.*?) are not final\.", timed_rows["deadline"])
    if finality is None:
        raise Failure("the timed_out(deadline) row names no final and non-final results")
    not_final = [e for t in _ticks(finality.group(2)) for e in expand(t)]
    final = [e for t in _ticks(finality.group(1)) for e in expand(t)] + [
        f"device_duplicate_{d}" for d in dispositions
        if f"device_duplicate_{d}" not in not_final]
    for e in final + not_final:
        if e not in events:
            raise Failure(f"finality names {e}, not an event")
    if "no final result attached" not in timed_rows["restart"]:
        raise Failure("the timed_out(restart) row does not wait on a final result")

    # What each result asserts, for the contradiction rule. A refusal and a
    # duplicate assert their verdict or disposition; a driver result asserts the
    # stored disposition the dispositions list gives it, `driver_<outcome>` (a
    # naming the text uses and does not state: held); device_conflict asserts
    # that other bytes hold the sequence. The results the text names as acting
    # assert that the device decided to act, which agrees with either driver
    # result and contradicts every refusal.
    asserts: dict[str, str] = {}
    for prefix, values in carried.items():
        for v in values:
            asserts[f"{prefix}_{v}"] = v
    driver_values = []
    for outcome in allowed.get("driver_reported", []):
        if f"driver_{outcome}" not in dispositions:
            raise Failure(f"driver_reported({outcome}) has no stored disposition")
        asserts[f"driver_reported_{outcome}"] = f"driver_{outcome}"
        driver_values.append(f"driver_{outcome}")
    asserts["device_conflict"] = "conflict"
    flat_life = _flat(life_body)
    acting_match = re.search(r"Nor can `([a-z_]+)` or `([a-z_]+)` beside a refusal of the "
                             r"same command", flat_life)
    if acting_match is None:
        raise Failure("the lifecycle names no acting results that contradict a refusal")
    acting_events = list(acting_match.groups())
    for e in acting_events:
        if e not in events:
            raise Failure(f"acting result {e} is not a lifecycle event")
        asserts[e] = "acting"
    # The results that never contradict anything, from their list.
    start = life_body.find("Three results never contradict anything:")
    block = life_body[start:life_body.find("\n- ", start)]
    heads = [_flat(item).split(":", 1)[0] for item in re.split(r"\n  - ", block)[1:]]
    not_binding_events: list[str] = []
    for head in heads:
        m = re.fullmatch(r"`([a-z_]+)\(([a-z_]+)\)`", head) \
            or re.fullmatch(r"`([a-z_]+)` with `([a-z_]+)`", head)
        if m is not None:
            name, value = m.groups()
            name = {"refused": "device_refused"}.get(name, name)
            not_binding_events.append(f"{name}_{value}")
        elif re.fullmatch(r"`[a-z_]+`", head):
            not_binding_events.append(_ticks(head)[0])
        else:
            raise Failure(f"non-contradicting result not understood: {head!r}")
    if len(heads) != 3:
        raise Failure("the list of results that never contradict is not three")
    for e in not_binding_events:
        if e not in asserts:
            raise Failure(f"non-contradicting result {e} is not an asserting event")
    # Cross-check against firmware-commands/v2: pending, and every verdict that
    # consumes nothing, stored nothing durable, so they must be in the list.
    derived = {f"device_duplicate_{d}" for d in dispositions
               if f"device_duplicate_{d}" in not_final}
    derived |= {f"device_refused_{v}" for v in set(allowed.get("refused", [])) - set(consuming)}
    if not derived <= set(not_binding_events):
        raise Failure("a result that stores nothing is not in the never-contradicts list")

    # The bound group: the table size and the storage_failure budget, parsed.
    kinds_flat = _flat(kinds_body)
    table_size = re.search(r"in a table of at least (\d+) that evicts the key it answered "
                           r"longest ago, in the order it answered them", kinds_flat)
    key_match = re.search(r"at most one command result for each `\(([a-z_, ]+)\)` in a boot",
                          kinds_flat)
    if key_match is None:
        raise Failure("the bound names no key")
    key_fields = [f.strip() for f in key_match.group(1).split(",")]
    # The step members that carry each key field; command_digest is the step's
    # `digest`, the label the Golden vectors name.
    step_names = {"cmd_seq": "cmd_seq", "command_digest": "digest",
                  "kind": "kind", "outcome": "outcome"}
    if any(f not in step_names for f in key_fields) or len(set(key_fields)) != len(key_fields):
        raise Failure(f"bound key fields {key_fields} not understood")
    budget = re.search(
        r"A device signs `([a-z_]+)` with `([a-z_]+)` within a budget its release fixes, "
        r"no larger than this: the first (\d+) in a boot, and after them each one at least "
        r"([\d,]+) ms, on a monotonic clock, after the previous one it signed\.", kinds_flat)
    if table_size is None or budget is None:
        raise Failure("the bound's table size or budget is not stated")
    bound = {"size": int(table_size.group(1)),
             "key": [step_names[f] for f in key_fields],
             "budget_kind": budget.group(1), "budget_outcome": budget.group(2),
             "first": int(budget.group(3)),
             "interval_ms": int(budget.group(4).replace(",", "")),
             # Rule switches the mutations and coverage turn off or change.
             "reset_on_boot": True, "held_spends": False, "budget_all_kinds": False,
             "budget_on": True, "kind_in_key": True, "unsigned_held": False}
    ending_match = re.search(
        r"driver acceptance is `([a-z_]+)\(([a-z_]+)\)`, or a `([a-z_]+)` whose stored "
        r"disposition is `([a-z_]+)`, and nothing earlier",
        _flat(markdown.own_body(r, "### Tier D")))
    if ending_match is None:
        raise Failure("Tier D names no driver acceptance")
    a, b, c_, d_ = ending_match.groups()
    ending_events = [f"{a}_{b}", f"{c_}_{d_}"]
    for e in ending_events:
        if e not in events:
            raise Failure(f"Tier D's driver acceptance {e} is not a lifecycle event")

    families = [_ticks(row[0])[0] for row in
                _table(markdown.own_body(t2, "### Layer 1 evidence families"))]
    if "command_result" not in families or sorted(example) != ["command_result", "signature"]:
        raise Failure("firmware-telemetry/v2 carries no command_result family")

    pin = re.search(r"Its SHA-256 is\s+`([0-9a-f]{64})`", golden)
    return {
        "members": members,
        "version": version,
        "domain": domain,
        "liveness_domain": liveness_domain[0][0],
        "command_fields": command_fields,
        "allowed": allowed,
        "reserved": reserved[0],
        "dispositions": dispositions,
        "table": table,
        "reasons": reasons,
        "events": events,
        "first_event": first,
        "deadline": deadline,
        "restart": restart,
        "asserts": asserts,
        "not_binding_events": not_binding_events,
        "acting_events": acting_events,
        "driver_values": driver_values,
        "bound": bound,
        # Rule switches the mutations turn off; the text sets each to True.
        "contradiction_blocks_ending": True,
        "contradiction_critical": True,
        "restart_ends_deadline": True,
        "final": final,
        "not_final": not_final,
        "ending_events": ending_events,
        "observed": {f"terminal_outcome_observed_{match_value}": True,
                     f"terminal_outcome_observed_{differ_value}": False},
        "families": families,
        "pin": None if pin is None else pin.group(1),
    }


def _dispositions(body: str) -> list[str]:
    """The sub-bullets of 'A duplicate answers with what the device recorded'."""
    start = body.find("- **A duplicate answers with what the device recorded")
    if start < 0:
        raise Failure("no stored-disposition list")
    end = body.find("\n- ", start + 1)
    block = body[start:end if end > 0 else len(body)]
    items = re.split(r"\n  - ", block)[1:]
    if not items:
        raise Failure("stored-disposition list is empty")
    found: list[str] = []
    for item in items:
        head = _flat(item).split(":", 1)[0]
        found += _token_list(head, "stored disposition")
    if len(found) != len(set(found)):
        raise Failure("a stored disposition is listed twice")
    return found


# The table's prose cells, mapped to predicates. They are phrases, not tokens,
# so they cannot be parsed generically; a cell outside these maps fails.
SEQ_CELLS = {"Below it": "below", "Equal to it": "equal", "Above it": "above"}
HASH_CELLS = {"any": None, "": None, "Differs from the device's current one": False,
              "Equals the current one": True}
DIGEST_CELLS = {"any": None, "": None, "Equals the stored one": True, "Differs": False}
RESULT_PHRASES = {
    "No result: a `command_rejected` fault, `replayed`, only": ("none", ""),
    # "once a boot" bounds how often; the judgments carry no boot count, so the
    # bound is held to its sentence in CLAUSES and not exercised here.
    "`duplicate`, with the stored disposition, once a boot": ("duplicate", STORED),
    "Freshness passes; the command is judged as a new command": ("new", ""),
}


def _judgment_row(row: list[str]) -> dict:
    seq, stored_hash, digest, result = row
    if seq not in SEQ_CELLS or stored_hash not in HASH_CELLS or digest not in DIGEST_CELLS:
        raise Failure(f"duplicate table row not understood: {row}")
    if result in RESULT_PHRASES:
        outcome = RESULT_PHRASES[result]
    else:
        tokens = _token_list(result, "duplicate table result")
        if len(tokens) > 2:
            raise Failure(f"duplicate table result {result!r}")
        outcome = (tokens[0], tokens[1] if len(tokens) == 2 else "")
    return {"seq": SEQ_CELLS[seq], "hash": HASH_CELLS[stored_hash],
            "digest": DIGEST_CELLS[digest], "result": outcome, "cells": row}


# --- receiver model -------------------------------------------------------------

def judge(payload: dict, context: dict, model: dict, public: bytes,
          off: frozenset[str]) -> str | None:
    """Return None to accept, or the name of the first rule that refuses.

    Rules a corpus reason names can be switched off; the others cannot. A rule
    reads only members that are present, so a missing member is refused by
    member_set alone.
    """
    keys = set(payload)
    if "signature" not in keys or keys - {"signature"} - set(model["families"]):
        return "payload_keys"
    present = keys & set(model["families"])
    if len(present) > 1 and "family_keys" not in off:
        return "family_keys"
    if "command_result" not in present:
        return "family"
    obj = payload["command_result"]
    if type(obj) is not dict:
        return "object"
    if not verify(public, canonical(obj), signature_bytes(payload["signature"], "payload")):
        return "signature"
    if set(obj) != set(model["members"]) and "member_set" not in off:
        return "member_set"
    if "v" in obj and not (type(obj["v"]) is int and obj["v"] == model["version"]):
        if "unsupported_version" not in off:
            return "unsupported_version"
    if "alg" in obj and obj["alg"] != "ed25519":
        return "alg"
    for name in ("device_id", "capability_hash", "posture"):
        if name in obj and obj[name] != context[name]:
            return name
    for name, low in (("boot_id", 0), ("seq", 0), ("device_uptime_ms", 0), ("cmd_seq", 1)):
        if name in obj and (type(obj[name]) is not int or not low <= obj[name] <= INT_MAX):
            return name
    if "command_digest" in obj:
        digest = obj["command_digest"]
        if (type(digest) is not str or not DIGEST_FORM.match(digest)) \
                and "digest_form" not in off:
            return "digest_form"
    for name in ("kind", "outcome"):
        if name in obj and type(obj[name]) is not str:
            return name
    kind = obj.get("kind")
    if kind is not None and kind not in model["allowed"] and "unknown_kind" not in off:
        return "unknown_kind"
    # An unknown kind allows nothing: its refusal must stand on the kind alone,
    # which the isolation check then proves.
    if kind in model["allowed"] and "outcome" in obj \
            and obj["outcome"] not in model["allowed"][kind] \
            and "outcome_not_allowed" not in off:
        return "outcome_not_allowed"
    return None


def judge_repeat(case: dict, model: dict) -> tuple[str, str]:
    device, command = case["device"], case["command"]
    record = device["record"]
    for where, value in (("mark", device["mark"]), ("record cmd_seq", record["cmd_seq"]),
                         ("command cmd_seq", command["cmd_seq"])):
        if type(value) is not int or not 1 <= value <= INT_MAX:
            raise Failure(f"{case['name']}: {where} is not a sequence")
    for where, value in (("device capability_hash", device["capability_hash"]),
                         ("record capability_hash", record["capability_hash"]),
                         ("record command_digest", record["command_digest"]),
                         ("command capability_hash", command["capability_hash"]),
                         ("command command_digest", command["command_digest"])):
        if type(value) is not str or not DIGEST_FORM.match(value):
            raise Failure(f"{case['name']}: {where} form")
    # The record is the last fresh command's, written atomically with the mark.
    if record["cmd_seq"] != device["mark"]:
        raise Failure(f"{case['name']}: the record is not the mark's command")
    if record["disposition"] not in model["dispositions"]:
        raise Failure(f"{case['name']}: disposition {record['disposition']!r} is not stored")
    # A fixture must be a state a device can reach. The digest covers the
    # command bytes, cmd_seq and capability_hash included, so an equal digest
    # means the same cmd_seq and the same carried hash as the stored command.
    digest_same = command["command_digest"] == record["command_digest"]
    if digest_same and command["cmd_seq"] != record["cmd_seq"]:
        raise Failure(f"{case['name']}: one digest for two cmd_seq values")
    if digest_same and record["disposition"] != "pending":
        # Every stored refusal but capability_mismatch, and every driver
        # disposition, passed the capability check: the carried hash was the one
        # the command was received under. capability_mismatch means it was not.
        mismatch = record["disposition"] == "capability_mismatch"
        if (command["capability_hash"] != record["capability_hash"]) != mismatch:
            raise Failure(f"{case['name']}: the command's own capability_hash cannot have "
                          f"been stored as {record['disposition']}")
    seq = command["cmd_seq"]
    relation = "below" if seq < device["mark"] else "equal" if seq == device["mark"] else "above"
    hash_same = record["capability_hash"] == device["capability_hash"]
    rows = [row for row in model["table"]
            if row["seq"] == relation
            and row["hash"] in (None, hash_same)
            and row["digest"] in (None, digest_same)]
    if len(rows) != 1:
        raise Failure(f"{case['name']}: {len(rows)} rows of the table hold")
    kind, outcome = rows[0]["result"]
    if outcome == STORED:
        outcome = record["disposition"]
    case.setdefault("_row", rows[0]["cells"])
    return kind, outcome


def conclude(events: list[str], model: dict, where: str) -> dict:
    vocabulary = set(model["events"])
    for event in events:
        if event not in vocabulary:
            raise Failure(f"{where}: unknown event {event!r}")
    # A lifecycle belongs to a command the runtime signed and recorded before
    # publishing: that event comes first, once.
    first = model["first_event"]
    if not events or events[0] != first or events.count(first) != 1:
        raise Failure(f"{where}: lifecycle does not start with one {first}")
    for once in ("issued", "publish_unconfirmed", model["deadline"]):
        if events.count(once) > 1:
            raise Failure(f"{where}: {once} twice")
    # At most one of issued and publish_unconfirmed, so never issued after it.
    if "issued" in events and "publish_unconfirmed" in events:
        raise Failure(f"{where}: both issued and publish_unconfirmed")
    # timed_out: the deadline, or a restart, with no final result attached.
    # Only the first is recorded: a restart ends a deadline that is still
    # running, and a deadline is never re-armed after a restart.
    timed_out = None
    final_seen = False
    restarted = False
    for event in events:
        if event in model["final"]:
            final_seen = True
        elif event == model["deadline"]:
            if not final_seen and timed_out is None and not (
                    restarted and model["restart_ends_deadline"]):
                timed_out = "deadline"
        elif event == model["restart"] and model["restart_ends_deadline"]:
            restarted = True
            if not final_seen and timed_out is None:
                timed_out = "restart"
    asserted = sorted({model["asserts"][e] for e in events if e in model["asserts"]
                       and e not in model["not_binding_events"]})
    agreeing = set(model["driver_values"]) | {"acting"}

    def agree(a: str, b: str) -> bool:
        return a == b or ("acting" in (a, b) and {a, b} <= agreeing)
    contradiction = any(not agree(a, b) for i, a in enumerate(asserted)
                        for b in asserted[i + 1:])
    observed = [e for e in events if e in model["observed"]]
    accepted = any(e in model["ending_events"] for e in events)
    return {
        "timed_out": timed_out,
        # Driver acceptance ends the attempts, from whenever it attaches, unless
        # the history holds a contradiction, in any order; then they resume.
        "attempts_ended": accepted and not (
            contradiction and model["contradiction_blocks_ending"]),
        "outcome_uncertain": not observed,
        "contradiction": contradiction,
        # Every lifecycle case is a Tier D command: an observation that differs
        # is critical, and so is a contradiction.
        "critical": any(not model["observed"][e] for e in observed)
        or (contradiction and model["contradiction_critical"]),
        # No firmware command is concluded executed in this version.
        "executed": False,
    }


def simulate(steps: list[dict], model: dict, bound: dict, where: str) -> list[bool]:
    """What a device at the contract's limits signs, step by step."""
    kinds = model["allowed"]
    out: list[bool] = []
    table: list[tuple] = []
    count, last, boot, now = 0, None, None, None
    for step in steps:
        if sorted(step) != ["boot", "cmd_seq", "digest", "kind", "outcome", "signed", "t_ms"]:
            raise Failure(f"{where}: step members")
        for name in ("boot", "t_ms", "cmd_seq"):
            if type(step[name]) is not int or step[name] < 0:
                raise Failure(f"{where}: step {name}")
        if type(step["digest"]) is not str or type(step["signed"]) is not bool:
            raise Failure(f"{where}: step digest or signed")
        kind, outcome = step["kind"], step["outcome"]
        if kind not in kinds or outcome not in kinds[kind]:
            raise Failure(f"{where}: step {kind!r} with outcome {outcome!r}")
        if boot is not None and step["boot"] < boot:
            raise Failure(f"{where}: boot decreases")
        if step["boot"] != boot:
            if boot is None or bound["reset_on_boot"]:
                table, count, last = [], 0, None
            boot, now = step["boot"], None
        if now is not None and step["t_ms"] < now:
            raise Failure(f"{where}: the monotonic clock runs back")
        now = step["t_ms"]
        key = tuple(step[f] for f in bound["key"]
                    if f != "kind" or bound["kind_in_key"])
        budgeted = bound["budget_on"] and (bound["budget_all_kinds"] or (
            kind == bound["budget_kind"] and outcome == bound["budget_outcome"]))
        held = key in table
        if budgeted and (not held or bound["held_spends"]):
            within = count < bound["first"] or now - last >= bound["interval_ms"]
            if within:
                count, last = count + 1, now
        else:
            within = True
        signed = within and not held
        if signed or (bound["unsigned_held"] and not held):
            table.append(key)
            if len(table) > bound["size"]:
                table.pop(0)
        out.append(signed)
    return out


# Variants of the bound a device could wrongly implement; the group must tell
# each from the contract's.
BOUND_VARIANTS = (
    ("a table of one fewer", lambda b: b.update(size=b["size"] - 1)),
    ("a table of one more", lambda b: b.update(size=b["size"] + 1)),
    ("one fewer free refusal", lambda b: b.update(first=b["first"] - 1)),
    ("one more free refusal", lambda b: b.update(first=b["first"] + 1)),
    ("an interval 1 ms shorter", lambda b: b.update(interval_ms=b["interval_ms"] - 1)),
    ("an interval 1 ms longer", lambda b: b.update(interval_ms=b["interval_ms"] + 1)),
    ("a table kept across a boot", lambda b: b.update(reset_on_boot=False)),
    ("a held key spends budget", lambda b: b.update(held_spends=True)),
    ("the budget bounds every kind", lambda b: b.update(budget_all_kinds=True)),
    ("no budget", lambda b: b.update(budget_on=False)),
    ("the kind left out of the key", lambda b: b.update(kind_in_key=False)),
    ("the outcome left out of the key",
     lambda b: b.update(key=[f for f in b["key"] if f != "outcome"])),
    ("an unsigned refusal held as answered", lambda b: b.update(unsigned_held=True)),
)


# --- corpus -------------------------------------------------------------------

def _keys(corpus: dict) -> tuple[bytes, bytes]:
    fault = json.loads(FAULT_CORPUS.read_bytes())
    command = json.loads(COMMAND_CORPUS.read_bytes())
    if corpus["device_test_seed_hex"] != fault["test_seed_hex"]:
        raise Failure("device seed is not the fault corpus's")
    if corpus["runtime_test_seed_hex"] != command["runtime_test_seed_hex"]:
        raise Failure("runtime seed is not the command corpus's")
    device = public_key(bytes.fromhex(corpus["device_test_seed_hex"]))
    runtime = public_key(bytes.fromhex(corpus["runtime_test_seed_hex"]))
    for label, value, key in (
            ("device_public_key_b64", corpus["device_public_key_b64"], device),
            ("verifier_context public_key_b64",
             corpus["verifier_context"]["public_key_b64"], device),
            ("runtime_public_key_b64", corpus["runtime_public_key_b64"], runtime)):
        if base64.b64encode(key).decode() != value:
            raise Failure(f"{label} does not derive from its seed")
    return device, runtime


def check(corpus: dict, model: dict, off: frozenset[str] = frozenset()) -> None:
    if corpus.get("contract") != "ori-specs/firmware-command-result/v1.md" \
            or corpus.get("version") != 1:
        raise Failure("corpus names another contract or version")
    device, runtime = _keys(corpus)
    context = corpus["verifier_context"]
    if sorted(context) != ["capability_hash", "device_id", "posture", "public_key_b64"]:
        raise Failure("verifier_context members")
    if sorted(corpus["reasons"]) != sorted(model["reasons"]):
        raise Failure("the corpus's reasons are not the contract's")
    for reason in model["reasons"]:
        if reason not in REASON_RULES:
            raise Failure(f"no receiver rule for reason {reason}")

    for group in ("results", "digests", "bound", "judgments", "lifecycle"):
        names = [case["name"] for case in corpus[group]]
        if len(names) != len(set(names)):
            raise Failure(f"{group}: a case name is used twice")

    for case in corpus["results"]:
        where = case["name"]
        obj = case["object"]
        body = canonical(obj)
        if bytes.fromhex(case["canonical_hex"]) != body:
            raise Failure(f"{where}: canonical bytes")
        raw = signature_bytes(case["signature"], where)
        if not verify(device, body, raw):
            raise Failure(f"{where}: signature does not verify under the device key")
        payload = parse_exact(bytes.fromhex(case["payload_hex"]), where)
        if type(payload) is not dict or payload.get("command_result") != obj \
                or payload.get("signature") != case["signature"]:
            raise Failure(f"{where}: payload is not this object and signature")
        if canonical(payload["command_result"]) != body:
            raise Failure(f"{where}: payload's object bytes")
        verdict = judge(payload, context, model, device, off)
        if case["expect"] == "accept":
            if case["reason"] is not None:
                raise Failure(f"{where}: an accept case names a reason")
            if sorted(payload) != ["command_result", "signature"]:
                raise Failure(f"{where}: an accept payload carries another key")
            if verdict is not None:
                raise Failure(f"{where}: refused ({verdict})")
        elif case["expect"] == "refuse":
            if case["reason"] not in model["reasons"]:
                raise Failure(f"{where}: undeclared reason {case['reason']}")
            if verdict != case["reason"]:
                raise Failure(f"{where}: refused for {verdict}, not {case['reason']}")
            if judge(payload, context, model, device, off | {case["reason"]}) is not None:
                raise Failure(f"{where}: refused for more than its declared reason")
        else:
            raise Failure(f"{where}: expect {case['expect']!r}")

    for case in corpus["digests"]:
        where = case["name"]
        command = case["command"]
        if type(command) is not dict or list(command) != model["command_fields"]:
            raise Failure(f"{where}: command members or order")
        for name in ("action", "channel", "device_id"):
            if type(command[name]) is not str or not FLEET.match(command[name]):
                raise Failure(f"{where}: {name} is not a fleet identifier")
        if type(command["capability_hash"]) is not str or \
                not DIGEST_FORM.match(command["capability_hash"]):
            raise Failure(f"{where}: capability_hash form")
        if type(command["cmd_seq"]) is not int or not 1 <= command["cmd_seq"] <= INT_MAX:
            raise Failure(f"{where}: cmd_seq")
        if type(command["v"]) is not int or command["v"] != 1:
            raise Failure(f"{where}: command v")
        object_bytes = bytes.fromhex(case["command_hex"])
        if object_bytes != canonical(command):
            raise Failure(f"{where}: command bytes")
        raw = signature_bytes(case["signature"], where)
        preimage = model["domain"].encode("ascii") + b"\x00" + object_bytes
        if not verify(runtime, preimage, raw):
            raise Failure(f"{where}: runtime signature does not verify in the command domain")
        for other in (object_bytes,
                      model["liveness_domain"].encode("ascii") + b"\x00" + object_bytes,
                      model["domain"].encode("ascii") + object_bytes):
            if verify(runtime, other, raw):
                raise Failure(f"{where}: signature verifies over another preimage")
        message = parse_exact(bytes.fromhex(case["message_hex"]), where)
        if message != {"command": command, "signature": case["signature"]}:
            raise Failure(f"{where}: wire message")
        if case["command_digest"] != "sha256:" + hashlib.sha256(preimage).hexdigest():
            raise Failure(f"{where}: command_digest is not SHA-256 of the preimage")
        if case["command_digest"] == "sha256:" + hashlib.sha256(object_bytes).hexdigest():
            raise Failure(f"{where}: command_digest is over the object alone")

    rows_seen: set[int] = set()
    dispositions_seen: set[str] = set()
    for case in corpus["judgments"]:
        work = copy.deepcopy(case)
        kind, outcome = judge_repeat(work, model)
        if case["expect"] != {"kind": kind, "outcome": outcome}:
            raise Failure(f"{case['name']}: table gives {kind}/{outcome!r}, "
                          f"corpus {case['expect']}")
        if kind not in ("new", "none") and outcome not in model["allowed"][kind]:
            raise Failure(f"{case['name']}: {kind} cannot carry {outcome!r}")
        rows_seen.add(next(i for i, row in enumerate(model["table"])
                           if row["cells"] == work["_row"]))
        if kind == "duplicate":
            dispositions_seen.add(outcome)

    for case in corpus["bound"]:
        got = simulate(case["steps"], model, model["bound"], case["name"])
        want = [step["signed"] for step in case["steps"]]
        if got != want:
            raise Failure(f"{case['name']}: the text signs {got}, corpus {want}")
    for label, edit in BOUND_VARIANTS:
        variant = copy.deepcopy(model["bound"])
        edit(variant)
        if all(simulate(c["steps"], model, variant, c["name"]) ==
               [step["signed"] for step in c["steps"]] for c in corpus["bound"]):
            raise Failure(f"coverage: the bound group does not tell {label} from the text")

    events_seen: set[str] = set()
    for case in corpus["lifecycle"]:
        expected = conclude(case["events"], model, case["name"])
        if case["expect"] != expected:
            raise Failure(f"{case['name']}: text gives {expected}, corpus {case['expect']}")
        events_seen |= set(case["events"])

    # Coverage.
    accepted = [c["object"] for c in corpus["results"] if c["expect"] == "accept"]
    for kind, outcomes in model["allowed"].items():
        for outcome in outcomes:
            if not any(o.get("kind") == kind and o.get("outcome") == outcome for o in accepted):
                raise Failure(f"coverage: no accept case for {kind}/{outcome!r}")
    refusals = [c for c in corpus["results"] if c["expect"] == "refuse"]
    for reason in model["reasons"]:
        if not any(c["reason"] == reason for c in refusals):
            raise Failure(f"coverage: no refusal for {reason}")
    if not any(c["reason"] == "unknown_kind" and c["object"].get("kind") == model["reserved"]
               for c in refusals):
        raise Failure(f"coverage: reserved kind {model['reserved']} is not refused")
    for index, row in enumerate(model["table"]):
        if index not in rows_seen:
            raise Failure(f"coverage: no judgment for table row {row['cells']}")
    for disposition in model["dispositions"]:
        if disposition not in dispositions_seen:
            raise Failure(f"coverage: no duplicate judgment answering {disposition}")
    def classes(events: list[str]) -> list[frozenset[str]]:
        return _classes(events, model)
    for group in classes(model["events"]):
        if not group & events_seen:
            raise Failure(f"coverage: no lifecycle records any of {sorted(group)}")
    # Finality: each final result before the deadline keeps timed_out
    # unrecorded, and each non-final one does not.
    deadline = model["deadline"]

    def alone_before(x: dict, group: frozenset[str]) -> bool:
        if deadline not in x["events"]:
            return False
        before = x["events"][:x["events"].index(deadline)]
        return bool(group & set(before)) and not any(
            e in model["final"] for e in before if e not in group)
    for group in classes(model["final"]) + classes(model["not_final"]):
        expected = "deadline" if group & set(model["not_final"]) else None
        if not any(alone_before(x, group) and x["expect"]["timed_out"] == expected
                   for x in corpus["lifecycle"]):
            raise Failure(f"coverage: no lifecycle with {sorted(group)} alone before "
                          f"{deadline}")
    # Contradiction, swept: each binding refusal disposition, as a refusal and as
    # a duplicate, against driver_ok; driver_ok against driver_error; and the
    # non-binding ones (pending, storage_failure) beside driver_ok, which do not
    # contradict. A contradiction that arrives after acceptance must be present.
    lifecycles = corpus["lifecycle"]
    refusal_values = [v for v in model["allowed"]["refused"]]
    binding_refusals = sorted({v for e, v in model["asserts"].items()
                               if v in refusal_values and e not in model["not_binding_events"]})

    def paired(tokens: set[str], other: set[str], should: bool) -> bool:
        return any(tokens & set(x["events"]) and other & set(x["events"])
                   and x["expect"]["contradiction"] is should for x in lifecycles)
    for value in binding_refusals:
        tokens = {e for e, v in model["asserts"].items()
                  if v == value and e not in model["not_binding_events"]}
        if not paired(tokens, {"driver_reported_ok"}, True):
            raise Failure(f"coverage: no lifecycle pairing {value} with driver_reported_ok")
    for event in model["not_binding_events"]:
        # The text gives both orders for storage_failure (a redelivery driven
        # after it, a delivery after one was driven); the others need one.
        orders = ((True,), (False,)) if event.endswith("_storage_failure") else ((True, False),)
        for allowed_orders in orders:
            if not any(event in x["events"] and "driver_reported_ok" in x["events"]
                       and (x["events"].index(event) < x["events"].index("driver_reported_ok"))
                       in allowed_orders and x["expect"]["contradiction"] is False
                       for x in lifecycles):
                raise Failure(f"coverage: no lifecycle with {event} beside "
                              f"driver_reported_ok in order {allowed_orders}")
    refusal_tokens = {e for e, v in model["asserts"].items()
                      if v in refusal_values and e not in model["not_binding_events"]}
    for event in model["acting_events"]:
        if not paired({event}, refusal_tokens, True):
            raise Failure(f"coverage: no lifecycle with {event} beside a refusal")
    # The text's own second example, token for token: driver_reported(ok)
    # against driver_reported(error).
    driver_tokens = [e for e in model["asserts"] if e.startswith("driver_reported_")]
    if not any(set(driver_tokens) <= set(x["events"]) and x["expect"]["contradiction"]
               for x in lifecycles):
        raise Failure("coverage: no lifecycle with both driver results as a contradiction")
    if not any(x["expect"]["contradiction"] and any(
            e in model["ending_events"] for e in x["events"][:next(
                i for i, e in enumerate(x["events"]) if e in refusal_tokens)])
            for x in lifecycles if refusal_tokens & set(x["events"])):
        raise Failure("coverage: no contradiction arriving after driver acceptance")
    # The restart boundary: a restart alone, a restart after a final result,
    # a restart after the deadline, and a deadline after a restart.
    dl, rs = model["deadline"], model["restart"]
    for label, test, expected in (
            ("restart with no final result", lambda e: rs in e and not any(
                x in model["final"] or x == dl for x in e[:e.index(rs)]), "restart"),
            ("restart after a final result", lambda e: rs in e and any(
                x in model["final"] for x in e[:e.index(rs)]), None),
            ("restart after the deadline", lambda e: rs in e and dl in e[:e.index(rs)]
             and not any(x in model["final"] for x in e[:e.index(rs)]), "deadline"),
            ("deadline after a restart", lambda e: rs in e and dl in e[e.index(rs):]
             and not any(x in model["final"] for x in e), "restart")):
        if not any(test(x["events"]) and x["expect"]["timed_out"] == expected
                   for x in lifecycles):
            raise Failure(f"coverage: no lifecycle with {label}")
    # A consumer must not require accepted or attempted before driver_reported.
    for event in ("driver_reported_ok", "driver_reported_error"):
        if not any(event in x["events"] and "actuation_attempted" not in x["events"]
                   for x in corpus["lifecycle"]):
            raise Failure(f"coverage: no lifecycle with {event} and no actuation_attempted")
    if not corpus["digests"]:
        raise Failure("coverage: no digest case")


def run(corpus_bytes: bytes, model: dict, off: frozenset[str] = frozenset()) -> None:
    check(json.loads(corpus_bytes), model, off)
    if model["pin"] is None:
        raise Failure("firmware-command-result/v1.md pins no corpus digest")
    if hashlib.sha256(corpus_bytes).hexdigest() != model["pin"]:
        raise Failure("corpus digest differs from the one firmware-command-result/v1.md pins")


# --- mutations ----------------------------------------------------------------

def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check(mutated, model)
        return go

    def accept(kind: str, outcome: str) -> Callable[[dict], dict]:
        return lambda c: next(x for x in c["results"] if x["expect"] == "accept"
                              and x["object"]["kind"] == kind
                              and x["object"]["outcome"] == outcome)

    def refusal(reason: str) -> Callable[[dict], dict]:
        return lambda c: next(x for x in c["results"] if x["reason"] == reason)

    def judgment(kind: str, outcome: str | None = None) -> Callable[[dict], dict]:
        return lambda c: next(x for x in c["judgments"] if x["expect"]["kind"] == kind
                              and outcome in (None, x["expect"]["outcome"]))

    def lifecycle(test: Callable[[list[str]], bool]) -> Callable[[dict], dict]:
        return lambda c: next(x for x in c["lifecycle"] if test(x["events"]))

    driver_ok = accept("driver_reported", "ok")

    def resign_free_edit(case: dict, **fields: object) -> None:
        case["object"].update(fields)

    def flip(wire: str) -> str:
        raw = bytearray(base64.b64decode(wire[len(SIGNATURE_PREFIX):]))
        raw[40] ^= 1
        return SIGNATURE_PREFIX + base64.b64encode(bytes(raw)).decode()

    def flip_result(c: dict) -> None:
        case = driver_ok(c)
        case["signature"] = flip(case["signature"])
        payload = json.loads(bytes.fromhex(case["payload_hex"]))
        payload["signature"] = case["signature"]
        case["payload_hex"] = canonical(payload).hex()

    def edit_object(c: dict) -> None:
        case = driver_ok(c)
        resign_free_edit(case, outcome="error")
        case["canonical_hex"] = canonical(case["object"]).hex()
        case["payload_hex"] = canonical(
            {"command_result": case["object"], "signature": case["signature"]}).hex()

    def payload_whitespace(c: dict) -> None:
        case = driver_ok(c)
        case["payload_hex"] = bytes.fromhex(case["payload_hex"]).replace(
            b",", b", ", 1).hex()

    def second_family_on_accept(c: dict) -> None:
        case = driver_ok(c)
        payload = json.loads(bytes.fromhex(case["payload_hex"]))
        payload["fault"] = {}
        case["payload_hex"] = canonical(payload).hex()

    def flip_digest_signature(c: dict) -> None:
        c["digests"][0]["signature"] = flip(c["digests"][0]["signature"])

    def digest_over_object(c: dict) -> None:
        case = c["digests"][0]
        case["command_digest"] = "sha256:" + hashlib.sha256(
            bytes.fromhex(case["command_hex"])).hexdigest()

    def digest_without_nul(c: dict) -> None:
        case = c["digests"][0]
        case["command_digest"] = "sha256:" + hashlib.sha256(
            model["domain"].encode() + bytes.fromhex(case["command_hex"])).hexdigest()

    def reorder_command(c: dict) -> None:
        case = c["digests"][0]
        case["command"] = dict(reversed(list(case["command"].items())))

    def model_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            run(corpus_bytes, mutated)
        return go

    def text_mutant(key: str, old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            pattern = r"\s+".join(re.escape(part) for part in old.split())
            if old.startswith("\n") or old.endswith("\n") or old.startswith(" "):
                pattern = re.escape(old)
            found = re.search(pattern, texts[key])
            if found is None:
                raise AssertionError(f"mutant target missing from {key}: {old!r}")
            texts[key] = texts[key][:found.start()] + new + texts[key][found.end():]
            run(corpus_bytes, contract_model(texts))
        return go

    def flip_expect(field: str, test: Callable[[list[str]], bool]) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            case = lifecycle(test)(c)
            case["expect"][field] = not case["expect"][field]
        return edit

    has = lambda e: (lambda events: e in events)  # noqa: E731

    cases: list[tuple[str, Callable[[], None]]] = [
        ("result signature bit flipped", corpus_mutant(flip_result)),
        ("result outcome edited after signing", corpus_mutant(edit_object)),
        ("canonical_hex edited", corpus_mutant(
            lambda c: driver_ok(c).update(canonical_hex=driver_ok(c)["canonical_hex"] + "20"))),
        ("payload not canonical", corpus_mutant(payload_whitespace)),
        ("second family key on an accept case", corpus_mutant(second_family_on_accept)),
        ("accept case marked refuse", corpus_mutant(
            lambda c: driver_ok(c).update(expect="refuse", reason="member_set"))),
        ("verifier context names another device", corpus_mutant(
            lambda c: c["verifier_context"].update(device_id="ori-fw-other"))),
        ("verifier context names another posture", corpus_mutant(
            lambda c: c["verifier_context"].update(posture="development"))),
        ("device seed swapped", corpus_mutant(lambda c: c.update(device_test_seed_hex="43" * 32))),
        ("runtime seed swapped", corpus_mutant(
            lambda c: c.update(runtime_test_seed_hex="12" * 32))),
        ("reason added to the corpus", corpus_mutant(lambda c: c["reasons"].update(extra="x"))),
        ("reason dropped from the corpus", corpus_mutant(
            lambda c: c["reasons"].pop("digest_form"))),
        ("digest signature bit flipped", corpus_mutant(flip_digest_signature)),
        ("digest over the object alone", corpus_mutant(digest_over_object)),
        ("digest without NUL", corpus_mutant(digest_without_nul)),
        ("command members reordered", corpus_mutant(reorder_command)),
        ("message_hex edited", corpus_mutant(
            lambda c: c["digests"][0].update(message_hex=c["digests"][0]["message_hex"][:-2]))),
        ("digests dropped", corpus_mutant(lambda c: c["digests"].clear())),
        ("record not the mark's command", corpus_mutant(
            lambda c: judgment("duplicate")(c)["device"]["record"].update(
                cmd_seq=judgment("duplicate")(c)["device"]["mark"] + 1))),
        ("unknown stored disposition", corpus_mutant(
            lambda c: judgment("duplicate")(c)["device"]["record"].update(disposition="executed"))),
        ("duplicate answers pending as driver_ok", corpus_mutant(
            lambda c: judgment("duplicate", "pending")(c)["expect"].update(outcome="driver_ok"))),
        ("conflict relabelled duplicate", corpus_mutant(
            lambda c: judgment("conflict")(c)["expect"].update(kind="duplicate"))),
        ("new relabelled refused", corpus_mutant(
            lambda c: judgment("new")(c)["expect"].update(kind="refused", outcome="replayed"))),
        ("replay relabelled conflict", corpus_mutant(
            lambda c: judgment("none")(c)["expect"].update(kind="conflict", outcome=""))),
        ("no-result relabelled refused", corpus_mutant(
            lambda c: judgment("none")(c)["expect"].update(kind="refused", outcome="replayed"))),
        ("capability_mismatch stored for the device's own hash", corpus_mutant(
            lambda c: judgment("duplicate", "capability_mismatch")(c)["command"].update(
                capability_hash=judgment("duplicate", "capability_mismatch")(c)
                ["device"]["record"]["capability_hash"]))),
        ("one digest for two sequences", corpus_mutant(
            lambda c: judgment("none")(c)["command"].update(
                command_digest=judgment("none")(c)["device"]["record"]["command_digest"],
                cmd_seq=judgment("none")(c)["device"]["mark"] - 1))),
        ("lifecycle without signed", corpus_mutant(
            lambda c: c["lifecycle"][0]["events"].pop(0))),
        ("timed_out given as an input event", corpus_mutant(
            lambda c: c["lifecycle"][0]["events"].append("timed_out"))),
        ("deadline passing twice", corpus_mutant(
            lambda c: lifecycle(has(model["deadline"]))(c)["events"].append(model["deadline"]))),
        ("timed_out after a final result flipped", corpus_mutant(
            flip_expect("timed_out", lambda e: model["deadline"] in e and any(
                x in model["final"] for x in e[:e.index(model["deadline"])])))),
        ("timed_out with no final result flipped", corpus_mutant(
            flip_expect("timed_out", lambda e: model["deadline"] in e and not any(
                x in model["final"] for x in e[:e.index(model["deadline"])])))),
        ("attempts end at a stored driver_ok flipped", corpus_mutant(
            flip_expect("attempts_ended", has("device_duplicate_driver_ok")))),
        ("attempts end at a stored pending flipped", corpus_mutant(
            flip_expect("attempts_ended", has("device_duplicate_pending")))),
        ("attempts end at publish_unconfirmed flipped", corpus_mutant(
            flip_expect("attempts_ended", has("publish_unconfirmed")))),
        ("attempts end at driver_reported_ok flipped", corpus_mutant(
            flip_expect("attempts_ended", has("driver_reported_ok")))),
        ("attempts end at observation flipped", corpus_mutant(
            flip_expect("attempts_ended", has("terminal_outcome_observed_matches")))),
        ("uncertain under driver_reported_ok flipped", corpus_mutant(
            flip_expect("outcome_uncertain", has("driver_reported_ok")))),
        ("executed when observed matches flipped", corpus_mutant(
            flip_expect("executed", has("terminal_outcome_observed_matches")))),
        ("executed when observed differs flipped", corpus_mutant(
            flip_expect("executed", has("terminal_outcome_observed_differs")))),
        ("issued after publish_unconfirmed", corpus_mutant(
            lambda c: lifecycle(has("publish_unconfirmed"))(c)["events"].append("issued"))),
        ("critical when observed differs flipped", corpus_mutant(
            flip_expect("critical", has("terminal_outcome_observed_differs")))),
        ("critical when observed matches flipped", corpus_mutant(
            flip_expect("critical", has("terminal_outcome_observed_matches")))),
        ("critical without observation flipped", corpus_mutant(
            flip_expect("critical", lambda e: not any(
                x.startswith("terminal_outcome_observed_") for x in e)))),
        ("unknown event", corpus_mutant(
            lambda c: c["lifecycle"][0]["events"].append("executed"))),
        ("reserved kind refusal dropped", corpus_mutant(
            lambda c: c["results"].remove(next(
                x for x in c["results"] if x["object"].get("kind") == model["reserved"])))),
        ("model: executed set by driver_reported_ok", model_mutant(
            lambda m: m["observed"].update(driver_reported_ok=True))),
        ("model: attempts end at device_accepted", model_mutant(
            lambda m: m["ending_events"].append("device_accepted"))),
        ("model: stored driver_ok does not end attempts", model_mutant(
            lambda m: m["ending_events"].remove("device_duplicate_driver_ok"))),
        ("model: pending counted final", model_mutant(
            lambda m: m["final"].append("device_duplicate_pending"))),
        ("model: device_refused not final", model_mutant(
            lambda m: m["final"].remove("device_refused"))),
        ("model: pending not a disposition", model_mutant(
            lambda m: (m["dispositions"].remove("pending"),
                       m["allowed"]["duplicate"].remove("pending")))),
        ("model: corpus digest pin wrong", model_mutant(lambda m: m.update(pin="0" * 64))),
        ("model: no pin", model_mutant(lambda m: m.update(pin=None))),
        ("model: liveness domain for commands", model_mutant(
            lambda m: m.update(domain=m["liveness_domain"]))),
    ]
    # Lifecycles a weaker model would accept, appended with the conclusions of
    # this model except for the one a weakening would change. Each must be
    # refused. Codex's case first: a duplicate answering rate_limited, then
    # driver_reported(ok) and a matching observation, read as an execution.
    def add_lifecycle(label: str, events: list[str], **wrong: object) -> None:
        def edit(c: dict) -> None:
            expect = conclude(events, model, label)
            expect.update(wrong)
            c["lifecycle"].append({"name": f"mutant {label}", "note": "",
                                   "events": events, "expect": expect})
        cases.append((f"lifecycle {label}", corpus_mutant(edit)))
    head = [model["first_event"], "issued"]
    codex = head + ["device_duplicate_rate_limited", "driver_reported_ok",
                    "terminal_outcome_observed_matches"]
    add_lifecycle("codex P2 read as execution", codex, attempts_ended=True,
                  contradiction=False, critical=False, executed=True)
    add_lifecycle("codex P2 read as ordinary", codex, attempts_ended=True,
                  contradiction=False, critical=False)
    refusal_values = model["allowed"]["refused"]
    contradicting = [e for e, v in model["asserts"].items()
                     if e not in model["not_binding_events"]
                     and (v in refusal_values or v in model["driver_values"][1:]
                          or (v == "driver_error"))]
    for acting in model["acting_events"]:
        for event in [e for e in contradicting if model["asserts"][e] in refusal_values]:
            add_lifecycle(f"{acting} beside {event} let through", head + [acting, event],
                          contradiction=False, critical=False)
    for event in contradicting:
        for order in ("before", "after"):
            events = head + ([event, "driver_reported_ok"] if order == "before"
                             else ["driver_reported_ok", event])
            add_lifecycle(f"{event} {order} driver_ok let through", events,
                          contradiction=False, attempts_ended=True, critical=False)
            add_lifecycle(f"{event} {order} driver_ok ends attempts", events,
                          attempts_ended=True)
            add_lifecycle(f"{event} {order} driver_ok not critical", events, critical=False)
        add_lifecycle(f"{event} before a stored driver_ok let through",
                      head + [event, "device_duplicate_driver_ok"],
                      contradiction=False, attempts_ended=True, critical=False)
    for event in model["not_binding_events"]:
        for events in (head + [event, "driver_reported_ok"], head + ["driver_reported_ok", event]):
            add_lifecycle(f"{event} beside driver_ok read as a contradiction {events[-1]}",
                          events, contradiction=True, attempts_ended=False, critical=True)
    add_lifecycle("executed concluded", head + ["driver_reported_ok",
                  "terminal_outcome_observed_matches"], executed=True)
    dl, rs = model["deadline"], model["restart"]
    add_lifecycle("deadline re-armed after restart", head + [rs, dl], timed_out="deadline")
    add_lifecycle("restart overrides the deadline", head + [dl, rs], timed_out="restart")
    add_lifecycle("restart after a final result", head + ["driver_reported_ok", rs],
                  timed_out="restart")
    add_lifecycle("restart ignored", head + [rs], timed_out=None)
    add_lifecycle("restart ends attempts", head + [rs], attempts_ended=True)
    add_lifecycle("restart read as a refusal of a late result",
                  head + [rs, "driver_reported_ok"], attempts_ended=False)
    for label, edit in (
            ("model: contradiction does not block ending",
             lambda m: m.update(contradiction_blocks_ending=False)),
            ("model: contradiction not critical",
             lambda m: m.update(contradiction_critical=False)),
            ("model: restart ignored", lambda m: m.update(restart_ends_deadline=False)),
            ("model: nothing binds", lambda m: m.update(not_binding_events=list(m["asserts"]))),
            ("model: pending binds",
             lambda m: m["not_binding_events"].remove("device_duplicate_pending")),
            ("model: storage_failure binds",
             lambda m: m["not_binding_events"].remove("device_refused_storage_failure")),
            ("model: conflict binds", lambda m: m["not_binding_events"].remove("device_conflict")),
            ("model: acting asserts nothing",
             lambda m: [m["asserts"].pop(e) for e in m["acting_events"]]),
            ("model: acting contradicts driver results",
             lambda m: m.update(driver_values=[])),
            ("model: driver error asserts driver_ok",
             lambda m: m["asserts"].update(driver_reported_error="driver_ok")),
            ("model: duplicate refusal asserts nothing",
             lambda m: m["asserts"].pop("device_duplicate_rate_limited")),
            ("model: restart counted final", lambda m: m["final"].append(m["restart"]))):
        cases.append((label, model_mutant(edit)))
    for label, edit in BOUND_VARIANTS:
        cases.append((f"model: bound with {label}", model_mutant(
            lambda m, e=edit: e(m["bound"]))))
    cases.append(("bound step flipped", corpus_mutant(
        lambda c: c["bound"][0]["steps"][-1].update(
            signed=not c["bound"][0]["steps"][-1]["signed"]))))
    cases.append(("bound clock runs back", corpus_mutant(
        lambda c: c["bound"][0]["steps"][-1].update(t_ms=-1))))
    cases.append(("bound group dropped", corpus_mutant(lambda c: c.update(bound=[]))))
    for kind, outcomes in model["allowed"].items():
        for outcome in outcomes:
            cases.append((f"accept {kind}/{outcome!r} dropped", corpus_mutant(
                lambda c, k=kind, o=outcome: c.update(results=[
                    x for x in c["results"] if not (
                        x["expect"] == "accept" and x["object"]["kind"] == k
                        and x["object"]["outcome"] == o)]))))
    for reason in model["reasons"]:
        cases.append((f"refusal relabelled from {reason}", corpus_mutant(
            lambda c, r=reason: refusal(r)(c).update(
                reason=next(x for x in model["reasons"] if x != r)))))
        cases.append((f"{reason} refusal moved to accept", corpus_mutant(
            lambda c, r=reason: refusal(r)(c).update(expect="accept", reason=None))))
        cases.append((f"{reason} refusals dropped", corpus_mutant(
            lambda c, r=reason: c.update(results=[x for x in c["results"]
                                                  if x["reason"] != r]))))
        cases.append((f"rule off: {reason}", lambda r=reason: run(
            corpus_bytes, model, frozenset({r}))))
    for index, row in enumerate(model["table"]):
        def drop_row(c: dict, i: int = index) -> None:
            c["judgments"] = [j for j in c["judgments"] if _row_index(j, model) != i]
        cases.append((f"judgments for row {index + 1} dropped", corpus_mutant(drop_row)))
    for disposition in model["dispositions"]:
        cases.append((f"duplicate judging {disposition} dropped", corpus_mutant(
            lambda c, d=disposition: c.update(judgments=[
                j for j in c["judgments"]
                if not (j["expect"]["kind"] == "duplicate" and j["expect"]["outcome"] == d)]))))
    for group in _classes(model["events"], model):
        cases.append((f"lifecycles recording {sorted(group)} dropped", corpus_mutant(
            lambda c, g=group: c.update(lifecycle=[x for x in c["lifecycle"]
                                                   if not g & set(x["events"])]))))
    for group in _classes(model["final"], model) + _classes(model["not_final"], model):
        def drop_alone(c: dict, g: frozenset[str] = group) -> None:
            d = model["deadline"]
            c["lifecycle"] = [x for x in c["lifecycle"] if not (
                d in x["events"] and g & set(x["events"][:x["events"].index(d)]))]
        cases.append((f"lifecycles with {sorted(group)} before the deadline dropped",
                      corpus_mutant(drop_alone)))

    text_cases = [
        ("kind row removed", "r",
