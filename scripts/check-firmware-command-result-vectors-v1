         "### Tier C\n", "### Tier C\n\n  ### Unassigned Authority\n"),
    ]
    for label, key, old, new in text_cases:
        cases.append((f"text: {label}", text_mutant(key, old, new)))

    survived = 0
    for label, mutant in cases:
        try:
            mutant()
        except AssertionError as stale:
            print(f"STALE    {label}: {stale}")
            survived += 1
            continue
        except (Failure, KeyError, StopIteration, ValueError, TypeError) as refused:
            print(f"refused  {label}: {refused}")
        else:
            print(f"SURVIVED {label}")
            survived += 1
    print(f"{len(cases)} mutants")
    return survived


def _classes(events: list[str], model: dict) -> list[frozenset[str]]:
    """Coverage classes: each event, except that the device_refused tokens and
    the device_duplicate tokens with a final disposition each form one class,
    as the timed_out row treats them. The contradiction sweep covers them one
    disposition at a time."""
    groups = []
    for prefix in ("device_refused_", "device_duplicate_"):
        group = frozenset(e for e in events if e.startswith(prefix) and e in model["final"])
        if group:
            groups.append(group)
    grouped = set().union(*groups) if groups else set()
    return [frozenset({e}) for e in events if e not in grouped] + groups


def _row_index(case: dict, model: dict) -> int:
    work = copy.deepcopy(case)
    judge_repeat(work, model)
    return next(i for i, row in enumerate(model["table"]) if row["cells"] == work["_row"])


def main(argv: list[str]) -> int:
    if argv not in ([], ["--mutations"]):
        print(__doc__)
        return 2
    try:
        model = contract_model()
    except (Failure, ValueError, KeyError) as failure:
        print(f"firmware-command-result/v1 contracts: {failure}")
        return 1
    try:
        corpus_bytes = CORPUS.read_bytes()
    except OSError as error:
        print(f"firmware-command-result/v1 corpus: {error}")
        return 1
    try:
        run(corpus_bytes, model)
    except (Failure, KeyError, TypeError, ValueError) as failure:
        print(f"firmware-command-result/v1 corpus: {type(failure).__name__}: {failure}")
        return 1
    corpus = json.loads(corpus_bytes)
    accepts = sum(c["expect"] == "accept" for c in corpus["results"])
    print(
        f"firmware-command-result/v1 corpus: {accepts} results accepted, "
        f"{len(corpus['results']) - accepts} refused each for its declared reason, "
        f"{len(corpus['digests'])} digests, {len(corpus['bound'])} bound sequences, "
        f"{len(corpus['judgments'])} judgments, "
        f"{len(corpus['lifecycle'])} lifecycles as the text gives them"
    )
    if argv == ["--mutations"]:
        survived = mutations(corpus_bytes, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
