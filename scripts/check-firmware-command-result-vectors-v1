        ("accepted takes an outcome", "r", "| `accepted` | `\"\"` |", "| `accepted` | `ok` |"),
        ("reserved kind renamed", "r",
         "`feedback_observed` is reserved for", "`feedback_seen` is reserved for"),
        ("reserved kind accepted", "r",
         "a receiver refuses it as an unknown kind", "a receiver accepts it"),
        ("bad_signature gets a result", "r",
         "`wrong_device` or `bad_signature` gets no result", "`wrong_device` gets no result"),
