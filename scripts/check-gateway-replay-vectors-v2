# ---------------------------------------------------------------- the replay

class Receiver:
    def __init__(self, model: dict, ctx: dict) -> None:
        self.m = model
        self.skew = ctx["skew_ms"]
        self.ttl = ctx["replay_ttl_ms"]
        self.stores = ctx["stores"]
        self.raised = ctx["stored_floor_ms"]      # only a floor raised by a drop
        self.base = ctx["start_clock_ms"]         # the clock at the last start
        self.held = {h["key"]: (h["signed_at_ms"], h["received_at_ms"]) for h in ctx["held"]}
        self.pending: dict[str, tuple[str, int, int]] = {}

    @property
    def floor(self) -> int:
        return self.base if self.raised is None else self.m["start"](self.raised, self.base)

    def fails(self, c: dict, key: str, s: int, t: int) -> bool:
        if c["rhs"] == "held":
            return key in self.held
        rhs = {"t-S": t - self.skew, "t+S": t + self.skew, "F": self.floor}[c["rhs"]]
        return not OPS[c["op"]](s, rhs)

    def verify(self, rows: list[int], key: str, s: int, t: int) -> str | None:
        for i in rows:
            if self.fails(self.m["checks"][i], key, s, t):
                return self.m["checks"][i]["reason"]
        return None

    def drop(self, key: str) -> tuple:
        s, r = self.held.pop(key)
        up = s + self.m["raise_by"]
        self.raised = up if self.raised is None else max(self.raised, up)
        return (key, s, r)

    def retention_ended(self, s: int, r: int, t: int) -> bool:
        if not OPS[self.m["stale_op"]](t, s + self.skew):
            return False
        return self.ttl is None or OPS[self.m["ttl_op"]](t, r + self.ttl)


def replay(model: dict, case: dict) -> list[dict]:
    rx = Receiver(model, case["context"])
    trace = []
    for i, ev in enumerate(case["events"]):
        kind, t = ev["event"], ev["t"]
        rec = {"i": i, "kind": kind, "t": t, "ev": ev, "pre_floor": rx.floor,
               "pre_raised": rx.raised, "pre_skew": rx.skew, "pre_held": dict(rx.held),
               "reason": None, "dropped": [], "fails": None, "key": ev.get("key"),
               "s": ev.get("signed_at_ms")}
        if kind in ("receive", "authenticate"):
            rec["fails"] = [rx.fails(c, ev["key"], ev["signed_at_ms"], t)
                            for c in model["checks"]]
            rec["reason"] = rx.verify(list(range(4)), ev["key"], ev["signed_at_ms"], t)
            if rec["reason"] is None:
                if kind == "receive":
                    rx.held[ev["key"]] = (ev["signed_at_ms"], t)
                else:
                    if ev["handle"] in rx.pending:
                        raise Failure(f"event {i}: handle {ev['handle']} already pending")
                    rx.pending[ev["handle"]] = (ev["key"], ev["signed_at_ms"], t)
        elif kind == "commit":
            if ev["handle"] not in rx.pending:
                raise Failure(f"event {i}: commit of handle {ev['handle']} that is not pending")
            key, s, r = rx.pending.pop(ev["handle"])
            if key != ev["key"]:
                raise Failure(f"event {i}: commit key {ev['key']} is not its authenticate's {key}")
            rec["s"], rec["auth_t"] = s, r
            rec["reason"] = rx.verify(list(model["recheck"]), key, s, t)
            if rec["reason"] is None:
                rx.held[key] = (s, r)              # receipt time from the authenticate
        elif kind == "prune":
            for key in [k for k, (s, r) in rx.held.items() if rx.retention_ended(s, r, t)]:
                rec["dropped"].append(rx.drop(key))
        elif kind == "evict":
            if not rx.held:
                raise Failure(f"event {i}: evict with nothing held")
            least = min(s for s, _ in rx.held.values())
            ties = sorted(k for k, (s, _) in rx.held.items() if s == least)
            # Any one of several sharing the smallest signing time may go; the
            # declared held keys name which, and must be one of them.
            want = set(ev["expected"]["held"])
            pick = next((k for k in ties if set(rx.held) - {k} == want), ties[0])
            rec["dropped"].append(rx.drop(pick))
        elif kind == "restart":
            if not rx.stores:
                rx.raised, rx.held = None, {}
            rx.base = t
            if "skew_ms" in ev:
                rx.skew = ev["skew_ms"]
            rx.pending = {}
        elif kind == "rotate":
            if not ev["keeps_previous"]:
                rx.raised, rx.held, rx.base, rx.pending = None, {}, t, {}
        rec.update(floor=rx.floor, raised=rx.raised, skew=rx.skew, held=dict(rx.held))
        trace.append(rec)
    return trace


# ---------------------------------------------------------------- the corpus

EVENT_FIELDS = {
    "receive": ({"event", "key", "signed_at_ms", "t", "expected"}, set()),
    "authenticate": ({"event", "handle", "key", "signed_at_ms", "t", "expected"}, set()),
    "commit": ({"event", "handle", "key", "t", "expected"}, set()),
    "prune": ({"event", "t", "expected"}, set()),
    "evict": ({"event", "t", "expected"}, set()),
    "restart": ({"event", "t", "expected"}, {"skew_ms"}),
    "rotate": ({"event", "keeps_previous", "t", "expected"}, set()),
}
REASONED = {"receive", "authenticate", "commit"}


def is_int(x: object) -> bool:
    return type(x) is int


def check_shape(corpus: dict, model: dict) -> None:
    if set(corpus) != {"contract", "section", "comment", "reasons", "cases"}:
        raise Failure(f"corpus top-level keys: {sorted(corpus)}")
    if corpus["contract"] != "ori-specs/gateway-api/v2.md":
        raise Failure(f"corpus contract: {corpus['contract']!r}")
    if corpus["section"] != SECTION:
        raise Failure(f"corpus section: {corpus['section']!r}")
    order = [c["reason"] for c in model["checks"]]
    if corpus["reasons"] != order:
        raise Failure(f"corpus reasons {corpus['reasons']} are not the table's {order}")
    names = [c["name"] for c in corpus["cases"]]
    if len(names) != len(set(names)):
        raise Failure("case names are not unique")
    for case in corpus["cases"]:
        name = case["name"]
        if set(case) != {"name", "note", "context", "events"} or not case["events"]:
            raise Failure(f"{name}: case fields")
        ctx = case["context"]
        if set(ctx) != {"skew_ms", "replay_ttl_ms", "stores", "stored_floor_ms",
                        "start_clock_ms", "held"}:
            raise Failure(f"{name}: context fields {sorted(ctx)}")
        if not (is_int(ctx["skew_ms"]) and ctx["skew_ms"] >= 0 and is_int(ctx["start_clock_ms"])
                and type(ctx["stores"]) is bool
                and (ctx["replay_ttl_ms"] is None or is_int(ctx["replay_ttl_ms"]))
                and (ctx["stored_floor_ms"] is None or is_int(ctx["stored_floor_ms"]))):
            raise Failure(f"{name}: context types")
        if not ctx["stores"] and ctx["stored_floor_ms"] is not None:
            raise Failure(f"{name}: a receiver that stores nothing has a stored floor")
        sig: dict[str, int] = {}
        for h in ctx["held"]:
            if set(h) != {"key", "signed_at_ms", "received_at_ms"} or h["key"] in sig \
                    or not is_int(h["signed_at_ms"]) or not is_int(h["received_at_ms"]):
                raise Failure(f"{name}: context held entry {h}")
            sig[h["key"]] = h["signed_at_ms"]
        for i, ev in enumerate(case["events"]):
            kind = ev.get("event")
            if kind not in EVENT_FIELDS:
                raise Failure(f"{name} event {i}: kind {kind!r}")
            need, may = EVENT_FIELDS[kind]
            if not need <= set(ev) <= need | may:
                raise Failure(f"{name} event {i}: fields {sorted(ev)}")
            if not is_int(ev["t"]) or ("skew_ms" in ev and not (is_int(ev["skew_ms"])
                                                                and ev["skew_ms"] >= 0)):
                raise Failure(f"{name} event {i}: types")
            if kind == "rotate" and type(ev["keeps_previous"]) is not bool:
                raise Failure(f"{name} event {i}: keeps_previous")
            if "signed_at_ms" in ev:
                if not is_int(ev["signed_at_ms"]):
                    raise Failure(f"{name} event {i}: signed_at_ms")
                # A key includes its signing time: one label, one signing time.
                if sig.setdefault(ev["key"], ev["signed_at_ms"]) != ev["signed_at_ms"]:
                    raise Failure(f"{name} event {i}: key {ev['key']} with two signing times")
            exp = ev["expected"]
            want = {"floor_ms", "held"} | ({"reason"} if kind in REASONED else set())
            if set(exp) != want:
                raise Failure(f"{name} event {i}: expected fields {sorted(exp)}")
            if kind in REASONED and exp["reason"] is not None and exp["reason"] not in order:
                raise Failure(f"{name} event {i}: reason {exp['reason']!r}")
            if not is_int(exp["floor_ms"]) or len(set(exp["held"])) != len(exp["held"]):
                raise Failure(f"{name} event {i}: floor or held malformed")


def check_replay(corpus: dict, model: dict) -> dict[str, list[dict]]:
    traces = {}
    for case in corpus["cases"]:
        trace = replay(model, case)
        for rec in trace:
            exp, where = rec["ev"]["expected"], f"{case['name']} event {rec['i']} ({rec['kind']})"
            if rec["kind"] in REASONED and exp["reason"] != rec["reason"]:
                raise Failure(f"{where}: reason {exp['reason']!r}, replay gives {rec['reason']!r}")
            if exp["floor_ms"] != rec["floor"]:
                raise Failure(f"{where}: floor {exp['floor_ms']}, replay gives {rec['floor']}")
            if set(exp["held"]) != set(rec["held"]):
                raise Failure(f"{where}: held {sorted(exp['held'])}, replay gives "
                              f"{sorted(rec['held'])}")
        traces[case["name"]] = trace
    return traces


# ---------------------------------------------------------------- coverage
# Each bullet is held as parts; each part is a test over one case's context
# and trace. A bullet is shown when every part is shown by some case.

def _reason(model: dict, rhs: str) -> str:
    return next(c["reason"] for c in model["checks"] if c["rhs"] == rhs)


def _after(trace: list[dict], i: int) -> list[dict]:
    return trace[i + 1:]


def _segment_after(trace: list[dict], i: int) -> list[dict]:
    """Events after i up to the next restart."""
    out = []
    for rec in trace[i + 1:]:
        if rec["kind"] == "restart":
            break
        out.append(rec)
    return out


def _verifies(trace):
    return [r for r in trace if r["kind"] in ("receive", "authenticate")]


def parts(model: dict) -> dict[str, list[tuple[str, Callable[[dict, list[dict]], bool]]]]:
    STALE, FUTURE = _reason(model, "t-S"), _reason(model, "t+S")
    FLOOR, REPLAY = _reason(model, "F"), _reason(model, "held")

    def at_floor(ctx, tr):
        return any(r["reason"] is None and r["s"] == r["pre_floor"] for r in _verifies(tr))

    def below_floor(ctx, tr):
        return any(r["reason"] == FLOOR and r["s"] == r["pre_floor"] - 1 for r in _verifies(tr))

    def edge(reason, off, side):
        def test(ctx, tr):
            return any(r["reason"] == reason
                       and r["s"] == r["t"] + side * (r["pre_skew"] + off)
                       for r in _verifies(tr))
        return test

    def ttl_last_ms(shorter):
        def test(ctx, tr):
            for r in tr:
                if r["kind"] != "receive" or r["reason"] != REPLAY:
                    continue
                ttl = ctx["replay_ttl_ms"]
                if ttl is None or r["t"] != r["s"] + r["pre_skew"]:
                    continue
                if (ttl < r["pre_skew"]) != shorter or ttl == r["pre_skew"]:
                    continue
                received = r["pre_held"][r["key"]][1]
                pruned = any(x["kind"] == "prune" and x["t"] == r["t"]
                             and r["key"] in x["pre_held"] for x in tr[:r["i"]])
                if pruned and (not shorter or r["t"] >= received + ttl):
                    return True
            return False
        return test

    def ahead(ctx, tr):
        for j, rs in enumerate(tr):
            if rs["kind"] != "restart":
                continue
            for a in tr[:j]:
                if a["kind"] == "receive" and a["reason"] is None and a["s"] > a["t"] \
                        and a["s"] >= rs["t"] and any(
                            b["kind"] == "receive" and b["key"] == a["key"]
                            for b in _after(tr, j)):
                    return True
        return False

    def behind(ctx, tr):
        for j, rs in enumerate(tr):
            if rs["kind"] != "restart":
                continue
            seg = _segment_after(tr, j)
            if any(r["kind"] == "receive" and r["reason"] == FLOOR and r["s"] < r["t"]
                   and r["s"] < rs["t"] for r in seg) and any(
                       r["kind"] == "receive" and r["reason"] is None and r["s"] < r["t"]
                       for r in seg):
                return True
        return False

    def forward(kind):
        def test(ctx, tr):
            for r in tr[1:]:
                if r["kind"] == kind and r["t"] > tr[r["i"] - 1]["t"] + 2 * r["pre_skew"] \
                        and (kind == "restart" or r["dropped"]):
                    return True
            return False
        return test

    def back_live(ctx, tr):
        top = None
        for r in tr:
            if r["kind"] == "restart":
                top = None
                continue
            if top is not None and r["t"] < top and r["kind"] == "receive" \
                    and r["reason"] == FLOOR:
                return True
            top = r["t"] if top is None else max(top, r["t"])
        return False

    def back_start(ctx, tr):
        for j, rs in enumerate(tr):
            if rs["kind"] == "restart" and j and rs["t"] < max(x["t"] for x in tr[:j]) \
                    and any(r["kind"] == "receive" and r["reason"] == FLOOR
                            for r in _segment_after(tr, j)):
                return True
        return False

    def back_unstored(ctx, tr):
        if ctx["stores"]:
            return False
        for j, rs in enumerate(tr):
            if rs["kind"] == "restart" and j and rs["t"] < max(x["t"] for x in tr[:j]) \
                    and any(r["kind"] == "receive" and r["reason"] is None
                            and r["key"] in rs["pre_held"] for r in _segment_after(tr, j)):
                return True
        return False

    def back_upgrade(ctx, tr):
        if not ctx["stores"] or ctx["stored_floor_ms"] is not None:
            return False
        starts = [r for r in tr if r["kind"] == "restart"]
        for a, first in enumerate(starts):
            for later in starts[a + 1:]:
                if later["t"] >= first["t"]:
                    continue
                refused = {r["key"] for r in tr[first["i"] + 1:later["i"]]
                           if r["kind"] == "receive" and r["reason"] == FLOOR
                           and r["s"] < first["t"] and r["key"] not in r["pre_held"]}
                if any(r["kind"] == "receive" and r["reason"] is None and r["key"] in refused
                       for r in _segment_after(tr, later["i"])):
                    return True
        return False

    def evict_ahead(ctx, tr):
        if not ctx["stores"]:
            return False
        for e in tr:
            if e["kind"] != "evict" or e["dropped"][0][1] <= e["t"]:
                continue
            s = e["dropped"][0][1]
            live = any(r["kind"] == "receive" and r["reason"] == FLOOR and r["s"] <= s
                       and r["s"] >= r["t"] - r["pre_skew"] for r in _segment_after(tr, e["i"]))
            for rs in _after(tr, e["i"]):
                if rs["kind"] == "restart" and rs["raised"] is not None and rs["raised"] > s \
                        and live and any(
                            r["kind"] == "receive" and r["reason"] == FLOOR
                            and rs["t"] <= r["s"] <= s for r in _segment_after(tr, rs["i"])):
                    return True
        return False

    def skew_raised(ctx, tr):
        for j, rs in enumerate(tr):
            if rs["kind"] == "restart" and rs["skew"] > rs["pre_skew"]:
                old, new = rs["pre_skew"], rs["skew"]
                if any(r["kind"] == "receive" and r["reason"] == FLOOR
                       and r["s"] < r["t"] - old and r["s"] >= r["t"] - new
                       for r in _segment_after(tr, j)):
                    return True
        return False

    def skew_lowered(ctx, tr):
        for j, rs in enumerate(tr):
            if rs["kind"] == "restart" and rs["skew"] < rs["pre_skew"]:
                old = rs["pre_skew"]
                if any(r["kind"] == "prune" and any(r["t"] <= s + old for _, s, _ in r["dropped"])
                       for r in _segment_after(tr, j)):
                    return True
        return False

    def restart_where(stores, test):
        def go(ctx, tr):
            return ctx["stores"] == stores and any(
                r["kind"] == "restart" and test(r) for r in tr)
        return go

    def upgrade(ctx, tr):
        if not (ctx["stores"] and ctx["stored_floor_ms"] is None and ctx["held"]
                and tr[0]["kind"] == "restart"):
            return False
        start, kept = tr[0]["t"], {h["key"] for h in ctx["held"]}
        seg = _segment_after(tr, 0)
        return any(r["kind"] == "receive" and r["reason"] == REPLAY and r["key"] in kept
                   for r in seg) and any(
                       r["kind"] == "receive" and r["reason"] == FLOOR
                       and r["key"] not in r["pre_held"] and r["s"] < start for r in seg)

    def rollback(ctx, tr):
        stored = ctx["stored_floor_ms"]
        j = next((r["i"] for r in tr if r["kind"] == "restart"), None)
        if stored is None or j is None or tr[j]["t"] <= stored:
            return False
        return any(r["kind"] == "receive" and r["reason"] == FLOOR
                   and stored <= r["s"] < tr[j]["t"] for r in _segment_after(tr, j))

    def auth_drop(ctx, tr):
        for c in tr:
            if c["kind"] != "commit" or c["reason"] != FLOOR:
                continue
            a = next(x for x in reversed(tr[:c["i"]]) if x["kind"] == "authenticate"
                     and x["ev"]["handle"] == c["ev"]["handle"])
            if any(x["dropped"] for x in tr[a["i"] + 1:c["i"]]) \
                    and a["s"] >= a["floor"] and c["s"] < c["pre_floor"]:
                return True
        return False

    def evicts(ctx, tr):
        for e in tr:
            if e["kind"] != "evict":
                continue
            key, s, r = e["dropped"][0]
            early = not (OPS[model["stale_op"]](e["t"], s + e["pre_skew"]) and (
                ctx["replay_ttl_ms"] is None
                or OPS[model["ttl_op"]](e["t"], r + ctx["replay_ttl_ms"])))
            if early and any(x["kind"] == "receive" and x["key"] == key
                             and x["reason"] == FLOOR for x in _after(tr, e["i"])):
                return True
        return False

    def rotation(keeps):
        def test(ctx, tr):
            for r in tr:
                if r["kind"] != "rotate" or r["ev"]["keeps_previous"] != keeps \
                        or not r["pre_held"] or r["pre_floor"] <= r["t"]:
                    continue
                if keeps and r["held"] == r["pre_held"] and r["floor"] == r["pre_floor"]:
                    return True
                if not keeps and not r["held"] and r["floor"] == r["t"]:
                    return True
            return False
        return test

    idx = {c["rhs"]: n for n, c in enumerate(model["checks"])}

    def precedence(a, b):
        first, second = sorted((idx[a], idx[b]))

        def test(ctx, tr):
            reason = model["checks"][first]["reason"]
            return any(r["reason"] == reason and r["fails"][second] for r in _verifies(tr))
        return test

    def commit_receipt(ctx, tr):
        ttl = ctx["replay_ttl_ms"]
        if ttl is None:
            return False
        for c in tr:
            if c["kind"] != "commit" or c["reason"] is not None or c["auth_t"] >= c["t"]:
                continue
            # dropped by a prune the authenticate's receipt allows and the
            # commit's would not
            if any(p["kind"] == "prune" and any(k == c["key"] for k, _, _ in p["dropped"])
                   and c["auth_t"] + ttl <= p["t"] < c["t"] + ttl
                   for p in _after(tr, c["i"])):
                return True
        return False

    return {
        B_FLOOR: [("accepted at the floor", at_floor),
                  (f"{FLOOR} one ms below the floor", below_floor)],
        B_SKEW: [("accepted at t - S", edge(None, 0, -1)),
                 (f"{STALE} at t - S - 1", edge(STALE, 1, -1)),
                 ("accepted at t + S", edge(None, 0, 1)),
                 (f"{FUTURE} at t + S + 1", edge(FUTURE, 1, 1))],
        B_TTL: [("replay at s + S after a prune at it, ttl < S", ttl_last_ms(True)),
                ("replay at s + S after a prune at it, ttl > S", ttl_last_ms(False))],
        B_SENDERS: [("sender ahead: accepted with s > t and s past a later start, "
                     "received again after it", ahead),
                    ("sender behind: refused at a start floor with s < t, then accepted "
                     "with s < t", behind)],
        B_CLOCK: [("clock forward live: a prune more than 2S after the last event drops "
                   "keys", forward("prune")),
                  ("clock back live: a receive below an earlier clock, refused at the "
                   "floor", back_live),
                  ("clock forward across a start: a restart more than 2S after the last "
                   "event", forward("restart")),
                  ("clock back across a non-storing restart: a key of the earlier run is "
                   "accepted again", back_unstored),
                  ("clock back across a later start by a storing receiver after an "
                   "upgrade: a key refused at the first start floor is accepted",
                   back_upgrade),
                  ("clock back across a start: a restart below an earlier clock, then a "
                   "floor refusal", back_start)],
        B_SKEWCHG: [("skew raised: a key stale under the old skew is refused at the floor "
                     "under the new", skew_raised),
                    ("skew lowered: a prune drops a key the old skew would keep",
                     skew_lowered)],
        B_RESTART: [("a storing restart keeps held keys", restart_where(
                        True, lambda r: r["pre_held"] and r["held"] == r["pre_held"])),
                    ("a storing restart keeps a raised floor above its clock", restart_where(
                        True, lambda r: r["pre_raised"] is not None
                        and r["raised"] == r["pre_raised"] and r["raised"] > r["t"])),
                    ("a non-storing restart loses held keys", restart_where(
                        False, lambda r: r["pre_held"] and not r["held"])),
                    ("a non-storing restart loses a raised floor", restart_where(
                        False, lambda r: r["pre_raised"] is not None and r["raised"] is None)),
                    ("first start with keys and no stored floor: a kept key is a replay, "
                     "a dropped one is refused at the start floor", upgrade),
                    ("a stored floor below the start clock: an envelope it would admit is "
                     "refused at the start floor", rollback)],
        B_AUTH: [("a drop between authenticate and commit raises the floor past the "
                  "envelope", auth_drop)],
        B_EVICT: [("an evict before retention ends, and the evicted key refused at the "
                   "floor", evicts),
                  ("an evicted key signed ahead of the clock refuses a sender behind it, "
                   "and again after a storing restart, above the start floor", evict_ahead)],
        B_ROTATE: [("a keeping rotation keeps a floor ahead of the clock and its keys",
                    rotation(True)),
                   ("a non-keeping rotation clears both, the floor at the clock",
                    rotation(False))],
        B_COMMIT: [("a committed key dropped at its authentication's receipt plus ttl, "
                    "before its commit's", commit_receipt)],
        B_PREC: [("stale and below the floor", precedence("t-S", "F")),
                 ("future and below the floor", precedence("t+S", "F")),
                 ("below the floor and held", precedence("F", "held"))],
    }


COVERAGE = (B_FLOOR, B_SKEW, B_TTL, B_COMMIT, B_SENDERS, B_CLOCK, B_SKEWCHG, B_RESTART,
            B_AUTH, B_EVICT, B_ROTATE, B_PREC)


def witnesses(corpus: dict, model: dict, traces: dict) -> dict[tuple[str, str], list[str]]:
    out = {}
    for bullet, ps in parts(model).items():
        for label, test in ps:
            out[(bullet, label)] = [c["name"] for c in corpus["cases"]
                                    if test(c["context"], traces[c["name"]])]
    return out


def check_coverage(corpus: dict, model: dict, traces: dict) -> None:
    missing = [f"{bullet!r}: {label}" for (bullet, label), w
               in witnesses(corpus, model, traces).items() if not w]
    if missing:
        raise Failure("cover bullets not shown by any case:\n  " + "\n  ".join(missing))


# ---------------------------------------------------------------- run

def check(text: str, corpus: dict, rc: str | None = None,
          st: dict | None = None) -> tuple[dict, dict]:
    model = contract_model(text)
    check_inventory(text, rc if rc is not None else RUNTIME_CONFIG.read_text(encoding="utf-8"),
                    st if st is not None else json.loads(STATUS.read_text(encoding="utf-8")))
    check_shape(corpus, model)
    traces = check_replay(corpus, model)
    check_coverage(corpus, model, traces)
    return model, traces


def outcome(text: str, corpus: dict, rc: str | None = None,
            st: dict | None = None) -> str | None:
    try:
        check(text, corpus, rc, st)
    except Failure as failure:
        return str(failure)
    except (KeyError, TypeError, ValueError, IndexError, StopIteration) as failure:
        return f"malformed: {failure!r}"
    return None


def mutations(text: str, corpus: dict) -> int:
    base = outcome(text, corpus)
    if base is not None:
        print("baseline fails; a mutant is refused only when its outcome differs from it")
    try:
        model = contract_model(text)
    except Failure:
        print("the contract does not parse; no mutant can be judged")
        return -1
    cases: list[tuple[str, Callable[[], tuple[str, dict]]]] = []

    def cm(label: str, edit: Callable[[dict], None]) -> None:
        def go():
            c = copy.deepcopy(corpus)
            edit(c)
            return text, c
        cases.append((label, go))

    sec_at = text.index(f"## {SECTION}\n")     # every text mutant lands in the section

    def tm(label: str, old: str, new: str) -> None:
        if old not in text[sec_at:]:
            raise SystemExit(f"text mutant {label!r}: {old!r} not in the section")

        def go():
            return text[:sec_at] + text[sec_at:].replace(old, new, 1), corpus
        cases.append((label, go))

    reasons = [c["reason"] for c in model["checks"]]
    for ci, case in enumerate(corpus["cases"]):
        names = sorted({e["key"] for e in case["events"] if "key" in e}
                       | {h["key"] for h in case["context"]["held"]})
        for ei, ev in enumerate(case["events"]):
            where = f"{case['name']}#{ei}"
            exp = ev["expected"]

            def at(c, ci=ci, ei=ei):
                return c["cases"][ci]["events"][ei]["expected"]
            if "reason" in exp:
                for r in [None] + reasons:
                    if r != exp["reason"]:
                        cm(f"{where} reason -> {r}",
                           lambda c, r=r, at=at: at(c).__setitem__("reason", r))
            for d in (1, -1):
                cm(f"{where} floor {d:+d}",
                   lambda c, d=d, at=at: at(c).__setitem__("floor_ms", at(c)["floor_ms"] + d))
            extra = next((n for n in names if n not in exp["held"]), "zz-mutant")
            cm(f"{where} held + {extra}",
               lambda c, k=extra, at=at: at(c)["held"].append(k))
            for k in exp["held"]:
                cm(f"{where} held - {k}", lambda c, k=k, at=at: at(c)["held"].remove(k))

    cm("header: contract", lambda c: c.__setitem__("contract", "ori-specs/gateway-api/v1.md"))
    cm("header: section", lambda c: c.__setitem__("section", "Envelope Freshness"))
    cm("header: reasons reordered", lambda c: c["reasons"].reverse())
    cm("header: reason renamed", lambda c: c["reasons"].__setitem__(0, "stale"))
    cm("header: duplicate case name",
       lambda c: c["cases"][1].__setitem__("name", c["cases"][0]["name"]))

    # Cases that are the only witness of some coverage part.
    _, traces = (model, check_replay(corpus, model)) if base is None or \
        base.startswith("cover bullets") else (model, None)
    equivalent = []
    if traces is not None:
        sole: dict[str, list[str]] = {}
        for (bullet, label), w in witnesses(corpus, model, traces).items():
            if len(w) == 1:
                sole.setdefault(w[0], []).append(label)
        for case in corpus["cases"]:
            n = case["name"]
            if n in sole:
                cm(f"case {n} deleted (sole witness: {'; '.join(sole[n])})",
                   lambda c, n=n: c.__setitem__(
                       "cases", [x for x in c["cases"] if x["name"] != n]))
            else:
                equivalent.append(f"case {n} deleted: witnesses no part alone")

    # Text mutants.
    rows = [line for line in sections(text)["Order of checks"]
            if re.fullmatch(r"\| \d \| .+ \|", line)]
    cells = [re.fullmatch(r"\| (\d) \| (.+) \|", r).groups() for r in rows]
    for i in range(3):
        a, b = rows[i], rows[i + 1]
        tm(f"text: table rows {i + 1} and {i + 2} swapped", a + "\n" + b, b + "\n" + a)
        tm(f"text: checks {i + 1} and {i + 2} swapped, numbers kept", a + "\n" + b,
           f"| {cells[i][0]} | {cells[i + 1][1]} |\n| {cells[i + 1][0]} | {cells[i][1]} |")
    for r in reasons:
        tm(f"text: reason {r} renamed", f"| `{r}` |", f"| `{r}_x` |")
    for row in rows:
        for old, new in (("≥", ">"), ("≤", "<")):
            if old in row:
                tm(f"text: {row.split('|')[1].strip()} {old} -> {new}",
                   row, row.replace(old, new))
    tm("text: bounds exclusive", "Every bound is inclusive.", "Every bound is exclusive.")
    tm("text: retention stale bound inclusive", "- `t` > `signed_at_ms` + `S`, so",
       "- `t` ≥ `signed_at_ms` + `S`, so")
    tm("text: retention ttl bound exclusive", "- `t` ≥ its receipt time plus",
       "- `t` > its receipt time plus")
    tm("text: recheck names other checks", "makes checks 3 and 4 again",
       "makes checks 2 and 4 again")
    tm("text: recheck one check", "makes checks 3 and 4 again", "makes check 4 again")
    tm("text: drop raises by 2", "`signed_at_ms` + 1, in the same",
       "`signed_at_ms` + 2, in the same")
    for name, phrases in HELD.items():
        for p in phrases:
            first = p.split(" ")[:6]
            # Delete the held sentence's opening words in the file's own wrapping.
            pat = r"\s+".join(re.escape(w) for w in first)
            m = re.compile(pat).search(text, sec_at)
            if m:
                cases.append((f"text: {name} sentence cut: {' '.join(first)}…",
                              lambda m=m: (text[:m.start()] + "XX" + text[m.end():], corpus)))
    tm("text: earlier secret may verify", "in which no earlier secret verifies",
       "in which an earlier secret may verify")
    tm("text: drop may raise", "**A dropped key raises the floor.**",
       "**A dropped key may raise the floor.**")
    tm("text: sender republishes", "It never republishes envelope bytes",
       "It may republish envelope bytes")
    tm("text: limit 2S", "at most `S` past its signing time",
       "at most 2 × `S` past its signing time")
    tm("text: start takes the lesser", "`F` becomes the greater of", "`F` becomes the lesser of")
    tm("text: un-record allowed", "A recorded key is never un-recorded:",
       "A recorded key may be un-recorded:")
    tm("text: MUST NOT bring back", "MUST NOT bring back a secret", "may bring back a secret")
    tm("text: bring back only as current", "secret or the previous one:", "secret:")
    tm("text: limits no longer bound claims", "it stops outside the cases",
       "it stops in every case, even the cases")
    tm("text: skew may be negative", "maximum clock skew, never negative;",
       "maximum clock skew;")

    def om(label: str, edit: Callable[[str], str]) -> None:
        cases.append((label, lambda: (edit(text), corpus)))
    dur = text.index("### Durability and Retirement\n")
    hostile = text.index("from a hostile one.", dur) + len("from a hostile one.")
    om("codex: custody rationale claims restore safety", lambda x: x[:hostile] + (
        " This protection is guaranteed even after restoring an older state store.")
        + x[hostile:])
    om("outside: replay claim under a guarded heading", lambda x: x.replace(
        "### Heartbeat Auth Envelope\n", "### Heartbeat Auth Envelope\n\n"
        "A heartbeat is never replayed.\n", 1))
    om("outside: an unguarded section starts naming replay", lambda x: x.replace(
        "## Producer Time\n", "## Producer Time\n\nThe clock here is not a replay "
        "defence.\n", 1))
    om("outside: a guarded sentence removed", lambda x: x.replace(
        "from a hostile one.", "from a hostile one", 1))
    rc_text = RUNTIME_CONFIG.read_text(encoding="utf-8")
    st_obj = json.loads(STATUS.read_text(encoding="utf-8"))
    cases.append(("runtime-config: ttl opens a window", lambda: (text, corpus, rc_text.replace(
        "so no value of it\n  opens a replay window", "so a short value\n  opens a replay window",
        1), None)))
    cases.append(("runtime-config: a second replay obligation", lambda: (
        text, corpus, rc_text.replace("## Producer Obligations", "- Keep the replay cache "
                                      "small.\n\n## Producer Obligations", 1), None)))

    def stm(label: str, edit: Callable[[dict], None]) -> None:
        def go():
            c = copy.deepcopy(st_obj)
            edit(c)
            return text, corpus, None, c
        cases.append((label, go))
    stm("status: top-level notes claim restore safety", lambda c: c.__setitem__(
        "notes", c["notes"] + " Replay protection survives a restored state store."))
    stm("status: adoption notes changed", lambda c: c["adoption"][0].__setitem__(
        "notes", c["adoption"][0]["notes"].replace(".", ";", 1)))
    sd = text.index("### Senders\n")
    for old, new in (("whose bytes the\nsender has never published", "whose bytes differ\nfrom "
                      "the last it published"),
                     ("never repeats a value", "rarely repeats a value"),
                     ("one\nmillisecond past the previous", "one\nmillisecond past or at the "
                      "previous"),
                     ("and durable\nacross a restart", "and kept in memory\nacross a restart"),
                     ("in one millisecond, or across a restart", "in one millisecond"),
                     ("so reading the clock again is not\nenough", "so reading the clock again "
                      "is\nenough")):
        if old not in text[sd:]:
            raise SystemExit(f"senders mutant: {old!r} not found")
        om(f"text: senders loosened: {flat(new)[:40]}",
           lambda x, old=old, new=new: x[:sd] + x[sd:].replace(old, new, 1))
    tm("text: subsection renamed", "### The floor\n", "### The replay floor\n")
    tm("text: section renamed", f"## {SECTION}\n", "## Envelope Freshness\n")
    tm("text: checker path renamed", "`scripts/check-gateway-replay-vectors-v2` shares",
       "`scripts/check-gateway-replay-vector-v2` shares")
    tm("text: generator path renamed", "`scripts/generate-gateway-replay-vectors-v2` reproduces",
       "`scripts/generate-gateway-replay-vector-v2` reproduces")
    sec = sections(text)["Replay vectors"]
    joined = "\n".join(sec)
    blocks = re.findall(r"^- .*(?:\n  .*)*", joined, re.M)
    for blk in blocks:
        label = flat(blk)[2:42]
        tm(f"text: bullet deleted: {label}…", blk + "\n", "")
        reworded = blk.replace(" and ", " or ", 1) if " and " in blk else blk.replace(
            ":", ": also", 1) if blk.startswith("- `") else blk + " too"
        tm(f"text: bullet reworded: {label}…", blk, reworded)

    survived = 0
    for label, make in cases:
        got = outcome(*make())
        if got is None if base is None else got == base:
            print(f"SURVIVED {label}")
            survived += 1
    print(f"{len(cases)} mutants, {len(cases) - survived} refused, {survived} survived")
    for e in equivalent:
        print(f"not a mutant: {e}")
    return survived


def main(argv: list[str]) -> int:
    if argv not in ([], ["--mutations"], ["--inventory"]):
        print(__doc__)
        return 2
    text = CONTRACT.read_text(encoding="utf-8")
    if argv == ["--inventory"]:
        print_inventory(text, json.loads(STATUS.read_text(encoding="utf-8")))
        return 0
    corpus = json.loads(CORPUS.read_text(encoding="utf-8"))
    failed = outcome(text, corpus)
    if failed is None:
        events = sum(len(c["events"]) for c in corpus["cases"])
        print(f"gateway-api/v2 replay corpus: {len(corpus['cases'])} cases, {events} "
              f"events replayed from the contract; {len(COVERAGE)} cover bullets shown")
    else:
        print(f"gateway-api/v2 replay corpus: {failed}")
    if argv == ["--mutations"]:
        survived = mutations(text, corpus)
        if survived < 0:
            return 1
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    return 0 if failed is None else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
