"""Check the gateway-api/v2 replay corpus against the contract.

Shares no code with scripts/generate-gateway-replay-vectors-v2, and was written
without reading it. The order of checks, their bounds and their reason names
are read from gateway-api/v2.md Envelope Freshness and Replay; every case is
replayed here under the section's rules and compared event by event.

Held to:

- the text: the section's subsections, the order-of-checks table (four rows,
  numbered in order, inclusive bounds, one reason each), the retention bounds,
  the floor, start, eviction and rotation sentences, the event list and the
  "cases cover" list, each word for word; the two script paths exist;
- the header: contract, section, the reasons in the table's order, unique
  case names;
- every event: its reason (receive, authenticate and commit only; null when
  accepted), the floor after it and the keys held after it, as the replay
  here decides them;
- coverage: every "cases cover" bullet is shown by events whose structure
  shows it, never by a case's name.
- one place for replay claims: every other section of gateway-api/v2.md whose
  own body touches replay, freshness, staleness, skew, signing time, capture or
  retransmission, the replay-settings obligation in runtime-config/v2.md and
  the notes in status/gateway-api/v2.json are held sentence by sentence;
  `--inventory` prints the held digests from the files as they stand.

    python3 scripts/check-gateway-replay-vectors-v2
    python3 scripts/check-gateway-replay-vectors-v2 --mutations
    python3 scripts/check-gateway-replay-vectors-v2 --inventory
"""

from __future__ import annotations

import copy
import hashlib
import json
import pathlib
import re
import sys
from typing import Callable

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "gateway-api" / "v2.md"
CORPUS = ROOT / "gateway-api" / "vectors" / "replay-v2.json"
RUNTIME_CONFIG = ROOT / "runtime-config" / "v2.md"
STATUS = ROOT / "status" / "gateway-api" / "v2.json"
SECTION = "Envelope Freshness and Replay"
SUBSECTIONS = ("Order of checks", "Retention", "The floor", "What the floor costs",
               "Recovery", "Senders", "Limits and later versions", "Replay vectors")
GENERATOR = "scripts/generate-gateway-replay-vectors-v2"
CHECKER = "scripts/check-gateway-replay-vectors-v2"

# Sentences each rule of the replay below rests on, held word for word
# (whitespace collapsed). A data check cannot see any of them change.
HELD = {
    "": (
        "This section alone states what replay protection achieves. Every other "
        "section names an envelope's key and refers here, and whatever this contract "
        "says replay protection stops, it stops outside the cases "
        "[Limits and later versions](#limits-and-later-versions) names.",
        "**The skew** is the receiver's maximum clock skew, never negative;",
    ),
    "Order of checks": (
        "is accepted only if every check holds, in this order. It is refused for "
        "the first that fails:",
        "Every bound is inclusive.",
        "An accepted envelope's key is held from then on.",
        "in one atomic step with recording, so a key dropped and a floor raised in "
        "between are both seen. The key's receipt time is the time it was "
        "authenticated.",
        "A recorded key is never un-recorded: a receiver that recorded it and then did "
        "not act on the envelope still holds it, and the sender's next attempt is newly "
        "signed, as [Senders](#senders) requires.",
    ),
    "Retention": (
        "A held key may be dropped only once both hold:",
    ),
    "The floor": (
        "**A dropped key raises the floor.** Dropping a key raises `F` to at least its "
        "`signed_at_ms` + 1,",
        "in the same atomic step, so no verification sees the key gone and the "
        "floor not yet raised.",
        "A receiver whose memory is full may drop the held key with the smallest "
        "signing time, any one of several that share it, before its retention ends, "
        "by the same step, instead of refusing the new envelope.",
        "**The stored floor never falls,** except under [Recovery](#recovery).",
        "**At every start,** `F` becomes the greater of the floor the receiver "
        "stored, if any, and its clock at that start. A receiver that stores its "
        "floor stores its held keys with it, and keeps both across a restart; one "
        "that stores neither starts each run with no stored floor and no held keys, "
        "so from its clock. A restart discards every authentication not yet recorded.",
        "**Only a floor raised by a dropped key is stored,** never a clock reading.",
        "The start rule covers keys dropped while no floor was kept, for envelopes "
        "signed before that start:",
        "Because it takes the greater of the two values, a floor stored before a "
        "rollback can never lower the floor at the next start. A start floor is not "
        "stored, so it covers its own run only;",
        "Every key dropped under the narrower skew raised the floor past its envelope, "
        "so the wider skew readmits none of them. A clock stepped back, live or across "
        "a start, is covered for every key whose drop raised the stored floor, because "
        "the stored floor does not follow the clock down.",
    ),
    "What the floor costs": (
        "**An eviction** raises the floor past the evicted envelope, which may have "
        "been signed up to `S` ahead of the clock.",
        "across a restart too when the floor is stored. A gateway's floor covers every "
        "runtime it serves,",
        "Whenever a receiver refuses an envelope as `before_replay_floor` while `F` > "
        "`t` − `S`, it logs a warning naming `F` and `t`.",
        "It also shows the condition in its own health, which it can do without hearing "
        "from the other party, once its health names a field for it: a gateway in its "
        "operational posture, and a runtime under "
        "[runtime-health/v4.md](../runtime-health/v4.md). Until then its log is the "
        "only record.",
    ),
    "Recovery": (
        "The receiver may drop its stored floor and every held key, and discard every "
        "authentication not yet recorded, which leaves `F` at its clock, only in one "
        "atomic step with switching to a new secret generation, under new key "
        "material, in which no earlier secret verifies, including any configured "
        "previous secret.",
        "Nothing signed before it verifies after it, so the reset readmits nothing.",
        "A receiver cannot tell new key material from a retired secret brought back, so "
        "an operator MUST NOT bring back a secret retired by a rotation that reset the "
        "floor, in any later configuration, as the current secret or the previous one: "
        "doing so readmits envelopes signed under it that were dropped at the reset.",
        "No verification under the retired generation commits after the switch.",
        "An ordinary rotation, with the earlier secret kept as the previous one, "
        "keeps the floor and every held key.",
        "No other path lowers the stored floor, and no command clears it.",
    ),
    "Senders": (
        "Every sender signs a fresh envelope for every message it publishes, including "
        "every retry and every redelivery. A fresh envelope is one whose bytes the "
        "sender has never published: re-signing unchanged content at an unchanged "
        "`signed_at_ms` gives identical bytes, so reading the clock again is not "
        "enough when it has not moved. A sender that may sign the same content twice "
        "in one millisecond, or across a restart with its clock unchanged or set back, "
        "takes `signed_at_ms` from a signing clock that never repeats a value: one "
        "millisecond past the previous when the clock has not moved, and durable "
        "across a restart, as [Outbound acknowledgement](#outbound-acknowledgement) "
        "requires of the gateway's acknowledgements. It never republishes envelope "
        "bytes it has already published. A refusal for any reason above is answered, "
        "if at all, by a newly signed attempt.",
        "the receiver's deduplication of content is unchanged.",
    ),
    "Limits and later versions": (
        "signed at or after that start, and the receiver kept no copy of its key. It "
        "can then be replayed after the start until it goes stale, at most `S` past its "
        "signing time.",
        "This version accepts the gap.",
        "**A clock stepped back across a later start reopens what only a start floor "
        "covered.** A start floor is a clock reading and is not stored. For a receiver "
        "that stores nothing, a clock stepped back across a restart readmits every "
        "envelope of earlier runs that its new skew window reaches.",
        "The floor gives no complete replay protection across the loss of a stored "
        "floor,",
    ),
    "Replay vectors": (
        "Each case is a receiver context and a run of events in order.",
        "The context gives the skew, `replay_ttl_ms` or `null`, whether the receiver "
        "stores its floor and keys, the floor it has stored, its clock at its last "
        "start, and the keys it holds, each with its signing and receipt times.",
        "Each event gives its reason, or none when accepted, and the floor and held "
        "keys after it.",
    ),
}
EVENTS = (
    (("receive",), "the receiver verifies an envelope and, when it is accepted, holds its key."),
    (("authenticate", "commit"), "a family that records only once the envelope answers something."),
    (("prune",), "the receiver drops every key whose retention has ended."),
    (("evict",), "a full receiver drops its held key with the smallest signing time."),
    (("restart",), "the receiver starts again, with a new skew where the case gives one."),
    (("rotate",), "a rotation that keeps the previous secret, or one that keeps none."),
)
B_FLOOR = "an envelope signed exactly at the floor, and one millisecond below it"
B_SKEW = "both skew bounds and one millisecond beyond each"
B_TTL = ("a replay at the last millisecond its envelope passes check 1, under a "
         "`replay_ttl_ms` shorter than the skew, and under a longer one")
B_SENDERS = "senders whose clocks run ahead of and behind the receiver's, across a start"
B_CLOCK = ("the clock stepped forward and back, live and across a start, and stepped "
           "back across a later start, by a receiver that stores nothing and by a "
           "storing receiver after an upgrade")
B_SKEWCHG = "the skew raised and lowered across a restart"
B_RESTART = ("a restart that stores its floor and keys, one that stores neither, the "
             "first start after an upgrade from a release that kept no floor, and a "
             "rollback and upgrade")
B_AUTH = "a key dropped between `authenticate` and `commit`"
B_EVICT = ("a full receiver evicting a key, and an evicted key signed ahead of the clock "
           "raising the stored floor above a sender behind it, across a restart")
B_ROTATE = "a rotation that keeps the previous secret and one that keeps none"
B_COMMIT = "a key recorded at commit, kept for `replay_ttl_ms` from its authentication"
B_PREC = ("precedence where two checks fail together: stale and below the floor, "
          "future and below the floor, and below the floor and held. Checks 1 and 2 "
          "cannot fail together")
OPS = {"≥": lambda a, b: a >= b, "≤": lambda a, b: a <= b,
       ">": lambda a, b: a > b, "<": lambda a, b: a < b}
INCLUSIVE = {"≥", "≤"}
RHS = {"`t` − `S`": "t-S", "`t` + `S`": "t+S", "`F`": "F"}


class Failure(Exception):
    pass


def flat(text: str) -> str:
    return " ".join(text.split())


# ---------------------------------------------------------------- the text

def sections(text: str) -> dict[str, list[str]]:
    lines = text.split("\n")
    try:
        start = lines.index(f"## {SECTION}")
    except ValueError:
        raise Failure(f"no '## {SECTION}' heading") from None
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")),
               len(lines))
    body = lines[start + 1:end]
    heads = [i for i, line in enumerate(body) if line.startswith("### ")]
    names = tuple(body[i][4:].strip() for i in heads)
    if names != SUBSECTIONS:
        raise Failure(f"subsections changed: {list(names)}")
    out = {"": body[:heads[0]]}
    for n, i in enumerate(heads):
        out[names[n]] = body[i + 1:heads[n + 1] if n + 1 < len(heads) else len(body)]
    return out


def bullets(lines: list[str], after: Callable[[str], bool]) -> list[str]:
    """The bullet list that follows the first line matching `after`."""
    at = next((i for i, line in enumerate(lines) if after(line)), None)
    if at is None:
        raise Failure("a list's lead-in line is gone")
    i = at + 1
    while i < len(lines) and not lines[i].strip():
        i += 1
    items: list[str] = []
    while i < len(lines) and lines[i].strip():
        line = lines[i]
        if line.startswith("- "):
            items.append(line[2:])
        elif line.startswith("  ") and items:
            items[-1] += " " + line.strip()
        else:
            raise Failure(f"unrecognised line in a list: {line!r}")
        i += 1
    return [flat(item) for item in items]


def contract_model(text: str) -> dict:
    sec = sections(text)
    norm = {name: flat("\n".join(lines)) for name, lines in sec.items()}
    for name, phrases in HELD.items():
        for phrase in phrases:
            if flat(phrase) not in norm[name]:
                raise Failure(f"{name}: rule text changed: {phrase!r}")

    # Order of checks: the table, its shape and its bounds.
    rows = [line for line in sec["Order of checks"] if line.startswith("|")]
    if len(rows) != 6 or rows[0] != "| Order | Check | Reason |" \
            or rows[1] != "| --- | --- | --- |":
        raise Failure("order-of-checks table changed shape")
    checks = []
    for n, row in enumerate(rows[2:], 1):
        m = re.fullmatch(r"\| (\d+) \| (.+?) \| `([a-z_]+)` \|", row)
        if not m:
            raise Failure(f"order-of-checks row unrecognised: {row!r}")
        if int(m.group(1)) != n:
            raise Failure(f"order-of-checks rows out of order at row {n}: {row!r}")
        cell, reason = m.group(2), m.group(3)
        if cell == "its key is not held":
            checks.append({"rhs": "held", "op": None, "reason": reason})
            continue
        b = re.fullmatch(r"`signed_at_ms` (≥|≤|>|<) (.+)", cell)
        if not b or b.group(2) not in RHS:
            raise Failure(f"order-of-checks check unrecognised: {cell!r}")
        if b.group(1) not in INCLUSIVE:
            raise Failure(f"'Every bound is inclusive' but row {n} reads {b.group(1)}")
        checks.append({"rhs": RHS[b.group(2)], "op": b.group(1), "reason": reason})
    if sorted(c["rhs"] for c in checks) != sorted(["t-S", "t+S", "F", "held"]):
        raise Failure("order-of-checks table does not name the four checks once each")
    if len({c["reason"] for c in checks}) != 4:
        raise Failure("order-of-checks reasons are not distinct")
    # The two skew bounds must face the right way for "within the skew".
    for c in checks:
        want = {"t-S": "≥", "t+S": "≤", "F": "≥"}.get(c["rhs"])
        if want and c["op"] != want:
            raise Failure(f"check against {c['rhs']} reads {c['op']}")
    m = re.search(r"It then makes checks (\d) and (\d) again when it records",
                  norm["Order of checks"])
    if not m:
        raise Failure("the recheck at recording is not stated as two numbered checks")
    recheck = (int(m.group(1)) - 1, int(m.group(2)) - 1)
    if {checks[i]["rhs"] for i in recheck} != {"F", "held"}:
        raise Failure("the checks rechecked at recording are not the floor and the key")

    # Retention: both bounds.
    r1 = re.search(r"- `t` (>|≥) `signed_at_ms` \+ `S`, so the envelope is stale;",
                   "\n".join(sec["Retention"]))
    r2 = re.search(r"- `t` (>|≥) its receipt time plus `gateway\.auth\.replay_ttl_ms`, "
                   r"where the receiver has that setting\.", norm["Retention"])
    if not r1 or not r2:
        raise Failure("retention bounds unrecognised")

    # The floor: what a drop raises it to.
    g = re.search(r"\*\*At every start,\*\* `F` becomes the (greater|lesser) of the floor "
                  r"the receiver stored, if any, and its clock at that start\.",
                  norm["The floor"])
    if not g:
        raise Failure("the start rule is unrecognised")
    d = re.search(r"Dropping a key raises `F` to at least its `signed_at_ms` \+ (\d+), "
                  r"in the same atomic step", norm["The floor"])
    if not d:
        raise Failure("the floor raise on a drop is unrecognised")

    # Replay vectors: the event list, the cover list, the scripts.
    rv = sec["Replay vectors"]
    events = []
    for item in bullets(rv, lambda line: line.rstrip().endswith("The events are:")):
        m = re.fullmatch(r"((?:`[a-z]+`(?: and |, )?)+): (.+)", item)
        if not m:
            raise Failure(f"event bullet unrecognised: {item!r}")
        events.append((tuple(re.findall(r"`([a-z]+)`", m.group(1))), m.group(2)))
    if tuple(events) != EVENTS:
        raise Failure(f"event list changed: {events}")
    cover = [b.rstrip(";.") for b in bullets(rv, lambda line: line.strip() == "The cases cover:")]
    if len(cover) != len(set(cover)) or set(cover) != set(COVERAGE):
        unknown = [b for b in cover if b not in COVERAGE]
        gone = [b for b in COVERAGE if b not in cover]
        raise Failure(f"cover list changed: unrecognised {unknown}, missing {gone}")
    # Bullet B_TTL names check 1 as the stale bound.
    if checks[0]["rhs"] != "t-S":
        raise Failure("a cover bullet names check 1 for the stale bound, which it no longer is")
    if {checks[0]["rhs"], checks[1]["rhs"]} != {"t-S", "t+S"}:
        raise Failure("a cover bullet says checks 1 and 2 cannot fail together; they are no "
                      "longer the two skew bounds")
    rvn = norm["Replay vectors"]
    if "[vectors/replay-v2.json](vectors/replay-v2.json) holds this section's cases." not in rvn:
        raise Failure("the corpus path changed")
    for path, claim in ((GENERATOR, "reproduces the file byte for byte."),
                        (CHECKER, "shares no code with it:")):
        if f"`{path}` {claim}" not in rvn:
            raise Failure(f"the claim for {path} changed")
        if not (ROOT / path).is_file():
            raise Failure(f"{path} named by the section does not exist")

    return {"checks": checks, "recheck": recheck,
            "stale_op": r1.group(1), "ttl_op": r2.group(1), "raise_by": int(d.group(1)),
            "start": max if g.group(1) == "greater" else min}


# ---------------------------------------------------------------- the inventory
# Whatever this contract says replay protection stops is stated in this section
# alone. Every other section whose own body touches replay, freshness,
# staleness, skew, signing time, capture or retransmission is held sentence by
# sentence, in order, as the SHA-256 of each sentence (whitespace collapsed),
# so an added, removed or changed sentence fails and is printed. A section that
# starts touching those stems fails until it is added here.
# `--inventory` prints the block below from the files as they stand.

STEMS = re.compile(r"replay|fresh|stale|skew|signed_at|captur|resubmi|redeliver|retransmi",
                   re.I)
RUNTIME_BULLET = (
    "- Read `gateway.auth.max_clock_skew_ms`, `gateway.auth.replay_ttl_ms` and "
    "`gateway.auth.persistent_replay_cache` under "
    "[gateway-api/v2.md](../gateway-api/v2.md#envelope-freshness-and-replay). "
    "`replay_ttl_ms` is a lower bound on how long a replay key is kept after receipt. "
    "A key is also kept until its envelope is stale, so no value of it opens a replay "
    "window. `persistent_replay_cache` stores the replay floor with the keys, and a "
    "runtime that stores neither starts each run from its clock."
)


def sentences(text: str) -> list[str]:
    return [x for x in re.split(r"(?<=[.!?])\s+", flat(text)) if x]


def digest(sentence: str) -> str:
    return hashlib.sha256(sentence.encode("utf-8")).hexdigest()[:16]


def guarded_sections(text: str) -> dict[str, list[str]]:
    """Each section's own body (to the next heading of any level), by heading,
    for every section outside this one whose body touches the stems."""
    lines, fence, heads = text.split("\n"), False, []
    for i, line in enumerate(lines):
        if line.startswith("```"):
            fence = not fence
        elif not fence and re.match(r"#{1,6} ", line):
            heads.append(i)
    out: dict[str, list[str]] = {}
    inside = False
    for n, i in enumerate(heads):
        head = lines[i]
        if head.startswith("## "):
            inside = head == f"## {SECTION}"
        if inside:
            continue
        end = heads[n + 1] if n + 1 < len(heads) else len(lines)
        body = "\n".join(lines[i + 1:end])
        if STEMS.search(body):
            if head in out:
                raise Failure(f"two guarded sections share the heading {head!r}")
            out[head] = sentences(body)
    return out


def status_notes(status: dict) -> dict[str, list[str]]:
    out = {"notes": sentences(status["notes"])}
    for n, entry in enumerate(status["adoption"]):
        out[f"adoption[{n}] {entry['repository']} {entry['role']}"] = sentences(entry["notes"])
    return out


def compare(where: str, held: tuple[str, ...], now: list[str]) -> None:
    got = [digest(x) for x in now]
    if tuple(got) == held:
        return
    i = next((k for k in range(min(len(got), len(held))) if got[k] != held[k]),
             min(len(got), len(held)))
    if len(got) > len(held) and got[i + 1:] == list(held[i:]):
        raise Failure(f"{where}: sentence {i + 1} added: {now[i]!r}")
    if len(got) < len(held) and got[i:] == list(held[i + 1:]):
        raise Failure(f"{where}: sentence {i + 1} removed (now before {now[i]!r})"
                      if i < len(now) else f"{where}: its last sentence removed")
    raise Failure(f"{where}: sentence {i + 1} changed: "
                  f"{now[i]!r}" if i < len(now) else f"{where}: sentences removed")


def check_inventory(text: str, runtime_config: str, status: dict) -> None:
    now = guarded_sections(text)
    if set(now) != set(INVENTORY):
        raise Failure(f"guarded sections changed: new {sorted(set(now) - set(INVENTORY))}, "
                      f"gone {sorted(set(INVENTORY) - set(now))}")
    for head, held in INVENTORY.items():
        compare(f"gateway-api/v2.md {head}", held, now[head])
    notes = status_notes(status)
    if set(notes) != set(STATUS_NOTES):
        raise Failure(f"status/gateway-api/v2.json notes changed: {sorted(notes)}")
    for key, held in STATUS_NOTES.items():
        compare(f"status/gateway-api/v2.json {key}", held, notes[key])
    rc = re.search(r"^## Consumer Obligations\n(.*?)^## ", runtime_config, re.S | re.M)
    if not rc:
        raise Failure("runtime-config/v2.md: no Consumer Obligations section")
    items = [flat(b) for b in re.findall(r"^- .*(?:\n  .*)*", rc.group(1), re.M)]
    if items.count(RUNTIME_BULLET) != 1:
        raise Failure("runtime-config/v2.md: the replay settings bullet changed")
    others = [b for b in items if b != RUNTIME_BULLET and STEMS.search(b)]
    if others:
        raise Failure(f"runtime-config/v2.md: another obligation touches replay: {others[0]!r}")


def print_inventory(text: str, status: dict) -> None:
    def block(name: str, table: dict[str, list[str]]) -> None:
        print(f"{name} = {{")
        for key, now in table.items():
            print(f"    {key!r}: (")
            hs = [digest(x) for x in now]
            for k in range(0, len(hs), 4):
                print("        " + " ".join(f'"{h}",' for h in hs[k:k + 4]))
            print("    ),")
        print("}")
    print("# BEGIN INVENTORY")
    block("INVENTORY", guarded_sections(text))
    block("STATUS_NOTES", status_notes(status))
    print("# END INVENTORY")


# BEGIN INVENTORY
