                       ("an HTML comment", f"<!-- {rule} -->"),
                       ("a fenced fake heading", f"```\n## Notes\n```\n\n{rule}"),
                       ("a block quote", f"> {rule}"),
                       ("a footnote", f"[^r]: {rule}"),
                       ("an indented code block", f"    {rule}"),
                       ("a deeper heading", f"#### Note\n\n{rule}")):
        om(f"closed: {label} at the section's end", lambda x, blk=blk: x[:x.index(
            end, sec_at)] + "\n\n" + blk + "\n" + x[x.index(end, sec_at):])
    om("closed: the section heading a second time", lambda x: x.replace(
        "## Producer Time\n", f"## {SECTION}\n\n{rule}\n\n## Producer Time\n", 1))
    tm("structure: a reset step dedented to a fourth way", "  - the receiver is stopped,",
       "- the receiver is stopped,")
    tm("structure: the restart nested under wait", "- **Restart a receiver that stores "
       "nothing", "  - **Restart a receiver that stores nothing")
    tm("structure: a paragraph indented into code", "\nReplacing a receiver's whole state "
       "store", "\n    Replacing a receiver's whole state store")
    tm("structure: a setext heading", "the ones declared.\n\n---", "the ones declared.\n---")
    tm("structure: two paragraphs merged", "wait is too long.\n\nReplacing", "wait is too "
       "long.\nReplacing")
    for head in [f"## {SECTION}"] + [f"### {n}" for n in SUBSECTIONS]:
        tm(f"closed: a sentence added under {head}", f"{head}\n\n",
           f"{head}\n\nA receiver may lower its floor.\n\n")
    # The posture record sits outside this section's scope; a sentence bringing it in, or
    # dropping the sentence that keeps it out, is a change to every section held.
    tm("inventory: the posture record brought under replay",
       "does\nnot apply to it;", "applies to it as well;")
    tm("inventory: a posture record sentence added",
       "publishes nothing on this topic.",
       "publishes nothing on this topic. Its receiver holds its signed_at_ms as a floor.")

    # Mutants of what the replay reads from the text: refused with the held and
    # closed sentences switched off too, so the model refuses them itself.
    parsed = re.compile(r"text: (table rows|checks \d|reason \S+ renamed|\d [≥≤] |retention|"
                        r"recheck|drop raises by 2|start takes the lesser)")
    base_model = outcome(text, corpus, guard=False)
    survived = 0
    for label, make in cases:
        got = outcome(*make())
        if got is None if base is None else got == base:
            print(f"SURVIVED {label}")
            survived += 1
        elif parsed.match(label) and outcome(*make(), guard=False) == base_model:
            print(f"SURVIVED by the held text only {label}")
            survived += 1
    for label, new in benign:
        got = outcome(text.replace(flow, new, 1), corpus)
        if got != base:
            print(f"REFUSED A BENIGN EDIT {label}: {got}")
            survived += 1
    print(f"{len(cases)} mutants, {len(cases) - survived} refused, {survived} survived")
    for e in equivalent:
        print(f"not a mutant: {e}")
    return survived


def main(argv: list[str]) -> int:
    if argv not in ([], ["--mutations"], ["--inventory"]):
        print(__doc__)
        return 2
    text = CONTRACT.read_text(encoding="utf-8")
    if argv == ["--inventory"]:
        print_inventory(text, json.loads(STATUS.read_text(encoding="utf-8")))
        return 0
    corpus = json.loads(CORPUS.read_text(encoding="utf-8"))
    failed = outcome(text, corpus)
    if failed is None:
        events = sum(len(c["events"]) for c in corpus["cases"])
        print(f"gateway-api/v2 replay corpus: {len(corpus['cases'])} cases, {events} "
              f"events replayed from the contract; {len(COVERAGE)} cover bullets shown")
    else:
        print(f"gateway-api/v2 replay corpus: {failed}")
    if argv == ["--mutations"]:
        survived = mutations(text, corpus)
        if survived < 0:
            return 1
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    return 0 if failed is None else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
