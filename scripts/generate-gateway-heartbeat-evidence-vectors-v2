"""Generate the gateway-api/v2 runtime node heartbeat evidence-block corpus.

Nothing here is shared with scripts/check-gateway-heartbeat-evidence-vectors-v2,
which reads each member's bound from the contract's evidence table and judges
every case itself.

    python3 scripts/generate-gateway-heartbeat-evidence-vectors-v2          # write
    python3 scripts/generate-gateway-heartbeat-evidence-vectors-v2 --check  # reproduce
"""

from __future__ import annotations

import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "gateway-api" / "vectors" / "heartbeat-evidence-v2.json"

HEX64 = "0123456789abcdef" * 4

BASE = {
    "chain_head_hash": HEX64,
    "attestation_gap_count": 0,
    "available": True,
    "action_event_type": "SAFETY_ACTION_EXECUTED",
}

# (name, member, value, admitted, note). Each case is BASE with one member replaced.
CASES = (
    ("base", None, None, True, "every member within its bound"),
    # action_event_type: empty, or 1 to 64 characters from A-Z and _.
    ("event_type_empty", "action_event_type", "", True, "0 characters"),
    ("event_type_one", "action_event_type", "A", True, "1 character"),
    ("event_type_underscore_only", "action_event_type", "_", True, "an underscore alone"),
    ("event_type_64", "action_event_type", "A" * 63 + "_", True, "64 characters"),
    ("event_type_65", "action_event_type", "A" * 64 + "_", False, "65 characters"),
    ("event_type_lowercase", "action_event_type", "SAFETY_ACTION_EXECUTEd", False,
     "one lowercase character"),
    ("event_type_digit", "action_event_type", "TIER2_ACTION", False, "one digit"),
    ("event_type_hyphen", "action_event_type", "SAFETY-ACTION", False, "a hyphen"),
    ("event_type_space", "action_event_type", "SAFETY ACTION", False, "a space"),
    ("event_type_non_ascii", "action_event_type", "SAFETY_ACTIÖN", False,
     "a letter outside ASCII"),
    ("event_type_null", "action_event_type", None, False, "not a string"),
    ("event_type_number", "action_event_type", 7, False, "not a string"),
    # chain_head_hash: empty, or 64 lowercase hex characters.
    ("chain_head_empty", "chain_head_hash", "", True, "the empty string"),
    ("chain_head_63", "chain_head_hash", HEX64[:63], False, "63 hex characters"),
    ("chain_head_65", "chain_head_hash", HEX64 + "0", False, "65 hex characters"),
    ("chain_head_uppercase", "chain_head_hash", HEX64[:63].upper() + "F", False,
     "uppercase hex"),
    ("chain_head_non_hex", "chain_head_hash", HEX64[:63] + "g", False, "a character outside hex"),
    ("chain_head_null", "chain_head_hash", None, False, "not a string"),
    # attestation_gap_count: an int, at least 0.
    ("gap_count_positive", "attestation_gap_count", 7, True, "a positive count"),
    ("gap_count_negative", "attestation_gap_count", -1, False, "below 0"),
    ("gap_count_string", "attestation_gap_count", "0", False, "not an int"),
    ("gap_count_bool", "attestation_gap_count", False, False, "a bool, not an int"),
    # available: a bool.
    ("available_false", "available", False, True, "false"),
    ("available_string", "available", "true", False, "not a bool"),
    ("available_int", "available", 1, False, "an int, not a bool"),
)


def build() -> dict:
    cases = []
    for name, member, value, admitted, note in CASES:
        block = dict(BASE)
        if member is not None:
            block[member] = value
        cases.append({"name": name, "member": member, "note": note,
                      "evidence": block, "admitted": admitted})
    return {
        "vector_set": "gateway-api/v2 runtime node heartbeat evidence block",
        "contract": "gateway-api/v2.md",
        "section": "## Runtime Node Heartbeat Payload",
        "comment": ("Each case is the evidence block of an otherwise admissible runtime node "
                    "heartbeat, differing from the base case in at most one member, and whether "
                    "the gateway admits that heartbeat. Members are judged on their own; no case "
                    "tests how they relate."),
        "cases": cases,
    }


def render() -> str:
    return json.dumps(build(), indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    text = render()
    if sys.argv[1:] == ["--check"]:
        if not OUT.exists() or OUT.read_text(encoding="utf-8") != text:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from this generator", file=sys.stderr)
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces: {len(CASES)} cases")
        return 0
    if sys.argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.write_text(text, encoding="utf-8")
    print(f"wrote {OUT.relative_to(ROOT)}: {len(CASES)} cases")
    return 0


if __name__ == "__main__":
    sys.exit(main())
