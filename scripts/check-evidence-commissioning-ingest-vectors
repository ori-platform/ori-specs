#!/usr/bin/env python3
"""Check the commissioning-ingest vectors against evidence-commissioning-ingest/v1.

Independent of whatever produced the file: the key identifier is re-derived
with a hand-written HKDF, the HMAC preimage and signature are recomputed from
the contract's rules, every artifact digest is recomputed from the
evidence-exchange artifact it claims to carry, every revocation's Ed25519
signature is verified under the registry key it names and whether it is
permitted is recomputed from the registry's revocation relation, every
cancellation's signature is verified and whether it is permitted is recomputed
from the registry's cancellation designation, and the negative-case set is held
to the contract's refusal table, read from the contract text.

    python3 scripts/check-evidence-commissioning-ingest-vectors
    python3 scripts/check-evidence-commissioning-ingest-vectors --mutations

`--mutations` flips each cancellation verdict, alters each signed body, flips
each registry designation, drops each required refusal, and rewords or
re-statuses the contract rules the model reads, and requires every mutant to be
refused.

Requires the `cryptography` package for Ed25519 verification; the check refuses
to run without it rather than skipping the signature.
"""

from __future__ import annotations

import base64
import hashlib
import hmac
import json
import pathlib
import re
import sys

try:
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey,
        Ed25519PublicKey,
    )
except ImportError:  # pragma: no cover - the gate must not pass silently
    print(
        "check-evidence-commissioning-ingest-vectors: the cryptography package is required",
        file=sys.stderr,
    )
    sys.exit(1)

ROOT = pathlib.Path(__file__).resolve().parent.parent
VECTORS = ROOT / "evidence-commissioning-ingest" / "vectors" / "ingest-auth.json"
EXCHANGE = ROOT / "evidence-exchange" / "vectors" / "commissioning-authorization.json"
PATH = "/v1/evidence/commissioning/artifacts"
SALT = b"ori.commissioning_ingest_key_id.v1"
INFO = b"commissioning_ingest"
REQUEST_DOMAIN = b"ori.commissioning_ingest_request.v1\x00"
REVOCATION_DOMAIN = b"ori.evidence_commissioning_revocation.v1\x00"
REVOCATION_FIELDS = {
    "v",
    "commissioning_digest",
    "key_id",
    "actor",
    "reason",
    "revoked_at_ms",
    "signature",
}
REQUIRED_NEGATIVES = {
    "body_substitution": ("refused_before_key_lookup", 401),
    "wrong_purpose_secret": ("unknown_key", 401),
    "nonce_replay": ("replay", 401),
    "key_not_permitted": ("key_not_permitted", 403),
    "unknown_commissioning_key": ("unknown_commissioning_key", 422),
    "self_authorised": ("self_authorised", 422),
    "wrong_type_for_body": ("malformed", 400),
    "courier_artifact_here": ("malformed", 400),
    "revocation_by_unrelated_key": ("revocation_not_permitted", 422),
    "unknown_authorisation_revocation": ("unknown_authorisation", 422),
    "resubmission_after_revocation": ("revoked", 409),
    "fresh_retry": ("same_semantic_response", 200),
    "cancellation_by_undesignated_key": ("cancellation_not_permitted", 422),
    "cancellation_by_retired_key": ("unknown_commissioning_key", 422),
    "cancellation_of_held_authorisation": ("authorisation_held", 409),
    "cancellation_for_another_epoch": ("cancellation_mismatch", 422),
    "authorisation_after_cancellation": ("cancelled", 409),
    "repeated_cancellation": ("same_semantic_response", 200),
    "cancellation_id_reused": ("cancellation_id_reused", 409),
    "cancellation_for_an_unrelated_issuer": ("cancellation_not_permitted", 422),
    "authorisation_with_inconsistent_issuer": ("cancellation_issuer_mismatch", 409),
}
CANCELLATION_DOMAIN = b"ori.evidence_commissioning_cancellation.v1\x00"
CANCELLATION_FIELDS = {
    "v",
    "device_id",
    "anchor_epoch_id",
    "commissioning_digest",
    "expected_authorisation_key_id",
    "cancellation_id",
    "reason",
    "issued_at_ms",
    "key_id",
    "signature",
}
CONTRACT = ROOT / "evidence-commissioning-ingest" / "v1.md"
# Rules the cancellation model below hard-codes; rewording one changes this checker.
REQUIRED_SENTENCES = (
    (
        "A cancellation is permitted when `expected_authorisation_key_id` names an active or retained "
        "commissioning-authority registry entry and that entry's `pending_cancellation_key_ids` contains the "
        "cancellation's signing `key_id`."
    ),
    "Neither the cancellation signer's own entry nor the transport credential can confer this relation.",
    (
        "a signing key the registry holds only as a retired tombstone verifies nothing and cannot sign a new "
        "cancellation, and is refused `422 unknown_commissioning_key`."
    ),
    (
        "The resulting tombstone binds `(commissioning_digest, device_id, anchor_epoch_id, "
        "expected_authorisation_key_id)`."
    ),
    (
        "If an authorisation later arrives with that digest but names another commissioning key, the authority "
        "refuses it `409 cancellation_issuer_mismatch`, the refusal-table row for exactly that case, rather than "
        "treating the cancellation as authority over that other key."
    ),
    (
        "An authorisation whose digest is tombstoned under a different expected_authorisation_key_id is refused "
        "`409 cancellation_issuer_mismatch`."
    ),
    (
        "That `503` is an internal-invariant failure only: a conforming authority never reaches it, it is not "
        "backpressure, and no caller action repairs it."
    ),
    (
        "The authority promotes nothing, keeps the tombstone, records the inconsistency, and returns a terminal "
        "decision."
    ),
    (
        "Repair requires a newly issued authorisation with a new digest and a fresh reference; the tombstoned "
        "digest never revives."
    ),
    (
        "Designating a recovery key therefore grants denial authority over pending references in its issuer "
        "scope; registry operators MUST treat it as such."
    ),
    (
        "`registration` is `applied` when retaining this authorisation promoted a registration in the same "
        "transaction, `awaiting_registration` when none was held, `cancelled` when this cancellation removed a "
        "pending registration,"
    ),
)


def refusal_table(text: str) -> dict[str, int]:
    """The contract's refusal table, reason to HTTP status."""
    start = text.find("| Condition | HTTP | `reason` |")
    if start < 0:
        fail("evidence-commissioning-ingest/v1.md no longer carries its refusal table")
    table: dict[str, int] = {}
    for line in text[start:].splitlines()[2:]:
        if not line.startswith("|"):
            break
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) != 3 or not cells[1].isdigit() or not cells[2].startswith("`"):
            fail(f"refusal table row is not condition | status | `reason`: {cells}")
        table[cells[2].strip("`")] = int(cells[1])
    return table


class Failure(Exception):
    pass


def fail(message: str) -> None:
    raise Failure(message)


def canonical(obj: object) -> bytes:
    return json.dumps(
        obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False
    ).encode("utf-8")


def digest(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def hkdf_sha256(ikm: bytes, salt: bytes, info: bytes, length: int) -> bytes:
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    out, block, counter = b"", b"", 1
    while len(out) < length:
        block = hmac.new(prk, block + info + bytes([counter]), hashlib.sha256).digest()
        out += block
        counter += 1
    return out[:length]


def check_submission(
    label: str,
    submission: dict,
    secret: str,
    key_id: str,
    artifact_type: str,
    body: bytes,
) -> None:
    if submission["artifact_hex"] != body.hex():
        fail(f"{label}: artifact_hex does not reproduce the artifact's canonical bytes")
    if submission["artifact_digest"] != digest(body):
        fail(f"{label}: artifact_digest does not match the body")
    request = submission["request"]
    if (
        request["method"] != "POST"
        or request["path"] != PATH
        or request["artifact_type"] != artifact_type
    ):
        fail(f"{label}: request names the wrong method, path or type")
    metadata = {
        "artifact_digest": submission["artifact_digest"],
        "artifact_type": artifact_type,
        "client_id": request["client_id"],
        "key_id": key_id,
        "method": "POST",
        "nonce": request["nonce"],
        "path": PATH,
        "sent_at_ms": request["sent_at_ms"],
    }
    if len(request["nonce"]) != 32 or any(
        c not in "0123456789abcdef" for c in request["nonce"]
    ):
        fail(f"{label}: nonce is not 32 lowercase hex characters")
    if submission["canonical_metadata"] != canonical(metadata).decode("utf-8"):
        fail(f"{label}: canonical_metadata does not reproduce")
    preimage = REQUEST_DOMAIN + canonical(metadata)
    if submission["hmac_preimage_hex"] != preimage.hex():
        fail(f"{label}: hmac_preimage_hex does not reproduce")
    expected = (
        "Ori-Commissioning-HMAC hmac-sha256:"
        + hmac.new(secret.encode("utf-8"), preimage, hashlib.sha256).hexdigest()
    )
    if submission["expected_authorization"] != expected:
        fail(f"{label}: expected_authorization does not reproduce")
    if (
        submission["expected"]["http"] != 200
        or submission["expected"]["outcome"] != "accepted"
    ):
        fail(f"{label}: a valid submission must be accepted")


def check(doc: dict, contract: str) -> None:
    """Hold one corpus to one contract text; raise Failure on the first unmet rule."""
    if doc:
        with EXCHANGE.open(encoding="utf-8") as handle:
            exchange = json.load(handle)
        cases = {case["name"]: case for case in exchange["cases"]}
        secret = doc["secret"]
        if len(secret.encode("utf-8")) < 32:
            fail("the published secret is shorter than 256 bits")
        if doc["key_purpose"] != "commissioning_ingest":
            fail("key_purpose must be commissioning_ingest")
        key_id = (
            "hkdf-sha256:" + hkdf_sha256(secret.encode("utf-8"), SALT, INFO, 16).hex()
        )
        if doc["key_id"] != key_id:
            fail(
                "key_id does not derive from the secret under the contract's salt and info"
            )
        credential = doc["credential"]
        if not credential["permitted_commissioning_key_ids"]:
            fail("the credential permits no commissioning key")

        valid = canonical(cases["valid"]["artifact"])
        check_submission(
            "authorisation_submission",
            doc["authorisation_submission"],
            secret,
            key_id,
            "commissioning_authorization",
            valid,
        )
        if (
            cases["valid"]["artifact"]["key_id"]
            not in credential["permitted_commissioning_key_ids"]
        ):
            fail("the valid authorisation's key_id is not permitted for the credential")
        if (
            doc["authorisation_submission"]["expected"]["registration"]
            != "awaiting_registration"
        ):
            fail("an authorisation retained with no registration held awaits one")

        registry = {entry["key_id"]: entry for entry in doc["commissioning_registry"]}
        issuing = cases["valid"]["artifact"]["key_id"]
        if registry[issuing]["public_key_hex"] != exchange["signing_key_public_hex"]:
            fail(
                "the registry's issuing key is not the exchange's published commissioning key"
            )
        if any(e["purpose"] != "commissioning_authority" for e in registry.values()):
            fail("every registry entry must hold a commissioning_authority key")
        if not registry[issuing]["revocation_key_ids"]:
            fail(
                "the issuing key designates no revocation key, so the recovery case cannot exist"
            )

        def verify_revocation(label: str, revocation: dict) -> None:
            if set(revocation) != REVOCATION_FIELDS:
                fail(f"{label}: revocation fields are {sorted(revocation)}")
            if revocation["commissioning_digest"] != digest(valid):
                fail(
                    f"{label}: the revocation does not name the valid authorisation's digest"
                )
            signer = registry.get(revocation["key_id"])
            if signer is None:
                fail(f"{label}: revocation names a key the registry does not hold")
            body = {k: v for k, v in revocation.items() if k != "signature"}
            signature = revocation["signature"]
            if not signature.startswith("ed25519:"):
                fail(f"{label}: revocation signature is not ed25519:")
            public = Ed25519PublicKey.from_public_bytes(
                bytes.fromhex(signer["public_key_hex"])
            )
            try:
                public.verify(
                    base64.b64decode(signature[len("ed25519:") :], validate=True),
                    REVOCATION_DOMAIN + canonical(body),
                )
            except (InvalidSignature, ValueError) as exc:
                fail(
                    f"{label}: revocation signature does not verify under {revocation['key_id']} ({exc.__class__.__name__})"
                )

        def permitted(revocation: dict) -> bool:
            return (
                revocation["key_id"] == issuing
                or revocation["key_id"] in registry[issuing]["revocation_key_ids"]
            )

        revocation = doc["revocation_submission"]["artifact"]
        verify_revocation("revocation_submission", revocation)
        if revocation["key_id"] != issuing:
            fail("revocation_submission must be signed by the issuing key")
        check_submission(
            "revocation_submission",
            doc["revocation_submission"],
            secret,
            key_id,
            "commissioning_revocation",
            canonical(revocation),
        )

        outcomes = {}
        for case in doc["revocation_cases"]:
            label = f"revocation_cases/{case['name']}"
            if case["authenticator"] != "valid":
                fail(
                    f"{label}: every revocation case must verify so the permission rule is reached"
                )
            verify_revocation(label, case["artifact"])
            if case["signer_key_id"] != case["artifact"]["key_id"]:
                fail(f"{label}: signer_key_id disagrees with the artifact")
            if case["artifact_hex"] != canonical(case["artifact"]).hex():
                fail(f"{label}: artifact_hex does not reproduce")
            if (
                case["artifact"]["key_id"]
                not in credential["permitted_commissioning_key_ids"]
            ):
                fail(
                    f"{label}: the credential does not permit the signer, so the permission rule is not what refuses it"
                )
            expected = (
                ("accept", None)
                if permitted(case["artifact"])
                else ("reject", "revocation_not_permitted")
            )
            if (case["expected"], case["reject_reason"]) != expected:
                fail(
                    f"{label}: expects {(case['expected'], case['reject_reason'])}, the registry relation gives {expected}"
                )
            if "request" in case:
                check_submission(
                    label,
                    {**case, "expected": {"http": 200, "outcome": "accepted"}},
                    secret,
                    key_id,
                    "commissioning_revocation",
                    canonical(case["artifact"]),
                )
            outcomes[case["name"]] = case["expected"]
        for name, expected in (
            ("by_issuing_key", "accept"),
            ("by_designated_recovery_key", "accept"),
            ("by_unrelated_held_key", "reject"),
        ):
            if outcomes.get(name) != expected:
                fail(f"revocation_cases must carry {name} as {expected}")
        signers = {case["artifact"]["key_id"] for case in doc["revocation_cases"]}
        if len(signers) != len(doc["revocation_cases"]):
            fail("revocation cases must each be signed by a different key")
        if doc["revocation_submission"]["expected"]["registration"] != "not_applicable":
            fail("a revocation carries registration not_applicable")
        if (
            doc["authorisation_submission"]["request"]["nonce"]
            == doc["revocation_submission"]["request"]["nonce"]
        ):
            fail("the two submissions reuse a nonce")

        prose = " ".join(contract.split())
        for sentence in REQUIRED_SENTENCES:
            if " ".join(sentence.split()) not in prose:
                fail(f"the contract no longer states, word for word: {sentence[:70]!r}; change this checker with it")
        table = refusal_table(contract)

        def verify_cancellation(label: str, cancellation: dict) -> None:
            if set(cancellation) != CANCELLATION_FIELDS:
                fail(f"{label}: cancellation fields are {sorted(cancellation)}")
            signer = registry.get(cancellation["key_id"])
            if signer is None:
                fail(f"{label}: cancellation names a key the registry does not hold")
            body = {k: v for k, v in cancellation.items() if k != "signature"}
            seed = doc["commissioning_key_seeds_hex"][cancellation["key_id"]]
            if signer["status"] == "retired":
                # A tombstone holds no public key, so the verifier is never reached;
                # the seed still produced a well-formed signature for the case.
                if signer["public_key_hex"] is not None:
                    fail(f"{label}: a retired registry entry must hold no public key")
                public_hex = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(seed)).public_key().public_bytes_raw().hex()
            else:
                public_hex = signer["public_key_hex"]
            try:
                Ed25519PublicKey.from_public_bytes(bytes.fromhex(public_hex)).verify(
                    base64.b64decode(cancellation["signature"][len("ed25519:"):], validate=True),
                    CANCELLATION_DOMAIN + canonical(body),
                )
            except (InvalidSignature, ValueError) as exc:
                fail(f"{label}: cancellation signature does not verify ({exc.__class__.__name__})")

        def cancellation_outcome(cancellation: dict) -> tuple[str, str | None]:
            signer = registry[cancellation["key_id"]]
            if signer["status"] == "retired":
                return "reject", "unknown_commissioning_key"
            issuer = registry.get(cancellation["expected_authorisation_key_id"])
            if issuer is not None and cancellation["key_id"] in issuer["pending_cancellation_key_ids"]:
                return "accept", None
            return "reject", "cancellation_not_permitted"

        submission = doc["cancellation_submission"]
        verify_cancellation("cancellation_submission", submission["artifact"])
        if cancellation_outcome(submission["artifact"]) != ("accept", None):
            fail("cancellation_submission must be signed by a key the registry designates for cancellation")
        check_submission(
            "cancellation_submission", submission, secret, key_id, "commissioning_cancellation",
            canonical(submission["artifact"]),
        )
        if submission["expected"].get("registration") != "cancelled":
            fail("a cancellation that removes a pending registration answers registration cancelled")
        if submission["request"]["nonce"] in (
            doc["authorisation_submission"]["request"]["nonce"], doc["revocation_submission"]["request"]["nonce"]
        ):
            fail("the cancellation submission reuses a nonce")
        cancellation_outcomes = {}
        for case in doc["cancellation_cases"]:
            label = f"cancellation_cases/{case['name']}"
            verify_cancellation(label, case["artifact"])
            if case["signer_key_id"] != case["artifact"]["key_id"]:
                fail(f"{label}: signer_key_id disagrees with the artifact")
            if case["artifact_hex"] != canonical(case["artifact"]).hex():
                fail(f"{label}: artifact_hex does not reproduce")
            if case["artifact"]["key_id"] not in credential["permitted_commissioning_key_ids"]:
                fail(f"{label}: the credential does not permit the signer, so the permission rule is not what refuses it")
            expected = cancellation_outcome(case["artifact"])
            if (case["expected"], case["reject_reason"]) != expected:
                fail(f"{label}: expects {(case['expected'], case['reject_reason'])}, the registry relation gives {expected}")
            wanted_auth = "not_reached" if expected[1] == "unknown_commissioning_key" else "valid"
            if case["authenticator"] != wanted_auth:
                fail(f"{label}: authenticator must be {wanted_auth}")
            cancellation_outcomes[case["name"]] = case["expected"]
        for name, expected in (
            ("by_designated_cancellation_key", "accept"),
            ("by_designated_key_for_an_unrelated_issuer", "reject"),
            ("by_issuing_key_not_designated", "reject"),
            ("by_unrelated_held_key", "reject"),
            ("by_retired_designated_key", "reject"),
        ):
            if cancellation_outcomes.get(name) != expected:
                fail(f"cancellation_cases must carry {name} as {expected}")
        if issuing in registry[issuing]["pending_cancellation_key_ids"]:
            fail("the issuing key must not list itself, or the issuing-key case proves nothing")
        if "comm-retired-1" not in registry[issuing]["pending_cancellation_key_ids"]:
            fail("the retired key must be designated, so that retirement alone refuses it")

        negatives = {case["name"]: case for case in doc["negative_cases"]}
        for name, (reason, http) in REQUIRED_NEGATIVES.items():
            if reason in table and table[reason] != http:
                fail(f"{name}: the contract refuses {reason} with {table[reason]}, this checker expects {http}")
        for reason in ("cancellation_not_permitted", "cancellation_mismatch", "authorisation_held", "cancelled",
                       "cancellation_id_reused", "cancellation_issuer_mismatch"):
            if reason not in table:
                fail(f"the contract's refusal table no longer carries {reason}")
        if set(negatives) != set(REQUIRED_NEGATIVES):
            fail(
                f"negative cases are {sorted(negatives)}; the contract requires {sorted(REQUIRED_NEGATIVES)}"
            )
        for name, (expected, http) in REQUIRED_NEGATIVES.items():
            case = negatives[name]
            if case["expected"] != expected or case["http"] != http:
                fail(
                    f"{name}: expects {case['expected']}/{case['http']}, the contract says {expected}/{http}"
                )
        if (
            negatives["revocation_by_unrelated_key"]["revocation_case"]
            != "by_unrelated_held_key"
        ):
            fail(
                "revocation_by_unrelated_key must point at the unrelated-key revocation case"
            )
        for name, source in (
            ("unknown_commissioning_key", "unknown_key_id"),
            ("self_authorised", "self_authorised_by_device_key"),
        ):
            if negatives[name]["artifact_digest"] != digest(
                canonical(cases[source]["artifact"])
            ):
                fail(
                    f"{name}: artifact_digest does not name the exchange's {source} artifact"
                )
            if cases[source]["expected"] != "reject":
                fail(f"{name}: the exchange case it reuses is not a rejection")
        for name, case_name in (
            ("cancellation_by_undesignated_key", "by_unrelated_held_key"),
            ("cancellation_for_an_unrelated_issuer", "by_designated_key_for_an_unrelated_issuer"),
            ("cancellation_by_retired_key", "by_retired_designated_key"),
        ):
            pointed = next((c for c in doc["cancellation_cases"] if c["name"] == case_name), None)
            if negatives[name].get("cancellation_case") != case_name or pointed is None:
                fail(f"{name} must point at the {case_name} cancellation case")
            if pointed["reject_reason"] != negatives[name]["expected"]:
                fail(f"{name}: the cancellation case it points at is refused for another reason")


def mutants(doc: dict, contract: str):
    """Corpus and contract edits, each of which a conforming checker refuses."""
    for i, case in enumerate(doc["cancellation_cases"]):
        bad = json.loads(json.dumps(doc))
        bad["cancellation_cases"][i]["expected"] = "accept" if case["expected"] == "reject" else "reject"
        yield f"cancellation case {case['name']} verdict flipped", bad, contract
        bad = json.loads(json.dumps(doc))
        bad["cancellation_cases"][i]["artifact"]["reason"] += "."
        yield f"cancellation case {case['name']} signed body altered", bad, contract
    issuers = {c["artifact"]["expected_authorisation_key_id"] for c in doc["cancellation_cases"]}
    for i, entry in enumerate(doc["commissioning_registry"]):
        if entry["key_id"] not in issuers:
            # Only the expected issuer's entry confers the relation; any other
            # entry's list is inert, which the unrelated-key case shows.
            continue
        bad = json.loads(json.dumps(doc))
        designated = bad["commissioning_registry"][i]["pending_cancellation_key_ids"]
        bad["commissioning_registry"][i]["pending_cancellation_key_ids"] = (
            [] if "comm-recovery-1" in designated else ["comm-recovery-1", "comm-key-1", "comm-key-2"])
        yield f"registry designation of {entry['key_id']} changed", bad, contract
    for name in REQUIRED_NEGATIVES:
        bad = json.loads(json.dumps(doc))
        bad["negative_cases"] = [c for c in doc["negative_cases"] if c["name"] != name]
        yield f"without negative {name}", bad, contract
    bad = json.loads(json.dumps(doc))
    bad["cancellation_submission"]["expected"]["registration"] = "not_applicable"
    yield "cancellation submission answers not_applicable", bad, contract
    for sentence in REQUIRED_SENTENCES:
        pattern = r"\s+".join(re.escape(w) for w in sentence.split())
        edited, count = re.subn(pattern, sentence.rsplit(" ", 1)[0].replace("\\", "\\\\"), contract, count=1)
        yield f"contract sentence reworded: {sentence[:40]!r}", doc, edited if count else contract + "\x00"
    for reason, status in (("cancellation_not_permitted", "422"), ("authorisation_held", "409"),
                           ("cancellation_mismatch", "422"), ("cancelled", "409"),
                           ("cancellation_id_reused", "409"), ("cancellation_issuer_mismatch", "409")):
        other = "409" if status == "422" else "422"
        edited = contract.replace(f"| {status} | `{reason}` |", f"| {other} | `{reason}` |")
        yield f"contract refuses {reason} at {other}", doc, edited
        yield f"contract drops {reason}", doc, "\n".join(
            line for line in contract.splitlines() if f"`{reason}` |" not in line)


def main() -> int:
    try:
        with VECTORS.open(encoding="utf-8") as handle:
            doc = json.load(handle)
        contract = CONTRACT.read_text(encoding="utf-8")
        check(doc, contract)
        if "--mutations" in sys.argv[1:]:
            survived, total = [], 0
            for label, bad, text in mutants(doc, contract):
                total += 1
                try:
                    check(bad, text)
                except (Failure, KeyError, ValueError):
                    continue
                survived.append(label)
            if survived:
                for label in survived:
                    print(f"mutant survived: {label}", file=sys.stderr)
                return 1
            print(f"commissioning-ingest mutations: {total} refused")
    except Failure as failure:
        print(
            f"check-evidence-commissioning-ingest-vectors: {failure}", file=sys.stderr
        )
        return 1
    except (KeyError, OSError, ValueError) as exc:
        print(
            f"check-evidence-commissioning-ingest-vectors: corpus is malformed ({exc!r})",
            file=sys.stderr,
        )
        return 1
    print(
        f"check-evidence-commissioning-ingest-vectors: corpus agrees with the contract ({len(REQUIRED_NEGATIVES)} refusals, "
        f"{len(doc['revocation_cases'])} revocation and {len(doc['cancellation_cases'])} cancellation signers covered)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
