    }


PHONE = "+2348000000000"
SUBORDINATE = "ori-fw-7c9f2b3a"


def rich_health() -> dict:
    """A whole snapshot carrying every local-only member, served consistently."""
    h = full_health()
    h["last_alert_timestamps"] = {"by_channel": {"sms": 1716999000000},
                                  "by_trigger": {"dangerous_overcurrent": 1716999000000}}
    h["remote_command_lockout"]["enforcement_enabled"] = True
    h["remote_command_lockout"]["senders"] = [{
        "channel": "sms", "from_number": PHONE, "risk_level": "critical", "locked_out": True,
        "enforcement_enabled": True, "incident_count": 4, "rejection_count": 9,
        "window_ms": 3600000, "checked_at_ms": 1716999000000, "reason": "rejection_volume",
        "stale": False}, {
        "channel": "whatsapp", "from_number": "+2348000000001", "risk_level": "normal",
        "locked_out": False, "enforcement_enabled": True, "incident_count": 0,
        "rejection_count": 1, "window_ms": 3600000, "checked_at_ms": 1716999000000,
        "reason": "", "stale": False}]
    h["commissioning"]["last_verdict"] = {"stage": "verify", "reason": "signature_invalid",
                                          "binding_seq": 2, "at_ms": 1716990000000}
    h["firmware_liveness"] = {
        "state": "available", "loop": "running", "started_age_ms": 600000, "interval_ms": 15000,
        "per_device_timeout_ms": 5000, "max_concurrent": 8, "expiry_window_ms": 60000,
        "supervised_devices": 2, "supported_device_capacity": 16,
        "worst_case_device_latency_ms": 5000, "consecutive_tick_failures": 0,
        "last_successful_tick_age_ms": 1000, "expiring_device_ids": [SUBORDINATE],
        "degraded": True}
    h["firmware_reading_age"] = {"state": "available", "signing_runtime": True, "devices": [
        {"device_id": "ori-fw-00000000",
         "latest_reading": {"key_epoch_id": "epoch-1", "boot_id": 3, "seq": 88},
         "liveness_bound": "unbounded"},
        {"device_id": SUBORDINATE,
         "latest_reading": {"key_epoch_id": "epoch-1", "boot_id": 41, "seq": 1207},
         "liveness_bound": {"name": "runtime liveness bound", "age_upper_ms": 1500,
                            "as_of_ms": 1717000000000}}]}
    profiles = profiles_block([1, 3])
    profiles["documents_refused"] = [{"file": "broken-profile.json",
                                      "reason": "invalid_profile_document"}]
    h["firmware_controller_profiles"] = profiles
    h["diagnostics"] = {
        "firmware_mqtt_operator": {"socket_path": "/var/lib/ori/data/firmware-mqtt.sock"},
        "firmware_liveness": {"last_error": "TimeoutError: publish timed out"}}
    folded = fold(holding(h))
    h.update(folded)
    return h


BLOCK_MEMBERS = {
    "capability_posture": ["state", "available", "sms_available", "whatsapp_available",
                           "gateway_reachable", "local_slm_loaded", "relay_connected",
                           "internet_available", "checked_at_ms", "expires_at_ms",
                           "gateway_last_heartbeat_ms"],
    "device_policy": ["state", "enabled", "available", "policy_held", "policy_version", "tier",
                      "relay_b_enabled", "relay_c_enabled", "cloud_llm_enabled",
                      "alert_sms_monthly_cap", "alert_whatsapp_monthly_cap", "expiry",
                      "valid_until", "issued_at", "is_expired"],
    "alert_outbox": ["state", "backlog_count", "tier_d_unresolved_count", "tier_d_max_attempts",
                     "tier_d_oldest_age_ms", "tier_d_age_bound_ms", "oldest_non_tier_d_age_ms",
                     "overdue_bound_ms", "oldest_queued_original_ts", "oldest_queued_at_ms",
                     "oldest_queued_age_ms", "retry_interval_minutes", "max_non_tier_d_attempts",
                     "tier_d_critical_warning_threshold", "batch_size"],
    "gateway_broker_posture": ["state", "available", "gateway_enabled", "deployment_check",
                               "anonymous_access", "acl_policy", "require_credentials",
                               "credentials_configured", "requires_acl_hardening"],
    "state_store_encryption": ["state", "available", "mode", "satisfied", "marker_configured",
                               "path_prefix_configured"],
    "evidence": list(evidence_available()),
    "action_log_records": ["state", "pending", "oldest_pending_age_ms", "ceiling", "lost",
                           "stall_bound_ms", "decision_records_lost", "loss_incidents"],
    "commissioning": ["state", "binding_seq", "binding_hash", "anchors_configured",
                      "actuation_licensed", "problems", "zones", "last_verdict"],
    "safety_registry": ["state", "trip_verification_deadline_ms"],
    "community_skills": ["state", "anchor_usable", "refused_skills"],
    "config_authority": ["state", "signature_required", "signature_verified", "dotenv_loaded",
                         "unsigned_value_source"],
    "skill_hooks": ["state", "required_unavailable", "optional_unavailable"],
    "telemetry_export": ["state", "transport_available", "suspended", "queued_events",
                         "retained_events", "dropped_events", "unconfirmed_events",
                         "declined_events", "refused_events"],
}
SENSOR_MEMBERS = ["id", "type", "protocol", "poll_interval_ms", "connection", "connected",
                  "last_seen_ms", "stale", "measurement_degraded", "consecutive_refusals"]


def keep(block: dict, members: list[str]) -> dict:
    return {k: copy_value(block[k]) for k in members if k in block}


def copy_value(value):
    return json.loads(json.dumps(value))


def project(h: dict) -> dict:
    """The remote health projection: an allowlist, never the snapshot less some fields."""
    out = {"projection": "runtime-health/v4/remote"}
    for key in ("device_id", "uptime_s", "status", "critical", "degradation_reasons"):
        out[key] = copy_value(h[key])
    out["unknown_critical_blocks"] = sorted(
        name for name in CRITICAL_CAPABLE if h[name]["state"] == "unavailable")
    for name, members in BLOCK_MEMBERS.items():
        out[name] = keep(h[name], members)
    verdict = out["commissioning"].get("last_verdict")
    if isinstance(verdict, dict):
        out["commissioning"]["last_verdict"] = {"binding_seq": verdict["binding_seq"],
                                                "at_ms": verdict["at_ms"]}
    out["sensors"] = [keep(s, SENSOR_MEMBERS) for s in h["sensors"]]
    out["safety_zones"] = copy_value(h["safety_zones"])
    out["last_alert_timestamps"] = {"by_channel": copy_value(
        h["last_alert_timestamps"]["by_channel"])}
    lock = h["remote_command_lockout"]
    out["remote_command_lockout"] = keep(lock, ["state", "enforcement_enabled", "risk_window_ms",
                                                "stale_after_ms", "incident_sender_limit"])
    if lock["state"] == "available":
        out["remote_command_lockout"]["sender_count"] = len(lock["senders"])
        out["remote_command_lockout"]["locked_out_sender_count"] = sum(
            1 for s in lock["senders"] if s["locked_out"])
    fl = h["firmware_liveness"]
    out["firmware_liveness"] = {k: copy_value(v) for k, v in fl.items()
                                if k != "expiring_device_ids"}
    if fl["state"] == "available":
        out["firmware_liveness"]["expiring_device_count"] = len(fl["expiring_device_ids"])
    ra = h["firmware_reading_age"]
    out["firmware_reading_age"] = keep(ra, ["state", "signing_runtime"])
    if ra["state"] == "available":
        out["firmware_reading_age"]["device_count"] = len(ra["devices"])
        out["firmware_reading_age"]["unbounded_device_count"] = sum(
            1 for d in ra["devices"] if d["liveness_bound"] == "unbounded")
    cp = h["firmware_controller_profiles"]
    out["firmware_controller_profiles"] = keep(cp, ["state", "documents_held"])
    if cp["state"] == "available":
        chans = cp["alarm_channels"]
        out["firmware_controller_profiles"].update(
            documents_refused_count=len(cp["documents_refused"]),
            alarm_channel_count=len(chans),
            alarm_as_of_count=sum(1 for c in chans if c["state"] == "as_of"),
            alarm_unknown_count=sum(1 for c in chans if c["state"] == "unknown"))
    return out


def projection_cases() -> list[dict]:
    rich = rich_health()
    local = [PHONE, "+2348000000001", "signature_invalid", SUBORDINATE, "ori-fw-00000000", "/var/lib/ori", "TimeoutError",
             "/run/ori/health.sock", "dangerous_overcurrent", "broken-profile.json"]
    cases = [("whole_healthy", full_health(), "every block as a healthy runtime serves it"),
             ("every_local_only_member", rich,
              ("senders, subordinate identities, refused files, trigger names, paths and "
               "exception text, none of which may leave the socket"))]
    hung = full_health()
    hung["skill_hooks"] = {"state": "unavailable"}
    hung["alert_outbox"] = {k: hung["alert_outbox"][k] for k in (
        "retry_interval_minutes", "max_non_tier_d_attempts",
        "tier_d_critical_warning_threshold", "batch_size", "tier_d_age_bound_ms",
        "overdue_bound_ms")}
    hung["alert_outbox"]["state"] = "unavailable"
    hung.update(fold(holding(hung)))
    cases.append(("unknown_critical_blocks", hung,
                  "two critical-capable blocks unreadable, named by block"))
    malformed = full_health()
    malformed["status"] = "warning"
    cases.append(("snapshot_fails_triple_check", malformed,
                  "the minimal projection, nothing else from the snapshot"))
    out = []
    for name, h, note in cases:
        runtime = {"device_id": "ori-runtime-configured"}
        projected = project(h) if triple_check(h) is None else {
            "projection": "runtime-health/v4/remote", "device_id": runtime["device_id"],
            "status": C, "critical": True, "degradation_reasons": [INVALID]}
        text = json.dumps(projected, ensure_ascii=False)
        assert not any(s in text for s in local), name
        case = {"name": name, "snapshot": h, "expected": projected,
                "must_not_contain": [s for s in local if s in json.dumps(h)],
                "note": note}
        if triple_check(h) is not None:
            assert runtime["device_id"] != h["device_id"]
            case["runtime"] = runtime
        out.append(case)
    return out


def heartbeat_full(h: dict, unservable: bool, runtime: dict) -> tuple[str | None, dict]:
    step = triple_check(h) or ("snapshot_unservable" if unservable else None)
    hb = {"device_id": runtime["device_id"], "last_seen_ms": runtime["now_ms"],
          "gateway_seen_ms": 0, "active_triggers": []}
    if step is not None:
        hb.update(status=C, degradation_reasons=[INVALID])
        return step, hb
    hb["status"] = "healthy" if h["status"] == "ok" else h["status"]
    if h["degradation_reasons"]:
        hb["degradation_reasons"] = list(h["degradation_reasons"])
    ev = h["evidence"]
    if ev["state"] == "available" and ev["attestation_summary_available"]:
        hb["evidence"] = {"chain_head_hash": ev["chain_head_hash"],
                          "attestation_gap_count": ev["attestation_gap_count"],
                          "available": True, "action_event_type": ev["action_event_type"]}
    return None, hb


def heartbeat_snapshot_cases() -> list[dict]:
    runtime = {"device_id": "site-a-edge-01", "now_ms": 1717000000000, "auth_enabled": False}
    with_evidence = full_health()
    with_evidence["evidence"] = evidence_available()
    unread = full_health()
    unread["evidence"] = evidence_available()
    unread["evidence"]["attestation_summary_available"] = False
    for k in ("last_attested_action_id", "attestation_gap_count", "status_counts",
              "contributor_links_unresolved"):
        del unread["evidence"][k]
    unread.update(fold(holding(unread)))
    over = full_health()
    over["alert_outbox"]["backlog_count"] = 9007199254740992
    specs = [
        ("healthy_evidence_disabled", full_health(), False,
         "healthy; evidence disabled, so no evidence block"),
        ("healthy_evidence_available", with_evidence, False,
         "the evidence block from the snapshot's own rows"),
        ("attestation_summary_unread", unread, False,
         "no evidence block, never zeros; the snapshot names subsystem_state_unknown"),
        ("critical_with_local_only_members", rich_health(), False,
         "nothing local-only reaches the heartbeat"),
        ("integer_the_socket_refuses", over, True,
         "a snapshot the socket would refuse is malformed for the heartbeat too"),
    ]
    out = []
    for name, h, unservable, note in specs:
        step, hb = heartbeat_full(h, unservable, runtime)
        out.append({"name": name, "snapshot": h, "runtime": runtime, "failed_step": step,
                    "expected": hb, "note": note})
    return out


def build() -> bytes:
    corpus = {
        "contract": "ori-specs/runtime-health/v4.md",
        "version": 4,
        "comment": (
            "Golden vectors for runtime-health/v4 Severity, Heartbeat Mapping, Request and "
            "Representation, and for the gateway-api/v2 runtime node heartbeat "
            "degradation_reasons validation as runtime-health/v4 amends it. A 'snapshot' "
            "carries only the members the condition table reads; every other member of the "
            "payload is out of scope here; a response_cases response is whole. In "
            "heartbeat_cases an absent "
            "'degradation_reasons' in 'expected' means the heartbeat omits the field. In "
            "request_cases each entry of 'writes_hex' is one client write, delivered in "
            "order; 'after' is what the client does once they are sent. A "
            "conforming implementation reproduces every 'expected'."),
        "conditions": {t: (C if t == INVALID else SEVERITY.get(t)) for t in VOCAB},
        "heartbeat_only": [INVALID],
        "max_reasons": MAX_REASONS,
        "fold_cases": fold_cases(),
        "snapshot_cases": snapshot_cases(),
        "served_cases": served_cases(),
        "heartbeat_cases": heartbeat_cases(),
        "fallback_heartbeat_case": fallback_heartbeat_case(),
        "response_cases": response_cases(),
        "projection_cases": projection_cases(),
        "heartbeat_snapshot_cases": heartbeat_snapshot_cases(),
        "unrepresentable_cases": unrepresentable_cases(),
        "gateway_reason_cases": gateway_cases(),
        "request_cases": request_cases(),
        "integer_cases": integer_cases(),
        "expiry_cases": expiry_cases(),
    }
    return (json.dumps(corpus, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = build()
    if argv == ["--check"]:
        if not OUT.exists() or OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator")
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv:
        print(__doc__)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)} sha256 {hashlib.sha256(data).hexdigest()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
