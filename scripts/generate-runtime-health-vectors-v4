         "no status member"),
        ("status_healthy", ok, {"status": "healthy", "critical": False, "degradation_reasons": []},
         "the heartbeat's word is not a local status"),
        ("status_not_string", ok, {"status": 0, "critical": False, "degradation_reasons": []},
         "status must be a string"),
        ("critical_true_beside_degraded", crit, {**good_c, "status": D},
         "critical true beside degraded is checked before reasons"),
        ("critical_absent", crit, {k: good_c[k] for k in ("status", "degradation_reasons")},
         "no critical member"),
        ("critical_false_on_critical", crit, {**good_c, "critical": False},
         "critical must follow status"),
        ("critical_string", ok, {"status": "ok", "critical": "false", "degradation_reasons": []},
         "critical must be a boolean"),
        ("reasons_absent", ok, {"status": "ok", "critical": False}, "no reasons member"),
        ("reasons_null", ok, {"status": "ok", "critical": False, "degradation_reasons": None},
         "null is not the empty set"),
