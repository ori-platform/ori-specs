         "one attempt, at the age bound"),
        ("tier_d_alert_under_thresholds", [
            (("alert_outbox", "tier_d_unresolved_count"), 1),
            (("alert_outbox", "tier_d_max_attempts"), 2),
            (("alert_outbox", "tier_d_oldest_age_ms"), 299999)],
         "under both thresholds: not yet critical"),
        ("alert_under_overdue_bound", [(("alert_outbox", "oldest_non_tier_d_age_ms"), 3599999)],
         "a young alert, whatever the backlog"),
        ("alert_outbox_unavailable", [(("alert_outbox",), {"state": "unavailable"})],
         "alert delivery decides severity, so an unreadable outbox is unknown"),
        ("alert_outbox_starting", [(("alert_outbox",), {"state": "starting"})],
         "the store not yet opened"),
        ("skill_hooks_disabled", [(("skill_hooks",), {"state": "disabled"})],
         "no isolated hook worker"),
        ("decision_loss_acknowledged", losses(incident("decision_record_lost", True)),
         "acknowledged: still listed and counted, no longer named"),
        ("decision_loss_after_restart", losses(incident("decision_record_lost")),
         "the persisted incident, reported again after a restart with its severity"),
        ("acknowledged_loss_beside_unacknowledged", losses(
            incident("decision_record_lost", True),
            incident("decision_record_lost", iid="inc-0003", count=2)),
         "an acknowledgement resolves only its own incident"),
        ("acknowledged_loss_beside_trip", losses(incident("decision_record_lost", True)) +
         SINGLE["safety_zone_trip_unresolved"],
         "an acknowledgement clears no other condition"),
        ("loss_incidents_unreadable", [((AL,), {"state": "unavailable"})],
         "persisted incidents that cannot be read: unknown, never clean counters"),
        ("liveness_clean_stop", [((FL, "loop"), "stopped_cleanly"),
                                 ((FL, "expiring_device_ids"), ["ori-fw-7c9f2b3a"]),
                                 ((FL, "supervised_devices"), 17),
                                 ((FL, "consecutive_tick_failures"), 2)],
         "an orderly shutdown owes no liveness"),
