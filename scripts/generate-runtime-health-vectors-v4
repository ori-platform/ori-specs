         "pending verification inside the deadline"),
        ("trip_verified", TRIPPED + [
            (("safety_zones", 0, "command_status"), "command_issued"),
            (("safety_zones", 0, "effect_verified"), "matched")],
         "a verified trip is resolved and protected"),
        ("trip_refused_while_pending_ratification", TRIPPED + [
