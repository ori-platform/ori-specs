    """An available profiles block with one as_of alarm channel: word 0b1011."""
    digest = "sha256:99563dd574a24b1530350600e7c0a668b0afca0df46da165d30dcbb7e7297c01"
    return {
        "state": "available",
        "documents_held": [{"id": "example-rectifier", "digest": digest}],
        "documents_refused": [],
        "alarm_channels": [{
            "device_id": "ori-fw-7c9f2b3a", "channel": "alarm0", "state": "as_of",
            "reading": {
                "key_epoch_id": "epoch-1", "boot_id": 41, "seq": 1207,
                "receiver_accepted_at_ms": 1716999990000, "word": 11,
                "profile": {"controller_profile_id": "example-rectifier", "digest": digest,
                            "profile_channel": "alarm_word_1"},
                "profile_status": "usable", "liveness_bound": "unbounded"},
            "asserted": [{"id": "rectifier_fault", "meaning": "Rectifier fault"}],
            "not_asserted_at_that_poll": ["mains_failure"],
            "unmapped_set_bits": unmapped}],
    }


