            ("diagnostics",), {"safety": []})),
         "type_invalid", "each namespace's value is an object"),
        ("capability_posture_unavailable", envelope_text(edited(
            ("capability_posture",), {"state": "unavailable", "available": False})),
         "accept", "decides no severity"),
        ("device_policy_unavailable", envelope_text(edited(
            ("device_policy",), {"state": "unavailable", "enabled": True, "available": False})),
         "accept", "decides no severity"),
        ("alert_outbox_unavailable", envelope_text(served(
            [(("alert_outbox",), {"state": "unavailable", "tier_d_age_bound_ms": 300000,
                                  "overdue_bound_ms": 3600000, "retry_interval_minutes": 0.5,
                                  "max_non_tier_d_attempts": 10,
                                  "tier_d_critical_warning_threshold": 3, "batch_size": 50})],
            "critical", ["subsystem_state_unknown_critical"])),
         "accept", "the outbox can raise a critical condition, so unreadable is critical"),
        ("trip_age_null_while_tripped", envelope_text(served(
            [(("safety_registry",), {"state": "available",
                                     "trip_verification_deadline_ms": 10000}),
             (("safety_zones",), [zone_entry(trip_age_ms=None)])], "ok", [])),
         "shape_invalid", "a tripped pair must carry its trip age"),
        ("trip_deadline_over_ceiling", envelope_text(served(
            [(("safety_registry",), {"state": "available",
                                     "trip_verification_deadline_ms": 60001})], "ok", [])),
         "shape_invalid", "the deadline's ceiling is 60000"),
        ("trip_verified_whole", envelope_text(served(
            [(("safety_registry",), {"state": "available",
                                     "trip_verification_deadline_ms": 10000}),
             (("safety_zones",), [zone_entry(trip_age_ms=4000)])], "ok", [])),
         "accept", "a verified trip, served whole"),
        ("alert_bound_above_default", envelope_text(edited(
            ("alert_outbox", "overdue_bound_ms"), 3600001)),
         "shape_invalid", "a bound above its default is refused at load, never served"),
        ("alert_threshold_above_default", envelope_text(edited(
            ("alert_outbox", "tier_d_critical_warning_threshold"), 4)),
         "shape_invalid", "a threshold above its default"),
        ("loss_counter_not_sum", envelope_text(edited(("action_log_records", "lost"), 1)),
         "shape_invalid", "lost counted with no incident behind it"),
        ("acknowledged_without_time", envelope_text(served(
            [(("action_log_records", "loss_incidents"),
              [{**incident("decision_record_lost", True), "acknowledged_at_ms": None}]),
             (("action_log_records", "decision_records_lost"), 1)], "ok", [])),
         "shape_invalid", "acknowledged_at_ms is null only while unacknowledged"),
        ("incidents_out_of_order", envelope_text(served(
            [(("action_log_records", "loss_incidents"),
              [incident("decision_record_lost", True, iid="inc-0002"),
               incident("decision_record_lost", True, iid="inc-0001")]),
             (("action_log_records", "decision_records_lost"), 2)], "ok", [])),
         "shape_invalid", "incidents are ordered by incident_id"),
        ("acknowledged_incident_whole", envelope_text(served(
            [(("action_log_records", "loss_incidents"),
              [incident("decision_record_lost", True)]),
             (("action_log_records", "decision_records_lost"), 1)], "ok", [])),
         "accept", "an acknowledged incident, still counted, names nothing"),
        ("device_policy_none_held", envelope_text(edited(
            ("device_policy",), {"state": "available", "enabled": True, "available": True,
                                 "policy_held": False})),
         "accept", "enabled with no policy held is available, not unavailable"),
        ("broker_posture_unavailable", envelope_text(edited(
            ("gateway_broker_posture",), {"state": "unavailable", "available": False})),
         "accept", "decides no severity"),
        ("encryption_unavailable", envelope_text(edited(
            ("state_store_encryption",), {"state": "unavailable", "available": False})),
         "accept", "decides no severity"),
        ("disabled_block_with_member", envelope_text(edited(("firmware_liveness", "loop"),
                                                            "running")),
         "shape_invalid", "a disabled block carries only state"),
        ("status_without_reason", envelope_text(edited(("status",), "degraded")),
         "status_mismatch", "degraded while nothing holds"),
        ("critical_string", envelope_text(edited(("critical",), "false")),
         "critical_mismatch", "critical must be a boolean"),
    ]
    return [{"name": n, "response": text, "expected": v, "note": note}
            for n, text, v, note in specs]


def unrepresentable_cases() -> list[dict]:
    specs = [
        ("device_policy.valid_until", "9223372036854775807"),
        ("alert_outbox.backlog_count", "9007199254740992"),
        ("alert_outbox.backlog_count", "9007199254740991"),
        ("evidence.stopped_local_bytes", "18446744073709551616"),
        ("action_log_records.lost", "0"),
    ]
    return [{"member": m, "value": v,
             "expected": "serve" if 0 <= int(v) <= INT_MAX else "internal_error"}
            for m, v in specs]


# ── the remote health projection and whole-snapshot heartbeats ────────────────

