BLOCK_PATH = {"config_authority": ("config_authority",), "commissioning": ("commissioning",),
              "firmware_liveness": (FL,), "evidence.action_records": AR,
              "alert_outbox": ("alert_outbox",), "safety_registry": ("safety_registry",)}


def startup(not_ready: list[str], elapsed_ms: int, deadline_ms: int, extra: list) -> tuple:
    """A producer not yet ready on these blocks, resolved by the startup deadline."""
    state = "starting" if elapsed_ms < deadline_ms else "unavailable"
    edits = []
    for block in not_ready:
        if block.startswith("sensor:"):
            edits.append((("sensors", int(block[7:]), "connection"),
                          "pending" if state == "starting" else "unavailable"))
        elif block == "evidence":
            edits += [((EV, "state"), state), ((EV, "attestation_summary_available"), False),
                      ((EV, "registration_available"), False),
                      ((EV, "delivery_ledger_available"), False)]
            if state == "unavailable":
                edits.append(((EV, "posture_problems"), ["signing_unavailable"]))
        else:
            edits.append((BLOCK_PATH[block], {"state": state}))
            if block == "safety_registry":
                edits.append((("safety_zones",), []))
    return edits + extra, {"not_ready": not_ready, "elapsed_ms": elapsed_ms,
                           "deadline_ms": deadline_ms}


def startup_specs() -> list[tuple[str, list, dict, str]]:
    lost = losses(incident("decision_record_lost"))
    out = []
    for name, nr, el, dl, extra, note in [
        ("startup_config_within", ["config_authority"], 4000, 120000, [],
         "inside the deadline: initialising"),
        ("startup_config_under_deadline", ["config_authority"], 119999, 120000, [],
         "one millisecond before the deadline: still starting"),
        ("startup_config_at_deadline", ["config_authority"], 120000, 120000, [],
         "at the deadline: unavailable, a failure to read"),
        ("startup_config_past", ["config_authority"], 300000, 120000, [],
         "a hung initialisation never reads as benign"),
        ("startup_within_beside_critical", ["config_authority"], 4000, 120000, lost,
         "a known critical wins over starting"),
        ("startup_past_beside_critical", ["config_authority"], 300000, 120000, lost,
         "a known critical wins over unknown"),
        ("startup_sensor_within", ["sensor:2"], 4000, 120000, [], "an adapter still connecting"),
        ("startup_sensor_past", ["sensor:2"], 300000, 120000, [],
         "an adapter never connected, never attempted to a verdict"),
        ("startup_liveness_within", ["firmware_liveness"], 4000, 120000, [],
         "the liveness loop not yet started"),
        ("startup_liveness_past", ["firmware_liveness"], 300000, 120000, [],
         "the liveness loop never started"),
        ("startup_evidence_within", ["evidence"], 4000, 120000, [], "evidence not yet opened"),
        ("startup_evidence_past", ["evidence"], 300000, 120000, [],
         "evidence never opened: unknown, and a posture problem"),
        ("startup_alert_outbox_within", ["alert_outbox"], 4000, 120000, [],
         "a critical-capable block initialising"),
        ("startup_alert_outbox_past", ["alert_outbox"], 300000, 120000, [],
         "a critical-capable block hung past the deadline: critical visibility unavailable"),
        ("startup_registry_past", ["safety_registry"], 120000, 120000, [],
         "at the deadline, a required safety registry still not built"),
        ("startup_records_past", ["evidence.action_records", "commissioning"], 300000, 120000,
         [], "two blocks hung: one token"),
    ]:
        edits, inputs = startup(nr, el, dl, extra)
        out.append((name, edits, inputs, note))
    return out


def snapshot_cases() -> list[dict]:
    out = []
    for name, edits, note in snapshot_specs():
        v = view(*edits)
        f = fold(holding(v))
        out.append({"name": name, "snapshot": v, "expected": f, "note": note})
    for name, edits, inputs, note in startup_specs():
        v = view(*edits)
        out.append({"name": name, "startup": inputs, "snapshot": v,
                    "expected": fold(holding(v)), "note": note})
    return out


# ── served triples: snapshot checks 6 to 10 ──────────────────────────────────

ABSENT = object()


def check_served(v: dict, served: dict) -> str:
    st = served.get("status", ABSENT)
    if not isinstance(st, str) or st not in RANK:
        return "status_invalid"
    cr = served.get("critical", ABSENT)
    if not isinstance(cr, bool) or cr != (st == C):
        return "critical_mismatch"
    rs = served.get("degradation_reasons", ABSENT)
    if (not isinstance(rs, list) or len(rs) > MAX_REASONS
            or not all(isinstance(x, str) for x in rs)
            or rs != sorted(set(rs)) or any(x not in SNAPSHOT_VOCAB for x in rs)):
        return "reasons_malformed"
    want = fold(holding(v))
    if rs != want["degradation_reasons"]:
        return "reasons_mismatch"
    if st != want["status"]:
        return "status_mismatch"
    return "accept"


def served_cases() -> list[dict]:
    crit = view(*losses(incident("decision_record_lost")),
                (("commissioning", "problems"), ["binding_missing"]))
    deg = view(*SINGLE["sensor_unconnected"])
    ok = view()
    good_c = fold(holding(crit))
    good_d = fold(holding(deg))
    many = [VOCAB[i % len(VOCAB)] for i in range(33)]
    specs = [
        ("consistent_critical", crit, good_c, "the served triple is the fold"),
        ("consistent_degraded", deg, good_d, "one degraded condition"),
        ("consistent_ok", ok, {"status": "ok", "critical": False, "degradation_reasons": []},
         "nothing holds"),
        ("degraded_over_critical", crit, {**good_c, "status": D, "critical": False},
         "a later degraded assigned over a critical"),
