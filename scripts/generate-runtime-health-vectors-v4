}


def snapshot_specs() -> list[tuple[str, list, str]]:
    s = [("nothing_wrong", [], "every block available and nothing holds")]
    for token in SEVERITY:
        note = f"{token} alone"
        if token == "safety_zone_trip_unresolved":
            note += ", with the unprotected claim a refused trip implies"
        s.append((f"alone_{token}", SINGLE[token], note))
    s += [
        ("tick_age_at_window", [((FL, "last_successful_tick_age_ms"), 60000)],
         "an age equal to the expiry window is expired"),
        ("tick_age_under_window", [((FL, "last_successful_tick_age_ms"), 59999)],
         "one millisecond under the window is not stale"),
        ("no_tick_started_at_window", [((FL, "last_successful_tick_age_ms"), None),
                                       ((FL, "started_age_ms"), 60000)],
         "no tick has succeeded since a start one window ago"),
        ("no_tick_started_under_window", [((FL, "last_successful_tick_age_ms"), None),
                                          ((FL, "started_age_ms"), 59999)],
         "no tick yet, inside the first window"),
        ("stale_tick_after_clean_stop", [((FL, "loop"), "stopped_cleanly"),
                                         ((FL, "last_successful_tick_age_ms"), 900000)],
         "an orderly shutdown owes no tick"),
        ("liveness_starting", [((FL,), {"state": "starting"})],
         "a configured scheduler whose loop has not started is starting"),
        ("config_starting", [(("config_authority",), {"state": "starting"})],
         "the configuration not yet read"),
        ("commissioning_starting", [(("commissioning",), {"state": "starting"})],
         "commissioning not yet loaded"),
        ("skills_starting", [(("community_skills",), {"state": "starting"})],
         "skills not yet loaded"),
        ("registry_starting", [(("safety_registry",), {"state": "starting"}),
                               (("safety_zones",), [])],
         "a required registry not yet built"),
        ("action_log_starting", [((AL,), {"state": "starting"})], "no record writer yet"),
        ("action_records_starting", [(AR, {"state": "starting"})], "no dispatcher yet"),
        ("evidence_starting", [((EV, "state"), "starting"),
                               ((EV, "attestation_summary_available"), False),
                               ((EV, "registration_available"), False),
                               ((EV, "delivery_ledger_available"), False)],
         "enabled evidence not yet opened is starting, and its unread sections are not unknown"),
        ("every_sensor_pending", [(("sensors", i, "connection"), "pending") for i in range(3)],
         "no adapter connected yet"),
        ("starting_beside_critical", [(("config_authority",), {"state": "starting"})] +
         losses(incident("decision_record_lost")),
         "a known critical wins over starting"),
        ("starting_beside_unknown", [(("config_authority",), {"state": "starting"}),
                                     (("commissioning",), {"state": "unavailable"})],
         "initialisation and a failure to read are named apart"),
        ("pending_and_failed_sensors", [(("sensors", 0, "connection"), "pending"),
                                        (("sensors", 1, "connection"), "failed")],
         "one sensor still connecting, another failed"),
        ("stopped_with_stale_tick", [((FL, "loop"), "stopped_unexpectedly"),
                                     ((FL, "last_successful_tick_age_ms"), 120000)],
         "a dead loop past the window is both stopped and stale"),
        ("capacity_equal", [((FL, "supervised_devices"), 16)],
         "supervised equal to capacity is not over it"),
        ("over_capacity_and_tick_failures", [((FL, "supervised_devices"), 17),
                                             ((FL, "consecutive_tick_failures"), 3)],
         "both degraded liveness conditions stay degraded"),
        ("tick_failures_and_device_expired", [((FL, "consecutive_tick_failures"), 3),
                                              ((FL, "expiring_device_ids"), ["ori-fw-00000000"])],
         "a degraded liveness condition beside a critical one is critical"),
        ("all_liveness", [((FL, "loop"), "stopped_unexpectedly"),
                          ((FL, "last_successful_tick_age_ms"), 120000),
                          ((FL, "expiring_device_ids"), ["ori-fw-00000000", "ori-fw-7c9f2b3a"]),
                          ((FL, "supervised_devices"), 17),
                          ((FL, "consecutive_tick_failures"), 5)],
         "every liveness condition at once"),
        ("liveness_disabled", [((FL,), {"state": "disabled"})],
         "a disabled scheduler contributes nothing"),
        ("stall_at_bound", [((AL, "pending"), 1), ((AL, "oldest_pending_age_ms"), 30000)],
         "an age equal to the stall bound is not stalled"),
        ("trip_mismatched", TRIPPED + [
            (("safety_zones", 0, "command_status"), "command_issued"),
            (("safety_zones", 0, "effect_verified"), "mismatched"),
            (("safety_zones", 0, "protection_claim"), "unprotected")],
         "an observed effect that contradicts the trip"),
        ("trip_unverified_at_deadline", TRIPPED + [
            (("safety_zones", 0, "command_status"), "command_issued"),
