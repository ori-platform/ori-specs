def envelope_text(health: dict | None = None, **envelope) -> str:
    body = {"schema_version": 1, "ok": True, "health": full_health() if health is None else health}
    body.update(envelope)
    return json.dumps(body, ensure_ascii=False) + "\n"


def edited(path: tuple, value) -> dict:
    h = full_health()
    node = h
    for key in path[:-1]:
        node = node[key]
    if value is ABSENT:
        del node[path[-1]]
    else:
        node[path[-1]] = value
    return h


def zone_entry(trip_age_ms) -> dict:
    """A verified, protected tripped pair; only trip_age_ms varies."""
    return {"zone_id": "zone-a", "profile_id": "profile-a", "activation": "active",
            "trip_state": "tripped", "command_status": "command_issued",
            "effect_verified": "matched", "measurement_degraded": False,
            "rejected_input_active": False, "last_rejected_reason": "", "binding_seq": 2,
            "trip_age_ms": trip_age_ms,
            "qualification": {"state": "none", "fixture_hash": "", "expires_at_ms": None,
                              "sessions_used": 0, "sessions_remaining": None,
                              "min_acceptable_seq": 0},
            "protection_claim": "protected"}


def served(edits: list, status: str, reasons: list[str]) -> dict:
    h = full_health()
    for path, value in edits:
        node = h
        for key in path[:-1]:
            node = node[key]
        node[path[-1]] = value
    h.update(status=status, critical=status == C, degradation_reasons=reasons)
    return h


