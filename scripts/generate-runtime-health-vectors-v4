         "a condition holds and its token is not served"),
        ("reason_extra", deg, {**good_d, "degradation_reasons":
                               ["community_skills_refused", "sensor_unconnected"]},
         "a token whose condition does not hold"),
        ("umbrella_missing", view(*SINGLE["firmware_liveness_tick_failures"]),
         {"status": D, "critical": False,
          "degradation_reasons": ["firmware_liveness_tick_failures"]},
         "a liveness condition holds without the umbrella"),
        ("ok_with_reasons", deg, {**good_d, "status": "ok"},
         "correct reasons and status ok"),
        ("critical_on_degraded", deg, {**good_d, "status": C, "critical": True},
         "critical served where only degraded conditions hold"),
    ]
    return [{"name": n, "snapshot": v, "served": s, "expected": check_served(v, s), "note": note}
            for n, v, s, note in specs]


# ── heartbeat mapping ────────────────────────────────────────────────────────

def self_consistent(st: str, cr: bool, rs: list[str]) -> bool:
    if (len(rs) == 0) != (st == "ok"):
        return False
    if (UMBRELLA in rs) != any(is_liveness(t) for t in rs):
        return False
    if st != "ok":
        top = max((SEVERITY[t] for t in rs if t != UMBRELLA), key=RANK.__getitem__,
                  default="ok")
        if top != st:
            return False
    return cr == (st == C)


def triple_check(snapshot) -> str | None:
    """The first failing step, T1 to T4, or None when the triple passes."""
    if not isinstance(snapshot, dict):
        return "status_invalid"
    st = snapshot.get("status", ABSENT)
    cr = snapshot.get("critical", ABSENT)
    rs = snapshot.get("degradation_reasons", ABSENT)
    if not isinstance(st, str) or st not in RANK:
        return "status_invalid"
    if not isinstance(cr, bool) or cr != (st == C):
        return "critical_mismatch"
    if (not isinstance(rs, list) or len(rs) > MAX_REASONS
            or not all(isinstance(x, str) for x in rs)
            or rs != sorted(set(rs)) or any(x not in SNAPSHOT_VOCAB for x in rs)):
        return "reasons_malformed"
    if not self_consistent(st, cr, rs):
        return "reasons_inconsistent"
    return None


def heartbeat(snapshot) -> dict:
    if triple_check(snapshot) is not None:
        return {"status": C, "degradation_reasons": [INVALID]}
    if snapshot["status"] == "ok":
        return {"status": "healthy", "degradation_reasons": None}
    return {"status": snapshot["status"], "degradation_reasons": list(snapshot["degradation_reasons"])}


def fallback_heartbeat_case() -> dict:
    snapshot = {
        "status": "warning", "critical": False, "degradation_reasons": [],
        "device_id": "spoofed-device", "active_triggers": ["dangerous_overcurrent"],
        "evidence": {"enabled": True, "available": True, "chain_head_hash": "ab" * 32,
                     "attestation_gap_count": 0, "action_event_type": "SAFETY_ACTION_EXECUTED"},
    }
    runtime = {"device_id": "site-a-edge-01", "now_ms": 1717000000000, "auth_enabled": False}
    assert triple_check(snapshot) is not None
    return {
        "snapshot": snapshot, "runtime": runtime, "failed_step": triple_check(snapshot),
        "expected": {"device_id": runtime["device_id"], "status": C,
                     "last_seen_ms": runtime["now_ms"], "gateway_seen_ms": 0,
                     "active_triggers": [], "degradation_reasons": [INVALID]},
        "note": "nothing from the failed snapshot: not its device_id, triggers or evidence; "
                "no auth member, because heartbeat authentication is disabled",
    }


def heartbeat_cases() -> list[dict]:
    def t(st, cr, rs):
        return {"status": st, "critical": cr, "degradation_reasons": rs}
    specs = [
        ("ok", t("ok", False, []), "healthy, no reasons"),
        ("degraded", t(D, False, ["sensor_unconnected"]), "degraded carries its reasons"),
        ("critical", t(C, True, ["decision_record_lost", "sensor_unconnected"]),
         "critical carries its reasons"),
        ("critical_liveness", t(C, True, ["firmware_liveness_degraded",
                                          "firmware_liveness_stopped",
                                          "firmware_liveness_tick_failures"]),
         "the umbrella travels with the precise tokens"),
        ("status_absent", {"critical": False, "degradation_reasons": []},
         "no status never maps to healthy"),
        ("status_unknown_word", t("warning", False, []), "an unknown status"),
        ("status_healthy_word", t("healthy", False, []), "the heartbeat's word used locally"),
        ("status_case", t("OK", False, []), "case is not folded"),
        ("status_padded", t(" ok", False, []), "whitespace is not trimmed"),
        ("status_number", t(0, False, []), "a number"),
        ("status_null", t(None, False, []), "null"),
        ("critical_absent", {"status": "ok", "degradation_reasons": []}, "no critical"),
        ("critical_mismatch", t("ok", True, []), "critical true on ok"),
        ("critical_beside_degraded", t(D, True, ["firmware_liveness_degraded",
                                                 "firmware_liveness_stopped"]),
         "the v3 runtime's stalled-loop shape: critical true beside degraded"),
        ("reasons_absent", {"status": "ok", "critical": False}, "no reasons member"),
        ("ok_with_reason", t("ok", False, ["sensor_unconnected"]), "reasons on ok"),
        ("degraded_without_reason", t(D, False, []), "degraded with an empty set"),
        ("liveness_without_umbrella", t(D, False, ["firmware_liveness_tick_failures"]),
         "a liveness token without the umbrella"),
        ("umbrella_alone", t(D, False, ["firmware_liveness_degraded"]),
         "the umbrella decides no severity, so it cannot stand alone"),
        ("severity_understated", t(D, False, ["decision_record_lost"]),
         "a critical token under a degraded status"),
        ("severity_overstated", t(C, True, ["sensor_unconnected"]),
         "a critical status with only degraded tokens"),
        ("reasons_unsorted", t(D, False, ["sensor_unconnected", "community_skills_refused"]),
         "out of order"),
        ("reasons_unknown", t(D, False, ["sensor_disconnected"]), "unknown token"),
        ("reasons_not_array", t(D, False, "sensor_unconnected"), "a string, not an array"),
        ("starting", t(D, False, ["subsystem_starting"]), "startup reads degraded"),
        ("unknown_critical", t(C, True, ["subsystem_state_unknown_critical"]),
         "passes through as critical"),
        ("unknown_critical_under_degraded", t(D, False, ["subsystem_state_unknown_critical"]),
         "a critical token under degraded"),
        ("starting_beside_critical", t(C, True, ["decision_record_lost", "subsystem_starting"]),
         "a known critical wins over starting"),
        ("snapshot_carries_invalid_token", t(C, True, [INVALID]),
         "a snapshot never carries the heartbeat's token"),
        ("reasons_over_bound", t(C, True, [f"t{i:02d}" for i in range(33)]),
         "thirty-three entries"),
        ("reasons_duplicate", t(D, False, ["sensor_unconnected", "sensor_unconnected"]),
         "a token twice"),
        ("reasons_null", t("ok", False, None), "null is not the empty set"),
        ("snapshot_not_object", ["ok", False, []], "the snapshot is not an object"),
        ("snapshot_null", None, "no snapshot"),
    ]
    out = []
    for name, snap, note in specs:
        hb = heartbeat(snap)
        expected = {"failed_step": triple_check(snap), "status": hb["status"]}
        if hb["degradation_reasons"] is not None:
            expected["degradation_reasons"] = hb["degradation_reasons"]
        out.append({"name": name, "snapshot": snap, "expected": expected, "note": note})
    return out


# ── gateway-api/v2 degradation_reasons validation ────────────────────────────

def gateway_verdict(hb: dict) -> str:
    if hb.get("status") not in ("healthy", D, C):
        return "runtime_status_invalid"
    if "degradation_reasons" not in hb:
        return "accept"
    rs = hb["degradation_reasons"]
    if not isinstance(rs, list):
        return "degradation_reasons_not_array"
    if not 1 <= len(rs) <= MAX_REASONS:
        return "degradation_reasons_length_invalid"
    if not all(isinstance(x, str) for x in rs):
        return "degradation_reason_not_string"
    if len(set(rs)) != len(rs):
        return "degradation_reasons_not_unique"
    if rs != sorted(rs):
        return "degradation_reasons_not_ordered"
    if any(x not in VOCAB for x in rs):
        return "degradation_reason_unknown"
    if INVALID in rs and (len(rs) != 1 or hb["status"] != C):
        return "degradation_reason_not_alone"
    if hb.get("status") not in (D, C):
        return "degradation_reasons_status_mismatch"
    worst = max((RANK[C if x == INVALID else SEVERITY[x]] for x in rs if x != UMBRELLA),
                default=0)
    if RANK[hb["status"]] < worst:
        return "degradation_reasons_severity_understated"
    return "accept"


def gateway_cases() -> list[dict]:
    specs = [
        ("healthy_absent", {"status": "healthy"}, "nothing to report"),
        ("degraded_absent", {"status": D}, "an older runtime naming no reason"),
        ("critical_absent", {"status": C}, "a runtime that cannot name its reason"),
        ("critical_with_reason", {"status": C, "degradation_reasons": ["decision_record_lost"]},
         "row 8 admits critical"),
        ("degraded_with_reasons", {"status": D, "degradation_reasons":
                                   ["firmware_liveness_degraded",
                                    "firmware_liveness_over_capacity"]}, "two tokens"),
        ("every_token", {"status": C, "degradation_reasons": list(SNAPSHOT_VOCAB)},
         f"all {len(SNAPSHOT_VOCAB)} snapshot tokens, within the bound of thirty-two"),
        ("snapshot_invalid", {"status": C, "degradation_reasons": [INVALID]},
         "a runtime whose snapshot was malformed"),
        ("snapshot_invalid_degraded", {"status": D, "degradation_reasons": [INVALID]},
         "the token only ever accompanies critical"),
        ("snapshot_invalid_beside_token", {"status": C, "degradation_reasons":
                                           [INVALID, "sensor_unconnected"]},
         "the token is always alone"),
        ("snapshot_invalid_healthy", {"status": "healthy", "degradation_reasons": [INVALID]},
         "refused by the alone step before the status step"),
        ("status_absent", {"degradation_reasons": ["sensor_unconnected"]},
         "status is validated before any reason"),
        ("status_starting_alone", {"status": "starting"},
         "starting is not a runtime node status"),
        ("status_unknown", {"status": "ok"}, "the local word is not a heartbeat status"),
        ("starting", {"status": D, "degradation_reasons": ["subsystem_starting"]},
         "a runtime still starting"),
        ("critical_with_degraded_tokens", {"status": C,
                                           "degradation_reasons": ["sensor_unconnected"]},
         "the gateway checks presence against status, not severity"),
        ("healthy_with_reason", {"status": "healthy",
                                 "degradation_reasons": ["sensor_unconnected"]},
         "reasons need degraded or critical"),
        ("starting_with_reason", {"status": "starting",
                                  "degradation_reasons": ["sensor_unconnected"]},
         "starting is not a runtime node status"),
        ("empty", {"status": D, "degradation_reasons": []}, "present-empty is malformed"),
        ("over_bound", {"status": C, "degradation_reasons":
                        [f"t{i:02d}" for i in range(33)]},
         "thirty-three entries fail length before anything else"),
        ("at_bound_duplicates", {"status": C, "degradation_reasons":
                                 ["sensor_unconnected"] * 32},
         "thirty-two entries pass length and fail uniqueness"),
        ("seventeen_duplicates", {"status": C, "degradation_reasons":
                                  ["sensor_unconnected"] * 17},
         "past the old bound of sixteen, inside the new one"),
        ("not_array", {"status": D, "degradation_reasons": "sensor_unconnected"},
         "a string"),
        ("not_string", {"status": D, "degradation_reasons": [1]}, "a number"),
        ("degraded_with_critical_token", {"status": D, "degradation_reasons":
                                          ["decision_record_lost"]},
         "a critical condition under degraded"),
        ("degraded_with_mixed_tokens", {"status": D, "degradation_reasons":
                                        ["sensor_unconnected", "tier_d_alert_delivery_unconfirmed"]},
         "the most severe token decides the floor"),
        ("unknown_critical_under_degraded", {"status": D, "degradation_reasons":
                                             ["subsystem_state_unknown_critical"]},
         "unknown critical visibility is critical"),
        ("unknown_critical", {"status": C, "degradation_reasons":
                              ["subsystem_state_unknown_critical"]},
         "the token alone, with no per-subsystem field"),
        ("degraded_umbrella_only", {"status": D, "degradation_reasons":
                                    ["firmware_liveness_degraded"]},
         "an older runtime naming only the umbrella stays accepted"),
        ("critical_umbrella_only", {"status": C, "degradation_reasons":
                                    ["firmware_liveness_degraded"]},
         "a status above its tokens' severity is accepted"),
        ("duplicate_out_of_order", {"status": D, "degradation_reasons":
                                    ["sensor_unconnected", "community_skills_refused",
                                     "sensor_unconnected"]},
         "uniqueness is judged before order"),
        ("not_ordered", {"status": D, "degradation_reasons":
                         ["sensor_unconnected", "community_skills_refused"]}, "reversed"),
        ("unknown", {"status": D, "degradation_reasons": ["sensor_disconnected"]},
         "outside the vocabulary"),
    ]
    return [{"name": n, "heartbeat": hb, "expected": gateway_verdict(hb), "note": note}
            for n, hb, note in specs]


# ── request framing ──────────────────────────────────────────────────────────

ACCEPTED = {b"", b"\n", b"GET_HEALTH", b"GET_HEALTH\n"}


def frame(writes: list[bytes], after: str) -> str:
    """Judge a request as the server receives it, byte by byte, whatever the writes."""
    held = bytearray()
    for byte in b"".join(writes):
        held.append(byte)
        if len(held) > 1024:
            return "request_too_large"
        if byte == 0x0A:
            # The request ends here; anything after is discarded unread.
            return "ok" if bytes(held) in ACCEPTED else "unsupported_request"
    if after == "silent":
        return "unsupported_request"
    return "ok" if bytes(held) in ACCEPTED else "unsupported_request"


def request_cases() -> list[dict]:
    g = b"GET_HEALTH"
    one = [
        ("empty", b""), ("lf", b"\n"), ("get", g), ("get_lf", g + b"\n"),
        ("get_two_lf", g + b"\n\n"), ("two_lf", b"\n\n"), ("get_crlf", g + b"\r\n"),
        ("cr", b"\r"), ("get_cr", g + b"\r"), ("lf_get", b"\n" + g),
        ("space_get", b" " + g), ("get_space", g + b" "), ("tab_get", b"\t" + g),
        ("get_vt", g + b"\x0b"), ("get_ff", g + b"\x0c"),
        ("fs_get_gs", b"\x1c" + g + b"\x1d"), ("get_rs", g + b"\x1e"), ("get_us", g + b"\x1f"),
        ("get_nel", g + "\u0085".encode()), ("nbsp_get", "\u00a0".encode() + g),
        ("get_line_separator", g + "\u2028".encode()),
        ("get_paragraph_separator", g + "\u2029".encode()),
        ("bom_get", "\ufeff".encode() + g), ("get_nul", g + b"\x00"), ("nul", b"\x00"),
        ("invalid_utf8_inside", b"GET_\xffHEALTH"), ("invalid_utf8_alone", b"\xff"),
        ("get_invalid_utf8", g + b"\xc3"), ("lower", b"get_health"),
        ("prefix", b"GET_HEALT"), ("suffix", b"GET_HEALTHX"), ("space", b" "),
        ("fullwidth_get", "ＧＥＴ_ＨＥＡＬＴＨ".encode()),
        ("get_lf_then_data", g + b"\n\xffjunk"),
        ("get_lf_then_get", g + b"\nGET_HEALTH\n"),
        ("max_unaccepted", b"A" * 1024), ("over_max", b"A" * 1025),
        ("line_1023_lf", b"x" * 1023 + b"\n"), ("line_1024_lf", b"x" * 1024 + b"\n"),
        ("get_lf_then_over", g + b"\n" + b"B" * 1014),
        ("get_padded_at", g + b" " * 1014),
    ]
    specs = [(n, [raw] if raw else [], "eof") for n, raw in one]
    specs += [
        ("split_get_lf", [b"GET_", b"HEALTH\n"], "silent"),
        ("split_byte_by_byte", [bytes([c]) for c in g + b"\n"], "silent"),
        ("split_get_then_eof", [b"GET_HEA", b"LTH"], "eof"),
        ("split_get_lf_then_data", [g, b"\n\xffjunk"], "silent"),
        ("split_data_after_lf", [g + b"\n", b"\xffjunk"], "silent"),
        ("split_two_lf", [g + b"\n", b"\n"], "eof"),
        ("split_lf_then_get", [b"\n", g], "eof"),
        ("split_1000_25", [b"A" * 1000, b"A" * 25], "silent"),
        ("split_1000_24", [b"A" * 1000, b"A" * 24], "eof"),
        ("split_1000_24_silent", [b"A" * 1000, b"A" * 24], "silent"),
        ("split_line_1024_lf", [b"x" * 1000, b"x" * 24 + b"\n"], "silent"),
        ("split_line_1023_lf", [b"x" * 1000, b"x" * 23 + b"\n"], "silent"),
        ("unfinished_get", [g], "silent"),
        ("unfinished_partial", [b"GET_"], "silent"),
        ("unfinished_nothing", [], "silent"),
        ("empty_then_eof", [], "eof"),
    ]
    return [{"name": n, "writes_hex": [w.hex() for w in writes], "after": after,
             "bytes_written": sum(len(w) for w in writes), "expected": frame(writes, after)}
            for n, writes, after in specs]


# ── integers and expiry ──────────────────────────────────────────────────────

def int_ok(text: str) -> bool:
    body = text.removeprefix("-")
    if not body.isdigit() or (len(body) > 1 and body[0] == "0") or not body.isascii():
        return False
    return 0 <= int(text) <= INT_MAX


def integer_cases() -> list[dict]:
    texts = ["0", "1", "9007199254740991", "9007199254740992", "9223372036854775807",
             "18446744073709551616", "-1", "-9007199254740991", "1.0", "1e3", "1E0",
             "0.5", "01", "\"1\"", "true", "null"]
    return [{"json": t, "expected": "accept" if int_ok(t) else "refuse"} for t in texts]


def expiry_ok(m: dict) -> bool:
    e, v, x = m.get("expiry", ABSENT), m.get("valid_until", ABSENT), m.get("is_expired", ABSENT)
    if not isinstance(x, bool):
        return False
    if e == "never":
        return v is None and x is False
    if e == "at":
        return type(v) is int and 0 <= v <= INT_MAX
    return False


def expiry_cases() -> list[dict]:
    specs = [
        {"expiry": "never", "valid_until": None, "is_expired": False},
        {"expiry": "at", "valid_until": 1767225600, "is_expired": False},
        {"expiry": "at", "valid_until": 1767225600, "is_expired": True},
        {"expiry": "never", "valid_until": 9223372036854775807, "is_expired": False},
        {"expiry": "never", "valid_until": None, "is_expired": True},
        {"expiry": "at", "valid_until": None, "is_expired": False},
        {"valid_until": None, "is_expired": False},
        {"expiry": None, "valid_until": None, "is_expired": False},
        {"expiry": "forever", "valid_until": None, "is_expired": False},
        {"expiry": "at", "valid_until": 9007199254740992, "is_expired": False},
        {"expiry": "at", "valid_until": "1767225600", "is_expired": False},
    ]
    return [{"device_policy": m, "expected": "accept" if expiry_ok(m) else "refuse"}
            for m in specs]


def fold_cases() -> list[dict]:
    tokens = list(SEVERITY)
    seqs = [("none", [])]
    seqs += [(f"alone_{t}", [t]) for t in tokens]
    seqs += [(f"pair_{a}__{b}", [a, b]) for a, b in itertools.permutations(tokens, 2)]
    seqs += [("all_forward", tokens), ("all_reverse", list(reversed(tokens)))]
    return [{"name": n, "holding": h, "expected": fold(h)} for n, h in seqs]


