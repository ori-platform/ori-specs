                                    list(reversed(good_c["degradation_reasons"]))},
         "reasons out of byte order"),
        ("reasons_duplicate", deg, {**good_d, "degradation_reasons":
                                    ["sensor_unconnected", "sensor_unconnected"]},
         "a token twice"),
        ("reasons_unknown_token", deg, {**good_d, "degradation_reasons":
                                        ["sensor_disconnected"]},
         "a token outside the vocabulary"),
