"""Generate the runtime-health/v4 corpus: severity, reasons, heartbeat mapping, framing.

Every expected value is computed here by a small model of runtime-health/v4
Severity, Heartbeat Mapping, Request and Representation, and of the
gateway-api/v2 degradation_reasons validation order. Nothing here is shared
with a checker, which recomputes every expected value from the contracts'
text.

    python3 scripts/generate-runtime-health-vectors-v4          # write
    python3 scripts/generate-runtime-health-vectors-v4 --check  # reproduce
"""

from __future__ import annotations

import hashlib
import itertools
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "runtime-health" / "health-vectors-v4.json"

C, D = "critical", "degraded"
UMBRELLA = "firmware_liveness_degraded"
SEVERITY = {
    "action_log_records_lost": D,
    "action_log_records_stalled": D,
    "commissioning_problem": D,
    "community_skills_refused": D,
    "config_unsigned_value_source": D,
    "decision_record_lost": C,
    "evidence_contributor_link_unresolved": D,
    "evidence_courier_answer_unrecognised": D,
    "evidence_posture_problem": D,
    "firmware_liveness_device_expired": C,
    "firmware_liveness_over_capacity": D,
    "firmware_liveness_stopped": C,
    "firmware_liveness_tick_failures": D,
    "firmware_liveness_tick_stale": C,
    "safety_zone_active_unprotected": D,
    "sensor_measurement_degraded": D,
    "sensor_unconnected": D,
    "subsystem_starting": D,
    "subsystem_state_unknown": D,
    "safety_zone_activation_refused": D,
    "safety_zone_trip_unresolved": C,
    "sensor_stale": D,
    "tier_d_alert_delivery_unconfirmed": C,
    "alert_delivery_overdue": D,
    "skill_required_hooks_unavailable": C,
    "skill_optional_hooks_unavailable": D,
    "tier_c_records_degraded": D,
    "tier_c_recovery_failed": D,
    "subsystem_state_unknown_critical": C,
}
CRITICAL_CAPABLE = ("safety_registry", "alert_outbox", "action_log_records", "skill_hooks",
                    "firmware_liveness")
INVALID = "health_snapshot_invalid"  # the heartbeat's alone; never in a snapshot
VOCAB = sorted([*SEVERITY, UMBRELLA, INVALID])
SNAPSHOT_VOCAB = [x for x in VOCAB if x != INVALID]
RANK = {"ok": 0, D: 1, C: 2}
MAX_REASONS = 32
INT_MAX = 2**53 - 1


def is_liveness(token: str) -> bool:
    return token.startswith("firmware_liveness_") and token != UMBRELLA


def fold(holding: list[str]) -> dict:
    """The status the conditions give, taking the maximum, never the last."""
    status = "ok"
    for token in holding:
        if RANK[SEVERITY[token]] > RANK[status]:
            status = SEVERITY[token]
    reasons = set(holding)
    if any(is_liveness(t) for t in holding):
        reasons.add(UMBRELLA)
    return {"status": status, "critical": status == C,
            "degradation_reasons": sorted(reasons)}


# ── condition model over a snapshot's members ────────────────────────────────

def avail(block: dict) -> bool:
    return isinstance(block, dict) and block.get("state") == "available"


REFUSAL_VERDICTS = ("unit_mismatch", "direction_unsupported", "parameter_mismatch",
                    "trip_point_unobservable", "undemonstrated_binding")


def holding(v: dict) -> list[str]:
    out = []
    fl = v["firmware_liveness"]
    if avail(fl) and fl["loop"] != "stopped_cleanly":
        loop = fl["loop"]
        if loop == "stopped_unexpectedly":
            out.append("firmware_liveness_stopped")
        age, window = fl["last_successful_tick_age_ms"], fl["expiry_window_ms"]
        if (age is not None and age >= window) or (
                age is None and fl["started_age_ms"] >= window):
            out.append("firmware_liveness_tick_stale")
        if fl["expiring_device_ids"]:
            out.append("firmware_liveness_device_expired")
        if fl["supervised_devices"] > fl["supported_device_capacity"]:
            out.append("firmware_liveness_over_capacity")
        if fl["consecutive_tick_failures"] > 0:
            out.append("firmware_liveness_tick_failures")
    al = v["action_log_records"]
    if avail(al):
        open_kinds = {i["kind"] for i in al["loss_incidents"] if not i["acknowledged"]}
        if "decision_record_lost" in open_kinds:
            out.append("decision_record_lost")
        if "action_record_lost" in open_kinds:
            out.append("action_log_records_lost")
        if al["oldest_pending_age_ms"] is not None and \
                al["oldest_pending_age_ms"] > al["stall_bound_ms"]:
            out.append("action_log_records_stalled")
    ev = v["evidence"]
    ar = ev["action_records"]
    if avail(ar):
        if ar["lost"] > 0 or ar["unknown_live"] > 0 or ar["pending"] >= ar["ceiling"]:
            out.append("tier_c_records_degraded")
        if ar["recovery_failed"]:
            out.append("tier_c_recovery_failed")
    sensors = {s["id"]: s for s in v["sensors"]}
    if any(s["connection"] == "failed" for s in v["sensors"]):
        out.append("sensor_unconnected")
    if any(s["measurement_degraded"] is True for s in v["sensors"]):
        out.append("sensor_measurement_degraded")
    if any(s["stale"] is True for s in v["sensors"]):
        out.append("sensor_stale")
    ao = v["alert_outbox"]
    if avail(ao):
        if ao["tier_d_unresolved_count"] > 0 and (
                ao["tier_d_max_attempts"] >= ao["tier_d_critical_warning_threshold"]
                or ao["tier_d_oldest_age_ms"] >= ao["tier_d_age_bound_ms"]):
            out.append("tier_d_alert_delivery_unconfirmed")
        if ao["oldest_non_tier_d_age_ms"] is not None and \
                ao["oldest_non_tier_d_age_ms"] >= ao["overdue_bound_ms"]:
            out.append("alert_delivery_overdue")
    sh = v["skill_hooks"]
    if avail(sh):
        if sh["required_unavailable"] > 0:
            out.append("skill_required_hooks_unavailable")
        if sh["optional_unavailable"] > 0:
            out.append("skill_optional_hooks_unavailable")
    if avail(v["community_skills"]) and v["community_skills"]["refused_skills"] > 0:
        out.append("community_skills_refused")
    if avail(v["config_authority"]) and v["config_authority"]["unsigned_value_source"]:
        out.append("config_unsigned_value_source")
    if ev["posture_problems"]:
        out.append("evidence_posture_problem")
    if ev.get("delivery_ledger_available") and ev["courier_answer_faults"] > 0:
        out.append("evidence_courier_answer_unrecognised")
    if ev.get("attestation_summary_available") and ev["contributor_links_unresolved"] > 0:
        out.append("evidence_contributor_link_unresolved")
    cm = v["commissioning"]
    if avail(cm) and cm["problems"]:
        out.append("commissioning_problem")
    zone_sensor = {z["zone_id"]: z["sensor_id"] for z in cm["zones"]} if avail(cm) else {}
    sr = v["safety_registry"]
    if avail(sr):
        def unreported(zone: dict) -> bool:
            s = sensors.get(zone_sensor.get(zone["zone_id"], ""))
            return s is not None and (s["stale"] or s["connection"] != "connected")
        if any(z["activation"] == "active" and (
                z["protection_claim"] == "unprotected" or unreported(z))
               for z in v["safety_zones"]):
            out.append("safety_zone_active_unprotected")
        if any(z["activation"] in REFUSAL_VERDICTS for z in v["safety_zones"]):
            out.append("safety_zone_activation_refused")
        if any(z["activation"] == "active" and z["trip_state"] == "tripped" and (
                z["command_status"] == "driver_refused"
                or z["effect_verified"] == "mismatched"
                or (z["effect_verified"] == "unknown"
                    and z["trip_age_ms"] >= sr["trip_verification_deadline_ms"]))
               for z in v["safety_zones"]):
            out.append("safety_zone_trip_unresolved")
    deciding = (ao, cm, sr, v["community_skills"], v["config_authority"], al, fl, sh, ev, ar)
    if any(b["state"] == "starting" for b in deciding) or any(
            s["connection"] == "pending" for s in v["sensors"]):
        out.append("subsystem_starting")
    if any(v[name]["state"] == "unavailable" for name in CRITICAL_CAPABLE):
        out.append("subsystem_state_unknown_critical")
    unknown = any(b["state"] == "unavailable" for b in (
        cm, v["community_skills"], v["config_authority"], ev, ar)) or any(
        s["connection"] == "unavailable" for s in v["sensors"])
    if ev["state"] == "available" and not (
            ev["attestation_summary_available"] and ev["registration_available"]
            and ev["delivery_ledger_available"]):
        unknown = True
    if unknown:
        out.append("subsystem_state_unknown")
    return out


def sensor(sid: str) -> dict:
    return {"id": sid, "connection": "connected", "connected": True, "stale": False,
            "measurement_degraded": False}


def baseline() -> dict:
    return {
        "firmware_liveness": {
            "state": "available", "loop": "running", "started_age_ms": 600000,
            "expiry_window_ms": 60000, "supervised_devices": 2,
            "supported_device_capacity": 16, "consecutive_tick_failures": 0,
            "last_successful_tick_age_ms": 1000, "expiring_device_ids": [],
            "degraded": False},
        "action_log_records": {
            "state": "available", "pending": 0, "oldest_pending_age_ms": None,
            "ceiling": 1000, "lost": 0, "stall_bound_ms": 30000,
            "decision_records_lost": 0, "loss_incidents": []},
        "evidence": {
            "state": "available", "posture_problems": [],
            "action_records": {
                "state": "available", "pending": 0, "outcome_unknown": 0,
                "dispatch_unproven": 0, "lost": 0, "ceiling": 64, "unknown_live": 0,
                "oldest_pending_age_ms": None, "recovery_failed": False},
            "attestation_summary_available": True, "registration_available": True,
            "delivery_ledger_available": True, "contributor_links_unresolved": 0,
            "courier_answer_faults": 0},
        "sensors": [sensor("load-current"), sensor("grid-voltage"),
                    sensor("tank-temperature"), sensor("zone-a-current")],
        "alert_outbox": {
            "state": "available", "tier_d_unresolved_count": 0, "tier_d_max_attempts": None,
            "tier_d_oldest_age_ms": None, "tier_d_age_bound_ms": 300000,
            "tier_d_critical_warning_threshold": 3, "oldest_non_tier_d_age_ms": None,
            "overdue_bound_ms": 3600000},
        "skill_hooks": {"state": "available", "required_unavailable": 0,
                        "optional_unavailable": 0},
        "community_skills": {"state": "available", "refused_skills": 0},
        "config_authority": {"state": "available", "unsigned_value_source": False},
        "commissioning": {"state": "available", "problems": [], "zones": [
            {"zone_id": "zone-a", "sensor_id": "zone-a-current", "state": "in_force",
             "availability": "available"}]},
        "safety_registry": {"state": "available", "trip_verification_deadline_ms": 10000},
        "safety_zones": [
            {"zone_id": "zone-a", "profile_id": "profile-a", "activation": "active",
             "trip_state": "armed", "command_status": "none", "effect_verified": "unknown",
             "trip_age_ms": None, "protection_claim": "protected"}],
    }


def view(*edits) -> dict:
    v = baseline()
    for path, value in edits:
        node = v
        for key in path[:-1]:
            node = node[key]
        node[path[-1]] = value
    for sensor in v["sensors"]:
        sensor["connected"] = sensor["connection"] == "connected"
    # A member its section flag withholds is absent, never a default.
    if not v["evidence"]["attestation_summary_available"]:
        v["evidence"].pop("contributor_links_unresolved", None)
    if not v["evidence"]["delivery_ledger_available"]:
        v["evidence"].pop("courier_answer_faults", None)
    if avail(v["firmware_liveness"]):
        v["firmware_liveness"]["degraded"] = any(is_liveness(t) for t in holding(v))
    return v


FL = "firmware_liveness"
AL = "action_log_records"
EV = "evidence"
AR = (EV, "action_records")

def incident(kind: str, acknowledged: bool = False, iid: str = "inc-0001",
             count: int = 1) -> dict:
    return {"incident_id": iid, "kind": kind, "count": count,
            "first_observed_at_ms": 1716990000000, "acknowledged": acknowledged,
            "acknowledged_at_ms": 1716995000000 if acknowledged else None}


def losses(*incidents: dict) -> list:
    """The incidents with the two counters they imply."""
    action = sum(i["count"] for i in incidents if i["kind"] == "action_record_lost")
    decision = sum(i["count"] for i in incidents if i["kind"] == "decision_record_lost")
    return [((AL, "loss_incidents"), sorted(incidents, key=lambda i: i["incident_id"])),
            ((AL, "lost"), action), ((AL, "decision_records_lost"), decision)]


