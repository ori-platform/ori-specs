# --- responses ----------------------------------------------------------------------------------------
ACTION = {(200, "stored"): "retire", (200, "duplicate"): "retire", (200, "superseded"): "retire",
          (202, "retry_later"): "keep", (400, "refused"): "reject", (401, "refused"): "keep",
          (403, "refused"): "keep", (422, "refused"): "reject", (429, "retry_later"): "keep",
          (503, "retry_later"): "keep"}
OUTCOMES = ("stored", "duplicate", "superseded", "retry_later", "refused")
# The reasons each row names, by (status, outcome). A 401 is never authenticated, so its row names none.
ROW_REASONS = {(200, "stored"): ("",), (200, "duplicate"): ("",), (200, "superseded"): ("lower_count",),
               (202, "retry_later"): ("key_not_enrolled", "unsupported_version"),
               (400, "refused"): ("not_canonical", "malformed"), (401, "refused"): (),
               (403, "refused"): ("not_owned",),
               (422, "refused"): ("key_revoked", "signature_invalid", "transition_refused", "class_refused",
                                  "detail_refused"),
               (429, "retry_later"): ("",), (503, "retry_later"): ("",)}
REQ_DIGEST = digest(submission())
OTHER_DIGEST = digest(submission(attempt_seq=42))
RESPONSE_CASES: list[dict] = []


def gateway_action(status: int, body: str, request_digest: str) -> tuple[str, str | None]:
    """The gateway's action, and when it retires nothing, the way it retires nothing, classed in the order of
    Response: does not parse by form, unauthenticated, another digest, unpaired, does not parse by reason, and
    then the row's action."""
    try:
        obj = json.loads(body)
    except ValueError:
        return "keep", "unparsable"
    if not isinstance(obj, dict) or obj.get("v") != 1 or isinstance(obj.get("v"), bool) \
            or obj.get("outcome") not in OUTCOMES:
        return "keep", "unparsable"
    if set(obj) == {"v", "outcome", "reason"}:
        if obj["outcome"] == "refused" and obj["reason"] == "" and status in (400, 401):
            return "keep", "unauthenticated"
        return "keep", "unparsable"
    if set(obj) != {"v", "outcome", "reason", "record_digest"} or not isinstance(obj["record_digest"], str) \
            or not DIGEST_RE.fullmatch(obj["record_digest"]):
        return "keep", "unparsable"
    if obj["record_digest"] != request_digest:
        return "keep", "another_digest"
    pair = (status, obj["outcome"])
    if pair not in ACTION:
        return "keep", "unpaired"
    if obj["reason"] not in ROW_REASONS[pair]:
        return "keep", "unparsable"
    return ACTION[pair], None


def resp_body(outcome: str, reason: str = "", rdigest: str | None = REQ_DIGEST, **extra: object) -> str:
    obj: dict = {"outcome": outcome, "reason": reason, "v": 1, **extra}
    if rdigest is not None:
        obj["record_digest"] = rdigest
    return canonical(obj).decode("utf-8")


def rs(name: str, note: str, status: int, body: str, action: str, *, row: str | None = None,
       retires_nothing: str | None = None, headers: dict | None = None) -> None:
    got = gateway_action(status, body, REQ_DIGEST)
    assert row is not None or retires_nothing is not None, name
    assert got == (action, retires_nothing), (name, got, action, retires_nothing)
    case: dict = {"name": name, "note": note, "request_digest": REQ_DIGEST, "response": {
        "status": status, "headers": {"Content-Type": "application/json", **(headers or {})}, "body": body},
        "action": action}
    if row is not None:
        case["row"] = row
    if retires_nothing is not None:
        case["retires_nothing"] = retires_nothing
    RESPONSE_CASES.append(case)


