       "and its members in another order: judged as the JSON it parses to.", 401,
       '{ "v": 1, "reason": "", "outcome": "refused" }', "keep", retires_nothing="unauthenticated")
    rs("row_200_stored_parsed_not_bytes", "200 stored with whitespace and its members out of order: judged as the "
       "JSON it parses to, and retired.", 200,
       '{"v": 1, "record_digest": "' + REQ_DIGEST + '", "reason": "", "outcome": "stored"}', "retire",
       row="200 stored")
    # Unauthenticated.
    rs("unparsable_429_unauthenticated_form", "429 retry_later of three members: a 429 is sent only once checks 1 "
       "to 5 have passed, so it names the digest; in the unauthenticated form it does not parse.", 429,
       resp_body("retry_later", rdigest=None), "keep", retires_nothing="unparsable", headers={"Retry-After": "30"})
    rs("unparsable_503_unauthenticated_refused", "503 refused of three members with an empty reason: the "
       "unauthenticated form is a 400 or 401 only.", 503, resp_body("refused", rdigest=None), "keep",
       retires_nothing="unparsable")
    rs("unauthenticated_400_check2", "A 400 refused in the unauthenticated form, as a request refused at check 2 "
       "is answered: keep, never reject.", 400, resp_body("refused", rdigest=None), "keep",
       retires_nothing="unauthenticated")
    rs("unauthenticated_401_check5", "A 401 refused in the unauthenticated form, as a replayed request is "
       "answered: keep.", 401, resp_body("refused", rdigest=None), "keep", retires_nothing="unauthenticated")


# --- config (gateway-config/v2 alert_delivery, forwarding keys) ------------------------------------
BASE_DOC = {
    "gateway": {
        "state_directory": "/var/lib/ori-gateway/state",
        "auth": {"shared_secret_env": "ORI_GATEWAY_SHARED_SECRET",
                 "previous_shared_secret_env": "ORI_GATEWAY_PREVIOUS_SHARED_SECRET"},
        "custody": {"secret_env": "ORI_GATEWAY_CUSTODY_SECRET"},
    },
    "evidence": {"enabled": True, "queue_directory": "/var/lib/ori-gateway/evidence-outbound",
                 "return_queue_directory": "/var/lib/ori-gateway/evidence-return",
                 "secret_env": "ORI_EVIDENCE_INGEST_SECRET"},
    "alert_delivery": {"enabled": True, "queue_directory": "/var/lib/ori-gateway/alert-delivery",
                       "endpoint_env": "ORI_ALERT_DELIVERY_ENDPOINT",
                       "client_id_env": "ORI_ALERT_DELIVERY_CLIENT_ID",
                       "secret_env": "ORI_ALERT_DELIVERY_SECRET"},
}
ENV_KEYS = ("endpoint_env", "client_id_env", "secret_env")
# Each variable rule 8 names, with its default when the key is absent (None: no default, so it names nothing).
SHARED_WITH = ((("gateway", "auth", "shared_secret_env"), "GATEWAY_SHARED_SECRET"),
               (("gateway", "auth", "previous_shared_secret_env"), ""),
               (("gateway", "custody", "secret_env"), None),
               (("evidence", "secret_env"), None))
WS = set("\t\n\x0b\x0c\r \x85\xa0\u1680\u2028\u2029\u202f\u205f\u3000") | {chr(c) for c in range(0x2000, 0x200B)}
CONFIG_CASES: list[dict] = []
ABSENT = object()


def get(doc: dict, path: tuple) -> object:
    for p in path:
        if not isinstance(doc, dict) or p not in doc:
            return ABSENT
        doc = doc[p]
    return doc


def config_verdict(doc: dict) -> str | None:
    """The first of rules 1, 6, 7 and 8 the document breaks. Every case keeps rules 2 to 5 satisfied, which the
    generator asserts."""
    ad = doc["alert_delivery"]
    if not isinstance(ad.get("enabled"), bool):
        return "type_mismatch"
    if not ad["enabled"]:
        return None
    for k in ("queue_directory", *ENV_KEYS):
        if k in ad and not isinstance(ad[k], str):
            return "type_mismatch"
    if "max_records_per_device" in ad and (isinstance(ad["max_records_per_device"], bool)
                                           or not isinstance(ad["max_records_per_device"], int)):
        return "type_mismatch"
    qd = ad["queue_directory"].strip("".join(WS))
    assert qd == "/var/lib/ori-gateway/alert-delivery", "rules 2 to 4 hold in every case"
    assert 1 <= ad.get("max_records_per_device", 4096) <= 65536, "rule 5 holds in every case"
    configured = [k for k in ENV_KEYS if ad.get(k, "") != ""]
    if configured and len(configured) != len(ENV_KEYS):
        return "forwarding_incomplete"
    if not configured:
        return None
    for k in ENV_KEYS:
        if any(c in WS or c == "=" for c in ad[k]):
            return "env_name_malformed"
    if ad["secret_env"].encode("utf-8") in (ad["endpoint_env"].encode("utf-8"), ad["client_id_env"].encode("utf-8")):
        return "secret_env_shared"
    for path, default in SHARED_WITH:
        v = get(doc, path)
        name = default if v is ABSENT else v
        if isinstance(name, str) and name.encode("utf-8") == ad["secret_env"].encode("utf-8"):
            return "secret_env_shared"
    return None


def cf(name: str, note: str, edit, expected: str | None) -> None:
    doc = copy.deepcopy(BASE_DOC)
    edit(doc)
    got = config_verdict(doc)
    assert got == expected, (name, got, expected)
    ad = doc["alert_delivery"]
    case = {"name": name, "note": note, "document": doc, "valid": expected is None}
    if expected is not None:
        case["rule"] = expected
    elif ad["enabled"]:
        case["forwarding"] = all(ad.get(k, "") != "" for k in ENV_KEYS)
    CONFIG_CASES.append(case)


def ad_set(**kv):
    def edit(doc: dict) -> None:
        for k, v in kv.items():
            if v is ABSENT:
                doc["alert_delivery"].pop(k, None)
            else:
                doc["alert_delivery"][k] = v
    return edit


def at(path: tuple, value: object):
    def edit(doc: dict) -> None:
        d = doc
        for p in path[:-1]:
            d = d.setdefault(p, {})
        if value is ABSENT:
            d.pop(path[-1], None)
        else:
            d[path[-1]] = value
    return edit


def both(*edits):
    def edit(doc: dict) -> None:
        for e in edits:
            e(doc)
    return edit


NO_FORWARDING = {k: ABSENT for k in ENV_KEYS}


def config_corpus() -> None:
    # Accepted.
    cf("accepted_base", "Enabled, a separate absolute queue, three distinct well-formed forwarding names, none "
       "shared with another credential's variable.", ad_set(), None)
    cf("accepted_custody_without_forwarding", "Enabled with none of the three forwarding keys: custody is "
       "configured without forwarding.", ad_set(**NO_FORWARDING), None)
    cf("accepted_forwarding_keys_all_empty", "All three forwarding keys present and empty: none is present and not "
       "empty, so custody is configured without forwarding.",
       ad_set(endpoint_env="", client_id_env="", secret_env=""), None)
    cf("accepted_forwarding_keys_absent_and_empty", "endpoint_env empty, the other two absent: no forwarding.",
       ad_set(endpoint_env="", client_id_env=ABSENT, secret_env=ABSENT), None)
    cf("accepted_lowercase_dotted_names", "Names in lower case with dots and hyphens: rules 6 to 8 impose no "
       "pattern beyond White_Space and `=`.",
       ad_set(endpoint_env="ori.alert-endpoint", client_id_env="ori.alert-client", secret_env="ori.alert-secret"),
       None)
    cf("accepted_shared_endpoint_and_client_names", "endpoint_env and client_id_env name the same variable: "
       "rule 8 judges only secret_env.", ad_set(client_id_env="ORI_ALERT_DELIVERY_ENDPOINT"), None)
    cf("accepted_other_credentials_absent", "gateway.auth.previous_shared_secret_env, gateway.custody.secret_env "
       "and evidence.secret_env absent: the first defaults to empty and the other two have no default, so none "
       "names a variable secret_env could share.",
       both(at(("gateway", "auth", "previous_shared_secret_env"), ABSENT), at(("gateway", "custody"), ABSENT),
            at(("evidence", "secret_env"), ABSENT)), None)
    cf("accepted_case_differs", "secret_env differs from gateway.auth.shared_secret_env only in case: compared "
       "byte for byte, a different name.", ad_set(secret_env="ori_gateway_shared_secret"), None)
    cf("accepted_shared_secret_env_default_other", "gateway.auth.shared_secret_env absent, so its default "
       "GATEWAY_SHARED_SECRET is in force, and secret_env names another variable.",
       at(("gateway", "auth", "shared_secret_env"), ABSENT), None)
    cf("accepted_disabled_bad_names", "Disabled: the forwarding keys are not validated, however they are formed.",
       ad_set(enabled=False, endpoint_env="", client_id_env="BAD NAME", secret_env="ORI_GATEWAY_SHARED_SECRET"),
       None)
    cf("accepted_disabled_bad_types", "Disabled: rule 1 judges only enabled, so non-string forwarding keys are "
       "not judged.", ad_set(enabled=False, endpoint_env=123, client_id_env=None, secret_env=True), None)
    cf("accepted_zero_width_space", "secret_env with an interior U+200B ZERO WIDTH SPACE, which has no White_Space "
       "property: not malformed.", ad_set(secret_env="ORI_ALERT\u200bSECRET"), None)
    # Rule 1 on the forwarding keys.
    for k in ENV_KEYS:
        cf(f"rule1_{k}_number", f"{k} is a bare number where a string is required.", ad_set(**{k: 123}),
           "type_mismatch")
        cf(f"rule1_{k}_null", f"{k} is an explicit null, no value of the string type.", ad_set(**{k: None}),
           "type_mismatch")
    cf("rule1_secret_env_bool", "secret_env is a boolean.", ad_set(secret_env=True), "type_mismatch")
    cf("rule1_endpoint_env_list", "endpoint_env is an array of one string.", ad_set(endpoint_env=["ORI_X"]),
       "type_mismatch")
    cf("rule1_client_id_env_object", "client_id_env is an object.", ad_set(client_id_env={"name": "ORI_X"}),
       "type_mismatch")
    cf("rule1_null_without_forwarding", "secret_env an explicit null, the other two absent: null is a type "
       "mismatch, not an absent key.", ad_set(endpoint_env=ABSENT, client_id_env=ABSENT, secret_env=None),
       "type_mismatch")
    cf("precedence_rule1_over_rule6", "secret_env is a number and endpoint_env is absent: rule 1 precedes rule 6.",
       ad_set(endpoint_env=ABSENT, secret_env=123), "type_mismatch")
    cf("precedence_rule1_over_rule7", "client_id_env is null and endpoint_env holds a space: rule 1 precedes rule 7.",
       ad_set(endpoint_env="ORI ENDPOINT", client_id_env=None), "type_mismatch")
    # Rule 6.
    for k in ENV_KEYS:
        cf(f"rule6_only_{k}", f"Only {k} is present and not empty.",
           ad_set(**{x: ABSENT for x in ENV_KEYS if x != k}), "forwarding_incomplete")
        cf(f"rule6_{k}_absent", f"{k} absent, the other two present.", ad_set(**{k: ABSENT}), "forwarding_incomplete")
        cf(f"rule6_{k}_empty", f"{k} empty, the other two present.", ad_set(**{k: ""}), "forwarding_incomplete")
    cf("precedence_rule6_over_rule7", "endpoint_env holds `=` and secret_env is absent: rule 6 precedes rule 7.",
       ad_set(endpoint_env="ORI=X", secret_env=ABSENT), "forwarding_incomplete")
    cf("precedence_rule6_over_rule8", "secret_env names the gateway's shared-secret variable and endpoint_env is "
       "empty: rule 6 precedes rule 8.", ad_set(endpoint_env="", secret_env="ORI_GATEWAY_SHARED_SECRET"),
       "forwarding_incomplete")
    cf("rule6_whitespace_counts_present", "secret_env of one space, the other two absent: a space is present and "
       "not empty, so forwarding is incomplete.", ad_set(endpoint_env=ABSENT, client_id_env=ABSENT, secret_env=" "),
       "forwarding_incomplete")
    # Rule 7.
    for k in ENV_KEYS:
        cf(f"rule7_{k}_space", f"{k} holds an interior space.", ad_set(**{k: "ORI ALERT"}), "env_name_malformed")
        cf(f"rule7_{k}_equals", f"{k} holds `=`.", ad_set(**{k: "ORI_ALERT=1"}), "env_name_malformed")
    cf("rule7_leading_space", "secret_env with a leading space: names are not trimmed, so the space is in the name.",
       ad_set(secret_env=" ORI_ALERT_DELIVERY_SECRET"), "env_name_malformed")
    cf("rule7_trailing_tab", "client_id_env with a trailing tab.", ad_set(client_id_env="ORI_ALERT_CLIENT\t"),
       "env_name_malformed")
    cf("rule7_newline", "endpoint_env with an interior line feed.", ad_set(endpoint_env="ORI_ALERT\nENDPOINT"),
       "env_name_malformed")
    cf("rule7_no_break_space", "secret_env with an interior U+00A0 NO-BREAK SPACE, a White_Space character.",
       ad_set(secret_env="ORI_ALERT\u00a0SECRET"), "env_name_malformed")
    cf("rule7_ideographic_space", "endpoint_env with an interior U+3000 IDEOGRAPHIC SPACE, a White_Space character.",
       ad_set(endpoint_env="ORI_ALERT\u3000ENDPOINT"), "env_name_malformed")
    cf("rule7_whitespace_only", "secret_env of one space, the other two named: rule 6 holds, and rule 7 refuses it.",
       ad_set(secret_env=" "), "env_name_malformed")
    cf("precedence_rule7_over_rule8", "secret_env names evidence.secret_env's variable and endpoint_env holds a "
       "space: rule 7 precedes rule 8.", ad_set(endpoint_env="ORI ENDPOINT", secret_env="ORI_EVIDENCE_INGEST_SECRET"),
       "env_name_malformed")
    # Rule 8.
    names = {("gateway", "auth", "shared_secret_env"): "ORI_GATEWAY_SHARED_SECRET",
             ("gateway", "auth", "previous_shared_secret_env"): "ORI_GATEWAY_PREVIOUS_SHARED_SECRET",
             ("gateway", "custody", "secret_env"): "ORI_GATEWAY_CUSTODY_SECRET",
             ("evidence", "secret_env"): "ORI_EVIDENCE_INGEST_SECRET"}
    for path, value in names.items():
        cf("rule8_" + "_".join(path), f"secret_env names the same variable as {'.'.join(path)}.",
           ad_set(secret_env=value), "secret_env_shared")
    cf("rule8_secret_is_endpoint_env", "secret_env names the same variable as this section's endpoint_env.",
       ad_set(secret_env="ORI_ALERT_DELIVERY_ENDPOINT"), "secret_env_shared")
    cf("rule8_secret_is_client_id_env", "secret_env names the same variable as this section's client_id_env.",
       ad_set(secret_env="ORI_ALERT_DELIVERY_CLIENT_ID"), "secret_env_shared")
    cf("rule8_shared_secret_env_default", "gateway.auth.shared_secret_env absent, so its default "
       "GATEWAY_SHARED_SECRET is the name in force, and secret_env names it.",
       both(at(("gateway", "auth", "shared_secret_env"), ABSENT), ad_set(secret_env="GATEWAY_SHARED_SECRET")),
       "secret_env_shared")
    cf("rule8_gateway_auth_absent", "No gateway.auth section: shared_secret_env's default GATEWAY_SHARED_SECRET is "
       "in force, and secret_env names it.",
       both(at(("gateway", "auth"), ABSENT), ad_set(secret_env="GATEWAY_SHARED_SECRET")), "secret_env_shared")
    cf("rule8_evidence_disabled", "evidence.enabled is false but evidence.secret_env names a variable: it counts "
       "whether or not evidence is enabled.",
       both(at(("evidence", "enabled"), False), ad_set(secret_env="ORI_EVIDENCE_INGEST_SECRET")),
       "secret_env_shared")


# --- the corpus -----------------------------------------------------------------------------------------
def build() -> dict:
    REQUEST_CASES.clear()
    RESPONSE_CASES.clear()
    CONFIG_CASES.clear()
    requests_corpus()
    requests_corpus_refused()
    responses_corpus()
    config_corpus()
    for group in (REQUEST_CASES, RESPONSE_CASES, CONFIG_CASES):
        names = [c["name"] for c in group]
        assert len(names) == len(set(names)), "case names are unique within a group"
    return {
        "contract": "alert-delivery-transport/v1",
        "description": {
            "key_ids": ("Test secrets, each the SHA-256 of the ASCII label `ori alert-delivery-transport/v1 <name> "
                        "test secret` written as 64 lowercase hexadecimal characters, with the key_id derived by "
                        "HKDF-SHA256 over the secret's UTF-8 bytes. The HMAC key is the same UTF-8 bytes. Test "
                        "secrets only."),
            "runtime_test_keys": ("Ed25519 report keys, each seeded by the SHA-256 of its `seed_label`, that sign "
                                  "the record bodies. Test keys only."),
            "registry": ("The receiver's own registry, shared by every request case: each client's key_ids, the "
                         "devices it may forward for and the owners on whose behalf it may; and each report-key "
                         "enrolment, binding a key to a device and to the owner it names, and `revoked` true for "
                         "a key since revoked. Each key is its own epoch."),
            "requests": ("Requests as an exact request line, every header received in order, and body, with the HMAC "
                         "input as hex wherever X-Ori-Alert-Sent-At-Ms carries an integer's own spelling, and the "
                         "receiver's verdict at checks 1 to 8 of Order. `receiver` gives the receiver's clock, the "
                         "(client_id, key_id, nonce) triples it already holds, and the records it holds verified, "
                         "each as stored or conflict. A verdict names its check (null when every check passes), "
                         "HTTP status, whether the response is authenticated, and the exact response body; a "
                         "refusal names its reason, and an accepted request check 8's verdict: stored, conflict, "
                         "duplicate or lower_count. A case that fails more than one check declares `precedence`."),
            "responses": ("A response to a request whose digest is `request_digest`, with the gateway's action. A "
                          "case on a row of the table names it as `row`; a case that retires nothing names the way "
                          "as `retires_nothing`: another_digest, unparsable, unpaired or unauthenticated."),
            "config": ("gateway-config/v2 documents, judged under the alert_delivery load rules: rule 1 on the "
                       "forwarding keys, rules 6 to 8, and accepted cases. Every case keeps rules 2 to 5 satisfied. "
                       "A refused case names the rule; an accepted enabled case says whether forwarding is "
                       "configured."),
        },
        "endpoint": {"method": METHOD, "path": PATH, "request_content_type": CONTENT_TYPE,
                     "max_request_line_bytes": MAX_REQUEST_LINE, "max_headers": MAX_HEADERS,
                     "max_header_bytes": MAX_HEADER_BYTES, "max_body_bytes": MAX_BODY, "skew_ms": SKEW_MS,
                     "hmac_domain_hex": HMAC_DOMAIN.hex(),
                     "key_id_salt": KEY_ID_SALT.decode("ascii"), "key_id_info": KEY_ID_INFO.decode("ascii")},
        "key_ids": [{"name": n, "label": label(n), "secret": SECRETS[n], "key_id": KEY_IDS[n]}
                    for n in SECRET_NAMES],
        "runtime_test_keys": [{"name": s.name, "seed_label": s.seed_label, "public_key": s.public_key,
                               "key_identity": s.identity} for s in SIGNERS.values()],
        "registry": REGISTRY,
        "requests": REQUEST_CASES,
        "responses": RESPONSE_CASES,
        "config": CONFIG_CASES,
    }


def render() -> bytes:
    return (json.dumps(build(), indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = render()
    if argv[1:] == ["--check"]:
        if not OUT.exists() or OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator", file=sys.stderr)
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv[1:]:
        print(__doc__, file=sys.stderr)
        return 2
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
