"""Generate alert-delivery-transport/v1 vectors.

Writes alert-delivery-transport/vectors/alert-delivery-transport-v1.json:

- key_ids: test secrets, each the SHA-256 of a published label written as 64
  lowercase hexadecimal characters, with the key_id the contract derives;
- requests: exact request lines, header lists and bodies, each with its HMAC
  input and Authorization header and the receiver's verdict at checks 1 to 8
  of Order, for the forwarding permissions, owners, enrolments and held
  records the case names: its check, HTTP status, response outcome and reason,
  and the exact response body;
- responses: a receiver's response to a request of known digest, with the
  gateway's action, retire, keep or reject;
- config: the gateway-config/v2 alert_delivery load rules on the forwarding
  keys, rule 1 on their types and rules 6 to 8, and accepted cases.

Every refused case is refused for one check alone, except a case that declares
its precedence: the check that wins and the later checks it also fails. The
generator judges every case with its own judges and stops if the verdict it
declares is not the one they reach. The secrets and runtime keys are test
values only.

Usage: generate-alert-delivery-transport-vectors-v1 [--check]
"""

from __future__ import annotations

import base64
import copy
import hashlib
import hmac
import json
import pathlib
import re
import sys

from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
from cryptography.hazmat.primitives.kdf.hkdf import HKDF
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "alert-delivery-transport" / "vectors" / "alert-delivery-transport-v1.json"

METHOD = "POST"
PATH = "/v1/runtime/alert-delivery-records"
REQUEST_LINE = f"{METHOD} {PATH} HTTP/1.1"
HOST = "receiver.example"
MAX_REQUEST_LINE = 1024
MAX_HEADERS = 32
MAX_HEADER_BYTES = 1024
MAX_BODY = 4096
MAX_INT = 2**53 - 1
SKEW_MS = 300_000
CONTENT_TYPE = "application/octet-stream"
KEY_ID_SALT = b"ori.alert_delivery_forward_key_id.v1"
KEY_ID_INFO = b"alert_delivery_forward"
HMAC_DOMAIN = b"ori.alert_delivery_forward_request.v1\x00"
RECORD_DOMAIN = b"ori.alert_delivery.v1\x00"
SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")
T0 = 1_787_000_000_000
NOW_MS = T0 + 60_000

H_HOST = "Host"
H_LEN = "Content-Length"
H_CT = "Content-Type"
H_CLIENT = "X-Ori-Alert-Client"
H_KEY = "X-Ori-Alert-Key-Id"
H_SENT = "X-Ori-Alert-Sent-At-Ms"
H_NONCE = "X-Ori-Alert-Nonce"
H_DIGEST = "X-Ori-Alert-Record-Digest"
H_AUTH = "Authorization"
REQUIRED = (H_CLIENT, H_KEY, H_SENT, H_NONCE, H_DIGEST, H_AUTH)
STANDARD = (H_HOST, H_LEN, H_CT)

CLIENT_A = "gateway-site-a"
CLIENT_B = "gateway-site-b"
CLIENT_ESCAPED = 'gw "a" \\ 01'
CLIENT_LONG = "g" * 128
DEVICE_A = "site-a-edge-01"
DEVICE_B = "site-b-edge-01"
DEVICE_MOVED = "site-m-edge-01"
DEVICE_UNKNOWN = "site-z-edge-99"
OWNER_A = "site-a"
OWNER_B = "site-b"

PRINTABLE_RE = re.compile(r"[\x20-\x7e]{1,128}")
KEY_ID_RE = re.compile(r"hkdf-sha256:[0-9a-f]{32}")
SENT_RE = re.compile(r"[1-9][0-9]{0,15}")
DIGITS_RE = re.compile(r"0|[1-9][0-9]*")
NONCE_RE = re.compile(r"[0-9a-f]{32}")
DIGEST_RE = re.compile(r"sha256:[0-9a-f]{64}")
AUTH_RE = re.compile(r"Ori-Alert-HMAC hmac-sha256:([0-9a-f]{64})")


# --- secrets and key identifiers ---------------------------------------------------------------------
def label(name: str) -> str:
    return f"ori alert-delivery-transport/v1 {name} test secret"


def secret(name: str) -> str:
    return hashlib.sha256(label(name).encode("ascii")).hexdigest()


def hkdf_stdlib(ikm: bytes, salt: bytes, info: bytes, length: int) -> bytes:
    prk = hmac.new(salt, ikm, hashlib.sha256).digest()
    out, block, i = b"", b"", 1
    while len(out) < length:
        block = hmac.new(prk, block + info + bytes([i]), hashlib.sha256).digest()
        out += block
        i += 1
    return out[:length]


def derive_key_id(sec: str) -> str:
    ikm = sec.encode("utf-8")
    ours = hkdf_stdlib(ikm, KEY_ID_SALT, KEY_ID_INFO, 16)
    theirs = HKDF(algorithm=hashes.SHA256(), length=16, salt=KEY_ID_SALT, info=KEY_ID_INFO).derive(ikm)
    assert ours == theirs, "the two HKDF implementations disagree"
    return "hkdf-sha256:" + ours.hex()


SECRET_NAMES = ("gateway-site-a", "gateway-site-b", "gateway-escaped", "gateway-long", "unheld")
SECRETS = {n: secret(n) for n in SECRET_NAMES}
KEY_IDS = {n: derive_key_id(SECRETS[n]) for n in SECRET_NAMES}
SECRET_BY_KEY_ID = {KEY_IDS[n]: SECRETS[n] for n in SECRET_NAMES}
assert len(set(KEY_IDS.values())) == len(KEY_IDS)


# --- runtime report keys -------------------------------------------------------------------------------
class Signer:
    def __init__(self, name: str) -> None:
        self.name = name
        self.seed_label = f"ori alert-delivery-transport/v1 {name} test key"
        self.key = Ed25519PrivateKey.from_private_bytes(hashlib.sha256(self.seed_label.encode("ascii")).digest())
        self.pub = self.key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
        self.identity = "sha256:" + hashlib.sha256(SPKI_PREFIX + self.pub).hexdigest()
        self.public_key = "ed25519:" + base64.b64encode(self.pub).decode("ascii")


SIGNERS = {n: Signer(n) for n in ("runtime-a", "runtime-b", "moved-old", "moved-new", "unenrolled", "rotated-a",
                                   "revoked-a")}
RT_A, RT_B, MOVED_OLD, MOVED_NEW, UNENROLLED, ROTATED_A, REVOKED_A = (SIGNERS[n] for n in SIGNERS)
DEFAULT_SIGNER = {DEVICE_A: RT_A, DEVICE_B: RT_B, DEVICE_MOVED: MOVED_NEW, DEVICE_UNKNOWN: UNENROLLED}

# The receiver's own registry. Each client: the key_ids it holds for it, the devices it may forward for, and the
# owners on whose behalf it may forward. Each enrolment: a report key bound to a device and to the owner the
# device belonged to when the key was enrolled. DEVICE_MOVED moved from site-a to site-b: the key enrolled while
# it was site-a's, moved-old, still names site-a, and the key enrolled since, moved-new, names site-b. Device A
# also holds rotated-a, a retired key of its own that still verifies and is its own epoch, and revoked-a, a key
# once enrolled for it and since revoked.
REGISTRY = {
    "clients": {
        CLIENT_A: {"key_ids": [KEY_IDS["gateway-site-a"]], "devices": [DEVICE_A], "owners": [OWNER_A]},
        CLIENT_B: {"key_ids": [KEY_IDS["gateway-site-b"]], "devices": [DEVICE_B, DEVICE_MOVED], "owners": [OWNER_B]},
        CLIENT_ESCAPED: {"key_ids": [KEY_IDS["gateway-escaped"]], "devices": [DEVICE_A], "owners": [OWNER_A]},
        CLIENT_LONG: {"key_ids": [KEY_IDS["gateway-long"]], "devices": [DEVICE_A], "owners": [OWNER_A]},
    },
    "enrolments": [
        {"device_id": DEVICE_A, "key_identity": RT_A.identity, "public_key": RT_A.public_key, "owner": OWNER_A,
         "revoked": False},
        {"device_id": DEVICE_A, "key_identity": ROTATED_A.identity, "public_key": ROTATED_A.public_key,
         "owner": OWNER_A, "revoked": False},
        {"device_id": DEVICE_A, "key_identity": REVOKED_A.identity, "public_key": REVOKED_A.public_key,
         "owner": OWNER_A, "revoked": True},
        {"device_id": DEVICE_B, "key_identity": RT_B.identity, "public_key": RT_B.public_key, "owner": OWNER_B,
         "revoked": False},
        {"device_id": DEVICE_MOVED, "key_identity": MOVED_OLD.identity, "public_key": MOVED_OLD.public_key,
         "owner": OWNER_A, "revoked": False},
        {"device_id": DEVICE_MOVED, "key_identity": MOVED_NEW.identity, "public_key": MOVED_NEW.public_key,
         "owner": OWNER_B, "revoked": False},
    ],
}
CLIENTS = REGISTRY["clients"]


def enrolment(device: object, identity: object) -> dict | None:
    for e in REGISTRY["enrolments"]:
        if e["device_id"] == device and e["key_identity"] == identity:
            return e
    return None


# --- canonical JSON (gateway-mqtt-canonical-json/v1) -----------------------------------------------
def canonical(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
                      allow_nan=False).encode("utf-8")


# --- record bodies (alert-delivery/v1 Records) -------------------------------------------------------
def signed_obj(obj: dict, signer: Signer) -> dict:
    unsigned = {k: v for k, v in obj.items() if k != "signature"}
    sig = signer.key.sign(RECORD_DOMAIN + canonical(unsigned))
    return {**unsigned, "signature": base64.b64encode(sig).decode("ascii")}


def submission_obj(device: str = DEVICE_A, signer: Signer | None = None, **over: object) -> dict:
    signer = signer or DEFAULT_SIGNER[device]
    obj = {"v": 1, "kind": "submission", "device_id": device, "key_identity": signer.identity,
           "alert_id": "q3Jx0bS6lVb8nT2aXw9e1g", "notice": "optional", "class": "grid_power_restored",
           "channel": "sms", "delivery_attempt_id": "Zt4Qm8yK2cR7vP1nL0sW5a", "attempt_seq": 41,
           "attempted_at_ms": T0 + 500, "observation_seq": 1, "prior_outcome": None, "outcome": "accepted",
           "detail": None, "issued_at_ms": T0 + 1000}
    obj.update(over)
    return signed_obj(obj, signer)


def submission(device: str = DEVICE_A, signer: Signer | None = None, **over: object) -> bytes:
    return canonical(submission_obj(device, signer, **over))


def tally(device: str = DEVICE_A, signer: Signer | None = None, **over: object) -> bytes:
    signer = signer or DEFAULT_SIGNER[device]
    obj = {"v": 1, "kind": "withheld_tally", "device_id": device, "key_identity": signer.identity,
           "channel": "whatsapp", "class": None, "reason": "capped", "month": "2026-08", "count": 3,
           "issued_at_ms": T0 + 2000}
    obj.update(over)
    return canonical(signed_obj(obj, signer))


def digest(body: bytes) -> str:
    return "sha256:" + hashlib.sha256(body).hexdigest()


# --- the receiver's record judges: Verifying check 1, then checks 3 to 6 -------------------------------
NOTICES = ("optional", "tier_d", "protection_degraded")
CHANNELS = ("sms", "whatsapp")
OUTCOMES_REC = ("accepted", "failed", "unconfirmed")
DETAILS = {"accepted": (), "failed": ("provider_refused", "provider_reported_failure", "not_submitted"),
           "unconfirmed": ("timeout_after_submit", "response_unreadable")}
ALL_DETAILS = tuple(d for v in DETAILS.values() for d in v)
TRANSITIONS = {(1, None): ("accepted", "failed", "unconfirmed"), (2, "unconfirmed"): ("accepted", "failed"),
               (2, "accepted"): ("failed",), (3, "accepted"): ("failed",)}
SUBMISSION_MEMBERS = ("v", "kind", "device_id", "key_identity", "alert_id", "notice", "class", "channel",
                      "delivery_attempt_id", "attempt_seq", "attempted_at_ms", "observation_seq", "prior_outcome",
                      "outcome", "detail", "issued_at_ms", "signature")
TALLY_MEMBERS = ("v", "kind", "device_id", "key_identity", "channel", "class", "reason", "month", "count",
                 "issued_at_ms", "signature")
DEVICE_RE = re.compile(r"[A-Za-z0-9._-]{1,128}")
ID_RE = re.compile(r"[A-Za-z0-9_-]{16,64}")
IDENTITY_RE = re.compile(r"sha256:[0-9a-f]{64}")
CLASS_RE = re.compile(r"[a-z][a-z0-9_]{0,31}")
MONTH_RE = re.compile(r"[0-9]{4}-(0[1-9]|1[0-2])")


def fold(name: str) -> str:
    return "".join("s" if c == "\u017f" else "k" if c == "\u212a" else c.lower() if "A" <= c <= "Z" else c
                   for c in name)


class Refused(Exception):
    pass


def member_rule(body: bytes) -> object:
    """Payload Member Rule, as far as this corpus's bodies need it: each failure is malformed at check 6."""
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("malformed") from None

    def pairs(items: list) -> dict:
        names = [k for k, _ in items]
        if len(set(names)) != len(names):
            raise Refused("malformed")
        folded = [fold(k) for k in names]
        if len(set(folded)) != len(folded):
            raise Refused("malformed")
        defined = set(SUBMISSION_MEMBERS) | set(TALLY_MEMBERS)
        if any(k not in defined and fold(k) in {fold(d) for d in defined} for k in names):
            raise Refused("malformed")
        return dict(items)
    try:
        obj = json.loads(text, object_pairs_hook=pairs)
    except ValueError:
        raise Refused("malformed") from None
    if not isinstance(obj, dict):
        raise Refused("malformed")
    return obj


def is_int(v: object, lo: int = 1, hi: int = MAX_INT) -> bool:
    return isinstance(v, int) and not isinstance(v, bool) and lo <= v <= hi


def is_str(v: object, pattern: re.Pattern) -> bool:
    return isinstance(v, str) and pattern.fullmatch(v) is not None


def sig_ok(v: object) -> bool:
    if not isinstance(v, str) or len(v) != 88:
        return False
    try:
        raw = base64.b64decode(v, validate=True)
    except ValueError:
        return False
    return len(raw) == 64 and base64.b64encode(raw).decode("ascii") == v


def form_ok(o: dict) -> bool:
    common = (is_str(o.get("device_id"), DEVICE_RE) and is_str(o.get("key_identity"), IDENTITY_RE)
              and o.get("channel") in CHANNELS and (o.get("class") is None or is_str(o.get("class"), CLASS_RE))
              and is_int(o.get("issued_at_ms")) and sig_ok(o.get("signature")))
    if o.get("kind") == "submission":
        return (tuple(sorted(o)) == tuple(sorted(SUBMISSION_MEMBERS)) and common
                and is_str(o["alert_id"], ID_RE) and o["notice"] in NOTICES
                and is_str(o["delivery_attempt_id"], ID_RE) and is_int(o["attempt_seq"])
                and is_int(o["attempted_at_ms"]) and is_int(o["observation_seq"], 1, 3)
                and (o["prior_outcome"] is None or o["prior_outcome"] in OUTCOMES_REC)
                and o["outcome"] in OUTCOMES_REC and (o["detail"] is None or o["detail"] in ALL_DETAILS))
    if o.get("kind") == "withheld_tally":
        return (tuple(sorted(o)) == tuple(sorted(TALLY_MEMBERS)) and common
                and o["reason"] in ("disabled", "capped") and is_str(o["month"], MONTH_RE) and is_int(o["count"]))
    return False


def check6(body: bytes) -> tuple[str | None, dict | None]:
    """Order check 6: the body is a record. The reason or None, and the object when it parsed to one."""
    try:
        obj = member_rule(body)
    except Refused as e:
        return str(e), None
    if canonical(obj) != body:
        return "not_canonical", obj
    v = obj.get("v")
    if is_int(v) and v != 1:
        return "unsupported_version", obj
    if v != 1 or isinstance(v, bool) or not form_ok(obj):
        return "malformed", obj
    return None, obj


def tally_key(o: dict) -> tuple:
    return (o["device_id"], o["key_identity"], o["channel"], o["class"], o["reason"], o["month"])


def check8_reasons(obj: dict) -> list[str]:
    """Verifying checks 3 to 5, each judged where its input exists, in order: the first is the answer."""
    reasons = []
    e = enrolment(obj["device_id"], obj["key_identity"])
    if e is None:
        reasons.append("key_not_enrolled")
    else:
        if e["revoked"]:
            reasons.append("key_revoked")
        pub = Ed25519PublicKey.from_public_bytes(base64.b64decode(e["public_key"].split(":", 1)[1]))
        try:
            pub.verify(base64.b64decode(obj["signature"]),
                       RECORD_DOMAIN + canonical({k: v for k, v in obj.items() if k != "signature"}))
        except InvalidSignature:
            reasons.append("signature_invalid")
    if obj["kind"] == "submission":
        if obj["outcome"] not in TRANSITIONS.get((obj["observation_seq"], obj["prior_outcome"]), ()):
            reasons.append("transition_refused")
        if obj["notice"] != "optional" and obj["class"] is not None:
            reasons.append("class_refused")
        d = obj["detail"]
        if d is not None and (d not in DETAILS[obj["outcome"]]
                              or (obj["prior_outcome"] == "accepted" and d != "provider_reported_failure")
                              or (obj["prior_outcome"] != "accepted" and d == "provider_reported_failure")):
            reasons.append("detail_refused")
    elif obj["reason"] == "disabled" and obj["class"] is None:
        reasons.append("class_refused")
    return reasons


def breaks_consistency(h: dict, o: dict) -> bool:
    """Consistency across records, between a held submission h and a new one o of the same device."""
    if h["kind"] != "submission" or o["kind"] != "submission" or h["device_id"] != o["device_id"] \
            or h["key_identity"] != o["key_identity"]:
        return False
    if h["delivery_attempt_id"] == o["delivery_attempt_id"] and any(
            h[k] != o[k] for k in ("alert_id", "notice", "class", "channel", "attempt_seq", "attempted_at_ms")):
        return True
    if h["alert_id"] == o["alert_id"] and (h["notice"], h["class"]) != (o["notice"], o["class"]):
        return True
    return h["attempt_seq"] == o["attempt_seq"] and h["delivery_attempt_id"] != o["delivery_attempt_id"]


# The complete legal paths of one attempt's observations through the observation table.
LEGAL_PATHS = (("accepted",), ("failed",), ("unconfirmed",), ("unconfirmed", "accepted"), ("unconfirmed", "failed"),
               ("accepted", "failed"), ("unconfirmed", "accepted", "failed"))


def admits_a_path(observations: list[dict]) -> bool:
    """Whether one attempt's observations, held and incoming together, fit at least one complete legal path: each
    at its observation_seq, with its outcome there and its prior_outcome the outcome one step earlier."""
    def fits(path: tuple, o: dict) -> bool:
        n = o["observation_seq"]
        return (n <= len(path) and path[n - 1] == o["outcome"]
                and o["prior_outcome"] == (path[n - 2] if n > 1 else None))
    return any(all(fits(path, o) for o in observations) for path in LEGAL_PATHS)


def check8_verdict(obj: dict, body: bytes, held: list) -> str:
    """Verifying check 6, against the records the receiver holds verified. A record held as conflict counts
    only for duplicate: it is never the earlier record another is judged against."""
    if any(json.loads(h["body"]) == obj for h in held):
        return "duplicate"
    stored = [json.loads(h["body"]) for h in held if h["held_as"] == "stored"]
    if obj["kind"] == "submission":
        ident = (obj["device_id"], obj["key_identity"], obj["delivery_attempt_id"], obj["observation_seq"])
        if any(h["kind"] == "submission"
               and (h["device_id"], h["key_identity"], h["delivery_attempt_id"], h["observation_seq"]) == ident
               for h in stored) or any(breaks_consistency(h, obj) for h in stored):
            return "conflict"
        attempt = [h for h in stored if h["kind"] == "submission" and h["device_id"] == obj["device_id"]
                   and h["key_identity"] == obj["key_identity"]
                   and h["delivery_attempt_id"] == obj["delivery_attempt_id"]]
        if not admits_a_path([*attempt, obj]):
            return "conflict"
        return "stored"
    same_key = [h for h in stored if h["kind"] == "withheld_tally" and tally_key(h) == tally_key(obj)]
    if any(h["count"] == obj["count"] for h in same_key):
        return "conflict"
    if same_key and obj["count"] < max(h["count"] for h in same_key):
        return "lower_count"
    return "stored"


# --- requests -----------------------------------------------------------------------------------------
def nonce(tag: str) -> str:
    return hashlib.sha256(f"ori alert-delivery-transport/v1 nonce {tag}".encode("ascii")).digest()[:16].hex()


def hmac_input(client: str, key_id: str, sent: int, nonce_: str, rdigest: str) -> bytes:
    return HMAC_DOMAIN + canonical({"client_id": client, "key_id": key_id, "method": METHOD, "nonce": nonce_,
                                    "path": PATH, "record_digest": rdigest, "sent_at_ms": sent})


def mac(sec: str, data: bytes) -> str:
    return hmac.new(sec.encode("utf-8"), data, hashlib.sha256).hexdigest()


ZERO_AUTH = "Ori-Alert-HMAC hmac-sha256:" + "0" * 64


def build_request(tag: str, *, body: bytes | None = None, client: str = CLIENT_A, secret_name: str = "gateway-site-a",
                  sent: int = NOW_MS - 2_000, nonce_: str | None = None, digest_header: str | None = None,
                  sign_with: str | None = None, over: dict | None = None, drop: tuple = (),
                  extra: tuple = (), request_line: str = REQUEST_LINE, rename: dict | None = None) -> dict:
    """A request whose headers are well formed and whose HMAC is over the headers as sent, unless told otherwise.
    `over` replaces a header's value, `drop` removes a header, `extra` appends (name, value) pairs, and `rename`
    writes a header under another spelling of its name."""
    body = submission() if body is None else body
    nonce_ = nonce(tag) if nonce_ is None else nonce_
    values = {H_HOST: HOST, H_LEN: str(len(body)), H_CT: CONTENT_TYPE, H_CLIENT: client,
              H_KEY: KEY_IDS[secret_name], H_SENT: str(sent), H_NONCE: nonce_,
              H_DIGEST: digest(body) if digest_header is None else digest_header}
    values.update({k: v for k, v in (over or {}).items() if k != H_AUTH})
    # The HMAC input is built from the headers as sent, wherever X-Ori-Alert-Sent-At-Ms carries an integer's own
    # spelling; sent_at_ms is the integer the header carries.
    data = None
    required_lower = {k.lower() for k in REQUIRED}
    single = not (set(drop) & set(REQUIRED)) and not any(n.lower() in required_lower for n, _ in extra)
    if single and DIGITS_RE.fullmatch(values[H_SENT]):
        data = hmac_input(values[H_CLIENT], values[H_KEY], int(values[H_SENT]), values[H_NONCE], values[H_DIGEST])
    if over and H_AUTH in over:
        values[H_AUTH] = over[H_AUTH]
    elif data is None:
        assert not single, tag
        values[H_AUTH] = ZERO_AUTH
    else:
        values[H_AUTH] = "Ori-Alert-HMAC hmac-sha256:" + mac(SECRETS[sign_with or secret_name], data)
    names = rename or {}
    headers = [[names.get(k, k), values[k]] for k in (*STANDARD, *REQUIRED) if k not in drop]
    headers += [list(p) for p in extra]
    return {"request_line": request_line, "headers": headers, "body": body, "hmac_input": data}


def failing_checks(req: dict, ctx: dict) -> tuple[list[int], dict, str]:
    """Each check of Order judged on its own, so a case can show it is refused for one check alone. Returns the
    failing checks, the reasons of checks 6 to 8, and the 200 verdict when check 8 passes."""
    headers, body = req["headers"], req["body"]
    fails, reasons = [], {}
    if (len(req["request_line"].encode("ascii")) > MAX_REQUEST_LINE or len(headers) > MAX_HEADERS
            or any(len(f"{k}: {v}".encode()) > MAX_HEADER_BYTES for k, v in headers) or len(body) > MAX_BODY
            or not any(k.lower() == H_LEN.lower() for k, _ in headers)
            or any(k.lower() == H_LEN.lower() and v != str(len(body)) for k, v in headers)):
        fails.append(1)
    counts: dict = {}
    for k, v in headers:
        counts.setdefault(k.lower(), []).append(v)
    one = {k: counts[k.lower()][0] for k in (H_CT, *REQUIRED) if len(counts.get(k.lower(), [])) == 1}
    h = {k: one.get(k, "") for k in (H_CT, *REQUIRED)}
    parts = req["request_line"].split(" ")
    sent_ok = SENT_RE.fullmatch(h[H_SENT]) and 1 <= int(h[H_SENT]) <= MAX_INT
    forms = (len(parts) == 3 and parts[0] == METHOD and parts[1] == PATH and len(one) == 1 + len(REQUIRED)
             and h[H_CT].lower() == CONTENT_TYPE
             and PRINTABLE_RE.fullmatch(h[H_CLIENT]) and KEY_ID_RE.fullmatch(h[H_KEY]) and sent_ok
             and NONCE_RE.fullmatch(h[H_NONCE]) and DIGEST_RE.fullmatch(h[H_DIGEST]) and AUTH_RE.fullmatch(h[H_AUTH]))
    if not forms or h[H_DIGEST] != digest(body):
        fails.append(2)
    # A later check is judged only where its inputs exist: one value of each header it reads, an integer's own
    # spelling for sent_at_ms, and, for checks 7 and 8, a body that is a record.
    has = {k: k in one for k in REQUIRED}
    sent = int(h[H_SENT]) if has[H_SENT] and DIGITS_RE.fullmatch(h[H_SENT]) else None
    client = CLIENTS.get(h[H_CLIENT], {})
    if has[H_CLIENT] and has[H_KEY] and h[H_KEY] not in client.get("key_ids", []):
        fails.append(3)
    # Check 4 judged alone: under the secret the key_id names, whether or not this client holds it.
    if all(has.values()) and sent is not None:
        sec = SECRET_BY_KEY_ID.get(h[H_KEY])
        m = AUTH_RE.fullmatch(h[H_AUTH])
        if sec is None or m is None or not hmac.compare_digest(
                m.group(1), mac(sec, hmac_input(h[H_CLIENT], h[H_KEY], sent, h[H_NONCE], h[H_DIGEST]))):
            fails.append(4)
    if has[H_CLIENT] and has[H_KEY] and has[H_NONCE] and sent is not None:
        replayed = [h[H_CLIENT], h[H_KEY], h[H_NONCE]] in ctx["held_nonces"]
        if abs(sent - ctx["now_ms"]) > SKEW_MS or replayed:
            fails.append(5)
    reason, obj = check6(body)
    if reason:
        fails.append(6)
        reasons[6] = reason
    verdict200 = ""
    if reason is None:
        if has[H_CLIENT]:
            e = enrolment(obj["device_id"], obj["key_identity"])
            if obj["device_id"] not in client.get("devices", []) or (
                    e is not None and e["owner"] not in client.get("owners", [])):
                fails.append(7)
                reasons[7] = "not_owned"
        r8 = check8_reasons(obj)
        if r8:
            fails.append(8)
            reasons[8] = r8[0]
            reasons["8_also"] = r8[1:]
        else:
            verdict200 = check8_verdict(obj, body, ctx["held"])
    return fails, reasons, verdict200


def response_for(check: int | None, reason: str | None, verdict200: str, rdigest: str) -> tuple[int, str, str]:
    """The status, response outcome and reason a check's answer carries."""
    if check is None:
        outcome = {"stored": "stored", "conflict": "stored", "duplicate": "duplicate",
                   "lower_count": "superseded"}[verdict200]
        return 200, outcome, "lower_count" if verdict200 == "lower_count" else ""
    if check in (1, 2):
        return 400, "refused", ""
    if check in (3, 4, 5):
        return 401, "refused", ""
    if check == 6:
        return (202, "retry_later", reason) if reason == "unsupported_version" else (400, "refused", reason)
    if check == 7:
        return 403, "refused", reason
    return (202, "retry_later", reason) if reason == "key_not_enrolled" else (422, "refused", reason)


REQUEST_CASES: list[dict] = []


def rq(name: str, note: str, req: dict, check: int | None, *, also: tuple = (), held_nonces: tuple = (),
       held: tuple = (), now_ms: int = NOW_MS, alike: str | None = None, expect200: str = "stored",
       also_reasons: tuple = ()) -> None:
    ctx = {"now_ms": now_ms, "held_nonces": [list(t) for t in held_nonces],
           "held": [{"body": b.decode("ascii"), "held_as": a} for b, a in held]}
    fails, reasons, verdict200 = failing_checks(req, ctx)
    expected = ([check] if check else []) + list(also)
    assert fails == expected, (name, fails, expected)
    if check is None:
        assert verdict200 == expect200, (name, verdict200, expect200)
    assert tuple(reasons.get("8_also", ())) == (also_reasons if check == 8 else tuple(reasons.get("8_also", ()))), \
        (name, reasons.get("8_also"), also_reasons)
    status, outcome, reason = response_for(check, reasons.get(check), verdict200, digest(req["body"]))
    authenticated = check is None or check >= 6
    response = {"outcome": outcome, "reason": reason, "v": 1}
    if authenticated:
        response["record_digest"] = digest(req["body"])
    case: dict = {"name": name, "note": note, "receiver": ctx, "request": {
        "request_line": req["request_line"],
        "headers": req["headers"],
        "body": req["body"].decode("ascii"),
        "body_length": len(req["body"]),
        "body_sha256": digest(req["body"]),
    }}
    if req["hmac_input"] is not None:
        case["hmac_input_hex"] = req["hmac_input"].hex()
    v: dict = {"outcome": "accepted" if check is None else "refused", "check": check, "status": status,
               "authenticated": authenticated, "response_body": canonical(response).decode("ascii")}
    if check is None:
        v["receiver_verdict"] = verdict200
    else:
        v["reason"] = reason
    if also:
        v["precedence"] = {"wins": check, "also_fails": list(also)}
    if check == 8 and also_reasons:
        v["reason_precedence"] = {"wins": reason, "also_fails": list(also_reasons)}
    if alike:
        v["answered_alike_with"] = alike
    case["verdict"] = v
    REQUEST_CASES.append(case)


def requests_corpus() -> None:
    # Accepted at checks 1 to 7, with check 8's 200 verdict.
    rq("accepted_submission", "A submission observation for a device the client may forward for, under the key "
       "enrolled for it, sent 2000 ms before the receiver's clock: stored.", build_request("accepted_submission"),
       None)
    rq("accepted_tally", "A withholding tally: the hop carries either kind of record alike.",
       build_request("accepted_tally", body=tally()), None)
    rq("accepted_client_b", "The second client, under its own secret, for its own device.",
       build_request("accepted_client_b", body=submission(DEVICE_B), client=CLIENT_B, secret_name="gateway-site-b"),
       None)
    rq("accepted_retry_duplicate", "A retry of accepted_submission after its response was lost: the same body and "
       "digest under a fresh sent_at_ms, nonce and HMAC, with the first nonce held and the record held: duplicate.",
       build_request("accepted_retry_duplicate", sent=NOW_MS - 1_000), None,
       held_nonces=((CLIENT_A, KEY_IDS["gateway-site-a"], nonce("accepted_submission")),),
       held=((submission(), "stored"),), expect200="duplicate")
    rq("accepted_conflict_stored", "Different bytes under an observation identity the receiver holds: held as "
       "conflict, answered stored.", build_request("accepted_conflict_stored", body=submission(issued_at_ms=T0 + 1001)),
       None, held=((submission(), "stored"),), expect200="conflict")
    rq("accepted_lower_count_superseded", "A tally whose count is below the greatest held for its key: "
       "lower_count, answered superseded.", build_request("accepted_lower_count_superseded", body=tally(count=3)),
       None, held=((tally(count=5, issued_at_ms=T0 + 3000), "stored"),), expect200="lower_count")
    rq("accepted_moved_device_new_key", "The moved device, forwarded by its new site's client, under the key "
       "enrolled since it moved, which names that site.",
       build_request("accepted_moved_device_new_key", body=submission(DEVICE_MOVED), client=CLIENT_B,
                     secret_name="gateway-site-b"), None)
    rq("accepted_skew_at_bound_past", "sent_at_ms exactly 300000 ms before the receiver's clock: within the bound.",
       build_request("accepted_skew_at_bound_past", sent=NOW_MS - SKEW_MS), None)
    rq("accepted_skew_at_bound_future", "sent_at_ms exactly 300000 ms after the receiver's clock: within the bound.",
       build_request("accepted_skew_at_bound_future", sent=NOW_MS + SKEW_MS), None)
    shared = nonce("shared_nonce")
    rq("accepted_nonce_held_for_other_client", "The nonce is held, but under another (client_id, key_id): the "
       "reservation is of the triple, so this is no replay.",
       build_request("accepted_nonce_held_for_other_client", nonce_=shared), None,
       held_nonces=((CLIENT_B, KEY_IDS["gateway-site-b"], shared),))
    rq("accepted_client_id_escaped", "A client identifier with a space, a quotation mark and a backslash, all "
       "printable ASCII: its HMAC input carries them escaped under gateway-mqtt-canonical-json/v1.",
       build_request("accepted_client_id_escaped", client=CLIENT_ESCAPED, secret_name="gateway-escaped"), None)
    rq("accepted_client_id_128", "A client identifier of 128 characters, the bound.",
       build_request("accepted_client_id_128", client=CLIENT_LONG, secret_name="gateway-long"), None)
    pads = tuple((f"X-Pad-{i:02d}", "p") for i in range(MAX_HEADERS - len(STANDARD) - len(REQUIRED)))
    rq("accepted_32_headers", "Host, Content-Length, Content-Type, the six required headers and 23 others: 32 "
       "headers, the bound.", build_request("accepted_32_headers", extra=pads), None)
    rq("accepted_header_1024_bytes", "One header of exactly 1024 bytes, counted as its name, `: ` and its value.",
       build_request("accepted_header_1024_bytes", extra=(("X-Pad", "p" * (MAX_HEADER_BYTES - len("X-Pad: "))),)),
       None)
    rq("accepted_content_type_other_case", "Content-Type Application/Octet-Stream: the media type is compared "
       "without regard to case.", build_request("accepted_content_type_other_case",
                                                over={H_CT: "Application/Octet-Stream"}), None)
    rq("accepted_header_names_other_case", "Required headers named in other case: x-ori-alert-nonce and "
       "AUTHORIZATION. Names are compared without regard to case.",
       build_request("accepted_header_names_other_case", rename={H_NONCE: "x-ori-alert-nonce",
                                                                  H_AUTH: "AUTHORIZATION"}), None)



def requests_corpus_refused() -> None:
    # Check 1.
    pads = tuple((f"X-Pad-{i:02d}", "p") for i in range(MAX_HEADERS + 1 - len(STANDARD) - len(REQUIRED)))
    rq("check1_33_headers", "33 headers, Host and Content-Length counted, one past the bound; every required "
       "header is present once and well formed.", build_request("check1_33_headers", extra=pads), 1)
    rq("check1_header_over_1024_bytes", "One header of 1025 bytes, counted as its name, `: ` and its value.",
       build_request("check1_header_over_1024_bytes",
                     extra=(("X-Pad", "p" * (MAX_HEADER_BYTES + 1 - len("X-Pad: "))),)), 1)
    rq("check1_content_length_mismatch", "Content-Length one more than the body's length; every other header "
       "matches the body.", build_request("check1_content_length_mismatch",
                                          over={H_LEN: str(len(submission()) + 1)}), 1)
    rq("check1_content_length_absent", "No Content-Length header: it must be present, and equal to the body's "
       "length.", build_request("check1_content_length_absent", drop=(H_LEN,)), 1)
    rq("check1_content_length_short", "Content-Length one less than the body's length.",
       build_request("check1_content_length_short", over={H_LEN: str(len(submission()) - 1)}), 1)
    long_path = PATH + "/" + "p" * (MAX_REQUEST_LINE - len(REQUEST_LINE))
    rq("precedence_1_over_2_long_path", "A request line of 1025 bytes made by a longer path: check 1 is first, and "
       "the target, not exactly the path, would fail check 2.",
       build_request("precedence_1_over_2_long_path", request_line=f"{METHOD} {long_path} HTTP/1.1"), 1, also=(2,))
    padded = submission() + b" " * (MAX_BODY + 1 - len(submission()))
    rq("check1_body_over_limit", "A body of 4097 bytes, one past the bound: a record padded with spaces, its digest "
       "header and HMAC over the padded bytes. The padding also makes it not_canonical at check 6.",
       build_request("check1_body_over_limit", body=padded), 1, also=(6,))
    # Check 2: the target and header forms.
    base = "check2_"
    rq(base + "query", "The request target is the path with a query: not exactly the path.",
       build_request(base + "query", request_line=f"{METHOD} {PATH}?x=1 HTTP/1.1"), 2)
    rq(base + "method_put", "The method PUT on the exact path. The HMAC input names POST, as it always does, and is "
       "valid; only the method refuses it.", build_request(base + "method_put",
                                                            request_line=f"PUT {PATH} HTTP/1.1"), 2)
    rq(base + "method_lower", "The method post in lower case: HTTP methods are case-sensitive, so not POST.",
       build_request(base + "method_lower", request_line=f"post {PATH} HTTP/1.1"), 2)
    rq(base + "client_empty", "An empty X-Ori-Alert-Client. The registry holds no such client, so checks 3 and 7 "
       "would refuse it too; check 2 is first.", build_request(base + "client_empty", client=""), 2, also=(3, 7))
    rq(base + "client_129", "An X-Ori-Alert-Client of 129 characters, one past the bound.",
       build_request(base + "client_129", client="g" * 129), 2, also=(3, 7))
    rq(base + "client_control", "An X-Ori-Alert-Client holding a DEL character, outside printable ASCII.",
       build_request(base + "client_control", client=CLIENT_A[:-1] + "\x7f"), 2, also=(3, 7))
    rq(base + "key_id_upper", "An X-Ori-Alert-Key-Id in upper-case hexadecimal: not of its form. The HMAC is over "
       "the header as sent.", build_request(base + "key_id_upper", over={
           H_KEY: KEY_IDS["gateway-site-a"].upper().replace("HKDF-SHA256", "hkdf-sha256")}), 2, also=(3, 4))
    rq(base + "sent_zero", "X-Ori-Alert-Sent-At-Ms of 0, below 1. The HMAC is valid over the integer 0, so only "
       "freshness would also refuse it.", build_request(base + "sent_zero", sent=0), 2, also=(5,))
    rq(base + "sent_over_max", "X-Ori-Alert-Sent-At-Ms of 9007199254740992, one past 2^53 - 1, with a valid HMAC "
       "over that integer.", build_request(base + "sent_over_max", sent=MAX_INT + 1), 2, also=(5,))
    rq(base + "sent_leading_zero", "X-Ori-Alert-Sent-At-Ms with a leading zero: no integer's own spelling, so "
       "neither the HMAC input nor freshness has a sent_at_ms, and Authorization is a fixed well-formed value.",
       build_request(base + "sent_leading_zero", over={H_SENT: "0" + str(NOW_MS - 2_000), H_AUTH: ZERO_AUTH}), 2)
    rq(base + "nonce_upper", "An X-Ori-Alert-Nonce in upper-case hexadecimal.",
       build_request(base + "nonce_upper", nonce_=nonce(base + "nonce_upper").upper()), 2)
    rq(base + "nonce_short", "An X-Ori-Alert-Nonce of 30 hexadecimal characters, 15 bytes.",
       build_request(base + "nonce_short", nonce_=nonce(base + "nonce_short")[:30]), 2)
    rq(base + "digest_upper", "An X-Ori-Alert-Record-Digest in upper-case hexadecimal.",
       build_request(base + "digest_upper", digest_header="sha256:" + hashlib.sha256(submission()).hexdigest().upper()),
       2)
    rq(base + "digest_mismatch", "A well-formed X-Ori-Alert-Record-Digest over other bytes than the body, and an "
       "HMAC over the header as sent: only the recomputed digest refuses it.",
       build_request(base + "digest_mismatch", digest_header=digest(submission(attempt_seq=42))), 2)
    good = build_request(base + "auth_scheme")
    rq(base + "auth_scheme", "An Authorization header with a valid HMAC under another scheme name.",
       build_request(base + "auth_scheme", over={H_AUTH: good["headers"][-1][1].replace("Ori-Alert-HMAC ", "Bearer ")}),
       2, also=(4,))
    good = build_request(base + "auth_upper")
    rq(base + "auth_upper", "An Authorization header whose HMAC is the right value in upper-case hexadecimal.",
       build_request(base + "auth_upper", over={
           H_AUTH: "Ori-Alert-HMAC hmac-sha256:" + good["headers"][-1][1].rsplit(":", 1)[1].upper()}), 2, also=(4,))
    rq(base + "nonce_missing", "No X-Ori-Alert-Nonce header: no HMAC input exists, and Authorization is a fixed "
       "well-formed value. Neither check 4 nor check 5 has its inputs.",
       build_request(base + "nonce_missing", drop=(H_NONCE,)), 2)
    rq(base + "authorization_missing", "No Authorization header: a missing header is a header form, at check 2, and "
       "no HMAC input exists.", build_request(base + "authorization_missing", drop=(H_AUTH,)), 2)
    rq(base + "client_twice", "X-Ori-Alert-Client twice, both copies the same value: each required header is "
       "present exactly once. No HMAC input exists, and checks 3, 4, 5 and 7 lack a single client identifier.",
       build_request(base + "client_twice", extra=((H_CLIENT, CLIENT_A),)), 2)
    rq(base + "client_twice_different", "X-Ori-Alert-Client twice with different values, the first the client "
       "whose key_id and device the request carries and the last another client the registry holds. There is no "
       "single client identifier, so neither check 3 nor check 7 has its input: a judge that kept the last value "
       "would refuse it at 3 and 7 as well, and one that kept the first would accept it there.",
       build_request(base + "client_twice_different", extra=((H_CLIENT, CLIENT_B),)), 2)
    rq(base + "nonce_twice_other_case", "X-Ori-Alert-Nonce twice, once in other case: names compared without "
       "regard to case are the same header, present twice. No HMAC input exists.",
       build_request(base + "nonce_twice_other_case", extra=(("x-ori-alert-nonce", nonce(base + "x")),)), 2)
    rq(base + "content_type_missing", "No Content-Type header.",
       build_request(base + "content_type_missing", drop=(H_CT,)), 2)
    rq(base + "content_type_parameter", "Content-Type application/octet-stream with a parameter: the media type "
       "takes none.", build_request(base + "content_type_parameter",
                                    over={H_CT: "application/octet-stream; charset=x"}), 2)
    rq(base + "content_type_other", "Content-Type application/json.",
       build_request(base + "content_type_other", over={H_CT: "application/json"}), 2)
    # Check 3.
    rq("check3_key_id_unheld", "A well-formed key_id the receiver holds for no client, with a valid HMAC under the "
       "secret it derives from: the credential is selected by (client_id, key_id), never by trial verification.",
       build_request("check3_key_id_unheld", secret_name="unheld"), 3)
    rq("check3_key_id_of_other_client", "Client A's request under client B's key_id and a valid HMAC under B's "
       "secret: a key_id held for another client selects nothing.",
       build_request("check3_key_id_of_other_client", secret_name="gateway-site-b"), 3)
    # Check 4.
    rq("check4_hmac_other_secret", "An HMAC under client B's secret beside client A's key_id.",
       build_request("check4_hmac_other_secret", sign_with="gateway-site-b"), 4)
    auth = build_request("check4_hmac_flipped")["headers"][-1][1]
    rq("check4_hmac_flipped", "The right HMAC with its last hexadecimal character changed.",
       build_request("check4_hmac_flipped", over={H_AUTH: auth[:-1] + ("0" if auth[-1] != "0" else "1")}), 4)
    rq("check4_hmac_over_other_digest", "An HMAC computed over another record's digest; the digest header names "
       "this body.", build_request("check4_hmac_over_other_digest", over={
           H_AUTH: "Ori-Alert-HMAC hmac-sha256:" + mac(SECRETS["gateway-site-a"], hmac_input(
               CLIENT_A, KEY_IDS["gateway-site-a"], NOW_MS - 2_000, nonce("check4_hmac_over_other_digest"),
               digest(submission(attempt_seq=42))))}), 4)
    rq("check4_hmac_raw_secret_key", "An HMAC keyed with the secret's 32 decoded bytes, not its UTF-8 bytes.",
       build_request("check4_hmac_raw_secret_key", over={H_AUTH: "Ori-Alert-HMAC hmac-sha256:" + hmac.new(
           bytes.fromhex(SECRETS["gateway-site-a"]), hmac_input(
               CLIENT_A, KEY_IDS["gateway-site-a"], NOW_MS - 2_000, nonce("check4_hmac_raw_secret_key"),
               digest(submission())), hashlib.sha256).hexdigest()}), 4)
    # Check 5.
    rq("check5_skew_past_bound_past", "sent_at_ms 300001 ms before the receiver's clock: one past the bound.",
       build_request("check5_skew_past_bound_past", sent=NOW_MS - SKEW_MS - 1), 5)
    rq("check5_skew_past_bound_future", "sent_at_ms 300001 ms after the receiver's clock: one past the bound.",
       build_request("check5_skew_past_bound_future", sent=NOW_MS + SKEW_MS + 1), 5)
    n = nonce("check5_nonce_reused")
    rq("check5_nonce_reused", "The (client_id, key_id, nonce) triple is already reserved: a transport replay, "
       "although sent_at_ms, the HMAC and the body are fresh.",
       build_request("check5_nonce_reused", nonce_=n, sent=NOW_MS - 500), 5,
       held_nonces=((CLIENT_A, KEY_IDS["gateway-site-a"], n),))
    # Check 6.
    record = submission()
    pretty = json.dumps(json.loads(record), sort_keys=True, indent=1).encode("ascii")
    rq("check6_not_canonical", "The record's members, indented: not the canonical bytes of the object it parses to.",
       build_request("check6_not_canonical", body=pretty), 6)
    rq("check6_unsupported_version", "A record whose v is 2, signed as such: unsupported_version, a 202 the "
       "receiver's state may cure.", build_request("check6_unsupported_version", body=submission(v=2)), 6)
    rq("check6_unsupported_version_max", "A record whose v is 2^53 - 1, the greatest integer the integer rule "
       "admits: unsupported_version.", build_request("check6_unsupported_version_max", body=submission(v=MAX_INT)), 6)
    rq("check6_malformed_v_zero", "A record whose v is 0, signed as such: outside the integer rule, so malformed, "
       "never unsupported_version.", build_request("check6_malformed_v_zero", body=submission(v=0)), 6)
    rq("check6_malformed_v_negative", "A record whose v is -1: outside the integer rule, so malformed.",
       build_request("check6_malformed_v_negative", body=submission(v=-1)), 6)
    rq("check6_malformed_v_over_max", "A record whose v is 2^53, one past the integer rule: malformed.",
       build_request("check6_malformed_v_over_max", body=submission(v=MAX_INT + 1)), 6)
    no_detail = {k: v for k, v in submission_obj().items() if k != "detail"}
    rq("check6_malformed_member_absent", "A submission observation without its detail member.",
       build_request("check6_malformed_member_absent", body=canonical(no_detail)), 6)
    rq("check6_malformed_kind", "A record whose kind is neither value.",
       build_request("check6_malformed_kind", body=submission(kind="observation")), 6)
    rq("check6_malformed_outcome_delivered", "A submission observation whose outcome is delivered, a reserved value "
       "outside the form.", build_request("check6_malformed_outcome_delivered", body=submission(outcome="delivered")),
       6)
    rq("check6_malformed_not_json", "A body that is not JSON.",
       build_request("check6_malformed_not_json", body=b"alert-delivery record"), 6)
    rq("check6_malformed_not_object", "A body that is a JSON array holding the record: not one JSON object.",
       build_request("check6_malformed_not_object", body=b"[" + record + b"]"), 6)
    rq("check6_malformed_trailing_data", "The record followed by a second value: not one JSON object.",
       build_request("check6_malformed_trailing_data", body=record + b"{}"), 6)
    dup = record[:-1] + b',"v":1}'
    rq("check6_malformed_member_twice", "The record with v named twice, the second after its last member.",
       build_request("check6_malformed_member_twice", body=dup), 6)
    variant = record[:-1] + b',"Device_id":"' + DEVICE_A.encode() + b'"}'
    rq("check6_malformed_case_variant_member", "The record with a Device_id member beside device_id: a case "
       "variant under the Payload Member Rule's closed fold.",
       build_request("check6_malformed_case_variant_member", body=variant), 6)
