CONFIG_MUTANTS = [
    "cfg_drop:unknown_device", "cfg_drop:malformed_key", "cfg_drop:inadmissible_key",
    "cfg_drop:duplicate_key", "cfg_drop:required_under_posture", "cfg_state_dir_last",
    "cfg_swap_entry:unknown_device,malformed_key",
