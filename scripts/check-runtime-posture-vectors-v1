    "posture": ROOT / "runtime-posture" / "v1.md",
    "gateway_api": ROOT / "gateway-api" / "v2.md",
    "gateway_config": ROOT / "gateway-config" / "v2.md",
    "operator_socket": ROOT / "operator-socket" / "v3.md",
    "lan": ROOT / "lan-app-api" / "v1.md",
    "admission": ROOT / "ed25519-key-admission" / "v1.md",
    "verification": ROOT / "ed25519-verification" / "v1.md",
    "canonical": ROOT / "gateway-mqtt-canonical-json" / "v1.md",
}

sys.setrecursionlimit(20000)


class Failure(Exception):
    pass


