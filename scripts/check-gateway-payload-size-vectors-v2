"""Check the gateway-api/v2 Payload Size corpus against the contract.

Shares no code with scripts/generate-gateway-payload-size-vectors-v2. The
topics and their maxima, the verdict names, the constructions and the corpus
digest are read from gateway-api/v2.md Payload Size; every payload is built
here from its construction and compared by digest.

Held to:

- every case: its bytes, built here, have its digest; its verdict is the one
  the maximum in force decides, and a configured maximum above the table is
  refused;
- the table: every topic the contract names in backticks, whatever its
  characters, has a maximum, and every maximum names a topic; subscription
  filters, source paths and the namespace placeholder are not topics;
- coverage, for every topic the table holds, the alert-delivery record and
  acknowledgement rows included: a json_object payload at the maximum, one byte
  over and four times over; an invalid_utf8 payload one byte over; a configured
  maximum half the table's, at and one over, refused where the half lies below
  the floor; one a byte above the table; and one a byte below the floor;
- paging: the pages and the terminal error the export rule gives, with an
  oversized item, several pages and an exact fill among the cases;
- envelopes: each evidence payload at its bound, rebuilt here with its own
  serialiser, decided by the table; the device_id bound agrees with the
  pattern runtime-config/v2 declares, and the types and reasons are the
  longest the contract's vocabularies hold;
- runtime reporting: the `mqtt_ingress` block Payload Volume links exists in
  runtime-health/v4, counts exactly the size, volume and member refusals as
  integers, cites the three sections, and names families as Payload Size does;
- the alert-delivery acknowledgement reply: its members are the ones Runtime
  Alert Delivery Acknowledgement shows, `outcome` `refused`, and `reason` the
  longest that alert-delivery/v1 Carriage and custody lets a refused
  acknowledgement carry, derived here from its numbered checks;
- the digest the contract pins is the corpus's.

    python3 scripts/check-gateway-payload-size-vectors-v2
    python3 scripts/check-gateway-payload-size-vectors-v2 --mutations
"""

from __future__ import annotations

import base64
import copy
import hashlib
import json
import pathlib
import re
import sys
from typing import Callable

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "gateway-api" / "v2.md"
CORPUS = ROOT / "gateway-api" / "vectors" / "payload-size-v2.json"
RUNTIME_SCHEMA = ROOT / "runtime-config" / "vectors" / "schema.json"
RUNTIME_HEALTH = ROOT / "runtime-health" / "v4.md"
ALERT_DELIVERY = ROOT / "alert-delivery" / "v1.md"
DIRECTIONS = {"Gateway -> Runtime": "gateway_to_runtime",
              "Runtime -> Gateway": "runtime_to_gateway"}
# The rule's own sentences, held word for word: the order, the length basis,
# the refusal's silence, the record, and the lower-only configuration. A data
# check cannot see any of them change.
HELD = (
    "A payload's length is the length of the MQTT application message exactly as "
    "delivered, before it is decrypted, decoded or read.",
    "Size is the first check, because it bounds the cost of every check after it.",
    "A receiver compares a payload's length with its topic's maximum before it parses, "
    "decodes, decrypts or verifies anything.",
    "It is not answered, since none of its members can be relied on, and it changes no "
    "state.",
    "The refusal is recorded with the topic family and the payload's size class, the least "
    "power of two not below its length, and never with its contents or a device identifier.",
    "Where an implementation offers a setting for a topic's maximum, a deployment may "
    "configure a lower maximum, never a higher one, and never below 4096 bytes.",
    "A producer never publishes a payload longer than its topic's maximum.",
    "A producer sizes and pages against the maximum in force for the topic it publishes, "
    "its own configured value where one is set, so a deployment that lowers a receiver's "
    "maximum lowers the producer's to match; a receiver that applies a lower maximum than "
    "its producer refuses conforming payloads above it.",
    "a courier cannot shrink a conforming artifact, and an inbound artifact refused for size "
    "would be redelivered without end.",
    "The runtime treats the escalation or the enrichment as unavailable at once, without "
    "waiting out its timeout.",
    "lists in `active_triggers` at most 64 names, in the order the runtime holds them, and "
    "only those that keep the payload within its maximum; it never omits another member to "
    "make room.",
    "A consumer reads the number of names as a lower bound on the triggers active, never as "
    "their count.",
    "Size and volume refusals are reported in each side's own health. A gateway reports them "
    "in its operational posture, below. A runtime reports them, with its Payload Member Rule "
    "refusals, in the `mqtt_ingress` block of "
    "[runtime-health/v4.md](../runtime-health/v4.md#mqtt_ingress-object), which its remote "
    "health projection carries.",
    "whose value is an object with exactly two integer members, `payload_too_large` and "
    "`volume_dropped`",
    "holds as many items as keep the payload, after encryption, encoding and `auth`, within "
    "the maximum, and at least one; `next_page_token` continues from the first item not "
    "returned.",
    "is replaced by the family's error response, with `error` `response_too_large`, so the "
    "runtime does not wait for an answer that will not come.",
    "a peer can never raise them: no payload, envelope or configuration the other side "
    "controls changes a bound.",
    "An item that does not fit in a page by itself ends the export with an error response "
    "whose `error` is `item_exceeds_payload_maximum`, and the gateway does not request that "
    "page again.",
    "is published as the canonical JSON of the whole payload, `auth` included, under the "
    "canonicalisation of [Artifact Bytes](#artifact-bytes), so the artifact occupies exactly "
    "its canonical bytes. This bounds size only: a receiver neither checks it nor relies on "
    "it, and Artifact Bytes is unchanged.",
    "whose canonical bytes exceed 1048576 cannot be carried on this hop, as an outbound "
    "artifact of that size cannot. The gateway's staging admits no artifact it could not "
    "carry, so a response carrying one is a response carrying an authority artifact the "
    "gateway cannot durably stage, which evidence-transport/v2 already decides: an "
    "unrecognised outcome for that attempt, the queue entry retained and backed off, the "
    "artifacts already staged staying staged, and delivery reported degraded. No such "
    "artifact is ever published to the runtime.",
    "An authority that keeps returning one holds that entry at the head of that device's "
    "lane, as any unrecognised response does, and evidence-transport/v2 keeps the device's "
    "other lane and every other device moving.",
    "Every row counts its routing members at their bounds. A runtime refuses at load a "
    "`device.id` outside the pattern",
    "a runtime refuses an export request whose `request_id` is outside it, unanswered, as it "
    "refuses an oversized payload.",
    "fits within 4096 bytes, the floor, so no permitted configuration refuses one",
    "An error response carries an `error` of at most 128 Unicode scalar values and no other "
    "free-form content: its routing, correlation, authentication and protocol members keep "
    "the values their family requires, and every other free-form string, such as `text`, "
    "`model` or the enrichment's optional strings, is empty or, where its family lets it, "
    "omitted.",
    "A gateway configuration may still name an identity outside it, as gateway-config/v2's "
    "compatibility rule allows, but no conforming runtime answers to one, so these maxima "
    "hold wherever a conforming runtime is on the other end.",
    # The coverage paragraph applies to every row, so a row added to the table, such as
    # the alert-delivery record and acknowledgement, owes every class below.
    "For every topic in the table the corpus holds a `json_object` payload at the maximum, "
    "one byte over it, and four times it; an `invalid_utf8` payload one byte over the "
    "maximum, refused for its size before anything else; a configured maximum half the "
    "table's, with payloads at it and one byte over; a configured maximum one byte above the "
    "table's, refused; and one a byte below the floor, refused.",
)


class Failure(Exception):
    pass


def _section(text: str, heading: str) -> str:
    start = text.index("\n" + heading + "\n")
    body = text[start + len(heading) + 2:]
    stop = re.search(r"^## ", body, re.M)
    return body if stop is None else body[:stop.start()]


def _vocabulary(flat: str, pattern: str, what: str) -> list[str]:
    found = re.search(pattern, flat)
    if found is None:
        raise Failure(f"gateway-api/v2 no longer states {what}")
    return re.findall(r"`([a-z_]+)`", found.group(1))


# alert-delivery/v1 Carriage and custody, word for word: which checks are answered, that a
# replayed record is answered `queued`, and the reasons a refusal carries.
CUSTODY_HELD = (
    "After the queue commit, or a refusal at checks 3 to 7 for a configured device, the "
    "gateway publishes an acknowledgement",
    "A message refused at check 5 is not acknowledged",
    "`outcome` is `queued` for a commit or a `replayed` record, and `refused` otherwise, with "
    "`reason` the check's reason, `queue_full` or `store_unavailable`.",
)


def alert_ack_model(text: str, delivery: str) -> dict:
    """The acknowledgement's members, from the example under Runtime Alert Delivery
    Acknowledgement, and the reasons a refused one can carry, from alert-delivery/v1's
    numbered checks: checks 3 to 7, less check 5, which is not answered, less `replayed`,
    which is answered `queued`, with `queue_full` and `store_unavailable` added."""
    section = _section(text, "## Runtime Alert Delivery Acknowledgement")
    example = re.search(r"```json\n(.*?)\n```", section, re.S)
    if example is None:
        raise Failure("Runtime Alert Delivery Acknowledgement shows no example")
    shown = json.loads(example.group(1))
    flat = " ".join(delivery.split())
    for sentence in CUSTODY_HELD:
        if sentence not in flat:
            raise Failure(f"alert-delivery/v1 no longer says: {sentence!r}")
    custody = _section(delivery, "## Carriage and custody")
    checks = dict(re.findall(r"^(\d+)\. (.*?)(?=^\d+\. |\n\n)", custody, re.M | re.S))
    if sorted(checks) != [str(n) for n in range(1, 8)]:
        raise Failure(f"alert-delivery/v1 Carriage and custody numbers checks {sorted(checks)}")
    said = {n: re.findall(r"(?::|\bis)\s+`([a-z_]+)`", " ".join(body.split()))
            for n, body in checks.items()}
    if not all(said[str(n)] for n in range(3, 8)):
        raise Failure(f"alert-delivery/v1 checks 3 to 7 do not each name a reason: {said}")
    reasons = {r for n in ("3", "4", "6", "7") for r in said[n]} - {"replayed"}
    reasons |= {"queue_full", "store_unavailable"}
    return {"members": shown, "reasons": sorted(reasons)}


def contract_model(text: str | None = None, schema: str | None = None,
                   health: str | None = None, delivery: str | None = None) -> dict:
    text = CONTRACT.read_text() if text is None else text
    delivery = ALERT_DELIVERY.read_text() if delivery is None else delivery
    schema = RUNTIME_SCHEMA.read_text() if schema is None else schema
    health = RUNTIME_HEALTH.read_text() if health is None else health
    size = _section(text, "## Payload Size")
    rows = re.findall(r"^\| `([^`]+)` \| (Gateway -> Runtime|Runtime -> Gateway) \| (\d+) \|",
                      size, re.M)
    if not rows:
        raise Failure("Payload Size holds no table of maxima")
    table = {topic: (DIRECTIONS[direction], int(maximum)) for topic, direction, maximum in rows}
    if len(table) != len(rows):
        raise Failure("a topic is listed twice in the Payload Size table")
    flat = " ".join(size.split())
    reason = re.search(r"A payload longer than the maximum is refused as `([a-z_]+)`", flat)
    verdicts = re.search(r"a verdict: `([a-z_]+)`, when the length is within the maximum in force.*?"
                         r"`([a-z_]+)`; or `([a-z_]+)`, when the configured maximum is above the "
                         r"table", flat)
    head = re.search(r"`json_object`: the bytes `([^`]+)`, then `(.)` repeated to make up the "
                     r"length, then `([^`]+)`", flat)
    fill = re.search(r"`invalid_utf8`: the byte `0x([0-9A-F]{2})` repeated", flat)
    pin = re.search(r"\[vectors/payload-size-v2\.json\]\(vectors/payload-size-v2\.json\) holds "
                    r"this section's cases\. Its SHA-256 is `([0-9a-f]{64})`", flat)
    lower = "may configure a lower maximum, never a higher one" in flat
    whole = " ".join(text.split())
    for sentence in HELD:
        if sentence not in whole:
            raise Failure(f"gateway-api/v2 no longer says: {sentence!r}")
    floor = re.search(r"never below (\d+) bytes", flat)
    if floor is None:
        raise Failure("Payload Size states no floor for a configured maximum")
    if None in (reason, verdicts, head, fill, pin) or not lower:
        raise Failure("Payload Size changed shape: reason, verdicts, constructions, pin or "
                      "the lower-only rule")
    assert reason and verdicts and head and fill and pin
    if verdicts.group(2) != reason.group(1):
        raise Failure("the corpus verdict for an oversized payload is not the refusal reason")
    # Every topic the contract names anywhere has a maximum, and every maximum
    # names one: literal topics only, since a filter with + or # is a
    # subscription, not a topic a payload travels on.
    # Every backticked ori/ string, whatever characters it holds, so a topic
    # spelled with a hyphen or a dot is not skipped; only subscription filters,
    # source paths and the namespace placeholder are not topics.
    defined = {
        s for s in re.findall(r"`(ori/[^`]*)`", text)
        if not ("+" in s or "#" in s or s.endswith(".py") or s.endswith("/..."))
    }
    item_error = re.search(r"An item that does not fit in a page by itself ends the export with an "
                           r"error response whose `error` is `([a-z_]+)`", flat)
    if item_error is None:
        raise Failure("Payload Size names no error for an item that does not fit alone")
    lowered = re.search(r"The evidence topics, `([^`]+)` and `([^`]+)`, are never lowered", flat)
    if lowered is None:
        raise Failure("Payload Size names no topic that is never lowered")
    never_lowered = set(lowered.groups())
    # The coverage paragraph's account of which configured halves are refused: the evidence
    # topics, and a topic whose maximum is the floor, whose half lies below it.
    halves = re.search(r"For the evidence topics, which are never lowered, (and for a topic whose "
                       r"maximum is the floor, whose half lies below it, )?the configured half is "
                       r"refused as well\.", flat)
    if halves is None:
        raise Failure("Payload Size no longer says which configured halves are refused")
    if defined != set(table):
        raise Failure("this recognises topics written in backticks only; "
                      f"topics without a maximum {sorted(defined - set(table))}, maxima for no "
                      f"topic {sorted(set(table) - defined)}")
    whole_flat = " ".join(text.split())
    routing = re.search(r"so a `device_id` on this hop is at most (\d+) ASCII characters", flat)
    declared = json.loads(schema)["properties"]["device"]["properties"]["id"]["pattern"]
    # One bracket class and one {1,N}, nothing else: a prefix or a second atom
    # would admit lengths no suffix shows.
    shape = re.fullmatch(r"\^\[([ -~]+?)\]\{1,(\d+)\}\$", declared)
    if routing is None or shape is None or "]" in shape.group(1) or "[" in shape.group(1):
        raise Failure(f"device.id pattern {declared!r} is not one ASCII bracket class with a "
                      "{1,N} bound, or Payload Size states no device_id bound")
    if routing.group(1) != shape.group(2):
        raise Failure(f"Payload Size counts device_id at {routing.group(1)} characters, "
                      f"runtime-config/v2 declares {shape.group(2)}")
    admitted = {chr(c) for c in range(128) if re.fullmatch(declared, chr(c))}
    unsafe = admitted & set("/+#|${}\"\\ \t\r\n\x00\x7f")
    if unsafe or not admitted:
        raise Failure(f"device.id pattern admits {sorted(unsafe)}")
    if f"`{declared}`" not in flat:
        raise Failure("Payload Size does not quote the pattern runtime-config/v2 declares")
    request_bound = re.search(r"A `request_id` is 1 to (\d+) characters from the same set", flat)
    error_bound = re.search(r"an `error` of at most (\d+) Unicode scalar values", flat)
    event_bound = re.search(r"`action_event_type` is at most (\d+) ASCII characters", flat)
    if None in (request_bound, error_bound, event_bound):
        raise Failure("Payload Size no longer bounds request_id, error or action_event_type")
    assert request_bound and error_bound and event_bound
    export_types = re.search(r"^\| `export_type` +\| +yes \| One of (.*?)\. \|$", text, re.M)
    tokens = re.findall(r"^\| `([a-z_]+)` \| (?:`degraded`|`critical`|none) +\|",
                        _section(text, "### `degradation_reasons`"), re.M)
    gateway_status = re.search(r'"status": "([a-z|]+)",\n  "uptime_s"', text)
    provider = re.search(r'"provider": "([a-z_|]+)"', text)
    if None in (export_types, gateway_status, provider) or not tokens:
        raise Failure("gateway-api/v2 no longer states export types, degradation tokens, or "
                      "the gateway heartbeat's status and provider")
    assert export_types and gateway_status and provider
    ingress_refusals(health, text)
    inbound_bound = re.search(r"An authority artifact of at most (\d+) canonical bytes", flat)
    outbound_bound = re.search(r"An artifact of at most (\d+) bytes \(evidence-transport/v2\)",
                               flat)
    if inbound_bound is None or outbound_bound is None:
        raise Failure("the evidence rows no longer state their artifact bounds")
    types_section = _section(text, "### Artifact Type Vocabulary")
    inbound_types = re.findall(r"^\| `([a-z_]+)` +\|", types_section, re.M)
    rejections = re.findall(r"^\| `([a-z_]+)` +\| (?:yes|\*\*no\*\*) ", text, re.M)
    if not inbound_types or not rejections:
        raise Failure("gateway-api/v2 no longer tabulates inbound types or rejection reasons")
    if ("and, for the alert-delivery acknowledgement of *Runtime Alert Delivery "
            "Acknowledgement*, `outcome` `refused` with the longest `reason` alert-delivery/v1.md "
            "*Carriage and custody* lets an acknowledgement carry.") not in flat:
        raise Failure("Size vectors no longer requires the refused alert-delivery "
                      "acknowledgement at its longest reason")
    return {
        "alert_ack": alert_ack_model(text, delivery),
        "routing": int(routing.group(1)),
        "request_id_bound": int(request_bound.group(1)),
        "error_bound": int(error_bound.group(1)),
        "event_bound": int(event_bound.group(1)),
        "export_types": re.findall(r"`([a-z_]+)`", export_types.group(1)),
        "degradation_tokens": tokens,
        "gateway_statuses": gateway_status.group(1).split("|"),
        "providers": provider.group(1).split("|"),
        "device_id_scalars": int(routing.group(1)),
        "device_id_pattern": declared,
        "artifact_bound": {"inbound": int(inbound_bound.group(1)),
                           "outbound": int(outbound_bound.group(1))},
        "outbound_types": _vocabulary(
            whole_flat, r"The closed outbound vocabulary is (.*?)\. Type is named",
            "the outbound artifact types"),
        "transport_reasons": _vocabulary(
            whole_flat, r"the closed transport refusal vocabulary is (.*?)\. `queue_full`",
            "the transport refusal vocabulary"),
        "outbound_outcomes": _vocabulary(
            whole_flat, r"`outcome` is (`[a-z_]+` or `[a-z_]+`)\. `reason` is empty for",
            "the outbound acknowledgement outcomes"),
        "inbound_types": inbound_types,
        "rejection_reasons": rejections,
        "table": table,
        "admitted": verdicts.group(1),
        "too_large": verdicts.group(2),
        "config_refused": verdicts.group(3),
        "json_head": head.group(1).encode(),
        "json_fill": head.group(2).encode(),
        "json_tail": head.group(3).encode(),
        "invalid_byte": bytes.fromhex(fill.group(1)),
        "pin": pin.group(1),
        "floor": int(floor.group(1)),
        "never_lowered": never_lowered,
        "half_refused_below_floor": halves.group(1) is not None,
        "item_error": item_error.group(1),
    }


def ingress_refusals(health: str, text: str) -> None:
    """Payload Volume sends a runtime's size, volume and member refusals to the
    `mqtt_ingress` block of runtime-health/v4: the anchor it links must exist, the
    block's `families` values must count exactly those three refusals as integers,
    and its families must be named as Payload Size names them."""
    heading = "### `mqtt_ingress` object"
    if "](../runtime-health/v4.md#mqtt_ingress-object)" not in text or (
            "\n" + heading + "\n") not in health:
        raise Failure("Payload Volume links an mqtt_ingress block runtime-health/v4 does not hold")
    start = health.index("\n" + heading + "\n") + len(heading) + 2
    block = health[start:]
    stop = re.search(r"^#{2,3} ", block, re.M)
    block = block if stop is None else block[:stop.start()]
    values = block.split("Each `families` value:", 1)
    if len(values) != 2:
        raise Failure("runtime-health/v4 mqtt_ingress no longer tabulates a families value")
    rows = dict(re.findall(r"^\| `([a-z_]+)` \| `([a-z]+)` \|", values[1], re.M))
    named = {"payload_too_large": "Payload Size", "volume_dropped": "Payload Volume",
             "member_refused": "Payload Member Rule"}
    if rows != {member: "int" for member in named}:
        raise Failure(f"runtime-health/v4 mqtt_ingress families value is {rows}, not one int "
                      f"for each of {sorted(named)}")
    flat_block = " ".join(block.split())
    for section in named.values():
        anchor = section.lower().replace(" ", "-")
        if f"[{section}](../gateway-api/v2.md#{anchor})" not in flat_block:
            raise Failure(f"runtime-health/v4 mqtt_ingress does not cite gateway-api/v2 {section}")
    if "named by its topic as Payload Size names a family" not in flat_block:
        raise Failure("runtime-health/v4 mqtt_ingress no longer names families as Payload Size does")


def build(model: dict, kind: str, length: int) -> bytes:
    if kind == "json_object":
        body = length - len(model["json_head"]) - len(model["json_tail"])
        if body < 0:
            raise Failure(f"json_object cannot be {length} bytes long")
        return model["json_head"] + model["json_fill"] * body + model["json_tail"]
    if kind == "invalid_utf8":
        return model["invalid_byte"] * length
    raise Failure(f"unknown construction {kind!r}")


def verdict(model: dict, topic: str, configured: int | None, length: int) -> str:
    maximum = model["table"][topic][1]
    if configured is not None and (
        configured > maximum
        or configured < model["floor"]
        or (configured < maximum and topic in model["never_lowered"])
    ):
        return model["config_refused"]
    in_force = maximum if configured is None else configured
    return model["admitted"] if length <= in_force else model["too_large"]


def check(corpus: dict, model: dict) -> None:
    names = [c["name"] for c in corpus["cases"]]
    if len(names) != len(set(names)):
        raise Failure("duplicate case name")
    seen: dict[str, set[str]] = {topic: set() for topic in model["table"]}
    for c in corpus["cases"]:
        if c["topic"] not in model["table"]:
            raise Failure(f"{c['name']}: topic {c['topic']!r} has no maximum in the contract")
        direction, maximum = model["table"][c["topic"]]
        if c["direction"] != direction:
            raise Failure(f"{c['name']}: direction is not the table's")
        data = build(model, c["construction"], c["length"])
        if len(data) != c["length"] or hashlib.sha256(data).hexdigest() != c["sha256"]:
            raise Failure(f"{c['name']}: bytes do not reproduce from the construction")
        want = verdict(model, c["topic"], c["configured_maximum"], c["length"])
        if c["verdict"] != want:
            raise Failure(f"{c['name']}: verdict {c['verdict']}, the contract decides {want}")
        configured, kind, length = c["configured_maximum"], c["construction"], c["length"]
        if configured is None and kind == "json_object":
            if length == maximum:
                seen[c["topic"]].add("at")
            elif length == maximum + 1:
                seen[c["topic"]].add("one_over")
            elif length == 4 * maximum:
                seen[c["topic"]].add("four_times")
        if configured is None and kind == "invalid_utf8" and length == maximum + 1:
            seen[c["topic"]].add("invalid_one_over")
        if configured == maximum // 2 and kind == "json_object":
            if length == configured:
                seen[c["topic"]].add("configured_at")
            elif length == configured + 1:
                seen[c["topic"]].add("configured_over")
        if configured == maximum + 1:
            seen[c["topic"]].add("configured_above")
        if configured == model["floor"] - 1:
            seen[c["topic"]].add("configured_below_floor")
    # The configured half is refused exactly where the coverage paragraph says it is, which
    # the floor and never-lowered rules above must agree with.
    for c in corpus["cases"]:
        maximum = model["table"][c["topic"]][1]
        if c["configured_maximum"] != maximum // 2:
            continue
        said = c["topic"] in model["never_lowered"] or (
            model["half_refused_below_floor"] and maximum // 2 < model["floor"])
        if (c["verdict"] == model["config_refused"]) != said:
            raise Failure(f"{c['name']}: the coverage paragraph says its configured half is "
                          f"{'refused' if said else 'in force'}")
    wanted = {"at", "one_over", "four_times", "invalid_one_over", "configured_at",
              "configured_over", "configured_above", "configured_below_floor"}
    for topic, got in seen.items():
        if got != wanted:
            raise Failure(f"coverage: {topic} lacks {sorted(wanted - got)}")


def page_export(fixed: int, items: list[int], maximum: int,
                item_error: str) -> tuple[list[dict], dict | None]:
    """The export rule, item by item: as many as fit, at least one, resuming at
    the first item not returned."""
    produced: list[dict] = []
    index = 0
    while index < len(items):
        if fixed + items[index] > maximum:
            return produced, {"at": index, "error": item_error}
        size, count = fixed, 0
        while index + count < len(items) and size + items[index + count] <= maximum:
            size += items[index + count]
            count += 1
        index += count
        produced.append({"items": count, "next": index})
    return produced, None


def check_paging(corpus: dict, model: dict) -> None:
    seen = set()
    for c in corpus["paging"]:
        produced, error = page_export(c["fixed_bytes"], c["item_bytes"], c["maximum"],
                                      model["item_error"])
        if (produced, error) != (c["pages"], c["error"]):
            raise Failure(f"{c['name']}: pages {c['pages']} {c['error']}, the rule gives "
                          f"{produced} {error}")
        if error is not None:
            seen.add("alone_too_large")
        if len(produced) > 2:
            seen.add("several_pages")
        for page in produced:
            start = page["next"] - page["items"]
            if c["fixed_bytes"] + sum(c["item_bytes"][start:page["next"]]) == c["maximum"]:
                seen.add("filled_exactly")
    missing = {"alone_too_large", "several_pages", "filled_exactly"} - seen
    if missing:
        raise Failure(f"coverage: no paging case with {sorted(missing)}")


def _json_string(value: str, escaped: bool) -> bytes:
    out = ['"']
    for ch in value:
        point = ord(ch)
        if ch in '"\\':
            out.append("\\" + ch)
        elif point < 0x20:
            out.append("\\u%04x" % point)
        elif point < 0x80 or not escaped:
            out.append(ch)
        elif point > 0xFFFF:
            point -= 0x10000
            out.append("\\u%04x\\u%04x" % (0xD800 + (point >> 10), 0xDC00 + (point & 0x3FF)))
        else:
            out.append("\\u%04x" % point)
    out.append('"')
    return "".join(out).encode("utf-8")


def _json(value: object, escaped: bool) -> bytes:
    if value is None:
        return b"null"
    if value is True or value is False:
        return b"true" if value else b"false"
    if isinstance(value, str):
        return _json_string(value, escaped)
    if isinstance(value, int):
        return str(value).encode()
    if isinstance(value, float):
        return repr(value).encode()
    if isinstance(value, list):
        return b"[" + b",".join(_json(v, escaped) for v in value) + b"]"
    assert isinstance(value, dict)
    members = [_json_string(k, escaped) + b":" + _json(value[k], escaped)
               for k in sorted(value)]
    return b"{" + b",".join(members) + b"}"


def evidence_payload(model: dict, c: dict) -> object:
    device_id = chr(int(c["device_id_scalar"][2:], 16)) * c["device_id_scalars"]
    top = 2 ** 53 - 1
    auth = {"scheme": "hmac-sha256", "signed_at_ms": top,
            "signature": "hmac-sha256:" + "0" * 64}
    topic = c["topic"]
    if topic.endswith("/outbound"):
        return {"artifact_b64": base64.b64encode(bytes(c["artifact_bytes"])).decode(),
                "artifact_type": c["artifact_type"], "device_id": device_id}
    if topic.endswith("/inbound"):
        shell = len(b'{"pad":""}')
        artifact = {"pad": "\u00e9" * ((c["artifact_bytes"] - shell) // 2)}
        if len(_json(artifact, False)) != c["artifact_bytes"]:
            raise Failure(f"{c['name']}: no artifact is {c['artifact_bytes']} canonical bytes")
        return {"artifact": artifact, "artifact_type": c["artifact_type"], "auth": auth,
                "device_id": device_id}
    return {"acknowledged_at_ms": top, "artifact_digest": "sha256:" + "0" * 64,
            "artifact_type": c["artifact_type"], "auth": auth, "device_id": device_id,
            "outcome": c["outcome"], "reason": c["reason"]}


def check_envelopes(corpus: dict, model: dict) -> None:
    longest = lambda words: max(len(w) for w in words)  # noqa: E731
    vocab = {
        "ori/{device_id}/evidence/outbound": (model["outbound_types"], None),
        "ori/{device_id}/evidence/outbound/ack": (model["outbound_types"],
                                                  model["transport_reasons"]),
        "ori/{device_id}/evidence/inbound": (model["inbound_types"], None),
        "ori/{device_id}/evidence/inbound/ack": (model["inbound_types"],
                                                 model["rejection_reasons"]),
    }
    seen = set()
    for c in corpus["envelopes"]:
        topic = c["topic"]
        if topic not in vocab:
            raise Failure(f"{c['name']}: {topic} is not an evidence topic")
        data = _json(evidence_payload(model, c), c["encoding"] == "escaped")
        if c["encoding"] not in ("canonical", "escaped"):
            raise Failure(f"{c['name']}: unknown encoding {c['encoding']!r}")
        if len(data) != c["length"] or hashlib.sha256(data).hexdigest() != c["sha256"]:
            raise Failure(f"{c['name']}: bytes do not reproduce")
        maximum = model["table"][topic][1]
        want = model["admitted"] if len(data) <= maximum else model["too_large"]
        if c["verdict"] != want:
            raise Failure(f"{c['name']}: verdict {c['verdict']}, the table decides {want}")
        scalar = chr(int(c["device_id_scalar"][2:], 16))
        types, reasons = vocab[topic]
        at_bound = (
            c["device_id_scalars"] == model["device_id_scalars"]
            and re.fullmatch(model["device_id_pattern"], scalar * c["device_id_scalars"])
            and c["artifact_type"] in types and len(c["artifact_type"]) == longest(types)
            and (reasons is None or (c["reason"] in reasons
                                     and len(c["reason"]) == longest(reasons)))
            and (topic.endswith("/ack") or c["artifact_bytes"] == model["artifact_bound"][
                "inbound" if topic.endswith("/inbound") else "outbound"])
        )
        if at_bound:
            seen.add((topic, c["encoding"]))
    wanted = {(t, "escaped") for t in vocab} | {("ori/{device_id}/evidence/inbound",
                                                  "canonical")}
    if seen != wanted:
        raise Failure(f"coverage: no envelope at its bound for {sorted(wanted - seen)}")


REPLY_TOPICS = {
    "reasoning_error": "ori/{device_id}/reasoning/response",
    "enrichment_error": "ori/{device_id}/tier_c/enrichment/response",
    "export_error_encrypted": "ori/{device_id}/export/response/{request_id}",
    "runtime_heartbeat_no_triggers": "ori/{device_id}/runtime/heartbeat",
    "gateway_heartbeat": "ori/gateway/health",
    "alert_delivery_ack": "ori/{device_id}/runtime/alert-delivery/ack",
}


def reply_payload(model: dict, name: str) -> object:
    """Each required reply at the bounds the contract states."""
    widest = lambda words: max(words, key=len)  # noqa: E731
    device_id = "a" * model["routing"]
    request_id = "a" * model["request_id_bound"]
    error = "\U0001F600" * model["error_bound"]
    top = 2 ** 53 - 1
    auth = {"scheme": "hmac-sha256", "signature": "hmac-sha256:" + "0" * 64,
            "signed_at_ms": top}
    if name == "reasoning_error":
        return {"action_tier": "A", "auth": auth, "confidence": 0.0, "device_id": device_id,
                "error": error, "latency_ms": top, "model": "", "proposed_action": None,
                "request_id": request_id, "text": "", "tokens_used": top}
    if name == "enrichment_error":
        return {"auth": auth, "device_id": device_id, "error": error, "latency_ms": top,
                "proposal_id": "A" * 8, "request_id": request_id, "tokens_used": top}
    if name == "export_error_encrypted":
        export_type = widest(model["export_types"])
        plaintext = _json({"complete": True, "device_id": device_id, "error": error,
                           "export_type": export_type, "items": [], "next_page_token": "",
                           "request_id": request_id}, True)
        return {"auth": auth, "device_id": device_id, "encrypted": True,
                "encryption": {"ciphertext": base64.b64encode(bytes(len(plaintext) + 16)).decode(),
                               "nonce": base64.b64encode(bytes(12)).decode(),
                               "scheme": "aes-256-gcm"},
                "export_type": export_type, "request_id": request_id}
    if name == "runtime_heartbeat_no_triggers":
        return {"active_triggers": [], "auth": auth, "degradation_reasons": model[
                    "degradation_tokens"], "device_id": device_id,
                "evidence": {"action_event_type": "A" * model["event_bound"],
                             "attestation_gap_count": top, "available": True,
                             "chain_head_hash": "0" * 64},
                "gateway_seen_ms": top, "last_seen_ms": top, "status": "critical"}
    if name == "gateway_heartbeat":
        return {"auth": auth, "provider": widest(model["providers"]),
                "sim_available": False, "status": widest(model["gateway_statuses"]),
                "timestamp_ms": top, "uptime_s": 1.7976931348623157e308,
                "webhook_bridge": {"body_limit_bytes": top, "enabled": False,
                                   "loopback_only": False, "provider_cidr_count": top,
                                   "ready": False, "request_timeout_ms": top,
                                   "runtime_target_configured": False,
                                   "source_cidrs_configured": False}}
    if name == "alert_delivery_ack":
        reason = widest(model["alert_ack"]["reasons"])
        payload = {"acknowledged_at_ms": top, "auth": auth, "device_id": device_id,
                   "outcome": "refused", "reason": reason,
                   "record_digest": "sha256:" + "0" * 64}
        shown = model["alert_ack"]["members"]
        if set(payload) != set(shown) or set(auth) != set(shown.get("auth", {})):
            raise Failure(f"the alert-delivery acknowledgement shows {sorted(shown)}, built "
                          f"here {sorted(payload)}")
        if len(reason) != max(len(r) for r in model["alert_ack"]["reasons"]):
            raise Failure("the alert-delivery acknowledgement reason is not the longest")
        return payload
    raise Failure(f"no required reply named {name!r}")


def check_replies(corpus: dict, model: dict) -> None:
    names = {c["name"] for c in corpus["replies"]}
    if names != set(REPLY_TOPICS):
        raise Failure(f"coverage: required replies {sorted(set(REPLY_TOPICS) - names)} "
                      f"missing, {sorted(names - set(REPLY_TOPICS))} unknown")
    for c in corpus["replies"]:
        if c["topic"] != REPLY_TOPICS[c["name"]] or c["configured_maximum"] != model["floor"]:
            raise Failure(f"{c['name']}: not on its topic at the floor")
        data = _json(reply_payload(model, c["name"]), True)
        if len(data) != c["length"] or hashlib.sha256(data).hexdigest() != c["sha256"]:
            raise Failure(f"{c['name']}: bytes do not reproduce")
        if c["verdict"] != model["admitted"] or len(data) > model["floor"]:
            raise Failure(f"{c['name']}: a required reply of {len(data)} bytes does not fit "
                          f"the floor of {model['floor']}")
    for c in corpus["envelopes"]:
        if c["topic"].endswith("/ack") and c["length"] > model["floor"]:
            raise Failure(f"{c['name']}: an acknowledgement does not fit the floor")


def run(corpus_bytes: bytes, model: dict) -> None:
    if hashlib.sha256(corpus_bytes).hexdigest() != model["pin"]:
        raise Failure("corpus digest differs from the one gateway-api/v2.md pins")
    corpus = json.loads(corpus_bytes)
    check(corpus, model)
    check_paging(corpus, model)
    check_envelopes(corpus, model)
    check_replies(corpus, model)


def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)
    text = CONTRACT.read_text()

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check(mutated, model)
        return go

    def paging_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check_paging(mutated, model)
        return go

    def envelope_mutant(edit: Callable[[dict], None],
                        consistent: bool = False) -> Callable[[], None]:
        """With ``consistent``, the edited cases are rebuilt with true bytes and
        verdicts, so only the coverage rule can refuse them."""
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            if consistent:
                for c in mutated["envelopes"]:
                    data = _json(evidence_payload(model, c), c["encoding"] == "escaped")
                    over = len(data) > model["table"][c["topic"]][1]
                    c.update(length=len(data), sha256=hashlib.sha256(data).hexdigest(),
                             verdict=model["too_large"] if over else model["admitted"])
            check_envelopes(mutated, model)
        return go

    def replies_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        """A contract whose bounds changed, with replies rebuilt consistently under
        them: only the floor can refuse it."""
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            corpus = copy.deepcopy(base)
            for c in corpus["replies"]:
                data = _json(reply_payload(mutated, c["name"]), True)
                over = len(data) > mutated["floor"]
                c.update(configured_maximum=mutated["floor"], length=len(data),
                         sha256=hashlib.sha256(data).hexdigest(),
                         verdict=mutated["too_large"] if over else mutated["admitted"])
            check_replies(corpus, mutated)
        return go

    def envelope(c: dict, name: str) -> dict:
        return next(x for x in c["envelopes"] if x["name"] == name)

    def model_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            run(corpus_bytes, mutated)
        return go

    def text_mutant(old: str, new: str) -> Callable[[], None]:
        """Replace ``old`` matched word by word, whatever the line wrapping."""
        pattern = re.compile(r"\s+".join(re.escape(w) for w in old.split()))

        def go() -> None:
            if pattern.search(text) is None:
                raise AssertionError(f"mutant target missing: {old!r}")
            run(corpus_bytes, contract_model(pattern.sub(lambda _: new, text, count=1)))
        return go

    health = RUNTIME_HEALTH.read_text()

    def health_mutant(old: str, new: str) -> Callable[[], None]:
        """Replace ``old`` in runtime-health/v4.md, word by word."""
        pattern = re.compile(r"\s+".join(re.escape(w) for w in old.split()))

        def go() -> None:
            if pattern.search(health) is None:
                raise AssertionError(f"mutant target missing: {old!r}")
            run(corpus_bytes, contract_model(
                text, None, pattern.sub(lambda _: new, health, count=1)))
        return go

    delivery = ALERT_DELIVERY.read_text()

    def delivery_mutant(old: str, new: str) -> Callable[[], None]:
        """Replace ``old`` in alert-delivery/v1.md, word by word."""
        pattern = re.compile(r"\s+".join(re.escape(w) for w in old.split()))

        def go() -> None:
            if pattern.search(delivery) is None:
                raise AssertionError(f"mutant target missing: {old!r}")
            run(corpus_bytes, contract_model(
                text, None, None, pattern.sub(lambda _: new, delivery, count=1)))
        return go

    def _rebuilt(name: str, m: dict) -> dict:
        data = _json(reply_payload(m, name), True)
        return {"length": len(data), "sha256": hashlib.sha256(data).hexdigest()}

    def by_name(c: dict, name: str) -> dict:
        return next(x for x in c["cases"] if x["name"] == name)

    def drop(name: str) -> Callable[[dict], None]:
        return lambda c: c.update(cases=[x for x in c["cases"] if x["name"] != name])

    first = base["cases"][0]["topic"]
    cases: list[tuple[str, Callable[[], None]]] = [
        ("one-over admitted", corpus_mutant(
            lambda c: by_name(c, "gateway_health_one_over").update(verdict="admitted"))),
        ("at-maximum refused", corpus_mutant(
            lambda c: by_name(c, "gateway_health_at_maximum").update(verdict="payload_too_large"))),
        ("raised configuration admitted", corpus_mutant(
            lambda c: by_name(c, "gateway_health_configured_above_table").update(
                verdict="admitted"))),
        ("configured lower ignored", corpus_mutant(
            lambda c: by_name(c, "gateway_health_configured_half_over").update(
                verdict="admitted"))),
        ("digest of other bytes", corpus_mutant(
            lambda c: by_name(c, "gateway_health_at_maximum").update(sha256="0" * 64))),
        ("length off by one", corpus_mutant(
            lambda c: by_name(c, "gateway_health_at_maximum").update(length=16383))),
        ("unknown topic", corpus_mutant(
            lambda c: by_name(c, "gateway_health_at_maximum").update(topic="ori/x"))),
        ("wrong direction", corpus_mutant(
            lambda c: by_name(c, "gateway_health_at_maximum").update(
                direction="runtime_to_gateway"))),
        ("maximum read one larger", model_mutant(
            lambda m: m["table"].__setitem__(first, (m["table"][first][0],
                                                     m["table"][first][1] + 1)))),
        ("maximum read one smaller", model_mutant(
            lambda m: m["table"].__setitem__(first, (m["table"][first][0],
                                                     m["table"][first][1] - 1)))),
        ("a raised configuration honoured", model_mutant(
            lambda m: m.update(config_refused=m["admitted"]))),
        ("fill byte changed", model_mutant(lambda m: m.update(json_fill=b"b"))),
        ("invalid byte changed", model_mutant(lambda m: m.update(invalid_byte=b"\xfe"))),
        ("pin wrong", model_mutant(lambda m: m.update(pin="0" * 64))),
        ("text: a maximum changed", text_mutant(
            "| `ori/gateway/health` | Gateway -> Runtime | 16384 |",
            "| `ori/gateway/health` | Gateway -> Runtime | 16385 |")),
        ("floor ignored", model_mutant(lambda m: m.update(floor=0))),
        # A topic whose maximum is the floor cannot be lowered at all, so its configured
        # half is below the floor and refused.
        ("text: the floor-sized half no longer said refused", text_mutant(
            "and for a topic whose maximum is the floor, whose half lies below it, ", "")),
        ("model: the floor-sized half read as in force", model_mutant(
            lambda m: m.update(half_refused_below_floor=False))),
        ("a floor-sized topic lowered to its half", corpus_mutant(
            lambda c: by_name(c, "runtime_posture_configured_half_at").update(
                verdict="admitted"))),
        ("text: the posture maximum raised", text_mutant(
            "| `ori/{device_id}/runtime/posture` | Runtime -> Gateway | 4096 |",
            "| `ori/{device_id}/runtime/posture` | Runtime -> Gateway | 4097 |")),
        ("text: an oversized item asked for again", text_mutant(
            "and the gateway does not request that page again",
            "and the gateway requests that page again")),
        ("paging: a page after the oversized item", paging_mutant(
            lambda c: next(x for x in c["paging"] if x["name"] == "an_item_too_large_alone")[
                "pages"].append({"items": 1, "next": 3}))),
        ("text: inbound published in any encoding", text_mutant(
            "is published as the canonical JSON of the whole payload",
            "is published as any JSON encoding of the whole payload")),
        ("text: oversized artifact archived", text_mutant(
            "an unrecognised outcome for that attempt", "a refusal that archives the entry")),
        ("text: routing bound widened", text_mutant(
            "so a `device_id` on this hop is at most 128 ASCII characters",
            "so a `device_id` on this hop is at most 4096 ASCII characters")),
        ("schema and text: a prefix admits any length", lambda: run(corpus_bytes, contract_model(
            text.replace("`^[A-Za-z0-9._-]{1,128}$`", "`^A*[A-Za-z0-9._-]{1,128}$`"),
            RUNTIME_SCHEMA.read_text().replace('"^[A-Za-z0-9._-]{1,128}$"',
                                               '"^A*[A-Za-z0-9._-]{1,128}$"')))),
        ("schema and text: the class admits a placeholder", lambda: run(
            corpus_bytes, contract_model(
                text.replace("`^[A-Za-z0-9._-]{1,128}$`", "`^[A-Za-z0-9._${}-]{1,128}$`"),
                RUNTIME_SCHEMA.read_text().replace('"^[A-Za-z0-9._-]{1,128}$"',
                                                   '"^[A-Za-z0-9._${}-]{1,128}$"')))),
        ("text: request_id refused answered", text_mutant(
            "a runtime refuses an export request whose `request_id` is outside it, unanswered",
            "a runtime answers an export request whose `request_id` is outside it")),
        ("replies: request_id unbounded", replies_mutant(
            lambda m: m.update(request_id_bound=3000))),
        ("replies: error widened", replies_mutant(lambda m: m.update(error_bound=512))),
        ("replies: floor lowered", replies_mutant(lambda m: m.update(floor=2048))),
        ("replies: export reply dropped", lambda: check_replies(
            {**base, "replies": [x for x in base["replies"]
                                 if x["name"] != "export_error_encrypted"]}, model)),
        ("replies: heartbeat without a token", lambda: check_replies(
            base, {**model, "degradation_tokens": model["degradation_tokens"][1:]})),
        ("schema: runtime pattern widened", lambda: run(corpus_bytes, contract_model(
            None, RUNTIME_SCHEMA.read_text().replace("]{1,128}$", "]{1,4096}$")))),
        ("model: inbound maximum at the artifact bound", lambda: check_envelopes(
            base, {**model, "table": {**model["table"], "ori/{device_id}/evidence/inbound": (
                "gateway_to_runtime", 1048576)}})),
        ("model: acknowledgement maximum below its members", lambda: check_envelopes(
            base, {**model, "table": {**model["table"],
                                      "ori/{device_id}/evidence/inbound/ack": (
                                          "runtime_to_gateway", 512)}})),
        ("envelope: device_id one scalar short", envelope_mutant(
            lambda c: [x.update(device_id_scalars=127) for x in c["envelopes"]], consistent=True)),
        ("envelope: device_id outside the pattern", envelope_mutant(
            lambda c: [x.update(device_id_scalar="U+00E9") for x in c["envelopes"]], consistent=True)),
        ("envelope: escaped inbound admitted", envelope_mutant(
            lambda c: envelope(c, "evidence_inbound_escaped_at_bound").update(
                verdict="admitted"))),
        ("envelope: escaped inbound dropped", envelope_mutant(
            lambda c: c.update(envelopes=[x for x in c["envelopes"]
                                          if x["name"] != "evidence_inbound_escaped_at_bound"]))),
        ("envelope: a shorter artifact type", envelope_mutant(
            lambda c: [x.update(artifact_type="delivery_receipt") for x in c["envelopes"]
                       if "inbound" in x["topic"]], consistent=True)),
        ("envelope: a shorter rejection reason", envelope_mutant(
            lambda c: envelope(c, "evidence_inbound_ack_at_bound").update(reason="malformed"), consistent=True)),
        ("envelope: an artifact below the bound", envelope_mutant(
            lambda c: [x.update(artifact_bytes=1024) for x in c["envelopes"]
                       if x["artifact_bytes"]], consistent=True)),
        ("text: pagination resumes at the first item returned", text_mutant(
            "continues from the first item not returned", "continues from the first item returned")),
        ("text: response error renamed", text_mutant(
            "with `error` `response_too_large`", "with `error` `response_ignored`")),
        ("text: a peer may raise a bound", text_mutant(
            "a peer can never raise them", "a peer can always raise them")),
        ("text: an oversized artifact holds every lane", text_mutant(
            "keeps the device's other lane and every other device moving",
            "holds the device's other lane and every other device")),
        ("text: item error renamed", text_mutant(
            "whose `error` is `item_exceeds_payload_maximum`", "whose `error` is `item_too_big`")),
        ("paging: a page one item short", paging_mutant(
            lambda c: c["paging"][0]["pages"][0].update(items=2))),
        ("paging: resumes at the first item returned", paging_mutant(
            lambda c: c["paging"][0]["pages"][0].update(next=0))),
        ("paging: oversized item silently skipped", paging_mutant(
            lambda c: c["paging"][1].update(error=None))),
        ("paging: no page filled to the byte", paging_mutant(
            lambda c: c.update(paging=[x for x in c["paging"]
                                       if x["name"] == "an_item_too_large_alone"] + [
                {"name": "pages_of_two", "fixed_bytes": 100, "item_bytes": [301] * 10,
                 "maximum": 1000, "error": None,
                 "pages": [{"items": 2, "next": n} for n in (2, 4, 6, 8, 10)]}]))),
        ("evidence lowered", model_mutant(lambda m: m.update(never_lowered=set()))),
        ("text: a hyphenated topic with no row", text_mutant(
            "| `ori/gateway/health` |", "| `ori/gateway/health` | `ori/{device_id}/tier-c/relay` |")),
        ("text: a dotted topic with no row", text_mutant(
            "## Payload Volume", "## Payload Volume\n\nSee `ori/{device_id}/relay.v1`.")),
        ("text: heartbeat cap removed", text_mutant(
            "at most 64 names, in the order", "names in the order")),
        ("text: heartbeat may drop members", text_mutant(
            "it never omits another member to make room", "it may omit other members to make room")),
        ("text: ingress shape opened", text_mutant(
            "with exactly two integer members", "with integer members including")),
        ("text: producer sizes against the table", text_mutant(
            "its own configured value where one is set", "never its own configured value")),
        ("text: Tier 3 waits out its timeout", text_mutant(
            "unavailable at once, without waiting out its timeout",
            "unavailable once its timeout has passed")),
        ("text: the old runtime deferral restored", text_mutant(
            "A runtime reports them, with its Payload Member Rule refusals, in the `mqtt_ingress` "
            "block of [runtime-health/v4.md](../runtime-health/v4.md#mqtt_ingress-object), which "
            "its remote health projection carries.",
            "A runtime reports them under [runtime-health/v4.md](../runtime-health/v4.md) once "
            "that contract names the field; until it does, a runtime records each refusal in its "
            "own log, by topic family, and reports nothing else about them.")),
        ("text: member refusals no longer reported", text_mutant(
            "A runtime reports them, with its Payload Member Rule refusals, in",
            "A runtime reports them in")),
        ("text: the projection no longer carries the block", text_mutant(
            ", which its remote health projection carries.", ".")),
        ("health: member_refused dropped from the families value", health_mutant(
            "| `member_refused` | `int` | Payloads refused under the Payload Member Rule. |\n",
            "")),
        ("health: a families count read as a string", health_mutant(
            "| `volume_dropped` | `int` |", "| `volume_dropped` | `string` |")),
        ("health: an extra families member", health_mutant(
            "| `member_refused` | `int` |",
            "| `envelope_refused` | `int` | x |\n| `member_refused` | `int` |")),
        ("health: the mqtt_ingress heading renamed", health_mutant(
            "### `mqtt_ingress` object", "### `mqtt_ingress_counts` object")),
        ("health: families named otherwise than Payload Size", health_mutant(
            "named by its topic as Payload Size names a family", "named by the runtime")),
        ("health: the Payload Member Rule citation dropped", health_mutant(
            "[Payload Member Rule](../gateway-api/v2.md#payload-member-rule)",
            "Payload Member Rule")),
        ("text: evidence lowerable", text_mutant(
            "are never lowered: a courier", "may be lowered: a courier")),
        ("text: count read as exact", text_mutant(
            "as a lower bound on the triggers active, never as their count",
            "as the count of the triggers active")),
        ("text: a topic dropped from the table", text_mutant(
            "| `ori/{device_id}/evidence/outbound/ack` | Gateway -> Runtime | 16384 | Fixed members. |\n",
            "")),
        ("text: reason renamed", text_mutant(
            "refused as `payload_too_large`", "refused as `too_large`")),
        ("text: raising allowed", text_mutant(
            "may configure a lower maximum, never a higher one",
            "may configure any maximum")),
        ("text: size checked after verification", text_mutant(
            "before it parses, decodes, decrypts or verifies anything",
            "after it verifies the envelope")),
        ("text: length after decryption", text_mutant(
            "exactly as delivered, before it is decrypted, decoded or read",
            "after it is decrypted and decoded")),
        ("text: refusal answered", text_mutant(
            "It is not answered, since none of its members can be relied on",
            "It is answered with an error, since none of its members can be relied on")),
        ("text: record carries the device", text_mutant(
            "never with its contents or a device identifier",
            "with its device identifier")),
        ("text: exact length recorded", text_mutant(
            "the least power of two not below its length", "its exact length")),
        ("text: floor removed", text_mutant(
            ", and never below 4096 bytes", "")),
        ("a topic named only in another section", text_mutant(
            "| `ori/{device_id}/evidence/inbound/ack` | Runtime -> Gateway | 16384 | Fixed members. |\n",
            "")),
        ("text: construction changed", text_mutant(
            "`json_object`: the bytes `{\"pad\":\"`", "`json_object`: the bytes `{\"p\":\"`")),
    ]
    for name in [c["name"] for c in base["cases"] if c["topic"] == first]:
        cases.append((f"{name} dropped", corpus_mutant(drop(name))))
    # The alert-delivery rows, held by topic and class rather than by case name, so the
    # mutants do not depend on how the generator names its cases.
    record = "ori/{device_id}/runtime/alert-delivery"
    ack = record + "/ack"
    floor = model["floor"]

    def classes(maximum: int) -> dict[str, Callable[[dict], bool]]:
        half = maximum // 2
        return {
            "at": lambda x: (x["configured_maximum"], x["construction"], x["length"]) == (
                None, "json_object", maximum),
            "one_over": lambda x: (x["configured_maximum"], x["construction"], x["length"]) == (
                None, "json_object", maximum + 1),
            "four_times": lambda x: (x["configured_maximum"], x["construction"],
                                     x["length"]) == (None, "json_object", 4 * maximum),
            "invalid_one_over": lambda x: (x["configured_maximum"], x["construction"],
                                           x["length"]) == (None, "invalid_utf8", maximum + 1),
            "configured_at": lambda x: (x["configured_maximum"], x["construction"],
                                        x["length"]) == (half, "json_object", half),
            "configured_over": lambda x: (x["configured_maximum"], x["construction"],
                                          x["length"]) == (half, "json_object", half + 1),
            "configured_above": lambda x: x["configured_maximum"] == maximum + 1,
            "configured_below_floor": lambda x: x["configured_maximum"] == floor - 1,
        }

    def drop_class(topic: str, test: Callable[[dict], bool]) -> Callable[[dict], None]:
        def edit(c: dict) -> None:
            kept = [x for x in c["cases"] if not (x["topic"] == topic and test(x))]
            if len(kept) == len(c["cases"]):
                raise AssertionError(f"mutant target missing: a {topic} case to drop")
            c["cases"] = kept
        return edit

    def first_of(topic: str, test: Callable[[dict], bool]) -> Callable[[dict], dict]:
        return lambda c: next(x for x in c["cases"] if x["topic"] == topic and test(x))

    for topic in (record, ack):
        tests = classes(model["table"][topic][1])
        for label, test in tests.items():
            cases.append((f"{topic}: {label} dropped", corpus_mutant(drop_class(topic, test))))
        cases += [
            (f"{topic}: one over admitted", corpus_mutant(
                lambda c, t=topic, f=tests["one_over"]: first_of(t, f)(c).update(
                    verdict="admitted"))),
            (f"{topic}: floor-sized half in force", corpus_mutant(
                lambda c, t=topic, f=tests["configured_at"]: first_of(t, f)(c).update(
                    verdict="admitted"))),
            (f"{topic}: direction reversed", corpus_mutant(
                lambda c, t=topic, f=tests["at"]: first_of(t, f)(c).update(
                    direction="gateway_to_runtime" if t == record
                    else "runtime_to_gateway"))),
        ]
    cases += [
        ("text: the alert-delivery maximum raised", text_mutant(
            "| `ori/{device_id}/runtime/alert-delivery` | Runtime -> Gateway | 4096 |",
            "| `ori/{device_id}/runtime/alert-delivery` | Runtime -> Gateway | 8192 |")),
        ("text: the alert-delivery acknowledgement maximum lowered", text_mutant(
            "| `ori/{device_id}/runtime/alert-delivery/ack` | Gateway -> Runtime | 4096 |",
            "| `ori/{device_id}/runtime/alert-delivery/ack` | Gateway -> Runtime | 2048 |")),
        ("text: the alert-delivery acknowledgement direction reversed", text_mutant(
            "| `ori/{device_id}/runtime/alert-delivery/ack` | Gateway -> Runtime | 4096 |",
            "| `ori/{device_id}/runtime/alert-delivery/ack` | Runtime -> Gateway | 4096 |")),
        ("text: the alert-delivery acknowledgement row dropped", text_mutant(
            "| `ori/{device_id}/runtime/alert-delivery/ack` | Gateway -> Runtime | 4096 | One "
            "custody acknowledgement and its fixed envelope members. |\n", "")),
        ("text: coverage limited to the older rows", text_mutant(
            "For every topic in the table the corpus holds",
            "For every topic in the table but the alert-delivery rows the corpus holds")),
        ("model: the alert-delivery record lowerable below the floor", model_mutant(
            lambda m: m.update(floor=2048))),
        ("replies: alert-delivery ack with a member it does not show", replies_mutant(
            lambda m: m["alert_ack"].update(members={**m["alert_ack"]["members"], "extra": 1}))),
        ("replies: alert-delivery ack dropped", lambda: check_replies(
            {**base, "replies": [x for x in base["replies"]
                                 if x["name"] != "alert_delivery_ack"]}, model)),
        ("replies: alert-delivery ack with a short reason", lambda: check_replies(
            {**base, "replies": [
                {**x, **_rebuilt(x["name"], {**model, "alert_ack": {
                    **model["alert_ack"], "reasons": ["malformed"]}})}
                if x["name"] == "alert_delivery_ack" else x for x in base["replies"]]},
            model)),
        ("delivery: check 6 answers with a longer reason", delivery_mutant(
            "differs from the topic's device: `device_mismatch`",
            "differs from the topic's device: `device_identity_mismatch_long`")),
        ("delivery: check 4 answers with a longer reason", delivery_mutant(
            "lists: `malformed`.", "lists: `malformed_or_out_of_form`.")),
        ("delivery: check 7 answers with a longer store reason", delivery_mutant(
            "write its custody queue, a record that passes checks 1 to 6 is `store_unavailable`",
            "write its custody queue, a record that passes checks 1 to 6 is "
            "`custody_store_unavailable`")),
        ("delivery: replayed answered refused", delivery_mutant(
            "`outcome` is `queued` for a commit or a `replayed` record",
            "`outcome` is `queued` for a commit")),
        ("delivery: check 5 answered", delivery_mutant(
            "A message refused at check 5 is not acknowledged",
            "A message refused at check 5 is acknowledged")),
        ("delivery: a retryable reason lengthened", delivery_mutant(
            "with `reason` the check's reason, `queue_full` or `store_unavailable`.",
            "with `reason` the check's reason, `queue_full_for_device_now` or "
            "`store_unavailable`.")),
        ("text: the acknowledgement example gains a member", text_mutant(
            '"record_digest": "sha256:..."\n}', '"record_digest": "sha256:...",\n  "x": ""\n}')),
        ("text: the refused acknowledgement no longer required", text_mutant(
            "`outcome` `refused` with the longest `reason`", "`outcome` `queued` with a `reason`")),
    ]
    survived = 0
    for label, mutant in cases:
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError) as refused:
            print(f"refused  {label}: {refused}")
        else:
            print(f"SURVIVED {label}")
            survived += 1
    print(f"{len(cases)} mutants")
    return survived


def main(argv: list[str]) -> int:
    try:
        model = contract_model()
    except Failure as failure:
        print(f"gateway-api/v2 payload size contract: {failure}")
        return 1
    corpus_bytes = CORPUS.read_bytes()
    try:
        run(corpus_bytes, model)
    except (Failure, KeyError, TypeError, ValueError) as failure:
        print(f"gateway-api/v2 payload size corpus: {failure!r}")
        return 1
    corpus = json.loads(corpus_bytes)
    print(f"gateway-api/v2 payload size corpus: {len(corpus['cases'])} cases over "
          f"{len(model['table'])} topics, each built and decided from the contract")
    if argv == ["--mutations"]:
        survived = mutations(corpus_bytes, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    elif argv:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
