#!/usr/bin/env python3
"""Check the evidence-disposition vectors against evidence-exchange/v2.

`evidence-exchange/vectors/evidence-disposition-v2.json` carries three things, and
every rule each is held to is read from the contract text, never from the
corpus:

- wire cases: every disposition's canonical bytes reproduce, and its Ed25519
  signature is verified under the key its `key_id` selects in the corpus's
  published registry, by purpose and without trial verification; each case's
  outcome is recomputed from the value table and the verification order, so a
  rejection is refused for the reason it names;
- mapping cases: one per row of the emission mapping, plus refusals the mapping
  does not name, each recomputed from the mapping table, which closes the
  vocabulary: a trigger it does not name emits nothing;
- the re-offer schedule: every due, delay and overdue case recomputed from the
  constants the contract's schedule sentence states, at the boundaries it
  names, across restarts;
- runtime sequences: sealed artifacts, dispositions, confirmations, restarts,
  fresh references, epoch changes, identity replacement and Tier C / Tier D
  executions, replayed through the runtime model the contract's verification
  order, effects and re-offer rules state, with every expectation compared.

The *Evidence disposition* section and the *Registration status at the
runtime* block are pinned to `evidence-exchange-disposition-pinned-units.json`
beside this script, and the sentences the model hard-codes are held word for
word.

    python3 scripts/check-evidence-disposition-vectors
    python3 scripts/check-evidence-disposition-vectors --mutations
    python3 scripts/check-evidence-disposition-vectors --print-units

Requires the `cryptography` package; the check refuses to run without it.
"""

from __future__ import annotations

import base64
import copy
import hashlib
import json
import pathlib
import re
import sys

try:
    from cryptography.exceptions import InvalidSignature
    from cryptography.hazmat.primitives.asymmetric.ed25519 import (
        Ed25519PrivateKey,
        Ed25519PublicKey,
    )
except ImportError:  # pragma: no cover - the gate must not pass silently
    print("check-evidence-disposition-vectors: the cryptography package is required", file=sys.stderr)
    sys.exit(1)

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "evidence-exchange" / "v2.md"
HEALTH = ROOT / "runtime-health" / "v3.md"
VECTORS = ROOT / "evidence-exchange" / "vectors" / "evidence-disposition-v2.json"
PINNED = ROOT / "scripts" / "evidence-exchange-disposition-pinned-units.json"
BLOCKS = (
    ("### Evidence disposition", "## Three state models"),
    ("**Registration status at the runtime**", "**Evidence findings**"),
)
PURPOSE = "evidence_authority_disposition"
DOMAIN_RULE = re.compile(r"\| Evidence disposition \| `([a-z_.0-9]+)\\0` \| Ed25519 \| `(\w+)` \|")

