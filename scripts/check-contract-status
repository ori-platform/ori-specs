         e0(impl_only, lambda e: e["implementation"].update(extra=1))),
        ("an unknown current field", "bad-value:current may hold only",
         e0(impl_only, lambda e: e["current"].update(extra=1))),
        ("an unknown assessment field", "bad-value:assessment may hold only",
         e0(impl_only, lambda e: e.update(assessment={"extra": 1}))),
        ("divergences that are not a list of text", "bad-value:non-empty list of text",
         entry_update(impl_only, {**assessed, "divergences": "x"}, conformance="non-conforming")),
        ("a vendored revision that is not a commit", "bad-value:vendored_revision must be",
         e0(impl_only, lambda e: e["implementation"].update(vendored_revision="zzz"))),
        ("a snapshot commit that is not a commit", "bad-value:commit must be a commit",
         e0(impl_only, lambda e: e["current"].update(commit="zz"))),
        ("a current snapshot without its commit", "bad-value:current_implementation_commit",
         e0(impl_only, lambda e: e.update(current={"vendored_revision": "0c34880"}))),
        ("an implemented entry without its implementation commit", "bad-value:commit of the live",
         e0(impl_only, lambda e: e["implementation"].pop("commit"))),
        ("an unreleased entry naming a release", "bad-value:is not shipped but names release",
         e0(impl_only, lambda e: e["implementation"].update(release="v1.0.0"))),
        ("a partial entry recording divergences", "bad-value:partial and records divergences",
         entry_update(impl_only, {**assessed, "divergences": ["x"], "missing_requirements": ["y"]},
                      conformance="partial")),
        ("a conforming entry recording missing requirements", "bad-value:cannot record missing requirements",
         entry_update(impl_only, {**assessed, "missing_requirements": ["y"]}, conformance="conforming")),
        ("an unassessed entry carrying an assessment", "bad-value:leaves conformance unassessed",
         entry_update(impl_only, assessed)),
        ("an unassessed entry recording divergences", "bad-value:which is an assessment",
         entry_update(impl_only, {**assessed, "divergences": ["x"]})),
        ("a claim of status none carrying a commit", "bad-value:status is none",
         e0(impl_only, lambda e: e.update(claim={"status": "none", "commit": "0" * 12}))),
        ("an unknown frozen_by field", "bad-value:frozen_by has unknown fields",
         rec_edit(frozen, lambda r: r["frozen_by"].update(extra=1))),
        ("a freeze date that is not a date", "bad-value:date must be",
         rec_edit(frozen, lambda r: r["frozen_by"].update(date="May"))),
        ("conservative set on a non-conservative event", "bad-value:conservative is true exactly",
         rec_edit(frozen, lambda r: r["frozen_by"].update(conservative=True))),
        ("branch protection outside the vocabulary", "bad-value:branch_protection records",
         rec_edit(frozen, lambda r: r["frozen_by"].update(branch_protection="maybe"))),
        ("a contract revision that is not a commit", "bad-value:contract_revision must name",
         rec_edit(frozen, lambda r: r["frozen_by"].update(contract_revision="zz"))),
        ("a pinned revision that is not a commit", "bad-value:pinned_revision is the ori-specs commit",
         rec_edit(frozen, lambda r: r["frozen_by"].update(pinned_revision="zz"))),
        ("a freeze event naming no repository", "frozen-by-unmatched:must name the repository",
         rec_edit(frozen, lambda r: r["frozen_by"].update(repository="nowhere"))),
        ("a conservative baseline in a repository with no entry", "frozen-by-unmatched:no adoption entry records",
         rec_edit(conservative, lambda r: r["frozen_by"].update(repository="cli"))),
        ("frozen_by on an amendable record", "bad-value:frozen_by belongs only",
         rec_edit(unshipped, lambda r: r.update(frozen_by={}))),
        ("proof missing a field", "bad-value:proof must hold exactly", rec_edit(unshipped, lambda r: r["proof"].pop("hil"))),
        ("a proof state outside the vocabulary", "bad-value:with state one of",
         rec_edit(unshipped, lambda r: r["proof"].update(hil={"state": "sure"}))),
        ("a proof state with no evidence", "proof-without-evidence",
         rec_edit(unshipped, lambda r: r["proof"].update(hil={"state": "partial"}))),
        ("a citation with no path base", "claim-without-citation:declares path_base",
         entry_update(impl_only, claim={"status": "claimed", "commit": "0" * 12, "claim_citation": {
             "path": "README.md", "line": 1, "text": f"Implements {impl_only}."}})),
        ("a citation with no path", "claim-without-citation:names its path",
         entry_update(impl_only, claim={"status": "claimed", "commit": "0" * 12, "claim_citation": {
             "path_base": "repository-root", "line": 1, "text": f"Implements {impl_only}."}})),
        ("a citation with a malformed line", "claim-without-citation:malformed",
         entry_update(impl_only, claim=claim(impl_only, path_base="repository-root", path="a.py", line=0,
                                             text=f"Implements {impl_only}."))),
        ("a citation naming another contract", "claim-citation-unqualified:does not name",
         entry_update(impl_only, claim=claim(impl_only, "This repository implements events/v1."))),
        ("a baseline audit that is not an object", "audit-missing:carries baseline_audit",
         rec_edit(frozen, lambda r: r.update(baseline_audit=[]))),
        ("an unknown baseline audit field", "bad-value:baseline_audit has unknown fields",
         rec_edit(frozen, lambda r: r["baseline_audit"].update(extra=1))),
        ("a freeze revision that is not the event's", "bad-value:freeze_revision is frozen_by",
         rec_edit(frozen, lambda r: r["baseline_audit"].update(freeze_revision="0000000"))),
        ("changes since the freeze that are not commits", "bad-value:changes_since_freeze is a list",
         rec_edit(frozen, lambda r: r["baseline_audit"].update(changes_since_freeze="x"))),
        ("a pending audit without its text digest", "audit-missing:pinned_sha256",
         rec_edit(frozen, lambda r: r["baseline_audit"].pop("pinned_sha256"))),
        ("a pending audit without its file pins", "audit-missing:pinned_files",
         rec_edit(frozen, lambda r: r["baseline_audit"].pop("pinned_files"))),
        ("a complete audit without the contract hash", "bad-value:contract_sha256",
         lambda root: complete_audit(root, lambda a: a.pop("contract_sha256"))),
        ("a complete audit with malformed vectors", "bad-value:vectors as",
         lambda root: complete_audit(root, lambda a: a.update(vectors=[]))),
        ("a complete audit with malformed role commits", "bad-value:role_commits as",
         lambda root: complete_audit(root, lambda a: a.update(role_commits="x"))),
        ("a complete audit whose hunks are not a list", "bad-value:classifies every later hunk",
         lambda root: complete_audit(root, lambda a: a.update(hunks="x"))),
        ("a complete audit with a malformed hunk", "bad-value:needs hunk_sha256",
         lambda root: complete_audit(root, lambda a: a["hunks"].__setitem__(0, {"x": 1}))),
        ("a hunk classified outside the vocabulary", "bad-value:classification must be one of",
         lambda root: complete_audit(root, first_hunk({"classification": "cosmetic"}))),
        ("a complete audit whose baseline is not in history", "baseline-unverifiable",
         lambda root: (complete_audit(root, lambda a: a.update(freeze_revision="0000000")),
                       _edit_json(root, f"status/{audited}.json", lambda r: (
                           r["frozen_by"].update(contract_revision="0000000"),
                           r["frozen_by"].pop("pinned_revision", None))))),
        ("a recorded vector hash that is not the freeze revision's", "baseline-hash-mismatch:vector hash",
         lambda root: complete_audit(root, lambda a: a["vectors"].update(
             {sorted(a["vectors"])[0]: "0" * 64}))),
        ("a README row that links no version document", "readme-row-mismatch:links no",
         lambda root: table_insert(root, "README.md", f"]({unshipped}.md) |",
                                   "| Stray | [gaps](gaps/open.md) | a | b | c |")),
        ("a README row removed", "readme-row-missing", lambda root: table_drop(root, "README.md", f"]({unshipped}.md) |")),
        ("a VERSIONING row with no record", "versioning-row-mismatch:has no record",
         lambda root: table_insert(root, "VERSIONING.md", f"| {unshipped.replace('/', ' | ')} |",
                                   "| nothing | v1 | a | b | c |")),
        ("a VERSIONING row disagreeing with its record", "versioning-row-mismatch:does not match",
         lambda root: table_replace(root, "VERSIONING.md", f"| {unshipped.replace('/', ' | ')} |", "`amendable`",
                                    "`frozen`")),
        ("a VERSIONING row removed", "versioning-row-missing",
         lambda root: table_drop(root, "VERSIONING.md", f"| {unshipped.replace('/', ' | ')} |")),
        ("a contract without its Status paragraph", "status-line-missing",
         lambda root: (root / f"{unshipped}.md").write_text(
             (root / f"{unshipped}.md").read_text().replace("> Status:", "> State:", 1))),
        ("an issue reference in a record", "issue-reference:status/",
         rec_edit(unshipped, lambda r: r.update(notes="See ori-runtime#1."))),
        ("an issue reference in README.md", "issue-reference:README.md",
         lambda root: (root / "README.md").write_text((root / "README.md").read_text() + "\nSee #12.\n")),
    ]
    failed = 0
    # Codes a case must not produce: a valid span citation is accepted, not refused.
    forbidden = {"a heading-plus-item span is a valid citation, so the claim freezes":
                 {"claim-without-citation", "claim-citation-unqualified"}}
    for name, code, mutate in cases:
        with tempfile.TemporaryDirectory() as tmp:
            root = pathlib.Path(tmp) / "specs"
            shutil.copytree(ROOT, root, ignore=shutil.ignore_patterns(".git", "__pycache__"))
            for rel in sorted((root / "status").rglob("*.json")):
                data = json.loads(rel.read_text(encoding="utf-8"))
                if isinstance(data.get("baseline_audit"), dict) and data["baseline_audit"].get("issue") is None:
                    _edit_json(root, rel.relative_to(root).as_posix(), lambda r: r["baseline_audit"].update(
                        issue="https://github.com/ori-platform/ori-specs/issues/1"))
            global BASE_OVERRIDE
            # Every case compares against the records as they stand, as if they were already on main.
            BASE_OVERRIDE = copy.deepcopy(base)
            if mutate(root) == "no-history":
                BASE_OVERRIDE = None
            got = check(root)
            BASE_OVERRIDE = None
            codes = {f.code for f in got}
            if code is None:
                good = not got
                detail = "" if good else "; ".join(str(f) for f in got[:3])
            else:
                want, _, fragment = code.partition(":")
                good = any(f.code == want and fragment in f.message + f.where for f in got) \
                    and not codes & forbidden.get(name, set())
                detail = "" if good else f"got {sorted(codes) or 'no finding'}"
            print(f"{'ok  ' if good else 'FAIL'} {name}" + (f" -> {code}" if code else "") +
                  (f" ({detail})" if detail else ""))
            failed += not good
    total, bad_sibling = sibling_mutations(impl_only)
    failed += bad_sibling
    total += len(cases)
    print(f"{total - failed}/{total} mutations behaved as named")
    return 1 if failed else 0


def sibling_mutations(rel: str) -> tuple[int, int]:
    """Drive --verify-siblings against a synthetic sibling repository built in a scratch directory."""
    c, v = rel.split("/")
    sentence = f"This repository implements {rel}."

    def git(repo: pathlib.Path, *args: str) -> str:
        return subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid",
                               "-c", "commit.gpgsign=false", "-c", "tag.gpgsign=false", *args],
                              capture_output=True, text=True, check=True).stdout.strip()

    def build(tmp: pathlib.Path) -> tuple[pathlib.Path, str, str]:
        repo = tmp / "siblings" / "ori-gateway"
        repo.mkdir(parents=True)
        git(repo, "init", "-q", "-b", "main")
        (repo / "old.txt").write_text("x\n")
        git(repo, "add", "old.txt")
        git(repo, "commit", "-q", "-m", "initial")
        git(repo, "tag", "v0")
        (repo / "impl.go").write_text(f"// {sentence}\n")
        (repo / "MANIFEST.json").write_text(json.dumps({"source_commit": "a" * 40, "files": {
            f"{c}/vectors/x.json": "0" * 64}}))
        git(repo, "add", "impl.go", "MANIFEST.json")
        git(repo, "commit", "-q", "-m", "implement")
        a = git(repo, "rev-parse", "--short=12", "HEAD")
        git(repo, "checkout", "-q", "-b", "side")
        (repo / "side.txt").write_text("x\n")
        git(repo, "add", "side.txt")
        git(repo, "commit", "-q", "-m", "side")
        b = git(repo, "rev-parse", "--short=12", "HEAD")
        git(repo, "checkout", "-q", "main")
        return tmp / "siblings", a, b

    def entry(a: str) -> dict:
        return {"role": "gateway", "repository": "gateway", "lifecycle": "implemented-unreleased",
                "conformance": "unassessed",
                "claim": {"status": "claimed", "commit": a, "claim_citation": {
                    "path_base": "repository-root", "path": "impl.go", "line": 1, "text": sentence}},
                "implementation": {"commit": a, "release": None, "paths": ["impl.go"], "vendored_revision": "aaaaaaa"},
                "current": {"commit": a, "vendored_revision": "aaaaaaa"}}

    cases: list[tuple[str, str | None, Callable[[dict, str, str], None]]] = [
        ("sibling: a snapshot that matches its repository passes", None, lambda e, a, b: None),
        ("sibling: a repository with no checkout", "sibling-unavailable:no checkout",
         lambda e, a, b: e.update(repository="skills-hub")),
        ("sibling: an implementation commit that does not exist", "sibling-missing:does not exist",
         lambda e, a, b: e["implementation"].update(commit="0" * 12)),
        ("sibling: an implementation commit off the default branch", "sibling-missing:is not on",
         lambda e, a, b: e["implementation"].update(commit=b)),
        ("sibling: a component with no mapping", "sibling-unavailable:no --component",
         lambda e, a, b: e["implementation"].update(path_base="component-root", component="library-crate")),
        ("sibling: a path absent at its commit", "sibling-missing:does not exist at",
         lambda e, a, b: e["implementation"].update(paths=["missing.go"])),
        ("sibling: an implementation pin the manifest does not carry", "sibling-vendored:implementation",
         lambda e, a, b: e["implementation"].update(vendored_revision="bbbbbbb")),
        ("sibling: a release that does not contain the implementation", "sibling-missing:does not contain",
         lambda e, a, b: (e.update(lifecycle="shipped"), e["implementation"].update(release="v0"))),
        ("sibling: a current pin the manifest does not carry", "sibling-vendored:current",
         lambda e, a, b: e["current"].update(vendored_revision="bbbbbbb")),
        ("sibling: a citation whose text is not at its line", "sibling-citation",
         lambda e, a, b: e["claim"]["claim_citation"].update(text=f"Nothing here implements {rel}.")),
    ]
    failed = 0
    for name, code, mutate in cases:
        with tempfile.TemporaryDirectory() as tmp:
            tmpdir = pathlib.Path(tmp)
            siblings, a, b = build(tmpdir)
            root = tmpdir / "specs"
            shutil.copytree(ROOT, root, ignore=shutil.ignore_patterns(".git", "__pycache__"))
            for other in (root / "status").rglob("*.json"):
                if other.relative_to(root).as_posix() != f"status/{rel}.json":
                    other.unlink()
            e = entry(a)
            mutate(e, a, b)
            _edit_json(root, f"status/{rel}.json", lambda r: r.update(adoption=[e]))
            got = verify_siblings(root, siblings, {}, {})
            if code is None:
                good = not got
            else:
                want, _, fragment = code.partition(":")
                good = any(f.code == want and fragment in f.message for f in got)
            detail = "" if good else f" (got {[str(f)[:120] for f in got] or 'no finding'})"
            print(f"{'ok  ' if good else 'FAIL'} {name}" + (f" -> {code}" if code else "") + detail)
            failed += not good
    return len(cases), failed


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--mutations", action="store_true", help="prove each check fires on a scratch copy")
    ap.add_argument("--write-status-lines", action="store_true", help="rewrite each Status: paragraph from its record")
    ap.add_argument("--print-rows", action="store_true", help="print the VERSIONING and README rows the records render")
    ap.add_argument("--digest", metavar="CONTRACT/VERSION", help="print the normative digest a pending audit pins")
    ap.add_argument("--write-rows", action="store_true", help="rewrite the README and VERSIONING rows from the records")
    ap.add_argument("--verify-siblings", metavar="DIR",
                    help="check every snapshot against sibling checkouts under DIR; CI cannot run this")
    ap.add_argument("--sibling", action="append", default=[], metavar="ROLE=PATH",
                    help="a checkout for a repository role that has no default directory name")
    ap.add_argument("--component", action="append", default=[], metavar="ROLE:COMPONENT=SUBDIR",
                    help="where a component-root component lives inside its repository")
    ap.add_argument("--draft-audit", metavar="CONTRACT/VERSION",
                    help="print a complete-audit skeleton, hashes and net hunks, for a reviewer to classify")
    args = ap.parse_args()
    if args.mutations:
        return mutations()
    if args.write_status_lines or args.write_rows:
        if args.write_status_lines:
            write_status_lines(ROOT)
        if args.write_rows:
            write_rows(ROOT)
        return 0
    if args.draft_audit:
        key = tuple(args.draft_audit.split("/"))
        rec = load_records(ROOT, [])[key]  # type: ignore[index]
        print(json.dumps(draft_audit(ROOT, key, rec), indent=2))  # type: ignore[arg-type]
        return 0
    if args.print_rows:
        print_rows(ROOT)
        return 0
    if args.digest:
        c, v = args.digest.split("/")
        print(json.dumps({"pinned_sha256": normative_digest((ROOT / f"{args.digest}.md").read_text(encoding="utf-8")),
                          "pinned_files": version_files(ROOT, c, v, versions_in(ROOT, c))}, indent=2))
        return 0
    if args.verify_siblings:
        extra = dict(x.split("=", 1) for x in args.sibling)
        comps = {}
        for x in args.component:
            lhs, sub = x.split("=", 1)
            role, comp = lhs.split(":", 1)
            comps[(role, comp)] = sub
        found = verify_siblings(ROOT, pathlib.Path(args.verify_siblings), extra, comps)
        for f in found:
            print(f, file=sys.stderr)
        print(f"sibling verification: {len(found)} finding(s)")
        return 1 if found else 0
    findings = check(ROOT)
    gaps = [f for f in findings if f.code.startswith("gap-")]
    errors = [f for f in findings if not f.code.startswith("gap-")]
    for f in errors:
        print(f, file=sys.stderr)
    if gaps:
        print(f"\nGaps ({len(gaps)}), which fail the check until closed:", file=sys.stderr)
        for f in gaps:
            print(f"  {f}", file=sys.stderr)
    if findings:
        print(f"\n{len(errors)} finding(s), {len(gaps)} gap(s). {LIMITS}", file=sys.stderr)
        return 1
    print(f"contract status: {len(contract_versions(ROOT))} contract versions agree with their records. Privacy is "
          "checked structurally, over listed forms only; private names are not detected, and the path and "
          "issue-reference checks are not complete.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
