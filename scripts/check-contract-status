         lambda root: complete_audit(root, first_hunk({"optional": False}))),
        ("a baseline hash that is not the freeze revision's", "baseline-hash-mismatch",
         lambda root: complete_audit(root, lambda a: a.update(contract_sha256="0" * 64))),
        ("a frozen vector file changed after a complete audit", "vector-drift", vector_edit),
