         rec_edit(unshipped, lambda r: r.update(contract="elsewhere"))),
        ("'no implementation' wording on an implemented version", "wording-no-implementation",
         lambda root: _insert_status_paragraph(root, f"{shipped_frozen}.md", "No implementation exists.")),
        ("design-target wording on a shipped version", "wording-design-target",
         lambda root: _insert_status_paragraph(root, f"{shipped_frozen}.md", "This is a design target.")),
        ("pre-ratification wording on a ratified version", "wording-pre-ratification",
         lambda root: (decision(root), _edit_json(root, f"status/{unshipped}.json", lambda r: r.update(
             maturity="ratified", ratified_by="decisions/x.md")),
             _insert_status_paragraph(root, f"{unshipped}.md", "It is pre-ratification."))[-1]),
        ("amendable wording on a frozen version", "wording-amendable-while-frozen",
         lambda root: _insert_status_paragraph(root, f"{frozen}.md", "It is amendable in place.")),
        ("an implementation path base outside the vocabulary", "bad-value:path_base must be one of",
         e0(impl_only, lambda e: e["implementation"].update(path_base="elsewhere", paths=["a.py"]))),
        ("a repository-root implementation naming a component", "bad-value:carries no component",
         e0(impl_only, lambda e: e["implementation"].update(path_base="repository-root", component="library-crate"))),
        ("an unknown record field", "bad-value:unknown fields", rec_edit(unshipped, lambda r: r.update(extra=1))),
        ("a maturity outside the vocabulary", "bad-value:maturity must be",
         rec_edit(unshipped, lambda r: r.update(maturity="final"))),
        ("a compatibility outside the vocabulary", "bad-value:compatibility must be",
         rec_edit(unshipped, lambda r: r.update(compatibility="open"))),
        ("ratified_by naming an anchor its record lacks", "ratified-record-missing:has no heading for",
         lambda root: (decision(root), _edit_json(root, f"status/{unshipped}.json", lambda r: r.update(
             maturity="ratified", ratified_by="decisions/x.md#nope")))[-1]),
        ("ratified_by on a draft", "bad-value:belongs only to a ratified",
         rec_edit(unshipped, lambda r: r.update(ratified_by="decisions/x.md"))),
        ("adoption that is not a list", "bad-value:adoption must be a list",
         rec_edit(unshipped, lambda r: r.update(adoption={}))),
        ("an adoption entry that is not an object", "bad-value:must be an object",
         rec_edit(unshipped, lambda r: r.update(adoption=[1]))),
        ("an adoption entry missing a field", "bad-value:needs", e0(impl_only, lambda e: e.pop("lifecycle"))),
        ("a role outside the vocabulary", "bad-value:.role must be", e0(impl_only, lambda e: e.update(role="x"))),
        ("a repository outside the vocabulary", "bad-value:.repository must be",
         e0(impl_only, lambda e: e.update(repository="x"))),
