"""Which checks a change reaches, held as a test rather than a belief.

Every check in validate.yml is gated on scripts/ci-scope, which reads each
hook's `files:` pattern. A wrong pattern costs a check that silently skips the
change it should have refused, so this pins the paths that must reach each
check, that a change outside every check reaches none of the corpus checkers,
that CI's own wiring and an unknown base reach everything, and that every
check step in the workflow is gated on the hook it runs and on nothing else.
"""

from __future__ import annotations

import os
import pathlib
import re
import subprocess
import sys
import tempfile
import unittest

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
SCOPE = ROOT / "scripts" / "ci-scope"
WORKFLOW = ROOT / ".github" / "workflows" / "validate.yml"
CONFIG = ROOT / ".pre-commit-config.yaml"
GATE = re.compile(r"^contains\(steps\.scope\.outputs\.reach, ' ([a-z0-9-]+) '\)$")

#: Checks that read the status model and the Markdown as a whole rather than one
#: corpus; every other check is a corpus checker.
WHOLE_TREE = {"contract-status", "contract-status-mutations", "contract-yaml-blocks"}

#: Steps that run on every change: what the gated steps need, and checks cheap
#: enough, or about the whole tree, to run regardless.
ALWAYS = {
    "Ensure workflow actions are pinned",
    "Install the vector checkers' verifier, hash-locked",
    "Decide which checks this change reaches",
    "Prove the scope decision reaches what it must",
    "Hygiene (pre-commit)",
    "Check contract status records",
    "Check required files exist",
    "Ensure repo remains docs-only",
    "Validate markdown links",
}

#: One changed path, and checks it must reach. Each line is a file the check
#: reads; the ones outside the check's own directory are the easy ones to miss.
