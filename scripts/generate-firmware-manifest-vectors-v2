"""Generate the firmware-telemetry/v2 manifest corpus.

Signatures come from OpenSSL through `cryptography`. Nothing here is shared
with scripts/check-firmware-manifest-vectors-v2, which verifies them with its
own curve arithmetic, canonicalises with its own serializer, and reads the
mode table from the contract rather than from this file.

    python3 scripts/generate-firmware-manifest-vectors-v2          # write
    python3 scripts/generate-firmware-manifest-vectors-v2 --check  # reproduce
"""

from __future__ import annotations

import base64
import hashlib
import json
import pathlib
import sys

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "firmware-telemetry" / "manifest-vectors-v2.json"
PROFILES = ROOT / "firmware-telemetry" / "controller-profile-vectors-v2.json"

SEED_HEX = "42" * 32
DEVICE_ID = "ori-fw-7c9f2b3a"

METERING = {
    "channel": "ch0",
    "sensor_type": "current",
    "unit": "ampere",
    "protocol": "modbus_rtu",
    "source": "pzem",
    "quality_floor": 0.8,
}
METERING_I2C = {
    "channel": "ch2",
    "sensor_type": "current",
    "unit": "ampere",
    "protocol": "i2c",
    "source": "ads1115",
    "quality_floor": 0.9,
}

def _profile_digest(name: str) -> str:
    corpus = json.loads(PROFILES.read_bytes())
    return next(c["digest"] for c in corpus["cases"] if c["name"] == name)


RECTIFIER_DIGEST = _profile_digest("rectifier")


def controller_profile(channel: str, **over: object) -> dict:
    binding = {
        "id": "example-rectifier",
        "digest": RECTIFIER_DIGEST,
        "profile_channel": channel,
        "qualification": "unqualified",
        "record": None,
    }
    binding.update(over)
    return binding


def bridged(**over: object) -> dict:
    channel = {
        "channel": "ch1",
        "sensor_type": "current",
        "unit": "ampere",
        "protocol": "modbus_rtu",
        "source": "foreign_device",
        "quality_floor": 0.8,
        "controller_profile": controller_profile("output_current"),
    }
    channel.update(over)
    return channel


def with_profile(**over: object) -> dict:
    return bridged(controller_profile=controller_profile("output_current", **over))


BRIDGED = bridged()
QUALIFIED = with_profile(
    qualification="qualified", record="controllers/records/example-rectifier.md")
ALARM_WORD = bridged(
    channel="ch3",
    sensor_type="controller_alarm_word",
    unit="bitmask",
    quality_floor=1.0,
    controller_profile=controller_profile("alarm_word_1"),
)
BRIDGED_VOLTAGE = bridged(
    channel="ch4",
    sensor_type="voltage",
    unit="volt",
    controller_profile=controller_profile("output_voltage"),
)
NO_PROFILE = {k: v for k, v in BRIDGED.items() if k != "controller_profile"}
ACTION = {"action": "relay_open", "channel": "relay0", "authority": "runtime_commanded"}
INTERLOCK = {
    "name": "local_overcurrent_interlock",
    "channel": "ch0",
    "action": "relay_open",
}

# (name, device_mode, channels, actions, interlocks, note) for every accepted case.
ACCEPT = (
    (
        "sensor_node",
        "sensor_node",
        [METERING],
        [],
        [],
        "one metering channel and no action",
    ),
    (
        "sensor_node_two_sources",
        "sensor_node",
        [METERING, METERING_I2C],
        [],
        [],
        "every channel whose source is not foreign_device meters, whatever its "
        "source or protocol",
    ),
    (
        "bridge_node",
        "bridge_node",
        [BRIDGED],
        [],
        [],
        "one bridged channel and no action",
    ),
    (
        "mixed_metering_bridged",
        "mixed",
        [METERING, BRIDGED],
