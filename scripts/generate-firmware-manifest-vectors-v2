        [BRIDGED],
        [ACTION],
        [],
        "a bridged channel and an action",
    ),
    (
        "mixed_all_three",
        "mixed",
        [BRIDGED, METERING],
        [ACTION],
        [INTERLOCK],
        "all three roles; the bridged channel comes first, so no position "
        "decides the mode",
    ),
    (
        "bridge_node_qualified",
        "bridge_node",
        [QUALIFIED],
        [],
        [],
        "a bridged channel whose profile the device attests qualified, naming "
        "its record",
    ),
    (
        "bridge_node_alarm_word",
        "bridge_node",
        [BRIDGED, ALARM_WORD],
        [],
        [],
        "an alarm-word channel reads the profile's alarm word as a bitmask",
    ),
    (
        "bridge_node_one_profile_three_channels",
        "bridge_node",
        [BRIDGED, BRIDGED_VOLTAGE, ALARM_WORD],
        [],
        [],
        "three channels read three channels of one profile, under one digest",
    ),
    (
        "bridge_node_shortest_record",
        "bridge_node",
        [with_profile(qualification="qualified", record="r")],
        [],
        [],
        "a one-character record",
    ),
    (
        "bridge_node_longest_record",
        "bridge_node",
        [with_profile(qualification="qualified", record="c/" + "r" * 125)],
        [],
        [],
        "a 127-character record",
    ),
    (
        "bridge_node_shortest_profile_id",
        "bridge_node",
        [bridged(sensor_type="frequency", unit="hertz",
                 controller_profile=controller_profile(
                     "frequency", id="M", digest=_profile_digest("meter_bounds")))],
        [],
        [],
        "a one-character profile id",
    ),
    (
        "bridge_node_longest_profile_id",
        "bridge_node",
        [bridged(sensor_type="controller_alarm_word", unit="bitmask", quality_floor=1.0,
                 controller_profile=controller_profile(
                     "alarms", id="a" * 48, digest=_profile_digest("thirty_two_alarms")))],
        [],
        [],
        "a 48-character profile id",
    ),
    (
        "mixed_metering_and_alarm_word",
        "mixed",
        [METERING, ALARM_WORD],
        [],
        [],
        "an alarm-word channel is bridged, so with a metering channel the "
        "device is mixed",
    ),
)

# (name, reason, device_mode, channels, actions, interlocks, note).
# Every signature is valid.
REJECT = (
    (
        "reject_mode_unknown_string",
        "invalid_device_mode",
        "gateway_node",
        [METERING],
        [],
        [],
        "a string outside the four values, over arrays that make the device a "
        "sensor_node",
    ),
    (
        "reject_mode_wrong_case",
        "invalid_device_mode",
        "Sensor_Node",
        [METERING],
        [],
        [],
        "values compare exactly; a case variant of sensor_node is no value",
    ),
    (
        "reject_mode_integer",
        "invalid_device_mode",
        0,
        [METERING],
        [],
        [],
        "device_mode is a JSON string; an integer is another type",
    ),
    (
        "reject_mode_null",
        "invalid_device_mode",
        None,
        [METERING],
        [],
