        "reject_bridge_node_with_metering_channel",
        "invalid_device_mode",
        "bridge_node",
        [BRIDGED, METERING],
        [],
        [],
        "a bridge that also meters is mixed",
    ),
    (
        "reject_mixed_single_role",
        "invalid_device_mode",
        "mixed",
        [METERING],
        [],
        [],
        "mixed needs more than one role; metering alone is a sensor_node",
    ),
    (
        "reject_actuator_node_over_mixed",
        "invalid_device_mode",
        "actuator_node",
        [METERING],
        [ACTION],
        [INTERLOCK],
        "an actuator that declares a channel is mixed",
    ),
    (
        "reject_actuator_node_no_channels",
        "no_channels",
        "actuator_node",
        [],
        [ACTION],
        [],
        "the mode agrees with the arrays, so the empty channels alone refuse "
        "it; actuator_node is never accepted under this version",
    ),
)


def bad_profile(name: str, note: str, **over: object) -> tuple:
    return (name, "invalid_controller_profile", "bridge_node",
            [with_profile(**over)], [], [], note)


def bad_profile_value(name: str, value: object, note: str) -> tuple:
    return (name, "invalid_controller_profile", "bridge_node",
            [bridged(controller_profile=value)], [], [], note)


_PROFILE_NO_RECORD = {k: v for k, v in controller_profile("output_current").items()
                      if k != "record"}

REJECT_PROFILES = (
    ("reject_bridged_without_profile", "controller_profile_missing", "bridge_node",
     [NO_PROFILE], [], [],
     "a bridged channel that names no profile; this was a valid v1 bridged "
     "channel"),
    ("reject_alarm_word_without_profile", "controller_profile_missing", "bridge_node",
     [BRIDGED, {k: v for k, v in ALARM_WORD.items() if k != "controller_profile"}], [], [],
     "an alarm word with no profile could not be interpreted at all"),
    ("reject_profile_on_metering_channel", "controller_profile_unexpected", "sensor_node",
     [dict(METERING, controller_profile=controller_profile("output_current"))], [], [],
     "a metering channel decodes through no controller profile"),
    bad_profile("reject_profile_id_bad_character", "a space is outside the fleet alphabet",
                id="example rectifier"),
    bad_profile("reject_profile_id_too_long", "an id is at most 48 characters", id="a" * 49),
    bad_profile("reject_profile_id_empty", "an id is at least one character", id=""),
    bad_profile("reject_digest_uppercase", "the digest is lowercase hex",
                digest=RECTIFIER_DIGEST.upper().replace("SHA256:", "sha256:")),
    bad_profile("reject_digest_no_prefix", "the digest carries its sha256: prefix",
                digest=RECTIFIER_DIGEST[len("sha256:"):]),
    bad_profile("reject_digest_long", "sixty-five hex digits are not a SHA-256",
                digest=RECTIFIER_DIGEST + "0"),
    bad_profile("reject_digest_short", "sixty-three hex digits are not a SHA-256",
                digest=RECTIFIER_DIGEST[:-1]),
    bad_profile("reject_profile_channel_bad_character",
                "a slash is outside the fleet alphabet", profile_channel="output/current"),
    bad_profile("reject_profile_id_not_string", "an id is a string", id=7),
    bad_profile("reject_profile_channel_empty", "a fleet identifier is at least one character",
                profile_channel=""),
    bad_profile("reject_profile_channel_too_long", "a fleet identifier is at most 48 characters",
                profile_channel="p" * 49),
    bad_profile("reject_digest_not_string", "a digest is a string", digest=7),
    bad_profile("reject_profile_channel_not_string", "a profile channel is a string",
                profile_channel=["output_current"]),
    bad_profile("reject_qualification_boolean", "qualification is a string",
                qualification=True),
    bad_profile("reject_record_not_string", "a record is a string or null",
                qualification="qualified", record=5),
    bad_profile("reject_record_dots_inside_segment", "a record never contains ..",
                qualification="qualified", record="controllers/records/r..md"),
    bad_profile("reject_qualification_unknown", "qualified or unqualified only",
                qualification="pending"),
    bad_profile("reject_qualified_without_record", "a qualified profile names its record",
                qualification="qualified"),
    bad_profile("reject_unqualified_with_record",
                "a record on an unqualified profile would read as a qualification",
                record="controllers/records/example-rectifier.md"),
    bad_profile("reject_record_absolute", "a record does not begin with a slash",
                qualification="qualified", record="/controllers/records/r.md"),
    bad_profile("reject_record_parent", "a record contains no ..",
                qualification="qualified", record="controllers/../records/r.md"),
    bad_profile("reject_record_empty_segment", "a record has no empty segment",
                qualification="qualified", record="controllers//r.md"),
    bad_profile("reject_record_trailing_slash", "a record has no trailing slash",
                qualification="qualified", record="controllers/records/"),
    bad_profile("reject_record_empty", "a record is at least one character",
                qualification="qualified", record=""),
    bad_profile("reject_record_too_long", "a record is at most 127 characters",
                qualification="qualified", record="r" * 128),
    bad_profile("reject_record_bad_character", "a space is outside the record alphabet",
                qualification="qualified", record="controllers/records/r 1.md"),
    bad_profile_value("reject_profile_extra_key",
                      dict(controller_profile("output_current"), bus_address=7),
                      "the object's keys are exactly five; a site's bus address is not one"),
    bad_profile_value("reject_profile_missing_record_key", _PROFILE_NO_RECORD,
                      "record is present, as null, on an unqualified profile"),
    bad_profile_value("reject_profile_not_object", RECTIFIER_DIGEST,
                      "controller_profile is an object, not a bare digest"),
    ("reject_one_profile_two_qualifications", "invalid_controller_profile", "bridge_node",
     [QUALIFIED, BRIDGED_VOLTAGE], [], [],
     "two channels name one profile id, one qualified and one not; a device "
     "holds one qualification per profile"),
    ("reject_one_profile_two_digests", "invalid_controller_profile", "bridge_node",
     [BRIDGED, bridged(channel="ch4", sensor_type="voltage", unit="volt",
                       controller_profile=controller_profile(
                           "output_voltage", digest="sha256:" + "0" * 64))], [], [],
     "two channels name one profile id under two digests"),
    ("reject_one_profile_two_records", "invalid_controller_profile", "bridge_node",
     [QUALIFIED, bridged(channel="ch4", sensor_type="voltage", unit="volt",
                         controller_profile=controller_profile(
                             "output_voltage", qualification="qualified",
                             record="controllers/records/other.md"))], [], [],
     "two channels name one qualified profile under one digest with two records"),
    ("reject_one_digest_two_ids", "invalid_controller_profile", "bridge_node",
     [BRIDGED, bridged(channel="ch4", sensor_type="voltage", unit="volt",
                       controller_profile=controller_profile(
                           "output_voltage", id="other-rectifier"))], [], [],
     "one digest named under two profile ids"),
    ("reject_bridged_other_protocol", "invalid_controller_profile", "bridge_node",
     [bridged(protocol="i2c")], [], [],
     "a controller profile describes Modbus RTU registers; a bridged channel "
     "on another protocol has no profile that could decode it"),
    ("reject_alarm_word_type_on_metering", "invalid_alarm_channel", "sensor_node",
     [dict(METERING, sensor_type="controller_alarm_word", unit="bitmask")], [], [],
     "an alarm word is read from a foreign controller, so only a bridged channel "
     "may be one"),
    ("reject_bitmask_unit_on_metering", "invalid_alarm_channel", "sensor_node",
     [dict(METERING, unit="bitmask")], [], [],
     "the unit alone, on a metering channel"),
    ("reject_alarm_word_type_on_metering_alone", "invalid_alarm_channel", "sensor_node",
     [dict(METERING, sensor_type="controller_alarm_word")], [], [],
     "the sensor type alone, on a metering channel"),
    ("reject_alarm_word_type_wrong_unit", "invalid_alarm_channel", "bridge_node",
     [bridged(sensor_type="controller_alarm_word", unit="ampere",
              controller_profile=controller_profile("alarm_word_1"))], [], [],
     "an alarm word's unit is bitmask"),
    ("reject_bitmask_unit_on_measurement", "invalid_alarm_channel", "bridge_node",
     [bridged(unit="bitmask")], [], [],
     "bitmask is the unit of an alarm word only"),
)


def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def build() -> bytes:
    key = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(SEED_HEX))
    public = key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    public_b64 = base64.b64encode(public).decode("ascii")

    def signed(mode: object, channels: list, actions: list, interlocks: list) -> dict:
        manifest = {
            "v": 1,
            "alg": "ed25519",
            "device_id": DEVICE_ID,
            "firmware_version": "0.1.0",
            "board_profile": "esp32s3-poe-8di8do",
            "device_mode": mode,
            "public_key_b64": public_b64,
            "posture": "sealed_flash",
            "secure_boot_enabled": True,
            "flash_encryption_enabled": True,
            "key_storage": "efuse_derived",
            "transports": ["mqtt", "rs485"],
            "channels": [dict(c) for c in channels],
            "actions": [dict(a) for a in actions],
            "interlocks": [dict(i) for i in interlocks],
        }
        body = canonical(manifest)
        digest = hashlib.sha256(body).hexdigest()
        message = {
            "manifest": manifest,
            "manifest_hash": "sha256:" + digest,
            "signature": "ed25519:" + base64.b64encode(key.sign(body)).decode("ascii"),
        }
        return {
            "message": message,
            "canonical_hex": body.hex(),
            "canonical_sha256_hex": digest,
            "message_hex": canonical(message).hex(),
        }

    cases = []
    for name, mode, channels, actions, interlocks, note in ACCEPT:
        cases.append(
            {"name": name, **signed(mode, channels, actions, interlocks), "note": note}
        )
    reject_cases = []
    for name, reason, mode, channels, actions, interlocks, note in REJECT + REJECT_PROFILES:
        reject_cases.append(
            {
                "name": name,
                "reason": reason,
                "signature_valid": True,
                **signed(mode, channels, actions, interlocks),
                "note": note,
            }
        )

    corpus = {
        "contract": "ori-specs/firmware-telemetry/v2.md",
        "version": 2,
        "comment": (
            "Golden vectors for firmware-telemetry/v2 Device Mode and "
            "Controller Profiles. Each case is "
            "a signed capability manifest message whose manifest is otherwise "
            "valid under v1. A consumer of this version must accept every case "
            "in 'cases' and refuse every case in 'reject_cases' with the "
            "declared reason. Each case is judged on its own against "
            "verifier_context, as the first manifest registered for that "
            "provisioning anchor. Signed with a disclosed TEST-ONLY seed, the "
            "same one the fault corpus discloses: never provision it."
        ),
        "test_seed_hex": SEED_HEX,
        "public_key_hex": public.hex(),
        "public_key_b64": public_b64,
        "signature_encoding": "ed25519:<standard-base64-64-byte-signature>",
        "verifier_context": {
            "device_id": DEVICE_ID,
            "public_key_b64": public_b64,
        },
        "reasons": {
            "invalid_device_mode": (
                "device_mode is not one of the four values, including a value "
                "of another JSON type, or is not the value the manifest's "
                "channels and actions determine"
            ),
            "no_channels": "channels is empty",
            "controller_profile_missing": "a bridged channel carries no "
                                          "controller_profile",
            "controller_profile_unexpected": "a channel that is not bridged "
                                             "carries controller_profile",
            "invalid_controller_profile": "a controller_profile breaks its "
                                          "grammar, or a bridged channel's "
                                          "protocol is not modbus_rtu",
            "invalid_alarm_channel": "controller_alarm_word or bitmask on a "
                                     "channel that is not a bridged alarm word",
        },
        "cases": cases,
        "reject_cases": reject_cases,
    }
    return (json.dumps(corpus, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = build()
    if argv == ["--check"]:
        if OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator")
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv:
        print(__doc__)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)} sha256 {hashlib.sha256(data).hexdigest()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
