"""Generate the evidence-exchange/v3 restated-records receiver-state corpus.

Writes evidence-exchange/vectors/receiver-state/restated-records-v3.json. Each
case is the runtime's held records before an inbound artifact, the artifact,
an optional injected store fault, the answer, and the held records after.
Expected values come from a small model of evidence-exchange/v3 Restated
records, All or nothing and Store faults, and of runtime-health/v4's
application-storage fault signal. Signing material is read from the published
v2 corpora; nothing new is minted. The checker is written separately and
shares no code with this file.

Run from the repository root:

    python3 scripts/generate-evidence-exchange-receiver-state-vectors-v3          # write
    python3 scripts/generate-evidence-exchange-receiver-state-vectors-v3 --check  # compare
"""

from __future__ import annotations

import base64
import copy
import hashlib
import hmac
import json
import pathlib
import sys
from typing import Any

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.kdf.hkdf import HKDF
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
VECTORS = ROOT / "evidence-exchange" / "vectors"
OUT = VECTORS / "receiver-state" / "restated-records-v3.json"
NAME = "generate-evidence-exchange-receiver-state-vectors-v3"

CUSTODY_DOMAIN = "ori.evidence_custody_ack.v1"
RECEIPT_DOMAIN = "ori.evidence_delivery_receipt.v1"
EPOCH_DOMAIN = "ori.evidence_epoch_confirmation.v1"
DISPOSITION_DOMAIN = "ori.evidence_disposition.v1"

DEVICE_ID = "energy-monitor-ikeja-01"
T0 = 1787000000000


def load(name: str) -> dict:
    return json.loads((VECTORS / name).read_text(encoding="utf-8"))


def canonical(obj: Any) -> bytes:
    return json.dumps(obj, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False, allow_nan=False).encode("utf-8")


def sha(label: str) -> str:
    return "sha256:" + hashlib.sha256(label.encode("utf-8")).hexdigest()


def public_hex(seed_hex: str) -> str:
    key = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(seed_hex))
    return key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw).hex()


def authority_key_id(public: str) -> str:
    return "sha256:" + hashlib.sha256(bytes.fromhex(public)).hexdigest()


def custody_key_id(secret: bytes) -> str:
    derived = HKDF(algorithm=hashes.SHA256(), length=16,
                   salt=b"ori.evidence_custody_key_id.v1",
                   info=b"gateway_custody").derive(secret)
    return "hkdf-sha256:" + derived.hex()


def preimage(domain: str, artifact: dict, authenticator: str) -> bytes:
    body = {k: v for k, v in artifact.items() if k != authenticator}
    return domain.encode("ascii") + b"\x00" + canonical(body)


# --- published material ---------------------------------------------------------------

_custody = load("custody-acknowledgement.json")
ACTIVE_SECRET = bytes.fromhex(_custody["gateway_secret_hex"])
PREVIOUS_SECRET = bytes.fromhex(_custody["previous_gateway_secret_hex"])
CUSTODY_ACTIVE = custody_key_id(ACTIVE_SECRET)
CUSTODY_PREVIOUS = custody_key_id(PREVIOUS_SECRET)
assert CUSTODY_ACTIVE == _custody["registry_state"]["active"]["key_id"]
assert CUSTODY_PREVIOUS == _custody["registry_state"]["verify_only"]["key_id"]

_receipt = load("delivery-receipt-v2.json")
_registry_corpus = load("authority-key-registry-v2.json")
_test_keys = {k["name"]: k["seed_hex"] for k in _registry_corpus["test_keys"]}
_disposition = load("evidence-disposition-v2.json")
_envelope = load("delivery-envelope.json")

SEEDS = {
    "receipt_active": _receipt["authority_receipt_seed_hex"],
    "receipt_verify_only": _test_keys["test key 0"],
    "epoch_active": _receipt["epoch_authority_seed_hex"],
    "epoch_verify_only": _test_keys["test key 3"],
    "disposition_active": _disposition["signing_key_seed_hex"],
}
PURPOSE = {
    "receipt_active": ("evidence_authority_receipt", "active"),
    "receipt_verify_only": ("evidence_authority_receipt", "verify_only"),
    "epoch_active": ("evidence_authority_epoch", "active"),
    "epoch_verify_only": ("evidence_authority_epoch", "verify_only"),
    "disposition_active": ("evidence_authority_disposition", "active"),
}
KEY_ID = {name: authority_key_id(public_hex(seed)) for name, seed in SEEDS.items()}

DEVICE_PUBKEY = _envelope["signing_key_public_hex"]
PREVIOUS_PUBKEY = public_hex(_envelope["previous_generation_seed_hex"])
EPOCH_CURRENT = next(c for c in _envelope["cases"] if c["name"] == "valid")["artifact"][
    "anchor_epoch_id"]
EPOCH_EARLIER = next(c for c in _envelope["cases"] if c["name"] == "superseded_epoch")[
    "artifact"]["anchor_epoch_id"]

SEALED_ENVELOPES = [
    {
        "local_seq": seq,
        "anchor_epoch_id": EPOCH_CURRENT,
        "chain_row_digest": sha(f"ori-specs evidence-exchange/v3 restated records chain row {seq}"),
        "envelope_digest": sha(f"ori-specs evidence-exchange/v3 restated records envelope {seq}"),
    }
    for seq in (1, 2, 3, 4)
]
SEALED_REGISTRATIONS = [
    {"anchor_epoch_id": EPOCH_EARLIER, "pubkey_hex": PREVIOUS_PUBKEY},
    {"anchor_epoch_id": EPOCH_CURRENT, "pubkey_hex": DEVICE_PUBKEY},
]
SEALED_ARTIFACTS = [
    {"artifact_type": "checkpoint", "anchor_epoch_id": epoch,
     "digest": sha(f"ori-specs evidence-exchange/v3 restated records checkpoint {n}")}
    for n, epoch in ((1, EPOCH_CURRENT), (2, EPOCH_CURRENT), (3, EPOCH_EARLIER))
]

# --- artifacts -------------------------------------------------------------------------


def custody(seq: int, at_ms: int, generation: str) -> dict:
    secret = ACTIVE_SECRET if generation == "active" else PREVIOUS_SECRET
    artifact = {
        "v": 1, "device_id": DEVICE_ID, "local_seq": seq,
        "envelope_digest": SEALED_ENVELOPES[seq - 1]["envelope_digest"],
        "custody_at_ms": at_ms, "key_id": custody_key_id(secret),
    }
    mac = hmac.new(secret, preimage(CUSTODY_DOMAIN, artifact, "mac"), hashlib.sha256)
    artifact["mac"] = "hmac-sha256:" + mac.hexdigest()
    return artifact


def sign(artifact: dict, domain: str, key: str) -> dict:
    artifact = dict(artifact, key_id=KEY_ID[key])
    private = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(SEEDS[key]))
    signature = private.sign(preimage(domain, artifact, "signature"))
    artifact["signature"] = "ed25519:" + base64.b64encode(signature).decode("ascii")
    return artifact


def receipt(first: int, last: int, at_ms: int, key: str = "receipt_active") -> dict:
    raw = b"".join(bytes.fromhex(e["chain_row_digest"][7:])
                   for e in SEALED_ENVELOPES if first <= e["local_seq"] <= last)
    return sign({
        "v": 1, "device_id": DEVICE_ID, "from_seq": first, "to_seq": last,
        "range_digest": "sha256:" + hashlib.sha256(raw).hexdigest(),
        "accepted_at_ms": at_ms,
    }, RECEIPT_DOMAIN, key)


def confirmation(epoch: str, actor: str, at_ms: int, key: str = "epoch_active") -> dict:
    pubkey = next(r["pubkey_hex"] for r in SEALED_REGISTRATIONS if r["anchor_epoch_id"] == epoch)
    return sign({
        "v": 1, "device_id": DEVICE_ID, "anchor_epoch_id": epoch, "pubkey_hex": pubkey,
        "actor": actor, "confirmed_at_ms": at_ms,
    }, EPOCH_DOMAIN, key)


DISPOSITION_BY_SCOPE = {"artifact": "artifact_terminal",
                        "epoch": "epoch_reprovisioning_required",
                        "identity": "identity_replacement_required"}


def disposition(trigger: int, at_ms: int, scope: str = "epoch") -> dict:
    """A disposition triggered by sealed artifact *trigger*, under the epoch that artifact names."""
    sealed = SEALED_ARTIFACTS[trigger - 1]
    return sign({
        "v": 1, "device_id": DEVICE_ID, "anchor_epoch_id": sealed["anchor_epoch_id"],
        "triggering_digest": sealed["digest"],
        "scope": scope, "disposition": DISPOSITION_BY_SCOPE[scope],
        "decided_at_ms": at_ms,
    }, DISPOSITION_DOMAIN, "disposition_active")


def stop_of(artifact: dict) -> dict | None:
    """The stop record a disposition's effect produces; an identity stop names no epoch."""
    if artifact["scope"] == "artifact":
        return None
    return {"scope": artifact["scope"],
            "anchor_epoch_id": artifact["anchor_epoch_id"] if artifact["scope"] == "epoch" else ""}


def applied_disposition(artifact: dict) -> dict:
    """The held record: the body's fields and the complete signed artifact's digest."""
    record = {k: artifact[k] for k in ("triggering_digest", "anchor_epoch_id", "scope",
                                       "disposition", "decided_at_ms", "key_id")}
    record["artifact_digest"] = "sha256:" + hashlib.sha256(canonical(artifact)).hexdigest()
    return record


# A second valid Ed25519 signature over the same preimage, from a nonce other
# than RFC 8032's deterministic one, so a re-signed disposition is a different
# artifact with an identical body. Affine arithmetic over edwards25519.
_P = 2**255 - 19
_L = 2**252 + 27742317777372353535851937790883648493
_D = (-121665 * pow(121666, _P - 2, _P)) % _P
_GY = 4 * pow(5, _P - 2, _P) % _P


def _recover_x(y: int, sign: int) -> int:
    xx = (y * y - 1) * pow(_D * y * y + 1, _P - 2, _P) % _P
    x = pow(xx, (_P + 3) // 8, _P)
    if (x * x - xx) % _P:
        x = x * pow(2, (_P - 1) // 4, _P) % _P
    if x % 2 != sign:
        x = _P - x
    return x


_G = (_recover_x(_GY, 0), _GY)


def _add(a: tuple, b: tuple) -> tuple:
    (x1, y1), (x2, y2) = a, b
    t = _D * x1 * x2 * y1 * y2 % _P
    return ((x1 * y2 + x2 * y1) * pow(1 + t, _P - 2, _P) % _P,
            (y1 * y2 + x1 * x2) * pow(1 - t, _P - 2, _P) % _P)


def _mul(k: int, point: tuple) -> tuple:
    out = (0, 1)
    while k:
        if k & 1:
            out = _add(out, point)
        point = _add(point, point)
        k >>= 1
    return out


def _encode(point: tuple) -> bytes:
    x, y = point
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


def resign(artifact: dict, domain: str, key: str) -> dict:
    """The same body signed again under *key* with a non-deterministic nonce."""
    body = {k: v for k, v in artifact.items() if k != "signature"}
    message = preimage(domain, body, "signature")
    digest = hashlib.sha512(bytes.fromhex(SEEDS[key])).digest()
    a = int.from_bytes(digest[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    public = _encode(_mul(a, _G))
    assert public.hex() == public_hex(SEEDS[key])
    r = int.from_bytes(hashlib.sha512(b"ori-specs restated records second nonce" + message).digest(),
                       "little") % _L
    big_r = _encode(_mul(r, _G))
    k = int.from_bytes(hashlib.sha512(big_r + public + message).digest(), "little") % _L
    signature = big_r + ((r + k * a) % _L).to_bytes(32, "little")
    Ed25519PrivateKey.from_private_bytes(bytes.fromhex(SEEDS[key])).public_key().verify(
        signature, message)
    resigned = dict(body, signature="ed25519:" + base64.b64encode(signature).decode("ascii"))
    assert resigned["signature"] != artifact["signature"]
    return resigned


# --- held records ----------------------------------------------------------------------


def held(**members: Any) -> dict:
    state = {
        "custody": [], "receipts": [], "epoch_confirmations": [], "active_epoch": None,
        "registration_obligations": [
            {"anchor_epoch_id": r["anchor_epoch_id"], "pubkey_hex": r["pubkey_hex"],
             "state": "open", "closed_at_ms": None} for r in SEALED_REGISTRATIONS],
        "dispositions": [], "stops": [],
        "application_storage_fault": False,
    }
    for key, value in members.items():
        assert key in state, key
        state[key] = value
    return state


def held_custody(seq: int, at_ms: int, generation: str, recorded: int | None) -> dict:
    return {"local_seq": seq, "custody_at_ms": at_ms,
            "key_id": CUSTODY_ACTIVE if generation == "active" else CUSTODY_PREVIOUS,
            "recorded_at_ms": recorded}


def held_receipts(first: int, last: int, at_ms: int, key: str = "receipt_active") -> list:
    return [{"local_seq": s, "accepted_at_ms": at_ms, "key_id": KEY_ID[key]}
            for s in range(first, last + 1)]


PROJECTION = ("device_id", "anchor_epoch_id", "pubkey_hex", "actor", "confirmed_at_ms", "key_id")


def confirmed(epoch: str, actor: str, at_ms: int, applied: int,
              key: str = "epoch_active") -> dict:
    """The held records of one applied confirmation of *epoch*."""
    pubkey = next(r["pubkey_hex"] for r in SEALED_REGISTRATIONS if r["anchor_epoch_id"] == epoch)
    record = {"device_id": DEVICE_ID, "anchor_epoch_id": epoch, "pubkey_hex": pubkey,
              "actor": actor,
              "confirmed_at_ms": at_ms, "key_id": KEY_ID[key], "applied_at_ms": applied}
    state = held(epoch_confirmations=[record])
    state["registration_obligations"] = [
        dict(o, state="confirmed", closed_at_ms=applied) if o["anchor_epoch_id"] == epoch else o
        for o in state["registration_obligations"]]
    if epoch == EPOCH_CURRENT:
        state["active_epoch"] = {k: record[k] for k in PROJECTION}
    return state


def earlier_epoch_confirmed() -> dict:
    """An earlier epoch confirmed while it was the sealing epoch; the current one open."""
    state = confirmed(EPOCH_EARLIER, "commissioning@site", T0 + 1000, T0 + 1100)
    record = state["epoch_confirmations"][0]
    state["active_epoch"] = {k: record[k] for k in PROJECTION}
    return state


def both_epochs_confirmed() -> dict:
    """The earlier epoch confirmed, then the current one; the current is active and effective."""
    state = earlier_epoch_confirmed()
    current = confirmed(EPOCH_CURRENT, ACTOR, CONFIRMED_AT, T0 + 2100)
    state["epoch_confirmations"] += current["epoch_confirmations"]
    state["registration_obligations"] = [
        dict(o, state="confirmed", closed_at_ms=T0 + 2100) if o["anchor_epoch_id"] == EPOCH_CURRENT else o
        for o in state["registration_obligations"]]
    state["active_epoch"] = current["active_epoch"]
    return state


# --- the model -------------------------------------------------------------------------


class StoreFault(Exception):
    pass


class Transaction:
    """Writes against a copy; a fault point raises before the copy is kept."""

    def __init__(self, state: dict, fault: str | None) -> None:
        assert fault in (None, "at_read", "after_first_write", "at_commit", "at_refusal_record"), fault
        if fault == "at_read":
            raise StoreFault
        self.state = copy.deepcopy(state)
        self.fault = fault
        self.writes = 0

    def write(self) -> None:
        self.writes += 1
        if self.fault == "after_first_write" and self.writes == 2:
            raise StoreFault

    def commit(self) -> dict:
        if self.fault == "at_commit" and self.writes == 0:
            raise AssertionError("at_commit needs an application that writes")
        if self.fault == "at_commit":
            raise StoreFault
        if self.fault == "after_first_write":
            raise AssertionError("after_first_write needs a second write to fault on")
        return self.state


def decide(kind: str, before: dict, artifact: dict, now: int,
           fault: str | None) -> tuple[str, str | None, dict, list | None]:
    """The answer, with the refusal-record point applied after the decision."""
    expected, reason, after, applied = decide_once(
        kind, before, artifact, now, None if fault == "at_refusal_record" else fault)
    if fault == "at_refusal_record":
        assert expected == "reject", "at_refusal_record applies only to a decided refusal"
        after = dict(copy.deepcopy(before), application_storage_fault=True)
    return expected, reason, after, applied


def decide_once(kind: str, before: dict, artifact: dict, now: int,
                fault: str | None) -> tuple[str, str | None, dict, list | None]:
    applied: list | None = None
    try:
        tx = Transaction(before, fault)
        s = tx.state
        if kind == "custody_acknowledgement":
            current = next((c for c in s["custody"] if c["local_seq"] == artifact["local_seq"]), None)
            if current is None:
                s["custody"].append({"local_seq": artifact["local_seq"],
                                     "custody_at_ms": artifact["custody_at_ms"],
                                     "key_id": artifact["key_id"], "recorded_at_ms": now})
                s["custody"].sort(key=lambda c: c["local_seq"])
                tx.write()
            elif current["custody_at_ms"] != artifact["custody_at_ms"]:
                return "reject", "restatement_conflict", before, None
            elif current["recorded_at_ms"] is None:
                current["recorded_at_ms"] = now
                tx.write()
        elif kind == "delivery_receipt":
            held_seqs = {r["local_seq"] for r in s["receipts"]}
            applied = [q for q in range(artifact["from_seq"], artifact["to_seq"] + 1)
                       if q not in held_seqs]
            for q in applied:
                s["receipts"].append({"local_seq": q, "accepted_at_ms": artifact["accepted_at_ms"],
                                      "key_id": artifact["key_id"]})
                tx.write()
            s["receipts"].sort(key=lambda r: r["local_seq"])
        elif kind == "epoch_confirmation":
            epoch = artifact["anchor_epoch_id"]
            current = next((c for c in s["epoch_confirmations"]
                            if c["anchor_epoch_id"] == epoch), None)
            if current is not None:
                if any(current[k] != artifact[k] for k in ("confirmed_at_ms", "actor", "key_id")):
                    return "reject", "restatement_conflict", before, None
            else:
                s["epoch_confirmations"].append(
                    dict({k: artifact[k] for k in PROJECTION}, applied_at_ms=now))
                tx.write()
                if epoch == EPOCH_CURRENT:
                    s["active_epoch"] = {k: artifact[k] for k in PROJECTION}
                    tx.write()
                for o in s["registration_obligations"]:
                    if (o["anchor_epoch_id"], o["pubkey_hex"], o["state"]) == (
                            epoch, artifact["pubkey_hex"], "open"):
                        o["state"], o["closed_at_ms"] = "confirmed", now
                        tx.write()
        elif kind == "evidence_disposition":
            record = applied_disposition(artifact)
            stop = stop_of(artifact)
            identity_stopped = any(x["scope"] == "identity" for x in s["stops"])
            if any(d["artifact_digest"] == record["artifact_digest"] for d in s["dispositions"]):
                pass
            elif stop is None:
                # Artifact scope, on a sealed checkpoint: recorded, with no
                # delivery effect and no stop, whatever stop is in force.
                s["dispositions"].append(record)
                tx.write()
            elif identity_stopped or stop in s["stops"]:
                # Step 6: an epoch or identity disposition whose stop is in
                # force has no new effect. An identity stop covers every epoch.
                return "reject", "superseded", before, None
            else:
                s["dispositions"].append(record)
                tx.write()
                s["stops"].append(stop)
                tx.write()
        else:
            raise AssertionError(kind)
        after = tx.commit()
    except StoreFault:
        return "undecided", None, dict(copy.deepcopy(before), application_storage_fault=True), None
    after["application_storage_fault"] = False
    return "accept", None, after, applied


# --- cases -----------------------------------------------------------------------------

NOW = T0 + 9000
CUSTODY_AT = T0 + 900
RECEIPT_AT = T0 + 1000
CONFIRMED_AT = T0 + 2000
ACTOR = "commissioning@site"


def held_one_custody(generation: str = "active", recorded: int | None = T0 + 950, **extra) -> dict:
    return held(custody=[held_custody(1, CUSTODY_AT, generation, recorded)], **extra)


CASES: list[tuple[str, str, str, dict, dict, str | None]] = [
    # custody
    ("custody_first_acceptance", "custody_acknowledgement",
     "Nothing is held for local_seq 1. Not a restatement: custody is recorded with this acknowledgement's time and generation, and the receiver's record time.",
     held(), custody(1, CUSTODY_AT, "active"), None),
    ("custody_identical_repeat", "custody_acknowledgement",
     "Byte-identical to the acknowledgement whose custody is held. Agrees: accepted, and the custody record is unchanged.",
     held_one_custody(), custody(1, CUSTODY_AT, "active"), None),
    ("custody_same_time_previous_generation", "custody_acknowledgement",
     "Custody was first recorded under the active generation; this names the same custody_at_ms under the verify_only generation. Agrees: the generation is not part of agreement, and the held key_id stays the first.",
     held_one_custody(), custody(1, CUSTODY_AT, "previous"), None),
    ("custody_same_time_active_generation", "custody_acknowledgement",
     "Custody was first recorded under the verify_only generation; this names the same custody_at_ms under the active one. Agrees, and the held key_id stays the verify_only generation's.",
     held_one_custody("previous"), custody(1, CUSTODY_AT, "active"), None),
    ("custody_different_time_active_generation", "custody_acknowledgement",
     "Names a custody_at_ms other than the held one, under the active generation. Conflicts: refused restatement_conflict, and nothing is written.",
     held_one_custody(), custody(1, CUSTODY_AT + 100, "active"), None),
    ("custody_different_time_previous_generation", "custody_acknowledgement",
