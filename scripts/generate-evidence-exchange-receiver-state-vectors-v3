AUTHENTICATOR = {"custody_acknowledgement": "mac"}
DOMAIN = {
    "custody_acknowledgement": CUSTODY_DOMAIN,
    "delivery_receipt": RECEIPT_DOMAIN,
    "epoch_confirmation": EPOCH_DOMAIN,
    "evidence_disposition": DISPOSITION_DOMAIN,
}


def build() -> str:
    cases = []
    for name, kind, note, before, artifact, fault in CASES:
        expected, reason, after, applied = decide(kind, before, artifact, NOW, fault)
        cases.append({
            "name": name,
            "artifact_type": kind,
            "note": note,
            "receiver_now_ms": NOW,
            "held_before": before,
            "artifact": artifact,
            "canonical_hex": preimage(DOMAIN[kind], artifact,
                                      AUTHENTICATOR.get(kind, "signature")).hex(),
            "authenticator": "valid",
            "store_fault": fault,
            "expected": expected,
            "reject_reason": reason,
            "applied_sequences": applied,
            "held_after": after,
        })
    names = [c["name"] for c in cases]
    assert len(set(names)) == len(names)
    # A refusal changes nothing, and a store fault changes nothing but the signal.
    for c in cases:
        if c["expected"] == "reject" and c["store_fault"] is None:
            assert c["held_after"] == c["held_before"], c["name"]
        if c["store_fault"] == "at_refusal_record":
            assert c["held_after"] == dict(c["held_before"], application_storage_fault=True), \
                c["name"]
        if c["expected"] == "undecided":
            assert c["held_after"] == dict(c["held_before"], application_storage_fault=True), \
                c["name"]
    corpus = {
        "vector_set": "evidence-exchange/v3 restated records",
        "contract": "evidence-exchange/v3",
        "artifact": "restated_records_state",
        "canonicalisation": "json.dumps(obj, sort_keys=True, separators=(',',':'), ensure_ascii=False).encode('utf-8')",
        "domain_note": "Authenticated bytes are the ASCII domain, one NUL byte, then the canonical payload with signature or mac removed; canonical_hex is that preimage.",
        "domains": DOMAIN,
        "warning": "Every secret and seed here is a published test value from the evidence-exchange/v2 corpora and must never sign anything real.",
        "why_this_file_exists": "Whether a verified artifact is applied, accepted with no change, refused restatement_conflict, or left undecided by a store fault depends on the records the receiver already holds, which no wire artifact can express. Each case states every held record before, the artifact, any injected store fault, the answer, and every held record after.",
        "device": {"device_id": DEVICE_ID, "pubkey_hex": DEVICE_PUBKEY,
                   "sealing_epoch": EPOCH_CURRENT},
        "sealed_envelopes": SEALED_ENVELOPES,
        "sealed_registrations": SEALED_REGISTRATIONS,
        "sealed_artifacts": SEALED_ARTIFACTS,
        "sealed_note": "Receiver state shared by every case. chain_row_digest and envelope_digest are SHA-256 of the UTF-8 labels 'ori-specs evidence-exchange/v3 restated records chain row N' and '... envelope N', and each sealed checkpoint digest of '... checkpoint N'; they stand for the bytes the receiver sealed. A receipt's range_digest is taken over these chain_row_digest values.",
        "custody_registry": {
            "active": {"key_id": CUSTODY_ACTIVE, "secret_hex": ACTIVE_SECRET.hex()},
            "verify_only": {"key_id": CUSTODY_PREVIOUS, "secret_hex": PREVIOUS_SECRET.hex()},
        },
        "authority_key_registry": {
            "schema": "ori.evidence_authority_keys.v1",
            "keys": [{"key_id": KEY_ID[n], "public_key_hex": public_hex(SEEDS[n]),
                      "purpose": PURPOSE[n][0], "status": PURPOSE[n][1]} for n in SEEDS],
        },
        "authority_seeds": {KEY_ID[n]: SEEDS[n] for n in SEEDS},
        "material_note": "The custody secrets are custody-acknowledgement.json's gateway_secret_hex and previous_gateway_secret_hex. The active receipt and epoch keys are delivery-receipt-v2.json's; the verify_only receipt and epoch keys are authority-key-registry-v2.json's test keys 0 and 3; the disposition key is evidence-disposition-v2.json's. The earlier epoch and its key are delivery-envelope.json's superseded_epoch case and previous_generation_seed_hex.",
        "state_note": "held_before and held_after carry exactly the members custody, receipts, epoch_confirmations, active_epoch, registration_obligations, dispositions, stops and application_storage_fault, as evidence-exchange/v3 Test vectors defines them.",
        "answer_note": "expected is accept (answered as applied), reject with reject_reason, or undecided (a store fault at any point but at_refusal_record: reject_reason and applied_sequences null). store_fault is null, at_read, after_first_write, at_commit or at_refusal_record, as evidence-exchange/v3 Test vectors defines them.",
        "cases": cases,
    }
    return json.dumps(corpus, indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    args = sys.argv[1:]
    if args and args != ["--check"]:
        print(__doc__)
        return 0 if args[0] in ("-h", "--help") else 2
    text = build()
    if args == ["--check"]:
        if not OUT.exists() or OUT.read_text(encoding="utf-8") != text:
            print(f"{NAME}: {OUT.relative_to(ROOT)} is not what the generator produces",
                  file=sys.stderr)
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces from its generator")
        return 0
    OUT.write_text(text, encoding="utf-8")
    print(f"wrote {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
