def alter(value: Any) -> Any:
    if isinstance(value, bool):
        return not value
    if type(value) is int:
        return value + 1
    if isinstance(value, str):
        return value + "x"
    if value is None:
        return "x"
    if isinstance(value, list):
        return value[:-1] if value else ["x"]
    return value


def fork(corpus: dict, *indices: int) -> dict:
    """A mutant's own corpus: its containers copied, and the cases it changes copied
    in full; every other case is the original's, which no check writes."""
    out = {**corpus, "note": dict(corpus["note"]), "codes": list(corpus["codes"]),
           "cases": list(corpus["cases"])}
    for index in indices:
        out["cases"][index] = copy.deepcopy(corpus["cases"][index])
    return out


def corpus_mutants(corpus: dict, T: dict) -> list[tuple[str, dict]]:
    out: list[tuple[str, dict]] = []
    codes = corpus["codes"]
    for i, case in enumerate(corpus["cases"]):
        name, exp = case["name"], case["expected"]

        def put(label: str, new_exp: dict, i: int = i, name: str = name) -> None:
            m = fork(corpus, i)
            m["cases"][i]["expected"] = new_exp
            out.append((f"{name}: {label}", m))

        keep = {"consumes_challenge": exp["consumes_challenge"]} \
            if "consumes_challenge" in exp else {}
        if exp["ok"]:
            put("accepted -> refused", {"ok": False, "code": "invalid_arguments", **keep})
            for k, v in exp["result"].items():
                if isinstance(v, dict):
                    for k2, v2 in v.items():
                        r = copy.deepcopy(exp)
                        r["result"][k][k2] = alter(v2)
                        put(f"result {k}.{k2} altered", r)
                else:
                    r = copy.deepcopy(exp)
                    r["result"][k] = alter(v)
                    put(f"result {k} altered", r)
            r = copy.deepcopy(exp)
            r["result"]["extra"] = 1
            put("result member added", r)
        else:
            put("code changed", {**exp, "code": codes[(codes.index(exp["code"]) + 1) % len(codes)]})
            put("refused -> accepted", {"ok": True, "result": {}, **keep})
        if "consumes_challenge" in exp:
            put("consumes flipped", {**exp, "consumes_challenge": not exp["consumes_challenge"]})
            put("consumes dropped", {k: v for k, v in exp.items() if k != "consumes_challenge"})
        else:
            put("consumes added", {**exp, "consumes_challenge": False})
        if b"\n" not in case["request"].encode("utf-8") and (
                exp.get("code") not in ("payload_too_large", "invalid_arguments") or
                not case["terminated"]):
            # past the frame, whether an LF came decides the answer
            m = fork(corpus, i)
            m["cases"][i]["terminated"] = not case["terminated"]
            out.append((f"{name}: terminated flipped", m))
        if len(frame(case)[0]) in (corpus["bound_bytes"], corpus["bound_bytes"] + 1):
            m = fork(corpus, i)
            c = m["cases"][i]
            if len(frame(case)[0]) == corpus["bound_bytes"]:
                c["request"] = c["request"][:-1] + " " + c["request"][-1]
            else:
                c["request"] = c["request"][:-2] + c["request"][-1]
            c["request_bytes"] = len(c["request"].encode("utf-8"))
            out.append((f"{name}: request moved across the bound", m))
        m = fork(corpus, i)
        m["cases"][i]["request_bytes"] += 1
        out.append((f"{name}: request_bytes off by one", m))
        got = evaluate(case, T)
        for token in exp["changes"]:
            put(f"change {token} dropped", {**exp, "changes": [t for t in exp["changes"]
                                                              if t != token]})
            kind, _, arg = token.partition(":")
            if arg:
                put(f"change {token} altered", {**exp, "changes": sorted(
                    [t for t in exp["changes"] if t != token] + [f"{kind}:{alter(arg)}"])})
        for extra in ("used://///////////////////w==", "revision:99", "challenges_cleared"):
            if extra not in exp["changes"]:
                put(f"change {extra} added", {**exp, "changes": sorted(exp["changes"] + [extra])})
        if True:
            req = request_of(case)
            for label, verified in signed_objects(case, T):
                if not verified or signature_may_fail(label, got, T):
                    continue
                if exp.get("code") == SIGNATURE_ROW[(label, got["op"])][1]:
                    continue      # the object's own row answers the same code: no change shows
                sig = req[label]["signature"]
                m = fork(corpus, i)
                m["cases"][i]["request"] = case["request"].replace(
                    sig, ("B" if sig[0] != "B" else "C") + sig[1:], 1)
                out.append((f"{name}: its {label} signature broken", m))
    for code in codes:
        m = fork(corpus)
        m["cases"] = [c for c in m["cases"] if c["expected"].get("code") != code]
        out.append((f"no case answered {code}", m))
    for op in ("challenge", "recover", "local_seed", "enrol", "revoke", "binding"):
        m = fork(corpus)
        m["cases"] = [c for c in m["cases"] if not (c["expected"]["ok"] and
                                                    f'"approver_registry_{op}"' in c["request"])]
        out.append((f"no accepted {op}", m))
    m = fork(corpus)
    m["cases"].append(copy.deepcopy(m["cases"][0]))
    out.append(("duplicate case name", m))
    for where in ("top", "case", "context"):
        m = fork(corpus, 0)
        {"top": m, "case": m["cases"][0], "context": m["cases"][0]["context"]}[where]["extra"] = 1
        out.append((f"extra {where} key", m))
    for delta in (-1, 1):
        m = fork(corpus)
        m["bound_bytes"] += delta
        out.append((f"bound_bytes {delta:+}", m))
    matrix = [i for i, c in enumerate(corpus["cases"]) if c["name"].startswith("m_")]
    if matrix:
        m = fork(corpus)
        del m["cases"][matrix[0]]
        out.append(("a matrix cell removed", m))
        m = fork(corpus, matrix[0], matrix[-1])
        a, b = m["cases"][matrix[0]], m["cases"][matrix[-1]]
        a["name"], b["name"] = b["name"], a["name"]
        out.append(("two matrix cases' names swapped", m))
    m = fork(corpus)
    m["note"]["corpus"] = m["note"]["corpus"].replace("(minted, own, other)", "(minted, own)")
    out.append(("matrix sentence altered", m))
    sms_held = [i for i, c in enumerate(corpus["cases"]) if any(
        h["challenge"]["candidates"] and h["challenge"]["candidates"][0]["channel"] == "sms"
        for h in c["context"]["challenges"])]
    if sms_held:
        m = fork(corpus, sms_held[0])
        m["cases"][sms_held[0]]["context"]["authenticated_phone_channels"] = []
        out.append(("a held sms challenge with no SMS ingress", m))
    m = fork(corpus)
    m["codes"] = m["codes"][1:] + m["codes"][:1]
    out.append(("codes reordered", m))
    for key in ("signatures", "expected.changes"):
        m = fork(corpus)
        m["note"][key] = m["note"][key].rsplit(". ", 1)[0] + "."
        out.append((f"{key} note's last sentence dropped", m))
    with_failing = [i for i, c in enumerate(corpus["cases"])
                    if c["context"]["keys_failing_admission"]]
    if with_failing:
        m = fork(corpus, with_failing[0])
        m["cases"][with_failing[0]]["context"]["keys_failing_admission"] = []
        out.append(("a failing key unlisted", m))
    m = fork(corpus, 0)
    m["cases"][0]["context"]["keys_failing_admission"] = [
        m["cases"][0]["context"]["anchors"]["current"]]
    out.append(("an admitted key listed as failing", m))
    return out


def _in_order(count: int, one: Callable[[int], Any]) -> list[Any]:
    """one(i) for each i below count, in order, on forked worker processes.

    Every mutant builds its own state from what it was given and writes
    nothing another mutant reads, so the workers share nothing a mutant
    changes, and the results come back in the order the mutants were listed.
    ORI_MUTATION_JOBS=1 runs every mutant in this process instead, which is
    how a parallel run is shown to report exactly what a serial one does.
    """
    jobs = int(os.environ.get("ORI_MUTATION_JOBS") or os.cpu_count() or 1)
    if jobs <= 1 or count < 2:
        return [one(i) for i in range(count)]
    global _ONE
    _ONE = one
    with multiprocessing.get_context("fork").Pool(min(jobs, count)) as pool:
        return pool.map(_call_one, range(count), chunksize=max(1, count // (jobs * 8)))


_ONE: Callable[[int], Any] | None = None


def _call_one(i: int) -> Any:
    assert _ONE is not None
    return _ONE(i)


def move_row_after(text: str, table: str, code: str, after: str) -> str:
    """The text with `code`'s row of `table` moved to just after `after`'s row."""
    lines = text.split("\n")
    start = lines.index(f"### {table}")
    end = next(i for i in range(start + 1, len(lines)) if lines[i].startswith("#"))
    at = {re.match(r"\| `([a-z_]+)`", lines[i]).group(1): i for i in range(start, end)
          if re.fullmatch(r"\| `[a-z_]+` \| .+ \|", lines[i])}
    need(code in at and after in at, f"mutation setup: {table} has no {code} or {after} row")
    row = lines.pop(at[code])
    lines.insert(at[after] - (1 if at[after] > at[code] else 0) + 1, row)
    return "\n".join(lines)


def refusal(expected: str, *given: str | None) -> Callable[[str], bool]:
    """A failure that is a case expected `expected` and answered one of `given` (None:
    accepted; no `given`: any other answer)."""
    def shown(code: str | None) -> str:
        return '{"ok": true' if code is None else f'{{"ok": false, "code": "{code}"}}'
    head = f'expected {{"ok": false, "code": "{expected}"}}, the text gives '
    return lambda message: head in message and (
        not given or any(head + shown(code) in message for code in given))


def answered(given: str) -> Callable[[str], bool]:
    """A failure that is a case the text answers otherwise answered `given`."""
    return lambda message: f'the text gives {{"ok": false, "code": "{given}"}}' in message


DB = "device_binding_mismatch"
# The device binding's mutants, each with the failure it must be refused by: a case
# the text answers device_binding_mismatch answered otherwise, or a case the text
# answers otherwise answered device_binding_mismatch, or the recovery state law.
DEVICE_DEFECTS: tuple[tuple[str, Callable[[str], bool]], ...] = (
    ("device_unchecked", refusal(DB)),
    ("device_unchecked:Challenge", refusal(DB)),
    ("device_unchecked:Challenges presented", refusal(DB)),
    # revoke comparing the document's device_id with the runtime's instead of refusing
    # first: the document names the registry's device, or the runtime's and the
    # revocation proceeds
    ("device_unchecked:Revoke", refusal(DB, "binding_mismatch", "site_binding_mismatch",
                                        "revision_conflict", "revision_regressed", None)),
    ("device_unchecked:Binding", refusal(DB, None, "site_binding_mismatch")),
    # the binding readback answering the runtime's device instead of refusing
    ("binding_device_from_runtime", refusal(DB, None, "site_binding_mismatch")),
    # a locked registry treated as bound to another device
    ("device_when_locked", answered(DB)),
    ("recover_device_unbound", lambda m: "under the runtime's device identity" in m),
    # a revocation document's device_id held to the site's 64 characters, not 128
    ("document_device_id_64", answered("malformed")),
)
# The device row of a table moved to just after another row: a case the text
# answers device_binding_mismatch must then be answered by a row it overtook.
DEVICE_MOVES = (
    ("Challenge", "site_binding_mismatch"),
    ("Challenge", "recovery_not_available"),
    ("Challenge", "channel_unauthenticated"),
    ("Challenge", "active_authorizer_exists"),
    ("Challenges presented", "site_binding_mismatch"),
    ("Challenges presented", "challenge_reused"),
    ("Revoke", "site_binding_mismatch"),
    ("Revoke", "binding_mismatch"),
    ("Revoke", "revision_conflict"),
    ("Binding", "site_binding_mismatch"),
)
# registry_unavailable moved after the device row where it now precedes it: the rows
# can never fail together, since a locked registry has neither binding, so no case can
# show the move and it must change no answer.
DEVICE_MOVES_INHERENT = (("Revoke", "registry_unavailable"), ("Binding", "registry_unavailable"))


def overtaken(text: str, name: str, after: str) -> tuple[str, ...]:
    """The codes the device row passes when moved to just after `after`."""
    codes = [code for code, _ in table(subsections(text)[name], "| `error.code` | Refused when |",
                                       name)]
    return tuple(codes[codes.index(DB) + 1:codes.index(after) + 1])


def device_mutants(text: str, approvers: str, corpus: dict) -> list[tuple[str, Callable[[], str]]]:
    out: list[tuple[str, Callable[[], str]]] = []

    def judged(t: str, d: frozenset, reason: Callable[[str], bool]) -> Callable[[], str]:
        def run() -> str:
            try:
                check(t, approvers, corpus, d, announce=False)
            except Failure as exc:
                return "refused" if reason(str(exc)) else \
                    f"error: refused for another reason: {exc}"
            return "accepted"
        return run

    for defect, reason in DEVICE_DEFECTS:
        out.append((f"device defect: {defect}", judged(text, frozenset({defect}), reason)))
    for table_name, after in DEVICE_MOVES:
        out.append((f"device row after {after} in {table_name}",
                    judged(move_row_after(text, table_name, DB, after), frozenset(),
                           refusal(DB, *overtaken(text, table_name, after)))))

    def inherent(t: str, label: str) -> Callable[[], str]:
        def run() -> str:
            try:
                check(t, approvers, corpus, announce=False)
            except Failure as exc:
                return f"error: '{label}' should change no answer but does: {exc}"
            return "inherent"
        return run
    for table_name, row in DEVICE_MOVES_INHERENT:
        label = f"{row} after the device row in {table_name}"
        out.append((label, inherent(move_row_after(text, table_name, row, DB), label)))
    # A registry held with a malformed device_id: a corrupt header, so locked, never held.
    held = next(i for i, c in enumerate(corpus["cases"]) if c["context"]["registry"])

    def corpus_judged(c: dict, reason: Callable[[str], bool]) -> Callable[[], str]:
        return lambda: _judge(text, approvers, c, reason)
    for key, bad in (("device_id", ""), ("device_id", "edge 1"), ("device_id", "x" * 129),
                     ("device_id", None), ("site_id", "x" * 65), ("site_id", "site 1"),
                     ("identity_epoch", "AA==")):
        m = fork(corpus, held)
        m["cases"][held]["context"]["registry"][key] = bad
        out.append((f"registry {key} {bad!r:.10} held as initialized",
                    corpus_judged(m, lambda msg: "corrupt, so locked" in msg)))
    m = fork(corpus, held)
    del m["cases"][held]["context"]["registry"]["device_id"]
    out.append(("device_id absent from a held registry",
                corpus_judged(m, lambda msg: "registry keys" in msg)))
    return out


def _judge(text: str, approvers: str, corpus: dict, reason: Callable[[str], bool]) -> str:
    try:
        check(text, approvers, corpus, announce=False)
    except Failure as exc:
        return "refused" if reason(str(exc)) else f"error: refused for another reason: {exc}"
    return "accepted"


def mutations(text: str, approvers: str, corpus: dict) -> None:
    """Every mutant, listed first, then run on the fork pool. Each returns
    "refused", "accepted", "inherent" (a reordering that changes no answer) or
    "error: …"; the tally is taken in listing order, so it does not depend on
    how the mutants were scheduled."""
    T = read_text(text, approvers)
    keyed = {k for name in TABLED for k in keyed_rows(T["tables"][name], name)}
    need(keyed == set(NEEDS), f"NEEDS and the refusal tables differ: {keyed ^ set(NEEDS)}")
    outcomes = [(case, evaluate(case, T)) for case in corpus["cases"]]
    jobs: list[tuple[str, str, Callable[[], str]]] = []    # (family, label, run)

    def check_mutant(t: str, c: dict, d: frozenset = frozenset()) -> Callable[[], str]:
        def run() -> str:
            try:
                check(t, approvers, c, d, announce=False)
            except Failure:
                return "refused"
            except (KeyError, TypeError, ValueError, IndexError, AttributeError) as exc:
                return f"error: the checker itself broke: {exc!r}"
            return "accepted"
        return run

    for label, mutant in text_mutants(text):
        m = re.fullmatch(r"swap rows (.+): ([a-z_]+)@(\d+) / ([a-z_]+)@(\d+)", label)
        if m:
            name, x, y = m.group(1), int(m.group(3)), int(m.group(5))
            keys = keyed_rows(T["tables"][name], name)
            why = [exclusive(NEEDS[keys[y]], NEEDS[keys[r]]) for r in range(x, y)]
            if keys[y] in DEAD and keys.index(DEAD[keys[y]][0]) < x:
                why = [DEAD[keys[y]][1]]
            if all(why):
                # The moved row never fails with any row it overtakes: the
                # reordering is the same rule, and a case telling it apart
                # would mean NEEDS is wrong.
                def inherent(mutant: str = mutant, label: str = label, why: list = why) -> str:
                    try:
                        check(mutant, approvers, corpus, announce=False)
                    except Failure as exc:
                        if ": expected " in str(exc) or "consumes_challenge" in str(exc):
                            return (f"error: '{label}' should change no answer ({why}) but "
                                    f"does: {exc}")
                        return "refused"      # by the text's own consistency
                    return "inherent"
                jobs.append(("text", label, inherent))
                continue
            co = [keys[r][1] + (f"#{keys[r][2] + 1}" if keys[r][2] else "")
                  for r in range(x, y) if not why[r - x]]
            label += f" (needs a case where it fails with {', '.join(co)} and that decides)"
        jobs.append(("text", f"text: {label}", check_mutant(mutant, corpus)))
    for label, mutant in corpus_mutants(corpus, T):
        jobs.append(("corpus", f"corpus: {label}", check_mutant(text, mutant)))
    for defect in DEFECTS:
        jobs.append(("defect", f"model defect: {defect}",
                     check_mutant(text, corpus, frozenset({defect}))))

    # The reachability model itself, mutated: each required or used cell removed,
    # each axis removed, a spurious well-formed cell added, each FORCES and IMPLIED
    # entry removed and a spurious one of each added. The corpus law and the sweep
    # comparison must notice each.
    joint = reachable_joint(T)
    rows = by_row(outcomes)
    base_rows = {row: row_law(row, a, rows.get(row, [])) for row, a in joint.items()}
    base_sweep = sweep_compare(T, joint)
    base = frozenset(reach_law(joint, outcomes) + base_sweep)

    def row_mutant(row: tuple, assignments: list[dict]) -> Callable[[], str]:
        def run() -> str:
            if row_law(row, assignments, rows.get(row, [])) != base_rows[row]:
                return "refused"
            same = sweep_compare(T, {**joint, row: assignments}) == base_sweep
            return "accepted" if same else "refused"
        return run

    def joint_mutant(forces: dict | None = None, implied: dict | None = None
                     ) -> Callable[[], str]:
        def run() -> str:
            j = reachable_joint(T, forces=forces, implied=implied)
            changed = frozenset(reach_law(j, outcomes) + sweep_compare(T, j)) != base
            return "refused" if changed else "accepted"
        return run

    for row, assignments in joint.items():
        need_cells = {frozenset(c.items()) for c in required(assignments)}
        used = {frozenset(g["axes"].items()) for _, g in rows.get(row, [])}
        for n, a in enumerate(assignments):
            cell = frozenset(defined(a).items())
            if cell not in need_cells and cell not in used:
                continue      # neither required nor any case's: no law reads it
            label = ", ".join(f"{k}={v}" for k, v in sorted(defined(a).items())) or "no axis"
            jobs.append(("reach", f"reachability: {row_name(row)} cell {label} removed",
                         row_mutant(row, assignments[:n] + assignments[n + 1:])))
        for axis in sorted({k for a in assignments for k, v in a.items()
                            if v is not None and not k.startswith("_")}):
            jobs.append(("reach", f"reachability: {row_name(row)} axis {axis} removed",
                         row_mutant(row, [{k: v for k, v in a.items() if k != axis}
                                          for a in assignments])))
        table = row[0]
        if table != "step":
            for axis, domain in table_axes(table, T).items():
                spurious = None
                for a in maximal(assignments):
                    full = {k: a.get(k) for k in table_axes(table, T)}
                    for value in domain:
                        b = {**full, axis: value}
                        if value != a.get(axis) and assignment_ok(table, b) and \
                                all(v is not None for v in b.values()) and \
                                defined(b) not in [defined(x) for x in assignments]:
                            spurious = b
                            break
                    if spurious:
                        break
                if spurious:
                    jobs.append(("reach", f"reachability: {row_name(row)} spurious cell "
                                 f"{defined(spurious)}", row_mutant(row, assignments + [spurious])))
    for key in FORCES:
        jobs.append(("reach", f"reachability: FORCES {row_name(key)} removed",
                     joint_mutant(forces={k: v for k, v in FORCES.items() if k != key})))
    for key in IMPLIED:
        jobs.append(("reach", f"reachability: IMPLIED {row_name(key)} removed",
                     joint_mutant(implied={k: v for k, v in IMPLIED.items() if k != key})))
    jobs.append(("reach", "reachability: spurious FORCES (Enrol challenge_stale for an own "
                 "approver)", joint_mutant(forces={**FORCES, (E, "challenge_stale", 0):
                                                   lambda a: a.get("approver") == "own"})))
    jobs.append(("reach", "reachability: spurious IMPLIED (Challenge value_tombstoned for sms)",
                 joint_mutant(implied={**IMPLIED, (C, "value_tombstoned", 0): (
                     ((C, "site_binding_mismatch", 0), lambda a: a.get("cand") == "sms"),)})))

    # `<row>_<axis>=<value>_only`: each row made to fire for one value of one axis;
    # every case that row decides with another value must then be answered otherwise.
    decided_at: dict[tuple, list[dict]] = {}
    for case, g in outcomes:
        decided_at.setdefault(g["decided"], []).append(case)

    def cases_mutant(cases: list[dict], **kwargs: Any) -> Callable[[], str]:
        def run() -> str:
            for case in cases:
                try:
                    check_case(case, T, **kwargs)
                except Failure:
                    return "refused"
                except (TypeError, KeyError, AttributeError, IndexError):
                    if "inject" in kwargs:
                        raise
                    # Past the suppressed row the model meets a state that row
                    # guarantees against (a locked registry, no challenge): it has
                    # no answer for the case, so the case's answer changes.
                    return "refused"
            return "accepted"
        return run

    for row, axes in reachable(T).items():
        if row[1] == "accept":
            continue
        for axis, values in axes.items():
            if len(values) < 2:
                continue
            for value in sorted(values):
                jobs.append(("only", f"model defect: {row_name(row)}_{axis}={value}_only",
                             cases_mutant(decided_at.get(row, []),
                                          defects=frozenset({("only", row, axis, value)}))))

    # Forbidden writes: each injected at each place an outcome is decided that the
    # text lets write nothing (every refusal, the binding readback, a replay), and
    # each case decided there must then break its state law.
    decided: dict[tuple, list[dict]] = {}
    for case, got in outcomes:
        key = row_key(got, T)
        if not got["ok"] or key[1] == "approver_registry_binding" or key[2] == "replayed":
            decided.setdefault(key, []).append(case)
    places = [("step", s) for s in T["steps"] if s != "own"] + \
        [k for name in TABLED for k in keyed_rows(T["tables"][name], name)] + \
        [("ok", "approver_registry_binding", None), ("ok", "approver_registry_revoke", "replayed")]
    for place in DEAD:
        need(place not in decided, f"{place} is listed as DEAD but decides a case")
    for place in [place for place in places if place not in DEAD]:
        where = place[1] if place[0] in ("step", "ok") else f"{place[0]} {place[1]}"
        cases = decided.get(place, [])
        for field in INJECT:
            jobs.append(("write", f"forbidden write: {field} at {where}" +
                         ("" if cases else " (no case is decided there)"),
                         cases_mutant(cases, inject=(field, place))))

    for label, run in device_mutants(text, approvers, corpus):
        jobs.append(("device", label, run))

    results = _in_order(len(jobs), lambda i: jobs[i][2]())
    errors = [f"{jobs[i][1]}: {r[7:]}" for i, r in enumerate(results) if r.startswith("error:")]
    need(not errors, "; ".join(errors))
    refused = results.count("refused")
    inherent = results.count("inherent")
    writes = sum(1 for family, _, _ in jobs if family == "write")
    survivors = [label for (_, label, _), r in zip(jobs, results) if r == "accepted"]
    if survivors:
        print(f"operator-socket/v3 approver registry: {refused} mutations refused, "
              f"{len(survivors)} accepted:", file=sys.stderr)
        for label in survivors:
            print(f"  accepted: {label}", file=sys.stderr)
        raise SystemExit(1)
    device = sum(1 for (family, _, _), r in zip(jobs, results)
                 if family == "device" and r == "refused")
    print(f"operator-socket/v3 approver registry: {refused} mutations refused, {writes} of them "
          f"forbidden writes and {device} device-binding mutants refused for their own reason "
          f"({inherent} reorderings of rows that never fail together change no answer)")


def explain(text: str, approvers: str, corpus: dict) -> None:
    T = read_text(text, approvers)
    for case in corpus["cases"]:
        exp = case["expected"]
        print(f"{case['name']}: expected {exp.get('code', 'ok')}; failing: "
              f"{all_failures(case, T)}")


def _strict_pairs(pairs: list) -> dict:
    out = dict(pairs)
    if len(out) != len(pairs):
        raise Failure("the corpus file names a member twice")
    return out


def main(argv: list[str]) -> int:
    corpus_path = CORPUS
    if "--corpus" in argv:
        corpus_path = pathlib.Path(argv[argv.index("--corpus") + 1])
    text = CONTRACT.read_text(encoding="utf-8")
    approvers = APPROVERS.read_text(encoding="utf-8")
    try:
        corpus = json.loads(corpus_path.read_text(encoding="utf-8"),
                            object_pairs_hook=_strict_pairs)
        if "--explain" in argv:
            explain(text, approvers, corpus)
            return 0
        if not (ROOT / GENERATOR).is_file():
            raise Failure(f"{GENERATOR} is missing")
        check(text, approvers, corpus)
        if "--mutations" in argv:
            mutations(text, approvers, corpus)
    except (Failure, KeyError, TypeError, ValueError) as exc:
        print(f"operator-socket/v3 approver registry vectors failed: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
