    "signatures_before_row_only", "depth_unbounded", "depth_off_by_one", "surrogate_accepted",
    "doc_dup_invalid_arguments", "document_dups_unchecked", "document_ids_any_string",
    "phone_authorization_digest_unchecked", "approver_check_skipped", "phone_text_last",
    "phone_text_any_eligible", "phone_text_first_matching", "sms_ingress_ignored", "noninteger_as_string",
    "int_digit_limit", "shadowed_unvalidated",
    "possession_window_extends_phone", "expiry_inclusive", "fraction_accepted",
