# Rows whose condition implies an earlier row of the same table fails too, so
# they can decide nothing: the earlier row always answers first. Each names
# that row. No case is decided at one, and moving one ahead of rows after the
# row it implies changes no answer.
DEAD: dict[tuple[str, str, int], tuple[tuple[str, str, int], str]] = {}


def exclusive(a: dict[str, str], b: dict[str, str]) -> str | None:
    """Why two rows can never fail together, or None."""
    for key in set(a) & set(b):
        if not set(a[key].split("|")) & set(b[key].split("|")):
            return f"{key} {a[key]} / {b[key]}"
    return None


def keyed_rows(rows: list[tuple[str, str]], name: str) -> list[tuple[str, str, int]]:
    seen: dict[str, int] = {}
    out = []
    for code, _ in rows:
        out.append((name, code, seen.get(code, 0)))
        seen[code] = seen.get(code, 0) + 1
    return out


# ----- coverage axes: for every row, the axis values on which the text makes it reachable

OP_NAME = {"approver_registry_challenge": "challenge", "approver_registry_recover": "recover",
           "approver_registry_local_seed": "local_seed", "approver_registry_enrol": "enrol",
           "approver_registry_revoke": "revoke", "approver_registry_binding": "binding",
           "reconcile_tier_c": "reconcile_tier_c", "evidence_commission": "evidence_commission"}
KIND = {"lan_ed25519": "lan", "sms": "sms", "whatsapp": "whatsapp"}


def table_axes(table: str, text: dict) -> dict[str, tuple[str, ...]]:
    """The axes a table's rows are judged over, and their domains.

    - Challenge: the challenge_operation; the candidate kind; for an enrolment, the
      request's approver (null, or named).
    - Challenges presented: the operation; the challenge held under the presented ID
      (none; for recover, its own recover challenge; for local_seed, its lan
      challenge; for enrol, its lan or sms challenge; or a foreign one, created for
      another operation); and, for local_seed and enrol, the kind of candidate the
      request presents, which its form lets be any channel.
    - Local seed and Enrol: the challenge's candidate kind; Enrol also the
      authoriser path and the candidate approver (minted, own, other), which the
      state defines wherever the registry is held."""
    three = ("lan", "sms", "whatsapp")
    return {
        C: {"op": ("recover", "local_seed", "enrol"), "cand": three, "approver": ("null", "named")},
        CP: {"op": ("recover", "local_seed", "enrol"),
             "kind": ("none", "recover", "lan", "sms", "foreign"), "pres": three},
        R_: {}, LS: {"cand": three},
        E: {"path": ("lan", "phone"), "cand": three, "approver": ("minted", "own", "other")},
        RV: {}, B: {},
    }.get(table, {})


def step_ops(step: str, text: dict) -> tuple[str, ...]:
    """The operations a step is judged over: the bound and the form every request on
    the socket; the caller, serialisation and the site the registry operations."""
    ops = text["ops"] if step in ("bound", "form") else text["registry_ops"]
    return tuple(OP_NAME[o] for o in ops)


def assignment_ok(table: str, a: dict) -> bool:
    """What a table can see at all."""
    if table == C:
        return (a["op"] == "recover") == (a["cand"] is None) and \
            (a["op"] == "enrol") == (a["approver"] is not None)
    if table == CP:
        own = {"recover": ("recover",), "local_seed": ("lan",), "enrol": ("lan", "sms")}[a["op"]]
        return a["kind"] in own + ("none", "foreign") and \
            (a["pres"] is None) == (a["op"] == "recover")
    if table == LS:
        return a["cand"] == "lan"
    if table == E:
        return a["cand"] in ("lan", "sms")
    return True


def with_none(table: str, axis: str) -> tuple:
    """Axes a table's assignment may leave undefined."""
    return (None,) if (table, axis) in ((C, "cand"), (C, "approver"), (CP, "pres"),
                                        (E, "approver")) else ()


# Rows that fail whenever their axis condition holds, and so answer first for
# every row after them in their table.
FORCES: dict[tuple, Callable[[dict], bool]] = {
    (C, "lan_key_required", 0): lambda a: a.get("op") == "local_seed" and a.get("cand") != "lan",
    (C, "channel_unauthenticated", 0): lambda a: a.get("op") == "enrol" and
    a.get("cand") == "whatsapp",
    (E, "authorizer_not_approver", 0): lambda a: a.get("approver") == "other",
}

# Rows whose failure, under a condition, implies an earlier row of their table
# fails too: at the challenge, a local_seed value active under a credential is an
# active credential, which active_authorizer_exists refuses first.
IMPLIED: dict[tuple, tuple[tuple[tuple, Callable[[dict], bool]], ...]] = {
    (C, "duplicate_value", 0): (((C, "active_authorizer_exists", 0),
                                 lambda a: a.get("op") == "local_seed"),),
}


def reachable(text: dict, forces: dict | None = None,
              implied: dict | None = None) -> dict[tuple, dict[str, set[str]]]:
    out: dict[tuple, dict[str, set[str]]] = {}
    for row, assignments in reachable_joint(text, forces, implied).items():
        axes: dict[str, set[str]] = {}
        for a in assignments:
            for n, v in a.items():
                if v is not None:
                    axes.setdefault(n, set()).add(v)
        out[row] = axes
    return out


def reachable_joint(text: dict, forces: dict | None = None,
                    implied: dict | None = None) -> dict[tuple, list[dict]]:
    """For every row (and every accept outcome), the values of each axis on which the
    text lets that row decide a request: what the table can see, compatible with
    what the row needs, and not forced to an earlier row's answer. The Enrol
    approver is undefined on a locked registry (no credential says whose an
    approver ID is)."""
    import itertools
    forces = FORCES if forces is None else forces
    implied = IMPLIED if implied is None else implied
    out: dict[tuple, list[dict]] = {}
    for step in text["steps"]:
        if step != "own":
            out[("step", step)] = [{"op": op} for op in step_ops(step, text)] + \
                ([{"op": None}] if step in ("bound", "form") else [])
    for table in TABLED:
        axes = table_axes(table, text)
        names = list(axes)
        domains = [axes[n] + with_none(table, n) for n in names]
        rows = keyed_rows(text["tables"][table], table) + \
            ([(table, "accept", 0)] if table != CP else [])
        for index, row in enumerate(rows):
            seen: list[dict] = []
            needs = NEEDS.get(row, {})
            for values in itertools.product(*domains):
                a = dict(zip(names, values))
                if not assignment_ok(table, a):
                    continue
                if table == E:
                    # The approver is undefined on a locked registry; where no named
                    # authoriser is active (authorizer_unavailable) it may be
                    # undefined too; elsewhere the state defines it.
                    if needs.get("reg") == "locked":
                        if a["approver"] is not None:
                            continue
                    elif a["approver"] is None and needs.get("auth") != "missing":
                        continue
                if table == CP:
                    held = needs.get("held")
                    if held == "none" and a["kind"] != "none":
                        continue
                    if held not in (None, "none") and a["kind"] == "none":
                        continue
                    if row[1] == "candidate_changed" and a["kind"] == "recover":
                        continue      # a recover challenge carries no candidate to change
                if any(k in a and a[k] is not None and a[k] not in needs[k].split("|")
                       for k in needs if k in ("op", "cand", "path", "approver")):
                    continue
                if any(forces[f](a) for f in rows[:index] if f in forces):
                    continue
                if row == (C, "channel_unauthenticated", 0) and a["cand"] == "sms":
                    # only while the runtime has no authenticated SMS ingress
                    a = {**a, "_ingress": "none"}
                if any(cond(a) for earlier, cond in implied.get(row, ()) if
                       earlier in rows[:index]):
                    continue
                seen.append(a)
            out[row] = seen
    return out


def enrol_approver(st: State) -> str | None:
    """Whose the candidate approver is, as the state says: minted when no active
    credential carries the ID; own or other against the authoriser the request
    names (an authorization's credential, or the sender of this challenge's
    ORI-ENROL-V1 text) when that credential is active; undefined otherwise."""
    if st.reg is None:
        return None
    aid = st.candidate()["approver_id"]
    if not approver_active(st, aid):
        return "minted"
    auth = st.req["authorization"]
    if auth is not None:
        named = [auth["authorizer_credential_id"]]
    else:
        text = recorded_text(st)
        named = [text["authorizer_credential_id"]] if text else []
    for cid in named:
        cred = st.cred(cid)
        if cred is not None:
            return "own" if cred["approver_id"] == aid else "other"
    return None


def axes_at(st: State, row: tuple) -> dict[str, str | None]:
    """The axis values of a request at the row deciding it."""
    table = row[0]
    if table == "step":
        op = st.op
        if op is None:
            req = request_of(st.case)
            op = req.get("operation") if isinstance(req, dict) else None
        return {"op": OP_NAME[op]} if op in OP_NAME else {}
    out: dict[str, str | None] = {}
    if table == C:
        out["op"] = st.req["challenge_operation"]
        cand = st.req["candidate"]
        out["cand"] = KIND[cand["channel"]] if cand else None
        if out["op"] == "enrol":
            out["approver"] = "null" if cand["approver_id"] is None else "named"
    elif table == CP:
        out["op"] = OP_NAME[st.op]
        if st.ch is None:
            out["kind"] = "none"
        elif st.challenge()["operation"] != out["op"]:
            out["kind"] = "foreign"
        elif st.challenge()["candidates"]:
            out["kind"] = KIND[st.challenge()["candidates"][0]["channel"]]
        else:
            out["kind"] = "recover"
        cand = st.req.get("candidate")
        out["pres"] = KIND[cand["channel"]] if isinstance(cand, dict) else None
    elif table in (LS, E) and st.ch is not None and st.ch["challenge"]["candidates"]:
        out["cand"] = KIND[st.candidate()["channel"]]
        if table == E:
            out["path"] = "phone" if st.req["authorization"] is None else "lan"
            out["approver"] = enrol_approver(st)
    return {k: v for k, v in out.items() if v is not None}


# ----- what a success writes (the effects) and returns

def fresh_sequence(reg: dict) -> int:
    return reg["credential_sequence"] + 1


def e_challenge(st: State) -> dict:
    minted, op, cand = st.ctx["minted"], st.req["challenge_operation"], st.req["candidate"]
    if minted is None:
        raise Failure("a challenge is created but context.minted is null")
    if op == "recover":
        epoch, revision, site, candidates = minted["identity_epoch"], 0, \
            st.ctx["verified_site_id"], []
    else:
        epoch, revision, site = st.reg["identity_epoch"], st.reg["registry_revision"], \
            st.reg["site_id"]
        aid = minted["approver_id"]
        if op == "enrol" and isinstance(cand.get("approver_id"), str) and \
                "existing_approver_minted" not in st.D:
            aid = cand["approver_id"]
        candidates = [{"approver_id": aid, "credential_id": minted["credential_id"],
                       "channel": cand["channel"], "value": cand["value"]}]
    challenge = {"v": 1, "challenge_id": minted["challenge_id"],
                 "device_id": st.ctx["device_id"], "site_id": site,
                 "identity_epoch": epoch, "operation": op,
                 "registry_revision": revision, "candidates": candidates}
    st.world["challenges"].append({
        "challenge": copy.deepcopy(challenge), "state": "pending",
        "credential_sequence_at_issue": st.reg["credential_sequence"] if st.reg else 0})
    if candidates and candidates[0]["channel"] in PHONE:
        st.world["codes_sent"].append(challenge["challenge_id"])
    return {"challenge": challenge}


def e_recover(st: State) -> dict:
    ch = st.challenge()
    device = None if "recover_device_unbound" in st.D else st.ctx["device_id"]
    st.world["registry"] = {
        "device_id": device,
        "site_id": st.ctx["verified_site_id"], "identity_epoch": ch["identity_epoch"],
        "registry_revision": 1, "last_external_revision": 0,
        "last_external_document_sha256": None, "credential_sequence": 0, "credentials": [],
        "tombstoned_credentials": [], "tombstoned_approvers": [], "tombstoned_values": []}
    mark_used(st.world, ch["challenge_id"])
    st.world["challenges"] = []
    st.world["phone_authorizations"] = []
    st.world["pending_phone_values"] = []
    return {"status": "recovered", "registry_revision": 1}


def add_credential(st: State) -> int:
    reg = st.world["registry"]
    cand = st.candidate()
    reg["credentials"].append({**copy.deepcopy(cand), "sequence": fresh_sequence(reg)})
    reg["credential_sequence"] = fresh_sequence(reg)
    reg["registry_revision"] += 1
    mark_used(st.world, st.challenge()["challenge_id"])
    return reg["registry_revision"]


def e_local_seed(st: State) -> dict:
    return {"status": "seeded", "registry_revision": add_credential(st)}


def e_enrol(st: State) -> dict:
    if lan_candidate(st):
        return {"status": "enrolled", "registry_revision": add_credential(st)}
    st.world["pending_phone_values"].append(st.candidate()["value"])
    mark_used(st.world, st.challenge()["challenge_id"])
    if "phone_pending_bumps_revision" in st.D:
        st.world["registry"]["registry_revision"] += 1
    return {"status": "phone_pending", "registry_revision": st.world["registry"]["registry_revision"]}


def e_revoke(st: State) -> dict:
    d, reg = st.req["document"], st.world["registry"]
    if d["revision"] == reg["last_external_revision"]:
        return {"status": "replayed", "registry_revision": reg["registry_revision"],
                "last_external_revision": reg["last_external_revision"]}
    for target in d["targets"]:
        kind, _, ident = target.partition(":")
        gone = [c for c in reg["credentials"]
                if (c["credential_id"] if kind == "credential" else c["approver_id"]) == ident]
        for c in gone:
            reg["credentials"].remove(c)
            reg["tombstoned_credentials"].append({"credential_id": c["credential_id"],
                                                  "approver_id": c["approver_id"]})
            if c["value"] not in reg["tombstoned_values"]:
                reg["tombstoned_values"].append(c["value"])
        if kind == "approver" and ident not in reg["tombstoned_approvers"]:
            reg["tombstoned_approvers"].append(ident)
    reg["registry_revision"] += 1
    reg["last_external_revision"] = d["revision"]
    reg["last_external_document_sha256"] = hashlib.sha256(profile2(d)).hexdigest()
    return {"status": "revoked", "registry_revision": reg["registry_revision"],
            "last_external_revision": d["revision"]}


def e_binding(st: State) -> dict:
    # "the registry's current `device_id`, `site_id`, `identity_epoch` and
    # `registry_revision`": the registry's own device binding, which equals the
    # runtime's identity only because device_binding_mismatch refused otherwise.
    device = st.ctx["device_id"] if "binding_device_from_runtime" in st.D else \
        st.reg["device_id"]
    return {"device_id": device, "site_id": st.reg["site_id"],
            "identity_epoch": st.reg["identity_epoch"],
            "registry_revision": st.reg["registry_revision"]}


EFFECT = {"approver_registry_challenge": e_challenge, "approver_registry_recover": e_recover,
          "approver_registry_local_seed": e_local_seed, "approver_registry_enrol": e_enrol,
          "approver_registry_revoke": e_revoke, "approver_registry_binding": e_binding}


# ----- the state laws: what an outcome may have written, judged apart from the
# effects above

def canon(value: Any) -> bytes:
    return profile2(value)


def state_law(case: dict, out: dict) -> None:
    pre, post, name = out["pre"], out["post"], case["name"]

    def law(cond: bool, what: str) -> None:
        if not cond:
            raise Failure(f"{name}: the state after it breaks the text: {what}")

    def rest_equal(*parts: str) -> None:
        for part in pre:
            if part not in parts and part != "used_now":
                law(canon(pre[part]) == canon(post[part]), f"{part} changed")

    def challenges_with_used(cid: str | None) -> list:
        want = copy.deepcopy(pre["challenges"])
        for held in want:
            if held["challenge"]["challenge_id"] == cid:
                held["state"] = "used"
        return want

    if not out["ok"]:
        # A refusal changes nothing, but for the used marker of the challenge it consumes.
        rest_equal("challenges")
        cid = out["presented"] if out.get("consumes_challenge") else None
        law(post["used_now"] == ([cid] if cid else []), "a refusal marked a challenge used "
            "other than the one it consumes")
        law(canon(post["challenges"]) == canon(challenges_with_used(cid)),
            "a challenge or its used marker changed other than by the consumption the "
            "text gives")
        return
    op, result = out["op"], out["result"]
    if op == "approver_registry_binding" or result.get("status") == "replayed":
        rest_equal()
        return
    if op == "approver_registry_challenge":
        rest_equal("challenges", "codes_sent")
        law(len(post["challenges"]) == len(pre["challenges"]) + 1 and
            canon(post["challenges"][:-1]) == canon(pre["challenges"]),
            "a challenge succeeds by recording exactly one new challenge")
        new = post["challenges"][-1]
        law(new["state"] == "pending" and canon(new["challenge"]) == canon(result["challenge"]),
            "the recorded challenge is the one answered, pending")
        cands = result["challenge"]["candidates"]
        phone = [result["challenge"]["challenge_id"] for c in cands if c["channel"] in PHONE]
        law(post["codes_sent"] == phone, "a possession code goes only to a phone candidate")
        return
    cid = out["presented"]
    law(post["used_now"] == ([cid] if cid else []), "a success consumes exactly its challenge")
    preg, nreg = pre["registry"], post["registry"]
    if op == "approver_registry_recover":
        rest_equal("challenges", "registry", "pending_phone_values", "phone_authorizations")
        law(post["pending_phone_values"] == [] and post["phone_authorizations"] == [] and
            post["challenges"] == [], "recovery clears every challenge, phone authorisation and "
            "pending phone operation")
        law(nreg is not None and nreg["registry_revision"] == 1 and nreg["credentials"] == [] and
            nreg["tombstoned_credentials"] == [] and nreg["tombstoned_approvers"] == [] and
            nreg["tombstoned_values"] == [] and nreg["last_external_revision"] == 0 and
            nreg["site_id"] == case["context"]["verified_site_id"] and
            nreg["device_id"] == case["context"]["device_id"],
            "recovery commits an empty initialized registry at revision 1 under the runtime's "
            "device identity and the verified site")
        return
    law(canon(post["challenges"]) == canon(challenges_with_used(cid)),
        "a success consumes exactly its challenge")
    if result.get("status") == "phone_pending":
        rest_equal("challenges", "pending_phone_values")
        law(len(post["pending_phone_values"]) == len(pre["pending_phone_values"]) + 1,
            "a phone candidate records one pending phone operation and no credential")
        return
    if op in ("approver_registry_local_seed", "approver_registry_enrol"):
        rest_equal("challenges", "registry")
        added = [c for c in nreg["credentials"] if c not in preg["credentials"]]
        law(len(added) == 1 and len(nreg["credentials"]) == len(preg["credentials"]) + 1,
            "a LAN addition commits exactly one credential")
        law(added[0]["sequence"] == preg["credential_sequence"] + 1 and
            nreg["credential_sequence"] == preg["credential_sequence"] + 1 and
            nreg["registry_revision"] == preg["registry_revision"] + 1 == result["registry_revision"],
            "the new credential takes the next sequence and the revision increments once")
        for k in ("tombstoned_credentials", "tombstoned_approvers", "tombstoned_values",
                  "identity_epoch", "device_id", "site_id", "last_external_revision",
                  "last_external_document_sha256"):
            law(canon(nreg[k]) == canon(preg[k]), f"a credential addition changed {k}")
        return
    # revoked
    rest_equal("registry")
    doc = json.loads(frame(case)[0])["document"]
    targets = [t.partition(":") for t in doc["targets"]]
    removed = [c for c in preg["credentials"] if any(
        (k == "credential" and c["credential_id"] == i) or (k == "approver" and
                                                           c["approver_id"] == i)
        for k, _, i in targets)]
    law(canon(nreg["credentials"]) == canon([c for c in preg["credentials"] if c not in removed]),
        "revocation removes exactly the targeted active credentials")
    law(all({"credential_id": c["credential_id"], "approver_id": c["approver_id"]}
            in nreg["tombstoned_credentials"] for c in removed) and
        len(nreg["tombstoned_credentials"]) == len(preg["tombstoned_credentials"]) + len(removed),
        "each removed credential, and only it, is tombstoned with its approver ID")
    law(set(nreg["tombstoned_approvers"]) == set(preg["tombstoned_approvers"]) |
        {i for k, _, i in targets if k == "approver"}, "approver targets are tombstoned")
    law(set(nreg["tombstoned_values"]) == set(preg["tombstoned_values"]) |
        {c["value"] for c in removed}, "a removed credential's value is tombstoned")
    law(nreg["registry_revision"] == preg["registry_revision"] + 1 and
        nreg["last_external_revision"] == doc["revision"] and
        nreg["credential_sequence"] == preg["credential_sequence"] and
        nreg["identity_epoch"] == preg["identity_epoch"] and nreg["site_id"] == preg["site_id"]
        and nreg["device_id"] == preg["device_id"],
        "revocation increments the revision once and records the external revision")


# ----- forbidden writes, injected by --mutations

FABRICATED = {"challenge": {"v": 1, "challenge_id": "/////////////////////w==", "device_id": "x",
                            "site_id": "x", "identity_epoch": "/////////////////////w==",
                            "operation": "enrol", "registry_revision": 0, "candidates": []},
              "state": "pending", "credential_sequence_at_issue": 0}


def _registry(world: dict) -> dict:
    if world["registry"] is None:
        world["registry"] = {"device_id": "x", "site_id": "x",
                             "identity_epoch": "/////////////////////w==",
                             "registry_revision": 1, "last_external_revision": 0,
                             "last_external_document_sha256": None, "credential_sequence": 0,
                             "credentials": [], "tombstoned_credentials": [],
                             "tombstoned_approvers": [], "tombstoned_values": []}
        return {}
    return world["registry"]


def _inc(key: str) -> Callable[[dict, dict], None]:
    def write(world: dict, out: dict) -> None:
        reg = _registry(world)
        if reg:
            reg[key] += 1
    return write


def _append(key: str, item: Any) -> Callable[[dict, dict], None]:
    def write(world: dict, out: dict) -> None:
        reg = _registry(world)
        if reg:
            reg[key].append(item)
    return write


def _epoch(world: dict, out: dict) -> None:
    reg = _registry(world)
    if reg:
        reg["identity_epoch"] = "AAAAAAAAAAAAAAAAAAAAAA=="


def _rebind(key: str) -> Callable[[dict, dict], None]:
    def write(world: dict, out: dict) -> None:
        reg = _registry(world)
        if reg:
            reg[key] = reg[key] + "-rebound"
    return write


def _used(world: dict, out: dict) -> None:
    for held in world["challenges"]:
        if held["challenge"]["challenge_id"] != (out["presented"] if out.get(
                "consumes_challenge") else None) and held["state"] != "used":
            held["state"] = "used"
            return
    world["challenges"].append({**copy.deepcopy(FABRICATED), "state": "used"})


def _unused(world: dict, out: dict) -> None:
    for held in world["challenges"]:
        if held["state"] == "used":
            held["state"] = "pending"
            return
    world["challenges"].append(copy.deepcopy(FABRICATED))


INJECT: dict[str, Callable[[dict, dict], None]] = {
    "registry revision": _inc("registry_revision"),
    "credential sequence": _inc("credential_sequence"),
    "last external revision": _inc("last_external_revision"),
    "credential added": _append("credentials", {
        "approver_id": "x", "credential_id": "x", "channel": "sms", "value": "+19999999999",
        "sequence": 99}),
    "credential tombstoned": _append("tombstoned_credentials",
                                     {"credential_id": "x", "approver_id": "x"}),
    "approver tombstoned": _append("tombstoned_approvers", "x"),
    "value tombstoned": _append("tombstoned_values", "+19999999999"),
    "identity epoch": _epoch,
    "device binding": _rebind("device_id"),
    "site binding": _rebind("site_id"),
    "challenge created": lambda w, o: w["challenges"].append(copy.deepcopy(FABRICATED)),
    "challenge marked used": _used,
    "used marker cleared": _unused,
    "pending phone operation": lambda w, o: w["pending_phone_values"].append("+19999999999"),
    "phone authorization": lambda w, o: w["phone_authorizations"].append(
        {"challenge_id": "/////////////////////w==", "authorizer_credential_id": "x"}),
    "in-flight marker": lambda w, o: w.update(
        registry_operation_in_flight=not w["registry_operation_in_flight"]),
    "possession code sent": lambda w, o: w["codes_sent"].append("/////////////////////w=="),
}


