"""Check the operator-socket/v3 approver registry corpus against the contract.

Shares no code with scripts/generate-operator-socket-approver-registry-vectors-v3,
and was written without reading it. Every case is replayed here through a model
read from operator-socket/v3.md, Approver Registry Operations, and from the
objects tier-c-approvers/v1.md defines; Ed25519 admission, verification and key
recognition are implemented here from ed25519-key-admission/v1 and
ed25519-verification/v1, with the standard library only.

Held to:

- the text: the bound, the framing, the order of refusal, every refusal table
  row (code and condition, word for word), each operation's members, the
  consumption boundary, the operational codes and the closed code list are
  parsed from the section, and the model takes its order and its values from
  them; the sentences each rule rests on are held word for word (whitespace
  collapsed), in v3.md and in tier-c-approvers/v1.md;
- every case: the frame (the bytes before the first LF; a connection that ends
  before any LF), the byte-exact bound, duplicate members at every depth,
  byte-exact member names, closed member sets and value forms, peer admission,
  `registry_busy`, the verified site, each operation's checks in the text's
  order, key recognition by identity and phone values by number, every
  challenge digest and Ed25519 signature, the exact `result`, the refusal code
  and whether the challenge is consumed;
- state: the model runs each case against a copy of the context's state and
  writes only what the text lets the outcome write. A refusal must leave every
  part of that state as it was, but for the used marker of the challenge it
  consumes; a success must write exactly its operation's commit. Each law is
  written apart from the effects it judges;
- the corpus: exact key sets, unique names, the header against the text, the
  `signatures` note bound to the codes that may carry a failing signature,
  `keys_failing_admission` exact, every non-operational code answered, an
  accepted case for every registry operation, and the boundaries the text
  states.

    python3 scripts/check-operator-socket-approver-registry-vectors-v3
    python3 scripts/check-operator-socket-approver-registry-vectors-v3 --mutations
    python3 scripts/check-operator-socket-approver-registry-vectors-v3 --explain

`--mutations` alters the corpus (each expected outcome and result member, each
consumption flag, each verifying signature, each code's cases, the header), the
text (each held sentence and its last word, each table row and its last word,
the refusal order, the bound, the members, the consumption boundary, the closed
list), the model (planted defects) and its writes (each forbidden write injected
at each refusal, and at each success that changes nothing); every mutant must
be refused. For the order of each refusal table, every row is moved ahead of
every earlier row; a move is exempt only when NEEDS shows the moved row can
never fail together with any row it overtakes, and then it must change no
answer. `--explain` prints, per case, every check that fails. `--corpus PATH`
checks another corpus file against the same text.

The corpus carries no state after a case, only `consumes_challenge`, so the
state laws hold this checker's model to the text; an implementation replaying
the corpus can check its own writes only through that one flag.
"""

from __future__ import annotations

import base64
import copy
import functools
import hashlib
import json
import multiprocessing
import os
import pathlib
import re
import sys

# A JSON integer of any length is a token the text judges (a revision over 2^53 − 1
# is malformed); Python's guard on converting long digit strings is not the text's.
sys.set_int_max_str_digits(0)
from collections.abc import Callable
from typing import Any

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "operator-socket" / "v3.md"
APPROVERS = ROOT / "tier-c-approvers" / "v1.md"
CORPUS = ROOT / "operator-socket" / "vectors" / "approver-registry-v3.json"
GENERATOR = "scripts/generate-operator-socket-approver-registry-vectors-v3"
CHECKER = "scripts/check-operator-socket-approver-registry-vectors-v3"
SECTION = "Approver Registry Operations"
SUBSECTIONS = ("Requests on the socket", "Authorisation", "Serialisation",
               "Order of refusal", "Value forms", "Challenge", "Challenges presented",
               "Recover", "Local seed", "Enrol", "Revoke", "Binding", "Codes")
TABLED = ("Challenge", "Challenges presented", "Recover", "Local seed", "Enrol",
          "Revoke", "Binding")
PRESENTING = {"approver_registry_recover": "Recover",
              "approver_registry_local_seed": "Local seed",
              "approver_registry_enrol": "Enrol"}
OWN_TABLE = {"approver_registry_challenge": "Challenge", "approver_registry_revoke": "Revoke",
             "approver_registry_binding": "Binding"}
PHONE = ("sms", "whatsapp")


class Failure(Exception):
    pass


def flat(text: str) -> str:
    return " ".join(text.split())


