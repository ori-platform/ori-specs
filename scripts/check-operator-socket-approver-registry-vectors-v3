) + tuple(f"matrix_flip:{p}:{k}:{w}" for p in ("lan", "phone") for k in ("lan", "sms")
          for w in ("minted", "own", "other")) + tuple(
    f"matrix_flip:{':'.join(v if i == axis else '*' for i in range(3))}"
    for axis, values in enumerate((("lan", "phone"), ("lan", "sms"), ("minted", "own", "other")))
    for v in values) + ("matrix_flip:phone:*:own", "matrix_flip:lan:*:other",
                        "matrix_flip:*:sms:minted") + tuple(
    f"elig_accept:{p}:{c}" for p in ("lan", "phone")
    for c in ("absent", "not_active", "wrong_kind")) + tuple(
