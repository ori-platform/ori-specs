                                             "registry_revision"}}


def need(cond: bool, message: str) -> None:
    if not cond:
        raise Failure(message)


def is_uid(v: Any) -> bool:
    return v is None or (type(v) is int and v >= 0)


SIGNATURES_NOTE = (
    "A signed object is a possession (verified under the candidate's value at Local seed's or "
    "Enrol's possession signature_invalid row), an authorization (under the named active "
    "credential's value, at Enrol's first signature_invalid row) or a revocation document "
    "(under its signing_key, at Revoke's signature_invalid row). A case may carry a signed "
    "object whose signature does not verify only when its answer is decided by a step of Order "
    "of refusal, by a row of Challenges presented, or by a row of the operation's table that "
    "comes before that object's signature row or is that row. In every other case each signed "
    "object the request carries verifies under its key.")
# Each signed object's signature row, as the note names it: (table, code, occurrence).
SIGNATURE_ROW = {("possession", "approver_registry_local_seed"): ("Local seed", "signature_invalid", 0),
                 ("possession", "approver_registry_enrol"): ("Enrol", "signature_invalid", 1),
                 ("authorization", "approver_registry_enrol"): ("Enrol", "signature_invalid", 0),
                 ("document", "approver_registry_revoke"): ("Revoke", "signature_invalid", 0)}

# The `expected.changes` note, held word for word: its vocabulary, the refusal rule,
# what recover lists, and what registry_created and last_external_revision imply.
CHANGES_NOTE = (
    "Every state change the answer commits, sorted, from this closed vocabulary: "
    "challenge_added:<challenge_id> (a pending challenge with its deadline); "
    "code_sent:<challenge_id> (a possession code sent to the challenge's phone candidate); "
    "used:<challenge_id> (the challenge marked used); registry_created:<identity_epoch> (an "
    "empty initialized registry under that epoch, the context's device_id and the verified "
    "site: revision 1, last "
    "external revision 0, credential sequence 0, no credentials or tombstones); "
    "challenges_cleared, phone_authorizations_cleared and pending_phone_cleared (every held "
    "challenge, received phone authorization and pending phone operation removed); "
    "credential_added:<credential_id> (the candidate made active); sequence:<n> and "
    "revision:<n> (the new credential sequence and registry revision); "
    "pending_phone_added:<value> (a pending phone operation for the candidate); "
    "credential_tombstoned:<credential_id> and value_tombstoned:<value> (an active credential "
    "removed, its ID and value tombstoned); approver_tombstoned:<approver_id>; and "
    "last_external_revision:<n>. A refusal lists [] or, when it consumes its challenge, only "
    "used:<challenge_id>. Every successful recover lists challenges_cleared, "
    "phone_authorizations_cleared and pending_phone_cleared, whether or not anything was "
    "held, and still lists used:<challenge_id> for the challenge it consumes and clears in "
    "the same transaction. registry_created implies revision 1, last external revision 0 and "
    "credential sequence 0, which are not listed separately. The recorded fingerprint of the "
    "last applied revocation document changes with last_external_revision and has no token of "
    "its own.")

WINDOW_MS = 60_000
CHALLENGES_NOTE_SENTENCE = (
    "A challenge not used is expired exactly when elapsed_ms exceeds 60,000, the challenge "
    "window, whatever its candidate's channel; the separate 10-minute phone possession window "
    "never extends it.")

# The closed vocabulary of `expected.changes`, as its note lists it.
CHANGE_KINDS = ("challenge_added", "code_sent", "used", "registry_created", "challenges_cleared",
                "phone_authorizations_cleared", "pending_phone_cleared", "credential_added",
                "sequence", "revision", "pending_phone_added", "credential_tombstoned",
                "value_tombstoned", "approver_tombstoned", "last_external_revision")


MATRIX_SENTENCE = (
    "The cases named m_<path>_<candidate>_<approver> are the enrolment matrix: every "
    "combination of authoriser path (lan, an authorization object; phone, an ORI-ENROL-V1 "
    "text), candidate kind (lan, sms) and candidate approver (minted, own, other).")
ELIGIBILITY_SENTENCE = (
    "The cases named e_<path>_<condition> are the authoriser eligibility block: every "
    "combination of authoriser path (lan, phone) and authoriser condition (absent, "
    "not_active, wrong_kind, not_preexisting, eligible).")
SWEEP_SENTENCE = (
    "The cases named x_<table>_<row>_<axes> are the refusal sweep, each decided by its "
    "row: steps (the Order-of-refusal steps) over every registry operation, and over "
    "evidence_commission for payload_too_large and invalid_arguments; cp (Challenges "
    "presented) over recover, and over local_seed (a lan challenge) and enrol (a lan or "
    "sms challenge) each x presented candidate kind (lan, sms, whatsapp), a presented "
    "kind other than the challenge's being decided at candidate_changed unless an earlier "
    "row fires; challenge_unavailable over the presented candidate kind alone, no "
    "challenge being held, and device_binding_mismatch and site_binding_mismatch also with "
    "no challenge held, over "
    "recover and the presented kind for local_seed and enrol; an expired sms challenge "
    "sitting between the 60-second challenge window and the 10-minute possession window; "
    "ch (Challenge) for an enrolment over candidate kind (lan, sms) x request approver "
    "(null, named), except phone_pending_for_value (sms only), channel_unauthenticated "
    "(whatsapp, and sms while the runtime has no authenticated SMS ingress) and "
    "approver_revoked and approver_unknown (named only); rc, ls, rv and bd (Recover, "
    "Local seed, Revoke, Binding) alone; en (Enrol) over authoriser path (lan, phone) x "
    "candidate kind (lan, sms), and from challenge_stale on, where the registry is held, "
    "also x candidate approver (minted, own, and other up to authorizer_not_approver; "
    "registry_unavailable has no approver axis), except that "
    "signature_invalid_authorization is lan-path only, possession_invalid and "
    "signature_invalid_possession are lan-candidate only, phone_pending_for_value is "
    "sms-candidate only, authorizer_not_approver is other only and approver_revoked "
    "minted only; ms (member strictness) over member form (escaped_duplicate, "
    "case_variant, unknown_member) x location (top, candidate, authorization, possession, "
    "document), malformed inside a document and invalid_arguments elsewhere.")
SWEEP_NAMES = {"signature_invalid_authorization": (E, "signature_invalid", 0),
               "signature_invalid_possession": (E, "signature_invalid", 1)}
ELIGIBILITY_AXES = (("lan", "phone"),
                    ("absent", "not_active", "wrong_kind", "not_preexisting", "eligible"))
MATRIX_AXES = (("lan", "phone"), ("lan", "sms"), ("minted", "own", "other"))


def check_notes(note: dict) -> None:
    need(note.get("corpus", "").startswith(
        MATRIX_SENTENCE + " " + ELIGIBILITY_SENTENCE + " " + SWEEP_SENTENCE + " "),
        "the corpus note's enrolment-matrix, eligibility or sweep sentence changed")
    need(CHALLENGES_NOTE_SENTENCE in note.get("context.challenges", ""),
         "the context.challenges note no longer states expiry by elapsed_ms")
    need(note.get("signatures") == SIGNATURES_NOTE, "the corpus's `signatures` note changed")
    need(note.get("expected.changes") == CHANGES_NOTE, "the corpus's `expected.changes` note "
         "changed")
    for kind in CHANGE_KINDS:
        need(re.search(rf"\b{kind}\b", CHANGES_NOTE) is not None,
             f"the `expected.changes` note no longer names {kind}")


def sweep_claims(text: dict) -> dict[tuple, tuple[set[str], set[str], str | None]]:
    """What the held sweep sentence claims, row by row and axis by axis, as read from
    it here: (row, axis) -> (claimed values, the sweep's domain for that axis, the
    operation the claim is scoped to)."""
    claims: dict[tuple, tuple[set[str], set[str], str | None]] = {}
    registry = {OP_NAME[o] for o in text["registry_ops"]}
    for step in ("bound", "form", "caller", "busy", "site"):
        ops = registry | ({"evidence_commission"} if step in ("bound", "form") else set())
        claims[(("step", step), "op")] = (ops, ops, None)
    own = {"recover": {"recover"}, "local_seed": {"lan"}, "enrol": {"lan", "sms"}}
    for row in keyed_rows(text["tables"][CP], CP):
        claims[(row, "op")] = ({"recover", "local_seed", "enrol"},) * 2 + (None,)
        for op in ("recover", "local_seed", "enrol"):
            # challenge_unavailable: no challenge held, the presented kind alone;
            # device_binding_mismatch and site_binding_mismatch: the operation's own
            # challenge and none held.
            bindings = ("device_binding_mismatch", "site_binding_mismatch")
            kinds = {"none"} if row[1] == "challenge_unavailable" else \
                own[op] | {"none"} if row[1] in bindings else own[op]
            domain = own[op] | {"none"}
            if op != "recover" or row[1] == "challenge_unavailable" or row[1] in bindings:
                claims[(row, "kind", op)] = (kinds, domain, op)
            if op != "recover":
                claims[(row, "pres", op)] = ({"lan", "sms", "whatsapp"},) * 2 + (op,)
    enrol_rows = [r for r in keyed_rows(text["tables"][C], C)
                  if "enrol" in NEEDS.get(r, {}).get("op", "enrol").split("|")]
    for row in enrol_rows:
        # channel_unauthenticated: "whatsapp, and sms while the runtime has no
        # authenticated SMS ingress", judged with the no-ingress context included.
        cand = {"phone_pending_for_value": {"sms"},
                "channel_unauthenticated": {"whatsapp", "sms"}}.get(row[1], {"lan", "sms"})
        approver = {"named"} if row[1] in ("approver_revoked", "approver_unknown") else \
            {"null", "named"}
        claims[(row, "cand")] = (cand, {"lan", "sms"} | cand, "enrol")
        claims[(row, "approver")] = (approver, {"null", "named"}, "enrol")
    keys = keyed_rows(text["tables"][E], E)
    not_approver = keys.index((E, "authorizer_not_approver", 0))
    for index, row in enumerate(keys):
        path = {"lan"} if row == SWEEP_NAMES["signature_invalid_authorization"] else \
            {"lan", "phone"}
        cand = {"lan"} if row in ((E, "possession_invalid", 0),
                                  SWEEP_NAMES["signature_invalid_possession"]) else \
            {"sms"} if row[1] == "phone_pending_for_value" else {"lan", "sms"}
        approver = {"other"} if index == not_approver else {"minted"} if \
            row[1] == "approver_revoked" else {"minted", "own", "other"} if \
            index < not_approver else {"minted", "own"}
        claims[(row, "path")] = (path, {"lan", "phone"}, None)
        claims[(row, "cand")] = (cand, {"lan", "sms"}, None)
        if row[1] == "registry_unavailable":
            approver = set()      # "registry_unavailable has no approver axis"
        claims[(row, "approver")] = (approver, {"minted", "own", "other"}, None)
    return claims


def sweep_compare(text: dict, joint: dict) -> list[str]:
    """Where the sweep sentence's claims and the model's reachability differ."""
    out = []
    for (row, axis, *_), (claimed, domain, scope) in sweep_claims(text).items():
        # The sweep runs in its default context, the runtime holding SMS ingress,
        # but for channel_unauthenticated, which it also sweeps without it.
        with_ingress_off = row == (C, "channel_unauthenticated", 0)
        reached = {a[axis] for a in joint.get(row, []) if a.get(axis) is not None and
                   (scope is None or a.get("op") == scope) and
                   (with_ingress_off or "_ingress" not in a)}
        if row[0] == "step":
            reached = {a["op"] for a in joint.get(row, []) if a.get("op") is not None}
        got = reached & domain
        if got != claimed:
            out.append(f"{row_name(row)} {axis}: the sweep sentence says {sorted(claimed)}, "
                       f"the text gives {sorted(got)}")
    return out


def signature_may_fail(label: str, got: dict, T: dict, D: frozenset = frozenset()) -> bool:
    """The note's rule: a failing signature is allowed when the answer is decided at
    or before that object's signature row."""
    where = got["where"]
    if got["ok"]:
        return False
    if where[0] == "step":
        return "signatures_not_at_steps" not in D
    if where[0] == "Challenges presented":
        return "signatures_not_at_presented" not in D
    row = SIGNATURE_ROW.get((label, got["op"]))
    if row is None or row[0] != where[0]:
        return False
    keys = keyed_rows(T["tables"][where[0]], where[0])
    if "signatures_before_row_only" in D:
        return where[1] < keys.index(row)
    return where[1] <= keys.index(row)


def changes_of(out: dict) -> list[str]:
    """The state an outcome committed, in the corpus's vocabulary, read off the
    state before and after it."""
    pre, post = out["pre"], out["post"]
    tokens: list[str] = []
    created = pre["registry"] is None and post["registry"] is not None
    if pre["challenges"] and not post["challenges"] or created:
        tokens.append("challenges_cleared") if not post["challenges"] else None
    before = {h["challenge"]["challenge_id"]: h for h in pre["challenges"]}
    for held in post["challenges"]:
        cid = held["challenge"]["challenge_id"]
        if cid not in before:
            tokens.append(f"challenge_added:{cid}")
        elif held["state"] == "used" and before[cid]["state"] != "used":
            tokens.append(f"used:{cid}")
    for cid in post["used_now"]:
        if f"used:{cid}" not in tokens and cid in before and before[cid]["state"] != "used":
            tokens.append(f"used:{cid}")
    tokens += [f"code_sent:{cid}" for cid in post["codes_sent"]]
    for part, token in (("phone_authorizations", "phone_authorizations_cleared"),
                        ("pending_phone_values", "pending_phone_cleared")):
        if not post[part] and (pre[part] or created):
            tokens.append(token)
    tokens += [f"pending_phone_added:{v}" for v in post["pending_phone_values"]
               if v not in pre["pending_phone_values"]]
    preg, nreg = pre["registry"], post["registry"]
    if created:
        tokens.append(f"registry_created:{nreg['identity_epoch']}")
    elif preg is not None and nreg is not None:
        ids = {c["credential_id"] for c in preg["credentials"]}
        tokens += [f"credential_added:{c['credential_id']}" for c in nreg["credentials"]
                   if c["credential_id"] not in ids]
        old_t = {t["credential_id"] for t in preg["tombstoned_credentials"]}
        tokens += [f"credential_tombstoned:{t['credential_id']}"
                   for t in nreg["tombstoned_credentials"] if t["credential_id"] not in old_t]
        tokens += [f"value_tombstoned:{v}" for v in nreg["tombstoned_values"]
                   if v not in preg["tombstoned_values"]]
        tokens += [f"approver_tombstoned:{a}" for a in nreg["tombstoned_approvers"]
                   if a not in preg["tombstoned_approvers"]]
        for key, token in (("credential_sequence", "sequence"), ("registry_revision", "revision"),
                           ("last_external_revision", "last_external_revision")):
            if nreg[key] != preg[key]:
                tokens.append(f"{token}:{nreg[key]}")
        for key in ("identity_epoch", "device_id", "site_id"):
            if nreg[key] != preg[key]:
                tokens.append(f"{key}:{nreg[key]}")
    elif preg is not None:
        tokens.append("registry_dropped")
    if post["phone_authorizations"] and canon(post["phone_authorizations"]) != canon(
            pre["phone_authorizations"]):
        tokens.append("phone_authorizations_changed")
    if post["registry_operation_in_flight"] != pre["registry_operation_in_flight"]:
        tokens.append("registry_operation_in_flight")
    for cid, held in before.items():
        now = next((h for h in post["challenges"] if h["challenge"]["challenge_id"] == cid), None)
        if now is not None and now["state"] != held["state"] and now["state"] != "used":
            tokens.append(f"state:{cid}")
    return sorted(tokens)


def check_context(name: str, ctx: dict) -> None:
    need(isinstance(ctx, dict) and set(ctx) == CONTEXT_KEYS, f"{name}: context keys")
    need(is_device_id(ctx["device_id"]), f"{name}: device_id")
    need(ctx["verified_site_id"] is None or isinstance(ctx["verified_site_id"], str),
         f"{name}: verified_site_id")
    need(is_uid(ctx["peer_uid"]) and is_uid(ctx["operator_uid"]), f"{name}: uids")
    need(type(ctx["registry_operation_in_flight"]) is bool and
         type(ctx["anchor_available"]) is bool, f"{name}: flags")
    anchors = ctx["anchors"]
    need(isinstance(anchors, dict) and set(anchors) == {"current", "previous", "other_class"} and
         all(canon_b64(a, 32) for a in anchors.values()), f"{name}: anchors")
    held_keys = list(anchors.values())
    reg = ctx["registry"]
    if reg is not None:
        need(isinstance(reg, dict) and set(reg) == REGISTRY_KEYS, f"{name}: registry keys")
        # "A header missing any of its three bindings, or holding one outside its form, is
        # corrupt, so the registry is locked": such a registry is `null`, never held.
        need(is_device_id(reg["device_id"]) and is_id(reg["site_id"]) and
             canon_b64(reg["identity_epoch"], 16) is not None,
             f"{name}: not a valid context: a registry with a binding outside its form is "
             "corrupt, so locked, and is null")
        need(canon_b64(reg["identity_epoch"], 16) is not None, f"{name}: registry epoch")
        for k in ("registry_revision", "last_external_revision", "credential_sequence"):
            need(type(reg[k]) is int and reg[k] >= 0, f"{name}: registry {k}")
        need(reg["registry_revision"] >= 1, f"{name}: registry revision starts at 1")
        need((reg["last_external_document_sha256"] is None) == (reg["last_external_revision"] == 0)
             and (reg["last_external_document_sha256"] is None or
                  is_digest(reg["last_external_document_sha256"])),
             f"{name}: last external document")
        ids = set()
        for c in reg["credentials"]:
            need(set(c) == CREDENTIAL_KEYS and is_id(c["approver_id"]) and
                 is_id(c["credential_id"]) and c["channel"] in ("sms", "whatsapp", "lan_ed25519")
                 and is_value(c["channel"], c["value"]) and type(c["sequence"]) is int and
                 1 <= c["sequence"] <= reg["credential_sequence"], f"{name}: credential {c}")
            if c["channel"] == "lan_ed25519":
                held_keys.append(c["value"][8:])
            need(c["credential_id"] not in ids, f"{name}: two active credentials share an ID")
            ids.add(c["credential_id"])
        for t in reg["tombstoned_credentials"]:
            need(isinstance(t, dict) and set(t) == {"credential_id", "approver_id"} and
                 is_id(t["credential_id"]) and is_id(t["approver_id"]),
                 f"{name}: tombstoned credential {t}")
        for k in ("tombstoned_credentials", "tombstoned_approvers", "tombstoned_values"):
            need(isinstance(reg[k], list) and
                 len({json.dumps(x, sort_keys=True) for x in reg[k]}) == len(reg[k]),
                 f"{name}: registry {k}")
    failing = ctx["keys_failing_admission"]
    need(isinstance(failing, list) and all(canon_b64(k, 32) for k in failing),
         f"{name}: keys_failing_admission")
    actually = sorted({k for k in held_keys if not key_admitted(canon_b64(k, 32))})
    need(sorted(set(failing)) == actually and len(set(failing)) == len(failing),
         f"{name}: keys_failing_admission {sorted(failing)} is not the context's keys that fail "
         f"admission {actually}")
    seen = set()
    for held in ctx["challenges"]:
        need(set(held) == HELD_CHALLENGE_KEYS and held["state"] in ("pending", "used", "expired")
             and type(held["credential_sequence_at_issue"]) is int and
             type(held["elapsed_ms"]) is int and held["elapsed_ms"] >= 0,
             f"{name}: held challenge")
        need(held["state"] == "used" or
             (held["state"] == "expired") == (held["elapsed_ms"] > WINDOW_MS),
             f"{name}: a held challenge's state is not what its elapsed_ms makes it")
        ch = held["challenge"]
        need(set(ch) == CHALLENGE_KEYS and is_v(ch["v"]) and
             canon_b64(ch["challenge_id"], 16) is not None and
             canon_b64(ch["identity_epoch"], 16) is not None and
             ch["operation"] in ("recover", "local_seed", "enrol") and
             type(ch["registry_revision"]) is int and ch["registry_revision"] >= 0 and
             is_device_id(ch["device_id"]) and is_id(ch["site_id"]), f"{name}: challenge object")
        need(len(ch["candidates"]) == (0 if ch["operation"] == "recover" else 1) and
             all(form_candidate(c) for c in ch["candidates"]), f"{name}: challenge candidates")
        need(ch["challenge_id"] not in seen, f"{name}: two held challenges share an ID")
        need(not ch["candidates"] or ch["candidates"][0]["channel"] not in PHONE or
             ch["candidates"][0]["channel"] in ctx["authenticated_phone_channels"],
             f"{name}: not a valid context: a held challenge's candidate is on a phone channel "
             "with no authenticated ingress, and that set is fixed for a run")
        seen.add(ch["challenge_id"])
    for text in ctx["phone_authorizations"]:
        need(set(text) == {"challenge_id", "challenge_sha256", "authorizer_credential_id"} and
             is_digest(text["challenge_sha256"]) and
             canon_b64(text["challenge_id"], 16) is not None and
             is_id(text["authorizer_credential_id"]), f"{name}: phone authorization")
    channels = ctx["authenticated_phone_channels"]
    need(isinstance(channels, list) and set(channels) <= {"sms"} and
         len(set(channels)) == len(channels),
         f"{name}: authenticated_phone_channels (only sms can have one in v1)")
    need(all(is_value("sms", v) for v in ctx["pending_phone_values"]),
         f"{name}: pending phone values")
    minted = ctx["minted"]
    if minted is not None:
        need(set(minted) == {"challenge_id", "approver_id", "credential_id", "identity_epoch"} and
             canon_b64(minted["challenge_id"], 16) is not None and is_id(minted["approver_id"]) and
             is_id(minted["credential_id"]) and canon_b64(minted["identity_epoch"], 16) is not None,
             f"{name}: minted")


def same(a: Any, b: Any) -> bool:
    return profile2(a) == profile2(b)


def check_case(case: dict, T: dict, defects: frozenset = frozenset(),
               inject: tuple | None = None) -> dict:
    name = case.get("name")
    need(isinstance(case, dict) and set(case) == CASE_KEYS and isinstance(name, str) and name and
         isinstance(case["note"], str) and case["note"], f"{name}: case keys")
    check_context(name, case["context"])
    need(isinstance(case["request"], str) and type(case["terminated"]) is bool,
         f"{name}: request or terminated")
    try:
        raw = case["request"].encode("utf-8")
    except UnicodeEncodeError:
        raise Failure(f"{name}: request is not UTF-8 text") from None
    need(type(case["request_bytes"]) is int and case["request_bytes"] == len(raw),
         f"{name}: request_bytes {case['request_bytes']} is not {len(raw)}")
    exp = case["expected"]
    need(isinstance(exp, dict) and type(exp.get("ok")) is bool, f"{name}: expected")
    base = {"ok", "result", "changes"} if exp["ok"] else {"ok", "code", "changes"}
    need(set(exp) in (base, base | {"consumes_challenge"}), f"{name}: expected keys")
    need(isinstance(exp["changes"], list) and exp["changes"] == sorted(exp["changes"]) and
         all(isinstance(t, str) and t.split(":", 1)[0] in CHANGE_KINDS for t in exp["changes"]),
         f"{name}: changes are not sorted tokens of the closed vocabulary")
    try:
        got = evaluate(case, T, defects, inject)
    except NotModelled as exc:
        raise Failure(f"{name}: outside the model: {exc}") from None
    except (KeyError, TypeError, IndexError, AttributeError) as exc:
        if defects or inject:
            raise
        raise Failure(f"{name}: the model cannot answer it; its request or context lacks or "
                      f"misshapes something the text reads ({type(exc).__name__}: {exc})") from None
    if exp["ok"] != got["ok"] or (exp["ok"] and not same(exp["result"], got["result"])) or \
            (not exp["ok"] and exp["code"] != got["code"]):
        shown = {k: got[k] for k in ("ok", "result", "code") if k in got}
        plain_exp = {k: v for k, v in exp.items() if k not in ("consumes_challenge", "changes")}
        raise Failure(f"{name}: expected {json.dumps(plain_exp)}, the text gives "
                      f"{json.dumps(shown)}")
    if got["presents"]:
        need("consumes_challenge" in exp and type(exp["consumes_challenge"]) is bool,
             f"{name}: consumes_challenge missing for a request that presents a challenge")
        need(exp["consumes_challenge"] == got["consumes_challenge"],
             f"{name}: consumes_challenge {exp['consumes_challenge']}, the text gives "
             f"{got['consumes_challenge']}")
    else:
        need("consumes_challenge" not in exp,
             f"{name}: consumes_challenge on a request that presents no challenge")
    if exp["ok"]:
        need(set(exp["result"]) == RESULT_KEYS[got["op"]], f"{name}: result members")
    judged = got["op"] == "approver_registry_challenge" and \
        (got["ok"] or got["where"][0] == "Challenge")
    need((case["context"]["minted"] is not None) == judged,
         f"{name}: context.minted is set though no challenge is judged, or unset for one that is")
    for label, verified in signed_objects(case, T):
        need(verified is not False or signature_may_fail(label, got, T, defects),
             f"{name}: its {label} signature does not verify though the answer is decided after "
             "that object's signature row")
    state_law(case, got)
    delta = changes_of(got)
    need(delta == exp["changes"], f"{name}: changes {exp['changes']}, the state the text "
         f"commits is {delta}")
    return got


def check(text_src: str, approvers_src: str, corpus: dict, defects: frozenset = frozenset(),
          announce: bool = True) -> None:
    T = read_text(text_src, approvers_src)
    need(isinstance(corpus, dict) and set(corpus) == TOP, "corpus top-level keys")
    need(corpus["contract"] == "operator-socket/v3" and corpus["section"] == SECTION,
         "corpus contract or section")
    need(type(corpus["bound_bytes"]) is int and corpus["bound_bytes"] == T["bound"],
         f"bound_bytes {corpus['bound_bytes']} is not the text's {T['bound']}")
    answered = [c for c in T["closed"] if c not in T["operational"]]
    need(corpus["codes"] == answered,
         "corpus codes are not the closed list less the operational codes, in the text's order")
    need(isinstance(corpus["note"], dict) and set(corpus["note"]) == NOTE_KEYS and
         all(isinstance(v, str) and v for v in corpus["note"].values()), "corpus note keys")
    check_notes(corpus["note"])
    differ = sweep_compare(T, reachable_joint(T))
    need(not differ, "the sweep sentence and the text's reachability differ: " + "; ".join(differ))
    cases = corpus["cases"]
    need(isinstance(cases, list) and cases, "no cases")
    names = [c.get("name") for c in cases]
    need(len(set(names)) == len(names), "case names are not unique")
    outcomes = [(case, check_case(case, T, defects)) for case in cases]
    coverage(T, corpus, outcomes)
    if announce:
        print(f"operator-socket/v3 approver registry: {len(cases)} cases agree with the text, "
              "and their state laws hold")


def request_of(case: dict) -> Any:
    raw, complete = frame(case)
    try:
        return parse_request(raw) if complete else None
    except (ValueError, UnicodeDecodeError):
        return None


def signed_objects(case: dict, T: dict) -> list[tuple[str, bool | None]]:
    """Every signed object a request carries and whether it verifies under its key
    (None when the case names no key for it)."""
    req = request_of(case)
    if not isinstance(req, dict):
        return []
    reg = case["context"]["registry"] or {}
    creds = {c["credential_id"]: c for c in reg.get("credentials", [])}

    def verifies(obj: Any, key: bytes | None, domain: str) -> bool | None:
        if not isinstance(obj, dict) or key is None or "signature" not in obj:
            return None
        signature = canon_b64(obj["signature"], 64)
        if signature is None:
            return False
        try:
            unsigned = profile2({k: v for k, v in obj.items() if k != "signature"})
        except Failure:
            return False
        return verify(key, T["domains"][domain] + b"\0" + unsigned, signature)

    out = []
    if isinstance(req.get("candidate"), dict):
        out.append(("possession", verifies(req.get("possession"),
                                           lan_key(req["candidate"].get("value")), "possession")))
    auth = req.get("authorization")
    if isinstance(auth, dict):
        cred = creds.get(auth.get("authorizer_credential_id"))
        out.append(("authorization", verifies(auth, lan_key(cred["value"]) if cred else None,
                                              "enrol")))
    doc = req.get("document")
    if isinstance(doc, dict):
        out.append(("document", verifies(doc, lan_key(doc.get("signing_key")), "revoke")))
    return out


def op_of(case: dict) -> str | None:
    req = request_of(case)
    return req.get("operation") if isinstance(req, dict) else None


def defined(a: dict) -> dict:
    """An assignment's axis values, without undefined axes or conditions (`_` keys)."""
    return {k: v for k, v in a.items() if v is not None and not k.startswith("_")}


def maximal(assignments: list[dict]) -> list[dict]:
    """The assignments no other one extends: those that define every axis the row
    can define for them."""
    shown = [defined(a) for a in assignments]
    return [a for a in shown if not any(b != a and b.items() >= a.items() for b in shown)]


def by_row(outcomes: list) -> dict[tuple, list]:
    out: dict[tuple, list] = {}
    for case, g in outcomes:
        out.setdefault(g["decided"], []).append((case, g))
    return out


def required(assignments: list[dict]) -> list[dict]:
    """The cells a row must have a case for: every maximal one but a foreign
    challenge's (presenting another operation's challenge is one case class, not a
    sweep over it), and one per single axis value, the foreign challenge included."""
    cells = [a for a in maximal(assignments) if a.get("kind") != "foreign"]
    singles = [{axis: value} for axis in sorted({k for a in assignments for k, v in a.items()
                                                 if v is not None and not k.startswith("_")})
               for value in sorted({a[axis] for a in assignments if a.get(axis) is not None})]
    return cells + singles


def row_law(row: tuple, assignments: list[dict], decided: list) -> list[str]:
    """One row's part of the law: its cases inside its reachability, its required
    cells each decided by some case."""
    out = []
    shown = {frozenset(defined(a).items()) for a in assignments}
    for case, g in decided:
        if frozenset(g["axes"].items()) not in shown:
            out.append(f"{case['name']} decided at {row_name(row)} with {g['axes']}, outside "
                       "the text's reachability")
    if not decided:
        return out + [f"{row_name(row)} deciding any case"]
    axes = [frozenset(g["axes"].items()) for _, g in decided]
    for cell in required(assignments):
        items = frozenset(cell.items())
        if not any(items <= a for a in axes):
            out.append(f"{row_name(row)} with " +
                       (", ".join(f"{k}={v}" for k, v in sorted(cell.items())) or "no axis"))
    return out


def reach_law(joint: dict, outcomes: list) -> list[str]:
    """Every case decided at a joint assignment the model's reachability holds, and
    every required reachable cell of every row decided by at least one case."""
    rows = by_row(outcomes)
    out = []
    for row, decided in rows.items():
        if row not in joint:
            out += [f"{case['name']} decided at {row_name(row)}, which the text makes "
                    "unreachable" for case, _ in decided]
    for row, assignments in joint.items():
        out += row_law(row, assignments, rows.get(row, []))
    return out


MS_FORMS = ("escaped_duplicate", "case_variant", "unknown_member")
MS_LOCATIONS = ("top", "candidate", "authorization", "possession", "document")
SIGNED_MEMBERS = {"authorization": {"v", "challenge_id", "challenge_sha256",
                                    "authorizer_credential_id", "signature"},
                  "possession": {"v", "challenge_id", "challenge_sha256",
                                 "candidate_credential_id", "signature"}}


def ms_cell(case: dict, T: dict) -> tuple[str, str] | None:
    """The member-strictness cell a request is, read from its own bytes: a member
    named twice through a JSON escape, a member differing from an accepted one only
    in case, or an unknown member, at the top level or in a candidate, authorization,
    possession or revocation document."""
    raw, complete = frame(case)
    if not complete:
        return None
    try:
        obj = parse_request(raw)
    except ValueError:
        return None
    if not isinstance(obj, dict) or not isinstance(obj.get("operation"), str) or \
            obj["operation"] not in T["ops"]:
        return None
    op = obj["operation"]
    places = [("top", obj, set(T["members"][op]))]
    for loc in ("candidate", "authorization", "possession", "document"):
        if isinstance(obj.get(loc), dict):
            accepted = REVOKE_MEMBERS if loc == "document" else SIGNED_MEMBERS.get(loc) or (
                {"approver_id", "credential_id", "channel", "value"} if op in PRESENTING else
                {"channel", "value"} | ({"approver_id"} if obj.get("challenge_operation") ==
                                        "enrol" else set()))
            places.append((loc, obj[loc], accepted))
    escaped = "\\u" in raw.decode("utf-8")
    for loc, o, accepted in places:
        if isinstance(o, Obj) and o.twice and escaped:
            return "escaped_duplicate", loc
        lowered = {a.lower() for a in accepted}
        for k in o:
            if k not in accepted:
                return ("case_variant" if k.lower() in lowered else "unknown_member"), loc
    return None


def member_strictness(T: dict, outcomes: list) -> list[str]:
    """Every member-strictness cell decided, inside a revocation document as
    `malformed` and elsewhere as `invalid_arguments`."""
    out = []
    seen: dict[tuple, list] = {}
    for case, g in outcomes:
        cell = ms_cell(case, T)
        if cell is not None:
            seen.setdefault(cell, []).append(g)
    for form in MS_FORMS:
        for loc in MS_LOCATIONS:
            want = (RV, "malformed", 0) if loc == "document" else ("step", "form")
            if not any(g["decided"] == want for g in seen.get((form, loc), [])):
                out.append(f"member strictness {form} in {loc} answered by {row_name(want)}")
    return out


def row_name(row: tuple) -> str:
    if row[0] == "step":
        return f"step {row[1]}"
    return f"{row[0]} {row[1]}" + (f"#{row[2] + 1}" if row[2] else "")


def admitted(ctx: dict) -> bool:
    peer, operator = ctx["peer_uid"], ctx["operator_uid"]
    return peer is not None and (peer == 0 or peer == operator)


def dup_depth(case: dict) -> str | None:
    raw, _ = frame(case)
    try:
        obj = parse_request(raw)
    except ValueError:
        return None
    if isinstance(obj, Obj) and obj.twice:
        return "top"
    return "nested" if twice_anywhere(obj) else None


def case_variant(case: dict) -> bool:
    req = request_of(case)
    if not isinstance(req, dict):
        return False
    accepted = {m for ms in (RECONCILE_MEMBERS, COMMISSION_MEMBERS, ("operation",)) for m in ms}
    return any(k not in accepted and k.lower() in accepted for k in req)


def coverage(T: dict, corpus: dict, outcomes: list) -> None:
    bound = T["bound"]
    answered = {got.get("code") for _, got in outcomes if not got["ok"]}
    for code in corpus["codes"]:
        need(code in answered, f"no case is answered `{code}`")
    accepted = {got["op"] for _, got in outcomes if got["ok"]}
    for op in T["registry_ops"]:
        need(op in accepted, f"no case accepts {op}")

    missing: list[str] = []

    def exists(pred: Callable[[dict, dict], bool], what: str) -> None:
        if not any(pred(case, got) for case, got in outcomes):
            missing.append(what)

    def size(c: dict) -> int:
        return len(frame(c)[0])

    def ctx(c: dict) -> dict:
        return c["context"]

    def raw(c: dict) -> bytes:
        return c["request"].encode("utf-8")

    exists(lambda c, g: size(c) == bound and g.get("code") != "payload_too_large",
           "a request of exactly the bound parsed")
    exists(lambda c, g: size(c) == bound + 1 and g.get("code") == "payload_too_large",
           "a request one byte over the bound refused")
    exists(lambda c, g: size(c) == bound and g["ok"] and g["op"] == "approver_registry_revoke",
           "a revocation of exactly the bound applied")
    exists(lambda c, g: size(c) > bound and len(frame(c)[0].decode("utf-8")) <= bound and
           g.get("code") == "payload_too_large", "the bound counted in bytes, not characters")
    exists(lambda c, g: size(c) > bound and op_of(c) is None, "an unparseable oversized request")
    exists(lambda c, g: size(c) > bound and not admitted(ctx(c)), "the bound before the caller")
    exists(lambda c, g: size(c) > bound and ctx(c)["registry_operation_in_flight"] and
           admitted(ctx(c)), "the bound before serialisation")
    exists(lambda c, g: size(c) > bound and str(op_of(c)) in ("reconcile_tier_c",
                                                               "evidence_commission"),
           "the bound on a v2 operation")
    exists(lambda c, g: b"\n" in raw(c) and g.get("code") == "invalid_arguments",
           "an LF inside the JSON text cutting the request")
    exists(lambda c, g: b"\n" in raw(c) and g["ok"], "bytes after the first LF ignored")
    exists(lambda c, g: not c["terminated"] and b"\n" not in raw(c) and
           g.get("code") == "invalid_arguments" and op_of({**c, "terminated": True}) is not None,
           "a whole object with no LF before the connection ends")
    exists(lambda c, g: g.get("code") == "invalid_arguments" and dup_depth(c) == "nested",
           "a member named twice only inside a nested object")
    exists(lambda c, g: g.get("code") == "invalid_arguments" and dup_depth(c) == "top",
           "a member named twice at the top level")
    exists(lambda c, g: g.get("code") == "invalid_arguments" and case_variant(c),
           "a member differing from an accepted name only in case")
    exists(lambda c, g: g.get("code") == "invalid_arguments" and not admitted(ctx(c)),
           "members decided before the caller")
    exists(lambda c, g: g.get("code") == "invalid_arguments" and
           ctx(c)["registry_operation_in_flight"], "members decided before serialisation")
    exists(lambda c, g: g.get("code") == "unauthenticated" and ctx(c)["registry_operation_in_flight"],
           "the caller decided before serialisation")
    exists(lambda c, g: g.get("code") == "unauthenticated" and ctx(c)["peer_uid"] is None,
           "a connection without peer credentials")
    exists(lambda c, g: g["ok"] and ctx(c)["operator_uid"] is None and ctx(c)["peer_uid"] == 0,
           "root admitted with no installed operator")
    exists(lambda c, g: g.get("code") == "unauthenticated" and ctx(c)["operator_uid"] is None and
           ctx(c)["peer_uid"] not in (None, 0), "only root admitted with no installed operator")
    exists(lambda c, g: g.get("code") == "registry_busy" and not ctx(c)["verified_site_id"],
           "serialisation decided before the verified site")
    exists(lambda c, g: g["where"] == ("step", "site") and not g["presents"],
           "an operation presenting no challenge refused for no verified site")
    exists(lambda c, g: g["where"] == ("step", "site") and ctx(c)["registry"] is not None and
           ctx(c)["registry"]["site_id"] != ctx(c)["verified_site_id"] and g["presents"],
           "no verified site decided before site_binding_mismatch")
    exists(lambda c, g: g["where"] == ("step", "site") and ctx(c)["registry"] is not None and
           ctx(c)["registry"]["device_id"] != ctx(c)["device_id"] and g["presents"],
           "no verified site decided before device_binding_mismatch")
    exists(lambda c, g: g.get("code") == "registry_busy" and ctx(c)["registry"] is not None and
           ctx(c)["registry"]["device_id"] != ctx(c)["device_id"],
           "serialisation decided before device_binding_mismatch")
    # The device ID's form at its bound: 128 characters, where a site ID stops at 64.
    def doc_device(c: dict) -> Any:
        req = request_of(c)
        doc = req.get("document") if isinstance(req, dict) else None
        return doc.get("device_id") if isinstance(doc, dict) else None
    exists(lambda c, g: g["ok"] and isinstance(doc_device(c), str) and len(doc_device(c)) == 128,
           "a revocation naming a 128-character device_id applied")
    exists(lambda c, g: g.get("code") == "malformed" and isinstance(doc_device(c), str) and
           len(doc_device(c)) == 129 and is_device_id(doc_device(c)[:128]),
           "a revocation naming a 129-character device_id malformed")
    def doc_site(c: dict) -> Any:
        req = request_of(c)
        doc = req.get("document") if isinstance(req, dict) else None
        return doc.get("site_id") if isinstance(doc, dict) else None
    exists(lambda c, g: g.get("code") == "malformed" and isinstance(doc_site(c), str) and
           len(doc_site(c)) == 65 and is_id(doc_site(c)[:64]) and is_device_id(doc_device(c)),
           "a revocation naming a 65-character site_id malformed")
    for op in ("approver_registry_binding", "approver_registry_challenge"):
        exists(lambda c, g, op=op: g["ok"] and g["op"] == op and len(ctx(c)["device_id"]) == 128,
               f"{op} answered under a 128-character device identity")
    exists(lambda c, g: g.get("code") == "registry_busy" and g.get("presents") and
           g.get("consumes_challenge") is False, "registry_busy consuming no challenge")
    exists(lambda c, g: g.get("code") == "unauthenticated" and op_of(c) in PRESENTING,
           "an unadmitted presentation consuming no challenge")
    exists(lambda c, g: g.get("where") is not None and g["where"][0] == "Challenge" and
           g["code"] != "channel_unauthenticated" and op_of(c) == "approver_registry_challenge"
           and (request_of(c).get("candidate") or {}).get("channel") == "whatsapp",
           "a whatsapp candidate refused by an earlier check than channel_unauthenticated")
    exists(lambda c, g: g.get("code") == "malformed" and dup_depth(c) == "nested",
           "a member named twice inside a revocation document answered malformed")
    exists(lambda c, g: nesting(frame(c)[0].decode("utf-8")) == MAX_DEPTH and
           g.get("code") != "invalid_arguments", "nesting of exactly 32 levels parsed")
    exists(lambda c, g: nesting(frame(c)[0].decode("utf-8")) == MAX_DEPTH + 1 and
           g.get("code") == "invalid_arguments", "nesting of 33 levels refused")
    exists(lambda c, g: re.search(r"\\u[dD][89a-fA-F]", c["request"]) is not None and
           g.get("code") == "invalid_arguments", "a string with no UTF-8 form refused")
    exists(lambda c, g: "\\u" in c["request"].split(":", 1)[0] and g["ok"],
           "a member name compared after unescaping")
    # Each Enrol authoriser row is answered on both authoriser paths: an
    # authorization object (LAN) and an attributed ORI-ENROL-V1 text (phone);
    # authorizer_not_approver also for both a LAN and a phone candidate. The
    # authorization's signature_invalid row exists on the LAN path alone: a phone
    # text carries no signature.
    def enrol_case(c: dict, g: dict, code: str) -> dict | None:
        req = request_of(c)
        if g.get("code") == code and g["where"][0] == "Enrol" and isinstance(req, dict):
            return req
        return None
    for code in ("authorizer_unavailable", "authorizer_not_preexisting",
                 "authorizer_not_approver"):
        for path, is_path in (("an authorization object", lambda r: r["authorization"] is not None),
                              ("an ORI-ENROL-V1 text", lambda r: r["authorization"] is None)):
            exists(lambda c, g, code=code, is_path=is_path:
                   (r := enrol_case(c, g, code)) is not None and is_path(r),
                   f"{code} on the authoriser path of {path}")
    for kind, is_kind in (("LAN", lambda r: r["candidate"]["channel"] == "lan_ed25519"),
                          ("phone", lambda r: r["candidate"]["channel"] in PHONE)):
        exists(lambda c, g, is_kind=is_kind:
               (r := enrol_case(c, g, "authorizer_not_approver")) is not None and is_kind(r),
               f"authorizer_not_approver for a {kind} candidate")
    # The enrolment matrix: every cell present once, its name the cell its request
    # and context are (its answer is the model's, as for every case).
    cells: dict[tuple, str] = {}
    for c, g in outcomes:
        if not c["name"].startswith("m_"):
            continue
        need(g["op"] == "approver_registry_enrol" and g["form_cell"] is not None,
             f"{c['name']}: a matrix case is not an Enrol request reaching the authoriser")
        named = tuple(c["name"][2:].split("_"))
        need(named == g["form_cell"], f"{c['name']}: its request and context are the cell "
             f"{'_'.join(g['form_cell'])}, not the one it is named for")
        need(named not in cells, f"{c['name']}: the matrix cell repeats {cells.get(named)}")
        cells[named] = c["name"]
    for cell in ((p, k, w) for p in MATRIX_AXES[0] for k in MATRIX_AXES[1]
                 for w in MATRIX_AXES[2]):
        if cell not in cells:
            missing.append(f"the enrolment matrix cell m_{'_'.join(cell)}")
    # The authoriser eligibility block, likewise: each cell present once, named for
    # the authoriser path and condition its request and context are.
    elig: dict[tuple, str] = {}
    for c, g in outcomes:
        if not c["name"].startswith("e_"):
            continue
        need(g["op"] == "approver_registry_enrol" and g["elig_cell"] is not None,
             f"{c['name']}: an eligibility case is not an Enrol request reaching the authoriser")
        named = tuple(c["name"][2:].split("_", 1))
        need(named == g["elig_cell"], f"{c['name']}: its request and context are the cell "
             f"{'_'.join(g['elig_cell'])}, not the one it is named for")
        need(named not in elig, f"{c['name']}: the eligibility cell repeats {elig.get(named)}")
        elig[named] = c["name"]
    for cell in ((p, k) for p in ELIGIBILITY_AXES[0] for k in ELIGIBILITY_AXES[1]):
        if cell not in elig:
            missing.append(f"the eligibility cell e_{'_'.join(cell)}")
    missing += reach_law(reachable_joint(T), outcomes)
    missing += member_strictness(T, outcomes)
    for kind in ("lan", "sms"):
        exists(lambda c, g, kind=kind: g["ok"] and g["op"] == "approver_registry_challenge" and
               request_of(c)["challenge_operation"] == "enrol" and
               isinstance(request_of(c)["candidate"]["approver_id"], str) and
               (request_of(c)["candidate"]["channel"] == "lan_ed25519") == (kind == "lan"),
               f"an enrol challenge for an existing approver with a {kind} candidate accepted")
    for channel in PHONE:
        exists(lambda c, g, channel=channel: g.get("code") == "lan_key_required" and
               request_of(c)["candidate"]["channel"] == channel,
               f"lan_key_required for a {channel} candidate")
    need(not missing, "no case shows: " + "; ".join(missing))


# ------------------------------------------------------------ mutations

def text_mutants(text: str) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []

    def raw_pattern(sentence: str) -> str:
        return r"\s+".join(re.escape(w) for w in sentence.split())

    for where, sentences in [(k, v) for k, v in HELD.items()] + [("v3", HELD_V3_ELSEWHERE)]:
        for sentence in sentences:
            pat = raw_pattern(sentence)
            if not re.search(pat, text):
                raise Failure(f"mutation setup: held sentence not found raw: {sentence[:60]}")
            out.append((f"drop sentence ({where}): {sentence[:50]}",
                        re.sub(pat, "", text, count=1)))
            words = sentence.split()
            out.append((f"drop last word ({where}): {sentence[:50]}",
                        re.sub(pat, lambda _, w=words: " ".join(w[:-1]), text, count=1)))
    lines = text.split("\n")
    start = lines.index(f"## {SECTION}")
    sub = None
    rows_at: dict[str, list[int]] = {}
    for i in range(start, len(lines)):
        if lines[i].startswith("## ") and i != start:
            break
        if lines[i].startswith("### "):
            sub = lines[i][4:]
        if sub in TABLED and re.fullmatch(r"\| `[a-z_]+` \| .+ \|", lines[i]):
            rows_at.setdefault(sub, []).append(i)
    for sub_name, idx in rows_at.items():
        for x in range(len(idx)):
            for y in range(x + 1, len(idx)):
                # row y moved to just before row x: the pair's order reversed
                a, b = idx[x], idx[y]
                m = lines[:a] + [lines[b]] + [lines[i] for i in range(a, b)] + lines[b + 1:]
                ca = re.match(r"\| `([a-z_]+)`", lines[a]).group(1)
                cb = re.match(r"\| `([a-z_]+)`", lines[b]).group(1)
                out.append((f"swap rows {sub_name}: {ca}@{x} / {cb}@{y}", "\n".join(m)))
        for i in idx:
            m = lines[:]
            del m[i]
            out.append((f"drop row {sub_name}: {lines[i][:40]}", "\n".join(m)))
            m = lines[:]
            m[i] = m[i][:-2].rsplit(" ", 1)[0] + " |"
            out.append((f"drop row's last word {sub_name}: {lines[i][:40]}", "\n".join(m)))
    order = [i for i in range(start, len(lines)) if re.fullmatch(r"\d\. .+", lines[i])][:6]
    for n in range(len(order) - 1):
        m = lines[:]
        a, b = order[n], order[n + 1]
        ta, tb = re.sub(r"^\d\. ", "", m[a]), re.sub(r"^\d\. ", "", m[b])
        if not tb.endswith(";"):
            ta, tb = ta.rstrip(";") + ".", tb.rstrip(".") + ";"
        m[a], m[b] = f"{n + 1}. {tb}", f"{n + 2}. {ta}"
        out.append((f"swap refusal order {n + 1}/{n + 2}", "\n".join(m)))
    sec_start = text.index(f"## {SECTION}")
    sec_end = text.index("\n## ", sec_start + 3)
    for delta in (-1, 1):
        n = f"{16384 + delta:,}"
        out.append((f"bound {n}", text[:sec_start] +
                    text[sec_start:sec_end].replace("16,384", n) + text[sec_end:]))
    codes_at = re.search(r"the list is\s+closed:", text[sec_start:]).start() + sec_start
    codes_end = text.index("An unexpected runtime fault", codes_at)
    for code in re.findall(r"`([a-z_]+)`", text[codes_at:codes_end]):
        part = re.sub(rf"`{code}`,\s+|`{code}`\s+and\s+|,?\s+and\s+`{code}`", "",
                      text[codes_at:codes_end], count=1)
        need(part != text[codes_at:codes_end], f"mutation setup: cannot drop {code}")
        out.append((f"drop code {code}", text[:codes_at] + part + text[codes_end:]))
    out.append(("add code", text[:codes_at] + text[codes_at:codes_end].replace(
        "`payload_too_large`", "`payload_too_large`, `bogus_code`", 1) + text[codes_end:]))
    consume = re.search(r"A request refused at or before `challenge_unavailable` consumes "
                        r"nothing\. From\s+`challenge_expired` on", text)
    need(consume is not None, "mutation setup: consumption sentence not found raw")
    span = consume.group(0)
    out.append(("consumption boundary one earlier", text.replace(span, span.replace(
        "`challenge_unavailable`", "`challenge_reused`").replace("`challenge_expired`",
                                                                  "`challenge_unavailable`"))))
    out.append(("consumption boundary one later", text.replace(span, span.replace(
        "`challenge_expired`", "`candidate_changed`").replace("`challenge_unavailable`",
                                                               "`challenge_expired`"))))
    for sentence, new in (
            ("Members: exactly `operation` (`approver_registry_recover`) and `challenge_id`.",
             "Members: exactly `operation` (`approver_registry_recover`), `challenge_id` and "
             "`note`."),
            ("Members: exactly `operation` (`approver_registry_binding`).",
             "Members: exactly `operation` (`approver_registry_binding`) and `device_id`."),
            ("Members: exactly `operation` (`approver_registry_revoke`) and `document`",
             "Members: exactly `operation` (`approver_registry_revoke`)"),
            ("`challenge_operation`: `recover`, `local_seed` or `enrol`;",
             "`challenge_operation`: `recover`, `local_seed`, `enrol` or `revoke`;")):
        pat = raw_pattern(sentence)
        need(re.search(pat, text) is not None, f"mutation setup: {sentence} not found")
        out.append((f"members: {new[:60]}", re.sub(pat, lambda _, n=new: n, text, count=1)))
    # The ninth and tenth operations the socket accepts, defined outside the registry:
    # dropping either, or admitting any operation outside the table, changes which
    # requests are refused.
    ops_now = "eight operations below, `runtime_device_key` or `report_key_enrolment_proof`,"
    for label, old_ops, new_ops in (
            ("operations: runtime_device_key no longer accepted",
             ops_now, "eight operations below or `report_key_enrolment_proof`,"),
            ("operations: report_key_enrolment_proof no longer accepted",
             ops_now, "eight operations below or `runtime_device_key`,"),
            ("operations: another operation accepted",
             ops_now,
             "eight operations below, `runtime_device_key`, `report_key_enrolment_proof` or "
             "`runtime_device_reset`,")):
        pat = raw_pattern(old_ops)
        need(re.search(pat, text) is not None, f"mutation setup: {old_ops} not found")
        out.append((label, re.sub(pat, lambda _, n=new_ops: n, text, count=1)))
    return out


DEFECTS = (
    "bound_minus_one", "bound_plus_one", "lf_counted", "chars_not_bytes", "parse_before_bound",
    "lf_inside_accepted", "after_lf_not_ignored", "eof_accepted",
    "dup_top_level_only", "dup_ignored", "case_insensitive_members", "null_peer_admitted",
