# ------------------------------------------------------------ Ed25519 (stdlib)

P = 2 ** 255 - 19
L = 2 ** 252 + 27742317777372353535851937790883648493
CURVE_D = (-121665 * pow(121666, P - 2, P)) % P
SQRT_M1 = pow(2, (P - 1) // 4, P)
IDENTITY = (0, 1, 1, 0)


def _add(a: tuple, b: tuple) -> tuple:
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    pa = (y1 - x1) * (y2 - x2) % P
    pb = (y1 + x1) * (y2 + x2) % P
    pc = 2 * t1 * t2 * CURVE_D % P
    pd = 2 * z1 * z2 % P
    e, f, g, h = pb - pa, pd - pc, pd + pc, pb + pa
    return (e * f % P, g * h % P, f * g % P, e * h % P)


def _mul(scalar: int, point: tuple) -> tuple:
    result = IDENTITY
    while scalar:
        if scalar & 1:
            result = _add(result, point)
        point = _add(point, point)
        scalar >>= 1
    return result


def _is_identity(point: tuple) -> bool:
    x, y, z, _ = point
    return x % P == 0 and (y - z) % P == 0


def _decode(raw: bytes) -> tuple[tuple | None, str | None]:
    n = int.from_bytes(raw, "little")
    sign, y = n >> 255, n & ((1 << 255) - 1)
    if y >= P:
        return None, "non_canonical"
    x2 = (y * y - 1) * pow(CURVE_D * y * y + 1, P - 2, P) % P
    x = pow(x2, (P + 3) // 8, P)
    if (x * x - x2) % P:
        x = x * SQRT_M1 % P
    if (x * x - x2) % P:
        return None, "off_curve"
    if x == 0 and sign:
        return None, "invalid_sign"
    if x & 1 != sign:
        x = P - x
    return (x, y, 1, x * y % P), None


def _encode(point: tuple) -> bytes:
    x, y, z, _ = point
    zi = pow(z, P - 2, P)
    x, y = x * zi % P, y * zi % P
    return (y | ((x & 1) << 255)).to_bytes(32, "little")


BASE = _decode((4 * pow(5, P - 2, P) % P).to_bytes(32, "little"))[0]


@functools.cache
def key_admitted(key: bytes) -> bool:
    """ed25519-key-admission/v1: none of its five clauses holds."""
    if len(key) != 32:
        return False
    point, _ = _decode(key)
    if point is None or _is_identity(_mul(8, point)):
        return False
    return _is_identity(_mul(L, point))


def _equation(key: bytes, message: bytes, signature: bytes) -> bool:
    point, _ = _decode(key)
    if point is None:
        return False
    r, s = signature[:32], int.from_bytes(signature[32:], "little")
    if s >= L or _decode(r)[0] is None:
        return False
    k = int.from_bytes(hashlib.sha512(r + key + message).digest(), "little")
    ka = _mul(k, point)
    return _encode(_add(_mul(s, BASE), ((-ka[0]) % P, ka[1], ka[2], (-ka[3]) % P))) == r


@functools.cache
def verify(key: bytes, message: bytes, signature: bytes) -> bool:
    """ed25519-verification/v1 with the full 512-bit k and a byte compare of R."""
    return len(signature) == 64 and key_admitted(key) and _equation(key, message, signature)


@functools.cache
def verify_unadmitted(key: bytes, message: bytes, signature: bytes) -> bool:
    """The equation without the key admission clause (a planted defect)."""
    return len(signature) == 64 and len(key) == 32 and _equation(key, message, signature)


def identity(key: bytes) -> bytes:
    """ed25519-key-admission/v1 Recognising a key: the 32 bytes with bit 255 cleared."""
    return key[:31] + bytes([key[31] & 0x7F])


# ------------------------------------------------------------ forms and JSON

def canon_b64(value: Any, size: int) -> bytes | None:
    """The bytes of canonical padded RFC 4648 Base64 of `size` bytes, else None."""
    if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9+/]*={0,2}", value):
        return None
    try:
        raw = base64.b64decode(value, validate=True)
    except ValueError:
        return None
    if len(raw) != size or base64.b64encode(raw).decode("ascii") != value:
        return None
    return raw


def lan_key(value: Any) -> bytes | None:
    if isinstance(value, str) and value.startswith("ed25519:"):
        return canon_b64(value[8:], 32)
    return None


def is_id(value: Any) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,64}", value) is not None


def is_device_id(value: Any) -> bool:
    """A device ID: "`device_id` matches `^[A-Za-z0-9._-]{1,128}$`, as runtime-config/v2
    defines `device.id`" (a site ID stays at 64)."""
    return isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9._-]{1,128}", value) is not None


def is_value(channel: Any, value: Any) -> bool:
    if not isinstance(value, str):
        return False
    if channel in PHONE:
        return re.fullmatch(r"\+[1-9][0-9]{1,14}", value) is not None
    if channel == "lan_ed25519":
        return lan_key(value) is not None
    return False


def is_v(value: Any) -> bool:
    return type(value) is int and value == 1


def is_digest(value: Any) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None


def json_text(value: str) -> str:
    out = ['"']
    escapes = {'"': '\\"', "\\": "\\\\", "\n": "\\n", "\r": "\\r", "\t": "\\t",
               "\b": "\\b", "\f": "\\f"}
    for ch in value:
        if ch in escapes:
            out.append(escapes[ch])
        elif ord(ch) < 0x20:
            out.append(f"\\u{ord(ch):04x}")
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def profile2(value: Any) -> bytes:
    """Profile 2 canonical JSON (signing/v2): sorted keys, compact, UTF-8, unescaped."""
    def enc(v: Any) -> str:
        if v is None:
            return "null"
        if v is True:
            return "true"
        if v is False:
            return "false"
        if type(v) is int:
            return str(v)
        if isinstance(v, NonInteger):
            raise Failure(f"a number with a fraction or exponent has no Profile 2 form: {v!r}")
        if isinstance(v, str):
            return json_text(v)
        if isinstance(v, list):
            return "[" + ",".join(enc(i) for i in v) + "]"
        if isinstance(v, dict):
            return "{" + ",".join(json_text(k) + ":" + enc(v[k]) for k in sorted(v)) + "}"
        raise Failure(f"value outside Profile 2: {v!r}")
    try:
        return enc(value).encode("utf-8")
    except UnicodeEncodeError:
        raise Failure("a string with no UTF-8 form has no Profile 2 bytes") from None


class NonInteger:
    """A JSON number written with a fraction or an exponent (`1.0`, `1e0`): its own
    token type, neither an integer nor a string, never equal to either."""
    __slots__ = ("text",)

    def __init__(self, text: str):
        self.text = text

    def __repr__(self) -> str:
        return f"NonInteger({self.text})"


MAX_SAFE = 2 ** 53 - 1


class Obj(dict):
    """A parsed JSON object that remembers whether a member was named twice in it,
    and whether any of its members, a shadowed duplicate included, holds a string
    with no UTF-8 form."""
    twice = False
    no_utf8 = False


def _no_utf8(value: Any) -> bool:
    """A string with no UTF-8 form in this value; an object reports its own flag,
    already taken over every member it was given."""
    stack = [value]
    while stack:
        v = stack.pop()
        if isinstance(v, str):
            try:
                v.encode("utf-8")
            except UnicodeEncodeError:
                return True
        elif isinstance(v, Obj):
            if v.no_utf8:
                return True
        elif isinstance(v, list):
            stack.extend(v)
    return False


def _pairs(pairs: list) -> Obj:
    obj = Obj(pairs)
    obj.twice = len(obj) != len(pairs)
    # Every member is validated as given, before a later duplicate shadows it.
    obj.no_utf8 = any(_no_utf8(k) or _no_utf8(v) for k, v in pairs)
    return obj


def _shown_pairs(pairs: list) -> Obj:
    """A planted defect: only the members that survive duplication are validated."""
    obj = Obj(pairs)
    obj.twice = len(obj) != len(pairs)
    obj.no_utf8 = any(_no_utf8(k) or _no_utf8(v) for k, v in obj.items())
    return obj


def _integer(text: str) -> int:
    """A JSON integer token, however many digits: the text's limits are its own
    (2^53 − 1 for revisions), not the parser's."""
    return int(text)


def _no_constant(name: str) -> Any:
    raise ValueError(f"{name} is not JSON")


def _nodes(value: Any) -> list[Any]:
    """Every value inside `value`, itself included, without recursion."""
    out, stack = [], [value]
    while stack:
        v = stack.pop()
        out.append(v)
        if isinstance(v, dict):
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(v)
    return out


def twice_anywhere(value: Any) -> bool:
    return any(isinstance(v, Obj) and v.twice for v in _nodes(value))


def plain(value: Any) -> Any:
    """`value` with every Obj made a dict (depth is bounded at parse, so recursion is too)."""
    if isinstance(value, dict):
        return {k: plain(v) for k, v in value.items()}
    if isinstance(value, list):
        return [plain(v) for v in value]
    return value


MAX_DEPTH = 32


def nesting(text: str) -> int:
    """The deepest object or array nesting of JSON text, the outermost being level 1,
    counted without parsing (a scan outside strings)."""
    depth = deepest = 0
    in_string = escaped = False
    for ch in text:
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
        elif ch == '"':
            in_string = True
        elif ch in "{[":
            depth += 1
            deepest = max(deepest, depth)
        elif ch in "}]":
            depth -= 1
    return deepest


def parse_request(raw: bytes, D: frozenset = frozenset()) -> Any:
    """One request's JSON, or ValueError for each parse failure the text names: text
    that is not JSON, a string with no UTF-8 form, nesting deeper than 32 levels."""
    text = raw.decode("utf-8")
    limit = MAX_DEPTH + (1 if "depth_off_by_one" in D else 0)
    if "depth_unbounded" not in D and nesting(text) > limit:
        raise ValueError("nesting deeper than 32 levels")
    if "fraction_accepted" in D:
        as_float: Callable[[str], Any] = lambda t: int(float(t)) if float(t).is_integer() \
            else float(t)
    elif "noninteger_as_string" in D:
        as_float = str
    else:
        as_float = NonInteger
    if "int_digit_limit" in D:
        def as_int(t: str) -> int:
            if len(t.lstrip("-")) > 4300:
                raise ValueError("Exceeds the limit (4300 digits) for integer string conversion")
            return int(t)
    else:
        as_int = _integer
    hook = _shown_pairs if "shadowed_unvalidated" in D else _pairs
    obj = json.loads(text, object_pairs_hook=hook, parse_constant=_no_constant,
                     parse_float=as_float, parse_int=as_int)
    if "surrogate_accepted" not in D and _no_utf8(obj):
        raise ValueError("a JSON string with no UTF-8 form")
    return obj


# ------------------------------------------------------------ the text

def subsections(text: str) -> dict[str, list[str]]:
    lines = text.split("\n")
    try:
        start = lines.index(f"## {SECTION}")
    except ValueError:
        raise Failure(f"no '## {SECTION}' heading") from None
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    body = lines[start + 1:end]
    heads = [i for i, line in enumerate(body) if line.startswith("### ")]
    names = tuple(body[i][4:].strip() for i in heads)
    if names != SUBSECTIONS:
        raise Failure(f"subsections changed: {list(names)}")
    out = {"": body[:heads[0]]}
    for n, i in enumerate(heads):
        out[names[n]] = body[i + 1:heads[n + 1] if n + 1 < len(heads) else len(body)]
    return out


def table(lines: list[str], header: str, where: str) -> list[tuple[str, str]]:
    rows = [line for line in lines if line.startswith("|")]
    if len(rows) < 3 or rows[0] != header or rows[1] != "| --- | --- |":
        raise Failure(f"{where}: table changed shape")
    out = []
    for row in rows[2:]:
        m = re.fullmatch(r"\| `([a-z_0-9]+)` \| (.+) \|", row)
        if not m:
            raise Failure(f"{where}: table row unrecognised: {row!r}")
        out.append((m.group(1), m.group(2)))
    return out


def members_sentence(norm: str, where: str) -> tuple[str, ...]:
    m = re.search(r"Members: exactly ((?:`[a-z_]+`(?: \(`[a-z_]+`\))?(?:, | and |\.|$))+)", norm)
    if not m:
        raise Failure(f"{where}: no 'Members: exactly' sentence")
    names = tuple(re.findall(r"`([a-z_]+)`", re.sub(r" \(`[a-z_]+`\)", "", m.group(1))))
    if not names or names[0] != "operation":
        raise Failure(f"{where}: members do not begin with `operation`: {names}")
    return names


STEP_NAMES = {
    "the bound": "bound",
    "the request's form and members": "form",
    "the caller": "caller",
    "another registry operation in flight": "busy",
    "no verified nonempty `device.site_id`": "site",
    "the operation's own checks, in the order its section lists them": "own",
}
STEP_CODES = {"bound": "payload_too_large", "form": "invalid_arguments",
              "caller": "unauthenticated", "busy": "registry_busy",
              "site": "registry_unavailable", "own": None}


def read_text(text: str, approvers: str) -> dict:
    sec = subsections(text)
    norm = {name: flat("\n".join(lines)) for name, lines in sec.items()}
    for name, sentences in HELD.items():
        for sentence in sentences:
            if flat(sentence) not in norm[name]:
                raise Failure(f"v3.md {name}: rule text changed: {sentence!r}")
    whole = flat(text)
    for sentence in HELD_V3_ELSEWHERE:
        if flat(sentence) not in whole:
            raise Failure(f"v3.md: rule text changed: {sentence!r}")
    appr = flat(approvers)
    for sentence in HELD_APPROVERS:
        if flat(sentence) not in appr:
            raise Failure(f"tier-c-approvers/v1.md: rule text changed: {sentence!r}")
    domains = {}
    for name, pattern in DOMAIN_SENTENCES.items():
        m = re.search(pattern, appr)
        if not m:
            raise Failure(f"tier-c-approvers/v1.md: the {name} preimage sentence changed")
        domains[name] = m.group(1).encode("ascii")

    req = norm["Requests on the socket"]
    m = re.search(r"\*\*The bound\.\*\* A request is at most ([0-9][0-9,]*) bytes, not counting "
                  r"its LF\.", req)
    if not m:
        raise Failure("the bound sentence changed")
    bound_text = m.group(1)
    bound = int(bound_text.replace(",", ""))
    if f"A request of exactly {bound_text} bytes is parsed." not in req:
        raise Failure("'A request of exactly <bound> bytes is parsed.' does not state the bound")
    for row_text in re.findall(r"exceeds the ([0-9,]+)-byte bound of \[Requests on the socket\]",
                               flat(text)):
        if row_text != bound_text:
            raise Failure(f"a v2 operation's payload_too_large row names {row_text}, not the bound")

    ops = [code for code, _ in table(sec["Requests on the socket"], "| `operation` | Defined by |",
                                     "operations")]
    if len(ops) != 8 or "eight operations" not in req:
        raise Failure(f"the operation table no longer lists eight operations: {ops}")
    registry_ops = [op for op in ops if op.startswith("approver_registry_")]
    if len(registry_ops) != 6:
        raise Failure("the six registry operations changed")

    steps = []
    for line in sec["Order of refusal"]:
        m = re.fullmatch(r"(\d)\. (.+?)(?:: `([a-z_]+)`;|\.)", line)
        if m:
            if int(m.group(1)) != len(steps) + 1 or m.group(2) not in STEP_NAMES:
                raise Failure(f"order of refusal item unrecognised: {line!r}")
            steps.append((STEP_NAMES[m.group(2)], m.group(3)))
    if sorted(s for s, _ in steps) != sorted(STEP_CODES) or \
            any(STEP_CODES[s] != c for s, c in steps):
        raise Failure(f"order of refusal changed: {steps}")
    m = re.search(r"((?:`[a-z_]+`(?:, | and ))+`[a-z_]+`) are operational outcomes with the "
                  r"meanings they have under \[Tier C Reconciliation\]\(#tier-c-reconciliation\), "
                  r"returned only to an admitted caller; none of them commits a registry change\.",
                  norm["Order of refusal"])
    if not m:
        raise Failure("the operational outcomes sentence changed")
    operational = re.findall(r"`([a-z_]+)`", m.group(1))

    tables = {}
    for name in TABLED:
        tables[name] = table(sec[name], "| `error.code` | Refused when |", name)
    for name, rows in ROWS.items():
        want = sorted((code, cell) for code, cell, _ in rows)
        if sorted(tables[name]) != want:
            have = set(tables[name])
            wanted = {(c, t) for c, t in want}
            changed = [r for r in tables[name] if r not in wanted] + \
                [r for r in want if r not in have]
            raise Failure(f"{name}: refusal table rows changed: {changed}")

    pres = norm["Challenges presented"]
    wm = re.search(r"`challenge_expired` \| The challenge's (\d+)-second deadline has passed\.",
                   "\n".join(sec["Challenges presented"]))
    if not wm:
        raise Failure("the challenge_expired row no longer states its deadline")
    window_ms = int(wm.group(1)) * 1000
    m = re.search(r"A request refused at or before `([a-z_]+)` consumes nothing\. From `([a-z_]+)` "
                  r"on, the challenge is used whether the operation commits or is refused", pres)
    if not m:
        raise Failure("the consumption sentence changed")
    pcodes = [code for code, _ in tables["Challenges presented"]]
    if m.group(1) not in pcodes or m.group(2) not in pcodes or \
            pcodes.index(m.group(2)) != pcodes.index(m.group(1)) + 1:
        raise Failure("the consumption boundary does not split the presented checks in two")
    consume_from = pcodes.index(m.group(2))

    members = {"reconcile_tier_c": RECONCILE_MEMBERS, "evidence_commission": COMMISSION_MEMBERS}
    for op, where in (("approver_registry_recover", "Recover"),
                      ("approver_registry_local_seed", "Local seed"),
                      ("approver_registry_enrol", "Enrol"),
                      ("approver_registry_revoke", "Revoke"),
                      ("approver_registry_binding", "Binding")):
        members[op] = members_sentence(norm[where], where)
    challenge_members = []
    for line in sec["Challenge"]:
        mm = re.match(r"- `([a-z_]+)`: ", line)
        if mm:
            challenge_members.append(mm.group(1))
    if "Its members are exactly:" not in norm["Challenge"] or not challenge_members:
        raise Failure("Challenge: the member list changed")
    members["approver_registry_challenge"] = tuple(challenge_members)
    if set(members) != set(ops):
        raise Failure("an operation has no member list")
    cm = re.search(r"`challenge_operation`: ((?:`[a-z_]+`(?:, | or ))+`[a-z_]+`);",
                   norm["Challenge"])
    challenge_ops = tuple(re.findall(r"`([a-z_]+)`", cm.group(1))) if cm else ()

    m = re.search(r"The registry operations answer only these `error\.code` values; the list is "
                  r"closed: (.+?)\. An unexpected runtime fault is `internal_error`, which commits "
                  r"nothing\.", norm["Codes"])
    if not m:
        raise Failure("the closed code list sentence changed")
    closed = re.findall(r"`([a-z_]+)`", m.group(1))
    if len(set(closed)) != len(closed):
        raise Failure("the closed code list repeats a code")
    named = {c for _, c in steps if c} | set(operational) | \
        {code for rows in tables.values() for code, _ in rows}
    if set(closed) != named:
        raise Failure(f"closed list and the codes the section names differ: "
                      f"unlisted {sorted(named - set(closed))}, unused {sorted(set(closed) - named)}")
    return {"bound": bound, "steps": [s for s, _ in steps], "tables": tables, "ops": ops,
            "registry_ops": registry_ops, "members": members, "challenge_ops": challenge_ops,
            "closed": closed, "operational": operational, "consume_from": consume_from,
            "window_ms": window_ms,
            "domains": domains}


# ------------------------------------------------------------ the model

class Refused(Exception):
    def __init__(self, code: str, where: tuple):
        super().__init__(code)
        self.code, self.where = code, where


class NotModelled(Exception):
    pass


def world_of(ctx: dict) -> dict:
    """The state a case runs against, copied from its context, and what it may write."""
    return {"registry": copy.deepcopy(ctx["registry"]),
            "challenges": copy.deepcopy(ctx["challenges"]),
            "pending_phone_values": list(ctx["pending_phone_values"]),
            "phone_authorizations": copy.deepcopy(ctx["phone_authorizations"]),
            "registry_operation_in_flight": ctx["registry_operation_in_flight"],
            "codes_sent": [], "used_now": []}


class State:
    def __init__(self, case: dict, text: dict, defects: frozenset):
        self.case, self.T, self.D = case, text, defects
        self.ctx = case["context"]
        self.reg = self.ctx["registry"]
        self.world = world_of(self.ctx)
        self.req: dict | None = None
        self.op: str | None = None
        self.ch: dict | None = None      # the held challenge entry
        self.form_ok = False
        self.raw_document: Any = None

    def active(self) -> list[dict]:
        return self.reg["credentials"] if self.reg else []

    def cred(self, cid: Any) -> dict | None:
        return next((c for c in self.active() if c["credential_id"] == cid), None)

    def challenge(self) -> dict:
        return self.ch["challenge"]

    def challenge_digest(self) -> str:
        return hashlib.sha256(profile2(self.challenge())).hexdigest()

    def candidate(self) -> dict:
        return self.challenge()["candidates"][0]

    def same_value(self, a: str, b: str, channels: tuple[str, str] | None = None) -> bool:
        """Values recognised as one: a LAN key by identity, a phone value by number."""
        ka, kb = lan_key(a), lan_key(b)
        if ka is not None and kb is not None:
            if "value_compare_bytes" in self.D:
                return ka == kb
            return identity(ka) == identity(kb)
        if channels and "phone_compare_channel" in self.D and channels[0] != channels[1]:
            return False
        return a == b


def frame(case: dict) -> tuple[bytes, bool]:
    """What the runtime reads: the bytes before the first LF, and whether an LF came."""
    raw = case["request"].encode("utf-8")
    if b"\n" in raw:
        return raw[:raw.index(b"\n")], True
    return raw, bool(case["terminated"])


def step_bound(st: State) -> None:
    raw, _ = frame(st.case)
    if "lf_inside_accepted" in st.D:
        raw = st.case["request"].encode("utf-8")
    size = len(raw)
    if "chars_not_bytes" in st.D:
        size = len(raw.decode("utf-8", "replace"))
    if "lf_counted" in st.D:
        size += 1
    bound = st.T["bound"] + (-1 if "bound_minus_one" in st.D else 0) + \
        (1 if "bound_plus_one" in st.D else 0)
    if size > bound:
        raise Refused("payload_too_large", ("step", "bound"))


def step_form(st: State) -> None:
    bad = Refused("invalid_arguments", ("step", "form"))
    raw, complete = frame(st.case)
    full = st.case["request"].encode("utf-8")
    if "lf_inside_accepted" in st.D:
        raw = full.rstrip(b"\n") if full.count(b"\n") else raw
    if "after_lf_not_ignored" in st.D and b"\n" in full and full[full.index(b"\n") + 1:]:
        raise bad
    if not complete and "eof_accepted" not in st.D:
        raise bad
    try:
        obj = parse_request(raw, st.D)
    except (ValueError, RecursionError):
        raise bad from None
    if not isinstance(obj, dict):
        raise bad
    if "dup_ignored" not in st.D:
        # A member named twice in a revocation `document` is the document's fault
        # (`malformed`); anywhere else it refuses the request.
        revocation = obj.get("operation") == "approver_registry_revoke"
        nested = [v for k, v in obj.items()
                  if not (revocation and k == "document" and "doc_dup_invalid_arguments" not in st.D)]
        if obj.twice or ("dup_top_level_only" not in st.D and any(map(twice_anywhere, nested))):
            raise bad
    st.raw_document = obj.get("document")
    req = plain(obj)
    if "case_insensitive_members" in st.D:
        req = {k.lower(): v for k, v in req.items()}
    op = req.get("operation")
    if not isinstance(op, str) or op not in st.T["ops"]:
        raise bad
    if set(req) != set(st.T["members"][op]):
        raise bad
    st.req, st.op = req, op
    if not FORMS[op](st, req):
        raise bad
    st.form_ok = True


def step_caller(st: State) -> None:
    peer, operator = st.ctx["peer_uid"], st.ctx["operator_uid"]
    if "null_peer_admitted" in st.D and peer is None:
        return
    if "operator_none_admits_any" in st.D and operator is None and peer is not None:
        return
    root = peer == 0 and "root_refused" not in st.D
    if peer is None or not (root or (operator is not None and peer == operator)):
        raise Refused("unauthenticated", ("step", "caller"))


def registry_op(st: State) -> bool:
    return st.op is None or st.op in st.T["registry_ops"]


def step_busy(st: State) -> None:
    if "busy_ignored" in st.D:
        return
    if registry_op(st) and st.ctx["registry_operation_in_flight"]:
        raise Refused("registry_busy", ("step", "busy"))


def step_site(st: State) -> None:
    if "site_step_skipped" in st.D:
        return
    if registry_op(st) and not st.ctx["verified_site_id"]:
        raise Refused("registry_unavailable", ("step", "site"))


def run_rows(st: State, name: str) -> None:
    keys = keyed_rows(st.T["tables"][name], name)
    for index, (code, cell) in enumerate(st.T["tables"][name]):
        if PRED[(name, code, cell)](st) and not suppressed(st, keys[index]):
            raise Refused(code, (name, index))


def suppressed(st: State, row: tuple) -> bool:
    """A planted `<row>_<axis>=<value>_only` defect: the row fires only for that value."""
    for defect in st.D:
        if isinstance(defect, tuple) and defect[0] == "only" and defect[1] == row:
            axes = axes_at(st, row)
            if axes.get(defect[2]) != defect[3]:
                return True
    return False


def step_own(st: State) -> dict:
    op = st.op
    if op not in st.T["registry_ops"]:
        raise NotModelled(f"{op} beyond its bound and members")
    if op in PRESENTING:
        st.ch = held_challenge(st)
        run_rows(st, "Challenges presented")
        run_rows(st, PRESENTING[op])
    else:
        if op == "approver_registry_revoke" and "replay_before_anchor" in st.D and \
                p_replay(st):
            return EFFECT[op](st)
        run_rows(st, OWN_TABLE[op])
    return EFFECT[op](st)


def held_challenge(st: State) -> dict | None:
    """The challenge the runtime holds under the presented ID, or None."""
    cid = st.req["challenge_id"]
    return next((c for c in st.world["challenges"] if c["challenge"]["challenge_id"] == cid),
                None)


STEPS: dict[str, Callable[[State], Any]] = {
    "bound": step_bound, "form": step_form, "caller": step_caller, "busy": step_busy,
    "site": step_site, "own": step_own}


def evaluate(case: dict, text: dict, defects: frozenset = frozenset(),
             inject: tuple | None = None) -> dict:
    """The answer the text gives, and the state after it. `inject` is a planted
    forbidden write: (field, where)."""
    st = State(case, text, defects)
    order = list(text["steps"])
    if "parse_before_bound" in defects:
        order.remove("bound")
        order.insert(order.index("form") + 1, "bound")
    pre = copy.deepcopy(st.world)
    out: dict[str, Any]
    try:
        for step in order:
            try:
                result = STEPS[step](st)
            except Refused as refusal:
                if refusal.where[0] == "step" and suppressed(st, refusal.where):
                    continue
                raise
        out = {"ok": True, "result": result, "where": None}
        consumed = True
    except Refused as refusal:
        out = {"ok": False, "code": refusal.code, "where": refusal.where}
        consumed = False
        if refusal.where[0] == "Challenges presented":
            consumed = refusal.where[1] >= text["consume_from"]
        elif refusal.where[0] in PRESENTING.values():
            consumed = True
        if "consume_nothing_on_refusal" in defects:
            consumed = False
        if consumed and st.ch is not None:
            mark_used(st.world, st.ch["challenge"]["challenge_id"])
    out["presents"] = st.form_ok and st.op in PRESENTING
    if out["presents"]:
        out["consumes_challenge"] = consumed
    out["op"] = st.op
    out["form_cell"] = None
    if st.op == "approver_registry_enrol" and st.ch is not None and st.reg is not None and \
            st.ch["challenge"]["candidates"] and authorizing(st) is not None:
        out["form_cell"] = matrix_cell(st)
    out["elig_cell"] = None
    if st.op == "approver_registry_enrol" and st.ch is not None and st.reg is not None and \
            st.ch["challenge"]["candidates"]:
        out["elig_cell"] = authoriser(st)[:2]
    out["row"] = row_key({**out, "op": st.op}, text) if out["ok"] else None
    decided = (OWN_TABLE.get(st.op) or PRESENTING.get(st.op), "accept", 0) if out["ok"] else \
        (out["where"] if out["where"][0] == "step" else
         keyed_rows(text["tables"][out["where"][0]], out["where"][0])[out["where"][1]])
    out["decided"] = decided
    out["axes"] = axes_at(st, decided)
    out["presented"] = st.ch["challenge"]["challenge_id"] if st.ch else None
    if inject and inject[1] == row_key(out, text):
        INJECT[inject[0]](st.world, out)
    out["pre"], out["post"] = pre, st.world
    return out


def row_key(out: dict, text: dict) -> tuple:
    """Where an outcome was decided, stable across reorderings of the text."""
    if out["ok"]:
        return ("ok", out["op"], out["result"].get("status"))
    where = out["where"]
    if where[0] == "step":
        return where
    name, index = where
    return keyed_rows(text["tables"][name], name)[index]


def mark_used(world: dict, challenge_id: str) -> None:
    world["used_now"].append(challenge_id)
    for held in world["challenges"]:
        if held["challenge"]["challenge_id"] == challenge_id:
            held["state"] = "used"


def all_failures(case: dict, text: dict) -> list[str]:
    """Every check that fails for a case, in order (for --explain)."""
    st = State(case, text, frozenset())
    out = []
    for step in text["steps"]:
        if step == "own":
            break
        try:
            STEPS[step](st)
        except Refused as refusal:
            out.append(refusal.code)
            if step == "form":
                return out
    if st.op not in text["registry_ops"]:
        return out
    if st.op in PRESENTING:
        st.ch = held_challenge(st)
        names = ["Challenges presented", PRESENTING[st.op]]
    else:
        names = [OWN_TABLE[st.op]]
    for name in names:
        for code, cell in text["tables"][name]:
            if PRED[(name, code, cell)](st):
                out.append(f"{name}:{code}")
    return out


# ----- forms, per operation (invalid_arguments)

def form_candidate(c: Any) -> bool:
    return isinstance(c, dict) and set(c) == {"approver_id", "credential_id", "channel", "value"} \
        and is_id(c["approver_id"]) and is_id(c["credential_id"]) \
        and c["channel"] in ("sms", "whatsapp", "lan_ed25519") and is_value(c["channel"], c["value"])


def form_signed(o: Any, id_member: str, D: frozenset) -> bool:
    if not isinstance(o, dict) or set(o) != {"v", "challenge_id", "challenge_sha256", id_member,
                                             "signature"}:
        return False
    v_ok = is_v(o["v"]) or ("v_bool_accepted" in D and o["v"] == 1)
    return v_ok and canon_b64(o["challenge_id"], 16) is not None and \
        is_digest(o["challenge_sha256"]) and is_id(o[id_member]) and \
        canon_b64(o["signature"], 64) is not None


def form_challenge(st: State, r: dict) -> bool:
    op, c = r["challenge_operation"], r["candidate"]
    if op not in st.T["challenge_ops"]:
        return False
    if op == "recover":
        return c is None
    want = {"channel", "value"} if op == "local_seed" else {"approver_id", "channel", "value"}
    if not isinstance(c, dict) or set(c) != want:
        return False
    if op == "enrol" and not (c["approver_id"] is None or is_id(c["approver_id"])):
        return False
    return c["channel"] in ("sms", "whatsapp", "lan_ed25519") and is_value(c["channel"], c["value"])


def form_recover(st: State, r: dict) -> bool:
    return canon_b64(r["challenge_id"], 16) is not None


def form_local_seed(st: State, r: dict) -> bool:
    return canon_b64(r["challenge_id"], 16) is not None and form_candidate(r["candidate"]) and \
        form_signed(r["possession"], "candidate_credential_id", st.D)


def form_enrol(st: State, r: dict) -> bool:
    if canon_b64(r["challenge_id"], 16) is None or not form_candidate(r["candidate"]):
        return False
    a, p = r["authorization"], r["possession"]
    if a is not None and not form_signed(a, "authorizer_credential_id", st.D):
        return False
    if r["candidate"]["channel"] == "lan_ed25519":
        return form_signed(p, "candidate_credential_id", st.D)
    return p is None


def form_any(st: State, r: dict) -> bool:
    return True      # a revocation document's own form is `malformed`, below


FORMS = {"approver_registry_challenge": form_challenge, "approver_registry_recover": form_recover,
         "approver_registry_local_seed": form_local_seed, "approver_registry_enrol": form_enrol,
         "approver_registry_revoke": form_any, "approver_registry_binding": form_any,
         "reconcile_tier_c": form_any, "evidence_commission": form_any}


# ----- row predicates

def needing(fn: Callable[[State], bool], *what: str) -> Callable[[State], bool]:
    """A condition that cannot hold without what it reads: a held registry, a held
    challenge, a well-formed document, an authorizing credential."""
    def guarded(st: State) -> bool:
        if "reg" in what and st.reg is None:
            return False
        if "ch" in what and st.ch is None:
            return False
        if "doc" in what and p_malformed(st):
            return False
        if "auth" in what and (st.reg is None or st.ch is None or authorizing(st) is None):
            return False
        return fn(st)
    guarded.__name__ = fn.__name__
    return guarded


def site_differs(st: State) -> bool:
    return st.reg is not None and st.reg["site_id"] != st.ctx["verified_site_id"]


def device_differs(st: State) -> bool:
    """"every registry operation on an initialized registry whose device binding differs
    from the runtime's device identity is refused `device_binding_mismatch`"; "A locked
    registry has neither binding." """
    if st.reg is None:
        return "device_when_locked" in st.D
    return st.reg["device_id"] != st.ctx["device_id"]


def device_row(table: str) -> Callable[[State], bool]:
    """The device binding row of one table; `device_unchecked` drops it everywhere and
    `device_unchecked:<table>` in that table alone."""
    def p_device_differs(st: State) -> bool:
        if "device_unchecked" in st.D or f"device_unchecked:{table}" in st.D:
            return False
        if table == B and "binding_device_from_runtime" in st.D:
            return False
        return device_differs(st)
    return p_device_differs


def ch_op(st: State) -> str:
    return st.req["challenge_operation"]


def ch_candidate(st: State) -> dict | None:
    return st.req["candidate"]


def tombstoned_value(st: State, value: str) -> bool:
    return any(st.same_value(value, t) for t in st.reg["tombstoned_values"])


def active_value(st: State, value: str, channel: str) -> bool:
    return any(st.same_value(value, c["value"], (channel, c["channel"])) for c in st.active())


def approver_active(st: State, aid: str) -> bool:
    return any(c["approver_id"] == aid for c in st.active())


def p_lan_key_required(st):
    return ch_op(st) == "local_seed" and ch_candidate(st)["channel"] != "lan_ed25519"


def p_recovery_not_available_challenge(st):
    return ch_op(st) == "recover" and st.reg is not None


def p_registry_unavailable_challenge(st):
    return ch_op(st) in ("local_seed", "enrol") and st.reg is None


def p_channel_unauthenticated(st):
    if ch_op(st) != "enrol":
        return False
    unauthenticated = set() if "whatsapp_authenticated" in st.D else {"whatsapp"}
    if "sms_unauthenticated" in st.D or ("sms" not in st.ctx["authenticated_phone_channels"]
                                         and "sms_ingress_ignored" not in st.D):
        unauthenticated |= {"sms"}
    return ch_candidate(st)["channel"] in unauthenticated


def p_active_authorizer_exists_challenge(st):
    return ch_op(st) == "local_seed" and bool(st.active())


def p_approver_revoked_challenge(st):
    aid = ch_candidate(st).get("approver_id") if ch_op(st) == "enrol" else None
    return isinstance(aid, str) and aid in st.reg["tombstoned_approvers"]


def p_approver_unknown(st):
    aid = ch_candidate(st).get("approver_id") if ch_op(st) == "enrol" else None
    return isinstance(aid, str) and not approver_active(st, aid) and \
        (st.reg is None or aid not in st.reg["tombstoned_approvers"])


def p_value_tombstoned_challenge(st):
    c = ch_candidate(st)
    if c is None or "challenge_value_checks_skipped" in st.D:
        return False
    return tombstoned_value(st, c["value"])


def p_duplicate_value_challenge(st):
    c = ch_candidate(st)
    if c is None or "challenge_value_checks_skipped" in st.D:
        return False
    return active_value(st, c["value"], c["channel"])


def p_phone_pending_challenge(st):
    c = ch_candidate(st)
    if c is None or "challenge_value_checks_skipped" in st.D:
        return False
    return c["channel"] in PHONE and c["value"] in st.ctx["pending_phone_values"]


def p_reused(st):
    return st.ch is not None and st.ch["state"] == "used"


def p_unavailable(st):
    if "expired_as_unavailable" in st.D and p_expired(st):
        return True
    return st.ch is None


def p_expired(st):
    """Expired: not used, and more than the challenge window since issue, whatever the
    candidate's channel (the phone possession window never extends it)."""
    if st.ch is None or st.ch["state"] == "used":
        return False
    window = st.T["window_ms"]
    if "possession_window_extends_phone" in st.D and \
            st.challenge()["candidates"] and st.candidate()["channel"] in PHONE:
        window = 600_000
    if "expiry_inclusive" in st.D:
        return st.ch["elapsed_ms"] >= window
    return st.ch["elapsed_ms"] > window


def p_candidate_changed(st):
    want = {"approver_registry_recover": "recover", "approver_registry_local_seed": "local_seed",
            "approver_registry_enrol": "enrol"}[st.op]
    if st.challenge()["operation"] != want and "operation_mismatch_unchecked" not in st.D:
        return True
    if want == "recover":
        return False
    given = st.req["candidate"]
    held = st.challenge()["candidates"]
    if "candidate_compare_loose" in st.D:
        return not held or held[0]["credential_id"] != given["credential_id"]
    return len(held) != 1 or profile2(held[0]) != profile2(given)


def p_locked(st):
    return st.reg is None


def p_recovery_not_available(st):
    return st.reg is not None


def p_recover_stale(st):
    if "recover_stale_unchecked" in st.D:
        return False
    ch = st.challenge()
    return ch["device_id"] != st.ctx["device_id"] or ch["site_id"] != st.ctx["verified_site_id"]


def p_stale(st):
    ch = st.challenge()
    revision = st.reg["registry_revision"] != ch["registry_revision"]
    epoch = st.reg["identity_epoch"] != ch["identity_epoch"]
    if "stale_revision_unchecked" in st.D:
        revision = False
    if "stale_epoch_unchecked" in st.D:
        epoch = False
    return revision or epoch


def p_active_exists(st):
    return bool(st.active())


def possession_mismatch(st: State) -> bool:
    p = st.req["possession"]
    digest_differs = p["challenge_sha256"] != st.challenge_digest()
    if "possession_digest_unchecked" in st.D:
        digest_differs = False
    return p["challenge_id"] != st.challenge()["challenge_id"] or digest_differs or \
        p["candidate_credential_id"] != st.candidate()["credential_id"]


def signed_fails(st: State, obj: dict, key_value: str, domain: str) -> bool:
    if "no_signature_check" in st.D:
        return False
    key = lan_key(key_value)
    signature = canon_b64(obj["signature"], 64)
    if key is None or signature is None:
        return True
    unsigned = {k: v for k, v in obj.items() if k != "signature"}
    message = st.T["domains"][domain] + b"\0" + profile2(unsigned)
    if "no_key_admission" in st.D:
        return not verify_unadmitted(key, message, signature)
    return not verify(key, message, signature)


def p_possession_invalid_seed(st):
    return possession_mismatch(st)


def p_signature_invalid_seed(st):
    return signed_fails(st, st.req["possession"], st.candidate()["value"], "possession")


def p_approver_revoked(st):
    return st.candidate()["approver_id"] in st.reg["tombstoned_approvers"]


def p_credential_reused(st):
    cid = st.candidate()["credential_id"]
    return st.cred(cid) is not None or \
        any(t["credential_id"] == cid for t in st.reg["tombstoned_credentials"])


def p_value_tombstoned(st):
    return tombstoned_value(st, st.candidate()["value"])


def p_duplicate_value(st):
    cand = st.candidate()
    return active_value(st, cand["value"], cand["channel"])


def authoriser(st: State) -> tuple[str, str, dict | None]:
    """The authoriser path, its condition (absent, not_active, wrong_kind,
    not_preexisting or eligible) and its credential, read from request and context."""
    reg = st.reg or {"credentials": [], "tombstoned_credentials": []}
    tombstoned = {t["credential_id"]: t for t in reg["tombstoned_credentials"]}

    def condition(cid: str, kind_ok: Callable[[str], bool]) -> tuple[str, dict | None]:
        cred = st.cred(cid)
        if cred is None:
            return ("not_active", tombstoned[cid]) if cid in tombstoned else ("absent", None)
        if not kind_ok(cred["channel"]):
            return "wrong_kind", cred
        if cred["sequence"] > st.ch["credential_sequence_at_issue"]:
            return "not_preexisting", cred
        return "eligible", cred

    auth = st.req["authorization"]
    if auth is not None:
        return ("lan",) + condition(auth["authorizer_credential_id"],
                                    lambda ch: ch == "lan_ed25519")
    text = recorded_text(st)
    if text is None:
        return ("phone", "absent", None)
    return ("phone",) + condition(text["authorizer_credential_id"], lambda ch: ch in PHONE)


def recorded_text(st: State) -> dict | None:
    """The challenge's authorization on the phone path: the first ORI-ENROL-V1 text
    recorded for its challenge ID (later ones are ignored), when it carries this
    challenge's digest; None otherwise."""
    texts = [t for t in st.ctx["phone_authorizations"]
             if t["challenge_id"] == st.challenge()["challenge_id"] or
             "phone_authorization_any_challenge" in st.D]
    if "phone_text_last" in st.D:
        texts = texts[::-1]
    if "phone_text_first_matching" in st.D:
        texts = [t for t in texts if t["challenge_sha256"] == st.challenge_digest()]
    if "phone_text_any_eligible" in st.D:
        active = [t for t in texts if (c := st.cred(t["authorizer_credential_id"])) is not None
                  and c["channel"] in PHONE]
        texts = active + [t for t in texts if t not in active]
    if not texts:
        return None
    first = texts[0]
    if first["challenge_sha256"] != st.challenge_digest() and \
            "phone_authorization_digest_unchecked" not in st.D:
        return None
    return first


def authorizing(st: State) -> dict | None:
    """The authorizing credential, or None (authorizer_unavailable)."""
    path, cond, cred = authoriser(st)
    if f"elig_refuse:{path}:{cond}" in st.D:
        return None
    if f"elig_accept:{path}:{cond}" in st.D or \
            (cond == "wrong_kind" and path == "lan" and "authorizer_any_channel" in st.D):
        # The planted defect accepts this authoriser: a stand-in active credential
        # of the path's kind carries its key, under the authoriser's own IDs.
        reg = st.reg or {"credentials": []}
        kind = ("lan_ed25519",) if path == "lan" else PHONE
        stand_in = next((c for c in reg["credentials"] if c["channel"] in kind), None)
        if stand_in is None:
            return None
        if cred is None:
            return {**stand_in, "sequence": 0}
        return {**stand_in, **{k: cred[k] for k in ("credential_id", "approver_id")},
                **({"channel": cred["channel"], "value": cred["value"]} if "value" in cred
                   else {}), "sequence": 0}
    return cred if cond in ("eligible", "not_preexisting") else None


def path_skipped(st: State, rule: str) -> bool:
    """A planted defect restricting a rule to one authoriser path or candidate kind."""
    phone_path = st.req["authorization"] is None
    lan_cand = st.candidate()["channel"] == "lan_ed25519"
    return (f"{rule}_lan_path_only" in st.D and phone_path) or \
        (f"{rule}_phone_path_only" in st.D and not phone_path) or \
        (f"{rule}_lan_candidate_only" in st.D and not lan_cand) or \
        (f"{rule}_phone_candidate_only" in st.D and lan_cand)


def p_authorizer_unavailable(st):
    if path_skipped(st, "unavailable"):
        return False
    return authorizing(st) is None


def p_authorizer_not_preexisting(st):
    if "preexisting_unchecked" in st.D or path_skipped(st, "not_preexisting"):
        return False
    return authorizing(st)["sequence"] > st.ch["credential_sequence_at_issue"]


def p_signature_invalid_authorization(st):
    auth = st.req["authorization"]
    if auth is None:
        return False
    digest_differs = auth["challenge_sha256"] != st.challenge_digest()
    if "authorization_digest_unchecked" in st.D:
        digest_differs = False
    if auth["challenge_id"] != st.challenge()["challenge_id"] or digest_differs:
        return True
    return signed_fails(st, auth, authorizing(st)["value"], "enrol")


def matrix_cell(st: State) -> tuple[str, str, str]:
    """The enrolment-matrix cell of an Enrol request, read from its request and
    context: authoriser path, candidate kind, and whose approver the candidate is."""
    path = "phone" if st.req["authorization"] is None else "lan"
    kind = "lan" if st.candidate()["channel"] == "lan_ed25519" else st.candidate()["channel"]
    aid = st.candidate()["approver_id"]
    if not approver_active(st, aid):
        whose = "minted"
    elif authorizing(st)["approver_id"] == aid:
        whose = "own"
    else:
        whose = "other"
    return path, kind, whose


def matrix_flipped(st: State) -> bool:
    """A planted defect mis-answering one cell, row or column of the matrix."""
    cell = matrix_cell(st)
    for defect in st.D:
        if isinstance(defect, str) and defect.startswith("matrix_flip:"):
            pattern = defect.split(":")[1:]
            if all(p in ("*", c) for p, c in zip(pattern, cell)):
                return True
    return False


def p_authorizer_not_approver(st):
    if "approver_check_skipped" in st.D or path_skipped(st, "not_approver"):
        return False
    aid = st.candidate()["approver_id"]
    answer = approver_active(st, aid) and authorizing(st)["approver_id"] != aid
    return not answer if matrix_flipped(st) else answer


def lan_candidate(st: State) -> bool:
    return st.candidate()["channel"] == "lan_ed25519"


def p_possession_invalid_enrol(st):
    return lan_candidate(st) and possession_mismatch(st)


def p_signature_invalid_possession_enrol(st):
    return lan_candidate(st) and signed_fails(st, st.req["possession"], st.candidate()["value"],
                                              "possession")


def p_phone_pending(st):
    return not lan_candidate(st) and st.candidate()["value"] in st.ctx["pending_phone_values"]


REVOKE_MEMBERS = {"v", "device_id", "site_id", "identity_epoch", "revision", "targets",
                  "signing_key", "signature"}


def anchor_keys(st: State) -> dict[str, bytes]:
    return {role: base64.b64decode(st.ctx["anchors"][role])
            for role in ("current", "previous", "other_class")}


def recognised(st: State, a: bytes, b: bytes) -> bool:
    if "anchor_compare_bytes" in st.D:
        return a == b
    return identity(a) == identity(b)


def p_anchor_unavailable(st):
    if not st.ctx["anchor_available"]:
        return True
    keys = anchor_keys(st)
    if "anchor_admission_unchecked" not in st.D and not key_admitted(keys["current"]):
        return True
    if "anchor_collision_unchecked" in st.D:
        return False
    roles = list(keys)
    return any(recognised(st, keys[a], keys[b])
               for i, a in enumerate(roles) for b in roles[i + 1:])


def p_malformed(st):
    d = st.req["document"]
    if not isinstance(d, dict) or set(d) != REVOKE_MEMBERS:
        return True
    if "document_dups_unchecked" not in st.D and twice_anywhere(st.raw_document):
        return True
    device_ok = is_id(d["device_id"]) if "document_device_id_64" in st.D else \
        is_device_id(d["device_id"])
    ids_ok = device_ok and is_id(d["site_id"]) if "document_ids_any_string" not in \
        st.D else isinstance(d["device_id"], str) and isinstance(d["site_id"], str)
    if not is_v(d["v"]) or not ids_ok:
        return True
    rev = d["revision"]
    if "revision_bool_accepted" in st.D:
        if not (isinstance(rev, int) and rev > 0):
            return True
    elif type(rev) is not int or rev <= 0:
        return True
    if "revision_unbounded" not in st.D and rev > MAX_SAFE:
        return True
    targets = d["targets"]
    if not isinstance(targets, list) or not targets or len(targets) > 32:
        return True
    if any(not isinstance(t, str) for t in targets) or len(set(targets)) != len(targets):
        return True
    if "targets_unsorted_accepted" not in st.D and targets != sorted(targets):
        return True
    for t in targets:
        kind, _, ident = t.partition(":")
        if kind not in ("credential", "approver") or not is_id(ident):
            return True
    return canon_b64(d["identity_epoch"], 16) is None or lan_key(d["signing_key"]) is None or \
        canon_b64(d["signature"], 64) is None


def anchor_role(st: State) -> str | None:
    key = lan_key(st.req["document"]["signing_key"])
    for role, anchor in anchor_keys(st).items():
        if recognised(st, anchor, key):
            return role
    return None


def p_unknown_signer(st):
    return anchor_role(st) is None


def p_revoke_signature(st):
    d = st.req["document"]
    return signed_fails(st, d, d["signing_key"], "revoke")


def p_superseded(st):
    return anchor_role(st) == "previous"


def p_wrong_authority(st):
    return anchor_role(st) == "other_class"


def p_site_differs(st):
    return site_differs(st)


def p_binding_mismatch(st):
    d = st.req["document"]
    return d["device_id"] != st.ctx["device_id"] or d["site_id"] != st.reg["site_id"] or \
        d["identity_epoch"] != st.reg["identity_epoch"]


def p_regressed(st):
    return st.req["document"]["revision"] < st.reg["last_external_revision"]


def document_fingerprint(st: State) -> str:
    if "replay_raw_bytes" in st.D:
        raw = frame(st.case)[0].decode("utf-8")
        return hashlib.sha256(raw[raw.index('"document"'):].encode("utf-8")).hexdigest()
    return hashlib.sha256(profile2(st.req["document"])).hexdigest()


def p_replay(st: State) -> bool:
    return st.reg is not None and isinstance(st.req["document"], dict) and \
        st.req["document"].get("revision") == st.reg["last_external_revision"] and \
        document_fingerprint(st) == st.reg["last_external_document_sha256"]


def p_conflict(st):
    return st.req["document"]["revision"] == st.reg["last_external_revision"] and \
        document_fingerprint(st) != st.reg["last_external_document_sha256"]


def known_target(st: State, target: str) -> bool:
    kind, _, ident = target.partition(":")
    reg = st.reg
    if kind == "credential":
        return st.cred(ident) is not None or \
            any(t["credential_id"] == ident for t in reg["tombstoned_credentials"])
    known = approver_active(st, ident) or ident in reg["tombstoned_approvers"]
    if "approver_known_by_active_only" not in st.D:
        known = known or any(t["approver_id"] == ident for t in reg["tombstoned_credentials"])
    return known


def p_unknown_target(st):
    if "unknown_target_partial" in st.D:
        return False
    if st.req["document"]["revision"] == st.reg["last_external_revision"]:
        return False      # the recorded document again: answered as a replay
    return not all(known_target(st, t) for t in st.req["document"]["targets"])


