def split_sentences(body: str) -> list[str]:
    """The section's prose as sentences: paragraphs and list items, tables and rules left out."""
    blocks: list[list[str]] = [[]]
    lines = body.splitlines()
    fenced = markdown.fenced_lines(lines)
    for k, line in enumerate(lines):
        t = line.strip()
        if k in fenced or not t or t.startswith("|") or re.fullmatch(r"-{3,}", t):
            blocks.append([])
            continue
        if t.startswith("- "):
            blocks.append([t[2:]])
            continue
        blocks[-1].append(t)
    out: list[str] = []
    for block in blocks:
        text = flat(" ".join(block))
        if text:
            out += [x for x in re.split(r"(?<=[.!?:;])\s+(?=[A-Z`*\[\"(])", text) if x]
    return out


