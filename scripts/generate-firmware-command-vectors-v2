#!/usr/bin/env python3
# Copyright 2026 Ori Nexus Systems LTD
# SPDX-License-Identifier: Apache-2.0
"""Generate the firmware-commands/v2 command corpus (Signing Domains).

Signatures come from OpenSSL through `cryptography`, under the disclosed
runtime and rogue test seeds of the liveness corpora. Object bytes are written
field by field. Nothing here is shared with
scripts/check-firmware-command-vectors-v2, which reads the domains and the
command grammar from the contracts.

    python3 scripts/generate-firmware-command-vectors-v2          # write
    python3 scripts/generate-firmware-command-vectors-v2 --check  # reproduce
"""

from __future__ import annotations

import base64
import hashlib
import json
import pathlib
import sys

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "firmware-commands" / "command-vectors-v2.json"

RUNTIME_SEED_HEX = "11" * 32
ROGUE_SEED_HEX = "99" * 32
COMMAND_DOMAIN = "ori.firmware_command.v2"
LIVENESS_DOMAIN = "ori.firmware_liveness.v2"
DEVICE_ID = "ori-fw-7c9f2b3a"
SEALED_HASH = "sha256:13751b5335ccedcd4ffcc82bbda28ebfb7558859f36a74e710f1a0b0ab23da8d"
BENCH_HASH = "sha256:943dadca53c0890a5afe2aed44cbb4942779f2a697cdaccd92b78cfe4fb1fa8d"
CMD_SEQ_MAX = 2**53 - 1
GRANTED = [["relay_close", "relay0"], ["relay_close", "relay1"], ["relay_open", "relay0"],
           ["relay_open", "relay1"]]

# The preimage each signature form covers, for the object bytes it signs.
PREIMAGES = {
    "command": lambda body: COMMAND_DOMAIN.encode("ascii") + b"\x00" + body,
    "liveness": lambda body: LIVENESS_DOMAIN.encode("ascii") + b"\x00" + body,
    "alone": lambda body: body,
    "command_no_nul": lambda body: COMMAND_DOMAIN.encode("ascii") + body,
}


def command_bytes(action: str, capability_hash: str, channel: str, cmd_seq: int) -> bytes:
    return (f'{{"action":"{action}","capability_hash":"{capability_hash}",'
            f'"channel":"{channel}","cmd_seq":{cmd_seq},"device_id":"{DEVICE_ID}","v":1}}'
            ).encode("ascii")


def context(capability_hash: str, last: int) -> dict:
    return {"device_id": DEVICE_ID, "capability_hash": capability_hash,
            "last_accepted_cmd_seq": last, "runtime_commanded": GRANTED}


# (name, note, object fields, verifier_context)
ACCEPT = (
    ("command_sealed_epoch_relay_open", "the first command of a device's sequence space",
     ("relay_open", SEALED_HASH, "relay0", 1), context(SEALED_HASH, 0)),
    ("command_bench_relay_close", "a close under another manifest epoch",
     ("relay_close", BENCH_HASH, "relay0", 2), context(BENCH_HASH, 1)),
    ("command_bench_second_channel", "a second channel, after a gap in cmd_seq",
     ("relay_open", BENCH_HASH, "relay1", 41), context(BENCH_HASH, 2)),
    ("command_bench_max_seq", "cmd_seq at its largest value",
     ("relay_close", BENCH_HASH, "relay1", CMD_SEQ_MAX), context(BENCH_HASH, 41)),
)

REFUSED_FIELDS = ("relay_open", SEALED_HASH, "relay0", 42)
# (name, signer, preimage form, note)
REJECT = (
    ("reject_signed_over_object_alone", "runtime", "alone",
     "signed by the runtime key over the command object bytes alone, v1's form"),
    ("reject_signed_in_liveness_domain", "runtime", "liveness",
     "signed by the runtime key in the liveness domain: a liveness signature is never a "
     "command signature"),
    ("reject_command_domain_without_nul", "runtime", "command_no_nul",
     "signed by the runtime key over the command domain and the object bytes with no NUL "
     "between them"),
    ("reject_rogue_key", "rogue", "command",
     "signed in the command domain by a key the device does not hold"),
)

CROSS_PURPOSE = (
    ("command_object", "command", command_bytes(*REFUSED_FIELDS),
     "the runtime key's three signatures over one command object"),
    ("liveness_object", "liveness",
     b'{"boot_id":41,"capability_hash":"' + SEALED_HASH.encode() + b'","device_id":"'
     + DEVICE_ID.encode() + b'","runtime_seq":1,"v":1}',
     "the runtime key's three signatures over one liveness object"),
)


def build() -> bytes:
    keys = {"runtime": Ed25519PrivateKey.from_private_bytes(bytes.fromhex(RUNTIME_SEED_HEX)),
            "rogue": Ed25519PrivateKey.from_private_bytes(bytes.fromhex(ROGUE_SEED_HEX))}
    public = {name: key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
              for name, key in keys.items()}

    def sign(body: bytes, signer: str = "runtime", form: str = "command") -> str:
        return base64.b64encode(keys[signer].sign(PREIMAGES[form](body))).decode("ascii")

    def wire(body: bytes, signature_b64: str) -> str:
        return (b'{"command":' + body + b',"signature":"ed25519:' + signature_b64.encode()
                + b'"}').hex()

    cases = []
    for name, note, fields, ctx in ACCEPT:
        body = command_bytes(*fields)
        signature = sign(body)
        cases.append({"name": name, "note": note, "verifier_context": ctx,
                      "input": json.loads(body), "command_hex": body.hex(),
                      "preimage_hex": PREIMAGES["command"](body).hex(),
                      "signature_b64": signature, "message_hex": wire(body, signature)})
    reject_cases = []
    for name, signer, form, note in REJECT:
        body = command_bytes(*REFUSED_FIELDS)
        signature = sign(body, signer, form)
        reject_cases.append({"name": name, "reason": "bad_signature", "signer": signer,
                             "signed_over": form, "note": note,
                             "verifier_context": context(SEALED_HASH, 41),
                             "input": json.loads(body), "command_hex": body.hex(),
                             "signature_b64": signature, "message_hex": wire(body, signature)})
    cross = []
    for name, purpose, body, note in CROSS_PURPOSE:
        cross.append({"name": name, "purpose": purpose, "note": note,
                      "object_hex": body.hex(),
                      "signatures": {form: sign(body, form=form)
                                     for form in ("command", "liveness", "alone")}})

    corpus = {
        "contract": "ori-specs/firmware-commands/v2.md#signing-domains",
        "version": 2,
        "comment": (
            "Golden vectors for the signing domains of firmware-commands/v2. A device must "
            "accept every case in 'cases' and refuse every case in 'reject_cases' as "
            "bad_signature, persisting nothing, evaluated against its verifier_context; a "
            "runtime signer must reproduce each accepted case's command, preimage and wire "
            "bytes. Each cross_purpose entry holds the runtime key's signatures over one object "
            "in the command domain, in the liveness domain and alone: they differ, and each "
            "verifies over its own preimage only. Signed with the TEST-ONLY runtime and rogue "
            "seeds of the liveness corpora; never use them in production."
        ),
        "domains": {"command": COMMAND_DOMAIN, "liveness": LIVENESS_DOMAIN},
        "runtime_test_seed_hex": RUNTIME_SEED_HEX,
        "runtime_public_key_hex": public["runtime"].hex(),
        "runtime_public_key_b64": base64.b64encode(public["runtime"]).decode("ascii"),
        "rogue_test_seed_hex": ROGUE_SEED_HEX,
        "rogue_public_key_hex": public["rogue"].hex(),
        "signature_encoding": "ed25519:<standard-base64-64-byte-signature>",
        "topic": "ori/fw/<device_id>/cmd",
        "retain": False,
        "qos": 1,
        "cases": cases,
        "reject_cases": reject_cases,
        "cross_purpose": cross,
    }
    return (json.dumps(corpus, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = build()
    if argv == ["--check"]:
        if not OUT.exists() or OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator")
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv:
        print(__doc__)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)} sha256 {hashlib.sha256(data).hexdigest()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
