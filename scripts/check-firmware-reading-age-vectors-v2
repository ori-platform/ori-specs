            ('A separate signed event for individual alarm transitions is not defined here.'),
            ("It would be a successor's, if equipment is shown to need transitions that polling "
             'cannot capture.'),
        ),
    },
}
# Sentences every mutation run reverses and deletes, whatever the sample.
MUTATE_ALWAYS = (
    'Never a wall clock',
    'CLOCK_BOOTTIME',
    'after every check of v1 and of this version',
    'An envelope with no bound is still accepted',
    'is not decided here',
    "carries that clock's error",
    'SHOULD make the per-device bound',
    'Every other receiver cannot bound it',
)


def contract_texts() -> dict[str, str]:
    return {"t2": TELEMETRY_V2.read_text(), "c2": COMMANDS_V2.read_text()}


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = contract_texts() if texts is None else texts
    check_normative({"commands": texts["c2"], "telemetry": texts["t2"]}, OWNER, HELD_SENTENCES)
    t2, c2 = texts["t2"], texts["c2"]
    age = section(t2, "## How Old A Reading Is")
    bound = section(age, "### The bound")
    present = section(age, "### What a receiver may present")
    golden = section(t2, "## Golden Vectors")
    golden = golden[golden.index("[reading-age-vectors-v2.json]"):]
    for sentence in BOUND_SENTENCES:
        need(bound, sentence, "v2.md The bound")
    for clause, _ in GUARDS:
        need(age, clause, "v2.md How Old A Reading Is")
    for sentence in PRESENT_SENTENCES:
        need(present, sentence, "v2.md What a receiver may present")
    for sentence in GOLDEN_SENTENCES:
        need(golden, sentence, "v2.md Golden Vectors")
    text = flat(bound)
    retention = re.search(
        r"An entry is usable while its age, the time on the clock since its signing start, "
        r"is at most one hour, (\d+) nanoseconds,", text)
    fields = re.search(r"An entry holds the liveness object's `(\w+)`, `(\w+)` and `(\w+)`", text)
    matching = re.search(r"has a bound only if the table holds an entry for its "
                         r"`liveness_nonce` whose `(\w+)`, `(\w+)` and `(\w+)` equal the "
                         r"envelope's", text)
    age_rule = re.search(r"`age_upper = now − signing_start`, in (\w+) on the same clock", text)
    unit = re.search(r"Each query gives the bound in nanoseconds and rounded up to whole "
                     r"(\w+), or no bound\.", flat(golden))
    kinds = re.search(r"Its events are in clock order, and are of (\w+) kinds:", flat(golden))
    if None in (retention, fields, matching, age_rule, unit, kinds):
        raise Failure("v2.md no longer states the retention, the entry, matching, the age, "
                      "the display unit or the event kinds as this checker reads them")
    assert retention and fields and matching and age_rule and unit and kinds
    if int(retention.group(1)) != 3600 * 10**9:
        raise Failure("the retention is not one hour in nanoseconds")
    if fields.groups() != matching.groups():
        raise Failure("matching does not compare exactly the fields an entry holds")
    if age_rule.group(1) != "nanoseconds":
        raise Failure("the age is not in nanoseconds")
    units = {"milliseconds": 10**6, "microseconds": 10**3, "seconds": 10**9}
    kind_bullets = _bullets(golden, "and are of eight kinds:")
    if kinds.group(1) != "eight" or kind_bullets != list(KINDS):
        raise Failure(f"the event kinds changed: {kind_bullets}")
    cover = _bullets(golden, "The cases cover:")
    if cover != list(COVER):
        raise Failure(f"the cases the corpus covers changed: {cover}")
    nonce = re.search(r"`nonce` is a JSON string of exactly (\d+) characters, each one of "
                      r"`(.)`-`(.)` or `(.)`-`(.)`", flat(c2))
    assert nonce is not None
    pin = re.search(r"Its SHA-256 is `([0-9a-f]{64})`", flat(golden))
    if pin is None:
        raise Failure("v2.md pins no reading-age corpus digest")
    return {
        "retention": int(retention.group(1)),
        "retention_stated": int(retention.group(1)),
        "usable_inclusive": True,    # usable at most the retention; expired once it exceeds
        "match_inclusive": True,     # acceptance no more than the retention after the start
        "match_fields": list(matching.groups()),
        "unit": units[unit.group(1)],
        "round_up": True,
        "evict_expired": True,
        "evict_device": True,
        "evict_total": True,
        "device_first": True,
        "device_scope": ("device_id",),
        "earliest_first": True,
        "tie_first_byte": True,
        "tie_by_nonce": True,
        "restart_empties": True,
        "restart_drops_starts": True,
        "restart_drops_latest": True,
        "restore_empties": False,
        "suspend_stops_clock": False,
        "unclocked_records": False,
        "match_by_runtime_seq": False,
        "age_fixed_at_receipt": False,
        "heartbeat_refreshes": False,
        "null_matches": False,
        "failed_discards": True,
        "failed_eviction_stands": True,
        "v1_matches": False,
        "expiry_slack": 0,
        "nonce_pattern": "[%s-%s%s-%s]{%s}" % (nonce.group(2), nonce.group(3), nonce.group(4),
                                               nonce.group(5), nonce.group(1)),
        "kinds": {name: keys for name, keys in KINDS.values()},
        "pin": pin.group(1),
    }


# --- the signing runtime ---------------------------------------------------------------

class Runtime:
    def __init__(self, model: dict, per_device: int, total: int) -> None:
        self.m = model
        self.per_device = per_device
        self.total = total
        self.table: dict[str, dict] = {}      # nonce -> entry
        self.messages: dict[tuple, int | None] = {}  # (device, boot, seq) -> signing start
        self.latest: dict[tuple, tuple] = {}   # (device, channel) -> message key
        self.signed_seqs: dict[str, int] = {}  # nonce -> runtime_seq, the state store's view
        self.process_seqs: set[tuple] = set()
        self.ever_signed: set[str] = set()
        self.suspended_ns = 0
        self.facts: set[str] = set()
        self.hour_old_survivors: set[str] = set()
        self.last_evicted: list[str] = []
        self.given: set[str] = set()
        self.v1_signed: set[tuple] = set()
        self.v1_pending: set[tuple] = set()
        self.pair_nonces: set[str] = set()
        self.failed_evicted: set[str] = set()
        self.between_null: set[tuple] = set()

    def clock(self, t: int) -> int:
        return t - self.suspended_ns if self.m["suspend_stops_clock"] else t

    def _usable(self, age: int) -> bool:
        r = self.m["retention"] + self.m["expiry_slack"]
        return age <= r if self.m["usable_inclusive"] else age < r

    def _evict_one(self, scope: list[str]) -> str:
        def key(nonce: str) -> tuple:
            start = self.table[nonce]["start"]
            tie = nonce.encode() if self.m["tie_by_nonce"] else self.table[nonce]["order"]
            if not self.m["tie_first_byte"]:
                tie = bytes(255 - b for b in tie) if isinstance(tie, bytes) else -tie
            return (start if self.m["earliest_first"] else -start, tie)
        ordered = sorted(scope, key=key)
        if len(ordered) > 1 and self.table[ordered[0]]["start"] == self.table[ordered[1]]["start"]:
            self.facts.add("tie")
        victim = ordered[0]
        del self.table[victim]
        return victim

    def sign(self, ev: dict, failed: bool = False) -> None:
        self.given.add(ev["nonce"])
        if not failed:
            self.ever_signed.add(ev["nonce"])
            self.signed_seqs[ev["nonce"]] = ev["runtime_seq"]
        seq_key = (ev["device_id"], ev["boot_id"], ev["runtime_seq"])
        if seq_key in self.process_seqs:
            self.facts.add("reissued_in_process")
        self.process_seqs.add(seq_key)
        if ev["t_ns"] is None:
            self.facts.add("unclocked")
            if not self.m["unclocked_records"]:
                return
            now = 0
        else:
            now = self.clock(ev["t_ns"])
        if ev["nonce"] in self.table:
            raise Failure("a nonce signed twice while its entry is held")
        device = tuple(ev[f] for f in self.m["device_scope"])
        mine = [n for n, e in self.table.items() if e["scope"] == device]
        for n in list(self.table):
            age = now - self.table[n]["start"]
            if self.m["evict_expired"] and not self._usable(age):
                del self.table[n]
        hour_old = {n for n, e in self.table.items() if now - e["start"] == self.m["retention"]}
        mine = [n for n, e in self.table.items() if e["device_id"] == ev["device_id"]]
        if (len(mine) >= self.per_device and len(self.table) >= self.total
                and min(self.table, key=lambda n: self.table[n]["start"]) not in mine):
            self.facts.add("device_before_total")

        def device_step() -> None:
            mine = [n for n, e in self.table.items() if e["scope"] == device]
            if self.m["evict_device"] and len(mine) >= self.per_device:
                held = dict(self.table)
                victim = self._evict_one(mine)
                self.last_evicted.append(victim)
                self.facts.add("evict_device")
                if now - held[victim]["start"] == self.m["retention"]:
                    self.facts.add("hour_old_size_evicted")
                if held[victim]["boot_id"] != ev["boot_id"]:
                    self.facts.add("device_spans_boots")
            elif len(mine) == self.per_device - 1:
                self.facts.add("device_fits")

        def total_step() -> None:
            if self.m["evict_total"] and len(self.table) >= self.total:
                self.last_evicted.append(self._evict_one(list(self.table)))
                self.facts.add("evict_total")
            elif len(self.table) == self.total - 1:
                self.facts.add("total_fits")

        for step in ((device_step, total_step) if self.m["device_first"]
                     else (total_step, device_step)):
            step()
        self.hour_old_survivors |= hour_old & set(self.table)
        self.table[ev["nonce"]] = {
            "device_id": ev["device_id"], "boot_id": ev["boot_id"],
            "capability_hash": ev["capability_hash"], "start": now, "scope": device,
            "runtime_seq": ev["runtime_seq"], "order": len(self.ever_signed),
        }

    def accept(self, ev: dict) -> None:
        now = self.clock(ev["t_ns"])
        key = (ev["device_id"], ev["boot_id"], ev["seq"])
        if key in self.messages:
            raise Failure(f"message {key} accepted twice")
        start = None
        nonce = ev.get("liveness_nonce")
        if ev["v"] == 1:
            self.facts.add("v1_envelope")
            if self.m["v1_matches"] and nonce in self.table:
                start = self.table[nonce]["start"]
        elif nonce is None:
            self.facts.add("null_nonce")
            if self.m["null_matches"] and None in self.table:
                start = self.table[None]["start"]  # type: ignore[index]
        else:
            if nonce not in self.given:
                self.facts.add("unknown_nonce")
            entry = self.table.get(nonce)
            if self.m["match_by_runtime_seq"] and nonce in self.signed_seqs:
                same = [e for e in self.table.values()
                        if e["runtime_seq"] == self.signed_seqs[nonce]
                        and e["device_id"] == ev["device_id"]]
                entry = max(same, key=lambda e: e["start"]) if same else None
            if entry is not None:
                differ = [f for f in self.m["match_fields"] if entry[f] != ev[f]]
                late = now - entry["start"]
                in_hour = (late <= self.m["retention"] if self.m["match_inclusive"]
                           else late < self.m["retention"])
                if len(differ) == 1 and in_hour:
                    self.facts.add(f"other_{differ[0]}")
                if not differ and late == self.m["retention"] + 1:
                    self.facts.add("match_past_edge")
                if not differ and in_hour:
                    start = entry["start"]
                    if nonce in self.hour_old_survivors:
                        self.facts.add("hour_old_survives_with_room")
                    self.facts.add("matched")
                    if late == self.m["retention"]:
                        self.facts.add("match_at_edge")
            if start is None and nonce in self.restarted_away:
                self.facts.add("restart_before")
            if start is None and nonce in self.reissued_after_restore:
                self.facts.add("restart_restore_reissue")
        self.messages[key] = start
        self.receipt[key] = now
        self.accept_times.append((now, nonce, start))
        channels = ev["channels"]
        if not channels:
            self.heartbeats.add(key)
            if self.m["heartbeat_refreshes"]:
                for (dev, ch) in list(self.latest):
                    if dev == ev["device_id"]:
                        self.latest[(dev, ch)] = key
        for ch in channels:
            self.latest[(ev["device_id"], ch)] = key

    restarted_away: set
    reissued_after_restore: set
    receipt: dict
    accept_times: list
    heartbeats: set

    def restart(self) -> None:
        self.restarted_away |= set(self.table)
        self.matched_before_restart |= {k for k, s in self.messages.items() if s is not None}
        if self.m["restart_empties"]:
            self.table.clear()
        if self.m["restart_drops_starts"]:
            self.messages = {k: None for k in self.messages}
        if self.m["restart_drops_latest"]:
            self.latest.clear()
        self.process_seqs = set()
        self.restarted = True

    def restore(self) -> None:
        if self.m["restore_empties"]:
            self.table.clear()
        self.restored_after_restart = self.restarted
        self.restored_live = not self.restarted
        self.restore_seen = True

    matched_before_restart: set

    def bound(self, start: int | None, key: tuple, now: int) -> dict:
        if start is None:
            return {"bound": "none"}
        at = self.receipt[key] if self.m["age_fixed_at_receipt"] else now
        ns = at - start
        unit = self.m["unit"]
        shown = -(-ns // unit) if self.m["round_up"] else ns // unit
        if ns % unit:
            self.facts.add("rounded")
        else:
            self.facts.add("whole_unit")
        return {"bound": "upper", "age_upper_ns": ns, "age_upper_ms_rounded_up": shown}

    def query(self, ev: dict) -> dict:
        now = self.clock(ev["t_ns"])
        if "message" in ev:
            m = ev["message"]
            key = (m["device_id"], m["boot_id"], m["seq"])
            if key not in self.messages:
                raise Failure(f"query of a message never accepted: {key}")
            start = self.messages[key]
            out = self.bound(start, key, now)
            if start is None and key in self.between_null:
                self.facts.add("rollout_between_unbounded")
            if start is not None:
                self.queried.setdefault(key, []).append(out["age_upper_ns"])
                if now - start > self.m["retention"]:
                    self.facts.add("queried_late")
            elif key in self.matched_before_restart:
                self.facts.add("restart_after")
            return out
        c = ev["channel"]
        key = self.latest.get((c["device_id"], c["channel"]))
        if key is None:
            return {"latest": None, "bound": "none"}
        if any(h[0] == c["device_id"] and h[2] > key[2] and h[1] == key[1]
               for h in self.heartbeats):
            self.facts.add("heartbeat_no_refresh")
        out = self.bound(self.messages[key], key, now)
        return {"latest": {"boot_id": key[1], "seq": key[2]}, **out}

    queried: dict


def run_case(case: dict, model: dict) -> set[str]:
    rt = Runtime(model, case["per_device_bound"], case["total_bound"])
    rt.restarted_away, rt.reissued_after_restore = set(), set()
    rt.receipt, rt.accept_times, rt.heartbeats = {}, [], set()
    rt.matched_before_restart, rt.queried = set(), {}
    rt.restarted, rt.restored_after_restart, rt.restored_live = False, False, False
    rt.restore_seen = False
    label = case["name"]
    last = None
    for i, ev in enumerate(case["events"]):
        kind = ev["kind"]
        if kind not in model["kinds"]:
            raise Failure(f"{label} event {i}: kind {kind}")
        keys = {"kind", *model["kinds"][kind]}
        if kind == "accept" and ev.get("v") == 1:
            keys -= {"liveness_nonce"}
        shapes = [keys | {"message"}, keys | {"channel"}] if kind == "query" else [keys]
        if set(ev) not in shapes:
            raise Failure(f"{label} event {i}: fields {sorted(ev)}")
        t = ev["t_ns"]
        if t is not None:
            if type(t) is not int or t < 0 or (last is not None and t < last):
                raise Failure(f"{label} event {i}: not in clock order")
            last = t
        elif kind != "sign_liveness":
            raise Failure(f"{label} event {i}: only a signing may have no clock reading")
        if kind == "sign_liveness":
            if not re.fullmatch(model["nonce_pattern"], ev["nonce"]):
                raise Failure(f"{label} event {i}: nonce grammar")
            before = (ev["device_id"], ev["boot_id"], ev["runtime_seq"])
            if rt.restore_seen and before in rt.process_seqs and rt.restored_live:
                rt.facts.add("live_restore_reissue")
            if rt.restored_after_restart and any(
                    s == ev["runtime_seq"] and n not in rt.table for n, s in rt.signed_seqs.items()
                    if n in rt.restarted_away):
                rt.reissued_after_restore |= {n for n, s in rt.signed_seqs.items()
                                              if s == ev["runtime_seq"] and n in rt.restarted_away}
            v1_before = (ev["device_id"], ev["boot_id"], ev["runtime_seq"] - 1)
            if v1_before in rt.v1_signed:
                rt.pair_nonces.add(ev["nonce"])
                rt.v1_pending.discard(v1_before)
            rt.sign(ev)
        elif kind == "sign_liveness_v1":
            if type(t) is not int:
                raise Failure(f"{label} event {i}: a v 1 signing without a clock reading")
            key = (ev["device_id"], ev["boot_id"], ev["runtime_seq"])
            rt.v1_signed.add(key)
            rt.v1_pending.add(key)
            rt.process_seqs.add(key)
        elif kind == "sign_failed":
            if type(t) is not int or not re.fullmatch(model["nonce_pattern"], ev["nonce"]):
                raise Failure(f"{label} event {i}: a failed signing needs its start and nonce")
            if (ev["device_id"], ev["boot_id"], ev["runtime_seq"] - 1) in rt.v1_signed:
                rt.v1_pending.discard((ev["device_id"], ev["boot_id"], ev["runtime_seq"] - 1))
                after_v1 = True
            else:
                after_v1 = False
            snapshot = dict(rt.table)
            rt.last_evicted = []
            rt.sign(ev, failed=True)
            evicted = list(rt.last_evicted)
            if model["failed_discards"]:
                rt.table.pop(ev["nonce"], None)
            if not model["failed_eviction_stands"]:
                for n in evicted:
                    rt.table[n] = snapshot[n]
            rt.failed_evicted |= set(evicted)
            if after_v1 and ev["nonce"] not in rt.table:
                rt.facts.add("rollout_failed_after_v1")
        elif kind == "accept":
            nonce = ev.get("liveness_nonce")
            if type(ev["v"]) is not int or ev["v"] not in (1, 2) or (nonce is not None and not re.fullmatch(
                    model["nonce_pattern"], nonce)) or type(ev["channels"]) is not list:
                raise Failure(f"{label} event {i}: an envelope v2.md would refuse")
            if nonce is None and ev["v"] == 2 and any(
                    k[0] == ev["device_id"] and k[1] == ev["boot_id"] for k in rt.v1_pending):
                rt.between_null.add((ev["device_id"], ev["boot_id"], ev["seq"]))
            rt.accept(ev)
            key = (ev["device_id"], ev["boot_id"], ev["seq"])
            if rt.messages[key] is not None and nonce in rt.pair_nonces:
                rt.facts.add("rollout_after_pair_bounded")
            if rt.messages[key] is None and nonce in rt.failed_evicted:
                rt.facts.add("failed_eviction_stands")
        elif kind == "restart":
            rt.restart()
        elif kind == "store_restore":
            rt.restore()
        elif kind == "suspend":
            if ev["resume_t_ns"] < t:
                raise Failure(f"{label} event {i}: resumes before it suspends")
            rt.facts.add("suspended")
            rt.suspended_ns += ev["resume_t_ns"] - t
            last = ev["resume_t_ns"]
        else:
            got = rt.query(ev)
            if got != ev["expected"]:
                raise Failure(f"{label} event {i}: expected {ev['expected']}, recomputed {got}")
    for samples in rt.queried.values():
        if len(samples) > 1 and samples[-1] > samples[0]:
            rt.facts.add("growing")
    burst = [a for a in rt.accept_times if a[2] is not None]
    for i in range(len(burst)):
        window = [a for a in burst if 0 <= a[0] - burst[i][0] <= 10**9]
        if len(window) >= 3 and len({a[1] for a in window}) >= 2:
            rt.facts.add("drained_backlog")
    return rt.facts


def check(corpus: dict, model: dict, coverage_model: dict | None = None) -> dict[str, list[str]]:
    """Recompute every query under `model`; judge coverage under `coverage_model`.

    Coverage is a property of the corpus against the text, so a mutant of the
    rules is refused only where a recomputed query differs.
    """
    if corpus["retention_ns"] != model["retention_stated"]:
        raise Failure("the corpus states another retention")
    if set(corpus["event_kinds"]) != set(model["kinds"]):
        raise Failure("the corpus's event kinds are not the text's six")
    names: set[str] = set()
    facts: dict[str, list[str]] = {}
    for case in corpus["cases"]:
        if case["name"] in names:
            raise Failure(f"duplicate case {case['name']}")
        names.add(case["name"])
        if set(case) != {"name", "per_device_bound", "total_bound", "events", "note"}:
            raise Failure(f"{case['name']}: fields {sorted(case)}")
        for bound in ("per_device_bound", "total_bound"):
            if type(case[bound]) is not int or case[bound] < 1:
                raise Failure(f"{case['name']}: {bound}")
        shown = run_case(case, model)
        if coverage_model is not None:
            shown = run_case(case, coverage_model)
        for fact in shown:
            facts.setdefault(fact, []).append(case["name"])
        for ev in case["events"]:
            facts.setdefault(f"kind {ev['kind']}", []).append(case["name"])
    for kind in model["kinds"]:
        if f"kind {kind}" not in facts:
            raise Failure(f"coverage: no {kind} event")
    for items in COVER.values():
        for item in items:
            if item not in facts:
                raise Failure(f"coverage: no case shows {item}")
    for item in EDGES:
        if item not in facts:
            raise Failure(f"coverage: no case shows {item}")
    return facts


def run(corpus_bytes: bytes, model: dict,
        coverage_model: dict | None = None) -> dict[str, list[str]]:
    if hashlib.sha256(corpus_bytes).hexdigest() != model["pin"]:
        raise Failure("corpus digest differs from the one firmware-telemetry/v2.md pins")
    return check(json.loads(corpus_bytes), model, coverage_model)


# --- mutations ----------------------------------------------------------------------------

def mutations(corpus_bytes: bytes, model: dict) -> int:
    base = json.loads(corpus_bytes)

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(base)
            edit(mutated)
            check(mutated, model)
        return go

    def model_mutant(**changes: object) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            mutated.update(changes)
            run(corpus_bytes, mutated, coverage_model=model)
        return go

    def text_mutant(old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            if old not in texts["t2"]:
                raise AssertionError(f"mutant target missing: {old!r}")
            texts["t2"] = texts["t2"].replace(old, new, 1)
            run(corpus_bytes, contract_model(texts))
        return go

    def case(c: dict, name: str) -> dict:
        return next(x for x in c["cases"] if x["name"] == name)

    def drop(name: str) -> Callable[[dict], None]:
        return lambda c: c.update(cases=[x for x in c["cases"] if x["name"] != name])

    r = model["retention"]
    cases: list[tuple[str, Callable[[], None]]] = [
        ("expected bound off by one", corpus_mutant(
            lambda c: case(c, "rounds_up")["events"][2]["expected"].update(age_upper_ns=2500000))),
        ("expected rounding down", corpus_mutant(
            lambda c: case(c, "rounds_up")["events"][2]["expected"].update(
                age_upper_ms_rounded_up=2))),
        ("expected bound where none", corpus_mutant(
            lambda c: case(c, "unknown_nonce")["events"][2].update(expected={
                "bound": "upper", "age_upper_ns": 3000000000, "age_upper_ms_rounded_up": 3000}))),
        ("events out of clock order", corpus_mutant(
            lambda c: case(c, "drained_backlog")["events"].reverse())),
        ("nonce in uppercase", corpus_mutant(
            lambda c: case(c, "matched_and_growing")["events"][0].update(
                nonce="C9A1DA7F16443010253A43946E2D92FA"))),
        ("an event with an extra field", corpus_mutant(
            lambda c: case(c, "matched_and_growing")["events"][1].update(runtime_seq=1))),
        ("retention restated", corpus_mutant(lambda c: c.update(retention_ns=r + 1))),
        ("an event kind renamed", corpus_mutant(
            lambda c: c["event_kinds"].__setitem__("reboot", c["event_kinds"].pop("restart")))),
        ("corpus digest pin wrong", model_mutant(pin="0" * 64)),
        ("retention one nanosecond shorter", model_mutant(retention=r - 1)),
        ("retention one nanosecond longer", model_mutant(retention=r + 1)),
        ("matching exclusive at the hour", model_mutant(match_inclusive=False)),
        ("matching ignores device_id", model_mutant(match_fields=["boot_id", "capability_hash"])),
        ("matching ignores boot_id", model_mutant(match_fields=["device_id", "capability_hash"])),
        ("matching ignores capability_hash", model_mutant(match_fields=["device_id", "boot_id"])),
        ("matching keyed by runtime_seq", model_mutant(match_by_runtime_seq=True)),
        ("bound rounded down", model_mutant(round_up=False)),
        ("display unit microseconds", model_mutant(unit=10**3)),
        ("no per-device eviction", model_mutant(evict_device=False)),
        ("no total eviction", model_mutant(evict_total=False)),
        ("latest evicted first", model_mutant(earliest_first=False)),
        ("tie goes to the last nonce in byte order", model_mutant(tie_first_byte=False)),
        ("tie goes to the first signed", model_mutant(tie_by_nonce=False)),
        ("restart keeps the table", model_mutant(restart_empties=False)),
        ("restart keeps held signing starts", model_mutant(restart_drops_starts=False)),
        ("restart keeps latest readings", model_mutant(restart_drops_latest=False)),
        ("store restore empties the table", model_mutant(restore_empties=True)),
        ("suspension stops the clock", model_mutant(suspend_stops_clock=True)),
        ("unclocked signing records an entry", model_mutant(unclocked_records=True)),
        ("age fixed at receipt", model_mutant(age_fixed_at_receipt=True)),
        ("heartbeat refreshes the channel", model_mutant(heartbeat_refreshes=True)),
        ("a failed signing leaves a usable entry", model_mutant(failed_discards=False)),
        ("a failed signing's eviction undone", model_mutant(failed_eviction_stands=False)),
        ("text: failed eviction undone", text_mutant(
            "which then holds no slot; any eviction made\n  when it was recorded stands.",
            "which then holds no slot, and what it evicted\n  is restored.")),
        ("text: kind dropped from eight", text_mutant(
            "- `v` `1` liveness messages the runtime signs, which carry no nonce and\n  record nothing in the table;\n",
            "")),
        ("total bound applied before the device bound", model_mutant(device_first=False)),
        ("device scope keyed by device and boot", model_mutant(
            device_scope=("device_id", "boot_id"))),
        ("an entry exactly an hour old expired", model_mutant(usable_inclusive=False)),
        ("text: retention", text_mutant("at most one hour, 3600000000000 nanoseconds",
                                        "at most one hour, 3599999999999 nanoseconds")),
        ("text: matching drops the manifest", text_mutant(
            "whose `device_id`, `boot_id` and `capability_hash` equal the\n  envelope's",
            "whose `device_id`, `boot_id` and `seq` equal the\n  envelope's")),
        ("text: tie-breaker reversed", text_mutant(
            "the one whose nonce\n  sorts first in byte order", "the one whose nonce\n  sorts last in byte order")),
        ("text: restore empties", text_mutant(
            "while the process runs neither empties it nor changes any entry",
            "while the process runs empties it")),
        ("text: rounding down", text_mutant("the smallest whole unit not\nless than it",
                                            "the largest whole unit not\ngreater than it")),
        ("text: heartbeats refresh", text_mutant("It never refreshes a channel's latest reading",
                                                 "It refreshes a channel's latest reading")),
        ("text: per-device bound per boot", text_mutant(
            "counting every entry for\n  a `device_id` whatever its `boot_id` or `capability_hash`, ",
            "counting the entries for\n  a `device_id` and `boot_id`, ")),
        ("text: total bound first", text_mutant(
            "Then, first, if the device\n  holds as many entries as its bound",
            "Then, after the total bound, if the device\n  holds as many entries as its bound")),
        ("text: cover item dropped", text_mutant("- a drained backlog;\n", "")),
        ("text: kind dropped", text_mutant("- restarts;\n", "")),
        ("text: corpus digest", text_mutant(
            "`909ef412cec0da86683aea72c2fdd430ce4797089166750f97c3c72db3696d83`",
            "`" + "0" * 64 + "`")),
    ]
    def normative_mutant(doc: str, mutated: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts[{'telemetry': 't2'}[doc]] = mutated
            run(corpus_bytes, contract_model(texts))
        return go

    def heading_mutant(doc: str, mutated: str) -> Callable[[], None]:
        return normative_mutant(doc, mutated)

    docs_now = {"commands": contract_texts().get("c2") or COMMANDS_V2.read_text(),
                "telemetry": contract_texts().get("t2") or TELEMETRY_V2.read_text()}
    own_doc = next(doc for doc, table in SECTION_OWNERS.items()
                   if any(who == OWNER for _, who in table))
    places = {
        "owned": next(path for path, who in SECTION_OWNERS[own_doc] if who == OWNER),
        "unowned": next(path for path, who in SECTION_OWNERS[own_doc] if who is None),
    }
    for where, path in places.items():
        at = markdown.section_offsets(docs_now[own_doc], path)[0]
        for form_name, form in markdown.HEADING_FORMS:
            mutated = (docs_now[own_doc][:at] + markdown.form_insertion(form)
                       + docs_now[own_doc][at:])
            cases.append((f"heading form in an {where} section: {form_name}",
                          heading_mutant(own_doc, mutated)))

    current = contract_texts()
    for label, doc, mutated in normative_text_mutants(
            {"commands": current.get("c2") or COMMANDS_V2.read_text(),
              "telemetry": current.get("t2") or TELEMETRY_V2.read_text()}, OWNER, MUTATE_ALWAYS):
        cases.append((label, normative_mutant(doc, mutated)))

    def guard_mutant(clause: str, flip: tuple[str, str] | None) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            texts["t2"] = guard_text(texts["t2"], clause, flip)
            run(corpus_bytes, contract_model(texts))
        return go

    for clause, flips in GUARDS:
        short = clause[:48]
        cases.append((f"guard deleted: {short}", guard_mutant(clause, None)))
        for polarity in flips:
            cases.append((f"guard reversed ({polarity[0]} -> {polarity[1]}): {short}",
                          guard_mutant(clause, polarity)))
    for c in base["cases"]:
        cases.append((f"case {c['name']} dropped", corpus_mutant(drop(c["name"]))))
    # Cases whose every covered item another case also shows.
    redundant = {
        "case accepted_exactly_an_hour_after_signing dropped":
            "hour_old_entry_survives_a_recording_with_room also accepts exactly one hour "
            "after the signing start and expects the bound",
        "case per_device_eviction dropped": "the tie, hour-old, bound-order and spans-boots "
                                            "cases also evict by the per-device bound, and "
                                            "other cases fit below it",
        "case null_nonce dropped": "rollout_failed_v2_signing_leaves_no_entry and "
                                   "rollout_reading_between_pair_unbounded also accept a v 2 "
                                   "envelope whose nonce is null",
        "case restart_before_acceptance dropped": "restart_and_restore_reissue_with_fresh_nonce "
                                                  "also accepts a nonce signed before a restart",
    }
    equivalent = [(label, m) for label, m in cases if label in redundant]
    cases = [(label, m) for label, m in cases if label not in redundant]
    # Mutants no corpus can refuse, each for the reason given.
    equivalent_reasons = {**redundant,
        "expired entries kept and counted":
            "eviction takes the earliest signing start in its scope, and every expired "
            "entry starts before every usable one, so a scope holding an expired entry "
            "evicts an expired one; usable entries are the same with or without the expiry "
            "sweep, and matching checks the hour itself, so no query can differ",
        "an entry expired only one nanosecond past the hour":
            "it keeps an expired entry one nanosecond longer, which by the reason above no "
            "query can observe",
        "a v 1 envelope matched by its nonce":
            "a v 1 envelope carries no liveness_nonce, so there is nothing to match",
        "a null nonce matched":
            "the table holds no entry for null, since every signed nonce has the grammar",
    }
    equivalent += [
        ("expired entries kept and counted", model_mutant(evict_expired=False)),
        ("an entry expired only one nanosecond past the hour", model_mutant(expiry_slack=1)),
        ("a v 1 envelope matched by its nonce", model_mutant(v1_matches=True)),
        ("a null nonce matched", model_mutant(null_matches=True)),
    ]
    survived = 0
    for label, mutant in cases + equivalent:
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError, IndexError) as refused:
            if label in equivalent_reasons:
                print(f"REFUSED (listed as equivalent) {label}: {refused}")
                survived += 1
            else:
                print(f"refused  {label}: {refused}")
        else:
            if label in equivalent_reasons:
                print(f"EQUIVALENT {label}: {equivalent_reasons[label]}")
            else:
                print(f"SURVIVED {label}")
                survived += 1
    # Heading-shaped lines that are not headings must change nothing.
    for where, path in places.items():
        at = markdown.section_offsets(docs_now[own_doc], path)[0]
        before = markdown.sections(docs_now[own_doc])
        for form_name, inserted in markdown.NOT_HEADINGS:
            mutated = docs_now[own_doc][:at] + "\n" + inserted + docs_now[own_doc][at:]
            shifted = [p for p, _, _ in markdown.sections(mutated)]
            wrong = shifted != [p for p, _, _ in before] or markdown.non_canonical(mutated)
            if not wrong and "fence" in form_name:
                try:
                    normative_mutant(own_doc, mutated)()
                except Failure as refused:
                    wrong = str(refused)
            if wrong:
                print(f"WRONGLY REFUSED not a heading, in an {where} section: {form_name}: {wrong}")
                survived += 1
            else:
                print(f"accepted not a heading, in an {where} section: {form_name}")
    print(f"{len(cases)} mutants, {len(equivalent)} known equivalent")
    return survived


def main(argv: list[str]) -> int:
    try:
        model = contract_model()
    except (Failure, ValueError) as failure:
        print(f"firmware-telemetry/v2 reading-age contract: {failure}")
        return 1
    corpus_bytes = CORPUS.read_bytes()
    try:
        run(corpus_bytes, model)
    except (Failure, KeyError, TypeError, ValueError) as failure:
        print(f"firmware-telemetry/v2 reading-age corpus: {failure!r}")
        return 1
    corpus = json.loads(corpus_bytes)
    queries = sum(1 for c in corpus["cases"] for e in c["events"] if e["kind"] == "query")
    print(
        f"firmware-telemetry/v2 reading-age corpus: {len(corpus['cases'])} cases, "
        f"{queries} queries recomputed from How Old A Reading Is"
    )
    held = [s for doc in HELD_SENTENCES.values() for body in doc.values() for s in body]
    owned = sum(len(doc) for doc in HELD_SENTENCES.values())
    print(f"{len(held)} sentences held, unchanged, in the {owned} sections this checker owns")
    if argv == ["--mutations"]:
        survived = mutations(corpus_bytes, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    elif argv:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
