"""Check the firmware-telemetry/v2 reading-age corpus against the contract.

Shares no code with scripts/generate-firmware-reading-age-vectors-v2. Every
query is recomputed by this script's own model of the signing runtime's
liveness table, built from "How Old A Reading Is" in firmware-telemetry/v2.md:
the retention and its edges, the entry's fields, the eviction order and its
tie-breaker, what a restart, a store restore and a suspension do, matching at
acceptance, the age at use and its rounding. The retention, the matching
fields, the display unit, the event kinds and the cases the corpus must cover
are read from the text, whose governing sentences are pinned word for word.
Nothing is read from the generator.

Held to:

- each case: its events are of the six kinds, carry exactly their fields, and
  run in clock order; each nonce has the grammar of firmware-commands/v2;
- each query: its bound, in nanoseconds and rounded up to whole milliseconds,
  or no bound, and a channel query's latest reading, recomputed;
- coverage: every event kind, every item the text says the cases cover (each
  as a property of the run, not of a case name), and each bound at its edge
  and one past it: matching at the hour and one nanosecond later, expiry at
  the hour and one nanosecond later, each size bound reached and not, and a
  bound a whole number of milliseconds and one that is not;
- the digest v2.md pins is the corpus's.

    python3 scripts/check-firmware-reading-age-vectors-v2
    python3 scripts/check-firmware-reading-age-vectors-v2 --mutations

`--mutations` corrupts the corpus, the contract text and this script's own
rule table and constants in turn; every mutant must be refused, except those
listed as equivalent with the reason no corpus could refuse them.
"""

from __future__ import annotations

import copy
import hashlib
import json
import pathlib
import re
import sys
from typing import Callable

import _contract_markdown as markdown

ROOT = pathlib.Path(__file__).resolve().parent.parent
CORPUS = ROOT / "firmware-telemetry" / "reading-age-vectors-v2.json"
TELEMETRY_V2 = ROOT / "firmware-telemetry" / "v2.md"
COMMANDS_V2 = ROOT / "firmware-commands" / "v2.md"


class Failure(Exception):
    pass


# --- contract text ------------------------------------------------------------------

def flat(text: str) -> str:
    return " ".join(text.split())


def section(text: str, heading: str) -> str:
    """A heading's text and its subsections, by the shared CommonMark recognizer."""
    return markdown.subtree(text, heading)


def need(text: str, sentence: str, where: str) -> None:
    if sentence not in flat(text):
        raise Failure(f"{where} no longer says: {sentence!r}")


BOUND_SENTENCES = (
    "The signing runtime keeps one entry per nonce it signs. An entry holds the liveness "
    "object's `device_id`, `boot_id` and `capability_hash`, and the signing start.",
    "**The signing start** is a reading of the runtime's clock taken before it begins "
