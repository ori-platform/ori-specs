"""Generate the firmware-command-result/v1 corpus.

Signatures come from OpenSSL through `cryptography`. Nothing here is shared
with scripts/check-firmware-command-result-vectors-v1, which verifies them with
its own curve arithmetic and reads the kinds, outcomes, reasons and the
duplicate table from the contract rather than from this file.

    python3 scripts/generate-firmware-command-result-vectors-v1          # write
    python3 scripts/generate-firmware-command-result-vectors-v1 --check  # reproduce
"""

from __future__ import annotations

import base64
import hashlib
import json
import pathlib
import sys

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "firmware-command-result" / "command-result-vectors-v1.json"

# The device seed of the firmware-telemetry/v2 fault corpus and the runtime seed
# of the firmware-commands/v2 command corpus, both disclosed and test-only.
DEVICE_SEED_HEX = "42" * 32
RUNTIME_SEED_HEX = "11" * 32
COMMAND_DOMAIN = "ori.firmware_command.v2"
DEVICE_ID = "ori-fw-7c9f2b3a"
CAPABILITY_HASH = (
    "sha256:13751b5335ccedcd4ffcc82bbda28ebfb7558859f36a74e710f1a0b0ab23da8d"
)
# A second manifest hash, for a judgment stored under an earlier approval.
EARLIER_HASH = "sha256:" + "ab" * 32
# A hash no approval of this device names, carried by a command refused as capability_mismatch.
THIRD_HASH = "sha256:" + "cd" * 32
POSTURE = "sealed_flash"
BOOT_ID = 41

REFUSAL_VERDICTS = (
    "capability_mismatch",
    "unknown_action",
    "rate_limited",
    "storage_failure",
)
DISPOSITIONS = (
    "pending",
    "capability_mismatch",
    "unknown_action",
    "rate_limited",
    "driver_ok",
    "driver_error",
)

# (name, action, channel, cmd_seq, note) for each command the digest group signs.
COMMANDS = (
    ("relay_open_1047", "relay_open", "relay0", 1047, "a protective open"),
    ("relay_close_1048", "relay_close", "relay0", 1048, "the next command, a close"),
    ("relay_open_1049_second_channel", "relay_open", "relay1", 1049, "another channel"),
)


def canonical(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def command_bytes(action: str, channel: str, cmd_seq: int) -> bytes:
    return canonical({"action": action, "capability_hash": CAPABILITY_HASH, "channel": channel,
                      "cmd_seq": cmd_seq, "device_id": DEVICE_ID, "v": 1})


def digest(body: bytes) -> str:
    preimage = COMMAND_DOMAIN.encode("ascii") + b"\x00" + body
    return "sha256:" + hashlib.sha256(preimage).hexdigest()


def build() -> bytes:
    device = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(DEVICE_SEED_HEX))
    runtime = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(RUNTIME_SEED_HEX))
    device_public = device.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    runtime_public = runtime.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    b64 = lambda raw: base64.b64encode(raw).decode("ascii")  # noqa: E731

    digests = []
    for name, action, channel, cmd_seq, note in COMMANDS:
        body = command_bytes(action, channel, cmd_seq)
        signature = "ed25519:" + b64(runtime.sign(COMMAND_DOMAIN.encode("ascii") + b"\x00" + body))
        message = b'{"command":' + body + b',"signature":"' + signature.encode() + b'"}'
        digests.append({"name": name, "note": note, "command": json.loads(body),
                        "command_hex": body.hex(), "signature": signature,
                        "message_hex": message.hex(), "command_digest": digest(body)})
    first = digests[0]["command_digest"]
    other = digests[1]["command_digest"]

    seq = 150000

    def result(kind: object, outcome: object, override: dict | None = None) -> dict:
        nonlocal seq
        seq += 1
        obj = {"v": 1, "alg": "ed25519", "device_id": DEVICE_ID, "boot_id": BOOT_ID, "seq": seq,
               "capability_hash": CAPABILITY_HASH, "posture": POSTURE,
               "device_uptime_ms": 925000 + seq - 150000, "cmd_seq": 1047,
               "command_digest": first, "kind": kind, "outcome": outcome}
        for key, value in (override or {}).items():
            if value is None:
                del obj[key]
            else:
                obj[key] = value
        return obj

    def signed(obj: dict, extra_family: bool = False) -> dict:
        body = canonical(obj)
        signature = "ed25519:" + b64(device.sign(body))
        payload: dict = {"command_result": obj, "signature": signature}
        if extra_family:
            payload["fault"] = {"code": "command_rejected"}
        return {"object": obj, "canonical_hex": body.hex(), "signature": signature,
                "payload_hex": canonical(payload).hex()}

    results = []

    def accept(name: str, note: str, obj: dict) -> None:
        results.append({"name": name, "note": note, **signed(obj), "expect": "accept",
                        "reason": None})

    def refuse(name: str, reason: str, note: str, obj: dict, extra_family: bool = False) -> None:
        results.append({"name": name, "note": note, **signed(obj, extra_family),
                        "expect": "refuse", "reason": reason})

    accept("accepted", "the device verified the command and will act on it", result("accepted", ""))
    for verdict in REFUSAL_VERDICTS:
        accept(f"refused_{verdict}", "a refusal after the signature verified",
               result("refused", verdict))
    for disposition in DISPOSITIONS:
        accept(f"duplicate_{disposition}", "a repeat of the last fresh command, answered with "
               "the disposition the device made durable", result("duplicate", disposition))
    accept("conflict", "the last fresh cmd_seq reused with other bytes", result("conflict", ""))
    accept("attempted", "the driver write began", result("attempted", ""))
    accept("driver_reported_ok", "the driver write returned success",
           result("driver_reported", "ok"))
    accept("driver_reported_error", "the driver write failed",
           result("driver_reported", "error"))
    accept("conflict_other_digest", "a result may name any digest the device verified",
           result("conflict", "", {"command_digest": other, "cmd_seq": 1048}))

    refuse("reject_extra_member", "member_set", "a member the contract does not define",
           result("accepted", "", {"note": "x"}))
    refuse("reject_missing_digest", "member_set", "command_digest is required",
           result("accepted", "", {"command_digest": None}))
    refuse("reject_missing_outcome", "member_set", "outcome is required even when empty",
           result("accepted", "", {"outcome": None}))
    refuse("reject_v_2", "unsupported_version", "this version is v 1",
           result("accepted", "", {"v": 2}))
    refuse("reject_v_string", "unsupported_version", "v is a JSON integer",
           result("accepted", "", {"v": "1"}))
    refuse("reject_feedback_observed", "unknown_kind",
           "feedback_observed is reserved and no device signs it", result("feedback_observed", ""))
    refuse("reject_kind_executed", "unknown_kind", "no kind means executed",
           result("executed", ""))
    refuse("reject_refused_bad_signature", "outcome_not_allowed",
           "an unauthenticated refusal gets no result", result("refused", "bad_signature"))
    refuse("reject_refused_malformed", "outcome_not_allowed",
           "an unauthenticated refusal gets no result", result("refused", "malformed"))
    refuse("reject_accepted_with_outcome", "outcome_not_allowed", "accepted takes no outcome",
           result("accepted", "ok"))
    refuse("reject_driver_pending", "outcome_not_allowed", "driver_reported is ok or error",
           result("driver_reported", "pending"))
    refuse("reject_driver_empty", "outcome_not_allowed", "driver_reported is ok or error",
           result("driver_reported", ""))
    refuse("reject_duplicate_accepted", "outcome_not_allowed",
           "a device never records accepted", result("duplicate", "accepted"))
    refuse("reject_duplicate_executed", "outcome_not_allowed", "no disposition means executed",
           result("duplicate", "executed"))
    refuse("reject_refused_replayed", "outcome_not_allowed",
           "a replay gets no result, only its fault", result("refused", "replayed"))
    refuse("reject_duplicate_storage_failure", "outcome_not_allowed",
           "a failed freshness write stores nothing a duplicate could answer with",
           result("duplicate", "storage_failure"))
    refuse("reject_duplicate_replayed", "outcome_not_allowed",
           "a replay is never the last fresh command's disposition",
           result("duplicate", "replayed"))
    refuse("reject_conflict_with_outcome", "outcome_not_allowed", "conflict takes no outcome",
           result("conflict", "pending"))
    refuse("reject_digest_uppercase", "digest_form", "the hex digits are lowercase",
           result("accepted", "", {"command_digest": first.upper().replace("SHA256:", "sha256:")}))
    refuse("reject_digest_no_prefix", "digest_form", "the sha256: prefix is required",
           result("accepted", "", {"command_digest": first[len("sha256:"):]}))
    refuse("reject_digest_short", "digest_form", "64 hex digits",
           result("accepted", "", {"command_digest": first[:-1]}))
    refuse("reject_two_family_keys", "family_keys",
           "a payload carries exactly one family key beside signature",
           result("accepted", ""), extra_family=True)

    def record(disposition: str, capability_hash: str = CAPABILITY_HASH,
               command_digest: str = first) -> dict:
        return {"cmd_seq": 1047, "command_digest": command_digest,
                "capability_hash": capability_hash, "disposition": disposition}

    def judgment(name: str, note: str, mark: int, rec: dict, cmd_seq: int, cmd_digest: str,
                 kind: str, outcome: str, cmd_hash: str = CAPABILITY_HASH) -> dict:
        return {"name": name, "note": note,
                "device": {"mark": mark, "capability_hash": CAPABILITY_HASH, "record": rec},
                "command": {"cmd_seq": cmd_seq, "command_digest": cmd_digest,
                            "capability_hash": cmd_hash},
                "expect": {"kind": kind, "outcome": outcome}}

    judgments = [
        judgment("below_mark", "anything below the mark is a replay, whatever its bytes, and "
                 "gets no result", 1047, record("driver_ok"), 1046, other, "none", ""),
        judgment("at_mark_other_epoch", "a judgment never crosses an approval epoch: the same "
                 "bytes, accepted under an earlier approval", 1047,
                 record("driver_ok", EARLIER_HASH), 1047, first, "none", "", EARLIER_HASH),
        judgment("at_mark_other_epoch_other_digest", "the epoch rule comes before the digest",
                 1047, record("pending", EARLIER_HASH), 1047, other, "none", ""),
        judgment("at_mark_conflict", "the last fresh cmd_seq with other bytes", 1047,
                 record("driver_ok"), 1047, other, "conflict", ""),
        judgment("at_mark_conflict_command_other_epoch", "a command at the mark naming another "
                 "capability_hash is a conflict, never capability_mismatch", 1047,
                 record("driver_ok"), 1047, other, "conflict", "", EARLIER_HASH),
        judgment("above_mark", "freshness passes", 1047, record("driver_ok"), 1048, other,
                 "new", ""),
        judgment("resend_after_storage_failure", "a failed freshness write stored nothing, so "
                 "a resend is above the mark and new", 1046,
                 {"cmd_seq": 1046, "command_digest": other, "capability_hash": CAPABILITY_HASH,
                  "disposition": "driver_ok"}, 1047, first, "new", ""),
    ] + [
        judgment(f"at_mark_duplicate_{d}", "an exact repeat answers with the stored disposition",
                 1047, record(d), 1047, first, "duplicate", d,
                 # A command refused as capability_mismatch named a hash other than the
                 # device's, and its repeat is the same bytes.
                 THIRD_HASH if d == "capability_mismatch" else CAPABILITY_HASH)
        for d in DISPOSITIONS
    ]

    def life(name: str, note: str, events: list[str], timed_out: bool, ended: bool,
             uncertain: bool, executed: bool) -> dict:
        return {"name": name, "note": note, "events": events,
                "expect": {"timed_out": timed_out, "attempts_ended": ended,
                           "outcome_uncertain": uncertain, "executed": executed,
                           "critical": "terminal_outcome_observed_differs" in events}}

    sent = ["signed", "issued"]
    lifecycle = [
        life("signed_only", "signed and not yet published", ["signed"], False, False, True, False),
        life("issued_only", "published is not executed", sent, False, False, True, False),
        life("accepted_only", "accepted is not executed, and ends no attempt",
             sent + ["device_accepted"], False, False, True, False),
        life("attempted_only", "a write begun ends no attempt",
             sent + ["device_accepted", "actuation_attempted"], False, False, True, False),
        life("driver_ok", "driver acceptance ends attempts, not uncertainty",
             sent + ["device_accepted", "actuation_attempted", "driver_reported_ok"],
             False, True, True, False),
        life("driver_ok_alone", "accepted and attempted are optional before driver_reported",
             sent + ["driver_reported_ok"], False, True, True, False),
        life("driver_error", "a failed write leaves attempts going",
             sent + ["device_accepted", "actuation_attempted", "driver_reported_error"],
             False, False, True, False),
        life("driver_error_then_deadline", "driver_reported(error) is final for the deadline "
             "and ends no attempt",
             sent + ["device_accepted", "actuation_attempted", "driver_reported_error",
                     "deadline_passed"], False, False, True, False),
        life("driver_ok_then_deadline", "a driver result is final, so no timed_out follows",
             sent + ["device_accepted", "actuation_attempted", "driver_reported_ok",
                     "deadline_passed"], False, True, True, False),
        life("attempted_then_deadline", "attempted is not final",
             sent + ["device_accepted", "actuation_attempted", "deadline_passed"],
             True, False, True, False),
        life("driver_error_without_attempted", "a channel with no driver mapping: an error and "
             "no write begun", sent + ["device_accepted", "driver_reported_error"],
             False, False, True, False),
        life("deadline_with_nothing", "absence is in doubt", sent + ["deadline_passed"],
             True, False, True, False),
        life("deadline_after_accepted", "accepted is not final",
             sent + ["device_accepted", "deadline_passed"], True, False, True, False),
        life("late_driver_ok", "a late result appends and ends attempts from then on",
             sent + ["device_accepted", "deadline_passed", "driver_reported_ok"],
             True, True, True, False),
        life("refused_then_deadline", "a refusal is final, so no timed_out follows",
             sent + ["device_refused", "deadline_passed"], False, False, True, False),
        life("conflict_then_deadline", "a conflict is final",
             sent + ["device_conflict", "deadline_passed"], False, False, True, False),
        life("duplicate_driver_ok", "a duplicate re-signing driver_ok is driver acceptance",
             sent + ["device_duplicate_driver_ok"], False, True, True, False),
        life("duplicate_pending_then_deadline", "a duplicate answering pending is not final",
             sent + ["device_duplicate_pending", "deadline_passed"], True, False, True, False),
        life("duplicate_refusal", "a duplicate of a refused command is final and ends nothing",
             sent + ["device_duplicate_rate_limited", "deadline_passed"],
             False, False, True, False),
        life("unconfirmed_then_driver_ok", "results attach to an unconfirmed publication",
             ["signed", "publish_unconfirmed", "driver_reported_ok"], False, True, True, False),
        life("unconfirmed_then_nothing", "an unconfirmed publication reaches timed_out",
             ["signed", "publish_unconfirmed", "deadline_passed"], True, False, True, False),
        life("observed_matches", "executed means observed",
             sent + ["driver_reported_ok", "terminal_outcome_observed_matches"],
             False, True, False, True),
        life("observed_then_driver_ok", "attribution does not depend on order: the device "
             "evidence may attach after the observation",
             sent + ["terminal_outcome_observed_matches", "driver_reported_ok"],
             False, True, False, True),
        life("observed_differs", "observed, and not the state commanded",
             sent + ["driver_reported_ok", "terminal_outcome_observed_differs"],
             False, True, False, False),
        life("observed_without_driver_ok", "an observation is not driver acceptance, and "
             "without device evidence it is not attributed to the command",
             sent + ["deadline_passed", "terminal_outcome_observed_matches"],
             True, False, False, False),
        life("refused_then_observed", "the commanded state observed after a signed refusal: "
             "known, and not this command's doing",
             sent + ["device_refused", "terminal_outcome_observed_matches"],
             False, False, False, False),
        life("duplicate_driver_ok_then_observed", "a duplicate re-signing driver_ok attributes "
             "the observation",
             sent + ["device_duplicate_driver_ok", "terminal_outcome_observed_matches"],
             False, True, False, True),
    ]

    corpus = {
        "contract": "ori-specs/firmware-command-result/v1.md",
        "version": 1,
        "comment": (
            "Golden vectors for firmware-command-result/v1. A receiver must accept every "
            "'results' case whose expect is accept and refuse every other with its declared "
            "reason, judging each on its own against verifier_context. 'digests', "
            "'judgments' and 'lifecycle' fix the command digest, the device's duplicate "
            "table and the runtime's conclusions. Signed with disclosed TEST-ONLY seeds: "
            "never provision them."
        ),
        "device_test_seed_hex": DEVICE_SEED_HEX,
        "device_public_key_b64": b64(device_public),
        "runtime_test_seed_hex": RUNTIME_SEED_HEX,
        "runtime_public_key_b64": b64(runtime_public),
        "signature_encoding": "ed25519:<standard-base64-64-byte-signature>",
        "verifier_context": {"device_id": DEVICE_ID, "capability_hash": CAPABILITY_HASH,
                             "posture": POSTURE, "public_key_b64": b64(device_public)},
        "reasons": {
            "member_set": "a member the contract does not define, or a required one missing",
            "unsupported_version": "v is not the integer 1",
            "unknown_kind": "kind is not one of the six kinds",
            "outcome_not_allowed": "outcome is not one its kind allows",
            "digest_form": "command_digest is not sha256: and 64 lowercase hex digits",
            "family_keys": "the payload carries more than one family key beside signature",
        },
        "results": results,
        "digests": digests,
        "judgments": judgments,
        "lifecycle": lifecycle,
    }
    return (json.dumps(corpus, indent=2, ensure_ascii=False) + "\n").encode("utf-8")


def main(argv: list[str]) -> int:
    data = build()
    if argv == ["--check"]:
        if OUT.read_bytes() != data:
            print(f"{OUT.relative_to(ROOT)} does not reproduce from its generator")
            return 1
        print(f"{OUT.relative_to(ROOT)} reproduces byte for byte")
        return 0
    if argv:
        print(__doc__)
        return 2
    OUT.write_bytes(data)
    print(f"wrote {OUT.relative_to(ROOT)} sha256 {hashlib.sha256(data).hexdigest()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
