        ("3a degraded row dropped", text_mutant(
            "g", "| yes | `false` | `degraded` | any array | `degraded` |", "")),
        ("3b ok row takes status ok", text_mutant(
            "g", "| yes | absent | `[]` | `ok` |", "| yes | absent, or `ok` | `[]` | `ok` |")),
        ("3b degraded row reads ok", text_mutant(
            "g", "| yes | `degraded` | any array | `degraded` |",
            "| yes | `degraded` | `[]` | `ok` |")),
        ("a row read when not well formed", text_mutant(
            "g", "| yes | absent | `[]` | `ok` |", "| no | absent | `[]` | `ok` |")),
        ("sensors no longer required", text_mutant(
            "g", "| `sensors` | array | 3a and 3b |", "| `sensors` | array | 3a |")),
        ("uptime typed as a string", text_mutant(
            "g", "| `uptime_s` | number | 3a and 3b |", "| `uptime_s` | string | 3a and 3b |")),
        ("safety loses null", text_mutant(
            "g", "| `safety` | object, or `null` | 3a and 3b |",
            "| `safety` | object | 3a and 3b |")),
        ("a later member required in 3b", text_mutant(
            "g", "| `firmware_reading_age`, `firmware_controller_profiles` | object | 3a |",
            "| `firmware_reading_age`, `firmware_controller_profiles` | object | 3a and 3b |")),
        ("evidence dropped from the member table", text_mutant(
            "g", "`device_policy`, `evidence`, `firmware_liveness`",
            "`device_policy`, `firmware_liveness`")),
        ("safety_zones not listed for 3b", text_mutant(
            "g", "; listed for 3b's closed set", "")),
        ("3b's set opened", text_mutant(
            "g", "For 3b, every other top-level member must also be one the table lists for it",
            "For 3b, other top-level members may be any")),
        ("present members no longer typed", text_mutant(
            "g", "every member the table lists that is present has that type too,", "")),
        ("device comparison no longer exact", text_mutant(
            "g", ", compared exactly as a JSON string.", ".")),
        ("status not listed for 3b", text_mutant(
            "g", "present only while a condition holds; listed for 3b's closed set |",
            "present only while a condition holds |")),
        ("device check removed", text_mutant(
            "g", "and its `device_id` is the device the export was requested from,",
            "and,")),
        ("null read as absent", text_mutant(
            "g", "is present, not absent, and is of the type `null`.",
            "is absent.")),
        ("well-formed rule removed", text_mutant(
            "g", "or from an unmarked item that is well formed for its encoding below and "
            "states that no condition holds", "or from an unmarked item")),
        ("critical rule spares malformed items", text_mutant(
            "g", "its other members, whether it is well formed, or the latch below",
