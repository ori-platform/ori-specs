            "g", "**When cases 3a and 3b end.**", "4. **Fallback.** Anything else is `ok`.\n\n"
            "**When cases 3a and 3b end.**")),
        # the model
        ("3b required members shrunk to device_id", model_mutant(
            lambda m: m["required"].update({"3b": ["device_id"]}))),
        ("3b closed set opened", model_mutant(
            lambda m: m.update(closed_3b=m["closed_3b"] + ["telemetry_rollup",
                                                           "firmware_reading_age"]))),
        ("degradation_reasons typed object", model_mutant(
            lambda m: m["types"].update(degradation_reasons=["object"]))),
        ("projection dropped from the model", model_mutant(
            lambda m: m["only"].remove("projection"))),
        # planted reading bugs
        *[(f"bug: {name}", bug(name)) for name in BUGS],
    ]
    survived = 0
    for label, mutant in cases:
        try:
            mutant()
        except (Failure, KeyError, StopIteration, ValueError, TypeError) as refused:
            print(f"refused  {label}: {refused}")
        else:
            print(f"SURVIVED {label}")
            survived += 1
    return survived


def main(argv: list[str]) -> int:
    if argv not in ([], ["--mutations"]):
        print(__doc__)
        return 2
    try:
        model = contract_model()
        check_model(model)
    except (Failure, ValueError) as failure:
        print(f"gateway-api/v2 health transition text: {failure}")
        return 1
    corpus = json.loads(CORPUS.read_bytes())
    baselines = json.loads(BASELINES.read_bytes())
    try:
        check(corpus, baselines, model)
    except Failure as failure:
        print(f"gateway-api/v2 health-transition corpus: {failure}")
        return 1
    print(f"gateway-api/v2 health-transition corpus: {len(corpus['cases'])} cases read as "
          "the text reads them; both producer exports well formed")
    if argv == ["--mutations"]:
        survived = mutations(corpus, baselines, model)
        if survived:
            print(f"{survived} mutant(s) survived")
            return 1
        print("every mutant refused")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
