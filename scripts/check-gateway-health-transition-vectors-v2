"""Check the gateway-api/v2 health-transition corpus against the contract.

Shares no code with scripts/generate-gateway-health-transition-vectors-v2, and
was written without reading it. The reading is modelled here from gateway-api/v2.md
`health` > "Reading `status` while runtimes adopt runtime-health/v4": the
marker, the severities, the five projection-only members, 3a's and 3b's
severity tables and the member table (members, JSON types, the encodings that
require them) are parsed from the text; the rules whose prose cannot be parsed
reliably (the two rules before the readings, well-formedness, the latch, case
1's and case 2's outcomes) are held to their sentences word for word,
whitespace folded.

Held to:

- the text: the subsection sits under `health`; two rules, then three numbered
  readings; the marker equals runtime-health/v4's `projection` row; the
  severities are runtime-health/v4's `status` vocabulary; each projection-only
  member is a v4 Remote Health Projection member and is in neither
  runtime-health/v3's Health Payload nor the member table; every v3 member is
  in the member table; 3a requires exactly 3b's members, `critical` and the
  later members the text names twice, each a v4 projection member; every
  severity-table row that yields `ok` requires an empty `degradation_reasons`;
- the baselines: each producer export in health-transition-baselines-v2.json
  is well formed for its encoding and reads `ok`;
- the header: contract anchor, version, baselines file, severities in v4's
  order plus unknown, unique case names, exact keys and JSON types;
- every case: severity and latched_after as the model here reads them, and no
  `ok` except from a marked `status: "ok"` or a well-formed unmarked item with
  an empty `degradation_reasons`;
- coverage, for each encoding: the exact and the started producer export;
  every required member absent and mistyped; another device; each
  `degradation_reasons` shape; each `status`; the critical rule overriding a
  malformed item; 3a's open member set and 3b's closed one; and, as before,
  the marked readings, each projection-only member alone, the near-miss
  markers and the latch before and after.

    python3 scripts/check-gateway-health-transition-vectors-v2
    python3 scripts/check-gateway-health-transition-vectors-v2 --mutations

`--mutations` corrupts the corpus, the baselines, the contract text and the
model, and plants a reading bug in turn; every mutant must be refused.
"""

from __future__ import annotations

import copy
import importlib.machinery
import importlib.util
import json
import pathlib
import re
import sys
from typing import Callable

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / "gateway-api" / "v2.md"
HEALTH_V3 = ROOT / "runtime-health" / "v3.md"
HEALTH_V4 = ROOT / "runtime-health" / "v4.md"
CORPUS = ROOT / "gateway-api" / "vectors" / "health-transition-v2.json"
BASELINES_NAME = "health-transition-baselines-v2.json"
BASELINES = CORPUS.parent / BASELINES_NAME
HEADING = "#### Reading `status` while runtimes adopt runtime-health/v4"
PARENT = "## Supported Export Types > ### `health`"
NUMBER_WORDS = {"two": 2, "three": 3, "four": 4, "five": 5, "six": 6}
# Which encoding each producer export is. `v2.5.0` is the text's own name for
# 3b's release; e4ba3e92 is a runtime commit after it, which the text cannot
# name, so this map is held here.
BASELINE_ENCODING = {"v2.5.0": "3b", "e4ba3e92": "3a"}
# A started runtime: what the corpus's started bases change, each a value the
# text's types admit (the unstarted exports carry safety null, an empty path
# and uptime 0.0).
STARTED = {"safety": {}, "uptime_s": 812.5}

# Sentences whose rules the model below implements by its own code. A data
# check cannot see their meaning change, so each is held word for word.
HELD = (
    # what runtimes write today
    "Among them are `status`, present only while a condition holds; "
    "`degradation_reasons`, always present and `[]` when no condition holds; "
    "`safety_zones`, present while the runtime has a safety registry; and "
    "`critical`. Runtime releases after v2.5.0 write `critical` always, as a JSON "
    "boolean; v2.5.0 writes it only when it is `true`.",
    # the order: verification, then two rules, then the readings
    "A gateway reads the severity of `items[0]` only once its response has "
    "verified under the [Export Auth Envelope](#export-auth-envelope), and then "
    "by two rules before any other:",
    # rule 1
    "**Critical is never read as less.** An item whose `critical` is the JSON "
    "boolean `true`, or whose `status` is the string `critical`, reads "
    "`critical`, whatever its `projection`, its other members, whether it is well "
    "formed, or the latch below.",
    # rule 2
    "**Health is read only from a well-formed item.** A reading yields `ok` only "
    "from an explicit `status` of `ok` in a marked item, or from an unmarked item "
    "that is well formed for its encoding below and states that no condition "
    "holds. A missing, mistyped or inconsistent member is never read as health.",
    # case 1
    "When `projection` is the string",
    "the item is the projection, and its severity is its `status`:",
    "is that severity. A `status` that is absent, any other string, or not a "
    "string is `unknown`, and is logged. This reading uses `status` and the rule "
    "above alone; the projection's other members are read under "
    "runtime-health/v4's own consumer rules.",
    # case 2
    "**Unmarked, with a projection-only member.** When `projection` is absent or "
    "is not that string, and the item carries any of",
    "it is neither shape. It is `unknown`, logged, and never read as a snapshot.",
    # case 3: well formed
    "**Unmarked otherwise,** read as a pre-v4 snapshot in one of two encodings. "
    "An item is **well formed** for an encoding when every member the table "
    "below requires for it is present with the JSON type the table gives, every "
    "member the table lists that is present has that type too, and its "
    "`device_id` is the device the export was requested from, compared exactly "
    "as a JSON string. For 3b, "
    "every other top-level member must also be one the table lists for it: that "
    "closed set is the v2.5.0 fingerprint. For 3a the table is a minimum, and a "
    "later release may send further members. Members are checked at the top "
    "level only; their contents are the runtime's own detail. A member present "
    "as JSON `null` is present, not absent, and is of the type `null`.",
    # 3a and 3b
    "**3a, a release after v2.5.0.** An item that carries `critical` reads by "
    "this table, and anything it does not list is `unknown`, logged:",
    "**3b, the v2.5.0 encoding.** v2.5.0 writes `critical` only when it is "
    "`true` and `status` only while a condition holds, so its healthy export "
    "carries neither: their absence, with `degradation_reasons` `[]`, is that "
    "runtime's signed verdict that no condition holds. An item that carries no "
    "`critical` reads by this table, and anything it does not list is "
    "`unknown`, logged:",
    "v2.5.0 never writes `status` `ok`, so an item of this encoding that does "
    "is `unknown`.",
    "In both, a non-empty `degradation_reasons` beside an absent or `ok` "
    "`status` is inconsistent, since a runtime that names a reason also "
    "degrades `status`, and reads `unknown`. A gateway tests "
    "`degradation_reasons` only for emptiness: it never projects or logs a "
    "reason string. Likewise it checks `health_socket_path` only for its type and "
    "never projects or logs it, since it is a filesystem path, and compares "
    "`device_id` only with the requested device.",
    "lists a member v2.5.0 never sends, so it is not well formed for 3b.",
    # what the tables rest on
    "The tables recognise a shape, not a producer: another producer that sent the "
    "same members would be read the same way.",
    "so an item from one that omitted `critical` is not well formed for either "
    "encoding and reads `unknown`. A later release that broke that would be read "
    "wrongly, which is why each release keeps it.",
    "A gateway reads such an export as `degraded`, because the producer has "
    "already discarded the critical indication.",
    # the latch
    "**Once a device serves the projection, it is held to it.** A gateway that "
    "has read a marked item, whatever its severity, from the device an export was "
    "requested from refuses every later unmarked item from that device, as "
    "`unknown`, logged, for as long as the gateway runs, except that an item the "
    "rule above reads `critical` still reads `critical`.",
    "The device is the one the request named and the response's topic carried, "
    "both verified, never the item's own `device_id` member, which its sender "
    "writes. It holds this in memory only.",
    "reads `unknown` until the gateway restarts, unless it reports critical: that "
    "fails towards `unknown`, visibly, and never towards `ok`.",
    "Verification says who sent an item, not that it is well formed, which is why "
    "both are required.",
    "Every consumer of the health export, the weekly report and the site health "
    "projection among them, reads severity through this one reading.",
    "[vectors/health-transition-v2.json](vectors/health-transition-v2.json) fixes "
    "these readings, from exports two runtime releases produced.",
)

ABSENT = object()
CASE_KEYS = {"name", "note", "requested_device_id", "latched", "item", "expect"}
HEADER_KEYS = {"contract", "version", "comment", "baselines", "severities", "cases"}
TYPES: dict[str, Callable[[object], bool]] = {
    "string": lambda v: type(v) is str,
    "number": lambda v: type(v) in (int, float),
    "array": lambda v: type(v) is list,
    "object": lambda v: type(v) is dict,
    "boolean": lambda v: type(v) is bool,
    "`null`": lambda v: v is None,
}
# Reading bugs a mutant may plant; the real reading plants none.
BUGS = (
    "3b_names_only",            # Codex's P1: 3b by member names alone, so {} reads ok
    "no_required", "no_types", "no_device", "number_accepts_string",
    "safety_object_only", "null_is_absent", "3a_closed", "3b_open",
    "optional_unchecked", "device_normalised",
    "reasons_unchecked", "reasons_null_empty", "rule1_needs_well_formed",
    "critical_rule_off", "status_rule_off", "latch_spares_status_critical",
    "truthy_critical", "string_true_critical", "absent_critical_false",
    "string_false_bool", "marker_prefix", "marker_rstrip", "no_latch",
    "latch_on_item_device", "case2_off", "3b_status_ok", "status_rstrip",
)


class Failure(Exception):
    pass


def _contract_markdown():
    """scripts/contract-markdown, by path: the repository holds no *.py file."""
    path = pathlib.Path(__file__).resolve().parent / "contract-markdown"
    loader = importlib.machinery.SourceFileLoader("contract_markdown", str(path))
    spec = importlib.util.spec_from_loader("contract_markdown", loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["contract_markdown"] = module
    loader.exec_module(module)
    return module


CM = _contract_markdown()


def fold(text: str) -> str:
    return " ".join(text.split())


def github_anchor(title: str) -> str:
    """The anchor GitHub renders for a heading: lower case, punctuation other
    than `-` and `_` dropped, each space a hyphen."""
    return re.sub(r"[^\w\- ]", "", title.lower()).replace(" ", "-")


def _ticked(text: str) -> list[str]:
    return re.findall(r"`([^`]+)`", text)


def _ticked_list(text: str, what: str) -> list[str]:
    """`a`, `b` or `c` / `a`, `b` and `c`, exactly, as a list."""
    if not re.fullmatch(r"(?:`[a-z_0-9]+`, )*`[a-z_0-9]+` (?:or|and) `[a-z_0-9]+`", text):
        raise Failure(f"{what} not understood: {text!r}")
    names = _ticked(text)
    if len(set(names)) != len(names):
        raise Failure(f"{what} repeats a member: {names!r}")
    return names


def _table_rows(body: str) -> list[list[str]]:
    rows = []
    for line in body.split("\n"):
        match = re.fullmatch(r"\s*\|(.*)\|\s*", line)
        if match:
            rows.append([cell.strip() for cell in match.group(1).split("|")])
    return rows


def _first_column_members(body: str) -> set[str]:
    rows = _table_rows(body)
    if len(rows) < 3 or not re.fullmatch(r"[-: ]+", "".join(rows[1])):
        raise Failure("no member table")
    out: set[str] = set()
    for row in rows[2:]:
        out.update(_ticked(row[0]))
    return out


def _between(body: str, start: str, end: str) -> str:
    match = re.search(re.escape(start) + r"(.*?)" + re.escape(end), body, re.S)
    if match is None:
        raise Failure(f"no text between {start!r} and {end!r}")
    return match.group(1)


# --- contract text ------------------------------------------------------------

def contract_texts() -> dict[str, str]:
    return {"g": CONTRACT.read_text(), "v3": HEALTH_V3.read_text(),
            "v4": HEALTH_V4.read_text()}


def _alternatives(cell: str) -> list[str]:
    return [part for part in re.split(r",\s*(?:or\s+)?|\s+or\s+", cell) if part]


# A severity-table cell, as a predicate on the member's value (ABSENT when the
# item lacks it). The phrases are the tables' whole vocabulary.
def _cell(column: str, cell: str) -> list[tuple[str, object]]:
    alts: list[tuple[str, object]] = []
    for alt in _alternatives(cell):
        if alt in ("absent", "any array", "yes"):
            alts.append(("phrase", alt))
        elif alt == "`[]`":
            alts.append(("empty", None))
        elif alt in ("`true`", "`false`"):
            alts.append(("literal", alt == "`true`"))
        elif re.fullmatch(r"`[a-z]+`", alt):
            alts.append(("literal", alt[1:-1]))
        else:
            raise Failure(f"{column} cell phrase not understood: {alt!r}")
    if column == "Well formed" and alts != [("phrase", "yes")]:
        raise Failure(f"a severity row is read from an item not well formed: {cell!r}")
    return alts


def _severity_table(body: str, columns: list[str]) -> list[dict]:
    rows = _table_rows(body)
    if len(rows) < 3 or rows[0] != columns + ["Severity"]:
        raise Failure(f"severity table header is {rows[:1]!r}")
    if not all(re.fullmatch(r"-{3,}", cell) for cell in rows[1]):
        raise Failure("severity table has no separator row")
    parsed = []
    for row in rows[2:]:
        if len(row) != len(columns) + 1 or not re.fullmatch(r"`[a-z]+`", row[-1]):
            raise Failure(f"severity row not understood: {row!r}")
        parsed.append({"cells": {name.strip("`"): _cell(name, cell)
                                 for name, cell in zip(columns, row)},
                       "severity": row[-1][1:-1], "text": tuple(row)})
    return parsed


def _member_table(body: str) -> dict:
    rows = _table_rows(body)
    if len(rows) < 3 or rows[0] != ["Member", "JSON type", "Required in"]:
        raise Failure(f"member table header is {rows[:1]!r}")
    types: dict[str, list[str]] = {}
    required: dict[str, set[str]] = {"3a": set(), "3b": set()}
    optional: set[str] = set()
    for row in rows[2:]:
        if len(row) != 3:
            raise Failure(f"member row not understood: {row!r}")
        names = _ticked(row[0])
        if not names or fold(", ".join(f"`{n}`" for n in names)) != fold(row[0]):
            raise Failure(f"member cell not understood: {row[0]!r}")
        kinds = _alternatives(row[1])
        if not kinds or any(k not in TYPES for k in kinds):
            raise Failure(f"JSON type not understood: {row[1]!r}")
        where = row[2]
        if where == "3a and 3b":
            encodings = {"3a", "3b"}
        elif where in ("3a", "3b"):
            encodings = {where}
        elif re.fullmatch(r"neither: present only while [^;|]+(?:; listed for 3b's "
                          r"closed set)?", where):
            encodings = set()
        else:
            raise Failure(f"required-in cell not understood: {where!r}")
        for name in names:
            if name in types:
                raise Failure(f"member table lists {name} twice")
            types[name] = kinds
            for encoding in encodings:
                required[encoding].add(name)
            if not encodings and where.endswith("; listed for 3b's closed set"):
                optional.add(name)
    return {"types": types, "required": required, "optional": optional}


def contract_model(texts: dict[str, str] | None = None) -> dict:
    texts = contract_texts() if texts is None else texts
    g = texts["g"]
    paths = [path for path, _, _ in CM.sections(g) if path.endswith(HEADING)]
    if paths != [PARENT + " > " + HEADING]:
        raise Failure(f"subsection not found once under `health`: {paths!r}")
    body = CM.own_body(g, HEADING)
    if CM.non_canonical(body):
        raise Failure(f"subsection holds non-canonical lines: {CM.non_canonical(body)[:3]}")
    flat = fold(body)
    for sentence in HELD:
        if fold(sentence) not in flat:
            raise Failure(f"gateway-api/v2.md no longer says: {sentence!r}")

    # Two rules, then three numbered readings, as the text counts them.
    rules = re.search(r"and then by (\w+) rules before any other:(.*?)Otherwise a gateway",
                      flat)
    if rules is None:
        raise Failure("the rules before the readings are not found")
    bullets = re.findall(r"(?:^|\s)- \*\*", rules.group(2))
    if NUMBER_WORDS.get(rules.group(1)) != len(bullets):
        raise Failure(f"the text counts {rules.group(1)} rules and states {len(bullets)}")
    ways = re.search(r"Otherwise a gateway reads it in one of (\w+) ways, which decide only "
                     r"between `([a-z]+)`, `([a-z]+)` and `([a-z]+)`:", flat)
    if ways is None:
        raise Failure("the three readings' sentence is not found")
    numbered = re.findall(r"^ {0,3}(\d+)\. \*\*", body, re.M)
    if numbered != [str(n) for n in range(1, NUMBER_WORDS.get(ways.group(1), 0) + 1)] \
            or len(numbered) != 3:
        raise Failure(f"readings numbered {numbered!r} for {ways.group(1)} ways")

    marker = re.search(r"When `projection` is the string `([^`]+)`, the item is the "
                       r"projection", flat)
    if marker is None:
        raise Failure("case 1 names no marker")
    sev = re.search(r"its severity is its `status`: `([a-z]+)` or `([a-z]+)` is that "
                    r"severity\.", flat)
    if sev is None:
        raise Failure("case 1 names no severities")
    marked_severities = list(sev.groups())
    unknown = re.search(r"or not a string is `([a-z]+)`, and is logged", flat)
    if unknown is None or unknown.group(1) in marked_severities:
        raise Failure("case 1 names no unknown severity")
    rule = re.search(r"An item whose `critical` is the JSON boolean `(true)`, or whose "
                     r"`status` is the string `([a-z]+)`, reads `([a-z]+)`", flat)
    if rule is None or rule.group(2) != rule.group(3):
        raise Failure("the critical rule names no severity, or a status other than it")
    critical = rule.group(3)
    decided = set(ways.groups()[1:])
    if decided != set(marked_severities) | {unknown.group(1)} or critical in decided:
        raise Failure(f"the readings decide {sorted(decided)}, not case 1's severities "
                      "plus unknown")

    members = re.search(r"and the item carries any of (.*?), it is neither shape\.", flat)
    if members is None:
        raise Failure("case 2 lists no members")
    only = _ticked_list(members.group(1), "case 2 member list")
    count = re.search(r"No runtime release has sent any of these (\w+) outside the "
                      r"projection\.", flat)
    if count is None or NUMBER_WORDS.get(count.group(1)) != len(only):
        raise Failure(f"case 2 lists {only!r}, which the text does not count")

    # Case 3: two severity tables and one member table.
    table_3a = _severity_table(
        _between(body, "**3a, a release after v2.5.0.**", "**3b, the v2.5.0 encoding.**"),
        ["Well formed", "`critical`", "`status`", "`degradation_reasons`"])
    table_3b = _severity_table(
        _between(body, "**3b, the v2.5.0 encoding.**", "In both, a non-empty"),
        ["Well formed", "`status`", "`degradation_reasons`"])
    members_table = _member_table(
        _between(body, "because this reading takes every reason as degrading.",
                 "The tables recognise a shape"))
    types, required = members_table["types"], members_table["required"]
    # 3b's closed set: what the table requires for it, and the rows it lists
    # "for 3b's closed set". 3b's own table reads `status`, so it must be one.
    closed_3b = required["3b"] | members_table["optional"]
    if "status" not in closed_3b:
        raise Failure("3b's table reads `status`, which its closed set does not list")
    for row in table_3a + table_3b:
        if row["severity"] not in decided:
            raise Failure(f"severity row {row['text']!r} reads outside {sorted(decided)}")
        if row["severity"] == "ok" and row["cells"]["degradation_reasons"] != [("empty", None)]:
            raise Failure(f"severity row {row['text']!r} reads ok beside a reason")
    if any(row["severity"] == "ok" and ("literal", "ok") in row["cells"]["status"]
           for row in table_3b):
        raise Failure("3b's table reads an explicit `status` `ok` as ok")

    # The later members, named twice, are exactly what 3a requires beyond 3b.
    later_a = re.search(r"An item of the v2\.5\.0 encoding that carried (.*?) lists a "
                        r"member v2\.5\.0 never sends", flat)
    later_b = re.search(r"every release after v2\.5\.0 writes `critical` always and sends "
                        r"(.*?), so an item from one", flat)
    if later_a is None or later_b is None:
        raise Failure("the later members are not named")
    later = _ticked_list(later_a.group(1), "later members")
    if set(later) != set(_ticked_list(later_b.group(1), "later members")):
        raise Failure("the two lists of later members differ")
    if required["3a"] != required["3b"] | {"critical"} | set(later):
        raise Failure("3a does not require exactly 3b's members, `critical` and the "
                      "later members")
    if types.get("critical") != ["boolean"] or "critical" in closed_3b:
        raise Failure("`critical` is not a 3a-only boolean")
    if set(later) & closed_3b:
        raise Failure("a later member is in 3b's closed set")

    # runtime-health/v4 and v3 cross-checks.
    v4, v3 = texts["v4"], texts["v3"]
    projection_body = CM.own_body(v4, "## Remote Health Projection")
    projection_members = _first_column_members(projection_body)
    row = re.search(r"^\| `projection` \| `([^`]+)`\. \|\s*$", projection_body, re.M)
    if row is None or row.group(1) != marker.group(1):
        raise Failure("the marker differs from runtime-health/v4's `projection` row")
    v4_payload = CM.own_body(v4, "## Health Payload")
    status_row = re.search(r"^\| `status` \| `string` \| `([a-z]+)`, `([a-z]+)` or "
                           r"`([a-z]+)`\.", v4_payload, re.M)
    if status_row is None or set(status_row.groups()) != set(marked_severities) | {critical}:
        raise Failure("case 1's and the critical rule's severities differ from "
                      "runtime-health/v4's `status`")
    severities = list(status_row.groups())
    v3_members = _first_column_members(CM.own_body(v3, "## Health Payload"))
    for name in only:
        if name not in projection_members:
            raise Failure(f"{name} is not a runtime-health/v4 projection member")
        if name in v3_members or name in types:
            raise Failure(f"{name} is a v3 or a pre-v4 snapshot member")
    for name in later:
        if name not in projection_members:
            raise Failure(f"{name} is not a runtime-health/v4 projection member")
    if not v3_members <= set(types):
        raise Failure(f"the member table lacks v3's {sorted(v3_members - set(types))}")
    if {"status", "degradation_reasons", "critical"} & v3_members:
        raise Failure("runtime-health/v3 defines a member the text says it does not")
    return {"marker": marker.group(1), "severities": severities,
            "marked": marked_severities, "unknown": unknown.group(1),
            "critical": critical, "only": only,
            "tables": {"3a": table_3a, "3b": table_3b},
            "types": types, "required": {k: sorted(v) for k, v in required.items()},
            "closed_3b": sorted(closed_3b), "later": later,
            "anchor": github_anchor(HEADING.lstrip("# "))}


# --- the reading ----------------------------------------------------------------

def is_marked(item: dict, model: dict, bugs: frozenset[str]) -> bool:
    value = item.get("projection", ABSENT)
    if type(value) is not str:
        return False
    if "marker_prefix" in bugs and value.startswith(model["marker"]):
        return True
    if "marker_rstrip" in bugs and value.rstrip() == model["marker"]:
        return True
    return value == model["marker"]


def encoding(item: dict) -> str:
    """3a for an item that carries `critical`, 3b for one that carries none."""
    return "3a" if "critical" in item else "3b"


def typed(name: str, value: object, model: dict, bugs: frozenset[str]) -> bool:
    kinds = model["types"][name]
    if "safety_object_only" in bugs:
        kinds = [k for k in kinds if k != "`null`"]
    if "number_accepts_string" in bugs and "number" in kinds and type(value) is str:
        return True
    return any(TYPES[kind](value) for kind in kinds)


def well_formed(item: dict, enc: str, requested: str, model: dict,
                bugs: frozenset[str] = frozenset()) -> bool:
    if enc == "3b" and "3b_names_only" in bugs:
        return all(name in model["closed_3b"] for name in item)
    for name in model["required"][enc]:
        value = item.get(name, ABSENT)
        if "null_is_absent" in bugs and value is None:
            value = ABSENT
        if value is ABSENT:
            if "no_required" in bugs:
                continue
            return False
        if "no_types" not in bugs and not typed(name, value, model, bugs):
            return False
    # Every listed member that is present has its type too.
    if "no_types" not in bugs and "optional_unchecked" not in bugs:
        for name, value in item.items():
            if name in model["types"] and not typed(name, value, model, bugs):
                return False
    device = item.get("device_id", ABSENT)
    if "device_normalised" in bugs and type(device) is str:
        device = device.strip().casefold()
    if "no_device" not in bugs and not (type(device) is str and device == requested):
        return False
    closed = (enc == "3b" and "3b_open" not in bugs) or (enc == "3a" and "3a_closed" in bugs)
    if closed:
        allowed = set(model["closed_3b"]) if enc == "3b" else \
            set(model["required"]["3a"]) | set(model["types"])
        if not set(item) <= allowed:
            return False
    return True


def _cell_matches(alts: list[tuple[str, object]], value: object, wf: bool) -> bool:
    for kind, token in alts:
        if kind == "phrase" and token == "yes" and wf:
            return True
        if kind == "phrase" and token == "absent" and value is ABSENT:
            return True
        if kind == "phrase" and token == "any array" and type(value) is list:
            return True
        if kind == "empty" and type(value) is list and value == []:
            return True
        if kind == "literal" and value is not ABSENT and type(value) is type(token) \
                and value == token:
            return True
    return False


def read(item: dict, requested: str, latched: bool, model: dict,
         bugs: frozenset[str] = frozenset()) -> tuple[str, bool]:
    """(severity, latched_after) for items[0] of a verified response."""
    critical = item.get("critical", ABSENT)
    status = item.get("status", ABSENT)
    marked = is_marked(item, model, bugs)
    if "latch_on_item_device" in bugs:
        latched = latched and item.get("device_id") == requested
    if "no_latch" in bugs:
        latched = False
    # The latch is held for any marked item, whatever its severity.
    latched_after = latched or marked
    by_critical = critical is True or (
        "truthy_critical" in bugs and critical is not ABSENT and bool(critical)) or (
        "string_true_critical" in bugs and critical == "true")
    by_status = type(status) is str and (status == model["critical"] or (
        "status_rstrip" in bugs and status.rstrip() == model["critical"]))
    if "status_rule_off" in bugs or ("latch_spares_status_critical" in bugs
                                     and latched and not marked):
        by_status = False
    if (by_critical or by_status) and "critical_rule_off" not in bugs:
        if "rule1_needs_well_formed" not in bugs or marked or well_formed(
                item, encoding(item), requested, model, bugs):
            return model["critical"], latched_after
    severity = _reading(item, marked, latched, requested, model, bugs)
    # Health is read only from a well-formed item.
    if severity == "ok" and not (
        (marked and status == "ok")
        or (not marked and not latched
            and well_formed(item, encoding(item), requested, model, bugs)
            and (item.get("degradation_reasons") == [] or "reasons_unchecked" in bugs
                 or "reasons_null_empty" in bugs))
    ):
        raise Failure("ok read from an item that is not well formed")
    return severity, latched_after


def _reading(item: dict, marked: bool, latched: bool, requested: str, model: dict,
             bugs: frozenset[str]) -> str:
    if marked:
        status = item.get("status", ABSENT)
        if type(status) is str and status in model["marked"]:
            return status
        return model["unknown"]
    if latched:
        return model["unknown"]
    if "case2_off" not in bugs and any(name in item for name in model["only"]):
        return model["unknown"]
    view = dict(item)
    if "absent_critical_false" in bugs and "critical" not in view:
        view["critical"] = False
    if "string_false_bool" in bugs and view.get("critical") in ("true", "false"):
        view["critical"] = view["critical"] == "true"
    if "reasons_null_empty" in bugs and view.get("degradation_reasons", ABSENT) is None:
        view["degradation_reasons"] = []
    enc = encoding(view)
    wf = well_formed(view, enc, requested, model, bugs)
    if "3b_status_ok" in bugs and enc == "3b" and wf and view.get("status") == "ok" \
            and view.get("degradation_reasons") == []:
        return "ok"
    for row in model["tables"][enc]:
        cells = row["cells"]
        if all(_cell_matches(alts, view.get(name, ABSENT), wf) if name != "Well formed"
               else _cell_matches(alts, ABSENT, wf)
               for name, alts in cells.items()
               if not (name == "degradation_reasons" and "reasons_unchecked" in bugs)):
            return row["severity"]
    return model["unknown"]


def shape(item: dict, latched: bool, model: dict) -> str:
    """Which reading decides the item, ignoring the critical rule."""
    if is_marked(item, model, frozenset()):
        return "marked"
    if latched:
        return "latched"
    if any(name in item for name in model["only"]):
        return "case2"
    return encoding(item)


def check_model(model: dict) -> None:
    """The severity tables' rows are disjoint over a sample domain."""
    values = {"critical": [ABSENT, True, False, None, "false"],
              "status": [ABSENT, "ok", "degraded", "critical", "warning", None, 1],
              "degradation_reasons": [ABSENT, [], ["x"], None, "none", {}]}
    for enc, table in model["tables"].items():
        names = [n for n in table[0]["cells"] if n != "Well formed"] if table else []
        for wf in (True, False):
            def walk(at: int, picked: dict) -> None:
                if at == len(names):
                    hits = [r for r in table if all(
                        _cell_matches(alts, picked.get(n, ABSENT), wf) if n != "Well formed"
                        else _cell_matches(alts, ABSENT, wf)
                        for n, alts in r["cells"].items())]
                    if len(hits) > 1:
                        raise Failure(f"{enc} rows overlap at {picked!r}")
                    return
                for value in values[names[at]]:
                    walk(at + 1, {**picked, names[at]: value})
            walk(0, {})


# --- the corpus -------------------------------------------------------------------

def check_baselines(baselines: dict, model: dict) -> None:
    if set(baselines) != {"comment"} | set(BASELINE_ENCODING):
        raise Failure(f"baselines hold {sorted(baselines)}")
    for name, enc in BASELINE_ENCODING.items():
        export = baselines[name]
        if type(export) is not dict or encoding(export) != enc:
            raise Failure(f"baseline {name} is not of encoding {enc}")
        device = export.get("device_id")
        if type(device) is not str or not well_formed(export, enc, device, model):
            raise Failure(f"baseline {name} is not well formed for {enc}")
        if read(export, device, False, model) != ("ok", False):
            raise Failure(f"baseline {name} does not read ok")
        if enc == "3b" and set(export) != set(model["required"]["3b"]):
            raise Failure(f"baseline {name} is not exactly 3b's required members")


def check(corpus: dict, baselines: dict, model: dict,
          bugs: frozenset[str] = frozenset()) -> None:
    check_baselines(baselines, model)
    if set(corpus) != HEADER_KEYS:
        raise Failure(f"header keys {sorted(corpus)}")
    if corpus["contract"] != "ori-specs/gateway-api/v2.md#" + model["anchor"]:
        raise Failure(f"contract {corpus['contract']!r} is not the subsection's anchor "
                      f"#{model['anchor']}")
    if type(corpus["version"]) is not int or corpus["version"] != 2:
        raise Failure("version is not 2")
    if corpus["baselines"] != BASELINES_NAME:
        raise Failure(f"baselines names {corpus['baselines']!r}")
    if corpus["severities"] != model["severities"] + [model["unknown"]]:
        raise Failure(f"severities {corpus['severities']!r} differ from the text's")
    names: set[str] = set()
    for case in corpus["cases"]:
        name = case.get("name")
        if set(case) != CASE_KEYS:
            raise Failure(f"{name}: keys {sorted(case)}")
        if type(name) is not str or not name or name in names:
            raise Failure(f"duplicate or empty case name {name!r}")
        names.add(name)
        if type(case["note"]) is not str or type(case["item"]) is not dict:
            raise Failure(f"{name}: note or item of the wrong type")
        if type(case["requested_device_id"]) is not str or not case["requested_device_id"]:
            raise Failure(f"{name}: requested_device_id")
        if type(case["latched"]) is not bool:
            raise Failure(f"{name}: latched is not a JSON boolean")
        expect = case["expect"]
        if type(expect) is not dict or set(expect) != {"severity", "latched_after"} \
                or type(expect["latched_after"]) is not bool \
                or expect["severity"] not in corpus["severities"]:
            raise Failure(f"{name}: expect")
        try:
            got = read(case["item"], case["requested_device_id"], case["latched"], model, bugs)
        except Failure as failure:
            raise Failure(f"{name}: {failure}") from None
        want = (expect["severity"], expect["latched_after"])
        if got != want:
            raise Failure(f"{name}: read as {got}, corpus says {want}")
    coverage(corpus["cases"], baselines, model)


def coverage(cases: list[dict], baselines: dict, model: dict) -> None:
    def where(pred: Callable[[dict, dict], bool]) -> bool:
        return any(pred(c, c["item"]) for c in cases)

    def by_rule(item: dict) -> bool:
        return item.get("critical", ABSENT) is True or item.get("status") == model["critical"]

    def shaped(name: str) -> Callable[[dict, dict], bool]:
        return lambda c, i: shape(i, c["latched"], model) == name

    def plain(c: dict, i: dict) -> bool:
        """Unmarked, unlatched, no projection-only member, no critical rule."""
        return not c["latched"] and not is_marked(i, model, frozenset()) \
            and not any(n in i for n in model["only"]) and not by_rule(i)

    def near(enc: str, but: str | None) -> Callable[[dict, dict], bool]:
        """An item of the encoding's members, well formed except perhaps for
        `but`, whatever `but` is."""
        def go(c: dict, i: dict) -> bool:
            for name in model["required"][enc]:
                if name == but:
                    continue
                if name not in i or not typed(name, i[name], model, frozenset()):
                    return False
            if but != "device_id" and i.get("device_id") != c["requested_device_id"]:
                return False
            if enc == "3b" and not set(i) - {but} <= set(model["closed_3b"]):
                return False
            return plain(c, i)
        return go

    def reads(severity: str) -> Callable[[dict, dict], bool]:
        return lambda c, i: c["expect"]["severity"] == severity

    labels: list[tuple[str, Callable[[dict, dict], bool]]] = []
    for name, enc in BASELINE_ENCODING.items():
        base = baselines[name]
        started = dict(base, **STARTED)
        labels += [
            (f"the exact {name} export", lambda c, i, b=base: plain(c, i) and i == b),
            (f"the started {name} export",
             lambda c, i, s=started: plain(c, i) and type(i.get("health_socket_path")) is str
             and i["health_socket_path"] != ""
             and {k: v for k, v in i.items() if k != "health_socket_path"}
             == {k: v for k, v in s.items() if k != "health_socket_path"}),
        ]
        for member in model["required"][enc]:
            labels += [
                (f"{enc}: {member} absent",
                 lambda c, i, e=enc, m=member: near(e, m)(c, i) and m not in i),
                (f"{enc}: {member} mistyped",
                 lambda c, i, e=enc, m=member: near(e, m)(c, i) and m in i
                 and not typed(m, i[m], model, frozenset())),
            ]
        labels += [
            (f"{enc}: another device",
             lambda c, i, e=enc: near(e, "device_id")(c, i) and type(i.get("device_id")) is str
             and i["device_id"] != c["requested_device_id"]),
            (f"{enc}: a device id that matches only when normalised",
             lambda c, i, e=enc: near(e, "device_id")(c, i) and type(i.get("device_id")) is str
             and i["device_id"] != c["requested_device_id"]
             and i["device_id"].strip().casefold()
             == c["requested_device_id"].strip().casefold()),
            (f"{enc}: a listed member it does not require, present and mistyped",
             lambda c, i, e=enc: near(e, None)(c, i) and any(
                 n in i and n != "status" and n not in model["required"][e]
                 and not typed(n, i[n], model, frozenset()) for n in model["types"])),
            (f"{enc}: reasons [] with status absent",
             lambda c, i, e=enc: near(e, None)(c, i) and i["degradation_reasons"] == []
             and "status" not in i),
            (f"{enc}: reasons non-empty with status degraded",
             lambda c, i, e=enc: near(e, None)(c, i) and i["degradation_reasons"] != []
             and i.get("status") == "degraded"),
            (f"{enc}: reasons [] with status degraded",
             lambda c, i, e=enc: near(e, None)(c, i) and i["degradation_reasons"] == []
             and i.get("status") == "degraded"),
            (f"{enc}: reasons non-empty with status absent",
             lambda c, i, e=enc: near(e, None)(c, i) and i["degradation_reasons"] != []
             and "status" not in i),
            *[(f"{enc}: reasons {label}",
               lambda c, i, e=enc, t=t: near(e, "degradation_reasons")(c, i)
               and "degradation_reasons" in i and t(i["degradation_reasons"]))
              for label, t in (("null", lambda v: v is None),
                               ("a string", lambda v: type(v) is str),
                               ("an object", lambda v: type(v) is dict))],
            (f"{enc}: status ok",
             lambda c, i, e=enc: near(e, None)(c, i) and i.get("status") == "ok"
             and i["degradation_reasons"] == []),
            (f"{enc}: status another string",
             lambda c, i, e=enc: near(e, None)(c, i) and type(i.get("status")) is str
             and i["status"] not in model["severities"]
             and i["status"].rstrip() != model["critical"]),
            (f"{enc}: status critical with trailing whitespace",
             lambda c, i, e=enc: near(e, None)(c, i) and type(i.get("status")) is str
             and i["status"] != model["critical"] and i["status"].rstrip() == model["critical"]),
            (f"{enc}: status not a string",
             lambda c, i, e=enc: near(e, None)(c, i) and "status" in i
             and type(i["status"]) is not str and i["status"] is not None),
            (f"{enc}: status null",
             lambda c, i, e=enc: near(e, None)(c, i) and "status" in i and i["status"] is None),
            (f"{enc}: the critical rule over a missing required member",
             lambda c, i, e=enc: not c["latched"] and not is_marked(i, model, frozenset())
             and not any(n in i for n in model["only"]) and by_rule(i) and encoding(i) == e
             and any(n not in i for n in model["required"][e])),
            (f"{enc}: the critical rule over a mistyped listed member",
             lambda c, i, e=enc: not c["latched"] and not is_marked(i, model, frozenset())
             and not any(n in i for n in model["only"]) and by_rule(i) and encoding(i) == e
             and all(n in i for n in model["required"][e])
             and any(n in i and n not in ("status", "critical")
                     and not typed(n, i[n], model, frozenset()) for n in model["types"])),
            (f"{enc}: status critical on an unlatched item",
             lambda c, i, e=enc: not c["latched"] and encoding(i) == e
             and not is_marked(i, model, frozenset())
             and i.get("status") == model["critical"]),
            (f"{enc}: latched", lambda c, i, e=enc: c["latched"] and encoding(i) == e
             and not is_marked(i, model, frozenset()) and not by_rule(i)
             and not any(n in i for n in model["only"])
             and well_formed(i, e, c["requested_device_id"], model)),
            (f"{enc}: latched, the critical rule",
             lambda c, i, e=enc: c["latched"] and encoding(i) == e
             and not is_marked(i, model, frozenset()) and by_rule(i)),
        ]
    labels += [
        ("3a: critical true on a well-formed item",
         lambda c, i: not c["latched"] and i.get("critical") is True
         and well_formed(i, "3a", c["requested_device_id"], model)),
        ("3a: critical the string true",
         lambda c, i: near("3a", "critical")(c, i) and i.get("critical") == "true"),
        ("3a: critical null",
         lambda c, i: near("3a", "critical")(c, i) and "critical" in i
         and i["critical"] is None),
        ("3a: a reason beside status ok",
         lambda c, i: near("3a", None)(c, i) and i.get("status") == "ok"
         and i["degradation_reasons"] != []),
        ("3a: an open member set read ok",
         lambda c, i: near("3a", None)(c, i) and reads("ok")(c, i)
         and not set(i) <= set(model["types"])),
        ("3b: a member outside its closed set",
         lambda c, i: plain(c, i) and encoding(i) == "3b"
         and all(n in i and typed(n, i[n], model, frozenset()) for n in model["required"]["3b"])
         and i.get("device_id") == c["requested_device_id"]
         and not set(i) <= set(model["types"])),
        *[(f"3b: the later member {m}",
           lambda c, i, m=m: plain(c, i) and encoding(i) == "3b" and m in i
           and all(n in i for n in model["required"]["3b"])) for m in model["later"]],
        ("3b: a listed optional member read ok",
         lambda c, i: near("3b", None)(c, i) and reads("ok")(c, i)
         and any(n in i for n in set(model["closed_3b"]) - set(model["required"]["3b"])
                 if n != "status")),
        ("an unmarked item from a latched device naming another device",
         lambda c, i: c["latched"] and not is_marked(i, model, frozenset()) and not by_rule(i)
         and i.get("device_id") != c["requested_device_id"]),
        ("a case-2 item from a latched device",
         lambda c, i: shape(i, False, model) == "case2" and c["latched"]),
        ("critical: true on a case-2 item",
         lambda c, i: shaped("case2")(c, i) and i.get("critical") is True),
        ("a marked item from an unlatched device",
         lambda c, i: shape(i, False, model) == "marked" and not c["latched"]),
        ("a marked item from a latched device",
         lambda c, i: shape(i, False, model) == "marked" and c["latched"]),
        ("critical: true on a marked item whose status is not critical",
         lambda c, i: shaped("marked")(c, i) and i.get("critical") is True
         and i.get("status") != model["critical"]),
        ("status critical on a marked item without critical: true",
         lambda c, i: shaped("marked")(c, i) and i.get("status") == model["critical"]
         and i.get("critical") is not True),
        ("a projection extending the marker",
         lambda c, i: type(i.get("projection")) is str and not c["latched"]
         and i["projection"].startswith(model["marker"])
         and i["projection"].rstrip() != model["marker"]),
        ("a projection of the marker with trailing whitespace",
         lambda c, i: type(i.get("projection")) is str and not c["latched"]
         and i["projection"] != model["marker"]
         and i["projection"].rstrip() == model["marker"]),
        ("a projection that is not a string",
         lambda c, i: "projection" in i and type(i["projection"]) is not str),
    ]
    for status in model["marked"] + [ABSENT, "other", "non-string"]:
        def has(c: dict, i: dict, status: object = status) -> bool:
            if not shaped("marked")(c, i) or by_rule(i):
                return False
            value = i.get("status", ABSENT)
            if status == "other":
                return type(value) is str and value not in model["severities"]
            if status == "non-string":
                return value is not ABSENT and type(value) is not str
            return value is status if status is ABSENT else value == status
        labels.append((f"a marked item with status {status if status is not ABSENT else 'absent'}",
                       has))
    for name in model["only"]:
        labels.append((f"{name} alone on an unmarked, unlatched item",
                       lambda c, i, n=name: shaped("case2")(c, i) and not by_rule(i)
                       and [m for m in model["only"] if m in i] == [n]))
    for label, pred in labels:
        if not where(pred):
            raise Failure(f"coverage: {label}")


# --- mutations ------------------------------------------------------------------

def mutations(corpus: dict, baselines: dict, model: dict) -> int:
    check(corpus, baselines, model)  # the baseline must hold, or no mutant proves anything

    def corpus_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(corpus)
            edit(mutated)
            check(mutated, baselines, model)
        return go

    def baseline_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(baselines)
            edit(mutated)
            check(corpus, mutated, model)
        return go

    def drop(pred: Callable[[dict], bool]) -> Callable[[], None]:
        return corpus_mutant(lambda c: c.update(
            cases=[x for x in c["cases"] if not pred(x)]))

    def text_mutant(key: str, old: str, new: str) -> Callable[[], None]:
        def go() -> None:
            texts = contract_texts()
            # The target matches across any run of whitespace, so a reflowed
            # paragraph keeps its mutant.
            pattern = re.compile(r"\s+".join(re.escape(word) for word in old.split()))
            if pattern.search(texts[key]) is None:
                raise AssertionError(f"mutant target missing from {key}: {old!r}")
            texts[key] = pattern.sub(lambda _: new, texts[key], count=1)
            mutated = contract_model(texts)
            check_model(mutated)
            check(corpus, baselines, mutated)
        return go

    def model_mutant(edit: Callable[[dict], None]) -> Callable[[], None]:
        def go() -> None:
            mutated = copy.deepcopy(model)
            edit(mutated)
            check_model(mutated)
            check(corpus, baselines, mutated)
        return go

    def bug(name: str) -> Callable[[], None]:
        return lambda: check(corpus, baselines, model, frozenset({name}))

    def first_marked(c: dict) -> dict:
        return next(x for x in c["cases"] if shape(x["item"], x["latched"], model) == "marked")

    def plain_ok(x: dict) -> bool:
        return x["expect"]["severity"] == "ok" and not is_marked(x["item"], model, frozenset())

    cases: list[tuple[str, Callable[[], None]]] = [
        # the corpus
        ("severity flipped", corpus_mutant(
            lambda c: c["cases"][0]["expect"].update(severity="unknown"))),
        ("latched_after flipped", corpus_mutant(
            lambda c: c["cases"][0]["expect"].update(
                latched_after=not c["cases"][0]["expect"]["latched_after"]))),
        ("latched as a string", corpus_mutant(
            lambda c: c["cases"][0].update(latched="false"))),
        ("duplicate case name", corpus_mutant(
            lambda c: c["cases"].append(copy.deepcopy(c["cases"][0])))),
        ("marked item's marker gains trailing whitespace", corpus_mutant(
            lambda c: first_marked(c)["item"].update(projection=model["marker"] + " "))),
        ("severities reordered", corpus_mutant(lambda c: c["severities"].reverse())),
        ("contract anchor changed", corpus_mutant(
            lambda c: c.update(contract=c["contract"] + "x"))),
        ("baselines renamed", corpus_mutant(lambda c: c.update(baselines="other.json"))),
        ("requested_device_id dropped", corpus_mutant(
            lambda c: c["cases"][0].pop("requested_device_id"))),
        ("ok cases read from another device", corpus_mutant(
            lambda c: [x.update(requested_device_id="dev-99") for x in c["cases"]
                       if plain_ok(x)])),
        ("ok cases emptied, Codex's {}", corpus_mutant(
            lambda c: [x.update(item={}) for x in c["cases"] if plain_ok(x)])),
        ("absent-member cases dropped", drop(lambda x: x["name"].endswith("_absent"))),
        ("mistyped-member cases dropped", drop(lambda x: x["name"].endswith("_mistyped"))),
        ("started cases dropped", drop(
            lambda x: plain_ok(x) and x["item"].get("safety") == {})),
        ("other-device cases dropped", drop(
            lambda x: x["item"].get("device_id") not in (None, x["requested_device_id"]))),
        ("3a open-set case dropped", drop(
            lambda x: plain_ok(x) and not set(x["item"]) <= set(model["types"]))),
        # the baselines
        ("baseline v2.5.0 gains firmware_reading_age", baseline_mutant(
            lambda b: b["v2.5.0"].update(firmware_reading_age={}))),
        ("baseline e4ba3e92 loses critical", baseline_mutant(
            lambda b: b["e4ba3e92"].pop("critical"))),
        ("baseline v2.5.0 loses sensors", baseline_mutant(lambda b: b["v2.5.0"].pop("sensors"))),
        ("baseline e4ba3e92 degraded", baseline_mutant(
            lambda b: b["e4ba3e92"].update(degradation_reasons=["x"]))),
        ("baseline dropped", baseline_mutant(lambda b: b.pop("e4ba3e92"))),
        # the text
        ("3a ok row reads degraded", text_mutant(
            "g", "| yes | `false` | absent, or `ok` | `[]` | `ok` |",
            "| yes | `false` | absent, or `ok` | `[]` | `degraded` |")),
        ("3a ok row takes any array", text_mutant(
