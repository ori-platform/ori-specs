{
  "contract": "runtime-config/v2",
  "version": 2,
  "comment": "The provisioning document, closed at every level. Types are checked and never coerced; an undeclared key at any depth is refused by full path. Extensions beyond schema-descriptor/v1: description, pattern, exclusive_minimum, entries, delegate, and the top-level retired table.",
  "adopts": "schema-descriptor/v1",
  "extensions": [
    "description",
    "pattern",
    "exclusive_minimum",
    "entries",
    "delegate"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "required": true,
      "enum": [
        "ori.runtime-config.v2"
      ],
      "description": "Marks a v2 document. Absent on a legacy single-document configuration."
    },
    "config_signature": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "required": true,
          "enum": [
            "ori.config_signature.v1"
          ]
        },
        "signer_id": {
          "type": "string",
          "required": true,
          "description": "Audit label only; never an authority input."
        },
        "signing_key": {
          "type": "string",
          "required": true,
          "pattern": "^ed25519:[A-Za-z0-9+/]{43}=$",
          "description": "The raw Ed25519 public key that signed this document, inside the signed bytes. Anchor selection compares this key material across every configured anchor; see runtime-config-orchestration/v1."
        },
        "signed_at_ms": {
          "type": "integer",
          "required": true,
          "minimum": 1
        },
        "signature": {
          "type": "string",
          "required": true,
          "description": "ed25519:<base64>; verified per runtime-config-signing/v1 before anything else is read."
        }
      },
      "description": "Signature envelope per runtime-config-signing/v1. Optional in development; production posture requires it."
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "required": true,
          "pattern": "^\\S+$",
          "description": "Durable device identity. Never changed by an upgrade."
        },
        "name": {
          "type": "string",
          "required": true
        },
        "location": {
          "type": "string",
          "required": true
        },
        "inventory_generation": {
          "type": "integer",
          "required": true,
          "minimum": 1,
          "description": "The hardware inventory generation this document declares. Monotonic per device and never reused for different contents; a commissioned binding names the generation it was proven against."
        },
        "site_type": {
          "type": "string",
          "default": ""
        },
        "country_code": {
          "type": "string",
          "default": "",
          "pattern": "^([A-Z]{2})?$",
          "description": "ISO 3166-1 alpha-2, or empty."
        },
        "deployment_type": {
          "type": "string",
          "default": "pi",
          "enum": [
            "pi",
            "phone",
            "edge_node",
            "server"
          ]
        },
        "deployment_profile": {
          "type": "string",
          "default": "development",
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "timezone": {
          "type": "string",
          "default": "",
          "description": "IANA name. Resolution order: this value, host timezone, UTC."
        }
      },
      "required": true
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "required": true
          },
          "type": {
            "type": "string",
            "required": true
          },
          "protocol": {
            "type": "string",
            "required": true
          },
          "poll_interval_ms": {
            "type": "integer",
            "default": 1000,
            "minimum": 100,
            "maximum": 60000
          },
          "calibration": {
            "type": "object",
            "properties": {},
            "delegate": "sensor-configuration/v1"
          }
        },
        "delegate": "sensor-configuration/v1",
        "description": "Canonical envelope per sensor-configuration/v1; every other key is protocol configuration validated by the adapter's declared schema."
      },
      "default": []
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "required": true
          },
          "version": {
            "type": "string",
            "default": ""
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of the selected package. Selection by digest confers nothing; a consumer that verifies packages MUST match it when present."
          },
          "config": {
            "type": "object",
            "properties": {
              "approval_timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "description": "The only key the runtime reads from this object today; the dispatcher fallback timeout is the maximum across skills."
              }
            },
            "delegate": "skills-package/v3",
            "description": "Beyond approval_timeout_seconds, keys are validated against the selected package's signed config_schema under skills-package/v3. A consumer that does not implement v3 MUST refuse any other key."
          }
        }
      },
      "default": []
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "default_tier": {
          "type": "string",
          "default": "local",
          "enum": [
            "rule",
            "local"
          ]
        },
        "local_model": {
          "type": "string",
          "default": ""
        },
        "model_path": {
          "type": "string",
          "default": ""
        },
        "escalation_threshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.0,
          "maximum": 1.0
        },
        "capability_posture": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "probe_interval_seconds": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 30
            },
            "gateway_heartbeat_ttl_seconds": {
              "type": "integer",
              "default": 30,
              "minimum": 1
            },
            "internet_probe_host": {
              "type": "string",
              "default": "one.one.one.one"
            },
            "internet_probe_port": {
              "type": "integer",
              "default": 53,
              "minimum": 1,
              "maximum": 65535
            },
            "internet_probe_timeout_ms": {
              "type": "integer",
              "default": 1000,
              "minimum": 100
            }
          }
        },
        "energy_aware_reasoning": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "throttle_threshold_percent": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 100.0
            },
            "critical_threshold_percent": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 100.0
            },
            "battery_sensor_id": {
              "type": "string",
              "default": ""
            },
            "alert_on_throttle": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "causal_memory": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "min_confidence_to_store": {
              "type": "number",
              "default": 0.0,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "rejection_expiry_days": {
              "type": "integer",
              "minimum": 0,
              "description": "0 never expires."
            }
          }
        },
        "context_enricher": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "staleness_window_ms": {
              "type": "integer",
              "default": 60000,
              "minimum": 100
            },
            "max_entries": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 20
            },
            "include_sources": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "broker_url": {
          "type": "string",
          "default": "",
          "description": "mqtt://, tcp:// or mqtts://. Required when enabled."
        },
        "broker_posture": {
          "type": "object",
          "properties": {
            "deployment_check": {
              "type": "string",
              "default": "warning",
              "enum": [
                "warning",
                "required"
              ]
            },
            "anonymous_access": {
              "type": "string",
              "default": "unknown",
              "enum": [
                "unknown",
                "disabled"
              ]
            },
            "require_credentials": {
              "type": "boolean",
              "default": false
            },
            "acl_policy": {
              "type": "string",
              "default": "unknown",
              "enum": [
                "unknown",
                "per_device_required"
              ]
            }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "ca_certfile": {
              "type": "string",
              "default": ""
            },
            "certfile": {
              "type": "string",
              "default": ""
            },
            "keyfile": {
              "type": "string",
              "default": ""
            },
            "keyfile_password_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "shared_secret_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "previous_shared_secret_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "max_clock_skew_ms": {
              "type": "integer",
              "default": 300000,
              "minimum": 1000
            },
            "replay_ttl_ms": {
              "type": "integer",
              "default": 300000,
              "minimum": 1000
            },
            "persistent_replay_cache": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "custody": {
          "type": "object",
          "properties": {
            "secret_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "previous_secret_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "retired_key_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^hkdf-sha256:[0-9a-f]{32}$"
              },
              "default": []
            }
          }
        },
        "encryption": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "node_heartbeat": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "interval_seconds": {
              "type": "number",
              "default": 30,
              "minimum": 1
            }
          }
        },
        "firmware_telemetry": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "topic": {
              "type": "string",
              "default": "ori/fw/+/telemetry",
              "description": "No # wildcard."
            },
            "qos": {
              "type": "integer",
              "default": 1,
              "enum": [
                0,
                1,
                2
              ]
            }
          }
        },
        "firmware_commands": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "runtime_command_key_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "provisioner_key_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "qos": {
              "type": "integer",
              "default": 1,
              "enum": [
                1
              ]
            },
            "publish_timeout_s": {
              "type": "number",
              "default": 10.0,
              "exclusive_minimum": 0.0
            },
            "liveness_interval_s": {
              "type": "number",
              "default": 15.0,
              "minimum": 1.0,
              "maximum": 20.0
            },
            "confirmation_retry_interval_s": {
              "type": "number",
              "default": 60.0,
              "minimum": 1.0,
              "maximum": 900.0
            }
          }
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "timeout_ms": {
              "type": "integer",
              "default": 10000,
              "minimum": 100
            }
          }
        }
      }
    },
    "telemetry_export": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "endpoint": {
          "type": "string",
          "default": ""
        },
        "api_key_env": {
          "type": "string",
          "default": "",
          "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
          "description": "Environment variable name; the value never enters the document."
        },
        "flush_interval_s": {
          "type": "number",
          "default": 30.0,
          "minimum": 1.0,
          "maximum": 300.0
        },
        "batch_size": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500
        },
        "timeout_ms": {
          "type": "integer",
          "default": 3000,
          "minimum": 100,
          "maximum": 30000
        },
        "max_queue_size": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "description": "Must be at least batch_size."
        }
      }
    },
    "device_policy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "url": {
          "type": "string",
          "default": "",
          "description": "https:// required when enabled."
        },
        "auth_token": {
          "type": "string",
          "default": "",
          "description": "Transport credential, carried as an environment placeholder."
        },
        "public_key_env": {
          "type": "string",
          "default": "ORI_DEVICE_POLICY_PUBLIC_KEY_B64",
          "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
          "description": "Environment variable holding the base64 Ed25519 key that verifies entitlement documents. The key itself never appears in a provisioning-signed document."
        },
        "request_timeout_ms": {
          "type": "integer",
          "default": 3000,
          "minimum": 100
        },
        "max_clock_skew_s": {
          "type": "integer",
          "default": 300,
          "minimum": 1
        },
        "refresh_enabled": {
          "type": "boolean",
          "default": false
        },
        "refresh_interval_s": {
          "type": "integer",
          "default": 21600,
          "minimum": 60
        }
      }
    },
    "health_socket": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "path": {
          "type": "string",
          "default": "/run/ori/health.sock"
        },
        "mode": {
          "type": "string",
          "default": "0o660",
          "pattern": "^0o[0-7]{3}$",
          "description": "Quoted octal permission string. YAML 1.1 and 1.2 parsers disagree about whether an unquoted 0o660 is a string or an integer, so the document carries a string and the consumer parses it."
        }
      }
    },
    "firmware_mqtt_provisioning": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "socket_path": {
          "type": "string",
          "default": "/run/ori/firmware-mqtt-provisioning.sock"
        },
        "socket_mode": {
          "type": "string",
          "default": "0o600",
          "pattern": "^0o[0-7]{3}$",
          "description": "Quoted octal permission string. YAML 1.1 and 1.2 parsers disagree about whether an unquoted 0o660 is a string or an integer, so the document carries a string and the consumer parses it. Must not grant world access and must grant owner or group write."
        },
        "allowed_uids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "provisioner_key_env": {
          "type": "string",
          "default": "ORI_FW_PROVISIONER_KEY",
          "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
          "description": "Environment variable name; the value never enters the document."
        },
        "client_ca_certfile": {
          "type": "string",
          "default": ""
        },
        "client_ca_keyfile": {
          "type": "string",
          "default": ""
        },
        "client_ca_key_password_env": {
          "type": "string",
          "default": "",
          "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
          "description": "Environment variable name; the value never enters the document."
        },
        "broker_ca_certfile": {
          "type": "string",
          "default": ""
        },
        "broker_uri": {
          "type": "string",
          "default": "",
          "description": "mqtts:// required when enabled."
        },
        "time_server": {
          "type": "string",
          "default": ""
        },
        "certificate_validity_days": {
          "type": "integer",
          "default": 90,
          "minimum": 1,
          "maximum": 397
        }
      }
    },
    "os_sandbox": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "require_for_community": {
          "type": "boolean",
          "default": false
        },
        "exec_timeout_ms": {
          "type": "integer",
          "default": 2000,
          "minimum": 100
        },
        "max_output_bytes": {
          "type": "integer",
          "default": 65536,
          "minimum": 4096
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "default": "ori_state.db"
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "enforce_production_posture": {
          "type": "boolean",
          "default": false
        },
        "config_signature": {
          "type": "object",
          "properties": {
            "require_signed": {
              "type": "boolean",
              "default": false
            },
            "trust_anchor_env": {
              "type": "string",
              "default": "ORI_CONFIG_TRUST_ANCHOR_PUBLIC_KEY_B64",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            }
          }
        },
        "skills": {
          "type": "object",
          "properties": {
            "require_signed": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "remote_commands": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "hmac_secret_env": {
              "type": "string",
              "default": "ORI_REMOTE_COMMAND_HMAC_SECRET",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "previous_hmac_secret_env": {
              "type": "string",
              "default": "",
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$",
              "description": "Environment variable name; the value never enters the document."
            },
            "max_skew_seconds": {
              "type": "integer",
              "default": 300,
              "minimum": 0
            },
            "allow_unlisted_senders": {
              "type": "boolean",
              "default": false
            },
            "allowed_senders": {
              "type": "object",
              "properties": {
                "sms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "whatsapp": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                }
              }
            },
            "lockout": {
              "type": "object",
              "properties": {
                "enforcement_enabled": {
                  "type": "boolean",
                  "default": false
                },
                "risk_window_ms": {
                  "type": "integer",
                  "default": 3600000,
                  "minimum": 1
                },
                "state_stale_after_ms": {
                  "type": "integer",
                  "default": 3600000,
                  "minimum": 1
                },
                "incident_sender_limit": {
                  "type": "integer",
                  "default": 50,
                  "minimum": 1
                },
                "elevated_incident_threshold": {
                  "type": "integer",
                  "default": 1,
                  "minimum": 1
                },
                "critical_incident_threshold": {
                  "type": "integer",
                  "default": 3,
                  "minimum": 1
                },
                "elevated_rejection_threshold": {
                  "type": "integer",
                  "default": 5,
                  "minimum": 1
                },
                "critical_rejection_threshold": {
                  "type": "integer",
                  "default": 15,
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "properties": {
        "primary_alert_channel": {
          "type": "string",
          "default": "sms",
          "enum": [
            "sms",
            "whatsapp"
          ]
        },
        "approval_require_scoped_replies": {
          "type": "boolean",
          "default": true
        },
        "operator_contact": {
          "type": "string",
          "default": ""
        },
        "secondary_contact": {
          "type": "string",
          "default": ""
        },
        "setup_notifications": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "sms",
                  "whatsapp",
                  "primary"
                ]
              },
              "default": [
                "primary"
              ]
            }
          }
        },
        "alert_outbox": {
          "type": "object",
          "properties": {
            "retry_interval_minutes": {
              "type": "number",
              "default": 0.5,
              "exclusive_minimum": 0.0
            },
            "max_non_tier_d_attempts": {
              "type": "integer",
              "default": 10,
