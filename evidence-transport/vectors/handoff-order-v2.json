  "checkpoint_sequences": [
    {
      "name": "a lost acknowledgement holds the next checkpoint local until the first is acknowledged",
      "steps": [
        {"event": "produce", "kind": "checkpoint", "id": "A", "expect": {"local_waiting": ["A"]}},
        {"event": "drain", "expect": {"handed_off": ["A"], "gateway_order": ["A"]}},
        {"event": "ack_lost", "id": "A", "expect": {"gateway_order": ["A"]}},
        {"event": "runtime_restart", "expect": {}},
        {"event": "produce", "kind": "checkpoint", "id": "B", "expect": {"local_waiting": ["B"]}},
        {"event": "drain", "expect": {"handed_off": ["A"], "gateway_order": ["A"], "local_waiting": ["B"]}},
        {"event": "ack", "id": "A", "expect": {"local_waiting": ["B"]}},
        {"event": "drain", "expect": {"handed_off": ["B"], "gateway_order": ["A", "B"], "local_waiting": []}}
      ]
    },
    {
