        {"event": "produce", "kind": "checkpoint", "id": "A", "expect": {}},
        {"event": "drain", "expect": {"handed_off": ["A"]}},
        {"event": "produce", "kind": "checkpoint", "id": "B", "expect": {}},
        {"event": "produce", "kind": "envelope", "id": "e1", "expect": {}},
        {"event": "produce", "kind": "envelope", "id": "e2", "expect": {}},
        {"event": "drain", "expect": {"handed_off": ["A", "e1", "e2"], "gateway_order": ["A", "e1", "e2"], "local_waiting": ["B"]}}
      ]
    },
    {
      "name": "a stopped epoch's checkpoint holds no checkpoint of another epoch",
      "steps": [
        {"event": "produce", "kind": "checkpoint", "id": "A", "epoch": "E1", "expect": {}},
